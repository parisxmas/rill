type J
  JNull
  JBool(Bool)
  JInt(Int)
  JStr(Str)
  JArr(List(J))
  JObj(List(Field))

type Field
  Fld(Str, J)

fn die(msg, i) =
  println("error at " + int_to_str(i + 1) + ": " + msg)
  exit(1)
  die(msg, i)

fn esc_into(b: StrBuf, c) =
  if c == 34 then
    b += "\\\""
  else if c == 92 then
    b += "\\\\"
  else if c == 10 then
    b += "\\n"
  else if c == 9 then
    b += "\\t"
  else if c == 13 then
    b += "\\r"
  else if c == 8 then
    b += "\\b"
  else if c == 12 then
    b += "\\f"
  else
    b += c

fn quote(b: StrBuf, x, i) =
  if i >= #x then
    b += "\""
  else
    esc_into(b, x[i])
    quote(b, x, i + 1)

fn show_arr(b: StrBuf, xs) = match xs
  Nil ->
    b += "]"
  Cons(x, rest) ->
    show_j(b, x)
    show_more(b, rest)

fn show_more(b: StrBuf, rest) = match rest
  Nil ->
    b += "]"
  Cons(_, _) ->
    b += ","
    show_arr(b, rest)

fn show_obj(b: StrBuf, fs) = match fs
  Nil ->
    b += "}"
  Cons(Fld(k, v), rest) ->
    b += "\""
    quote(b, k, 0)
    b += ":"
    show_j(b, v)
    show_omore(b, rest)

fn show_omore(b: StrBuf, rest) = match rest
  Nil ->
    b += "}"
  Cons(_, _) ->
    b += ","
    show_obj(b, rest)

fn show_j(b: StrBuf, v) = match v
  JNull ->
    b += "null"
  JBool(x) ->
    b += if x then "true" else "false"
  JInt(n) ->
    b += int_to_str(n)
  JStr(x) ->
    b += "\""
    quote(b, x, 0)
  JArr(xs) ->
    b += "["
    show_arr(b, xs)
  JObj(fs) ->
    b += "{"
    show_obj(b, fs)

fn print_doc(v) =
  b = strbuf()
  show_j(b, v)
  println(strbuf_str(b))

fn main() =
  s = read_line()

  fn ws(i) = if i < #s && is_space(s[i]) then ws(i + 1) else i

  fn digits(i) = if i < #s && s[i] >= 48 && s[i] <= 57 then digits(i + 1) else i

  fn pint(i) =
    a = if s[i] == 45 then i + 1 else i
    j = digits(a)
    if j == a then die("unexpected character", i) else (JInt(str_to_int(s[i:j])), j)

  fn plit(i, lit, v) =
    if i + #lit <= #s && s[i:i + #lit] == lit then (v, i + #lit) else die("unexpected character", i)

  fn sesc(acc: StrBuf, i) =
    if i >= #s then die("unterminated string", i)
    else
      c = s[i]
      if c == 34 || c == 92 || c == 47 then sadd(acc, i, c) else if c == 110 then sadd(acc, i, 10) else if c == 116 then sadd(acc, i, 9) else if c == 114 then sadd(acc, i, 13) else if c == 98 then sadd(acc, i, 8) else if c == 102 then sadd(acc, i, 12) else die("bad escape", i)

  fn sadd(acc: StrBuf, i, piece) =
    acc += piece
    sbody(acc, i + 1)

  fn sbody(acc: StrBuf, i) =
    if i >= #s then die("unterminated string", i)
    else
      c = s[i]
      if c == 34 then (strbuf_str(acc), i + 1) else if c == 92 then sesc(acc, i + 1) else sadd(acc, i, c)

  fn parse(i0) =
    i = ws(i0)
    if i >= #s then die("unexpected end of input", i)
    else
      c = s[i]
      if c == 110 then plit(i, "null", JNull)
      else if c == 116 then plit(i, "true", JBool(true))
      else if c == 102 then plit(i, "false", JBool(false))
      else if c == 34 then
        (x, j) = sbody(strbuf(), i + 1)
        (JStr(x), j)
      else if c == 91 then parr(ws(i + 1), Nil) else if c == 123 then pobj(ws(i + 1), Nil) else if c == 45 || c >= 48 && c <= 57 then pint(i) else die("unexpected character", i)

  fn parr(i, acc) =
    if i < #s && s[i] == 93 then (JArr(Nil), i + 1)
    else
      (v, j) = parse(i)
      asep(ws(j), Cons(v, acc))

  fn asep(i, acc) =
    if i >= #s then die("expected ',' or ']'", i)
    else if s[i] == 44 then
      (v, j) = parse(ws(i + 1))
      asep(ws(j), Cons(v, acc))
    else if s[i] == 93 then (JArr(reverse(acc)), i + 1) else die("expected ',' or ']'", i)

  fn pobj(i, acc) = if i < #s && s[i] == 125 then (JObj(Nil), i + 1) else pkey(i, acc)

  fn pkey(i, acc) =
    if i >= #s || s[i] != 34 then die("unexpected character", i)
    else
      (k, j) = sbody(strbuf(), i + 1)
      c = ws(j)
      if c >= #s || s[c] != 58 then die("expected ':'", c)
      else
        (v, j2) = parse(c + 1)
        osep(ws(j2), Cons(Fld(k, v), acc))

  fn osep(i, acc) =
    if i >= #s then die("expected ',' or '}'", i) else if s[i] == 44 then pkey(ws(i + 1), acc) else if s[i] == 125 then (JObj(reverse(acc)), i + 1) else die("expected ',' or '}'", i)

  (v, j) = parse(0)
  i = ws(j)
  if i < #s then die("trailing content", i) else print_doc(v)
