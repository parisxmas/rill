type J
  JNull
  JBool(Bool)
  JInt(Int)
  JStr(Str)
  JArr(List(J))
  JObj(List(Field))

type Field
  Fld(Str, J)

fn die(msg, i) =
  println("error at " + int_to_str(i + 1) + ": " + msg)
  exit(1)
  die(msg, i)

fn esc1(c) =
  if c == 34 then "\\\"" else if c == 92 then "\\\\" else if c == 10 then "\\n" else if c == 9 then "\\t" else if c == 13 then "\\r" else if c == 8 then "\\b" else if c == 12 then "\\f" else chr(c)

fn quote(x) =
  fn go(i, acc) = if i >= #x then acc else go(i + 1, acc + esc1(x[i]))

  "\"" + go(0, "") + "\""

fn show_f(f) = match f
  Fld(k, v) -> quote(k) + ":" + show_j(v)

fn show_j(v) = match v
  JNull -> "null"
  JBool(b) -> if b then "true" else "false"
  JInt(n) -> int_to_str(n)
  JStr(x) -> quote(x)
  JArr(xs) -> "[" + join(map(xs, \e -> show_j(e)), ",") + "]"
  JObj(fs) -> "{" + join(map(fs, \f -> show_f(f)), ",") + "}"

fn main() =
  s = read_line()

  fn ws(i) = if i < #s && is_space(s[i]) then ws(i + 1) else i

  fn digits(i) = if i < #s && s[i] >= 48 && s[i] <= 57 then digits(i + 1) else i

  fn pint(i) =
    a = if s[i] == 45 then i + 1 else i
    j = digits(a)
    if j == a then die("unexpected character", i) else (JInt(str_to_int(s[i:j])), j)

  fn plit(i, lit, v) =
    if i + #lit <= #s && s[i:i + #lit] == lit then (v, i + #lit) else die("unexpected character", i)

  fn sesc(i, acc) =
    if i >= #s then die("unterminated string", i)
    else
      c = s[i]
      if c == 34 || c == 92 || c == 47 then sbody(i + 1, acc + chr(c)) else if c == 110 then sbody(i + 1, acc + "\n") else if c == 116 then sbody(i + 1, acc + "\t") else if c == 114 then sbody(i + 1, acc + "\r") else if c == 98 then sbody(i + 1, acc + chr(8)) else if c == 102 then sbody(i + 1, acc + chr(12)) else die("bad escape", i)

  fn sbody(i, acc) =
    if i >= #s then die("unterminated string", i)
    else
      c = s[i]
      if c == 34 then (acc, i + 1) else if c == 92 then sesc(i + 1, acc) else sbody(i + 1, acc + chr(c))

  fn parse(i0) =
    i = ws(i0)
    if i >= #s then die("unexpected end of input", i)
    else
      c = s[i]
      if c == 110 then plit(i, "null", JNull)
      else if c == 116 then plit(i, "true", JBool(true))
      else if c == 102 then plit(i, "false", JBool(false))
      else if c == 34 then
        (x, j) = sbody(i + 1, "")
        (JStr(x), j)
      else if c == 91 then parr(ws(i + 1), Nil) else if c == 123 then pobj(ws(i + 1), Nil) else if c == 45 || c >= 48 && c <= 57 then pint(i) else die("unexpected character", i)

  fn parr(i, acc) =
    if i < #s && s[i] == 93 then (JArr(Nil), i + 1)
    else
      (v, j) = parse(i)
      asep(ws(j), Cons(v, acc))

  fn asep(i, acc) =
    if i >= #s then die("expected ',' or ']'", i)
    else if s[i] == 44 then
      (v, j) = parse(ws(i + 1))
      asep(ws(j), Cons(v, acc))
    else if s[i] == 93 then (JArr(reverse(acc)), i + 1) else die("expected ',' or ']'", i)

  fn pobj(i, acc) = if i < #s && s[i] == 125 then (JObj(Nil), i + 1) else pkey(i, acc)

  fn pkey(i, acc) =
    if i >= #s || s[i] != 34 then die("unexpected character", i)
    else
      (k, j) = sbody(i + 1, "")
      c = ws(j)
      if c >= #s || s[c] != 58 then die("expected ':'", c)
      else
        (v, j2) = parse(c + 1)
        osep(ws(j2), Cons(Fld(k, v), acc))

  fn osep(i, acc) =
    if i >= #s then die("expected ',' or '}'", i) else if s[i] == 44 then pkey(ws(i + 1), acc) else if s[i] == 125 then (JObj(reverse(acc)), i + 1) else die("expected ',' or '}'", i)

  (v, j) = parse(0)
  i = ws(j)
  if i < #s then die("trailing content", i) else println(show_j(v))
