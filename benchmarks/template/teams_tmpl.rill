module teams_tmpl

# Generated from benchmarks/template/teams.tmpl by tools/tmplgen.rill — do not edit.
import "web/tmpl"
import "teamdata"

fn teams(b: StrBuf, year, teams: List(Team)) =
  b += "<html>\n  <head>\n    <title>"
  render(b, year)
  b += "</title>\n  </head>\n  <body>\n    <h1>CSL "
  render(b, year)
  b += "</h1>\n    <ul>\n    "
  fn each0(l0, idx) = match l0
    Nil -> ()
    Cons(team, rest0) ->
      b += "\n      <li class=\""
      if idx == 0 then
        b += "champion"
        ()
      else ()
      b += "\">\n      <b>"
      render(b, team.name)
      b += "</b>: "
      render(b, team.score)
      b += "\n      </li>\n    "
      each0(rest0, idx + 1)
  each0(teams, 0)
  b += "\n    </ul>\n  </body>\n</html>\n"
  ()
