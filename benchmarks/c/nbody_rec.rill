# The same five bodies as records in a list: what a functional program writes.
# Every step builds five new Body values and a new list.
extern "m" fn sqrt(x: Float) -> Float

type Body
  B(x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, m: Float)

fn kick(b: Body, os: List(Body), dt, ax, ay, az) = match os
  Nil -> B(b.x, b.y, b.z, ax, ay, az, b.m)
  Cons(o, rest) ->
    dx = b.x - o.x
    dy = b.y - o.y
    dz = b.z - o.z
    d2 = dx * dx + dy * dy + dz * dz
    if d2 == 0.0 then kick(b, rest, dt, ax, ay, az)
    else
      mag = dt / (d2 * sqrt(d2))
      kick(b, rest, dt, ax - dx * o.m * mag, ay - dy * o.m * mag, az - dz * o.m * mag)

fn drift(b: Body, dt) = B(b.x + dt * b.vx, b.y + dt * b.vy, b.z + dt * b.vz, b.vx, b.vy, b.vz, b.m)

fn step_one(b: Body, bodies, dt) = drift(kick(b, bodies, dt, b.vx, b.vy, b.vz), dt)

fn advance(bodies, dt) = map(bodies, \b -> step_one(b, bodies, dt))

fn pot(b: Body, os: List(Body), e) = match os
  Nil -> e
  Cons(o, rest) ->
    dx = b.x - o.x
    dy = b.y - o.y
    dz = b.z - o.z
    d2 = dx * dx + dy * dy + dz * dz
    if d2 == 0.0 then pot(b, rest, e) else pot(b, rest, e - 0.5 * b.m * o.m / sqrt(d2))

fn kin(b: Body) = 0.5 * b.m * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)

fn energy(bodies: List(Body)) = fold(bodies, 0.0, \e, b -> pot(b, bodies, e + kin(b)))

fn momentum(bodies: List(Body), f) = fold(bodies, 0.0, \p, b -> p + f(b) * b.m)

fn vx_of(b: Body) = b.vx

fn vy_of(b: Body) = b.vy

fn vz_of(b: Body) = b.vz

fn body(bx, by, bz, bvx, bvy, bvz, bm) =
  dpy = 365.24
  sm = 4.0 * 3.141592653589793 * 3.141592653589793
  B(bx, by, bz, bvx * dpy, bvy * dpy, bvz * dpy, bm * sm)

fn run(bodies, k, dt) = if k == 0 then bodies else run(advance(bodies, dt), k - 1, dt)

fn main() =
  sm = 4.0 * 3.141592653589793 * 3.141592653589793
  planets = Cons(body(4.841431442464721, -1.1603200440274284, -0.10362204447112311, 0.001660076642744037, 0.007699011184197404, -0.0000690460016972063, 0.0009547919384243266), Cons(body(8.34336671824458, 4.124798564124305, -0.4035234171143214, -0.002767425107268624, 0.004998528012349172, 0.000023041729757376393, 0.0002858859806661308), Cons(body(12.894369562139131, -15.111151401698631, -0.22330757889265573, 0.002964601375647616, 0.0023784717395948095, -0.000029658956854023756, 0.00004366244043351563), Cons(body(15.379697114850917, -25.919314609987964, 0.17925877295037118, 0.0026806777249038932, 0.001628241700382423, -0.00009515922545197159, 0.000051513890204661145), Nil))))

  px = momentum(planets, vx_of)
  py = momentum(planets, vy_of)
  pz = momentum(planets, vz_of)
  sun = B(0.0, 0.0, 0.0, 0.0 - px / sm, 0.0 - py / sm, 0.0 - pz / sm, sm)
  bodies = Cons(sun, planets)
  println(to_int(energy(bodies) * 1000000000.0))
  final = run(bodies, 1000000, 0.01)
  println(to_int(energy(final) * 1000000000.0))
