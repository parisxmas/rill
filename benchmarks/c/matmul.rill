fn main() =
  n = 500
  a = buf_float(n * n)
  b = buf_float(n * n)
  c = buf_float(n * n)

  for i in 0..n
    for j in 0..n
      a[i * n + j] = to_float(i * j % 10)
      b[i * n + j] = to_float((i + j) % 10)

  for i in 0..n
    for k in 0..n
      aik = a[i * n + k]
      for j in 0..n
        c[i * n + j] += aik * b[k * n + j]

  s = for i in 0..n * n with acc = 0.0
    acc + c[i]
  println(to_int(s))
