extern "m" fn sqrt(x: Float) -> Float

fn a(i, j) = 1.0 / to_float((i + j) * (i + j + 1) / 2 + i + 1)

fn main() =
  n = 2000
  u = buf_float(n)
  v = buf_float(n)
  t = buf_float(n)

  fn au(src: Buf(Float), dst: Buf(Float)) =
    for i in 0..n
      dst[i] = for j in 0..n with s = 0.0
        s + a(i, j) * src[j]

  fn atu(src: Buf(Float), dst: Buf(Float)) =
    for i in 0..n
      dst[i] = for j in 0..n with s = 0.0
        s + a(j, i) * src[j]

  fn atau(src, dst) =
    au(src, t)
    atu(t, dst)

  for i in 0..n
    u[i] = 1.0
  for k in 0..10
    atau(u, v)
    atau(v, u)
  vbv = for i in 0..n with s = 0.0
    s + u[i] * v[i]
  vv = for i in 0..n with s = 0.0
    s + v[i] * v[i]
  println(to_int(sqrt(vbv / vv) * 1000000000.0))
