{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*",
  "indentationRules": {
    "increaseIndentPattern": "(^\\s*(type|trait|impl)\\s+\\S.*$)|((=|->|\\bselect|\\bmatch\\s+[^\\s()]+)\\s*(#.*)?$)",
    "decreaseIndentPattern": "(?!)"
  }
}
