# A float prints as the fewest digits that read back as it: `%g` kept six,
# so `0.1 + 0.2` printed `0.3` and no printed float could be trusted to be
# the one computed (2026-09-25). Laid out as `%g` lays it out — no exponent
# from 1e-4 up to where the digits end, no point with nothing after it — so
# a number of six digits or fewer prints as it always did.

fn main() =
  println(0.1 + 0.2)
  println(3.0)
  println(-0.0)
  println(2.5)
  println(100001.0)
  println(1000000.0)
  println(1234567.0)
  println(123456789012345680.0)
  println(to_float(9007199254740993))
  println(0.0001)
  println(0.00001)
  println(.0)
  println(0.)
  println(0.0 / 0.0)
  println(1.0 / 0.0)
  println(-1.0 / 0.0)
  println(3.14159)
  println(12.566370614359172)
  println(float2(1.5, 0.1 + 0.2))
