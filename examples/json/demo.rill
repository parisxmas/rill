import "json"

fn main() =
  doc = parse("{\"user\":{\"name\":\"ada\",\"age\":36},\"tags\":[\"x\",\"y\"],\"ok\":true,\"pi\":3.5}")
  println(as_str(unwrap_or(path(doc, Cons("user", Cons("name", Nil))), JNull)))
  println(as_float(unwrap_or(path(doc, Cons("user", Cons("age", Nil))), JNull)))
  println(as_bool(unwrap_or(get(doc, "ok"), JNull)))
  println(join(map(items(unwrap_or(get(doc, "tags"), JNull)), \x -> as_str(x)), "+"))
  println(to_string(doc))
  println(to_string(parse("[1,\"a\\nb\",null,false,[2]]")))
