# JSON, written in Rill: a recursive-descent parser and a printer.
#
# Parsing functions return a `Parsed` — the value together with where it
# stopped — because that is how a recursive-descent parser threads position
# through immutable data.

type Json
  JNull
  JBool(Bool)
  JInt(Int)
  JNum(Float)
  JStr(Str)
  JArr(List(Json))
  JObj(List(Field))

type Field
  Field(key: Str, value: Json)

type Parsed
  Parsed(value: Json, pos: Int)

# -- parsing ------------------------------------------------------------------

fn parse(text) = match parse_value(text, skip_ws(text, 0))
  Parsed(v, _) -> v

fn skip_ws(s, i) = if i < str_len(s) && is_space(str_get(s, i)) then skip_ws(s, i + 1) else i

fn parse_value(s, i) =
  c = str_get(s, i)
  if c == 123 then parse_object(s, skip_ws(s, i + 1), Nil) else if c == 91 then parse_array(s, skip_ws(s, i + 1), Nil) else if c == 34 then parse_string(s, i + 1, "") else if c == 116 then Parsed(JBool(true), i + 4) else if c == 102 then Parsed(JBool(false), i + 5) else if c == 110 then Parsed(JNull, i + 4) else parse_number(s, i)

# `"` is 34, `\` is 92.
fn parse_string(s, i, acc) =
  c = str_get(s, i)
  if c < 0 || c == 34 then Parsed(JStr(acc), i + 1) else if c == 92 then parse_escape(s, i + 1, acc) else parse_string(s, i + 1, acc + chr(c))

fn parse_escape(s, i, acc) =
  c = str_get(s, i)
  if c == 110 then parse_string(s, i + 1, acc + "\n") else if c == 116 then parse_string(s, i + 1, acc + "\t") else if c == 114 then parse_string(s, i + 1, acc + "\r") else if c == 117 then parse_unicode(s, i + 1, acc) else parse_string(s, i + 1, acc + chr(c))

# Only the Latin-1 range is turned back into a byte; anything above it becomes
# `?`, which is honest about this being a byte-oriented string type.
fn parse_unicode(s, i, acc) =
  v = hex4(s, i)
  parse_string(s, i + 4, acc + (if v < 256 then chr(v) else "?"))

fn hex4(s, i) =
  hex_digit(str_get(s, i)) * 4096 + hex_digit(str_get(s, i + 1)) * 256 + hex_digit(str_get(s, i + 2)) * 16 + hex_digit(str_get(s, i + 3))

fn hex_digit(c) =
  if c >= 48 && c <= 57 then c - 48 else if c >= 97 && c <= 102 then c - 87 else if c >= 65 && c <= 70 then c - 55 else 0

fn parse_number(s, i) =
  j = number_end(s, i)
  Parsed(number_of(str_sub(s, i, j - i)), j)

# JSON has a single number type, but a document id or a count is exact and a
# measurement is not. A literal that never showed a decimal point or an
# exponent stays an integer, so it prints back exactly the way it arrived —
# `%g` would turn an id of 1234567 into 1.23457e+06.
fn number_of(text) =
  if is_integral(text) then JInt(str_to_int(text)) else JNum(str_to_float(text))

fn is_integral(text) =
  str_find(text, ".") < 0 && str_find(text, "e") < 0 && str_find(text, "E") < 0

fn number_end(s, i) =
  c = str_get(s, i)
  if is_number_char(c) then number_end(s, i + 1) else i

fn is_number_char(c) = c >= 48 && c <= 57 || c == 45 || c == 43 || c == 46 || c == 101 || c == 69

# `]` is 93, `,` is 44.
fn parse_array(s, i, acc) =
  if str_get(s, i) == 93 then Parsed(JArr(reverse(acc)), i + 1) else array_item(s, i, acc)

fn array_item(s, i, acc) = match parse_value(s, i)
  Parsed(v, j) -> array_next(s, skip_ws(s, j), Cons(v, acc))

fn array_next(s, i, acc) =
  if str_get(s, i) == 44 then parse_array(s, skip_ws(s, i + 1), acc) else parse_array(s, i, acc)

# `}` is 125, `:` is 58.
fn parse_object(s, i, acc) =
  if str_get(s, i) == 125 then Parsed(JObj(reverse(acc)), i + 1) else object_key(s, i, acc)

fn object_key(s, i, acc) = match parse_string(s, i + 1, "")
  Parsed(k, j) -> object_value(s, skip_ws(s, j), k, acc)

# `i` is at the `:` that follows the key.
fn object_value(s, i, key, acc) = object_pair(s, skip_ws(s, i + 1), key, acc)

fn object_pair(s, i, key, acc) = match parse_value(s, i)
  Parsed(v, j) -> object_next(s, skip_ws(s, j), Cons(Field(key_text(key), v), acc))

fn key_text(k) = match k
  JStr(t) -> t
  _ -> ""

fn object_next(s, i, acc) =
  if str_get(s, i) == 44 then parse_object(s, skip_ws(s, i + 1), acc) else parse_object(s, i, acc)

# -- printing -----------------------------------------------------------------

fn to_string(j) = match j
  JNull -> "null"
  JBool(b) -> bool_to_str(b)
  JInt(n) -> int_to_str(n)
  JNum(n) -> float_to_str(n)
  JStr(t) -> "\"" + escape(t, 0, "") + "\""
  JArr(items) -> "[" + join(map(items, \x -> to_string(x)), ",") + "]"
  JObj(fields) -> "{" + join(map(fields, \f -> field_string(f)), ",") + "}"

fn field_string(f) = match f
  Field(k, v) -> "\"" + escape(k, 0, "") + "\":" + to_string(v)

fn escape(s, i, acc) =
  if i >= str_len(s) then acc else escape(s, i + 1, acc + escape_byte(str_get(s, i)))

fn escape_byte(c) =
  if c == 34 then "\\\"" else if c == 92 then "\\\\" else if c == 10 then "\\n" else if c == 9 then "\\t" else if c == 13 then "\\r" else chr(c)

# -- reading values out -------------------------------------------------------

fn get(j, key) = match j
  JObj(fields) -> field_lookup(fields, key)
  _ -> None

fn field_lookup(fields, key) = match fields
  Nil -> None
  Cons(f, rest) -> match f
    Field(k, v) -> if k == key then Some(v) else field_lookup(rest, key)

fn items(j) = match j
  JArr(xs) -> xs
  _ -> Nil

fn as_str(j) = match j
  JStr(t) -> t
  _ -> ""

fn as_float(j) = match j
  JNum(n) -> n
  JInt(n) -> str_to_float(int_to_str(n))
  _ -> 0.0

# For values that arrived as integers — ids, counts, versions. A `JNum` has no
# exact integer to give back, so it answers 0 rather than rounding silently.
fn as_int(j) = match j
  JInt(n) -> n
  _ -> 0

fn as_bool(j) = match j
  JBool(b) -> b
  _ -> false

# Walks a path of object keys: `path(doc, Cons("user", Cons("name", Nil)))`.
fn path(j, keys) = match keys
  Nil -> Some(j)
  Cons(k, rest) -> match get(j, k)
    None -> None
    Some(v) -> path(v, rest)
