# A TCP echo server and a client, in one program. The server runs on a
# strand and handles each connection on another; a strand waiting on a
# socket parks instead of holding up the worker running it, so this works even
# with a single worker.
fn handle(conn) =
  msg = sock_read(conn)
  if str_len(msg) == 0 then close_conn(conn) else reply(conn, msg)

fn reply(conn, msg) =
  sock_write(conn, "echo: " + msg)
  handle(conn)

fn close_conn(conn) = sock_close(conn)

fn serve(server, remaining) =
  conn = tcp_accept(server)
  spawn handle(conn)
  if remaining == 1 then sock_close(server) else serve(server, remaining - 1)

fn talk(port, what) =
  fd = tcp_connect("127.0.0.1", port)
  sock_write(fd, what)
  answer = sock_read(fd)
  sock_close(fd)
  answer

# Port 0 asks the kernel for a free one and `sock_port` says which it gave,
# so this runs on a machine that already has something on the port a fixed
# number would have named.
fn main() = match listen_on(0)
  Err(e) -> println(e)
  Ok(server) -> run(server, sock_port(server))

fn run(server, port) =
  spawn serve(server, 2)
  println(trim(talk(port, "merhaba")))
  println(trim(talk(port, "dunya")))
