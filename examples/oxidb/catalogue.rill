# A hundred thousand documents in OxiDB, and an HTTP server in front of them.
#
# Three libraries meet here and none of them knows about the others:
# `oxidb.rill` speaks the database's binary wire, `http.rill` speaks HTTP/1.1,
# `catalogue.tmpl` is the page, and what is written below is only the joining —
# a URL turned into a query, an answer turned into JSON or into a view the
# template can lay out.
#
#     oxidb-server &                      # the document engine is on by default
#     ./catalogue 4444                    # seeds if needed, then serves
#     ./catalogue 4444 8123               # or on the port you name
#     ./catalogue 4444 8123 fresh         # and build the collection again
#
# `/` is a page a browser can use: a form for the filters, a table, and a
# pager. Everything else answers JSON, so the same server serves both.
#
# The page is whole before any script runs, and works with none: a filter is a
# form submit and a pager step is a link. `static/catalogue.js` is what makes
# it live — zap, a signals library, takes both halves over with its own
# components: `Select` and `Button` in the toolbar, `DataGrid` for the table,
# which sorts, filters and pages a window of rows without asking the server
# anything. What the server rendered is held back until they are in, so the
# page is not painted twice, and let through anyway if the script never
# arrives. Where the line falls is the interesting part: the DATABASE answers
# which of a hundred thousand documents match, with an index behind every
# field the form offers, and the GRID holds one window of that answer.
# `/rows` is that window as JSON, and it is in the page already — the server
# puts what it just rendered into a `<script type="application/json">`, so the
# client starts from what is on the screen rather than asking for it again. It
# carries what it cost to make, too: the grid shows the database's time and
# the writing's beside its row count.
#
# The grid groups, too: a column header dragged onto the panel above the
# table folds the rows into groups, and every level of that tree is
# `/rows?group=<field>` with the path down to it as filters — one pipeline in
# the database, the count and the aggregates of every matching document, and
# paged like the documents are. See "grouping" below.
#
# The table is editable. A cell opens the editor its column's type asks for —
# a number field, the calendar, a list — and what comes out is a `POST
# /doc/<sku>` naming one field. The rules are written twice on purpose: the
# grid stops you at sixty characters while you type, and `refused` below
# checks the same limits again before anything is written, because a request
# need not have come from the page. A refusal comes back as the reason, the
# grid puts the old value back and shows it on the cell, and a write that
# lands answers with how long the database took — which is what the little
# notice in the corner of the page is counting.
#
# The page is a template rather than markup built by hand, and it is four of
# them: `catalogue.tmpl` is the page, and it includes the form, the table and
# the pager — `<% include catalogue_table(v.rows) %>` is the call
# `catalogue_table(b, v.rows)`, the same builder and the rows handed over.
# `tools/tmplgen.rill` compiles each one to the Rill checked in beside it, and
# that Rill is compiled with the rest of this program. Nothing is parsed or
# looked up by name while a page is being rendered:
#
#     rill build tools/tmplgen.rill -o tmplgen
#     for t in catalogue catalogue_form catalogue_table catalogue_nav; do
#       ./tmplgen examples/oxidb/$t.tmpl examples/oxidb/${t}_tmpl.rill
#     done
#
#     open http://127.0.0.1:8123/
#     curl 127.0.0.1:8123/count
#     curl '127.0.0.1:8123/find?role=eng&limit=3'
#     curl '127.0.0.1:8123/top?by=score&limit=5'
#     curl 127.0.0.1:8123/doc/42
#
# Seeding is a thousand documents a frame: one round trip per batch rather
# than per document. A hundred thousand of them go in in 624 ms and the four
# indexes take 466 more, after which every route below answers in about a
# third of a millisecond. Without the indexes the same routes take 15 ms to
# find one document and 471 to sort by a field, because each is then a read
# of all hundred thousand — which is the whole argument for an index, in two
# numbers.
#
# The pager asks for a page by counting past the ones before it, which is
# what `skip` is and what every offset pager pays: page 1 answers in 0.4 ms,
# page 100 in 0.5, page 1000 in 1.4, and page 3900 — ninety-seven thousand
# documents counted past — in 95. A pager that stayed fast at the end would
# carry the last key it saw rather than a number, and ask for what comes
# after it; this one is the shape a URL wants to be.
#
# Behind a proxy, which is where a server like this usually sits: nginx talks
# HTTP/1.1 to its upstream and there is no version of `proxy_pass` that talks
# HTTP/2, so the wire between them is this one. Two lines make it keep the
# connection, which is worth about 70% here — a connection per request
# measured 3,300 requests a second against 5,600:
#
#     proxy_http_version 1.1;
#     proxy_set_header Connection "";
#
# And `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`, which is
# what the rate limiter counts by; without it every caller is the same one.
#
# The connections to the database are sixteen, handed round on a channel: a
# request takes one, uses it, and puts it back, and a request that finds none
# waits — which is the backpressure a server wants anyway. Opening one per
# request is what this did first, and it survived a browser and died under
# load: at four thousand requests a second, each leaving a closed socket in
# TIME_WAIT for a minute, sixteen thousand of them piled up, the machine ran
# out of ports, and nine requests in ten came back 502. Sixteen is where the
# measurements settled — four gives 3,300 requests a second, eight 4,900,
# sixteen 5,600, and thirty-two no more of them but a fourfold worse tail.
#
# The HTTP side is `http.rill`'s: one strand per connection, keep-alive, and
# a connection parked on a slow client costs nothing. A hundred people
# searching at once are a hundred strands on one worker: 5,600 searches a
# second, half of them answered inside 18 ms, none failed. Five hundred at
# once is the same 5,400 a second with the queue in the latency — 92 ms —
# which is what saturation looks like when nothing is breaking. More workers
# do not help: at this size the work is a round trip to the database and back,
# not arithmetic.
import "oxidb"
import "http" as h
import "catview"
import "ws"
import "catalogue_page"

# How many documents to seed when the collection is empty, unless a number is
# given on the command line. A hundred thousand is enough to make an index the
# difference between a page and a wait; the shape of the example does not
# change at two million, only the numbers do.
fn total() = 100000

fn batch() = 1000

fn collection() = "catalogue"

fn main() = match args()
  Cons(_, Cons(db, rest)) -> start(str_to_int(db), wanted_port(rest), asked_fresh(rest), asked_count(rest))
  _ -> usage()

fn usage() =
  println("usage: catalogue <oxidb-port> [http-port]")
  println("  needs an oxidb-server; the document engine is on by default.")

fn wanted_port(rest) = match rest
  Cons(p, _) -> str_to_int(p)
  Nil -> 0

# `fresh` anywhere after the ports: build the collection again even if it is
# already there.
fn asked_fresh(rest) = match rest
  Nil -> false
  Cons(a, more) -> a == "fresh" || asked_fresh(more)

# `fresh 2000000` — how many to build. Anything else, or nothing, is the
# usual hundred thousand.
fn asked_count(rest) = match rest
  Nil -> total()
  Cons(a, more) -> if a == "fresh" then first_number(more) else asked_count(more)

fn first_number(rest) = match rest
  Nil -> total()
  Cons(a, _) -> if str_to_int(a) > 0 then str_to_int(a) else total()

# -- seeding ------------------------------------------------------------------

fn start(db, want, fresh, count) = match dial("127.0.0.1", db)
  Err(e) -> println("oxidb: " + e)
  Ok(fd) -> seed_then_serve(fd, db, want, fresh, count)

# The documents outlive the server. A restart that wiped them would be a
# restart that threw away everything anyone had edited, and would cost a
# second and a half to say nothing new — so the collection is counted first,
# and seeded only if it is not already there. `./catalogue 4444 8123 fresh`
# asks for it to be built again.
fn seed_then_serve(fd, db, want, fresh, count) =
  if !fresh && already(fd) then
    println("catalogue is already there, left as it is")
    ready_to_serve(fd, db, want)
  else
    println("clearing " + collection())
    drop_all(fd)
    println("seeding " + int_to_str(count) + " documents")
    t0 = now_nanos()
    fill_batches(fd, 0, count)
    println("seeded in " + int_to_str((now_nanos() - t0) / 1000000) + " ms")
    # An index apiece on what the routes below ask by and sort on. Without
    # them every request reads a hundred thousand documents: `/top?by=score`
    # took 471 ms and takes 3 with one.
    t2 = now_nanos()
    index_on(fd, "sku")
    index_on(fd, "role")
    index_on(fd, "region")
    index_on(fd, "score")
    println("indexed in " + int_to_str((now_nanos() - t2) / 1000000) + " ms")
    ready_to_serve(fd, db, want)

fn ready_to_serve(fd, db, want) =
  shown("count", count(fd, collection()), \d -> int_to_str(counted(d)))
  hang_up(fd)
  serve_on(db, want)

# Anything at all, rather than a particular number: a collection that has been
# edited, or seeded to another size, is still a collection that is there.
fn already(fd) = match count(fd, collection())
  Err(_) -> false
  Ok(d) -> counted(d) > 0

fn drop_all(fd) = match delete(fd, collection(), JObj(Nil))
  Err(e) ->
    println("delete: " + e)
    0
  Ok(_) -> 0

fn index_on(fd, name) = match create_index(fd, collection(), name)
  Err(e) ->
    println("create_index " + name + ": " + e)
    0
  Ok(_) -> 0

# A batch at a time until the whole run is in.
fn fill_batches(fd, from, count) =
  if from >= count then 0
  else
    n = if count - from < batch() then count - from else batch()
    send_batch(fd, from, n)
    fill_batches(fd, from + n, count)

fn send_batch(fd, from, n) = match insert_many(fd, collection(), batch_docs(from, n))
  Err(e) ->
    println("insert_many at " + int_to_str(from) + ": " + e)
    0
  Ok(_) -> 0

fn batch_docs(from, n) =
  for k in 0..n with acc = Nil
    Cons(one_doc(from + n - 1 - k), acc)

# Made from the number alone, so a query's answer is predictable: role and
# region cycle, the score is a scramble of the id, and the name carries it.
fn one_doc(i) =
  JObj(Cons(field("sku", int(i)), Cons(field("name", text("item-" + int_to_str(i))), Cons(field("role", text(role_of(i))), Cons(field("region", text(region_of(i))), Cons(field("score", JNum(score_of(i))), Cons(field("stock", int(i % 97)), Cons(field("added", text(added_of(i))), Nil))))))))

# A date apiece, cycling, so it is always a real one and always the same one.
fn added_of(i) = "2026-" + two_digits(1 + i % 12) + "-" + two_digits(1 + i % 28)

fn two_digits(n) = if n < 10 then "0" + int_to_str(n) else int_to_str(n)

fn role_of(i) = nth_or(Cons("eng", Cons("ops", Cons("sre", Cons("design", Nil)))), i % 4, "eng")

fn region_of(i) = nth_or(Cons("eu", Cons("us", Cons("apac", Nil))), i % 3, "eu")

fn score_of(i) = to_float(i * 7919 % 10007) / 100.0

fn nth_or(l, i, fallback) = unwrap_or(nth(l, i), fallback)

# -- serving ------------------------------------------------------------------

fn serve_on(db, want) = match listen_on(want)
  Err(e) -> println(e)
  Ok(server) -> announce(server, db, sock_port(server))

fn announce(server, db, port) =
  println("http://127.0.0.1:" + int_to_str(port) + "/  — try /count, /find?role=eng&limit=3, /top?by=score&limit=5, /doc/42")
  pool = build_pool(db, connections())
  # The writes are the ones that reach the database, so they are the ones that
  # are counted. A middleware is a layer around the handler and `wrap` puts
  # the list on in order, outermost first.
  kept = map_new()
  watching = map_new()
  cell = weight_cell()
  # Once before the doors open, so the first page has real numbers in it.
  # The cell is two words one strand writes and every handler reads — shared
  # on purpose, which a `--parallel` build asks the program to say.
  weigh_once(pool, cell)
  spawn weigh_every(pool, apart(cell))
  answer = h.wrap(Cons(h.rate_limit(writes_a_second()), Nil), \req -> route(pool, kept, watching, cell, req))
  h.serve_taking(server, answer, \conn, raw -> live(watching, conn, raw))

fn writes_a_second() = 20

# -- routing ------------------------------------------------------------------

fn connections() = 16

# The pool: a buffered channel holding open connections. It is built once,
# before the first request, and the handler closes over it.
fn build_pool(db, n) =
  ch = channel(n)
  fill_pool(ch, db, n)
  ch

fn fill_pool(ch, db, n) =
  if n <= 0 then 0 else match dial("127.0.0.1", db)
    Err(e) ->
      println("pool: " + e)
      0
    Ok(fd) ->
      send(ch, fd)
      fill_pool(ch, db, n - 1)

# A write arrives as a POST and nothing else does: a link cannot change a
# document, whatever it says.
fn route(pool, kept, watching, cell, req: h.Request) =
  if req.method == "POST" then with_db(pool, \fd -> answer_edit(fd, watching, path_of(req.path), req.body)) else dispatch(pool, kept, cell, path_of(req.path), query_of(req.path), h.header(req, "if-none-match"))

# `POST /doc/<sku>` with `{"field": ..., "value": ...}` — one cell of one
# document, which is what the grid sends when a cell is edited.
fn answer_edit(fd, watching, path, body) =
  if starts_with(path, "/doc/") then edit_doc(fd, watching, str_to_int(str_sub(path, 5, str_len(path))), parse(body)) else h.json_response(404, "{\"error\":\"nothing to write there\"}")

fn edit_doc(fd, watching, sku, body) = match body
  Err(e) -> h.json_response(400, "{\"error\":\"" + e + "\"}")
  Ok(j) -> apply_edit(fd, watching, sku, as_str(unwrap_or(get(j, "field"), JNull)), unwrap_or(get(j, "value"), JNull))

fn apply_edit(fd, watching, sku, name, value) =
  refusal = refused(name, value)
  if str_len(refusal) > 0 then h.json_response(400, "{\"error\":\"" + refusal + "\"}") else write_field(fd, watching, sku, name, value)

fn write_field(fd, watching, sku, name, value) =
  t0 = now_nanos()
  match update(fd, collection(), JObj(Cons(field("sku", int(sku)), Nil)), set(Cons(Field(name, value), Nil)))
    Err(e) -> failed(e)
    Ok(_) ->
      told(watching, sku, name, value)
      h.json_response(200, "{\"ok\":true,\"db_us\":" + int_to_str((now_nanos() - t0) / 1000) + "}")

# -- what the others are looking at -----------------------------------------------
#
# A page that changed a document is not the only one showing it. Every browser
# that has this collection open holds a socket here and says which documents
# are on its screen; when one of them is written, the change goes to exactly
# those and to nobody else. A page looking at another part of the catalogue is
# not told anything at all — the point is not to broadcast, it is to tell the
# few who can see the difference.
fn live(watching, conn, raw) =
  if !ws_wanted(raw) then false
  else
    ws_accept(conn, raw)
    map_set(watching, conn, Nil)
    watch_loop(watching, conn)
    true

# `{"skus": [0, 12, 24]}` — what this page can see, sent again whenever it
# changes. The socket says nothing else.
fn watch_loop(watching, conn) =
  msg = ws_read(conn)
  if str_len(msg) == 0 then
    map_del(watching, conn)
    sock_close(conn)
  else
    map_set(watching, conn, skus_of(msg))
    watch_loop(watching, conn)

fn skus_of(msg) = match parse(msg)
  Err(_) -> Nil
  Ok(j) -> numbers(as_arr(unwrap_or(get(j, "skus"), JArr(Nil))))

fn as_arr(j) = match j
  JArr(items) -> items
  _ -> Nil

fn numbers(items) = match items
  Nil -> Nil
  Cons(x, rest) -> Cons(as_int(x), numbers(rest))

fn told(watching, sku, name, value) =
  text = "{\"sku\":" + int_to_str(sku) + ",\"field\":\"" + name + "\",\"value\":" + to_string(value) + "}"
  tell_each(map_items(watching), sku, text)

fn tell_each(items, sku, text) = match items
  Nil -> 0
  Cons(one, rest) -> match one
    (conn, skus) ->
      if watching_it(skus, sku) then ws_write(conn, text) else 0
      tell_each(rest, sku, text)

fn watching_it(skus, sku) = match skus
  Nil -> false
  Cons(x, rest) -> x == sku || watching_it(rest, sku)

# What a document may be told, and what it may not. The page enforces the same
# rules while you type, but a request need not have come from the page — so
# these are the ones that count, and the answer is why it was refused or
# nothing at all. `sku` is what a document is found by and `score` is
# computed, so neither is here.
fn refused(name, value) =
  if name == "name" then text_rule(value, 60, "a name") else if name == "role" then one_of(value, Cons("eng", Cons("ops", Cons("sre", Cons("design", Nil)))), "a role") else if name == "region" then one_of(value, Cons("eu", Cons("us", Cons("apac", Nil))), "a region") else if name == "stock" then number_rule(value, 0, 99999, "stock") else if name == "added" then date_rule(value) else "`" + name + "` is not a field this page may change"

fn text_rule(value, most, what) = match value
  JStr(s) ->
    if str_len(trim(s)) == 0 then what + " cannot be empty" else if str_len(s) > most then what + " is at most " + int_to_str(most) + " characters" else ""
  _ -> what + " has to be text"

fn one_of(value, allowed, what) = match value
  JStr(s) -> if listed(allowed, s) then "" else what + " is one of " + join(allowed, ", ")
  _ -> what + " has to be text"

fn listed(l, s) = match l
  Nil -> false
  Cons(x, rest) -> x == s || listed(rest, s)

fn number_rule(value, least, most, what) = match value
  JInt(n) ->
    if n < least then what + " is never below " + int_to_str(least) else if n > most then what + " is at most " + int_to_str(most) else ""
  _ -> what + " has to be a whole number"

# `2026-01-15` and nothing else: ten characters, dashes where dashes go, and a
# month and a day that exist.
fn date_rule(value) = match value
  JStr(s) ->
    if str_len(s) != 10 || str_get(s, 4) != 45 || str_get(s, 7) != 45 then "a date is written 2026-01-15" else if !digits_only(s, 0, 4) || !digits_only(s, 5, 7) || !digits_only(s, 8, 10) then "a date is written 2026-01-15" else month_and_day(str_to_int(str_sub(s, 5, 2)), str_to_int(str_sub(s, 8, 2)))
  _ -> "a date has to be text"

fn month_and_day(month, day) =
  if month < 1 || month > 12 then "there is no month " + int_to_str(month) else if day < 1 || day > 31 then "there is no day " + int_to_str(day) else ""

fn digits_only(s, from, to) =
  for i in from..to with ok = true
    ok && str_get(s, i) >= 48 && str_get(s, i) <= 57

fn dispatch(pool, kept, cell, path, qs, asked) =
  if path == "/" then with_db(pool, \fd -> browse(fd, qs, cell)) else if path == "/rows" then with_db(pool, \fd -> answer_rows(fd, qs)) else if path == "/count" then with_db(pool, \fd -> answer_count(fd)) else if path == "/stat" then answer_stat(cell) else if path == "/find" then with_db(pool, \fd -> answer_find(fd, qs)) else if path == "/top" then with_db(pool, \fd -> answer_top(fd, qs)) else if starts_with(path, "/doc/") then with_db(pool, \fd -> answer_doc(fd, str_to_int(str_sub(path, 5, str_len(path))))) else if starts_with(path, "/static/") then answer_static(kept, str_sub(path, 8, str_len(path)), asked) else h.json_response(404, "{\"error\":\"no route for " + path + "\"}")

# -- what the page pulls in ----------------------------------------------------

# The modules are named rather than joined onto a root, so nothing a URL says
# can reach a file this server was not meant to hand out.
fn answer_static(kept, name, asked) =
  if is_module(name) then serve_module(kept, name, asked) else h.json_response(404, "{\"error\":\"no such file\"}")

# The files the page is allowed to ask for, by name. zap and its component
# set are vendored under `static/` so the example needs nothing installed.
fn is_module(name) =
  name == "catalogue.js" || name == "index.js" || name == "zap.js" || name == "html.js" || name == "router.js" || name == "theme.css" || is_component(name)

fn is_component(name) =
  name == "components/grid.js" || name == "components/pagination.js" || name == "components/select.js" || name == "components/button.js" || name == "components/switch.js" || name == "components/datepicker.js" || name == "components/calendar.js" || name == "components/anchor.js" || name == "components/toast.js"

# Read once and kept: a page pulls in nine files, and going to disk for each
# of them on every load is the same work over and over. What goes back says
# which version it is, so a second visit — and the proxy this will usually sit
# behind — asks with `If-None-Match` and is told 304 rather than sent the file
# again.
#
# `no-cache` rather than `max-age`, because these URLs never change: it does
# not mean "do not keep it", it means "ask before using what you kept". A file
# that changes is then seen at once, which an hour of `max-age` on
# `/static/zap.js` would hide — as it hid one from this very page while it was
# being written.
#
# Run from the repository root or from the example's own directory; both are
# tried, and a server that finds neither says so rather than serving a blank
# page that fails in the browser.
fn serve_module(kept, name, asked) = match map_get(kept, name)
  Some(text) -> module_response(name, text, asked)
  None -> read_module(kept, name, asked)

fn read_module(kept, name, asked) = match first_readable(Cons("examples/oxidb/static/" + name, Cons("static/" + name, Nil)))
  Err(e) -> h.text_response(500, e)
  Ok(text) ->
    map_set(kept, name, text)
    module_response(name, text, asked)

fn module_response(name, text, asked) =
  tag = version_of(text)
  if asked == tag then keepable(h.Response(304, kind_of(name), Nil, ""), tag) else keepable(h.Response(200, kind_of(name), Nil, text), tag)

fn keepable(res, tag) = h.with_header(h.with_header(res, "Cache-Control", "no-cache"), "ETag", tag)

# A quoted version of the bytes: their length and a rolling sum. Two files
# that differ differ in one or the other, and it is one pass over the text
# rather than a hash of everything on every request.
fn version_of(text) =
  sum = for i in 0..str_len(text) with acc = 0
    (acc * 31 + str_get(text, i)) % 2147483647
  chr(34) + int_to_str(str_len(text)) + "-" + int_to_str(sum) + chr(34)

fn kind_of(name) =
  if str_find(name, ".css") > 0 then "text/css; charset=utf-8" else "text/javascript; charset=utf-8"

fn first_readable(paths) = match paths
  Nil -> Err("cannot find the static files — run this from the repository root")
  Cons(p, rest) -> match read_file(p)
    Ok(text) -> Ok(text)
    Err(_) -> first_readable(rest)

# One of the pool's connections for the length of the call, and back
# afterwards whatever the answer was.
fn with_db(pool, ask) =
  fd = recv(pool)
  res = ask(fd)
  send(pool, fd)
  res

# What the two processes are holding: this one's own resident set, and what the
# database says about itself.
#
# It is read once for the whole server rather than once per client. Two words
# of memory hold the last reading, one strand refreshes them on a fixed
# heartbeat, and every page and every `/stat` reads those words. A hundred
# people watching the corner of the page therefore cost exactly what one
# person costs — and, more to the point, the database is asked about itself
# twice a second at most, whatever the traffic, so a page about memory can
# never become the reason there is less of it.
fn weight_cell() = buf_int(2)

fn weigh_ms() = 2000

fn weigh_every(pool, cell) =
  sleep_ms(weigh_ms())
  weigh_once(pool, cell)
  weigh_every(pool, cell)

fn weigh_once(pool, cell) = with_db(pool, \fd -> record_weight(cell, fd))

# Tenths of a megabyte, so what is shared is two whole numbers. -1 says the
# database did not answer, which the page shows as `?` — a truer thing to put
# in a corner about memory than a zero.
fn record_weight(cell: Buf(Int), fd) =
  buf_set(cell, 0, rss_bytes() * 10 / 1048576)
  buf_set(cell, 1, db_tenths(proc_status(fd)))
  0

fn db_tenths(status) = match status
  Err(_) -> 0 - 1
  Ok(d) -> to_int(rss_mb(d) * 10.0)

fn weight_now(cell: Buf(Int)) = Weight(tenths(buf_get(cell, 0)), tenths(buf_get(cell, 1)))

fn tenths(n) = if n < 0 then "?" else int_to_str(n / 10) + "." + int_to_str(n % 10)

# The corner of the page on its own, so the script can keep it current without
# fetching the rest of the page with it. Both numbers go out as text, because
# `?` is one of the things either can be.
fn answer_stat(cell) = match weight_now(cell)
  Weight(rill, db) -> h.json_response(200, "{\"rill_mb\":\"" + rill + "\",\"db_mb\":\"" + db + "\"}")

fn answer_count(fd) = match count(fd, collection())
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, "{\"count\":" + int_to_str(counted(d)) + "}")

fn answer_doc(fd, sku) = match find(fd, collection(), JObj(Cons(field("sku", int(sku)), Nil)))
  Err(e) -> failed(e)
  Ok(d) -> one_or_none(docs(d))

fn one_or_none(list) = match list
  Nil -> h.json_response(404, "{\"error\":\"no such document\"}")
  Cons(doc, _) -> h.json_response(200, to_string(doc))

# `?role=eng&region=eu&limit=10` — every parameter but `limit` is a field the
# document must match.
fn answer_find(fd, qs) = match find_sorted(fd, collection(), JObj(match_fields(qs)), JObj(Cons(field("sku", int(1)), Nil)), limit_of(qs))
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, to_string(JArr(docs(d))))

# `?by=score&limit=5` — the highest by that field.
fn answer_top(fd, qs) = match find_sorted(fd, collection(), JObj(Nil), JObj(Cons(field(by_of(qs), int(0 - 1)), Nil)), limit_of(qs))
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, to_string(JArr(docs(d))))

fn failed(why) = h.json_response(500, "{\"error\":\"" + why + "\"}")

fn limit_of(qs) = at_most(int_or(param(qs, "limit"), 10), 1000)

fn at_most(n, cap) = if n > cap then cap else if n < 1 then 1 else n

fn by_of(qs) = if str_len(param(qs, "by")) == 0 then "score" else param(qs, "by")

fn int_or(s, fallback) = if str_len(s) == 0 then fallback else str_to_int(s)

# Every parameter that is not `limit` or `by` becomes a field to match on. A
# value that reads as a number is matched as one, so `?sku=42` finds the
# document rather than nothing.
fn match_fields(qs) = fields_of(reverse(h.params(qs)), Nil)

fn fields_of(pairs: List(h.Header), acc) = match pairs
  Nil -> acc
  Cons(one, rest) ->
    kept = if is_control(one.name) || str_len(one.value) == 0 then acc else Cons(field(one.name, valued(one.value)), acc)
    fields_of(rest, kept)

# The parameters that steer the page rather than filter the documents.
fn is_control(k) =
  str_len(k) == 0 || k == "limit" || k == "by" || k == "dir" || k == "page" || k == "group"

fn valued(v) = if looks_numeric(v) then int(str_to_int(v)) else text(v)

fn looks_numeric(v) =
  if str_len(v) == 0 then false
  else
    for i in 0..str_len(v) with ok = true
      ok && str_get(v, i) >= 48 && str_get(v, i) <= 57

# -- the target, taken apart ---------------------------------------------------
#
# `path_of`, `query_of`, `param` and `params` are `http.rill`'s: every server
# writes them once and this one used to as well, without the percent-decoding
# that makes a filter with a space in it work.

fn path_of(target) = h.path_of(target)

fn query_of(target) = h.query_of(target)

fn param(qs, key) = h.param(qs, key)

fn shown(label, result, render) = match result
  Err(e) -> println(label + ": error: " + e)
  Ok(data) -> println(label + ": " + render(data))

# -- the page ------------------------------------------------------------------

# `/` renders what `/find` answers, with a form in front of it and a pager
# under it. Nothing here is JavaScript: a link carries the page number and
# the server answers with the page.
fn browse(fd, qs, cell) =
  t0 = now_nanos()
  match shape_of(fd, qs)
    (q, size, total, pages, page, skip) ->
      found = find_page(fd, collection(), q, sorted_by(qs), size, skip)
      answer_page(qs, found, total, page, pages, size, skip, now_nanos() - t0, weight_now(cell))

# What `/` renders, as JSON, for the client that took the page over. It is the
# same question asked the same way — the two answers cannot drift apart,
# because only the last step of each differs. With `group=<field>` it is a
# different question, answered below.
fn answer_rows(fd, qs) =
  if str_len(param(qs, "group")) > 0 then answer_groups(fd, qs) else answer_docs(fd, qs)

fn answer_docs(fd, qs) =
  t0 = now_nanos()
  match shape_of(fd, qs)
    (q, size, total, pages, page, skip) ->
      found = find_page(fd, collection(), q, sorted_by(qs), size, skip)
      rows_json(found, total, page, pages, skip, now_nanos() - t0)

fn rows_json(result, total, page, pages, skip, asked) = match result
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, rows_body(docs(d), total, page, pages, skip, asked))

# One page of results as JSON. `/rows` answers with it and `/` carries it
# inside the page, so the client starts from what it can already see.
#
# The two times are what it cost to produce: `db` is everything the database
# was asked — the count and the page — and `wrote` is turning the answer into
# what the grid reads. The second is measured around its own work and added at
# the end, which is why the number is the length of the string rather than of
# the whole reply.
fn rows_body(list, total, page, pages, skip, asked) =
  t0 = now_nanos()
  head = "{\"total\":" + int_to_str(total) + ",\"page\":" + int_to_str(page) + ",\"pages\":" + int_to_str(pages)
  body = head + ",\"from\":" + int_to_str(skip + 1) + ",\"docs\":" + to_string(JArr(list))
  body + ",\"db_us\":" + int_to_str(asked / 1000) + ",\"wrote_us\":" + int_to_str((now_nanos() - t0) / 1000) + "}"

# -- grouping ------------------------------------------------------------------
#
# `/rows?group=region&role=eng&page=2&limit=25` — the same filters, and instead
# of the documents that match, what they come to under each value of one
# field: how many there are, their average score, their stock in total. The
# grid asks this when a column header has been dragged onto its group panel,
# one level at a time: the groups under `role` first, and when one of them is
# opened, the groups under `region` with that role added to the filters — and
# when the last level is opened, the documents themselves, which is `/rows`
# as it always was. A level is never more than one question, and a page of
# groups is paged the way a page of documents is.
#
# It is one pipeline. `$match` is the filters, `$group` the field, and
# `$facet` splits what comes out into the page that was asked for and the
# count of groups, so the pager has its total without a second trip. The
# database does all of it: nothing here reads a document.
#
# `by` sorts the groups: the field itself, or `count`, `score` and `stock`,
# which are the three numbers a group carries. Anything else is the field.
fn answer_groups(fd, qs) =
  f = param(qs, "group")
  if !known_field(f) then h.json_response(400, "{\"error\":\"cannot group by `" + f + "`\"}") else groups_at((fd, qs, f, page_size(qs)), page_of(qs), now_nanos())

fn known_field(f) =
  listed(Cons("sku", Cons("name", Cons("role", Cons("region", Cons("score", Cons("stock", Cons("added", Nil))))))), f)

# The question is one tuple — the connection, the query, the field and the
# page size — so that asking it again is a jump and not a deeper stack.
fn groups_at(ask, page, t0) = match ask
  (fd, qs, f, size) ->
    skip = (if page < 1 then 0 else page - 1) * size
    match aggregate(fd, collection(), group_pipeline(JObj(match_fields(qs)), f, group_sort(qs, f), skip, size))
      Err(e) -> failed(e)
      Ok(d) -> groups_found(ask, page, skip, t0, facet_of(docs(d)))

# A page past the end — a URL kept from before an edit made the groups fewer —
# is asked again as the last page there is.
fn groups_found(ask, page, skip, t0, found) = match (ask, found)
  ((_, _, f, size), (rows, total)) ->
    pages = if total <= 0 then 1 else (total + size - 1) / size
    if page > pages then groups_at(ask, pages, t0) else h.json_response(200, groups_body(f, rows, total, clamped(page, 1, pages), pages, skip, now_nanos() - t0))

fn group_pipeline(q, f, sort, skip, size) =
  JArr(append(match_stage(q), Cons(group_stage(f), Cons(facet_stage(sort, skip, size), Nil))))

# No filters is no `$match`: the database groups the whole collection, and
# for a count alone that is a read of the index and not of the documents.
fn match_stage(q) = match q
  JObj(Nil) -> Nil
  _ -> Cons(stage_of("$match", q), Nil)

fn stage_of(name, body) = JObj(Cons(field(name, body), Nil))

fn group_stage(f) =
  JObj(Cons(field("$group", JObj(Cons(field("_id", text("$" + f)), Cons(field("count", accum("$sum", int(1))), Cons(field("score", accum("$avg", text("$score"))), Cons(field("stock", accum("$sum", text("$stock"))), Nil)))))), Nil))

fn accum(op, arg) = JObj(Cons(field(op, arg), Nil))

fn facet_stage(sort, skip, size) =
  page = JArr(Cons(stage_of("$sort", sort), Cons(stage_of("$skip", int(skip)), Cons(stage_of("$limit", int(size)), Nil))))
  stage_of("$facet", JObj(Cons(field("rows", page), Cons(field("total", JArr(Cons(stage_of("$count", text("n")), Nil))), Nil))))

fn group_sort(qs, f) = JObj(Cons(field(group_key(sort_by(qs), f), int(sort_dir(qs))), Nil))

fn group_key(by, f) =
  if by == f then "_id" else if by == "count" || by == "score" || by == "stock" then by else "_id"

# `$facet` answers with one document: the page under `rows`, and under
# `total` a list holding `{"n": 4}` — or nothing at all when there are no
# groups, which is what an empty match comes to.
fn facet_of(list) = match list
  Nil -> (Nil, 0)
  Cons(one, _) -> (as_arr(at_key(one, "rows")), first_n(as_arr(at_key(one, "total"))))

fn first_n(items) = match items
  Nil -> 0
  Cons(one, _) -> as_int(at_key(one, "n"))

fn at_key(doc, key) = unwrap_or(get(doc, key), JNull)

fn groups_body(f, rows, total, page, pages, skip, asked) =
  t0 = now_nanos()
  head = "{\"total\":" + int_to_str(total) + ",\"page\":" + int_to_str(page) + ",\"pages\":" + int_to_str(pages)
  body = head + ",\"from\":" + int_to_str(skip + 1) + ",\"field\":\"" + f + "\",\"groups\":" + to_string(JArr(map(rows, \d -> group_row(d))))
  body + ",\"db_us\":" + int_to_str(asked / 1000) + ",\"wrote_us\":" + int_to_str((now_nanos() - t0) / 1000) + "}"

# `_id` is what the database calls the value grouped under; the grid calls it
# `key`, and the three numbers keep the names of the columns they stand in.
fn group_row(d) =
  JObj(Cons(field("key", at_key(d, "_id")), Cons(field("count", at_key(d, "count")), Cons(field("score", at_key(d, "score")), Cons(field("stock", at_key(d, "stock")), Nil)))))

# How many match, which page of them was asked for, and where it begins.
fn shape_of(fd, qs) =
  q = JObj(match_fields(qs))
  size = page_size(qs)
  total = matched(fd, q)
  pages = if total <= 0 then 1 else (total + size - 1) / size
  page = clamped(page_of(qs), 1, pages)
  (q, size, total, pages, page, (page - 1) * size)

fn sorted_by(qs) = JObj(Cons(field(sort_by(qs), int(sort_dir(qs))), Nil))

fn answer_page(qs, result, total, page, pages, size, skip, asked, weight) = match result
  Err(e) -> h.html_response(500, page_of_html(qs, Nil, 0, 1, 1, size, 0, e, asked, weight))
  Ok(d) -> h.html_response(200, page_of_html(qs, docs(d), total, page, pages, size, skip, "", asked, weight))

fn matched(fd, q) = match count_where(fd, collection(), q)
  Err(_) -> 0
  Ok(d) -> counted(d)

fn page_size(qs) = at_most(int_or(param(qs, "limit"), 25), 200)

fn page_of(qs) = int_or(param(qs, "page"), 1)

fn sort_by(qs) = if str_len(param(qs, "by")) == 0 then "sku" else param(qs, "by")

fn sort_dir(qs) = if param(qs, "dir") == "desc" then 0 - 1 else 1

fn clamped(n, lo, hi) = if n < lo then lo else if n > hi then hi else n

# The page itself is `catalogue.tmpl`, compiled to Rill by
# `tools/tmplgen.rill` before this file is. What is left here is the shape it
# is given: the form as it should come back, one row per document, and the
# pager worked out — no markup, and no page to look at to see what a query
# does.
fn page_of_html(qs, list, total, page, pages, size, skip, trouble, asked, weight) =
  b = strbuf()
  catalogue_page(b, view_of(qs, list, total, page, pages, skip, trouble, asked, weight))
  strbuf_str(b)

fn view_of(qs, list, total, page, pages, skip, trouble, asked, weight) =
  dir = if sort_dir(qs) < 0 then "desc" else "asc"
  bys = choices(Cons("sku", Cons("score", Cons("stock", Cons("name", Nil)))), sort_by(qs))
  dirs = choices(Cons("asc", Cons("desc", Nil)), dir)
  seen = len(list)
  seed = in_script(rows_body(list, total, page, pages, skip, asked))
  View(param(qs, "role"), param(qs, "region"), param(qs, "sku"), int_to_str(page_size(qs)), bys, dirs, trouble, total, page, pages, skip + 1, skip + seen, rows_of(list), steps_of(qs, page, pages), seed, weight)

# JSON is put in the page as it stands, so the one byte that could end the
# script tag early is written as an escape. Nothing else in JSON can.
fn in_script(json) = join(split(json, "<"), chr(92) + "u003c")

fn rows_of(list) = match list
  Nil -> Nil
  Cons(doc, rest) -> Cons(row_of(doc), rows_of(rest))

fn row_of(doc) =
  Row(field_int(doc, "sku"), field_str(doc, "name"), field_str(doc, "role"), field_str(doc, "region"), field_float(doc, "score"), field_int(doc, "stock"))

fn field_float(doc, key) = as_float(unwrap_or(get(doc, key), JNull))

# Five steps, of which the middle one is where the page count goes: a step
# that is not live is a word rather than a link, and that is what the counter
# wants to be anyway.
fn steps_of(qs, page, pages) =
  here = int_to_str(page) + " / " + int_to_str(pages)
  back = Cons(step_of(qs, 1, page > 1, "first"), Cons(step_of(qs, page - 1, page > 1, "prev"), Nil))
  on = Cons(step_of(qs, page + 1, page < pages, "next"), Cons(step_of(qs, pages, page < pages, "last"), Nil))
  append(back, Cons(Step(here, "", false), on))

fn step_of(qs, to, live, label) = Step(label, if live then with_page(qs, to) else "", live)

# The query string as it stands, with `page` set to this one.
fn with_page(qs, n) = join(reverse(Cons("page=" + int_to_str(n), kept_pairs(qs))), "&")

# The query as it stands, minus the page and anything empty, written back out
# with everything escaped — a name with a space in it makes a link that works.
fn kept_pairs(qs) = kept_of(h.params(qs), Nil)

fn kept_of(pairs: List(h.Header), acc) = match pairs
  Nil -> acc
  Cons(one, rest) ->
    kept = if one.name == "page" || str_len(one.value) == 0 then acc else Cons(h.encoded(one.name) + "=" + h.encoded(one.value), acc)
    kept_of(rest, kept)
