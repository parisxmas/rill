# A hundred thousand documents in OxiDB, and an HTTP server in front of them.
#
# Three libraries meet here and none of them knows about the others:
# `oxidb.rill` speaks the database's binary wire, `http.rill` speaks HTTP/1.1,
# `catalogue.tmpl` is the page, and what is written below is only the joining —
# a URL turned into a query, an answer turned into JSON or into a view the
# template can lay out.
#
#     oxidb-server &                      # the document engine is on by default
#     ./catalogue 4444                    # seeds, then serves on a port it prints
#     ./catalogue 4444 8123               # or on the port you name
#
# `/` is a page a browser can use: a form for the filters, a table, and a
# pager. Everything else answers JSON, so the same server serves both.
#
# The page is whole before any script runs, and works with none: a filter is a
# form submit and a pager step is a link. `static/catalogue.js` is what makes
# it live — zap, a signals library, takes both halves over with its own
# components: `Select` and `Button` in the toolbar, `DataGrid` for the table,
# which sorts, filters and pages a window of rows without asking the server
# anything. What the server rendered is held back until they are in, so the
# page is not painted twice, and let through anyway if the script never
# arrives. Where the line falls is the interesting part: the DATABASE answers
# which of a hundred thousand documents match, with an index behind every
# field the form offers, and the GRID holds one window of that answer.
# `/rows` is that window as JSON, and it is in the page already — the server
# puts what it just rendered into a `<script type="application/json">`, so the
# client starts from what is on the screen rather than asking for it again. It
# carries what it cost to make, too: the grid shows the database's time and
# the writing's beside its row count.
#
# The table is editable. A cell opens the editor its column's type asks for —
# a number field, the calendar, a list — and what comes out is a `POST
# /doc/<sku>` naming one field. The rules are written twice on purpose: the
# grid stops you at sixty characters while you type, and `refused` below
# checks the same limits again before anything is written, because a request
# need not have come from the page. A refusal comes back as the reason, the
# grid puts the old value back and shows it on the cell, and a write that
# lands answers with how long the database took — which is what the little
# notice in the corner of the page is counting.
#
# The page is a template rather than markup built by hand, and it is four of
# them: `catalogue.tmpl` is the page, and it includes the form, the table and
# the pager — `<% include catalogue_table(v.rows) %>` is the call
# `catalogue_table(b, v.rows)`, the same builder and the rows handed over.
# `tools/tmplgen.rill` compiles each one to the Rill checked in beside it, and
# that Rill is compiled with the rest of this program. Nothing is parsed or
# looked up by name while a page is being rendered:
#
#     rill build tools/tmplgen.rill -o tmplgen
#     for t in catalogue catalogue_form catalogue_table catalogue_nav; do
#       ./tmplgen examples/oxidb/$t.tmpl examples/oxidb/${t}_tmpl.rill
#     done
#
#     open http://127.0.0.1:8123/
#     curl 127.0.0.1:8123/count
#     curl '127.0.0.1:8123/find?role=eng&limit=3'
#     curl '127.0.0.1:8123/top?by=score&limit=5'
#     curl 127.0.0.1:8123/doc/42
#
# Seeding is a thousand documents a frame: one round trip per batch rather
# than per document. A hundred thousand of them go in in 624 ms and the four
# indexes take 466 more, after which every route below answers in about a
# third of a millisecond. Without the indexes the same routes take 15 ms to
# find one document and 471 to sort by a field, because each is then a read
# of all hundred thousand — which is the whole argument for an index, in two
# numbers.
#
# The pager asks for a page by counting past the ones before it, which is
# what `skip` is and what every offset pager pays: page 1 answers in 0.4 ms,
# page 100 in 0.5, page 1000 in 1.4, and page 3900 — ninety-seven thousand
# documents counted past — in 95. A pager that stayed fast at the end would
# carry the last key it saw rather than a number, and ask for what comes
# after it; this one is the shape a URL wants to be.
#
# The connections to the database are sixteen, handed round on a channel: a
# request takes one, uses it, and puts it back, and a request that finds none
# waits — which is the backpressure a server wants anyway. Opening one per
# request is what this did first, and it survived a browser and died under
# load: at four thousand requests a second, each leaving a closed socket in
# TIME_WAIT for a minute, sixteen thousand of them piled up, the machine ran
# out of ports, and nine requests in ten came back 502. Sixteen is where the
# measurements settled — four gives 3,300 requests a second, eight 4,900,
# sixteen 5,600, and thirty-two no more of them but a fourfold worse tail.
#
# The HTTP side is `http.rill`'s: one strand per connection, keep-alive, and
# a connection parked on a slow client costs nothing. A hundred people
# searching at once are a hundred strands on one worker: 5,600 searches a
# second, half of them answered inside 18 ms, none failed. Five hundred at
# once is the same 5,400 a second with the queue in the latency — 92 ms —
# which is what saturation looks like when nothing is breaking. More workers
# do not help: at this size the work is a round trip to the database and back,
# not arithmetic.
import "oxidb"
import "http" as h
import "catview"
import "catalogue_page"

fn total() = 100000

fn batch() = 1000

fn collection() = "catalogue"

fn main() = match args()
  Cons(_, Cons(db, rest)) -> start(str_to_int(db), wanted_port(rest))
  _ -> usage()

fn usage() =
  println("usage: catalogue <oxidb-port> [http-port]")
  println("  needs an oxidb-server; the document engine is on by default.")

fn wanted_port(rest) = match rest
  Cons(p, _) -> str_to_int(p)
  Nil -> 0

# -- seeding ------------------------------------------------------------------

fn start(db, want) = match dial("127.0.0.1", db)
  Err(e) -> println("oxidb: " + e)
  Ok(fd) -> seed_then_serve(fd, db, want)

fn seed_then_serve(fd, db, want) =
  println("clearing " + collection())
  drop_all(fd)
  println("seeding " + int_to_str(total()) + " documents")
  t0 = now_nanos()
  fill(fd, 0)
  t1 = now_nanos()
  println("seeded in " + int_to_str((t1 - t0) / 1000000) + " ms")
  # An index apiece on what the routes below ask by and sort on. Without
  # them every request reads a hundred thousand documents: `/top?by=score`
  # took 471 ms and takes 3 with one.
  t2 = now_nanos()
  index_on(fd, "sku")
  index_on(fd, "role")
  index_on(fd, "region")
  index_on(fd, "score")
  println("indexed in " + int_to_str((now_nanos() - t2) / 1000000) + " ms")
  shown("count", count(fd, collection()), \d -> int_to_str(counted(d)))
  hang_up(fd)
  serve_on(db, want)

fn drop_all(fd) = match delete(fd, collection(), JObj(Nil))
  Err(e) ->
    println("delete: " + e)
    0
  Ok(_) -> 0

fn index_on(fd, name) = match create_index(fd, collection(), name)
  Err(e) ->
    println("create_index " + name + ": " + e)
    0
  Ok(_) -> 0

# A batch at a time until the whole run is in.
fn fill(fd, from) =
  if from >= total() then 0
  else
    n = if total() - from < batch() then total() - from else batch()
    send_batch(fd, from, n)
    fill(fd, from + n)

fn send_batch(fd, from, n) = match insert_many(fd, collection(), batch_docs(from, n))
  Err(e) ->
    println("insert_many at " + int_to_str(from) + ": " + e)
    0
  Ok(_) -> 0

fn batch_docs(from, n) =
  for k in 0..n with acc = Nil
    Cons(one_doc(from + n - 1 - k), acc)

# Made from the number alone, so a query's answer is predictable: role and
# region cycle, the score is a scramble of the id, and the name carries it.
fn one_doc(i) =
  JObj(Cons(field("sku", int(i)), Cons(field("name", text("item-" + int_to_str(i))), Cons(field("role", text(role_of(i))), Cons(field("region", text(region_of(i))), Cons(field("score", JNum(score_of(i))), Cons(field("stock", int(i % 97)), Cons(field("added", text(added_of(i))), Nil))))))))

# A date apiece, cycling, so it is always a real one and always the same one.
fn added_of(i) = "2026-" + two_digits(1 + i % 12) + "-" + two_digits(1 + i % 28)

fn two_digits(n) = if n < 10 then "0" + int_to_str(n) else int_to_str(n)

fn role_of(i) = nth_or(Cons("eng", Cons("ops", Cons("sre", Cons("design", Nil)))), i % 4, "eng")

fn region_of(i) = nth_or(Cons("eu", Cons("us", Cons("apac", Nil))), i % 3, "eu")

fn score_of(i) = to_float(i * 7919 % 10007) / 100.0

fn nth_or(l, i, fallback) = unwrap_or(nth(l, i), fallback)

# -- serving ------------------------------------------------------------------

fn serve_on(db, want) = match listen_on(want)
  Err(e) -> println(e)
  Ok(server) -> announce(server, db, sock_port(server))

fn announce(server, db, port) =
  println("http://127.0.0.1:" + int_to_str(port) + "/  — try /count, /find?role=eng&limit=3, /top?by=score&limit=5, /doc/42")
  pool = build_pool(db, connections())
  # The writes are the ones that reach the database, so they are the ones that
  # are counted. A middleware is a layer around the handler and `wrap` puts
  # the list on in order, outermost first.
  h.accept_forever(server, h.wrap(Cons(h.rate_limit(writes_a_second()), Nil), \req -> route(pool, req)))

fn writes_a_second() = 20

# -- routing ------------------------------------------------------------------

fn connections() = 16

# The pool: a buffered channel holding open connections. It is built once,
# before the first request, and the handler closes over it.
fn build_pool(db, n) =
  ch = channel(n)
  fill_pool(ch, db, n)
  ch

fn fill_pool(ch, db, n) =
  if n <= 0 then 0 else match dial("127.0.0.1", db)
    Err(e) ->
      println("pool: " + e)
      0
    Ok(fd) ->
      send(ch, fd)
      fill_pool(ch, db, n - 1)

# A write arrives as a POST and nothing else does: a link cannot change a
# document, whatever it says.
fn route(pool, req: h.Request) =
  if req.method == "POST" then with_db(pool, \fd -> answer_edit(fd, path_of(req.path), req.body)) else dispatch(pool, path_of(req.path), query_of(req.path))

# `POST /doc/<sku>` with `{"field": ..., "value": ...}` — one cell of one
# document, which is what the grid sends when a cell is edited.
fn answer_edit(fd, path, body) =
  if starts_with(path, "/doc/") then edit_doc(fd, str_to_int(str_sub(path, 5, str_len(path))), parse(body)) else h.json_response(404, "{\"error\":\"nothing to write there\"}")

fn edit_doc(fd, sku, body) = match body
  Err(e) -> h.json_response(400, "{\"error\":\"" + e + "\"}")
  Ok(j) -> apply_edit(fd, sku, as_str(unwrap_or(get(j, "field"), JNull)), unwrap_or(get(j, "value"), JNull))

fn apply_edit(fd, sku, name, value) =
  refusal = refused(name, value)
  if str_len(refusal) > 0 then h.json_response(400, "{\"error\":\"" + refusal + "\"}") else write_field(fd, sku, name, value)

fn write_field(fd, sku, name, value) =
  t0 = now_nanos()
  match update(fd, collection(), JObj(Cons(field("sku", int(sku)), Nil)), set(Cons(Field(name, value), Nil)))
    Err(e) -> failed(e)
    Ok(_) -> h.json_response(200, "{\"ok\":true,\"db_us\":" + int_to_str((now_nanos() - t0) / 1000) + "}")

# What a document may be told, and what it may not. The page enforces the same
# rules while you type, but a request need not have come from the page — so
# these are the ones that count, and the answer is why it was refused or
# nothing at all. `sku` is what a document is found by and `score` is
# computed, so neither is here.
fn refused(name, value) =
  if name == "name" then text_rule(value, 60, "a name") else if name == "role" then one_of(value, Cons("eng", Cons("ops", Cons("sre", Cons("design", Nil)))), "a role") else if name == "region" then one_of(value, Cons("eu", Cons("us", Cons("apac", Nil))), "a region") else if name == "stock" then number_rule(value, 0, 99999, "stock") else if name == "added" then date_rule(value) else "`" + name + "` is not a field this page may change"

fn text_rule(value, most, what) = match value
  JStr(s) ->
    if str_len(trim(s)) == 0 then what + " cannot be empty" else if str_len(s) > most then what + " is at most " + int_to_str(most) + " characters" else ""
  _ -> what + " has to be text"

fn one_of(value, allowed, what) = match value
  JStr(s) -> if listed(allowed, s) then "" else what + " is one of " + join(allowed, ", ")
  _ -> what + " has to be text"

fn listed(l, s) = match l
  Nil -> false
  Cons(x, rest) -> x == s || listed(rest, s)

fn number_rule(value, least, most, what) = match value
  JInt(n) ->
    if n < least then what + " is never below " + int_to_str(least) else if n > most then what + " is at most " + int_to_str(most) else ""
  _ -> what + " has to be a whole number"

# `2026-01-15` and nothing else: ten characters, dashes where dashes go, and a
# month and a day that exist.
fn date_rule(value) = match value
  JStr(s) ->
    if str_len(s) != 10 || str_get(s, 4) != 45 || str_get(s, 7) != 45 then "a date is written 2026-01-15" else if !digits_only(s, 0, 4) || !digits_only(s, 5, 7) || !digits_only(s, 8, 10) then "a date is written 2026-01-15" else month_and_day(str_to_int(str_sub(s, 5, 2)), str_to_int(str_sub(s, 8, 2)))
  _ -> "a date has to be text"

fn month_and_day(month, day) =
  if month < 1 || month > 12 then "there is no month " + int_to_str(month) else if day < 1 || day > 31 then "there is no day " + int_to_str(day) else ""

fn digits_only(s, from, to) =
  for i in from..to with ok = true
    ok && str_get(s, i) >= 48 && str_get(s, i) <= 57

fn dispatch(pool, path, qs) =
  if path == "/" then with_db(pool, \fd -> browse(fd, qs)) else if path == "/rows" then with_db(pool, \fd -> answer_rows(fd, qs)) else if path == "/count" then with_db(pool, \fd -> answer_count(fd)) else if path == "/find" then with_db(pool, \fd -> answer_find(fd, qs)) else if path == "/top" then with_db(pool, \fd -> answer_top(fd, qs)) else if starts_with(path, "/doc/") then with_db(pool, \fd -> answer_doc(fd, str_to_int(str_sub(path, 5, str_len(path))))) else if starts_with(path, "/static/") then answer_static(str_sub(path, 8, str_len(path))) else h.json_response(404, "{\"error\":\"no route for " + path + "\"}")

# -- what the page pulls in ----------------------------------------------------

# The modules are named rather than joined onto a root, so nothing a URL says
# can reach a file this server was not meant to hand out.
fn answer_static(name) =
  if is_module(name) then serve_module(name) else h.json_response(404, "{\"error\":\"no such file\"}")

# The files the page is allowed to ask for, by name. zap and its component
# set are vendored under `static/` so the example needs nothing installed.
fn is_module(name) =
  name == "catalogue.js" || name == "index.js" || name == "zap.js" || name == "html.js" || name == "router.js" || name == "theme.css" || is_component(name)

fn is_component(name) =
  name == "components/grid.js" || name == "components/pagination.js" || name == "components/select.js" || name == "components/button.js" || name == "components/switch.js" || name == "components/datepicker.js" || name == "components/calendar.js" || name == "components/anchor.js" || name == "components/toast.js"

# Run from the repository root or from the example's own directory; both are
# tried, and a server that finds neither says so rather than serving a blank
# page that fails in the browser.
fn serve_module(name) = match first_readable(Cons("examples/oxidb/static/" + name, Cons("static/" + name, Nil)))
  Err(e) -> h.text_response(500, e)
  Ok(text) -> h.Response(200, kind_of(name), text)

fn kind_of(name) =
  if str_find(name, ".css") > 0 then "text/css; charset=utf-8" else "text/javascript; charset=utf-8"

fn first_readable(paths) = match paths
  Nil -> Err("cannot find the static files — run this from the repository root")
  Cons(p, rest) -> match read_file(p)
    Ok(text) -> Ok(text)
    Err(_) -> first_readable(rest)

# One of the pool's connections for the length of the call, and back
# afterwards whatever the answer was.
fn with_db(pool, ask) =
  fd = recv(pool)
  res = ask(fd)
  send(pool, fd)
  res

fn answer_count(fd) = match count(fd, collection())
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, "{\"count\":" + int_to_str(counted(d)) + "}")

fn answer_doc(fd, sku) = match find(fd, collection(), JObj(Cons(field("sku", int(sku)), Nil)))
  Err(e) -> failed(e)
  Ok(d) -> one_or_none(docs(d))

fn one_or_none(list) = match list
  Nil -> h.json_response(404, "{\"error\":\"no such document\"}")
  Cons(doc, _) -> h.json_response(200, to_string(doc))

# `?role=eng&region=eu&limit=10` — every parameter but `limit` is a field the
# document must match.
fn answer_find(fd, qs) = match find_sorted(fd, collection(), JObj(match_fields(qs)), JObj(Cons(field("sku", int(1)), Nil)), limit_of(qs))
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, to_string(JArr(docs(d))))

# `?by=score&limit=5` — the highest by that field.
fn answer_top(fd, qs) = match find_sorted(fd, collection(), JObj(Nil), JObj(Cons(field(by_of(qs), int(0 - 1)), Nil)), limit_of(qs))
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, to_string(JArr(docs(d))))

fn failed(why) = h.json_response(500, "{\"error\":\"" + why + "\"}")

fn limit_of(qs) = at_most(int_or(param(qs, "limit"), 10), 1000)

fn at_most(n, cap) = if n > cap then cap else if n < 1 then 1 else n

fn by_of(qs) = if str_len(param(qs, "by")) == 0 then "score" else param(qs, "by")

fn int_or(s, fallback) = if str_len(s) == 0 then fallback else str_to_int(s)

# Every parameter that is not `limit` or `by` becomes a field to match on. A
# value that reads as a number is matched as one, so `?sku=42` finds the
# document rather than nothing.
fn match_fields(qs) =
  for i in 0..len(pairs_of(qs)) with acc = Nil
    p = unwrap_or(nth(pairs_of(qs), len(pairs_of(qs)) - 1 - i), "")
    k = before_eq(p)
    if is_control(k) || str_len(after_eq(p)) == 0 then acc else Cons(field(k, valued(after_eq(p))), acc)

# The parameters that steer the page rather than filter the documents.
fn is_control(k) = str_len(k) == 0 || k == "limit" || k == "by" || k == "dir" || k == "page"

fn valued(v) = if looks_numeric(v) then int(str_to_int(v)) else text(v)

fn looks_numeric(v) =
  if str_len(v) == 0 then false
  else
    for i in 0..str_len(v) with ok = true
      ok && str_get(v, i) >= 48 && str_get(v, i) <= 57

# -- the target, taken apart ---------------------------------------------------

fn path_of(target) =
  i = str_find(target, "?")
  if i < 0 then target else str_sub(target, 0, i)

fn query_of(target) =
  i = str_find(target, "?")
  if i < 0 then "" else str_sub(target, i + 1, str_len(target))

fn pairs_of(qs) = if str_len(qs) == 0 then Nil else split(qs, "&")

fn param(qs, key) =
  for i in 0..len(pairs_of(qs)) with found = ""
    p = unwrap_or(nth(pairs_of(qs), i), "")
    if before_eq(p) == key then after_eq(p) else found

fn before_eq(p) =
  i = str_find(p, "=")
  if i < 0 then p else str_sub(p, 0, i)

fn after_eq(p) =
  i = str_find(p, "=")
  if i < 0 then "" else str_sub(p, i + 1, str_len(p))

fn shown(label, result, render) = match result
  Err(e) -> println(label + ": error: " + e)
  Ok(data) -> println(label + ": " + render(data))

# -- the page ------------------------------------------------------------------

# `/` renders what `/find` answers, with a form in front of it and a pager
# under it. Nothing here is JavaScript: a link carries the page number and
# the server answers with the page.
fn browse(fd, qs) =
  t0 = now_nanos()
  match shape_of(fd, qs)
    (q, size, total, pages, page, skip) ->
      found = find_page(fd, collection(), q, sorted_by(qs), size, skip)
      answer_page(qs, found, total, page, pages, size, skip, now_nanos() - t0)

# What `/` renders, as JSON, for the client that took the page over. It is the
# same question asked the same way — the two answers cannot drift apart,
# because only the last step of each differs.
fn answer_rows(fd, qs) =
  t0 = now_nanos()
  match shape_of(fd, qs)
    (q, size, total, pages, page, skip) ->
      found = find_page(fd, collection(), q, sorted_by(qs), size, skip)
      rows_json(found, total, page, pages, skip, now_nanos() - t0)

fn rows_json(result, total, page, pages, skip, asked) = match result
  Err(e) -> failed(e)
  Ok(d) -> h.json_response(200, rows_body(docs(d), total, page, pages, skip, asked))

# One page of results as JSON. `/rows` answers with it and `/` carries it
# inside the page, so the client starts from what it can already see.
#
# The two times are what it cost to produce: `db` is everything the database
# was asked — the count and the page — and `wrote` is turning the answer into
# what the grid reads. The second is measured around its own work and added at
# the end, which is why the number is the length of the string rather than of
# the whole reply.
fn rows_body(list, total, page, pages, skip, asked) =
  t0 = now_nanos()
  head = "{\"total\":" + int_to_str(total) + ",\"page\":" + int_to_str(page) + ",\"pages\":" + int_to_str(pages)
  body = head + ",\"from\":" + int_to_str(skip + 1) + ",\"docs\":" + to_string(JArr(list))
  body + ",\"db_us\":" + int_to_str(asked / 1000) + ",\"wrote_us\":" + int_to_str((now_nanos() - t0) / 1000) + "}"

# How many match, which page of them was asked for, and where it begins.
fn shape_of(fd, qs) =
  q = JObj(match_fields(qs))
  size = page_size(qs)
  total = matched(fd, q)
  pages = if total <= 0 then 1 else (total + size - 1) / size
  page = clamped(page_of(qs), 1, pages)
  (q, size, total, pages, page, (page - 1) * size)

fn sorted_by(qs) = JObj(Cons(field(sort_by(qs), int(sort_dir(qs))), Nil))

fn answer_page(qs, result, total, page, pages, size, skip, asked) = match result
  Err(e) -> h.html_response(500, page_of_html(qs, Nil, 0, 1, 1, size, 0, e, asked))
  Ok(d) -> h.html_response(200, page_of_html(qs, docs(d), total, page, pages, size, skip, "", asked))

fn matched(fd, q) = match count_where(fd, collection(), q)
  Err(_) -> 0
  Ok(d) -> counted(d)

fn page_size(qs) = at_most(int_or(param(qs, "limit"), 25), 200)

fn page_of(qs) = int_or(param(qs, "page"), 1)

fn sort_by(qs) = if str_len(param(qs, "by")) == 0 then "sku" else param(qs, "by")

fn sort_dir(qs) = if param(qs, "dir") == "desc" then 0 - 1 else 1

fn clamped(n, lo, hi) = if n < lo then lo else if n > hi then hi else n

# The page itself is `catalogue.tmpl`, compiled to Rill by
# `tools/tmplgen.rill` before this file is. What is left here is the shape it
# is given: the form as it should come back, one row per document, and the
# pager worked out — no markup, and no page to look at to see what a query
# does.
fn page_of_html(qs, list, total, page, pages, size, skip, trouble, asked) =
  b = strbuf()
  catalogue_page(b, view_of(qs, list, total, page, pages, skip, trouble, asked))
  strbuf_str(b)

fn view_of(qs, list, total, page, pages, skip, trouble, asked) =
  dir = if sort_dir(qs) < 0 then "desc" else "asc"
  bys = choices(Cons("sku", Cons("score", Cons("stock", Cons("name", Nil)))), sort_by(qs))
  dirs = choices(Cons("asc", Cons("desc", Nil)), dir)
  seen = len(list)
  seed = in_script(rows_body(list, total, page, pages, skip, asked))
  View(param(qs, "role"), param(qs, "region"), param(qs, "sku"), int_to_str(page_size(qs)), bys, dirs, trouble, total, page, pages, skip + 1, skip + seen, rows_of(list), steps_of(qs, page, pages), seed)

# JSON is put in the page as it stands, so the one byte that could end the
# script tag early is written as an escape. Nothing else in JSON can.
fn in_script(json) = join(split(json, "<"), chr(92) + "u003c")

fn rows_of(list) = match list
  Nil -> Nil
  Cons(doc, rest) -> Cons(row_of(doc), rows_of(rest))

fn row_of(doc) =
  Row(field_int(doc, "sku"), field_str(doc, "name"), field_str(doc, "role"), field_str(doc, "region"), field_float(doc, "score"), field_int(doc, "stock"))

fn field_float(doc, key) = as_float(unwrap_or(get(doc, key), JNull))

# Five steps, of which the middle one is where the page count goes: a step
# that is not live is a word rather than a link, and that is what the counter
# wants to be anyway.
fn steps_of(qs, page, pages) =
  here = int_to_str(page) + " / " + int_to_str(pages)
  back = Cons(step_of(qs, 1, page > 1, "first"), Cons(step_of(qs, page - 1, page > 1, "prev"), Nil))
  on = Cons(step_of(qs, page + 1, page < pages, "next"), Cons(step_of(qs, pages, page < pages, "last"), Nil))
  append(back, Cons(Step(here, "", false), on))

fn step_of(qs, to, live, label) = Step(label, if live then with_page(qs, to) else "", live)

# The query string as it stands, with `page` set to this one.
fn with_page(qs, n) = join(reverse(Cons("page=" + int_to_str(n), kept_pairs(qs))), "&")

fn kept_pairs(qs) =
  for i in 0..len(pairs_of(qs)) with acc = Nil
    p = unwrap_or(nth(pairs_of(qs), i), "")
    if before_eq(p) == "page" || str_len(after_eq(p)) == 0 then acc else Cons(p, acc)
