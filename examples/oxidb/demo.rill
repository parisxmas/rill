# The OxiDB client, driven end to end.
#
# With no arguments this talks to a stand-in server started on a strand, so
# the example runs anywhere and the test suite can check it. The stand-in is
# not a database: it speaks the frame format and answers the handful of
# commands below with the shapes a real server answers them with, which is
# exactly the surface the client is responsible for.
#
# Give it a port and it talks to a real server instead:
#
#     oxidb-server &                 # listening on 4444
#     ./demo 4444
import "db/oxidb"

# `args()` includes the program's own name, so "no arguments" is a list of
# one. Matching `Nil` here meant the stand-in never ran: every run took the
# port branch, read a port of 0 out of the program's path, and failed to
# connect to it.
fn main() = match args()
  Cons(_, Nil) -> against_stand_in()
  Cons(_, Cons(port, _)) -> report(str_to_int(port))
  Nil -> against_stand_in()

# -- the client half ----------------------------------------------------------

fn report(port) = match dial("127.0.0.1", port)
  Err(e) -> println(e)
  Ok(fd) -> converse(fd)

fn converse(fd) =
  show_result("ping", ping(fd), \d -> as_str(d))
  show_result("insert", insert(fd, "team", person("ada", "eng", 36)), \d -> int_to_str(inserted_id(d)))
  show_result("insert_many", insert_many(fd, "team", Cons(person("grace", "eng", 45), Cons(person("linus", "ops", 29), Nil))), \d -> join(map(inserted_ids(d), \i -> int_to_str(i)), ","))
  show_result("count", count(fd, "team"), \d -> int_to_str(counted(d)))
  show_result("find", find(fd, "team", JObj(Cons(field("role", text("eng")), Nil))), \d -> names_of(d))
  show_result("update", update(fd, "team", JObj(Cons(field("name", text("linus")), Nil)), set(Cons(field("role", text("sre")), Nil))), \d -> int_to_str(modified(d)))
  show_result("delete", delete(fd, "team", JObj(Cons(field("name", text("ada")), Nil))), \d -> int_to_str(deleted(d)))
  hang_up(fd)

fn person(name, role, age) =
  JObj(Cons(field("name", text(name)), Cons(field("role", text(role)), Cons(field("age", int(age)), Nil))))

fn names_of(data) = join(map(docs(data), \d -> field_str(d, "name")), ",")

# Every call answers `Ok(data)` or `Err(message)`, and both are worth showing.
fn show_result(label, result, render) = match result
  Err(e) -> println(label + ": error: " + e)
  Ok(data) -> println(label + ": " + render(data))

# -- the stand-in server ------------------------------------------------------

fn against_stand_in() = match listen_on(4470)
  Err(e) -> println(e)
  Ok(server) -> run(server)

# The socket is open before the strand starts, so the first request cannot
# arrive before there is something to accept it.
fn run(server) =
  spawn stand_in(server, 7)
  report(4470)

fn stand_in(server, remaining) =
  conn = tcp_accept(server)
  answer_all(conn, remaining)
  sock_close(server)

# A frame is `0xDB` and a value, so the request decodes from byte 1. One the
# stand-in cannot read becomes `JNull`, which has no `cmd` and so falls
# through to the unknown-command reply — the shape a real server answers a
# nonsense request with anyway.
fn answer_all(conn, remaining) =
  request = asked(ow_decode(ow_recv(conn), 1))
  answer(conn, reply_to(as_str(unwrap_or(get(request, "cmd"), JNull)), request))
  if remaining == 1 then sock_close(conn) else answer_all(conn, remaining - 1)

fn asked(read) = match read
  Parsed(v, _) -> v
  Failed(_, _) -> JNull

# On this wire the status byte says whether the value is an answer or a
# complaint, so there is no envelope around it. 0 is an answer, 1 is not.
fn answer(conn, reply) = match reply
  Ok(data) -> ow_frame_out(conn, chr(219) + chr(0) + ow_encode(data))
  Err(msg) -> ow_frame_out(conn, chr(219) + chr(1) + ow_encode(JStr(msg)))

# The reply shapes a real server uses, verified against oxidb-server 0.43.0.
fn reply_to(cmd, request) =
  if cmd == "ping" then Ok(JStr("pong")) else if cmd == "insert" then Ok(one_field("id", JInt(1))) else if cmd == "insert_many" then Ok(JArr(Cons(JInt(2), Cons(JInt(3), Nil)))) else if cmd == "count" then Ok(one_field("count", JInt(3))) else if cmd == "find" then Ok(JArr(Cons(person("ada", "eng", 36), Cons(person("grace", "eng", 45), Nil)))) else if cmd == "update" then Ok(one_field("modified", JInt(1))) else if cmd == "delete" then Ok(one_field("deleted", JInt(1))) else Err("unknown command: " + cmd)

fn one_field(key, value) = JObj(Cons(Field(key, value), Nil))
