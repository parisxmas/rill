# A WebSocket echo server, with a client in the same program so the exchange
# is self-contained. Each connection gets a strand; while it waits for the
# next frame it is parked, not holding a worker.
import "web/ws"

fn serve_ws(conn) =
  request = fill(conn, "", 4)
  if ws_accept(conn, request) then echo_loop(conn, "") else sock_close(conn)

# The leftovers are carried from one frame to the next. A read is not a frame:
# the client below sends both of its messages in one write, so the second
# arrives in the same read as the first and a loop that threw the remainder
# away would answer once and then wait for ever.
fn echo_loop(conn, acc) =
  (msg, rest) = ws_take(conn, acc)
  if str_len(msg) == 0 then ws_close(conn) else echo_back(conn, msg, rest)

fn echo_back(conn, msg, rest) =
  ws_write(conn, "echo: " + msg)
  echo_loop(conn, rest)

fn accept_loop(server, remaining) =
  conn = tcp_accept(server)
  spawn serve_ws(conn)
  if remaining == 1 then sock_close(server) else accept_loop(server, remaining - 1)

# The client: handshake, then one masked frame per message.
fn client(port, messages) = match connect_to("127.0.0.1", port)
  Err(e) -> println(e)
  Ok(fd) -> talk(fd, messages)

fn talk(fd, messages) =
  sock_write(fd, ws_handshake_request("127.0.0.1", "/"))
  reply = fill(fd, "", 12)
  println(first_line_of(reply))
  exchange(fd, messages)
  ws_close(fd)

fn first_line_of(raw) = unwrap_or(nth(split(raw, "\r\n"), 0), "")

# Both messages in one write, and then both answers read back — which is what
# a browser does when two frames leave in the same tick, and what the echo loop
# above has to survive.
fn exchange(fd, messages) =
  sock_write(fd, all_frames(messages))
  read_back(fd, len(messages), "")

fn all_frames(messages) = match messages
  Nil -> ""
  Cons(m, rest) -> client_frame(m) + all_frames(rest)

fn read_back(fd, n, acc) =
  (msg, rest) = ws_take(fd, acc)
  println(msg)
  if n == 1 then 0 else read_back(fd, n - 1, rest)

fn main() = match listen_on(8090)
  Err(e) -> println(e)
  Ok(server) -> run(server)

fn run(server) =
  spawn accept_loop(server, 1)
  client(8090, Cons("merhaba", Cons("dunya", Nil)))
