# `map` over a list of numbers or flat records, handed over at its last use,
# writes each answer over the value in the same cell — from the first cell
# something else holds, the rest is built anew, and that cell is let go of.
# A list something else still holds is never written over (2026-09-25).

extern fn rill_mem_report() -> Int

type P
  P(x: Float, y: Float)

fn step(ps, k) = if k == 0 then ps else step(map(ps, \p -> P(p.x + 1.0, p.y * 2.0)), k - 1)

fn run() =
  tail = Cons(10, Cons(20, Nil))
  front = Cons(1, Cons(2, tail))
  doubled = map(front, \x -> x * 2)
  println(doubled)
  println(tail)
  kept = Cons(5, Cons(6, Nil))
  also = map(kept, \x -> x + 1)
  println(kept)
  println(also)
  halves = map(range(1, 4), \x -> to_float(x) / 2.0)
  println(halves)
  println(step(Cons(P(0.0, 1.0), Cons(P(1.0, 1.0), Nil)), 3))
  big = step(map(range(1, 100000), \i -> P(to_float(i), 1.0)), 5)
  println(len(big))

fn main() =
  run()
  println(int_to_str(rill_mem_report()))
  0
