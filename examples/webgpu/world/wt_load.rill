# A wt-style load run: sixteen players at once, each walking and firing for
# ninety seconds, so the server's memory can be watched from outside while a
# full valley plays. No assertions here — the numbers this test produces are
# read off `ps`, not printed by it.
#
#   rill build server.rill -o srv && ./srv 8092 &
#   rill run wt_load.rill        # then watch the server's RSS
import "ws"

extern fn sin(x: Float) -> Float

extern fn cos(x: Float) -> Float

fn port() = 8092

fn players() = 16

fn frames_each() = 1800

fn put_f32(b, sc, v) =
  poke_f32(sc, 0, v)
  strbuf_byte(b, peek_u8(sc, 0))
  strbuf_byte(b, peek_u8(sc, 1))
  strbuf_byte(b, peek_u8(sc, 2))
  strbuf_byte(b, peek_u8(sc, 3))

fn input_msg(sc, yaw, keys) =
  b = strbuf()
  strbuf_byte(b, 105)
  strbuf_byte(b, keys)
  put_f32(b, sc, yaw)
  put_f32(b, sc, 0.0)
  strbuf_str(b)

fn fire_msg(sc, yaw) =
  b = strbuf()
  strbuf_byte(b, 102)
  put_f32(b, sc, sin(yaw))
  put_f32(b, sc, 0.0)
  put_f32(b, sc, 0.0 - cos(yaw))
  strbuf_str(b)

fn header_rest(fd, buf) =
  at = str_find(buf, "\r\n\r\n")
  if at < 0 then grow_header(fd, buf) else str_sub(buf, at + 4, str_len(buf) - at - 4)

fn grow_header(fd, buf) =
  more = fill(fd, buf, str_len(buf) + 1)
  if str_len(more) == str_len(buf) then "" else header_rest(fd, more)

fn client(i, done) = match connect_to("127.0.0.1", port())
  Err(e) ->
    println("player " + int_to_str(i) + " could not connect: " + e)
    send(done, 0)
  Ok(fd) -> play(i, fd, done)

fn play(i, fd, done) =
  sock_write(fd, ws_handshake_request("127.0.0.1", "/?p=135"))
  acc = header_rest(fd, fill(fd, "", 4))
  (h, a2) = ws_take(fd, acc)
  if str_len(h) == 0 || str_get(h, 0) != 104 then turned_away(i, fd, done) else walk_about(i, fd, a2, done)

fn turned_away(i, fd, done) =
  println("player " + int_to_str(i) + " was turned away")
  sock_close(fd)
  send(done, 0)

fn walk_about(i, fd, acc, done) =
  sc = alloc_bytes(8)
  yaw = to_float(i) * 0.39
  live(i, fd, acc, sc, yaw, 0)
  ws_close(fd)
  send(done, 1)

# One frame read, and every so often something said back: a walk every fifth
# frame, a shot every fiftieth — about what a person is worth in traffic.
fn live(i, fd, acc, sc, yaw, n) =
  (m, rest) = ws_take(fd, acc)
  if str_len(m) == 0 then 0 else heard(i, fd, rest, sc, yaw, n)

fn heard(i, fd, rest, sc, yaw, n) =
  if n % 5 == 0 then sock_write(fd, client_frame_bin(input_msg(sc, yaw + to_float(n) * 0.001, 33))) else 0
  if n % 50 == 25 then sock_write(fd, client_frame_bin(fire_msg(sc, yaw + to_float(n) * 0.001))) else 0
  if n >= frames_each() then 1 else live(i, fd, rest, sc, yaw, n + 1)

fn gather(done, k) =
  if k == 0 then 0 else took(done, k)

fn took(done, k) =
  recv(done)
  gather(done, k - 1)

fn main() =
  done = channel(players())

  for i in 0..players()
    spawn client(i, done)

  gather(done, players())
  println("all " + int_to_str(players()) + " players done")
