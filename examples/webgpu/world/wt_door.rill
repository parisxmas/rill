# The door, against a real store.
#
# Everything a stranger can send arrives as text, so most of what is worth
# pinning here is what happens to text that is not what was expected: a number
# out of range, a name with a quotation mark in it, a token nobody minted, a
# body with the key missing altogether.
import "oxiresp"
import "door" as d
import "accounts" as a

fn say(what, got, want) =
  println("  " + what + ": " + got + (if got == want then "" else "  (want " + want + ")"))

fn sayn(what, got, want) = say(what, int_to_str(got), int_to_str(want))

fn has(hay, needle) = if str_find(hay, needle) >= 0 then 1 else 0

fn fresh(p) = p + str_sub(a.secret_hex(1), 0, 6)

# Shut every valley still on this token's list, whatever the test named them.
fn shut_rest(fd, token) =
  mine = d.answer(fd, "POST", "/api/mine", "token=" + token + "\n")
  at = str_find(mine, "\"name\":\"")
  if at < 0 then 0
  else
    # Eight characters, not nine: `"name":"` — the nine was copied from the
    # token's extraction, whose key is a letter longer, and the missing first
    # letter made a name no shut could match, which made this loop forever.
    rest = str_sub(mine, at + 8, str_len(mine) - at - 8)
    name = str_sub(rest, 0, str_find(rest, "\""))
    d.answer(fd, "POST", "/api/shut", "token=" + token + "\nname=" + name + "\n")
    shut_rest(fd, token)

fn req(method, path, body) =
  method + " " + path + " HTTP/1.1\r\nHost: x\r\nContent-Length: " + int_to_str(str_len(body)) + "\r\n\r\n" + body

fn main() = match kv_connect("127.0.0.1", 6390)
  Err(e) -> println("no OxiMem — " + e)
  Ok(fd) ->
    println("reading a request")
    r = req("POST", "/api/login", "who=ada\nkey=beef\n")
    say("the method", d.method_of(r), "POST")
    say("the path", d.path_of(r), "/api/login")
    sayn("the length", d.content_len(r), 17)
    say("a header is found whatever its case",
        d.header_of("GET / HTTP/1.1\r\nCoNtEnT-LeNgTh: 42\r\n\r\n", "content-length"), "42")
    say("a value from the body", d.body_val(d.body_of(r), "who"), "ada")
    say("the second line too", d.body_val(d.body_of(r), "key"), "beef")
    say("a key that is not there is nothing", d.body_val(d.body_of(r), "nope"), "")
    # A key that is a prefix of another must not answer for it.
    say("a prefix is not a match", d.body_val("whoever=x\n", "who"), "")

    println("numbers a stranger sent")
    sayn("in range, kept", d.clampi(500, 0, 1200), 500)
    sayn("above, pulled down", d.clampi(1000000, 0, 1200), 1200)
    sayn("below, pulled up", d.clampi(0 - 5, 2, 32), 2)
    # `str_to_int` of a word is nought, which for `players` would be a valley
    # nobody can enter; the floor is what saves it.
    sayn("a word where a number was wanted", d.clampi(str_to_int("lots"), 2, 32), 2)

    println("the hour the doors open")
    say("a word it knows", d.time_of("time=night\n"), "night")
    say("a number of seconds", d.time_of("time=200\n"), "200")
    say("out of range, clamped", d.time_of("time=9999\n"), "359")
    say("nothing said, noon", d.time_of(""), "noon")
    say("nonsense, noon", d.time_of("time=teatime\n"), "noon")

    println("what may be written into a reply")
    say("ordinary words pass", d.safe_text("that name is taken"), "that name is taken")
    say("a quotation mark cannot end the string early",
        d.safe_text("ada\" + evil"), "ada  evil")
    say("and neither can a backslash or a brace",
        d.safe_text("a\\b{c}"), "abc")

    println("registering through the door")
    who = fresh("ada")
    key = a.secret_hex(4)
    reg = d.answer(fd, "POST", "/api/register", "who=" + who + "\nkey=" + key + "\n")
    sayn("it says yes", has(reg, "\"ok\":true"), 1)
    sayn("and hands back a token", has(reg, "\"token\":\""), 1)
    sayn("the same name again is refused", has(d.answer(fd, "POST", "/api/register",
        "who=" + who + "\nkey=" + key + "\n"), "that name is taken"), 1)

    println("signing in through the door")
    lin = d.answer(fd, "POST", "/api/login", "who=" + who + "\nkey=" + key + "\n")
    sayn("the right word gets in", has(lin, "\"ok\":true"), 1)
    sayn("a wrong word does not", has(d.answer(fd, "POST", "/api/login",
        "who=" + who + "\nkey=" + a.secret_hex(4) + "\n"), "\"ok\":false"), 1)
    # The refusal for a name nobody registered must read the same as the one
    # for a wrong word, or it answers "does this name exist".
    say("and a name nobody made reads the same",
        d.answer(fd, "POST", "/api/login", "who=" + fresh("ghost") + "\nkey=" + key + "\n"),
        d.answer(fd, "POST", "/api/login", "who=" + who + "\nkey=" + a.secret_hex(4) + "\n"))

    token = str_sub(lin, str_find(lin, "\"token\":\"") + 9, 32)
    sayn("a token was read back out", str_len(token), 32)

    println("making a valley")
    sayn("without a token, no", has(d.answer(fd, "POST", "/api/make", "name=x\n"), "sign in first"), 1)
    vname = fresh("vale")
    made = d.answer(fd, "POST", "/api/make",
        "token=" + token + "\nname=" + vname + "\nplayers=8\ntime=night\ngravity=120\npines=50\ncrystals=20\ngrass=100\nmeteors=1\nmatch=600\nreport=10\n")
    sayn("with one, yes", has(made, "\"ok\":true"), 1)
    sayn("and it has an address", has(made, "\"path\":\"/valley"), 1)
    sayn("a second valley of the same name is refused",
         has(d.answer(fd, "POST", "/api/make", "token=" + token + "\nname=" + vname + "\n"),
             "already called that"), 1)
    sayn("a valley named like a bad account is refused",
         has(d.answer(fd, "POST", "/api/make", "token=" + token + "\nname=Ada\n"), "\"ok\":false"), 1)

    println("what was written down")
    mine = d.answer(fd, "POST", "/api/mine", "token=" + token + "\n")
    sayn("the valley is listed", has(mine, "\"name\":\"" + vname + "\""), 1)
    sayn("with the players asked for", has(mine, "\"players\":8"), 1)
    sayn("the hour asked for", has(mine, "\"time\":\"night\""), 1)
    sayn("the gravity asked for", has(mine, "\"gravity\":120"), 1)
    sayn("the pines asked for", has(mine, "\"pines\":50"), 1)
    sayn("the crystals asked for", has(mine, "\"crystals\":20"), 1)
    sayn("the grass asked for", has(mine, "\"grass\":100"), 1)
    sayn("the meteors asked for", has(mine, "\"meteors\":1"), 1)
    sayn("the match length asked for", has(mine, "\"match\":600"), 1)
    sayn("the report length asked for", has(mine, "\"report\":10"), 1)

    println("a valley made with nothing said")
    dname = fresh("dfl")
    d.answer(fd, "POST", "/api/make", "token=" + token + "\nname=" + dname + "\n")
    dm = d.answer(fd, "POST", "/api/mine", "token=" + token + "\n")
    sayn("takes the house numbers", has(dm, "\"players\":16"), 1)
    sayn("and the house pines", has(dm, "\"pines\":400"), 1)

    println("the limit on how many")
    sayn("a third is allowed", has(d.answer(fd, "POST", "/api/make",
        "token=" + token + "\nname=" + fresh("thr") + "\n"), "\"ok\":true"), 1)
    sayn("a fourth is not", has(d.answer(fd, "POST", "/api/make",
        "token=" + token + "\nname=" + fresh("fou") + "\n"), "already have three"), 1)

    println("shutting one down")
    sayn("somebody else's is not yours to shut", has(d.answer(fd, "POST", "/api/shut",
        "token=" + token + "\nname=kuzey\n"), "no valley by that name"), 1)
    sayn("your own is", has(d.answer(fd, "POST", "/api/shut",
        "token=" + token + "\nname=" + vname + "\n"), "\"ok\":true"), 1)
    sayn("and then it is gone from your list",
         has(d.answer(fd, "POST", "/api/mine", "token=" + token + "\n"), "\"name\":\"" + vname + "\""), 0)

    # Leave nothing behind: on the box a keeper starts a container for every
    # definition it finds, and a test that leaks two valleys per run is a test
    # that slowly fills the machine with them.
    d.answer(fd, "POST", "/api/shut", "token=" + token + "\nname=" + dname + "\n")
    shut_rest(fd, token)
    sayn("and the test cleans up after itself",
         has(d.answer(fd, "POST", "/api/mine", "token=" + token + "\n"), "\"name\""), 0)

    println("doors that are not there")
    sayn("an unknown path", has(d.answer(fd, "GET", "/api/nothing", ""), "no such door"), 1)
    sayn("the right path by the wrong method", has(d.answer(fd, "GET", "/api/make", ""), "no such door"), 1)
    println("done")
