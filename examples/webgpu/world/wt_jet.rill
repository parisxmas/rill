# A native run for the planet's pull and the pack that fights it.
#
# Both ends run `walk`, so this is the arithmetic the server does and the
# browser predicts — which is the whole reason the pack lives in the valley
# and not in the page.
#
# The key is one key, and which of its two jobs it is doing is decided by how
# it was pressed: a press is a jump however long it is held, and a second
# press soon after the first is what lights the pack. So the legs are tested
# by pressing once and the pack by pressing twice, and the difference between
# those two runs is the whole of what this file is about.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

fn run(s, n, keys, top) =
  if n == 0 then top
  else
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, keys)
    run(s, n - 1, keys, if v.player_y(s) > top then v.player_y(s) else top)

fn ground_at(s) = v.ground(v.player_x(s), v.player_z(s))

fn dist(dx, dz) = sqrt(dx * dx + dz * dz)

# Somewhere new, on the floor, with a full tank — which is what `place_player`
# promises and what every stage below starts from.
fn fresh(s) =
  v.respawn(s)
  run(s, 30, 0, 0.0 - 1000.0)
  1

# A tap: down for a frame, up for a frame.
fn tap(s) =
  run(s, 1, 16, 0.0 - 1000.0)
  run(s, 1, 0, 0.0 - 1000.0)
  1

# How many frames the pack needs to stop a fall of `vy`, with the key held
# and the pack already armed. Counted rather than reasoned about: the thrust
# is written as a move toward the climb rate, so what it does to a body that
# is already moving fast the wrong way is a question for a measurement.
fn arrest(s, vy) =
  v.respawn(s)
  run(s, 30, 0, 0.0 - 1000.0)
  tap(s)
  run(s, 2, 16, 0.0 - 1000.0)
  # Two hundred metres up, because the question is how long the pack takes
  # and not how far it is to the floor: dropped at thirty a second from where
  # a respawn stands, the answer was two frames and the ground, which is a
  # measurement of the terrain rather than of the pack.
  poke_f32(s, 22, ground_at(s) + 200.0)
  poke_f32(s, 24, vy)
  arrest_count(s, 0)

fn arrest_count(s, n) =
  if peek_f32(s, 24) >= 0.0 || n > 600 then n
  else
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 16)
    arrest_count(s, n + 1)

# One press, then the key up: the legs alone.
fn hop(s) =
  g0 = ground_at(s)
  run(s, 1, 16, 0.0 - 1000.0)
  run(s, 600, 0, 0.0 - 1000.0) - g0

fn main() =
  w = v.init(48, 20, 20, 20)
  s = v.join(w)
  fresh(s)

  say("the planet pulls at the old constant", to_int(v.gravity(w) + 0.5), 26)
  say("and the tank starts full", cm(v.jet_fuel(s)), 100)

  # v squared over twice g: nine and a half metres a second against
  # twenty-six is a metre and three quarters, which is what this valley has
  # always jumped.
  # A hundred and seventy-three is the arithmetic; a hundred and sixty-six is
  # what sixty samples a second sees of it, because the apex falls between two
  # frames and neither of them is it.
  say("a jump clears, cm", cm(hop(s)), 166)

  # The same legs on a tenth of the pull carry ten times as far. Nothing about
  # the jump was rewritten to make this happen — it falls out of the number.
  v.set_gravity(w, 2.6)
  fresh(s)
  say("the same jump on a tenth of it, cm", cm(hop(s)), 1728)
  v.set_gravity(w, 26.0)

  # Held from a single press, the pack stays where it is: this is a jump and
  # nothing else, whatever the key does afterwards. It is the case the old
  # gesture got wrong — nobody could clear a rock without taking off.
  fresh(s)
  g0 = ground_at(s)
  held = run(s, 600, 16, 0.0 - 1000.0) - g0
  say("holding one press is still a jump, cm", cm(held), 166)
  say("and the tank is untouched", cm(v.jet_fuel(s)), 100)

  # Tapped, then pressed again and held: the pack takes over the moment the
  # feet are off the ground and holds the climb at thirteen metres a second
  # until the tank is out.
  fresh(s)
  g1 = ground_at(s)
  tap(s)
  top = run(s, 178, 16, 0.0 - 1000.0)
  # Thirty-two metres on one tank, which is twice the pine it used to be —
  # and a shade over twice the old fifteen, because a pack that reaches its
  # ceiling sooner flies more of its burn at that ceiling.
  say("the pack lifts twice a pine's worth, m", to_int(top - g1), 32)
  say("and empties the tank", cm(v.jet_fuel(s)), 0)
  say("the pack is out", v.jet_on(s), 0)


  # Nothing holds it up now: the key is still down and it is still a fall.
  run(s, 240, 16, 0.0 - 1000.0)
  # Down again — near the floor it left rather than exactly on it, because
  # what it lands on may be a stone or a crystal it flew up beside.
  say("what goes up comes down", if v.player_y(s) < g1 + 2.0 then 1 else 0, 1)

  # Standing fills it, at a sixth of the rate it burned — thirteen seconds for
  # the whole tank, and nothing at all while falling. Both halves are asserted:
  # that four and a half seconds is now a third of a tank rather than all of
  # it, and that thirteen and a half is the lot.
  say("the tank is all but empty on landing", if v.jet_fuel(s) < 0.1 then 1 else 0, 1)
  run(s, 270, 0, 0.0 - 1000.0)
  # Thirty-four is the arithmetic — four and a half over thirteen and a fifth
  # — and thirty-three is what it comes to from here, because the frame the
  # feet touch down on is still a frame of falling and fills nothing.
  say("four and a half seconds is a third", cm(v.jet_fuel(s)), 33)
  run(s, 540, 0, 0.0 - 1000.0)
  say("thirteen and a half fills it", cm(v.jet_fuel(s)), 100)

  # A tank that has just run dry does not relight on the first drop back in:
  # a quarter has to be there, or a held key is one frame of thrust for every
  # frame of fall.
  fresh(s)
  tap(s)
  run(s, 178, 16, 0.0 - 1000.0)
  say("dry after the burn", cm(v.jet_fuel(s)), 0)
  run(s, 6, 0, 0.0 - 1000.0)
  say("and a sip is not enough to relight", v.jet_dry(s), 1)

  # And a second tap that comes too late is not a pair, it is two jumps. The
  # gap is a third of a second; this waits a whole one.
  fresh(s)
  g2 = ground_at(s)
  tap(s)
  run(s, 60, 0, 0.0 - 1000.0)
  late = run(s, 300, 16, 0.0 - 1000.0) - g2
  say("a late second press does not arm it", cm(v.jet_fuel(s)), 100)

  # And what a slow tick makes of the pair. The server walks twenty times a
  # second on whatever mask arrived last, so a tap two frames long can fall
  # between two of its ticks — it would see one press where the player made
  # two, refuse to arm, and pull a flying player back down. So the page sends
  # the answer rather than the presses: bit ten says the pack is armed, and a
  # tick landing anywhere inside the burn reads it. Held here with no pair at
  # all, which is precisely the case the server is left with.
  fresh(s)
  run(s, 120, 16 + 1024, 0.0 - 1000.0)
  say("a told pack lights without a pair", if v.jet_fuel(s) < 0.9 then 1 else 0, 1)

  # The lean: what the pack does to the ground speed, which is a separate
  # question from what it does to the climb.
  #
  # Measured over the ground rather than read off the constant, because the
  # constant is applied in the middle of a function that also collides, and a
  # doubling that the hillside eats is not a doubling. Run in the air on both
  # counts — the walking figure is taken from a body that has jumped and not
  # lit the pack, so the only difference between the two runs is the thrust.
  fresh(s)
  poke_f32(s, 22, ground_at(s) + 120.0)
  poke_f32(s, 24, 0.0)
  x0 = v.player_x(s)
  z0 = v.player_z(s)
  run(s, 30, 1, 0.0 - 1000.0)
  fell_far = cm(dist(v.player_x(s) - x0, v.player_z(s) - z0))

  fresh(s)
  tap(s)
  run(s, 2, 16, 0.0 - 1000.0)
  poke_f32(s, 22, ground_at(s) + 120.0)
  x1 = v.player_x(s)
  z1 = v.player_z(s)
  run(s, 30, 1 + 16, 0.0 - 1000.0)
  flew_far = cm(dist(v.player_x(s) - x1, v.player_z(s) - z1))

  # Two hundred and eighty-one is half a second at five and a half a second,
  # rounded down from 281.25; twice that is 562 and not 563, because what is
  # doubled is the distance and not the rounded figure printed here.
  say("half a second of walking, in cm", fell_far, 281)
  say("and the same under thrust", flew_far, 562)
  say("which is the lean, in tenths", to_int(v.jet_lean() * 10.0 + 0.5), 20)

  # And the ground is untouched: the pack is what doubles it, not the key.
  fresh(s)
  x2 = v.player_x(s)
  z2 = v.player_z(s)
  run(s, 30, 1, 0.0 - 1000.0)
  say("on foot it is still five and a half, in cm", cm(dist(v.player_x(s) - x2, v.player_z(s) - z2)), 281)

  # And the crouch, which is the other thing one key does to a body.
  #
  # It is here because of how it broke: the ease was written as "if the target
  # is above you go up, otherwise go down", which is right until you arrive —
  # and then a key still held takes the second branch and slides back. It read
  # as the whole view shaking, three tenths a frame, for as long as C was
  # down. So what is asserted is not that it gets there but that it *stays*.
  fresh(s)
  run(s, 60, 64, 0.0 - 1000.0)
  a = cm(v.crouch_of(s))
  run(s, 60, 64, 0.0 - 1000.0)
  b = cm(v.crouch_of(s))
  say("held, it goes all the way down", a, 100)
  say("and stays there", b, 100)
  run(s, 60, 0, 0.0 - 1000.0)
  say("let go, it comes all the way up", cm(v.crouch_of(s)), 0)

  # And the other half of the doubling, which is not height but authority:
  # what the pack does to somebody already falling. At the default pull the
  # net thrust is two and two fifths of a gravity, so thirty metres a second
  # of fall is turned around in about half of one. It was 97 frames before —
  # a second and two thirds, long enough to reach the ground while the pack
  # is still arguing with the fall.
  #
  # Last in the file on purpose: it parks somebody two hundred metres up with
  # an empty tank, and a stage that started from there would be measuring the
  # fall rather than itself.
  say("thirty a second of fall is turned in frames", arrest(s, 0.0 - 30.0), 29)
  println("done")
