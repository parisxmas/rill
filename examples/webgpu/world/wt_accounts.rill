# Accounts, against a real OxiMem rather than a pretend one.
#
# Every interesting thing here is a thing the store does — SETNX refusing the
# second writer, EXPIRE keeping a token alive, a GET on a key that was never
# written — and a stub that answers the way I expect is a stub that agrees
# with my expectations rather than with the engine.
#
#   OXIMEM=127.0.0.1:6390 rill run wt_accounts.rill
import "oxiresp"
import "accounts" as a

fn say(what, got, want) =
  println("  " + what + ": " + got + (if got == want then "" else "  (want " + want + ")"))

fn sayn(what, got, want) = say(what, int_to_str(got), int_to_str(want))

# A value's text, or nothing. Written out rather than reached for with
# `kv_or`, whose fallback would have to name a constructor from another
# module — which is a thing this language does not spell.
fn text_of(r) = match r
  Ok(v) -> kv_text(v)
  Err(_) -> ""

fn host() = "127.0.0.1"
fn port() = 6390

# A name nothing else in the store will collide with, so the file can be run
# twice in a row without a scrub between.
fn fresh(prefix) = prefix + str_sub(a.secret_hex(1), 0, 6)

fn main() = match kv_connect(host(), port())
  Err(e) -> println("no OxiMem on " + host() + ":" + int_to_str(port()) + " — " + e)
  Ok(fd) ->
    println("the rules a name keeps")
    say("a good name passes", a.who_wrong("ada"), "")
    say("digits and hyphens are fine", a.who_wrong("ada-9"), "")
    say("two letters is too short", a.who_wrong("ad"), "a name is at least three letters")
    say("thirteen is too long", a.who_wrong("abcdefghijklm"), "a name is at most twelve letters")
    say("a digit cannot start one", a.who_wrong("9ada"), "a name starts with a letter")
    say("capitals are refused", a.who_wrong("Ada"), "a name is lower-case letters, digits and hyphens")
    say("and so is a space", a.who_wrong("ad a"), "a name is lower-case letters, digits and hyphens")
    # The characters that would have to be escaped somewhere downstream.
    say("and a slash", a.who_wrong("ad/a"), "a name is lower-case letters, digits and hyphens")
    say("and a colon, which is the record's own separator",
        a.who_wrong("ad:a"), "a name is lower-case letters, digits and hyphens")

    println("secrets")
    sayn("a secret is sixteen hex a word", str_len(a.secret_hex(2)), 32)
    sayn("and two of them differ", if a.secret_hex(2) == a.secret_hex(2) then 1 else 0, 0)

    println("making an account")
    who = fresh("ada")
    key = a.secret_hex(4)
    say("a free name is given", a.acct_make(fd, who, key, 1000), "")
    say("the same name twice is not", a.acct_make(fd, who, key, 1000), "that name is taken")
    say("a bad name never reaches the store", a.acct_make(fd, "x", key, 1000),
        "a name is at least three letters")
    say("and neither does an empty word", a.acct_make(fd, fresh("bob"), "", 1000),
        "that word did not arrive")

    println("being let in")
    sayn("the right word is admitted", a.acct_admits(fd, who, key), 1)
    sayn("a wrong word is not", a.acct_admits(fd, who, a.secret_hex(4)), 0)
    # A name nobody registered must answer exactly as a wrong word does, or the
    # difference is a way to ask which names exist.
    sayn("a name that was never made is not", a.acct_admits(fd, fresh("nobody"), key), 0)
    # One flipped hex digit: the derivation must not be near-missing.
    sayn("one digit out is not", a.acct_admits(fd, who,
        (if str_get(key, 0) == 97 then "b" else "a") + str_sub(key, 1, str_len(key) - 1)), 0)

    println("the record")
    rec = text_of(kv_get(fd, a.user_key(who)))
    sayn("it has four fields", if str_len(a.field(rec, 3)) > 0 then 1 else 0, 1)
    sayn("the salt is a hundred and twenty-eight bits", str_len(a.field(rec, 0)), 32)
    sayn("the rounds are written down", str_to_int(a.field(rec, 2)), a.rounds_now())
    sayn("the word itself is nowhere in it", if str_find(rec, key) < 0 then 1 else 0, 1)
    # Two accounts made from the *same* word must not look alike, which is the
    # whole of what the salt is for.
    who2 = fresh("bea")
    a.acct_make(fd, who2, key, 1000)
    rec2 = text_of(kv_get(fd, a.user_key(who2)))
    sayn("the same word twice gives different records",
         if a.field(rec, 1) == a.field(rec2, 1) then 1 else 0, 0)
    sayn("but both still admit it", a.acct_admits(fd, who2, key), 1)

    println("being signed in")
    tok = a.sess_open(fd, who)
    sayn("a token is a hundred and twenty-eight bits", str_len(tok), 32)
    say("and it says who", a.sess_whose(fd, tok), who)
    say("a token nobody minted says nobody", a.sess_whose(fd, a.secret_hex(2)), "")
    say("and so does a malformed one", a.sess_whose(fd, "short"), "")
    sayn("signing out drops it", a.sess_close(fd, tok), 1)
    say("and then it says nobody", a.sess_whose(fd, tok), "")
    # Two sign-ins are two tokens: signing out of one machine must not sign you
    # out of the other.
    t1 = a.sess_open(fd, who)
    t2 = a.sess_open(fd, who)
    sayn("two sign-ins are two tokens", if t1 == t2 then 1 else 0, 0)
    a.sess_close(fd, t1)
    say("dropping one leaves the other", a.sess_whose(fd, t2), who)
    a.sess_close(fd, t2)

    kv_hang_up(fd)
    println("done")
