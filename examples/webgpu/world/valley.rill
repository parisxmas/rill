# A walkable valley: the terrain and its mesh, where the pines and the crystals
# stand, how a player walks, falls and jumps, what the rounds and the fireballs
# do on the way to wherever they land, and the matrices the GPU consumes.
#
# This file is the valley itself and nothing else. It is compiled twice: into
# `world.wasm` for the browser, where `world.rill` puts the browser's names on
# it, and into the server, where `server.rill` runs the same arithmetic for
# everybody at once. Neither of those decides anything about what the valley
# is — that is all here, which is the only reason the two can agree.
#
# Nothing here allocates per frame: the state lives in memory taken once with
# `alloc_bytes` — deliberately uncounted — and every function is handed the
# pointer back.
#
# There are two kinds of block and they have the same layout. One of them is
# the world: it owns the terrain, the instances, the projectiles, the shark and
# the clock, and there is exactly one. The others are players: a walk, a look,
# a health and the push a blast left, one block each. Every block carries a
# pointer to its world at slot 94, and the world's points at itself — so
# `wd(s)` is the world whichever kind of block `s` is, and a valley with one
# player in it is the same arithmetic as a valley with eight.
#
# That is why this file can be the server as well as the client. `walk` moves
# one player, `step_world` moves everything shared, and `frame` is the two of
# them and a camera, which is what a browser with nobody else in the valley
# needs. A server calls the first two directly, once per player and once per
# tick.
#
# Slot layout, in slots from the base pointer. A slot is four bytes for the
# numbers and a pointer's width for the pointers, so the two live at different
# byte offsets on a 64-bit machine and at the same ones under wasm — which is
# why a number and a pointer never share a slot number here.
#
# Player, or the world acting as one:
#   f32  0..15   view-projection matrix, column-major
#   f32 16..18   eye position (for lighting and fog)
#   f32 19, 20   yaw, pitch
#   f32 21..23   camera foot position
#   f32 24       vertical velocity   25  grounded flag
#   f32 30, 31   what a server was last told: the keys, and a shot asked for
#   f32 48..50   the direction of that shot   52  when one last left
#   f32 51       when anything was last heard from them
#   f32 32..47   the sun's shadow matrix, column-major
#   f32 82       health, one to zero        84, 85  the push a blast left
#   f32 101      the health this player had last frame — see `note_hit`
#   f32 107      how long they have been down, in seconds
#   f32 108      when they last chose a name, on the world's clock
#   f32 109, 110 rounds taken, and rounds landed on somebody else
#   f32 111      how much the sights are magnifying, 1 when they are not
#   f32 115      breath, one to zero        116  out of it, until 115 comes back
#   f32 118      rounds left in the magazine
#   f32 123      whether their lamp is lit — see `set_keys`
#   f32 124      what the caller adds to a spawn's seed — see `spawn_salt`
#   f32 125      when they last said something — see `may_say`
#   f32 102..104 what being shot did to their head: a clock, how hard, which way
#   f32 99       this player's id, which outlives its place in the table
#   ptr 94       the world it is in; in the world's own block, itself
#
# World only:
#   f32 26..28   wind: angle, strength, accumulated time
#   f32 29       wind phase — see `step_world`
#   f32 56..59   terrain vertex count, pine count, crystal count, grass count
#   f32 60, 61   how many rounds and shards there have ever been — the ring
#                slot is that modulo the ring, so the count is also a log
#   f32 62       crystals broken so far    70..72  where the last one stood
#   f32 63       next slot in the fireball ring   73  the charge's own clock
#   ptr 77       chargers: crystal, its size, mode, clock, and who it is for
#   f32 79       gate: zero lets one charge begin this frame
#   f32 80       next slot in the blast ring    ptr 81  the blasts themselves
#   f32 53       whether the far crystals throw at all
#   f32 86..93   the shark: where, which way, what it is doing
#   ptr 74       the fireballs the far crystals throw
#   ptr 64..67   terrain mesh, pine, crystal and grass instances
#   ptr 68, 69   the bullets, and the shards they knock loose
#   ptr 96       the players, as blocks    f32 98  how many   100  the next id
#   ptr 97       a ring of which crystal broke, indexed by the tally at 62
#   f32 105      how many people a client can see    ptr 106  where they are
#   f32 112      rounds that have found somebody   ptr 113  who, by whom, how much
#
# The sun's matrix is written into whichever block was asked, because it is the
# host that swings the sun and the host has one block in its hand.

extern fn sin(x: Float) -> Float

extern fn cos(x: Float) -> Float

extern fn tan(x: Float) -> Float

extern fn floor(x: Float) -> Float

extern fn sqrt(x: Float) -> Float

extern fn exp(x: Float) -> Float

# ---- who is where ----------------------------------------------------------
#
# The world a block belongs to. The world's own block points at itself, so this
# is safe to ask of anything and costs one load — which is what lets every
# function below take "a block" and not care which kind it was handed.

fn wd(s) = peek_ptr(s, 94)

fn player_cap() = 32

fn player_count(w) = to_int(peek_f32(w, 98))

fn player_at(w, i) = peek_ptr(peek_ptr(w, 96), i)

# ---- the shape of the land -------------------------------------------------

fn fract(x) = x - floor(x)

fn clampf(x, lo, hi) = max(lo, min(hi, x))

# One pseudo-random number per lattice point; the classic sine hash.
fn hash2(ix, iz) = fract(sin(ix * 127.1 + iz * 311.7) * 43758.5453)

# Value noise: hashes at the cell corners, blended with a smoothstep.
fn vnoise(x, z) =
  ix = floor(x)
  iz = floor(z)
  fx = x - ix
  fz = z - iz
  ux = fx * fx * (3.0 - 2.0 * fx)
  uz = fz * fz * (3.0 - 2.0 * fz)
  a = hash2(ix, iz)
  b = hash2(ix + 1.0, iz)
  c = hash2(ix, iz + 1.0)
  d = hash2(ix + 1.0, iz + 1.0)
  a + (b - a) * ux + (c - a) * uz + (a - b - c + d) * ux * uz

# The valley: three octaves of noise, a lake carved from the middle, and a
# rim that rises toward the edges so the world has a horizon of its own.
fn height(x, z) =
  n1 = vnoise(x * 0.035, z * 0.035) * 9.0
  n2 = vnoise(x * 0.09 + 40.0, z * 0.09) * 4.0
  n3 = vnoise(x * 0.22, z * 0.22 + 40.0) * 1.4
  n = n1 + n2 + n3
  d2 = (x * x + z * z) / 7225.0
  clampf(n + d2 * d2 * 26.0 - 10.5 * exp(0.0 - (x * x + z * z) / 1400.0), 0.0 - 9.0, 34.0)

# Whether the player is standing in the lake. The water sits at zero and the
# ground is carved below it, so the ground under their feet being negative is
# the whole test — no flag to keep, and nothing that can get out of step with
# where they actually are.
fn in_water(s) =
  yes(height(peek_f32(s, 21), peek_f32(s, 23)) < 0.0)

# The host asks too, so that a shot taken while wading is refused before the
# bolt cycles and the bang plays rather than after: a rifle that goes off and
# does nothing is worse than one that will not go off.
fn wading(s: Ptr) -> Int = in_water(s)

# ---- building the mesh -----------------------------------------------------
#
# 96 x 96 cells, two triangles each. The colour is per face — that is where
# the low-poly banding comes from — but the normal is per corner, taken from
# the height field's own slope, so the ground is lit as the smooth surface it
# is. Facets in the palette read as style; facets in the lighting read as a
# mistake, and a metre-wide triangle lit flat has a hard edge on every side.
# A vertex is nine floats — position, normal, colour.
#
# The heights come from a lattice computed once, not from `height` called at
# each cell's four corners: a corner belongs to four cells, and `height` is
# twelve sines deep. It is also the more correct way round — two cells sharing
# an edge now read one number for it rather than each working out its own.

fn world_w() = 170.0

fn cell_step(n) = world_w() / to_float(n)

# Where lattice column (or row) `k` stands. Every vertex of the mesh is at one
# of these, so what two cells share they agree about exactly.
fn lattice(k, s) = to_float(k) * s - world_w() * 0.5

fn lerp(a, b, t) = a + (b - a) * t

fn smoothstep(a, b, x) =
  t = clampf((x - a) / (b - a), 0.0, 1.0)
  t * t * (3.0 - 2.0 * t)

# The colour of one corner: sand, cliff, snow or grass, but weighed rather
# than chosen. Thresholds put the whole change at one triangle's edge, and a
# snowline or a band of dark rock that turns on at an exact height has that
# edge for a boundary — visibly, because the edge is a metre long. `ny` is the
# normal's upward component; low means steep. The order is the order they
# override in: grass under snow, snow under rock, rock under sand.
fn band_r(h, ny) =
  lerp(lerp(lerp(0.16, 0.8, smoothstep(9.8, 11.8, h)), 0.38, 1.0 - smoothstep(0.6, 0.84, ny)), 0.72, 1.0 - smoothstep(0.05, 1.15, h))

fn band_g(h, ny) =
  lerp(lerp(lerp(0.38, 0.8, smoothstep(9.8, 11.8, h)), 0.38, 1.0 - smoothstep(0.6, 0.84, ny)), 0.63, 1.0 - smoothstep(0.05, 1.15, h))

fn band_b(h, ny) =
  lerp(lerp(lerp(0.26, 0.86, smoothstep(9.8, 11.8, h)), 0.46, 1.0 - smoothstep(0.6, 0.84, ny)), 0.45, 1.0 - smoothstep(0.05, 1.15, h))

# The corner's own height and its own steepness decide its colour, so the GPU
# interpolates the band across the triangle instead of stopping it at the edge.
fn emit_vert(m, at, x, y, z, nx, ny, nz, j) =
  poke_f32(m, at, x)
  poke_f32(m, at + 1, y)
  poke_f32(m, at + 2, z)
  poke_f32(m, at + 3, nx)
  poke_f32(m, at + 4, ny)
  poke_f32(m, at + 5, nz)
  poke_f32(m, at + 6, band_r(y, ny) * j)
  poke_f32(m, at + 7, band_g(y, ny) * j)
  poke_f32(m, at + 8, band_b(y, ny) * j)

fn clampi(v, hi) = max(0, min(hi, v))

# The slope at a lattice corner, from the two heights either side of it. The
# terrain is a height field, so this is a subtraction rather than a cross
# product — and a corner shared by four cells gets one answer instead of four,
# which is exactly what makes the lighting continuous across the edge.
fn slope_x(hs: Buf(F64), w, ix, iz, s) =
  a = clampi(ix - 1, w - 1)
  b = clampi(ix + 1, w - 1)
  (hs[iz * w + b] - hs[iz * w + a]) / (to_float(b - a) * s)

fn slope_z(hs: Buf(F64), w, ix, iz, s) =
  a = clampi(iz - 1, w - 1)
  b = clampi(iz + 1, w - 1)
  (hs[b * w + ix] - hs[a * w + ix]) / (to_float(b - a) * s)

fn emit_corner(m, at, hs: Buf(F64), w, s, ix, iz, j) =
  sx = slope_x(hs, w, ix, iz, s)
  sz = slope_z(hs, w, ix, iz, s)
  il = 1.0 / sqrt(sx * sx + 1.0 + sz * sz)
  x = lattice(ix, s)
  z = lattice(iz, s)
  y = hs[iz * w + ix]
  emit_vert(m, at, x, y, z, (0.0 - sx) * il, il, (0.0 - sz) * il, j)

# One triangle — 27 floats — named by its three lattice corners rather than by
# nine coordinates, because the corners are what everything else is read from.
fn emit_tri(m, at, hs: Buf(F64), w, s, ia, ja, ib, jb, ic, jc) =
  # A little brightness per cell, so the ground is not uniform. Half what it
  # used to carry: with grain in the ground texture, a cell seven per cent
  # brighter than its neighbour is a seam, not variety.
  j = 0.965 + 0.07 * hash2(floor(lattice(ia, s) * 3.1), floor(lattice(ja, s) * 3.1))
  emit_corner(m, at, hs, w, s, ia, ja, j)
  emit_corner(m, at + 9, hs, w, s, ib, jb, j)
  emit_corner(m, at + 18, hs, w, s, ic, jc, j)

# The lattice: (n + 1) squared samples of the terrain, one per corner.
fn gen_heights(hs: Buf(F64), n, s) =
  w = n + 1

  for k in 0..w * w
    hs[k] = height(lattice(k % w, s), lattice(k / w, s))

# Both triangles of every cell, reading the corners the lattice already has.
fn gen_cells(m, hs: Buf(F64), n, s) =
  w = n + 1

  for i in 0..n * n
    ix = i % n
    iz = i / n
    at = i * 54
    emit_tri(m, at, hs, w, s, ix, iz, ix, iz + 1, ix + 1, iz + 1)
    emit_tri(m, at + 27, hs, w, s, ix, iz, ix + 1, iz + 1, ix + 1, iz)

# ---- placing the pines and the crystals ------------------------------------
#
# Candidate spots come from the same hash as the terrain; each is kept or
# rejected by where it landed: pines on the grass slopes, crystals near the
# waterline with a few strays up in the rocks. An instance is eight floats —
# position, scale, rotation, colour.

fn near_spawn(x, z) = (x + 14.0) * (x + 14.0) + (z + 34.0) * (z + 34.0) < 81.0

fn keep_pine(h, seed) = if h < 1.0 then false else if h > 9.5 then false else seed < 0.22

fn keep_crystal(h, seed) = if h < 0.7 then false else if h > 3.5 then seed < 0.012 else seed < 0.11

fn keep_grass(h, seed) = if h < 0.9 then false else if h > 8.5 then false else seed < 0.85

# Poplars take the water's edge, which is the one band of this valley nothing
# else wants: a pine will not stand below a metre and the crystals thin out
# under one, so the shore was bare ground between the lake and the treeline.
# It is also where a poplar belongs — they follow water, and a line of them
# along a shore is a thing anybody who has seen one recognises without being
# told. So the belt is not a decoration on top of the forest; it is the
# forest ending and something else beginning, which is what a second tree is
# for.
fn keep_poplar(h, seed) = if h < 0.35 then false else if h > 2.9 then false else seed < 0.30

# ---- the flowers ------------------------------------------------------------
#
# Everything else in this valley is scattered: a candidate, a hash, a rule
# about the ground, and whatever survives stands where it fell. Flowers are
# not scattered. They come in patches, because a plant that seeds itself
# seeds itself next to its parent, and a meadow with an even sprinkling of
# flowers over it is a meadow nobody has ever walked in.
#
# So the walk picks *patches* — the same hash, the same kind of rule — and
# each one puts a dozen or two plants inside a couple of metres of itself.
# What that buys is somewhere to walk towards, which an even sprinkle never
# gives you.
#
# They collide with nothing. There is no sphere, no entry in the walk's
# collision lists, nothing in any ring: they are drawn and that is all. You
# walk through them.
fn flower_patches(npine: Int) -> Int = npine / 8

fn flowers_per_patch() = 18

fn flower_cap(npine: Int) -> Int = flower_patches(npine) * flowers_per_patch()

# Open ground, and lower than the pines like to stand: the meadow between the
# shore and the treeline, and the flats above it. Not on the bare tops, where
# nothing else grows either.
fn keep_flowers(h, seed) = if h < 0.9 then false else if h > 7.5 then false else seed < 0.16

fn flowers(s: Ptr) -> Ptr = peek_ptr(wd(s), 71)

# Slot 251, which is above every pointer this block has on either target —
# and that is not a preference, it is the only stretch that works twice. A
# pointer is eight bytes natively and four under wasm, so float slot 64 and
# pointer slot 64 are the same bytes in the browser and thirty-two apart on
# the server: the count went in at 64, sat on top of the terrain mesh, and
# came back as a hundred and ten thousand flowers on wasm and two thousand
# on the server. Pointers here stop at 120; floats from 242 up are clear on
# both, which is where gravity and the jetpack's tank already live.
fn flower_count(s: Ptr) -> Int = to_int(peek_f32(wd(s), 251))

# One patch: a centre, and a couple of dozen plants around it. The spread is
# not even either — `r * r` crowds them towards the middle, which is what a
# patch looks like from above.
fn patch(buf, at, cx, cz, seed) =
  for j in 0..flowers_per_patch()
    one_flower(buf, (at + j) * 8, cx, cz, seed + to_float(j) * 3.7)
  flowers_per_patch()

fn one_flower(buf, k, cx, cz, seed) =
  a = hash2(seed, 19.0) * 6.28318
  r = hash2(seed, 31.0)
  d = r * r * 2.4
  x = cx + cos(a) * d
  z = cz + sin(a) * d
  sd = hash2(seed, 57.0)
  c = hash2(seed, 83.0)
  poke_f32(buf, k, x)
  poke_f32(buf, k + 1, height(x, z))
  poke_f32(buf, k + 2, z)
  poke_f32(buf, k + 3, 0.42 + sd * 0.34)
  poke_f32(buf, k + 4, hash2(seed, 97.0) * 6.28318)
  poke_f32(buf, k + 5, 0.30 + c * 0.22)
  poke_f32(buf, k + 6, 0.34 + c * 0.20)
  poke_f32(buf, k + 7, 0.28 + c * 0.18)
  1

fn sow_flowers(buf, i, made, patches, lim) =
  if i >= lim || made >= patches then made * flowers_per_patch()
  else
    seed = hash2(to_float(i), 401.0)
    x = (hash2(to_float(i), 137.0) - 0.5) * 152.0
    z = (hash2(to_float(i), 211.0) - 0.5) * 152.0
    if keep_flowers(height(x, z), seed) && !near_spawn(x, z) then
      patch(buf, made * flowers_per_patch(), x, z, seed * 313.0)
      sow_flowers(buf, i + 1, made + 1, patches, lim)
    else sow_flowers(buf, i + 1, made, patches, lim)

# The tint each thing carries. A poplar is the pale end of the scale in every
# channel — the leaves are a yellow-green that catches the low sun where the
# pines go black, and the same number lifts the bark, which the shader reads
# as how far to brighten it. That is most of what separates the two trees at
# a distance: one is a dark cone, the other a pale column.
fn inst_r(c, kind) =
  if kind == 0 then 0.1 + c * 0.05
  else if kind == 2 then 0.11 + c * 0.07
  else if kind == 3 then 0.34 + c * 0.18
  else if c < 0.6 then 1.0 else if c < 0.85 then 0.25 else 0.75

fn inst_g(c, kind) =
  if kind == 0 then 0.3 + c * 0.1
  else if kind == 2 then 0.3 + c * 0.16
  else if kind == 3 then 0.50 + c * 0.20
  else if c < 0.6 then 0.72 else if c < 0.85 then 0.95 else 0.45

fn inst_b(c, kind) =
  if kind == 0 then 0.2 + c * 0.06
  else if kind == 2 then 0.13 + c * 0.09
  else if kind == 3 then 0.24 + c * 0.14
  else if c < 0.6 then 0.18 else if c < 0.85 then 0.85 else 1.0

# Taller than a pine and much narrower, which is the whole silhouette.
fn inst_scale(sd, kind) =
  if kind == 0 then 0.85 + sd * 0.9
  else if kind == 2 then 0.55 + sd * 0.8
  else if kind == 3 then 1.0 + sd * 0.7
  else 0.5 + sd * 1.1

fn emit_inst(buf, at, x, y, z, i, kind) =
  s = hash2(to_float(i), 500.0)
  c = hash2(to_float(i), 900.0)
  poke_f32(buf, at, x)
  poke_f32(buf, at + 1, y)
  poke_f32(buf, at + 2, z)
  poke_f32(buf, at + 3, inst_scale(s, kind))
  poke_f32(buf, at + 4, s * 6.28)
  poke_f32(buf, at + 5, inst_r(c, kind))
  poke_f32(buf, at + 6, inst_g(c, kind))
  poke_f32(buf, at + 7, inst_b(c, kind))
  1

# The loosest seed any of the three tests can accept. Above it nothing stands
# whatever the ground is like, and asking costs nothing — where sampling the
# terrain costs twelve sines. Most candidates end here.
fn seed_cap(kind) = if kind == 0 then 0.22 else if kind == 2 then 0.85 else if kind == 3 then 0.30 else 0.11

# Tries candidate `i`; returns 1 if something now stands there.
fn placed(buf, count, i, kind) =
  seed = hash2(to_float(i), 311.0 + to_float(kind))
  if seed >= seed_cap(kind) then 0
  else
    x = (hash2(to_float(i), 7.0 + to_float(kind)) - 0.5) * 152.0
    z = (hash2(to_float(i), 113.0 + to_float(kind)) - 0.5) * 152.0
    h = height(x, z)
    keep = if kind == 0 then keep_pine(h, seed) else if kind == 2 then keep_grass(h, seed) else if kind == 3 then keep_poplar(h, seed) else keep_crystal(h, seed)
    if near_spawn(x, z) then 0 else if keep then emit_inst(buf, count * 8, x, h, z, i, kind) else 0

fn place(buf, i, count, cap, lim, kind) =
  if i >= lim then count else if count >= cap then count else place(buf, i + 1, count + placed(buf, count, i, kind), cap, lim, kind)

# ---- the boulders -----------------------------------------------------------
#
# Rocks do not grow one at a time and they are not scattered evenly. A slope
# sheds them, and what is left is an outcrop: a handful of stones lying within
# a few metres of one another, then thirty metres of nothing, then another
# handful. So this is placed in two passes rather than one — where a cluster
# is, and then where each of its stones is around that centre — which is the
# whole difference between a rockfall and a lawn with pebbles on it.
#
# The kinds above are scattered by one hash over the whole map because that is
# what a forest is. This is the one thing in the valley that is not.

fn rock_clusters() = 26

# Between four and eleven to a cluster, so no two outcrops are the same size
# and none of them is a ring.
fn rock_most() = 11

fn rock_cap() = rock_clusters() * rock_most()

# How far a stone lies from the middle of its own outcrop. Four metres: close
# enough to read as one thing at fifty metres, loose enough that walking into
# one is not walking into all of them.
fn rock_spread() = 4.0

# How steeply the ground tips, as a gradient: metres of rise over metres of
# run. Measured across three metres rather than as a derivative, because a
# boulder is a metre across and what matters is whether the ground tilts under
# a thing that size, not what the surface is doing at a point.
fn rock_tilt(x, z) =
  dx = height(x + 1.5, z) - height(x - 1.5, z)
  dz = height(x, z + 1.5) - height(x, z - 1.5)
  sqrt(dx * dx + dz * dz) / 3.0

# The one number that decides where a boulder may lie, and it is about what
# the ground can hold rather than about what it is made of.
#
# A gradient of 0.62 is a slope of thirty-two degrees, which is roughly where
# loose material stops staying put. Nothing rests above that: a boulder on a
# steeper face has not come to a stop there, it is glued to it, and it reads
# as glued from fifty metres away.
#
# There is deliberately no lower bound. There was one — stones were kept to
# ground the terrain draws grey, on the reasoning that boulders belong to rock
# faces — and it was wrong twice over. It put every stone on the steepest
# ground in the valley, which is exactly where they look stuck; and a boulder
# lying in a meadow is not an error, it is the commonest boulder there is.
fn rock_steep() = 0.62

# Where an outcrop may start: gentler still, so that a cluster can scatter its
# stones outward and stay inside the limit rather than losing half of them to
# it.
fn rock_face() = 0.46

fn stony(x, z) =
  h = height(x, z)
  # Above the waterline: a stone on the lakebed is a stone nobody will see.
  if h < 0.6 then false else if h > 30.0 then false else rock_tilt(x, z) < rock_steep()

# How upright the ground is under a stone, which is what the terrain's own
# colour bands are asked in — `band_r` and its neighbours take a normal's
# upward part, and a height field's is one over the root of one plus its
# gradient squared.
fn rock_up(x, z) =
  t = rock_tilt(x, z)
  1.0 / sqrt(1.0 + t * t)

# Where cluster `c` sits: tried a few times, because most of a valley is not
# a rock face and a first guess usually lands in the meadow or the lake.
fn rock_spot(c, tries) =
  x = (hash2(to_float(c) * 2.9 + to_float(tries) * 17.7, 61.0) - 0.5) * 150.0
  z = (hash2(to_float(c) * 4.3 + to_float(tries) * 13.1, 83.0) - 0.5) * 150.0
  h = height(x, z)
  if h > 0.9 && h < 30.0 && rock_tilt(x, z) < rock_face() then pack_spot(x, z)
  else if tries > 40 then pack_spot(x, z)
  else rock_spot(c, tries + 1)

# One stone of one cluster, if the ground under it will have it. A stone is
# dropped rather than made to fit: the ones that land on the meadow below the
# outcrop or in the water are simply not there, which is what gives a cluster
# a ragged edge instead of a circular one.
fn rock_one(buf, count, c, j) =
  (cx, cz) = rock_spot(c, 0)
  a = hash2(to_float(c) * 7.1 + to_float(j), 131.0) * 6.28318
  r = rock_spread() * sqrt(hash2(to_float(c) * 3.3 + to_float(j), 149.0))
  x = cx + cos(a) * r
  z = cz + sin(a) * r
  h = height(x, z)
  if near_spawn(x, z) then 0
  else if stony(x, z) then emit_rock(buf, count * 8, x, h, z, c, j)
  else 0

# Eight floats, the same stride every instanced thing in this valley uses —
# but the last three are not a colour. A rock takes its colour from the
# terrain's own photograph, so what those slots carry instead is the shape:
# how much this stone is squashed on each axis, and how dark it is against
# its neighbours. One mesh and a sign, and no two boulders alike.
fn emit_rock(buf, at, x, y, z, c, j) =
  s = hash2(to_float(c) * 11.0 + to_float(j), 211.0)
  q = hash2(to_float(c) * 5.0 + to_float(j), 307.0)
  p = hash2(to_float(c) * 13.0 + to_float(j), 401.0)
  # The last three slots are the colour of the ground this stone is lying on
  # — the same `band_r`, `band_g`, `band_b` the terrain's own corners are
  # painted with, asked at this spot.
  #
  # They carried the stone's squash at first, with the choice of mesh in the
  # sign of one of them, and the boulder's colour was a constant: the stone
  # band, on the reasoning that a boulder only ever stands on stony ground.
  # Once it could stand anywhere that reasoning went, and it had been shaky
  # before — the high slopes are painted with the *snow* band and textured
  # with rock, which comes out a warm pale tan, and a boulder in the stone
  # band's grey-blue sat on it looking like a hole in the hillside.
  #
  # So the colour goes where every other instanced thing in this valley keeps
  # its colour, and the shape comes out of the angle instead: the renderer
  # hashes the rotation for the squash and for which of the two meshes this
  # is. Nothing is lost — the angle was a hash to begin with.
  size = 0.55 + s * 1.75
  ny = rock_up(x, z)
  poke_f32(buf, at, x)
  poke_f32(buf, at + 1, y - 0.10 * size)
  poke_f32(buf, at + 2, z)
  poke_f32(buf, at + 3, size)
  poke_f32(buf, at + 4, p * 6.28318)
  poke_f32(buf, at + 5, band_r(y, ny))
  poke_f32(buf, at + 6, band_g(y, ny))
  poke_f32(buf, at + 7, band_b(y, ny))
  1

# ---- standing on one ---------------------------------------------------------
#
# A boulder is not a tree. A trunk is two metres of nothing-you-can-do and the
# only sensible answer to walking into one is to be stopped; a stone is knee
# to waist high and the only sensible answer is to climb it — which is half of
# what an outcrop is for, since a rock you can get on top of is a rock you can
# see over and shoot from.
#
# So a boulder is two things at two heights, and which one it is depends on
# where the feet are. Below its top it is a wall to be pushed out of; at or
# above its top it is ground to stand on. Handed to `collide_all` and nothing
# else — which is what it was at first — it was a wall at every height,
# including the height of somebody standing on top of it, and the top could
# never be reached because the push happens before the jump ever lands.

# How tall a stone of this size is, over the point it is anchored at. Both
# meshes are about nine tenths as tall as they are wide once their own squash
# is in, and this is deliberately a little under that: sinking two centimetres
# into a rock you are standing on is invisible, and floating two above one is
# not.
fn rock_tall(size) = 0.42 * size

# How far from its centre the top of a stone will hold you. Smaller than the
# radius that pushes you out, because the top of a rounded thing is narrower
# than its middle — you should step off the edge a little before the point
# where you could no longer have walked into it.
fn rock_stand(size) = 0.40 * size + 0.20

fn rock_reach(size) = 0.45 * size + 0.35

# The height a stone can be climbed by walking rather than jumping. The same
# distance the ground may rise under a step without anybody thinking about it.
fn rock_step() = 0.55

# The top of the highest boulder under (x, z) that these feet are high enough
# to be standing on, or a long way down if there is none.
fn rock_floor(w, x, y, z) =
  rf_scan(peek_ptr(w, 99), to_int(peek_f32(w, 249)), 0, x, y, z, 0.0 - 1000.0)

fn rf_scan(b, n, i, x, y, z, best) =
  if i >= n then best
  else
    at = i * 8
    size = peek_f32(b, at + 3)
    top = peek_f32(b, at + 1) + rock_tall(size)
    dx = x - peek_f32(b, at)
    dz = z - peek_f32(b, at + 2)
    r = rock_stand(size)
    on = dx * dx + dz * dz < r * r && y > top - rock_step() && top > best
    rf_scan(b, n, i + 1, x, y, z, if on then top else best)

# And the wall half: pushed out of a stone, but only while below its top. The
# margin is the same step, so the frame you clear the edge on is a frame that
# stops shoving you sideways rather than one that fights the landing.
fn collide_rocks(s, w) =
  b = peek_ptr(w, 99)
  n = to_int(peek_f32(w, 249))
  for i in 0..n
    collide_rock(s, b, i)

fn collide_rock(s, b, i) =
  at = i * 8
  size = peek_f32(b, at + 3)
  top = peek_f32(b, at + 1) + rock_tall(size)
  if peek_f32(s, 22) > top - rock_step() then 1
  else
    ix = peek_f32(b, at)
    iz = peek_f32(b, at + 2)
    r = rock_reach(size)
    dx = peek_f32(s, 21) - ix
    dz = peek_f32(s, 23) - iz
    d2 = dx * dx + dz * dz
    if d2 < r * r && d2 > 0.0001 then push_out(s, ix, iz, dx, dz, sqrt(d2), r) else 1

fn rock_cluster(buf, count, c, j, n) =
  if j >= n then count
  else rock_cluster(buf, count + rock_one(buf, count, c, j), c, j + 1, n)

fn place_rocks(buf, c, count) =
  if c >= rock_clusters() then count
  else
    n = 4 + to_int(hash2(to_float(c), 173.0) * to_float(rock_most() - 3))
    place_rocks(buf, c + 1, rock_cluster(buf, count, c, 0, n))

# ---- the walls on the tops --------------------------------------------------
#
# Stone, laid in an L, on the bare flats above the treeline. Pines stop at 9.5
# and crystals are mostly under 3.5, so everything over twelve is open ground
# with nothing on it — which is exactly where a thing you can put your back
# against is worth having, and where a rocket can be seen coming.
#
# A wall is not one object. It is a run of blocks, each standing on its own, and
# taking one out takes out only that one: the shape of what is left is decided
# by what has been shot rather than by a list of damage states somebody wrote.
# The stride is the crystals' — eight floats, with the size at slot 3 — and so
# is the way a piece leaves: the size goes to zero and the renderer stops
# drawing it, which is one number to change and one number to send.

# A note on where these live, paid for the hard way.
#
# `peek_f32(p, i)` reads the byte at `4i`. `peek_ptr(p, i)` reads the byte at
# `8i` — a pointer's index is in pointers, not in floats. So float slot 128 and
# pointer slot 64 are *the same eight bytes*, and this block's pointers start at
# 64. Everything a float wants has to live below 128; everything a pointer wants
# has to live at 64 or above and inside the 1024 bytes, which is pointer slot
# 127.
#
# On wasm32 a pointer is four bytes, so `8i` is `4i` and none of this bites. All
# of it was tested on wasm. The server segfaulted on the first player to move,
# because the round's clock at float 128 was sitting on top of the terrain mesh
# pointer at ptr 64 and writing a time into it.
#
#   floats   121 how many blocks      124 the round's clock
#            122 stones gone          125 the round's phase
#            123 fire shot down       126 how long a round is
#            111 kills  112 deaths    127 how long the board is up
#
#   pointers 114 the blocks           116 the ring of downed fire
#            115 the ring of stones   117 each wall's sphere
#            118 the scratch a segment or a chunk's numbers travel in,
#                because more than eight float arguments go to the stack and
#                stack arguments in a loop are what took the server down
#             76 the pines a warhead took    83 the wear on the glass
#             78 the crystals' bites         75 where rounds have stopped
#
# Those last four are down at seventy rather than up beside the others, and
# the reason is the second half of the trap above. `peek_ptr(p, i)` reads the
# byte at `i * sizeof(void*)`: eight on the server, **four in the browser**.
# So on wasm32 pointer slot i and float slot i are the same four bytes, and a
# buffer parked on a pointer slot whose float twin this block already uses is
# a buffer a counter writes over — in the browser only, silently, while the
# server and every test go on working. 121 to 124 are the round's own floats,
# and the marks' cursor sat on 94, which is `wd`: the pointer back to the
# world. Seventy to seventy-two are where the last crystal stood, which is
# how the second attempt at a home for these went wrong as well.
# `tools/slots.py` counts the pairs now, and it is the only reliable way to
# pick a slot in this file.
fn block_size() = 0.3

# Eight courses of three tenths is the same two and a bit metres the wall was
# when it was three courses of eight tenths: a bit over head height, which is
# what it is for.
fn wall_tall() = 8

fn wall_cap() = 40

# The most blocks one L can want: two arms of nineteen, eight courses high.
fn wall_arm_max() = 26

fn wall_blocks() = wall_arm_max() * 2 * wall_tall()

fn block_cap() = wall_cap() * wall_blocks()

# Where each L stands and how far it reaches, four floats to a wall.
#
# Without this every round in the air tests every stone in the valley on every
# frame, and there are a great many more stones than there were: thirty-two
# rounds against three and a half thousand blocks is a hundred thousand tests a
# frame for walls that are almost all on the other side of the map. One sphere
# a wall throws nearly all of it away before touching a block.
fn wall_box(w) = peek_ptr(w, 117)

fn wall_near(wb, k, x, y, z, reach) =
  dx = peek_f32(wb, k * 4) - x
  dy = peek_f32(wb, k * 4 + 1) - y
  dz = peek_f32(wb, k * 4 + 2) - z
  r = peek_f32(wb, k * 4 + 3) + reach
  dx * dx + dy * dy + dz * dz < r * r

fn blocks_ptr(w) = peek_ptr(w, 114)

# One float per stone: nought standing, one broken. The stone itself cannot
# say — a broken stone is live rubble now, its size well over the threshold —
# and somebody arriving an hour in has missed every event about it. This is
# the whole of the wall's history, held where the wall is, so a joining client
# is handed the state and not asked to have been present.
fn broken_mark(w) = peek_ptr(w, 120)

fn mark_broken(w, i) =
  poke_f32(broken_mark(w), i, 1.0)
  1

fn block_broken(w: Ptr, i: Int) -> Int = yes(peek_f32(broken_mark(w), i) > 0.5)

fn clear_marks(w) =
  mb = broken_mark(w)

  for i in 0..block_cap()
    poke_f32(mb, i, 0.0)

fn block_count(w) = to_int(peek_f32(w, 121))

fn block_f(bb, i, k) = peek_f32(bb, i * 8 + k)

fn block_live(bb, i) = block_f(bb, i, 3) > 0.01

# Level enough to build on, and down where the game is. They stood on the bare
# tops above twelve metres at first, which kept them clear of the trees and
# also clear of everybody: the fighting happens around the meadows and the
# water, and cover a climb away is scenery. The band is three and a half to
# twelve now — above the lake's edge, below the peaks — so an L stands among
# the pines and the crystals where somebody actually ducks behind it.
#
# The levelness test is unchanged and still does the real work: four samples
# three metres out and four more at six, because a wall that starts halfway
# down a slope has one end buried and the other in the air.
#
# No bands any more. Shore, meadow, pine belt, bare tops — a wall may stand
# anywhere the ground is dry and level enough to take it, which is the whole
# of the valley except the lake. The one rule left is the water: the corner
# has to be properly above it, and so does a ring of ground an arm's reach
# out, because an L's arms run eight metres and an arm that walks down the
# beach into the shallows is a wall standing in the lake. A pine through the
# middle of one is allowed and looks like what it is — a wall built round the
# tree that was there first.
# How far from the middle of the map a wall may be sited.
#
# Not the whole of it, which is what it was. The lattice runs from minus half
# `world_w` to plus half of it — eighty-five metres either way — and the sites
# were drawn from exactly that range, so a wall could start on the last row of
# ground in the valley and run its two arms out past the edge of the world.
# What you saw then was an L hanging in the sky over nothing, which is the
# screenshot this line was written from.
#
# Twelve metres of margin: an arm is at most twenty-six stones of thirty
# centimetres, the corner turns a right angle, and the furthest a block can
# get from the site is a little under eleven.
fn wall_span() = world_w() - 24.0

# Where a wall may stand.
#
# It wanted level ground and it wanted rather a lot of it: within one and a
# third metres over a six-metre reach, in every direction. That is a flat, and
# the valley's flats are its tops and its meadows — so every wall in it stood
# on one, and a hillside, which is where cover is worth most, never had any.
#
# A wall on a slope is not a problem to be avoided. Each column already stands
# on its own ground, so a wall crossing a hillside steps down it course by
# course, the way a dry-stone wall actually does. What is left to refuse is
# ground too steep to have built on: `rock_tilt` is the same gradient the
# boulders are placed by, and seven tenths of it is a slope of thirty-five
# degrees.
fn good_site(x, z) =
  h = height(x, z)
  if h < 1.6 then false
  else rock_tilt(x, z) < 0.7 && not_cliff_near(x, z) && dry_at(x, z, 8.0)

# And the same question asked at the reach of an arm, because the middle of a
# site says nothing about what the far end of it is standing on: a wall that
# starts on a shoulder and ends over a drop is the floating wall again, in
# miniature.
fn not_cliff_near(x, z) =
  rock_tilt(x + 6.0, z) < 0.9 && rock_tilt(x - 6.0, z) < 0.9
    && rock_tilt(x, z + 6.0) < 0.9 && rock_tilt(x, z - 6.0) < 0.9

# The four points an arm could reach, all of them clear of the water line.
fn dry_at(x, z, d) =
  height(x + d, z) > 0.4 && height(x - d, z) > 0.4 && height(x, z + d) > 0.4 && height(x, z - d) > 0.4

fn absf(v) = if v < 0.0 then 0.0 - v else v

# A Bool where an Int is wanted, which is most of the wire and half the HUD.
fn yes(b) = if b then 1 else 0

fn place_walls(w, bb) =
  wb = wall_box(w)

  for k in 0..wall_cap()
    set_wall_box(wb, k, 0.0, 0.0 - 1000.0, 0.0, 0.0)

  n = wall_try(w, bb, 0, 0)
  poke_f32(w, 121, to_float(n * wall_blocks()))
  n

fn wall_try(w, bb, i, made) =
  # Twelve thousand tries for forty walls, over the whole map rather than a
  # band of it. This runs once, at init, and a failed try is two hashes and
  # nine heights.
  if i >= 12000 || made >= wall_cap() then made
  else
    x = (hash2(to_float(i), 17.0) - 0.5) * wall_span()
    z = (hash2(to_float(i), 29.0) - 0.5) * wall_span()
    if good_site(x, z) && far_from_walls(wall_box(w), 0, made, x, z) then wall_try(w, bb, i + 1, made + lay_wall(bb, wall_box(w), made, x, z, to_float(i))) else wall_try(w, bb, i + 1, made)

# Fifteen metres from every wall already laid. Without this the first decent
# flat in the hash sequence collects half the walls in the valley — nine of
# sixteen once stood within a few metres of one another on the north-shore
# meadow, a quarry where cover was wanted. Fifteen rather than eighteen,
# because forty walls have to fit where sixteen used to.
fn far_from_walls(wb, k, made, x, z) =
  if k >= made then true
  else
    dx = peek_f32(wb, k * 4) - x
    dz = peek_f32(wb, k * 4 + 2) - z
    if dx * dx + dz * dz < 225.0 then false else far_from_walls(wb, k + 1, made, x, z)

# One L. Two arms meeting at a corner, each a run of blocks, each run three
# high. The turn is always a right angle — that is what makes it an L and not a
# bent line — but which way it faces and how long each arm runs is the site's.
fn lay_wall(bb, wb, wi, x, z, seed) =
  yaw = hash2(seed, 41.0) * 6.28318
  la = 16 + to_int(hash2(seed, 53.0) * 10.9)
  lb = 13 + to_int(hash2(seed, 67.0) * 10.9)
  base = wi * wall_blocks()

  # Nothing is drawn until it is written, so the whole slice starts empty and
  # the two arms fill what they need.
  for j in 0..wall_blocks()
    poke_f32(bb, (base + j) * 8 + 3, 0.0)

  arm(bb, base, x, z, sin(yaw), cos(yaw), la, seed)
  arm(bb, base + la * wall_tall(), x + sin(yaw) * block_size() * to_float(la - 1), z + cos(yaw) * block_size() * to_float(la - 1), cos(yaw), 0.0 - sin(yaw), lb, seed + 3.0)
  # The sphere that holds this L: the start, the corner and the far end, and
  # the radius is whichever reaches furthest from the middle of the three.
  cx = x + sin(yaw) * block_size() * to_float(la - 1)
  cz = z + cos(yaw) * block_size() * to_float(la - 1)
  ex = cx + cos(yaw) * block_size() * to_float(lb - 1)
  ez = cz - sin(yaw) * block_size() * to_float(lb - 1)
  mx = (x + cx + ex) / 3.0
  mz = (z + cz + ez) / 3.0
  r1 = sqrt((x - mx) * (x - mx) + (z - mz) * (z - mz))
  r2 = sqrt((cx - mx) * (cx - mx) + (cz - mz) * (cz - mz))
  r3 = sqrt((ex - mx) * (ex - mx) + (ez - mz) * (ez - mz))
  far = if r1 > r2 then if r1 > r3 then r1 else r3 else if r2 > r3 then r2 else r3
  # +5.5, not +2: a broken stone rolls up to three metres from where it stood
  # and is still this wall's to collide with, so the sphere has to reach it.
  set_wall_box(wb, wi, mx, height(mx, mz) + block_size() * to_float(wall_tall()) * 0.5, mz, far + 5.5)
  1

fn set_wall_box(wb, wi, x, y, z, r) =
  poke_f32(wb, wi * 4, x)
  poke_f32(wb, wi * 4 + 1, y)
  poke_f32(wb, wi * 4 + 2, z)
  poke_f32(wb, wi * 4 + 3, r)
  1

# The stones of one arm, laid along it — and turned to face the way it runs.
#
# They used to be laid along the arm and left pointing north. A wall on any
# other heading was then a row of square stones standing at an angle to their
# own wall, and what you saw was not a face but a saw: every stone's corner
# out past its neighbour's side, all the way up. The jitter on top of it made
# it worse rather than looser.
#
# So the arm's own heading goes down to the stone, and what is left of the
# jitter is a degree and a half — enough that no two stones sit exactly alike,
# little enough that the face stays a face.
fn arm(bb, base, x, z, dx, dz, len, seed) =
  a = atan2_like(dx, dz)

  for j in 0..len
    column(bb, base + j * wall_tall(), x + dx * block_size() * to_float(j), z + dz * block_size() * to_float(j), a, seed + to_float(j))

# How far a wall is set into the hillside it stands on. Twenty centimetres of
# a thirty-centimetre stone, so the bottom course is mostly earth and what
# shows of it is a lip.
#
# Nothing was buried at first and every column sat exactly on the ground under
# its own centre, which is right on a flat and wrong on everything else: a
# stone is thirty centimetres across and the ground under its downhill edge is
# lower than the ground under its middle, so a wall crossing a slope stood on
# a row of little arches. Sinking it is half the answer and the other half is
# below — the ground has to be asked about the whole footprint, not a point.
fn wall_sink() = 0.2

# The lowest ground under a stone laid at (x, z): the four corners of the
# square that contains it however it is turned. Twenty-one centimetres is half
# the diagonal of a thirty-centimetre block, so this covers every yaw without
# knowing which one it has.
fn under_block(x, z) =
  a = height(x - 0.21, z - 0.21)
  b = height(x + 0.21, z - 0.21)
  c = height(x - 0.21, z + 0.21)
  d = height(x + 0.21, z + 0.21)
  min(min(a, b), min(c, d))

fn column(bb, base, x, z, a, seed) =
  g = under_block(x, z) - wall_sink()

  for k in 0..wall_tall()
    emit_block(bb, base + k, x, g + block_size() * (0.5 + to_float(k)), z, a, seed + to_float(k) * 7.0)

fn emit_block(bb, i, x, y, z, a, seed) =
  at = i * 8
  # A stone is not the stone next to it: the size wobbles a little and so does
  # the grey, which is what keeps a run of them from reading as one extruded
  # box with lines drawn on it.
  v = 0.4 + hash2(seed, 91.0) * 0.13
  poke_f32(bb, at, x)
  poke_f32(bb, at + 1, y)
  poke_f32(bb, at + 2, z)
  poke_f32(bb, at + 3, block_size() * (0.94 + hash2(seed, 13.0) * 0.09))
  poke_f32(bb, at + 4, a + (hash2(seed, 71.0) - 0.5) * 0.05)
  poke_f32(bb, at + 5, v)
  poke_f32(bb, at + 6, v * (0.97 + hash2(seed, 29.0) * 0.05))
  poke_f32(bb, at + 7, v * (0.93 + hash2(seed, 47.0) * 0.07))
  1

# ---- what the rifle sends downrange ----------------------------------------
#
# A ring of slots, eight floats each: position, velocity, a spare, and the
# life left. Firing overwrites the oldest — a fixed pool needs no allocation
# and no compaction, and thirty-two rounds is more than anyone can put in the
# air with a bolt action.
#
# The flight is the honest one. Gravity pulls at 9.81, and drag takes a
# fraction of the speed away every second, which is why a bullet's drop grows
# faster than the schoolbook parabola says it should: it is slowing down the
# whole way, so it spends longer falling over the second half of its flight
# than over the first. At 260 m/s a shot across this valley lands about a
# metre and a half low.

fn bullet_cap() = 32

# Nine floats a round: position, velocity, whose it is, its life — and, since
# 2026-08-29, which gun fired it.
#
# That last one is here because three separate things wanted to know it and
# all three were asking the *speed* instead, which is a proxy that rots. The
# tracer's fence was drawn at 100 when the AK flew at 80 and quietly let the
# AK's streaks back the day it went to 120; the chip-on-the-wall fence was
# drawn at 100 too and quietly stopped every weapon leaving a mark the day
# the AK passed it; and the machine gun broke the idea outright by wanting
# tracers at the same speed the AK wants none. A round now says what it came
# out of, and none of those questions can rot again.
#
#   0 the rifle    1 the AK    2 the MG3
fn bullet_stride() = 9

fn from_rifle() = 0.0

fn from_ak() = 1.0

fn from_mg() = 2.0

# Every fifth round off the belt: it leaves a chip like the rest of them and
# it is the only one drawn on the way.
fn from_mg_lit() = 3.0

# Doubled from 120 on 2026-08-29, by request. What it buys is flatness and
# lead: across the whole valley a round now falls a quarter of what it did,
# and the lead on a sprinting man at a hundred metres drops from a body
# length to half a step — the rifle reads as the precision instrument its
# glass always promised. The AK keeps its own number below; the two are
# different weapons again, this time in the right direction.
# If this number moves, check the tracer's fence in `tracer.wgsl`: rifle
# rounds must stay above it or their streaks vanish too.
fn bullet_speed() = 240.0

fn bullet_life() = 3.2

# Ground or water, whichever the bullet would meet first.
# Out of the world, rather than out of ammunition.
#
# The valley is a hundred and fifty across and everything in it is placed
# inside that. A round fired at the sky is not coming back to anything: it
# holds a slot in a ring of thirty-two for the three and a bit seconds its
# life says, and a rocket holds one of a much smaller ring for six, which is
# three shots' worth of tube spent on something that left. So they are let go
# when they leave, and the slot is free for the next one immediately.
#
# Generously outside, not tightly: a shot arcing over the far ridge is still
# in play, and the ceiling is well above anything the terrain reaches.
fn gone_from_world(x, y, z) =
  if y > 320.0 then 1.0 else if x < 0.0 - 200.0 || x > 200.0 then 1.0 else if z < 0.0 - 200.0 || z > 200.0 then 1.0 else 0.0

# Where a thing that falls comes to rest. The dug floor, not the ground the
# valley was born with: everything that lands — a round, a chip of rock, a box
# put down — was landing on the original hillside, so a crate over a shaft sat
# in the air where the rock used to be and a bullet stopped a few metres above
# the floor of a pit.
fn stop_height(w, x, z) = max(0.0, floor_at(w, x, z))

# Everything that can stop a round which is not the ground and not a wall, and
# whether one of them did. A hit ends a round by writing nought into its life,
# so all this has to do is look at that number either side of the four calls.
#
# One function rather than four lines in `step_bullet` because a binding cannot
# be given an `if` block, and the answer has to be a value: it decides whether
# a chip is left behind, and a chip stuck to something that is about to stop
# existing is the bug this exists to stop.
fn hit_a_thing(w, b, at, ax, ay, az, px, py, pz, decide, on) =
  if on < 0.5 then 0.0
  else
    alive = peek_f32(b, at + 7)
    if decide > 0 then
      hit_fire(w, b, at, 0 - 1, ax, ay, az, px, py, pz)
      hit_crystals(w, b, at, ax, ay, az, px, py, pz)
      hit_players(w, b, at, ax, ay, az, px, py, pz)
    else stop_on_ghosts(w, b, at, ax, ay, az, px, py, pz)
    if alive > 0.001 && peek_f32(b, at + 7) < 0.001 then 1.0 else 0.0

fn step_bullet(w, b, at, dt, decide) =
  life = peek_f32(b, at + 7) - dt
  on = if life > 0.0 then 1.0 else 0.0
  vx0 = peek_f32(b, at + 3)
  vy0 = peek_f32(b, at + 4)
  vz0 = peek_f32(b, at + 5)
  # Quadratic drag: the retardation is proportional to the speed squared, so
  # what comes off the velocity vector each step is proportional to the speed
  # itself. First order is plenty — at sixty frames a second and this
  # coefficient the step is under a thousandth of the velocity.
  sp = sqrt(vx0 * vx0 + vy0 * vy0 + vz0 * vz0)
  k = 1.0 - 0.00011 * sp * dt * on
  vx = vx0 * k
  vy = vy0 * k - fireball_g() * dt * on
  vz = vz0 * k
  px = peek_f32(b, at) + vx * dt * on
  py = peek_f32(b, at + 1) + vy * dt * on
  pz = peek_f32(b, at + 2) + vz * dt * on
  landed = if py < stop_height(w, px, pz) then 1.0 else 0.0
  # Anything solid on the way there, before the position is committed — and
  # only if there is a round to do the hitting.
  #
  # This ran unconditionally, and a dead slot is not a harmless one. An expired
  # bullet keeps its last position and stops moving, so the test ran every frame
  # on a segment of zero length sitting wherever it stopped — and the slots
  # start life at the origin, all thirty-two of them, because `clear_bullets`
  # zeroes the lifetime and nothing else. A crystal near that point was safe
  # only until it charged: the swell takes it to two and a half times its size,
  # the hit spheres grow with it, and the crystal reached out and broke itself
  # on a round that had been dead for a minute.
  #
  # It looked like crystals shattering on their own, and it got worse the more
  # often they fired, which is the sort of thing that sends you looking at the
  # charge animation. It was one missing guard.
  # A chip belongs where a round hit a *place*: the ground, or a wall. What
  # else stops one is a thing — a crystal that is a second away from being
  # shards, a fireball, somebody standing there — and a chip stuck to a thing
  # that then leaves is a chip hanging in mid-air. Break a crystal with the AK
  # and the burst that broke it stayed behind, floating where the glass had
  # been.
  #
  # So the walls are asked first and on their own, and `hit_a_thing` watches
  # the round across everything else. The order the four run in has not moved:
  # a round that crosses both a crystal and a player is still the crystal's.
  if on > 0.5 && decide > 0 then hit_stone(w, b, at, peek_f32(b, at), peek_f32(b, at + 1), peek_f32(b, at + 2), px, py, pz) else 0
  # Read straight after the sweep and before anything else touches the
  # scratch: which block stopped it, or less than nought for the ground.
  wall_i = if on > 0.5 && decide > 0 then to_int(peek_f32(seg_of(w), 14)) else 0 - 1
  on_a_thing = hit_a_thing(w, b, at, peek_f32(b, at), peek_f32(b, at + 1), peek_f32(b, at + 2), px, py, pz, decide, on)

  # Struck something, or reached the ground: either way this is where it
  # stopped, and an AK's round leaves a chip there. The hits above end a round
  # by writing nought into its life, so the slot is the answer to "did it hit
  # anything" — and the ground is the `landed` test. Only the AK's, because
  # the rifle's rounds are still drawn on the way and do not need saying twice.
  struck = if peek_f32(b, at + 7) < 0.001 then 1.0 else 0.0
  # `bullet_stride`'s ninth float, not the speed: this line read `sp < 100.0`
  # when the AK flew at 80, and the day it went to 120 every weapon in the
  # valley silently stopped leaving chips — the marks and the sparks that
  # burst with them had been dead ever since.
  leaves_a_chip = peek_f32(b, at + 8) > 0.5
  if on > 0.5 && (landed > 0.5 || struck > 0.5) && leaves_a_chip && on_a_thing < 0.5 then
    note_mark(w, px, if landed > 0.5 then stop_height(w, px, pz) else py, pz, if landed > 0.5 then 0 - 1 else wall_i)
  else 0

  poke_f32(b, at, px)
  poke_f32(b, at + 1, py)
  poke_f32(b, at + 2, pz)
  poke_f32(b, at + 3, vx)
  poke_f32(b, at + 4, vy)
  poke_f32(b, at + 5, vz)
  away = gone_from_world(px, py, pz)
  poke_f32(b, at + 7, if landed > 0.5 || away > 0.5 then 0.0 else if peek_f32(b, at + 7) < 0.001 then 0.0 else life)

# ---- who a client can see, for rounds to stop on ----------------------------
#
# A round that goes through somebody is the one thing in this valley that reads
# as broken rather than as a miss. It does not go through them on the server —
# `try_hit_player` ends it — but a client has no player blocks except its own:
# everybody else arrives as a snapshot and is drawn from it, so there was
# nothing in the world for a round to stop against and the tracer sailed on
# through the chest of the person it had just killed.
#
# So the page writes down where it is drawing people, and the rounds stop
# there. Not a decision — the damage is still the server's word, and this
# table has no health in it and nothing reads it but the bullet step. It is
# where they are *drawn*, interpolated between the last two snapshots, which
# means a round stops at the body you can see rather than at one a tenth of a
# second behind it. That is the whole reason it is done here rather than off
# the health going down in the next snapshot: at a hundred and twenty metres a
# second, one tick of waiting is six metres of tracer past somebody's back.
fn ghost_cap() = 40

fn set_ghosts(w: Ptr, n: Int) =
  poke_f32(w, 105, to_float(if n > ghost_cap() then ghost_cap() else n))
  1

fn set_ghost(w: Ptr, i: Int, x: Float, y: Float, z: Float) =
  g = peek_ptr(w, 106)
  poke_f32(g, i * 3, x)
  poke_f32(g, i * 3 + 1, y)
  poke_f32(g, i * 3 + 2, z)
  1

# The same three spheres the server decides with, so a round stops where it
# would have counted — head, body and legs, and a leg is most of what is
# showing when somebody is behind a rock.
fn ghost_hit(g, i, ax, ay, az, bx, by, bz) =
  x = peek_f32(g, i * 3)
  y = peek_f32(g, i * 3 + 1)
  z = peek_f32(g, i * 3 + 2)
  head = yes(seg_dist2(ax, ay, az, bx, by, bz, x, y + 1.62, z) < 0.09)
  body = yes(seg_dist2(ax, ay, az, bx, by, bz, x, y + 1.05, z) < 0.1764)
  legs = yes(seg_dist2(ax, ay, az, bx, by, bz, x, y + 0.45, z) < 0.1296)
  head + body + legs

fn stop_on_ghosts(w, b, at, ax, ay, az, bx, by, bz) =
  g = peek_ptr(w, 106)

  for i in 0..to_int(peek_f32(w, 105))
    stopped(b, at, ghost_hit(g, i, ax, ay, az, bx, by, bz))

fn stopped(b, at, hit) = if hit > 0 then poked_out(b, at) else 0

fn poked_out(b, at) =
  poke_f32(b, at + 7, 0.0)
  1

fn step_bullets(w, b, dt, decide) =
  for i in 0..bullet_cap()
    step_bullet(w, b, i * bullet_stride(), dt, decide)

# `alloc_bytes` hands back whatever was there; a slot with life left in it
# would draw a streak the moment the world appeared.
fn clear_bullets(b) =
  for i in 0..bullet_cap()
    poke_f32(b, i * bullet_stride() + 7, 0.0)

# `d` is where the sights point; the host works it out from the same yaw and
# pitch this file wrote. The round starts a little ahead of the eye so its
# streak does not begin inside the camera.
#
# The rounds are the world's, not the shooter's: there is one ring of them and
# everybody's are in it, which is what makes a round something other people can
# watch go past. Slot 6 was spare in a stride of eight — the tracer shader is
# written against it under that name — and it carries whose round this is, so a
# hit can be credited and so that nobody shoots themselves in the back of the
# head at the muzzle.
# An empty rifle is a rifle that does not go off, and this is the one place
# both ways of asking come through: the browser fires here for its own tracer
# and bang, and the server fires here for what the round actually hits. The
# count is spent in the same instruction on both, which is what keeps the
# number on the screen and the number the server is enforcing the same one.
fn fire(s: Ptr, dx: Float, dy: Float, dz: Float) =
  if weapon(s) == 1 then fire_rocket(s, dx, dy, dz) else if weapon(s) == 2 then fire_ak(s, dx, dy, dz) else if weapon(s) == 5 then fire_mg(s, dx, dy, dz) else fire_bullet(s, dx, dy, dz)

fn fire_bullet(s, dx, dy, dz) =
  if peek_f32(s, 118) < 0.5 then 0 else fire_round(s, dx, dy, dz)

# A rocket is a fireball with a flat trajectory and somebody's aim behind it.
#
# The crystals already throw fire that flies, drags, falls, lands and leaves a
# crater that hurts whoever is near it, and all of that is already on the wire
# — a `t` when one is thrown and a `k` where it came down. A rocket that is a
# second system beside that one would be the same arithmetic written twice and
# two more messages to keep in step. So it goes in the same ring.
#
# What tells them apart is the sign of the seed. A crystal's seed comes out of
# `hash2` and is never negative; a rocket's is the same number with a minus in
# front of it. The renderer reads the sign and draws a tube of steel with a
# smoke trail instead of a ball of fire, and the sign survives the wire without
# a field being added to it. The same trick the mesh uses for "no texture here"
# and the shard pool uses for "nothing in this slot".
# A rocket's seed carries three things in one float. The sign says it is a
# rocket rather than a crystal's thrown fire; the fraction is the randomness
# every fireball wants for its smoke and its crater; and the whole part is who
# fired it, so that a warhead leaving the tube does not go off on the shoulder
# it left. Nothing had to be added to the ring or to the protocol — the seed
# was already crossing both, and a hash does not care how big its input is.
fn rocket_seed(s, w) =
  0.0 - (to_float(player_id(s)) + 0.01 + hash2(peek_f32(w, 28), 61.0) * 0.98)

fn rocket_owner(seed) = floor(0.0 - seed)

fn fire_rocket(s, dx, dy, dz) =
  if peek_f32(s, 120) < 0.5 then 0 else launch(s, dx, dy, dz)

fn launch(s, dx, dy, dz) =
  poke_f32(s, 120, peek_f32(s, 120) - 1.0)
  w = wd(s)
  fb = peek_ptr(w, 74)
  k = to_int(peek_f32(w, 63))
  at = k % fireball_cap() * fireball_stride()
  v = rocket_speed()
  # Out of the tube rather than out of the eye, or the first thing a rocket
  # meets is the shoulder it was fired from.
  poke_f32(fb, at, peek_f32(s, 16) + dx * 1.1)
  poke_f32(fb, at + 1, peek_f32(s, 17) + dy * 1.1)
  poke_f32(fb, at + 2, peek_f32(s, 18) + dz * 1.1)
  poke_f32(fb, at + 3, dx * v)
  poke_f32(fb, at + 4, dy * v)
  poke_f32(fb, at + 5, dz * v)
  poke_f32(fb, at + 6, rocket_seed(s, w))
  poke_f32(fb, at + 7, 6.0)
  poke_f32(fb, at + 8, 0.0)
  poke_f32(w, 63, to_float(k + 1))
  1

fn fire_round(s, dx, dy, dz) =
  poke_f32(s, 118, peek_f32(s, 118) - 1.0)
  w = wd(s)
  b = peek_ptr(w, 68)
  k = to_int(peek_f32(w, 60))
  at = k % bullet_cap() * bullet_stride()
  v = bullet_speed()
  poke_f32(b, at, peek_f32(s, 16) + dx * 0.9)
  poke_f32(b, at + 1, peek_f32(s, 17) + dy * 0.9)
  poke_f32(b, at + 2, peek_f32(s, 18) + dz * 0.9)
  poke_f32(b, at + 3, dx * v)
  poke_f32(b, at + 4, dy * v)
  poke_f32(b, at + 5, dz * v)
  poke_f32(b, at + 6, peek_f32(s, 99))
  poke_f32(b, at + 7, bullet_life())
  poke_f32(b, at + 8, from_rifle())
  poke_f32(w, 60, to_float(k + 1))
  1

# ---- the AK ----------------------------------------------------------------
#
# The default arm: thirty rounds, held-trigger automatic at ten rounds a
# second — the gun's own cyclic rate, near enough, which empties a magazine in
# three — and a bullet at two thirds of the rifle's speed: eighty metres a
# second against a hundred and twenty, so it is still led at distance but no
# longer lobbed. Same rounds in the same ring; only the muzzle velocity and
# the magazine differ.
# ---- what a round leaves behind ---------------------------------------------
#
# The AK's rounds are not drawn on the way — a streak from a weapon fired ten
# times a second is a lit rope across the valley — so where they arrive is the
# only evidence there is. Each one writes a chip: where it stopped, the line
# it came in on, and the moment, in a ring the renderer walks every frame.
#
# It is decoration, and it is recorded on whichever machine stepped the round
# — the shooter's browser, everybody else's, and the server, which keeps the
# ring and never reads it. Nothing crosses the wire for it: a mark is where a
# round ended, and every client already steps every round it can see.
fn mark_ring() = 48

fn mark_life() = 10.0

# How far apart the two samples of the ground are taken, for its slope.
fn mark_step() = 0.25

# A chip, and the face it is stuck to.
#
# What the ring used to carry here was the round's own flight, which is what a
# card square to the incoming line needs. That was wrong twice over: a card
# built on the flight faces whoever fired the round, so it turned to follow
# them as they walked round it — a sticker hanging in the air rather than a
# hole in something — and the sparks that come off the same ring went back up
# the barrel instead of off the wall.
#
# So it carries the surface instead, pointing out of it. Two surfaces can be
# hit. A wall block was a sphere as far as the round was concerned, so out of
# it is out from its centre. The ground is a height field, so out of it is its
# gradient: four samples of the same `height` the walking uses, which is
# nothing at the handful of chips a second this runs at. Under the waterline
# the ground the round stopped on is the flat of the lake rather than the bed
# below it, and the answer there is simply up.
fn note_mark(w, x, y, z, wall_i) =
  n = to_int(peek_f32(w, 55))
  mb = peek_ptr(w, 75)
  at = n % mark_ring() * 8
  bb = blocks_ptr(w)
  e = mark_step()
  wall = yes(wall_i >= 0)
  # Never a negative index into the block buffer, whichever way the `if` below
  # is evaluated.
  wi = if wall > 0 then wall_i else 0
  flat = yes(wall < 1 && height(x, z) < 0.0)
  gx = if flat > 0 then 0.0 else height(x - e, z) - height(x + e, z)
  gy = if flat > 0 then 1.0 else e * 2.0
  gz = if flat > 0 then 0.0 else height(x, z - e) - height(x, z + e)
  ex = if wall > 0 then x - block_f(bb, wi, 0) else gx
  ey = if wall > 0 then y - block_f(bb, wi, 1) else gy
  ez = if wall > 0 then z - block_f(bb, wi, 2) else gz
  l = sqrt(ex * ex + ey * ey + ez * ez)
  d = if l < 0.001 then 1.0 else 1.0 / l
  poke_f32(mb, at, x)
  poke_f32(mb, at + 1, y)
  poke_f32(mb, at + 2, z)
  poke_f32(mb, at + 3, ex * d)
  poke_f32(mb, at + 4, ey * d)
  poke_f32(mb, at + 5, ez * d)
  poke_f32(mb, at + 6, world_time(w))
  poke_f32(mb, at + 7, 0.0)
  poke_f32(w, 55, to_float(n + 1))
  1

fn marks(s: Ptr) -> Ptr = peek_ptr(wd(s), 75)

fn marks_cap() -> Int = mark_ring()

fn clear_marks_ring(mb) =
  for i in 0..mark_ring()
    poke_f32(mb, i * 8 + 6, 0.0)

fn ak_full() = 30

# A hundred milliseconds between rounds. This is the wire's gate rather than
# the trigger's: the browser holds itself to the same number in `AK_CYCLE`,
# and a client that simply did not would be refused here.
fn ak_gap() = 0.1

fn ak_rounds(s: Ptr) -> Int = to_int(peek_f32(s, 106))

# The spare magazines on the belt: four beside the one in the gun, five in
# all. When the loaded one runs dry the next pull of the trigger is not a
# shot, it is the change — a second and a half with the gun down, run through
# the same fire clock the shots are, so the browser and the server sit out
# the same pause.
fn ak_mag_count() = 5

fn ak_mags(s: Ptr) -> Int = to_int(peek_f32(s, 117))

fn ak_reload(s) =
  if peek_f32(s, 117) < 0.5 then 0
  else
    poke_f32(s, 117, peek_f32(s, 117) - 1.0)
    poke_f32(s, 106, to_float(ak_full()))
    poke_f32(s, 52, world_time(wd(s)) + 1.4)
    0

# ---- the MG3 --------------------------------------------------------------
#
# Weapon five. A belt-fed gun whose whole character is the trade the user
# asked for in one sentence: standing, it fires wide and climbs hard; on one
# knee it settles into something you can hold on a target. The knee is read
# from `crouch_of`, which the walk already keeps, so the machine gun costs no
# new state to know how it is being held.
#
# Its rounds fly at the AK's speed on purpose — inside the tracer fence in
# `tracer.wgsl` — so a thousand rounds a minute does not put a lit rope
# across the valley.
fn mg_full() = 75

fn mg_belt_count() = 2

# A round every tick, which is twelve hundred a minute — the top of what the
# real gun does, and the only rate near it that both ends can agree on.
#
# It was 0.06, meaning a thousand a minute, and that number was chosen for the
# gun rather than for the machinery: the server's clock advances in fifty
# millisecond steps, so a gate of sixty lets it fire on every *other* step and
# no faster. The client, whose clock is the frame, managed its full sixteen a
# second. The two spent the belt at different rates — six or seven rounds a
# second apart — and every second or two the gap grew past what reconciliation
# tolerates and the server's higher count was written back: on screen the
# rounds refilled themselves while the trigger was down.
#
# The AK never showed this because a tenth of a second is exactly two ticks.
# Any weapon added here wants a gap that is a whole number of them.
fn mg_gap() = 0.05

fn mg_speed() = 180.0

fn mg_rounds(s: Ptr) -> Int = to_int(peek_f32(s, 252))

fn mg_belts(s: Ptr) -> Int = to_int(peek_f32(s, 254))

# How wide the cone is, in radians, and the whole of the stance trade: about
# three degrees standing, under three quarters of one on a knee. The knee is
# read as a threshold rather than blended — half-way down is not braced.
fn mg_cone(s) = if crouch_of(s) > 0.5 then 0.012 else 0.052

fn fire_mg(s, dx, dy, dz) =
  if peek_f32(s, 252) < 0.5 then mg_reload(s) else mg_spat(s, dx, dy, dz)

fn mg_spat(s, dx, dy, dz) =
  # The spend lives here, beside the round it pays for. It was in a wrapper
  # once, and the day the wrapper was simplified away the belt stopped
  # counting down — an infinite belt, caught by the first line of the test
  # that was written the same hour.
  poke_f32(s, 252, peek_f32(s, 252) - 1.0)
  w = wd(s)
  b = peek_ptr(w, 68)
  k = to_int(peek_f32(w, 60))
  at = k % bullet_cap() * bullet_stride()
  v = mg_speed()
  poke_f32(b, at, peek_f32(s, 16) + dx * 0.9)
  poke_f32(b, at + 1, peek_f32(s, 17) + dy * 0.9)
  poke_f32(b, at + 2, peek_f32(s, 18) + dz * 0.9)
  poke_f32(b, at + 3, dx * v)
  poke_f32(b, at + 4, dy * v)
  poke_f32(b, at + 5, dz * v)
  poke_f32(b, at + 6, peek_f32(s, 99))
  poke_f32(b, at + 7, bullet_life())
  # One round in five, which is how a belt for this gun is actually loaded —
  # and the reason sixteen a second reads as a machine gun rather than as a
  # lit rope: the four dark rounds between are what make the fifth a line you
  # can follow. The other four still leave chips, so `from_mg` for them and a
  # third kind for the ones that are drawn.
  poke_f32(b, at + 8, if to_int(peek_f32(s, 253)) % 5 == 0 then from_mg_lit() else from_mg())
  poke_f32(w, 60, to_float(k + 1))
  1

# A new belt, on the AK's clock: the fire gate is pushed out while the feed
# cover is open, and a spare comes off the shoulder.
fn mg_reload(s) =
  if to_int(peek_f32(s, 254)) < 1 then 0
  else
    poke_f32(s, 254, peek_f32(s, 254) - 1.0)
    poke_f32(s, 252, to_float(mg_full()))
    # The AK's 1.4, not a longer one of this gun's own.
    #
    # Three seconds looked right for a belt — it is a heavier thing to load
    # than a magazine — and it broke the gun in a shared valley. Three
    # numbers have to agree about how long a change takes: the hands animate
    # for `change_secs` (1.45), the page holds the ammunition against the
    # server's figure for 900 milliseconds, and this pushes the fire gate.
    # Set past the other two, the hold expired while the server still had the
    # old belt, `reconcile` wrote its nought back over the fresh seventy-five,
    # the trigger found an empty gun and loaded it again — a reload that
    # restarted forever, and only ever in a valley with a server in it.
    poke_f32(s, 52, world_time(wd(s)) + 1.4)
    1

# The belt change somebody asked for. The same refusals as the AK's manual
# magazine: nothing to change, nothing to change to, or a change already
# under way behind the fire gate.
fn ask_belt(s, tnow) =
  if peek_f32(s, 82) < 0.001 then 0
  else if in_water(s) > 0 then 0
  else if mg_belts(s) < 1 then 0
  else if mg_rounds(s) >= mg_full() then 0
  else if tnow - peek_f32(s, 52) < mg_gap() then 0
  else mg_reload(s)

fn fire_ak(s, dx, dy, dz) =
  if peek_f32(s, 106) < 0.5 then ak_reload(s) else fire_ak_round(s, dx, dy, dz)

# Changing the magazine because somebody asked for it, rather than because the
# last round has gone.
#
# The change itself is `ak_reload` either way — the same second and a half, the
# same spare off the belt. What a manual one needs on top is the refusals, and
# they are all of them the same question: is there anything to do, and is this
# a moment to do it in. A full magazine has nothing to change. A player with no
# spare has nothing to change to. And the last of them is the fire clock the
# trigger is already gated on: `ak_reload` pushes slot 52 into the future, so a
# second press inside the change is asking for something that is happening.
#
# Both ends run this. The browser asks so that the count and the hands answer
# the key rather than the round trip; the server asks because the magazine it
# keeps is the one that decides whether a round leaves, and a client that could
# fill its own would be a client with an inexhaustible rifle.
fn ask_reload(s: Ptr) -> Int =
  tnow = world_time(wd(s))
  if weapon(s) == 5 then ask_belt(s, tnow)
  else if weapon(s) != 2 then 0
  else if peek_f32(s, 82) < 0.001 then 0
  else if in_water(s) > 0 then 0
  else if ak_mags(s) < 1 then 0
  else if ak_rounds(s) >= ak_full() then 0
  else if tnow - peek_f32(s, 52) < ak_gap() then 0
  else
    ak_reload(s)
    1

# What the AK sends downrange, and it is its own number now.
#
# It was `bullet_speed() * 2 / 3` — eighty metres a second against the rifle's
# hundred and twenty — which read as "two thirds of a rifle" and tied the two
# together for good. Reach is what that fraction was really setting: a round
# fired level falls 4.9 metres in the first second whatever it left the barrel
# at, so how far it gets before it is into the ground is its speed times the
# time it can afford to fall, and that is linear in the speed. Half again as
# far therefore wants half again the speed.
#
# Which brought it level with the old rifle at the muzzle. Raised half again
# on 2026-08-29, the day after the rifle doubled to 240: the two are still
# not the same weapon — the rifle is one aimed round at a time through glass
# and this is thirty in four seconds — and now their speeds say so too, 180
# against 240. The AK shoots flatter than it did and still asks more lead
# than the rifle, which is the right order for an unscoped gun.
# If this number moves, move the tracer's fence with it: `tracer.wgsl` hides
# the AK's streaks by speed, and the fence has been left behind once before.
fn ak_speed() = 180.0

fn fire_ak_round(s, dx, dy, dz) =
  poke_f32(s, 106, peek_f32(s, 106) - 1.0)
  w = wd(s)
  b = peek_ptr(w, 68)
  k = to_int(peek_f32(w, 60))
  at = k % bullet_cap() * bullet_stride()
  v = ak_speed()
  poke_f32(b, at, peek_f32(s, 16) + dx * 0.9)
  poke_f32(b, at + 1, peek_f32(s, 17) + dy * 0.9)
  poke_f32(b, at + 2, peek_f32(s, 18) + dz * 0.9)
  poke_f32(b, at + 3, dx * v)
  poke_f32(b, at + 4, dy * v)
  poke_f32(b, at + 5, dz * v)
  poke_f32(b, at + 6, peek_f32(s, 99))
  poke_f32(b, at + 7, bullet_life())
  poke_f32(b, at + 8, from_ak())
  poke_f32(w, 60, to_float(k + 1))
  1

# What the held weapon has left, and the writing of it — one number on the
# wire whatever is in the hands, because the snapshot says "your weapon holds
# n" and both ends agree about which weapon that is.
fn held_ammo(s: Ptr) -> Int =
  if weapon(s) == 1 then rockets(s) else if weapon(s) == 2 then ak_rounds(s) else if weapon(s) == 5 then mg_rounds(s) else rounds(s)

# Whether a pull of the trigger has anything to become: a shot, or — for an
# AK with an empty magazine and spares on the belt — the change.
fn may_fire(s) =
  if weapon(s) == 2 then yes(ak_rounds(s) > 0 || ak_mags(s) > 0) else if weapon(s) == 5 then yes(mg_rounds(s) > 0 || mg_belts(s) > 0) else held_ammo(s)

fn set_held_ammo(s: Ptr, n: Int) =
  if weapon(s) == 1 then poke_f32(s, 120, to_float(n)) else if weapon(s) == 2 then poke_f32(s, 106, to_float(n)) else if weapon(s) == 5 then poke_f32(s, 252, to_float(n)) else poke_f32(s, 118, to_float(n))
  1

# ---- what a round does when it arrives -------------------------------------
#
# The crystals are the only things in the valley solid enough to break. A hit
# takes one out of the instance buffer — its scale goes to zero, which is how
# the host stops drawing it without the array having to change length — and
# puts eight shards in its place, thrown outward and tumbling.
#
# The shards keep the colour of what they came from, fall, land, and stay.
# There is no settling to model: a shard that reaches the ground has its
# velocity and its spin set to zero and its height snapped to the terrain,
# which is the same thing the walking camera does when it lands.

fn break_ring() = 32

fn shard_cap() = 224

# The first slots of the shard buffer are not debris at all: they are the
# magazines lying about the valley, which is how they get drawn and stepped
# and picked up without a buffer, a pipeline or a wire message of their own.
# A piece of a crystal, a lump out of a crater and a magazine are the same
# twenty floats; what tells them apart is slot 16, which already said whether
# walking over one was worth anything.
#
# Twenty-two of them, which at ten rounds each is a hundred and sixty rifle
# rounds and four hundred and fifty belted ones on the ground at once — enough
# that somebody who has spent what they carry has somewhere to walk rather
# than nothing to do until they respawn.
fn mag_count() = 22

# Three kinds, in three contiguous runs of the index: magazines below
# `mag_only`, rocket crates up to `crate_end`, belts of machine-gun rounds
# above it. The split is by index and contiguous, which is what lets the
# renderer draw each kind with its own mesh in one instanced call — a range,
# not a filter — and it costs the wire nothing: which kind box `i` is falls
# out of `i`.
fn mag_only() = 10

fn crate_end() = 16

fn mag_size() = 10

# How big a box on the ground is drawn, against the twenty-six centimetres the
# real one was scanned at. Sixteen boxes over a hundred and fifty metres of
# valley, and at life size one of them lying in that grass is something you
# walk past rather than something you find — the crystal chip it replaced was
# nearly a metre tall and glowed. Forty centimetres is a box you can see at a
# run and still a box.
fn mag_scale() = 1.6

# The crate is Poly Haven's `old_military_crate`, eighty centimetres of olive
# wood scanned at life size, and it is drawn close to it: a crate of rockets
# is a thing you find, not a thing you trip over.
fn crate_scale() = 0.95

# A belt of machine-gun rounds, dropped where it fell: twenty-two real
# cartridges laid along a shallow S and baked as one mesh, thirty centimetres
# of it at life size. Half again, because a belt lying flat in grass is a
# thinner thing than a box standing in it and needs the help to be found —
# and because copper catches the light, which a box of stamped steel does not.
fn belt_scale() = 1.5

# What slot 16 holds: nothing, a magazine, a rocket crate, or — anywhere below
# one — how much of somebody a chip of crystal is worth. Two and three are not
# fractions anybody can heal by, so the one number says both what a thing is
# and what it gives.
fn worth_nothing() = 0.0

fn worth_rounds() = 2.0

fn worth_rockets() = 3.0

fn worth_belt() = 4.0

# What one chip mends, by the colour of the crystal it came off. There are
# three in the valley and they are not worth the same:
#
#   amber   three in five of them, and three per cent of a player per crystal
#   cyan    one in five, and six
#   violet  one in six, and twelve
#
# Counted, not assumed: 187, 60 and 53 of the three hundred.
#
# Rarity and value in the same order, which is the only arrangement that makes
# the colour worth reading at two hundred metres — the rare one is now a reason
# to cross the valley rather than the same crystal in another paint. Split
# eight ways across the chips a crystal leaves, so sweeping up every piece of
# one is worth exactly that and there is no way to get more out of it.
#
# It averaged 5.19 per cent a crystal over the three hundred when it was
# half this — the flat five every crystal was worth at first, redistributed
# by colour. Doubled 2026-08-29 because the valley got harder to live in
# than the medicine could keep up with: six, twelve and twenty-four by
# colour now, 10.4 a crystal on average, and a violet worth crossing the
# whole valley for. Still short of what one hit costs, which is the line
# that matters — see `gather_shard` on why the medicine must stay cheaper
# than the wound.
#
# The colour is read once, here, out of the crystal that is coming apart. The
# chips carry a number from then on: a palette that changes should change what
# the valley looks like and not what it heals.
fn chip_heal(r: Float, g: Float, b: Float) =
  if r < 0.5 then 0.015 else if b > 0.9 then 0.03 else 0.0075

# Debris goes round the ring above the magazines, so a busy minute of breaking
# crystals cannot write over them.
fn shard_ring() = shard_cap() - mag_count()

# Twenty floats: position, velocity, orientation, spin, scale, colour.
fn shard_stride() = 20

# The closest approach of a point to a segment, squared. A round crosses seven
# metres between frames, so testing where it happens to be at the end of one
# would let it through anything narrower than that.
fn seg_dist2(ax, ay, az, bx, by, bz, cx, cy, cz) =
  dx = bx - ax
  dy = by - ay
  dz = bz - az
  l2 = dx * dx + dy * dy + dz * dz + 0.000001
  t = clampf(((cx - ax) * dx + (cy - ay) * dy + (cz - az) * dz) / l2, 0.0, 1.0)
  px = ax + dx * t - cx
  py = ay + dy * t - cy
  pz = az + dz * t - cz
  px * px + py * py + pz * pz

# A piece thrown with the up and the out said separately.
#
# `spawn_shard` ties them together through one `throw`, which is right for
# something coming apart where it stood — it goes up half again as far as it
# goes sideways, whatever you scale it by. A warhead does not do that. What
# goes straight up is the ground it lifted, and what goes sideways is the case
# it tore itself out of, and those are different speeds rather than one speed
# with a ratio.
fn spawn_piece(sb, k, x, y, z, sc, r, g, b, up, out, seed) =
  at = (mag_count() + k % shard_ring()) * shard_stride()
  h1 = hash2(seed, 11.0)
  h2 = hash2(seed, 23.0)
  h3 = hash2(seed, 37.0)
  h4 = hash2(seed, 51.0)
  a = h1 * 6.28318
  poke_f32(sb, at, x + (h1 - 0.5) * sc * 0.5)
  poke_f32(sb, at + 1, y + h2 * sc * 1.6)
  poke_f32(sb, at + 2, z + (h3 - 0.5) * sc * 0.5)
  poke_f32(sb, at + 3, cos(a) * out)
  poke_f32(sb, at + 4, up)
  poke_f32(sb, at + 5, sin(a) * out)
  poke_f32(sb, at + 6, h1 * 6.28318)
  poke_f32(sb, at + 7, h2 * 6.28318)
  poke_f32(sb, at + 8, h3 * 6.28318)
  poke_f32(sb, at + 9, (h2 - 0.5) * 22.0)
  poke_f32(sb, at + 10, (h3 - 0.5) * 22.0)
  poke_f32(sb, at + 11, (h4 - 0.5) * 22.0)
  poke_f32(sb, at + 12, sc * (0.14 + h4 * 0.16))
  poke_f32(sb, at + 13, r)
  poke_f32(sb, at + 14, g)
  poke_f32(sb, at + 15, b)
  poke_f32(sb, at + 16, 0.0)
  1

# A piece thrown where we say, rather than in a direction of its own.
#
# `spawn_piece` picks its own angle, which is right for something bursting
# where it stands. A wall does not do that: it comes apart *away* from the
# thing that hit it, and which way that is is the whole difference between
# stone blown off a wall and stone that happened to fall over.
# The thirteen numbers a chunk wants come through the same scratch block the
# sweep uses, for the same reason the sweep uses it: thirteen arguments is
# five past what the registers hold, and stack arguments in a loop are the
# thing that took the server down. Slots 0-2 the place, 3 the size, 4-6 the
# colour, 7-9 the velocity. The seed stays an argument because it is the one
# thing that differs between the pieces of one burst.
fn spawn_chunk(sb, k, cs, seed) =
  x = peek_f32(cs, 0)
  y = peek_f32(cs, 1)
  z = peek_f32(cs, 2)
  sc = peek_f32(cs, 3)
  r = peek_f32(cs, 4)
  g = peek_f32(cs, 5)
  b = peek_f32(cs, 6)
  at = (mag_count() + k % shard_ring()) * shard_stride()
  h1 = hash2(seed, 11.0)
  h2 = hash2(seed, 23.0)
  h3 = hash2(seed, 37.0)
  h4 = hash2(seed, 51.0)
  poke_f32(sb, at, x + (h1 - 0.5) * sc)
  poke_f32(sb, at + 1, y + (h2 - 0.5) * sc)
  poke_f32(sb, at + 2, z + (h3 - 0.5) * sc)
  poke_f32(sb, at + 3, peek_f32(cs, 7) + (h1 - 0.5) * 6.0)
  poke_f32(sb, at + 4, peek_f32(cs, 8) + h2 * 4.0)
  poke_f32(sb, at + 5, peek_f32(cs, 9) + (h3 - 0.5) * 6.0)
  poke_f32(sb, at + 6, h1 * 6.28318)
  poke_f32(sb, at + 7, h2 * 6.28318)
  poke_f32(sb, at + 8, h3 * 6.28318)
  poke_f32(sb, at + 9, (h2 - 0.5) * 26.0)
  poke_f32(sb, at + 10, (h3 - 0.5) * 26.0)
  poke_f32(sb, at + 11, (h4 - 0.5) * 26.0)
  poke_f32(sb, at + 12, sc * (0.2 + h4 * 0.26))
  poke_f32(sb, at + 13, r)
  poke_f32(sb, at + 14, g)
  poke_f32(sb, at + 15, b)
  poke_f32(sb, at + 16, 0.0)
  1

fn spawn_shard(sb, k, x, y, z, sc, r, g, b, throw, heals, seed) =
  at = (mag_count() + k % shard_ring()) * shard_stride()
  h1 = hash2(seed, 11.0)
  h2 = hash2(seed, 23.0)
  h3 = hash2(seed, 37.0)
  h4 = hash2(seed, 51.0)
  # Outward and upward, the way a thing that has just been hit comes apart.
  a = h1 * 6.28318
  # `throw` is how hard: one for a crystal coming apart where it stood, more
  # for something blown out of a crater. It is the only thing that separates
  # the two, which is why it is an argument rather than two copies of this.
  up = (2.5 + h2 * 5.5) * throw
  out = (1.6 + h3 * 3.4) * throw
  poke_f32(sb, at, x + (h1 - 0.5) * sc * 0.5)
  poke_f32(sb, at + 1, y + h2 * sc * 1.6)
  poke_f32(sb, at + 2, z + (h3 - 0.5) * sc * 0.5)
  poke_f32(sb, at + 3, cos(a) * out)
  poke_f32(sb, at + 4, up)
  poke_f32(sb, at + 5, sin(a) * out)
  poke_f32(sb, at + 6, h1 * 6.28318)
  poke_f32(sb, at + 7, h2 * 6.28318)
  poke_f32(sb, at + 8, h3 * 6.28318)
  poke_f32(sb, at + 9, (h2 - 0.5) * 14.0)
  poke_f32(sb, at + 10, (h3 - 0.5) * 14.0)
  poke_f32(sb, at + 11, (h4 - 0.5) * 14.0)
  poke_f32(sb, at + 12, sc * (0.14 + h4 * 0.16))
  poke_f32(sb, at + 13, r)
  poke_f32(sb, at + 14, g)
  poke_f32(sb, at + 15, b)
  # Whether this piece is worth anything to walk over. A crystal you shot has
  # the light still in it; the ground a meteor threw out of a crater does not.
  # Slot 16 is spare in a stride of twenty and the renderer never reads it.
  poke_f32(sb, at + 16, heals)
  1

# Somebody coming apart.
#
# The pieces are the ones a crystal already breaks into — a fifth of the file
# is about how those fall, land and stay, and a body has no reason to want a
# second answer. What changes is where they start and what colour they are:
# eighteen of them, out of the head, the two arms and the legs, at the heights
# a round is tested against, in the colour the renderer gives that player.
#
# It is the renderer's business rather than the world's, which is why it is
# spawned by whoever is watching rather than sent: a server that nobody is
# looking at has no reason to make debris, and a client already knows the
# moment a health it was told about reaches zero.
fn gib_at(w: Ptr, x: Float, y: Float, z: Float, yaw: Float, id: Int) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))
  # Dimmed, which is what the figure itself does when it goes down.
  r = hue_r(to_float(id), 0.0)
  g = hue_g(to_float(id), 0.0)
  b = hue_b(to_float(id), 0.0)
  # Across the shoulders, turned the way they were facing.
  ax = cos(yaw) * 0.34
  az = sin(yaw) * 0.34
  seed = to_float(id) * 31.0 + y * 7.0
  # A crystal stands on its base, so `spawn_shard` scatters upward from the
  # point it is given. A shoulder is not a base: what is wanted here is a
  # scatter *around* the height, so each burst starts half its own spread
  # below the part it is coming from — which is what `low` works out.
  for j in 0..4
    spawn_shard(sb, k0 + j, x, low(y + 1.62, head_bit()), z, head_bit(), r, g, b, 1.3, 0.0, seed + to_float(j))
  for j in 0..4
    spawn_shard(sb, k0 + 4 + j, x + ax, low(y + 1.15, limb_bit()), z + az, limb_bit(), r, g, b, 1.2, 0.0, seed + to_float(j) + 40.0)
  for j in 0..4
    spawn_shard(sb, k0 + 8 + j, x - ax, low(y + 1.15, limb_bit()), z - az, limb_bit(), r, g, b, 1.2, 0.0, seed + to_float(j) + 80.0)
  for j in 0..6
    spawn_shard(sb, k0 + 12 + j, x, low(y + 0.45, limb_bit()), z, limb_bit(), r, g, b, 1.0, 0.0, seed + to_float(j) + 120.0)
  poke_f32(w, 61, to_float(k0 + 18))
  1

# How big a piece is, which is also how far the burst scatters: a shard's own
# size is a fifth of this and its spread is one and a half times it.
fn head_bit() = 0.6

fn limb_bit() = 0.55

fn low(h: Float, bit: Float) = h - bit * 0.8

# The same colour the renderer works out for a player, which is the golden
# angle round the hue circle and a saturation that falls with their health.
# Written here as well because the pieces have to match the person, and the
# world is where they are made.
fn hue_h(id: Float) = id * 0.61803398875 - floor(id * 0.61803398875)

fn hue_s(hp: Float) = 0.35 + 0.4 * clampf(hp, 0.0, 1.0)

fn hue_v(hp: Float) = 0.55 + 0.35 * clampf(hp, 0.0, 1.0)

# Hue to red, green and blue, one channel at a time: each is the same curve
# with the wheel turned a third, which is cheaper to say three times than to
# say once with an index into something.
fn hue_ch(h: Float, sat: Float, val: Float, turn: Float) =
  t = h * 6.0 + turn
  k = t - 6.0 * floor(t / 6.0)
  m = if k < 3.0 then k else 6.0 - k
  val * (1.0 - sat * clampf(1.0 - clampf(m - 1.0, 0.0, 1.0), 0.0, 1.0))

fn hue_r(id: Float, hp: Float) = hue_ch(hue_h(id), hue_s(hp), hue_v(hp), 5.0)

fn hue_g(id: Float, hp: Float) = hue_ch(hue_h(id), hue_s(hp), hue_v(hp), 3.0)

fn hue_b(id: Float, hp: Float) = hue_ch(hue_h(id), hue_s(hp), hue_v(hp), 1.0)

# Where the magazines lie. Scattered like everything else in the valley — a
# hash of the index, tried a few times until one lands on ground rather than in
# the lake, because a magazine at the bottom of the water is one nobody will
# ever have.
fn place_mags(w: Ptr) =
  sb = peek_ptr(w, 69)
  for i in 0..mag_count()
    place_mag(w, sb, i, 0)

# Where box `i` lies once it has been taken `n` times. A pure function of the
# two, which is the whole of how the valley stays in step: nobody has to be
# told a position, only a count. Thirty-seven is nothing but a stride large
# enough that box three on its second life is not box four on its first.
fn mag_seed(i: Int, times: Int) = to_float(i) + to_float(times) * 37.0

fn mag_spot(seed: Float, tries: Int) =
  x = (hash2(seed * 3.7 + to_float(tries) * 11.3, 5.0) - 0.5) * 150.0
  z = (hash2(seed * 5.1 + to_float(tries) * 7.9, 9.0) - 0.5) * 150.0
  if height(x, z) > 0.4 then pack_spot(x, z) else if tries > 6 then pack_spot(x, z) else mag_spot(seed, tries + 1)

# Two numbers out of one return, without a tuple: the valley is one array of
# floats and this is the one place that wanted a pair.
fn pack_spot(x: Float, z: Float) = (x, z)

fn place_mag(w, sb, i, times) =
  (x, z) = mag_spot(mag_seed(i, times), 0)
  at = i * shard_stride()
  poke_f32(sb, at, x)
  poke_f32(sb, at + 1, stop_height(w, x, z))
  poke_f32(sb, at + 2, z)
  poke_f32(sb, at + 3, 0.0)
  poke_f32(sb, at + 4, 0.0)
  poke_f32(sb, at + 5, 0.0)
  # Only the yaw. A shard tumbles on all three axes because it was thrown; a
  # box was put down, and a box lying on its corner in the grass reads as a
  # bug rather than as scenery.
  poke_f32(sb, at + 6, 0.0)
  poke_f32(sb, at + 7, hash2(to_float(i), 3.0) * 6.28318)
  poke_f32(sb, at + 8, 0.0)
  poke_f32(sb, at + 9, 0.0)
  poke_f32(sb, at + 10, 0.0)
  poke_f32(sb, at + 11, 0.0)
  poke_f32(sb, at + 12, if i < mag_only() then mag_scale()
    else if i < crate_end() then crate_scale()
    else belt_scale())
  # And the colour goes unread. The prop pipeline samples a photograph of the
  # real thing; these three are left as they were so that a slot is the same
  # twenty floats wherever it is looked at.
  poke_f32(sb, at + 13, 0.2)
  poke_f32(sb, at + 14, 0.23)
  poke_f32(sb, at + 15, 0.3)
  poke_f32(sb, at + 16, if i < mag_only() then worth_rounds()
    else if i < crate_end() then worth_rockets()
    else worth_belt())
  # How many times this one has been taken, which is the other half of where
  # it is. Not a clock: a count survives a client and a server disagreeing
  # about the time by a tenth of a second, and a due date does not.
  poke_f32(sb, at + 17, to_float(times))
  1

# What the wire says about a box, and what a browser does about it: box `i`
# has been taken `n` times, so it is lying wherever that pair puts it. Stated
# rather than stepped, so a client that missed the message before it, or heard
# one twice, still ends up in the same place as everybody else.
fn set_mag(w: Ptr, i: Int, times: Int) =
  place_mag(w, peek_ptr(w, 69), i, times)
  1

# And what a server reads off its own world to know there is anything to say.
fn mag_times(w: Ptr, i: Int) -> Int =
  to_int(peek_f32(peek_ptr(w, 69), i * shard_stride() + 17))

fn break_crystal(w, cb, cat, ci) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))
  x = peek_f32(cb, cat)
  y = peek_f32(cb, cat + 1)
  z = peek_f32(cb, cat + 2)
  # A tally the host watches, and where the last one went. It has no other way
  # of knowing: the hit happens inside a frame it only calls.
  #
  # The tally is also the cursor of a small ring of which crystal it was. A
  # server reads back the ones a client has not heard about yet; the count and
  # the log are the same number, so they cannot come apart.
  ring_push(w, 97, 62, break_ring(), ci)
  poke_f32(w, 70, x)
  poke_f32(w, 71, y)
  poke_f32(w, 72, z)
  sc = peek_f32(cb, cat + 3)
  r = peek_f32(cb, cat + 5)
  g = peek_f32(cb, cat + 6)
  b = peek_f32(cb, cat + 7)
  poke_f32(cb, cat + 3, 0.0)

  worth = chip_heal(r, g, b)

  for j in 0..8
    spawn_shard(sb, k0 + j, x, y, z, sc, r, g, b, 1.0, worth, to_float(ci * 8 + j))

  poke_f32(w, 61, to_float(k0 + 8))
  1

# One crystal against one round's path this frame.
#
# A crystal is a bipyramid: a point at the bottom, a waist at 0.7 of its scale
# where it is 0.42 wide, and a long taper to a point at 2.4. One sphere around
# its middle is the wrong shape twice over — far too generous at the tips,
# where a shot half a crystal clear of it still counted, and not generous
# enough at the waist.
#
# Six spheres up the axis, each at least as wide as the crystal is at that
# height and at least half the distance to the next, so the chain has no holes
# in it. That is a hit test the shape of the thing being shot at.
#
# Four of them left two: from 1.68 to 1.87, and from 2.13 to the tip at 2.40.
# The second one is the one anybody would notice — the top eleven per cent of
# a crystal is the part that stands clear of everything around it, so it is
# exactly the part people shoot at, and rounds went straight through it.
fn hit_at(cb, cat, sc, f, rr, ax, ay, az, bx, by, bz) =
  d2 = seg_dist2(ax, ay, az, bx, by, bz, peek_f32(cb, cat), peek_f32(cb, cat + 1) + sc * f, peek_f32(cb, cat + 2))

  r = sc * rr
  if d2 < r * r then 1.0 else 0.0

fn try_break(w, cb, ci, b, at, ax, ay, az, bx, by, bz) =
  cat = ci * 8
  sc = peek_f32(cb, cat + 3)
  if sc < 0.01 then 0
  else
    n1 = hit_at(cb, cat, sc, 0.0, 0.25, ax, ay, az, bx, by, bz)
    n2 = hit_at(cb, cat, sc, 0.5, 0.34, ax, ay, az, bx, by, bz)
    n3 = hit_at(cb, cat, sc, 1.0, 0.35, ax, ay, az, bx, by, bz)
    n4 = hit_at(cb, cat, sc, 1.5, 0.25, ax, ay, az, bx, by, bz)
    n5 = hit_at(cb, cat, sc, 1.9, 0.2, ax, ay, az, bx, by, bz)
    n6 = hit_at(cb, cat, sc, 2.25, 0.18, ax, ay, az, bx, by, bz)
    if n1 + n2 + n3 + n4 + n5 + n6 < 0.5 then 0
    else
      # The round stops in the glass either way. What it did to the glass is
      # the ledger's: a rifle round is a whole crystal, an AK round a fifth of
      # one — five of the fast little rounds to what one aimed shot does.
      poke_f32(b, at + 7, 0.0)
      hpb = peek_ptr(w, 83)
      worn = peek_f32(hpb, ci) + (if round_scale(b, at) < 0.5 then 0.2 else 1.0)
      if worn > 0.99 then break_crystal(w, cb, cat, ci)
      else
        poke_f32(hpb, ci, worn)
        chip_crystal(w, cb, cat)

# A round that wore the glass without breaking it: two chips off the surface,
# in the crystal's own colour, so five shots read as five bites rather than
# four nothings and a surprise.
fn chip_crystal(w, cb, cat) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))
  cs = seg_of(w)
  fill_chunk(cs, peek_f32(cb, cat), peek_f32(cb, cat + 1) + peek_f32(cb, cat + 3) * 0.8, peek_f32(cb, cat + 2), 0.2, peek_f32(cb, cat + 5), peek_f32(cb, cat + 6), peek_f32(cb, cat + 7))
  fill_kick(cs, 0.0, 3.0, 0.0)

  for j in 0..2
    spawn_chunk(sb, k0 + j, cs, peek_f32(cb, cat) * 7.7 + to_float(j))

  poke_f32(w, 61, to_float(k0 + 2))
  1

fn hit_crystals(w, b, at, ax, ay, az, bx, by, bz) =
  sg = seg_of(w)
  poke_f32(sg, 0, ax)
  poke_f32(sg, 1, ay)
  poke_f32(sg, 2, az)
  poke_f32(sg, 3, bx)
  poke_f32(sg, 4, by)
  poke_f32(sg, 5, bz)
  set_grid_bounds(sg, ax, az, bx, bz, 4.5)
  grid_walk(w, b, at, 0)

# ---- and what it does to somebody ------------------------------------------
#
# The same segment test the crystals get, against two spheres: the body and the
# head. A person is not a sphere, but they are a good deal closer to two of
# them stacked than to one — the single sphere that covers a standing figure
# also covers the half metre of air on either side of them, and rounds that
# went visibly wide still counted.
#
# What a hit costs depends on where it lands. Three spheres stacked, tested
# from the top down because the smallest is worth the most:
#
#   the head, a tenth of a metre wide at eye height, ends it outright;
#   the body, from the hips to the shoulders, takes a third;
#   the legs, from the ground to the hips, take a tenth.
#
# The whole of the difficulty of this rifle is now in where it is pointed
# rather than in how many times it is fired, which is the difference between a
# shot and a sequence. A body hit is still deliberately worse than a fireball
# — one of those takes an eighth — because the fireballs are weather and the
# rifle is somebody deciding.
# The AK's round arrives slower than the rifle's and lands at a third of its
# worth — read off the round itself, because the ring has no field to spare
# and the speed already says which gun it left.
#
# A hundred metres a second is the line, and the drag is what makes it safe.
# The rounds lose speed as `dv/dt = -0.00011 v²`, which over a whole 3.2
# second life takes the rifle's from 240 to about 221 and the AK's from 180
# to about 169: both stay far above the hundred this line is drawn at, so
# neither ever pays the slow-round third. Sixty was the line while the AK left the
# muzzle at forty; the day its speed doubled, a threshold left where it was
# would have handed it the rifle's damage in silence — and the day the
# rifle's doubled again, this comment was re-read before the number moved,
# which is the sort of thing a number in a comment is for.
fn round_scale(b, at) =
  vx = peek_f32(b, at + 3)
  vy = peek_f32(b, at + 4)
  vz = peek_f32(b, at + 5)
  if vx * vx + vy * vy + vz * vz < 10000.0 then 1.0 / 3.0 else 1.0

fn head_hurt() = 1.0

fn body_hurt() = 0.3

fn leg_hurt() = 0.1

fn player_sphere(s, up, r, ax, ay, az, bx, by, bz) =
  d2 = seg_dist2(ax, ay, az, bx, by, bz, peek_f32(s, 21), peek_f32(s, 22) + up, peek_f32(s, 23))

  if d2 < r * r then 1.0 else 0.0

# A round passes through whoever fired it: at the muzzle it starts nine tenths
# of a metre from their own eye, which is inside the sphere around their head.
fn try_hit_player(w, s, owner, b, at, ax, ay, az, bx, by, bz) =
  if peek_f32(s, 99) == owner then 0 else if peek_f32(s, 82) < 0.001 then 0 else hit_where(w, s, owner, b, at, ax, ay, az, bx, by, bz)

# Top down: the head is inside the body's sphere as far as a segment test is
# concerned, so asking about the body first would give away every head shot.
fn hit_where(w, s, owner, b, at, ax, ay, az, bx, by, bz) =
  if player_sphere(s, 1.62, 0.3, ax, ay, az, bx, by, bz) > 0.5 then landed(w, s, owner, b, at, head_hurt() * round_scale(b, at)) else if player_sphere(s, 1.05, 0.42, ax, ay, az, bx, by, bz) > 0.5 then landed(w, s, owner, b, at, body_hurt() * round_scale(b, at)) else if player_sphere(s, 0.45, 0.36, ax, ay, az, bx, by, bz) > 0.5 then landed(w, s, owner, b, at, leg_hurt() * round_scale(b, at)) else 0

# Both halves of a hit are written down: one for whoever was hit and one for
# whoever fired, because the second is the interesting number and cannot be
# worked out from the first — a valley of four people has no way of telling
# whose round it was from the fact that somebody flinched.
fn landed(w, s, owner, b, at, hurt) =
  poke_f32(b, at + 7, 0.0)
  was = peek_f32(s, 82)
  poke_f32(s, 82, clampf(was - hurt, 0.0, 1.0))
  poke_f32(s, 109, peek_f32(s, 109) + 1.0)
  credit(w, owner)
  put_hurt(w, peek_f32(s, 99), owner, was - peek_f32(s, 82), if peek_f32(s, 82) < 0.001 then 1.0 else 0.0)
  1

# ---- who hit you ------------------------------------------------------------
#
# A ring, and a count that only goes up, in the shape everything else that
# happens between two ticks is sent in. Four numbers: who was hit, who hit
# them, how much of them it took, and whether that was the end of them. The
# third because a hit is not always the same size and "sixteen" is a different
# thing to be told than "you have been shot"; the fourth because the shooter
# cannot work it out — the snapshot that says the victim is down arrives after
# this and says nothing about who put them there.
#
# Only the server fills this in. A client is told, and tells whoever it is
# about; it is the one fact in the valley that somebody else knows about you
# before you do.
fn hurt_ring() = 32

fn put_hurt(w, victim, shooter, dmg, down) =
  k = to_int(peek_f32(w, 112))
  at = k % hurt_ring() * 4
  hb = peek_ptr(w, 113)
  poke_f32(hb, at, victim)
  poke_f32(hb, at + 1, shooter)
  poke_f32(hb, at + 2, dmg)
  poke_f32(hb, at + 3, down)
  poke_f32(w, 112, to_float(k + 1))
  if down > 0.5 then tally_end(w, victim, shooter) else 0
  1

fn hurts(w: Ptr) -> Int = to_int(peek_f32(w, 112))

fn hurt_f(w: Ptr, k: Int, j: Int) -> Float = peek_f32(peek_ptr(w, 113), k % hurt_ring() * 4 + j)

# The shooter by their id rather than by where they were in the table: a round
# outlives the slot of whoever fired it, which is the whole reason the id is
# carried on the round at all.
fn credit(w, owner) =
  i = index_of(w, owner, 0)
  if i < 0 then 0 else bump(player_at(w, i))

fn bump(s) =
  poke_f32(s, 110, peek_f32(s, 110) + 1.0)
  1

fn hits_taken(s: Ptr) -> Int = to_int(peek_f32(s, 109))

fn hits_given(s: Ptr) -> Int = to_int(peek_f32(s, 110))

fn hit_players(w, b, at, ax, ay, az, bx, by, bz) =
  owner = peek_f32(b, at + 6)

  for i in 0..player_count(w)
    try_hit_player(w, player_at(w, i), owner, b, at, ax, ay, az, bx, by, bz)

fn step_shard(w, sb, at, dt) =
  sc = peek_f32(sb, at + 12)
  # Every piece falls, whatever it is worth. The test for that — slot 16, the
  # flag that says a chip came off a crystal you shot and not out of a crater —
  # belongs in `gather_shard` and was for a while in here as well, which meant
  # the eighteen lumps a meteor throws were never stepped at all: no gravity,
  # no tumble, no landing. They hung in the air over the crater at the height
  # they spawned, each frozen at its random spawn angle, until the slot was
  # reused. What a shard is worth to walk over has nothing to do with whether
  # it obeys gravity.
  if sc < 0.0001 then 0
  else
    vy = peek_f32(sb, at + 4) - 24.0 * dt
    x = peek_f32(sb, at) + peek_f32(sb, at + 3) * dt
    y = peek_f32(sb, at + 1) + vy * dt
    z = peek_f32(sb, at + 2) + peek_f32(sb, at + 5) * dt
    g = stop_height(w, x, z)
    down = if y < g then 1.0 else 0.0
    keep = 1.0 - down
    poke_f32(sb, at, x)
    poke_f32(sb, at + 1, if down > 0.5 then g else y)
    poke_f32(sb, at + 2, z)
    poke_f32(sb, at + 3, peek_f32(sb, at + 3) * keep)
    poke_f32(sb, at + 4, vy * keep)
    poke_f32(sb, at + 5, peek_f32(sb, at + 5) * keep)
    poke_f32(sb, at + 6, peek_f32(sb, at + 6) + peek_f32(sb, at + 9) * dt)
    poke_f32(sb, at + 7, peek_f32(sb, at + 7) + peek_f32(sb, at + 10) * dt)
    poke_f32(sb, at + 8, peek_f32(sb, at + 8) + peek_f32(sb, at + 11) * dt)
    poke_f32(sb, at + 9, peek_f32(sb, at + 9) * keep)
    poke_f32(sb, at + 10, peek_f32(sb, at + 10) * keep)
    poke_f32(sb, at + 11, peek_f32(sb, at + 11) * keep)
    1

fn step_shards(w, sb, dt) =
  # The boxes stand on the ground and the ground can be taken out from under
  # them. They were placed on the hillside the valley was born with, so a
  # crate over somebody's shaft hung in the air where the rock used to be —
  # which is the one thing in this world that could be seen to be wrong from
  # across the valley. They fall now, like everything else that is standing on
  # something.
  for i in 0..mag_count()
    at = i * shard_stride()
    g = stop_height(w, peek_f32(sb, at), peek_f32(sb, at + 2))
    if peek_f32(sb, at + 1) > g then poke_f32(sb, at + 1, g) else poke_f32(sb, at + 1, peek_f32(sb, at + 1))

  for i in 0..shard_cap()
    step_shard(w, sb, i * shard_stride(), dt)

fn clear_shards(sb) =
  for i in 0..shard_cap()
    poke_f32(sb, i * shard_stride() + 12, 0.0)

fn shards(s: Ptr) -> Ptr = peek_ptr(wd(s), 69)

# How many crystals have been broken since the world was built, and where the
# most recent one stood.
fn breaks(s: Ptr) -> Int = to_int(peek_f32(wd(s), 62))

fn break_x(s: Ptr) -> Float = peek_f32(wd(s), 70)

fn break_y(s: Ptr) -> Float = peek_f32(wd(s), 71)

fn break_z(s: Ptr) -> Float = peek_f32(wd(s), 72)

fn shards_cap(s: Ptr) -> Int = shard_cap()

# ---- what the far crystals throw back --------------------------------------
#
# Every couple of seconds one crystal, chosen at random and only if it is far
# enough away to be worth watching, lobs a ball of fire at where the player is
# standing. Where they are standing, not where they will be: a shot led onto a
# moving target always lands, and a fireball you cannot walk out of the way of
# is not a fireball, it is a cutscene.
#
# The launch angle is solved without any inverse trigonometry, which this file
# has none of. Pick the flight time instead of the angle — the horizontal
# distance over a chosen horizontal speed — and the two velocities fall out of
# it: across, the distance over the time; upward, whatever cancels the drop
# over that time and still arrives at the right height. Exact in a vacuum, and
# at fourteen metres a second the air is very nearly a vacuum.

fn fireball_cap() = 24

# Nine floats: position, velocity, a seed, the life left, and how long it has
# been flying — which the trail needs, so it cannot draw smoke from before the
# thing existed.
fn fireball_stride() = 9

fn fireball_speed() = 14.0  # horizontal; the arc comes from the height

# Fireballs fall at a third of what everything else falls at. This is the one
# unphysical number in the file and it earns its place: a projectile this slow
# thrown this far has to be lobbed over a house, and it spends its whole flight
# above the top of the screen. A third of a gravity keeps the arc low enough to
# watch without making the thing any faster. Everything else about it — the
# aiming, the drag, the landing — is the same arithmetic as the rifle's.
fn fireball_g() = 3.2

# Before it throws, a crystal draws itself up — two and a half times its own
# size over a second and a quarter, which is enough to see from across the
# valley and is the only warning there is — throws, and settles back over
# nearly as long. Only ever one at a time, so the whole animation is three
# numbers in the state rather than a field on every instance.
fn charge_time() = 1.25

fn relax_time() = 0.95

fn charge_swell() = 1.5

# Three and a bit seconds between attempts.
#
# This has been round three times. At one second, twenty-two landed on a
# standing player in thirty-five — arriving faster than the two and a half
# seconds one takes to fly, which is a barrage, and a threat that never stops
# stops being a threat. At three it was sixteen a minute and the hillside went
# quiet. One point six sat between them for a while, and it was the right
# number for a blast that reached forty-five metres: at that radius the sky
# being busy *was* the threat, because there was nowhere in the meadow a
# meteor did not reach.
#
# Halving the radius changed what a meteor is. It is now a thing that happens
# where it lands — ten metres away is two per cent of you — so the pressure
# has to come from one arriving near you rather than from several arriving at
# once. Three point two is that: half as many, each of which means something.
# Measured against the running server with somebody standing in it: seventeen
# throws a minute became nine.
fn fireball_every() = 3.2  # seconds between attempts

fn fireball_reach() = 70.0  # nothing nearer than this throws

fn launch_fireball(fb, k, cx, cy, cz, px, py, pz, seed) =
  dx = px - cx
  dz = pz - cz
  d = sqrt(dx * dx + dz * dz) + 0.001
  t = d / fireball_speed()
  at = k % fireball_cap() * fireball_stride()
  poke_f32(fb, at, cx)
  poke_f32(fb, at + 1, cy)
  poke_f32(fb, at + 2, cz)
  poke_f32(fb, at + 3, dx / t)
  poke_f32(fb, at + 4, (py - cy + 0.5 * fireball_g() * t * t) / t)
  poke_f32(fb, at + 5, dz / t)
  poke_f32(fb, at + 6, seed)
  poke_f32(fb, at + 7, t + 2.0)
  poke_f32(fb, at + 8, 0.0)
  1

# Three crystals can be winding up at once. One at a time held the rate down to
# a shot every five seconds however short the wait between them was made: the
# swell and the settle are two and a quarter of those seconds on their own, and
# nothing else could start until they were done. Three of them, each with its
# own index, size, mode and clock, live in a little buffer rather than in state
# slots — which is also what makes the count a constant to change rather than a
# rewrite.

fn charger_cap() = 3

fn charger_stride() = 5  # crystal, its size, mode, clock, who for

# Who a crystal has decided to throw at, and whether somebody is worth
# throwing at. Standing in the lake is what takes you off the list — the same
# rule the blast damage obeys, so wading in protects you from the shots that
# have not been fired as well as from the ones that have.
fn worth_throwing_at(s, cb, cat) =
  if in_water(s) > 0 then 0
  else if peek_f32(s, 82) < 0.001 then 0
  else
    dx = peek_f32(s, 21) - peek_f32(cb, cat)
    dz = peek_f32(s, 23) - peek_f32(cb, cat + 2)
    if sqrt(dx * dx + dz * dz) < fireball_reach() then 0 else 1

# The first player worth it, starting from a rolled index rather than from
# zero — otherwise whoever joined first is the only one ever shot at.
fn pick_target(w, cb, cat, from, tried) =
  n = player_count(w)
  if n == 0 then 0 - 1 else if tried == n then 0 - 1 else pick_or_next(w, cb, cat, from, tried, (from + tried) % n)

fn pick_or_next(w, cb, cat, from, tried, i) =
  if worth_throwing_at(player_at(w, i), cb, cat) > 0 then i else pick_target(w, cb, cat, from, tried + 1)

# A block by the id it carries, or nothing if they have gone. A charge takes a
# second and a quarter to wind up and its target can leave inside that, so the
# throw asks again rather than trusting the index it started with.
fn player_by_id(w, id, i) =
  if i == player_count(w) then null_ptr() else player_by_id_at(w, id, i, player_at(w, i))

fn player_by_id_at(w, id, i, s) =
  if peek_f32(s, 99) == id then s else player_by_id(w, id, i + 1)

# Two chargers must not take the same crystal. Written out rather than looped
# because a `for` here would have nothing to accumulate into.
fn taken_at(cbuf, at, i) =
  if peek_f32(cbuf, at + 2) < 0.5 then 0 else yes(to_int(peek_f32(cbuf, at)) == i)

fn taken(cbuf, i) =
  st = charger_stride()
  taken_at(cbuf, 0, i) + taken_at(cbuf, st, i) + taken_at(cbuf, st * 2, i)

# Slot 79 is the gate: zero means one charge may begin this frame.
#
# Nothing is thrown at someone standing in the lake, and nothing is thrown at
# somebody who is already down. Both are checked where a charge begins rather
# than where one is released, so a crystal that is already swelling still
# finishes its throw: cutting the animation off mid-swell because the target
# waded in would leave a crystal stuck at twice its size with nothing to bring
# it back.
fn maybe_start(w, cbuf, ci, tnow) =
  at = ci * charger_stride()
  if peek_f32(w, 79) > 0.5 then 0
  else if peek_f32(cbuf, at + 2) > 0.5 then 0
  else
    cb = peek_ptr(w, 66)
    n = to_int(peek_f32(w, 58))
    r = hash2(floor(tnow * 7.3) + to_float(ci) * 3.0, 91.0)
    i = to_int(r * to_float(n)) % n
    cat = i * 8
    sc = peek_f32(cb, cat + 3)
    if sc < 0.01 then 0 else if taken(cbuf, i) > 0 then 0 else start_at(w, cbuf, at, cb, cat, i, sc, pick_target(w, cb, cat, to_int(r * 977.0), 0))

fn start_at(w, cbuf, at, cb, cat, i, sc, ti) =
  if ti < 0 then 0
  else
    poke_f32(cbuf, at, to_float(i))
    poke_f32(cbuf, at + 1, sc)
    poke_f32(cbuf, at + 2, 1.0)
    poke_f32(cbuf, at + 3, 0.0)
    poke_f32(cbuf, at + 4, peek_f32(player_at(w, ti), 99))
    poke_f32(w, 79, 1.0)
    1

# Where the target is *now*, not where they were when the crystal started to
# swell. A shot led onto a moving target always lands and is not a fireball; a
# shot aimed at where they stood a second and a quarter ago is one you can walk
# out of, which is what the swell is a warning of.
fn throw_from(w, cb, cat, base, tnow, id) =
  target = player_by_id(w, id, 0)
  if is_null(target) then 0 else throw_at(w, cb, cat, base, tnow, target)

fn throw_at(w, cb, cat, base, tnow, s) =
  k = to_int(peek_f32(w, 63))
  poke_f32(w, 63, to_float(k + 1))
  launch_fireball(peek_ptr(w, 74), k, peek_f32(cb, cat), peek_f32(cb, cat + 1) + base * 1.9, peek_f32(cb, cat + 2), peek_f32(s, 21), peek_f32(s, 22) + 1.2, peek_f32(s, 23), hash2(floor(tnow * 11.7), 53.0))

# Growing, throwing, settling back. If the crystal is shot while it is winding
# up, its scale is already zero and there is nothing to put back: the charger
# just goes idle, which is what the liveness test is for.
fn run_one(w, cbuf, ci, dt, tnow) =
  at = ci * charger_stride()
  mode = peek_f32(cbuf, at + 2)
  if mode < 0.5 then 0
  else
    cb = peek_ptr(w, 66)
    cat = to_int(peek_f32(cbuf, at)) * 8
    base = peek_f32(cbuf, at + 1)
    ct = peek_f32(cbuf, at + 3) + dt
    poke_f32(cbuf, at + 3, ct)
    if peek_f32(cb, cat + 3) < 0.01 then
      poke_f32(cbuf, at + 2, 0.0)
      0
    else if mode < 1.5 then
      poke_f32(cb, cat + 3, base * (1.0 + charge_swell() * smoothstep(0.0, charge_time(), ct)))
      if ct < charge_time() then 0
      else
        throw_from(w, cb, cat, base, tnow, peek_f32(cbuf, at + 4))
        poke_f32(cbuf, at + 2, 2.0)
        poke_f32(cbuf, at + 3, 0.0)
        1
    else
      poke_f32(cb, cat + 3, base * (1.0 + charge_swell() * (1.0 - smoothstep(0.0, relax_time(), ct))))
      if ct < relax_time() then 0
      else
        poke_f32(cb, cat + 3, base)
        poke_f32(cbuf, at + 2, 0.0)
        1

fn start_pass(w, cbuf, tnow) =
  for ci in 0..charger_cap()
    maybe_start(w, cbuf, ci, tnow)

fn step_pass(w, cbuf, dt, tnow) =
  for ci in 0..charger_cap()
    run_one(w, cbuf, ci, dt, tnow)

# Whether the far crystals throw at all.
#
# A switch on the world rather than a constant in this file, because the two
# valleys want different answers: a browser alone in one is the demo the
# fireballs were written for, and a shared one is a place people are trying to
# stand about in and shoot each other. `init` leaves them off and either end
# may turn them on — a server with `meteors=on`, a browser with `set_meteors`.
#
# Off is the default now. A sky that drops a fireball every few seconds is a
# fine thing to watch and a poor thing to be shot at in, and the valley has
# become the second of those.
#
# Only the *starting* is gated. Whatever is already winding up finishes its
# swell, throws and settles back, because a crystal cut off mid-swell would
# stay at two and a half times its size with nothing left to bring it down.
fn meteors_on(w: Ptr) -> Int = yes(peek_f32(w, 53) > 0.5)

fn set_meteors(w: Ptr, on: Int) =
  poke_f32(w, 53, if on > 0 then 1.0 else 0.0)
  1

fn run_charge(w, dt, tnow) =
  cbuf = peek_ptr(w, 77)
  ct = peek_f32(w, 73) + dt
  due = if ct > fireball_every() then 1.0 else 0.0
  poke_f32(w, 73, if due > 0.5 then 0.0 else ct)
  poke_f32(w, 79, 1.0 - due)
  if meteors_on(w) > 0 then start_pass(w, cbuf, tnow) else 0
  step_pass(w, cbuf, dt, tnow)

fn clear_chargers(cbuf) =
  for ci in 0..charger_cap()
    poke_f32(cbuf, ci * charger_stride() + 2, 0.0)

# ---- where one lands -------------------------------------------------------
#
# A ring of eight impacts, each remembered just long enough to be drawn: where
# it was, a seed so no two blasts look alike, and how long ago. The debris is
# not a second system — it is the same shards a broken crystal leaves, thrown
# from the impact instead, charred rather than coloured. They fall, land and
# stay, because that is what the shard pool already does.

fn blast_cap() = 8

fn blast_stride() = 8

# What an impact does to whoever is standing near it. Nothing past sixty
# metres, falling off hard inside it — five times the fireball's own twelve,
# because the pressure gets to you before the fire does and there is nowhere to
# be that is "just outside" an explosion.
#
# An eighth of you at the centre, so it takes nine direct hits. These arrive
# about sixteen times a minute and all of them land on you if you stand still,
# which at a fifth was death in twenty-five seconds — measured, and too short
# for a valley anyone is meant to look at. Nine gives you most of a minute of
# doing nothing, which is long enough to work out that doing nothing is the
# problem. These are thrown
# at where you are standing, so standing still is what gets you hit; at 0.62,
# which is where this started, three landed in eleven seconds and killed a
# player who had not yet finished looking around. Punishing the mistake is the
# point, but it has to be a mistake you get to notice you are making.
# How far a blast is felt, and it is not one number any more. A meteor is
# weather — it comes down where it likes and the radius is what makes standing
# still the mistake — but a rocket is aimed, and a rocket that reaches
# twenty-two metres is a weapon you do not have to hit anybody with. Thirty per
# cent off the rocket's: 15.75 against the sky's 22.5.
#
# It is only the reach that moves. The cube below is unchanged, so a direct hit
# takes the same bite it always did and what has gone is the outer ring — the
# hits that were landing on somebody a stone's throw from where the warhead
# went. At ten metres a rocket now does a fifth of what it did.
fn meteor_reach() = 22.5

fn rocket_reach() = 15.75

fn blast_hurt(s, x, y, z, reach) =
  dx = peek_f32(s, 21) - x
  dy = peek_f32(s, 22) + 1.0 - y
  dz = peek_f32(s, 23) - z
  d = sqrt(dx * dx + dy * dy + dz * dz)
  k = clampf(1.0 - d / reach, 0.0, 1.0)
  # Cubed, and out to whatever `reach` the caller handed down. Squared over a
  # short radius meant every impact either missed entirely or took the same
  # bite out of you, because these are thrown at where you are standing and so
  # nearly all of them land within a few metres.
  #
  # The cube is what stops a radius from meaning everything hurts equally: at a
  # meteor's reach, full at your feet, a third of it at seven and a half
  # metres, a twenty-seventh at fifteen, and under the floor below — nothing at
  # all past about seventeen. A rocket's is the same shape over a shorter run.
  # What it buys is that a near miss is felt at all, so the one that lands a
  # few paces away is still part of the weather rather than being either lethal
  # or nothing.
  #
  # The radius has come down twice. Sixty was too much of the valley — an
  # impact you could barely see across the meadow still registered, which made
  # the whole map feel dangerous rather than the ground around you. Forty-five
  # gave back the far side and still reached a third of the way across it.
  # Halving that again is what makes a meteor a thing that happens *where it
  # lands*: standing ten metres off is now most of the way to safe, which is
  # the distance somebody walking away covers while one is in the air.
  hit = 0.115 * k * k * k
  # Nothing reaches you in the lake. The crystals already refuse to throw at
  # someone standing in it; this is the other half of that — one already in the
  # air when you waded in should not still land on you. Water takes a blast
  # wave apart, and more to the point the two rules have to agree or wading in
  # only protects you from the shots that had not been fired yet.
  if in_water(s) > 0 then 0
  else if hit < 0.002 then 0
  else
    poke_f32(s, 82, clampf(peek_f32(s, 82) - hit, 0.0, 1.0))
    # And it shoves you. Away from the blast on the flat and a little upward,
    # both scaled by exactly the k² the damage is — so the push and the hurt
    # are the same number and a blast that barely reached you barely moves you.
    #
    # A velocity, not a displacement, and that is the whole of it. This was a
    # metre written straight into the position first, and measured at 0.16 to
    # 0.70 metres of ground covered — a real distance, and still invisible,
    # because a metre delivered inside one sixtieth of a second is not a push,
    # it is a cut to somewhere else. Handed over as a speed that decays across
    # about a fifth of a second, the same couple of metres arrive as being
    # shoved: you watch yourself go.
    #
    # Thirty-four metres a second at a direct hit, which carries five or six
    # before it dies away. One landing at your feet should throw you, and the
    # squared falloff is what keeps that from being true of the ones that did
    # not: at ten metres it is under a third of this, at fifteen a ninth.
    #
    # Measured on the way up: nine metres a second moved you 1.0 to 1.3 in the
    # second after, fifteen moved you 1.2 to 2.1, and neither read as being
    # thrown.
    #
    # And it lifts you now as well as pushing you — nine up, which against a
    # gravity of twenty-six is a metre and a half of air and two thirds of a
    # second off the ground. This was 2.2, nine centimetres, deliberately: a
    # stagger. One landing at your feet should not be a stagger. The two are
    # separate numbers so that the far ones can still only nudge you, which the
    # squared falloff sees to.
    hx = dx / (d + 0.4)
    hz = dz / (d + 0.4)
    shove = 34.0 * k * k
    poke_f32(s, 84, peek_f32(s, 84) + hx * shove)
    poke_f32(s, 85, peek_f32(s, 85) + hz * shove)
    poke_f32(s, 24, peek_f32(s, 24) + 9.0 * k * k)
    poke_f32(s, 25, 0.0)
    1

# Cuts do not heal on their own. What mends you is walking over what you broke:
# the chips a shattered crystal leaves on the ground still have the light in
# them, and stepping on one takes it.
#
# Which turns the whole thing into a loop rather than two unrelated systems. The
# crystals throw fire at you; you shoot them; what is left of them is the only
# medicine there is. Standing still is what gets you hit and also what stops you
# healing, and the thing you are being punished for going near is the thing you
# have to go near.
#
# A chip is taken once and is gone — its scale goes to zero, which is the same
# "empty slot" the pool already understands, so the piece simply is not drawn
# any more and no flag has to be invented for it.
#
# What a crystal is worth depends on which one it was — six per cent, twelve
# or twenty-four, by colour; see `chip_heal`. It averages ten, and staying
# under what a hit costs is the number that matters: the medicine has to be
# worth less than the wound, or there is nothing to weigh. It was three and a
# half a chip once, which made one crystal worth twenty-eight and turned a
# lucky shot into a full heal — twenty-four for the rarest colour is as close
# as this has been allowed back to that line.
fn gather_shard(w, s, sb, i, mend) =
  at = i * shard_stride()
  sc = peek_f32(sb, at + 12)
  if sc < 0.0001 then 0
  else if peek_f32(sb, at + 16) < 0.0001 then 0
  else
    # Charred ground is charred ground. Measured before this test existed: an
    # impact took fifteen points off and then handed back sixty-three, because
    # the eighteen pieces it blew out of the hillside landed on the player it had
    # just hit and were picked up on the spot. Being shelled was the fastest way
    # to heal in the valley.
    dx = peek_f32(sb, at) - peek_f32(s, 21)
    dy = peek_f32(sb, at + 1) - peek_f32(s, 22)
    dz = peek_f32(sb, at + 2) - peek_f32(s, 23)
    # A generous reach on the flat and a tight one vertically: you pick up what
    # you walk over, not what is on the ledge above your head.
    if dx * dx + dz * dz > 2.9 then 0
    else if dy > 2.2 then 0
    else if dy < 0.0 - 1.2 then 0
    else if wanted(s, sb, at) == 0 then 0
    else
      poke_f32(sb, at + 12, 0.0)
      worth_of(w, s, sb, i, at, mend)

# Whether this is worth anything to whoever is standing on it. Somebody
# carrying a full rifle walks over a magazine: taking it would put ten rounds
# into a rifle that has ten and move the box to the far side of the valley,
# which is the worst of both. A magazine speaks only for the rifle now and a
# crate only for the tube — ammunition stopped being one thing the day the
# crates arrived — so what you are full of, you walk past, and what you are
# short of is the thing you go looking for.
#
# A chip of crystal is always taken: the heal clamps, and a chip is small
# enough that losing a fraction of one is not something anybody is counting.
fn wanted(s, sb, at) =
  kind = peek_f32(sb, at + 16)
  if kind < 1.5 then 1
  else if kind > 3.5 then yes(mg_rounds(s) < mg_full() || mg_belts(s) < mg_belt_count() - 1)
  else if kind > 2.5 then yes(rockets(s) < rocket_full())
  else yes(rounds(s) < mag_size() || ak_rounds(s) < ak_full() || ak_mags(s) < ak_mag_count() - 1)

fn gather(w, s, sb, mend) =
  for i in 0..shard_cap()
    gather_shard(w, s, sb, i, mend)

fn health(s: Ptr) -> Float = peek_f32(s, 82)

# How many rounds are in the rifle, which is a number on the screen and the
# reason it will not go off.
fn rounds(s: Ptr) -> Int = to_int(peek_f32(s, 118))

fn mag_full() -> Int = mag_size()

# How much running is left, one to zero, for whatever wants to draw it.
fn breath(s: Ptr) -> Float = peek_f32(s, 115)

# And whether they are winded, which is the difference between an empty bar
# and a bar that is filling but will not let you run yet.
fn winded(s: Ptr) -> Int = yes(peek_f32(s, 116) > 0.5)

# Start again, without rebuilding the valley.
#
# Every crystal's size came out of `inst_scale` on a hash, and breaking one set
# it to zero — but the hash itself is still sitting in slot 4 of the same
# record, where it was written as an angle to turn the prism by. So the size is
# recoverable exactly rather than needing to be stored a second time, and the
# valley comes back with the same crystals in the same places at the same sizes
# instead of a fresh random one. That matters: starting again should be the same
# valley, or it is not starting again.
fn restore_crystal(cb, i) =
  at = i * 8
  poke_f32(cb, at + 3, inst_scale(peek_f32(cb, at + 4) / 6.28, 1))

fn reset_world(w) =
  cb = peek_ptr(w, 66)

  for i in 0..to_int(peek_f32(w, 58))
    restore_crystal(cb, i)

  # And the wear on the glass goes with the breaks.
  for i in 0..to_int(peek_f32(w, 58))
    poke_f32(peek_ptr(w, 83), i, 0.0)

  clear_marks_ring(peek_ptr(w, 75))

  poke_f32(w, 62, 0.0)
  clear_bullets(peek_ptr(w, 68))
  clear_shards(peek_ptr(w, 69))
  clear_fireballs(peek_ptr(w, 74))
  clear_blasts(peek_ptr(w, 81))
  clear_chargers(peek_ptr(w, 77))
  1

# One player back on their feet, with the valley left as it is. This is what a
# server does with somebody who has been shot: the crystals they broke stay
# broken, because the world does not begin again for everyone else.
fn respawn(s: Ptr) = place_player(s)

# And the whole thing back to the beginning, which is what the browser does
# when the last crystal is gone and there is nobody else to consider.
fn restart(s: Ptr) =
  reset_world(wd(s))
  place_player(s)
  1

# The sign of the seed says which blast this is, the way it does for the glass
# and the stone: negative is somebody's rocket, positive is the sky's.
fn hurt_everyone(w, x, y, z, seed) =
  reach = if seed > 0.0 then meteor_reach() else rocket_reach()

  for i in 0..player_count(w)
    blast_hurt(player_at(w, i), x, y, z, reach)

# What a warhead does to the glass around it.
#
# Six metres. Nine was measured rather than reasoned about and came to six
# crystals a rocket with seventeen on the best shot, which is a tube that
# clears hillsides — and seventeen breaks in one tick is over half the
# thirty-two the break ring holds, so a client could have missed some. They do
# not spread evenly: they crowd the waterline, and a rocket into a stand of
# them catches far more than the average density says it should.
#
# Six comes to three and a third a rocket over fourteen aimed shots, ten on the
# best of them, and one that broke nothing at all because it missed.
fn blast_glass() = 6.0

# And only a rocket's blast. A meteor comes down somewhere every few seconds
# and a valley that shelled its own crystals would be over without anybody in
# it — the crystals are the thing the game is about, and what breaks them is
# meant to be somebody deciding to. The sign of the seed says which blast this
# was, the same way it says which thing to draw.
fn glass_near(w, x, y, z, seed) =
  if seed > 0.0 then 0 else break_near(w, x, y, z)

fn break_near(w, x, y, z) =
  sg = seg_of(w)
  poke_f32(sg, 0, x)
  poke_f32(sg, 1, y)
  poke_f32(sg, 2, z)
  set_grid_bounds(sg, x, z, x, z, blast_glass() + 4.5)
  grid_walk(w, null_ptr(), 0, 1)

fn break_if_near(w, cb, ci, x, y, z) =
  cat = ci * 8
  if peek_f32(cb, cat + 3) < 0.01 then 0
  else
    dx = peek_f32(cb, cat) - x
    dy = peek_f32(cb, cat + 1) - y
    dz = peek_f32(cb, cat + 2) - z
    if dx * dx + dy * dy + dz * dz > blast_glass() * blast_glass() then 0 else break_crystal(w, cb, cat, ci)

fn add_blast(w, x, y, z, seed) =
  bb = peek_ptr(w, 81)
  k = to_int(peek_f32(w, 80))
  at = k % blast_cap() * blast_stride()
  poke_f32(bb, at, x)
  poke_f32(bb, at + 1, y)
  poke_f32(bb, at + 2, z)
  poke_f32(bb, at + 3, seed)
  poke_f32(bb, at + 4, 0.0)
  poke_f32(w, 80, to_float(k + 1))
  hurt_everyone(w, x, y, z, seed)
  glass_near(w, x, y, z, seed)

  # Eighteen pieces of what it hit, thrown nearly twice as hard as a crystal
  # coming apart. The fireball above them reaches twelve metres now and the
  # dust runs twenty-seven along the ground; ten chips landing inside three of
  # the crater read as a stone that cracked, not as ground that was blown out
  # of a hill.
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))

  for j in 0..18
    spawn_shard(sb, k0 + j, x, y, z, 1.1, 0.34, 0.13, 0.05, 1.9, 0.0, seed * 97.0 + to_float(j))

  poke_f32(w, 61, to_float(k0 + 18))
  warhead_debris(w, x, y, z, seed)
  smash_walls(w, x, y, z, seed)
  fell_pines(w, x, y, z, seed)

# What a warhead does to a wall. Only a warhead — a meteor landing on the tops
# would quietly take the walls apart over an afternoon with nobody there.
# Two thirds off what a warhead takes out of a wall. It was three and a half
# metres when a block was eight tenths of a metre; the blocks are three tenths
# now, so the same reach would have taken far more of the wall rather than the
# same amount in smaller pieces. Volume goes as the cube, so a third of the
# damage is the cube root of a third off the radius.
# A hole, not the wall.
#
# The reach is what decides how much of a wall goes, and a wall is a slab: the
# stones taken are the ones in the disc the sphere cuts through it, so the count
# goes as the *square* of the reach and not the cube. At 2.35 that disc was
# four and a half metres across against arms four to five metres long, which is
# not a hole in a wall, it is the wall. At 1.2 it is two and a half across and
# leaves stone standing either side, and it takes twenty-odd rockets to finish
# an L rather than two.
#
# Then back up to 1.6, because 1.2 was small enough that anything but a dead
# centre hit did nothing at all — but that was measured while the blast was
# quietly going off metres *behind* the wall it had struck. With the burst
# put back on the face it hit, 1.6 took thirty-plus stones a rocket and an L
# fell in four. Half the hole: 1.15 reaches about seventeen stones — a
# doorway, not a missing wall — and a wall is worth eight or nine rockets.
#
# And half of it again. The square law is what sets the number: half the
# stones is the square root of a half off the reach, so 1.15 becomes 0.81.
# Counted rather than trusted — a blast laid in the face of a wall takes 26
# stones at 1.15 and 13 at 0.81, which is the halving asked for exactly.
#
# The disc is a metre and six across against blocks three tenths of a metre
# on a side: five stones wide, so it is still a gap somebody can get through,
# and a wall now costs the better part of twenty rockets. The stone at the
# centre is still thrown as hard as it ever was — `burst_block` scales the
# push by the fraction of the reach, not by the reach — so what changed is
# how much goes, not how it leaves.
fn blast_stone() = 0.81

fn smash_walls(w, x, y, z, seed) =
  if seed > 0.0 then 0 else break_blocks(w, x, y, z, seed)

fn break_blocks(w, x, y, z, seed) =
  wb = wall_box(w)
  bb = blocks_ptr(w)

  for k in 0..wall_cap()
    break_in_wall(w, wb, bb, k, x, y, z, seed)
  1

fn break_in_wall(w, wb, bb, k, x, y, z, seed) =
  if wall_near(wb, k, x, y, z, blast_stone()) then break_wall_blocks(w, bb, k, x, y, z, seed) else 0

fn break_wall_blocks(w, bb, k, x, y, z, seed) =
  base = k * wall_blocks()

  for j in 0..wall_blocks()
    maybe_break_block(w, bb, base + j, x, y, z, seed)
  0

fn maybe_break_block(w, bb, i, x, y, z, seed) =
  if block_live(bb, i) then try_break_block(w, bb, i, x, y, z, seed) else 0

fn try_break_block(w, bb, i, x, y, z, seed) =
  dx = block_f(bb, i, 0) - x
  dy = block_f(bb, i, 1) - y
  dz = block_f(bb, i, 2) - z
  d2 = dx * dx + dy * dy + dz * dz
  if d2 > blast_stone() * blast_stone() then 0 else burst_block(w, bb, i, dx, dy, dz, d2, seed)

# The block goes, and what it was goes outward from where the warhead was.
#
# Speed falls off with distance the way the push does — the stone at the point
# of impact is thrown twice as hard as the one at the edge of the reach, which
# is what makes a hole rather than a uniformly scattered wall.
fn burst_block(w, bb, i, dx, dy, dz, d2, seed) =
  d = sqrt(d2)
  n = if d < 0.001 then 1.0 else 1.0 / d
  push = 22.0 * (1.0 - d / blast_stone()) + 6.0
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))
  sc = block_f(bb, i, 3)
  bx = block_f(bb, i, 0)
  by = block_f(bb, i, 1)
  bz = block_f(bb, i, 2)
  r = block_f(bb, i, 5)
  g = block_f(bb, i, 6)
  b = block_f(bb, i, 7)

  # Two pieces, near enough the size of the stone that stood there. Five chips
  # a fifth of the size read as dust coming off a wall; what should come off it
  # is the stones themselves, thrown up and then falling like anything with
  # weight — which `step_shard` already gives them.
  cs = seg_of(w)
  fill_chunk(cs, bx, by, bz, sc * 0.85, r, g, b)
  fill_kick(cs, dx * n * push, dy * n * push + 7.0, dz * n * push)
  sbase = seed * 53.0 + to_float(i) * 7.3

  for j in 0..2
    spawn_chunk(sb, k0 + j, cs, sbase + to_float(j))

  poke_f32(w, 61, to_float(k0 + 2))
  fall_to_ground(bb, i, sc)
  mark_broken(w, i)
  note_block(w, i)
  1

# A ring the server reads back, the same shape the crystals' is: a count that
# only goes up, and where it points is which block it was. A client cannot work
# out on its own which stone went, so it is told.
# ---- rings of indices --------------------------------------------------------
#
# Four of these: which crystal broke, which stone went, which pine fell, which
# of the crystals' fire was shot down. Each is a tally that doubles as the
# cursor of a small ring — the count and the log are the same number, so they
# cannot come apart — and each was written out three times over: read the
# tally, write at the tally modulo the ring, bump the tally. It is one line
# each now.
fn ring_push(w, buf, tally, ring, i) =
  n = to_int(peek_f32(w, tally))
  poke_f32(peek_ptr(w, buf), n % ring, to_float(i))
  poke_f32(w, tally, to_float(n + 1))
  1

fn ring_at(w, buf, ring, k) = to_int(peek_f32(peek_ptr(w, buf), k % ring))

fn block_ring() = 64

fn note_block(w, i) = ring_push(w, 115, 122, block_ring(), i)

fn blocks_gone(w: Ptr) -> Int = to_int(peek_f32(w, 122))

fn block_which(w: Ptr, k: Int) -> Int = ring_at(w, 115, block_ring(), k)

# Taking one out because the server said so, with no blast to work it out from.
fn drop_block(w: Ptr, i: Int) =
  bb = blocks_ptr(w)
  if i < 0 || i >= block_count(w) then 0 else if block_live(bb, i) then scatter_block(w, bb, i) else 0

fn scatter_block(w, bb, i) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))
  sc = block_f(bb, i, 3)

  cs = seg_of(w)
  fill_chunk(cs, block_f(bb, i, 0), block_f(bb, i, 1), block_f(bb, i, 2), sc * 0.85, block_f(bb, i, 5), block_f(bb, i, 6), block_f(bb, i, 7))
  fill_kick(cs, 0.0, 7.0, 0.0)
  sbase = to_float(i) * 31.7

  for j in 0..2
    spawn_chunk(sb, k0 + j, cs, sbase + to_float(j))

  poke_f32(w, 61, to_float(k0 + 2))
  fall_to_ground(bb, i, sc)
  mark_broken(w, i)
  1

# ---- the pines a warhead takes ---------------------------------------------
#
# A rocket that goes off against a trunk takes the tree. Only a rocket — the
# same sign-of-the-seed gate the walls use, or the crystals' own fire would
# slowly clear the forest by itself — and only very close: a warhead two
# metres from a trunk is a felled tree, three metres is a scorched one.
#
# A felled pine is not killed, it is *turned*: the scale goes negative, which
# is the mark every reader tests, and the yaw slot — whose work is done — is
# rewritten with the moment it fell, so the renderer can lay it down over a
# second rather than on a frame. Deterministic like everything else on this
# wire: a client is told which pine went and computes the same lie from the
# same numbers.
# A warhead's reach. The pick has its own and it is much smaller — the two used
# to share this one, which was a warhead's number doing a pick's work: a chip
# three tenths of a metre wide brought down every pine within two and a fifth
# metres of it, and the ground under those was untouched. Two things fell
# pines for two different reasons, so the reason travels with the call.
fn fell_reach() = 2.2

fn fell_ring() = 32

fn fell_pines(w, x, y, z, seed) =
  if seed > 0.0 then 0 else fell_scan(w, x, y, z, fell_reach())

fn fell_scan(w, x, y, z, reach) =
  pb = peek_ptr(w, 65)
  r2 = reach * reach

  for i in 0..to_int(peek_f32(w, 57))
    try_fell(w, pb, i, x, y, z, r2)
  1

fn try_fell(w, pb, i, x, y, z, r2) =
  if peek_f32(pb, i * 8 + 3) <= 0.01 then 0 else fell_near(w, pb, i, x, y, z, r2)

fn fell_near(w, pb, i, x, y, z, r2) =
  dx = peek_f32(pb, i * 8) - x
  dz = peek_f32(pb, i * 8 + 2) - z
  g = peek_f32(pb, i * 8 + 1)
  if dx * dx + dz * dz > r2 then 0 else if y < g - 2.0 || y > g + 12.0 then 0 else drop_pine(w, pb, i)

fn drop_pine(w, pb, i) =
  at = i * 8
  poke_f32(pb, at + 4, world_time(w))
  poke_f32(pb, at + 3, 0.0 - peek_f32(pb, at + 3))
  burst_pine(w, pb, at)
  note_fell(w, i)
  1

# Bark and splinters off the trunk, thrown up and out — the same shards
# everything else that breaks leaves, in wood's own brown.
fn burst_pine(w, pb, at) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))
  cs = seg_of(w)
  fill_chunk(cs, peek_f32(pb, at), peek_f32(pb, at + 1) + 1.1, peek_f32(pb, at + 2), 0.42, 0.30, 0.20, 0.11)
  fill_kick(cs, 0.0, 5.5, 0.0)
  sbase = peek_f32(pb, at) * 13.7

  for j in 0..6
    spawn_chunk(sb, k0 + j, cs, sbase + to_float(j))

  poke_f32(w, 61, to_float(k0 + 6))
  1

fn note_fell(w, i) = ring_push(w, 76, 93, fell_ring(), i)

fn pines_down(w: Ptr) -> Int = to_int(peek_f32(w, 93))

fn fell_which(w: Ptr, k: Int) -> Int = ring_at(w, 76, fell_ring(), k)

# Being told which pine went, with no blast of our own to work it out from —
# and the whole standing history for whoever walks in late.
fn put_fell(w: Ptr, i: Int) =
  pb = peek_ptr(w, 65)
  if i < 0 || i >= to_int(peek_f32(w, 57)) then 0 else if peek_f32(pb, i * 8 + 3) <= 0.01 then 0 else drop_pine(w, pb, i)

fn pine_felled(w: Ptr, i: Int) -> Int = yes(peek_f32(peek_ptr(w, 65), i * 8 + 3) < 0.0)

# What a warhead does that a stone does not, and only a warhead: a meteor comes
# down somewhere every few seconds and the valley would be full of columns.
fn warhead_debris(w, x, y, z, seed) =
  if seed > 0.0 then 0 else pillar_and_shrapnel(w, x, y, z, seed)

fn pillar_and_shrapnel(w, x, y, z, seed) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))

  # The column. Straight up and hardly out at all — twenty-odd metres a second
  # against gravity's twenty-four is a good two seconds of it standing there,
  # which is what makes the shape read as vertical rather than as a wider
  # version of the crater it already had.
  for j in 0..14
    pillar_piece(sb, k0 + j, x, y, z, seed * 131.0 + to_float(j))

  # And the case, which is the other half of what a warhead is: small, fast,
  # and outward in every direction, gone before the column has finished rising.
  for j in 0..22
    shrapnel_piece(sb, k0 + 14 + j, x, y, z, seed * 179.0 + to_float(j))

  poke_f32(w, 61, to_float(k0 + 36))
  1

fn pillar_piece(sb, k, x, y, z, seed) =
  h = hash2(seed, 67.0)
  g = hash2(seed, 83.0)
  spawn_piece(sb, k, x, y, z, 0.95, 0.14, 0.115, 0.1, 17.0 + h * 13.0, g * 2.2, seed)

fn shrapnel_piece(sb, k, x, y, z, seed) =
  h = hash2(seed, 71.0)
  g = hash2(seed, 89.0)
  spawn_piece(sb, k, x, y, z, 0.34, 0.32, 0.3, 0.28, 1.5 + g * 7.0, 13.0 + h * 14.0, seed)

fn step_blast(bb, at, dt) =
  a = peek_f32(bb, at + 4)
  poke_f32(bb, at + 4, if a < 0.0 then a else a + dt)

fn step_blasts(bb, dt) =
  for i in 0..blast_cap()
    step_blast(bb, i * blast_stride(), dt)

fn clear_blasts(bb) =
  for i in 0..blast_cap()
    poke_f32(bb, i * blast_stride() + 4, 0.0 - 1.0)

fn blasts(s: Ptr) -> Ptr = peek_ptr(wd(s), 81)

fn blasts_cap(s: Ptr) -> Int = blast_cap()

# How long a crater goes on lighting the valley. One light for all of them —
# two blasts close enough together to both matter is rare enough that the
# second taking over is not something anybody sees, and a light per blast
# would put a loop in every fragment in the world.
fn blast_light_s() = 2.6

# Which crater is lighting the valley: the youngest that is still burning, or
# minus one if none is. The page used to walk the ring itself and hold the
# rule — the length of a burn — in a second place; the ages are kept here, so
# the choosing belongs here too. It matters most on the frame after a round
# restart, when every blast is cleared and a rule written down anywhere else
# is still counting one down.
fn blast_lit(s: Ptr) -> Int = pick_blast(blasts(s), 0, 0 - 1)

fn pick_blast(bb, i, best) =
  if i >= blast_cap() then best
  else
    a = peek_f32(bb, i * blast_stride() + 4)
    burning = a >= 0.0 && a < blast_light_s()
    younger = best < 0 || a < peek_f32(bb, best * blast_stride() + 4)
    pick_blast(bb, i + 1, if burning && younger then i else best)

# How many have gone off since the world was built. The host watches this the
# way it watches the breaks: it has no other way of knowing, because the
# landing happens inside a frame it only calls.
fn blasts_fired(s: Ptr) -> Int = to_int(peek_f32(wd(s), 80))

# How long a rocket's smoke stands after the rocket is gone. The same number
# the trail is drawn over, in `fireball.wgsl` — the parcels fade to nothing
# across exactly this, and the slot is let go on the frame they reach it.
fn smoke_after() = 1.7

# A slot holds one of two things. A rocket in the air, which has a positive
# life counting down; or the smoke it left, which has a negative one counting
# up from the moment it went off.
#
# There was nowhere else to put that clock. The stride is nine floats and every
# one is spoken for, and widening it reaches the ring, the instance buffer, the
# vertex layout and the wire. `life` is the one field that means nothing once a
# rocket has arrived, so it is what the smoke counts on: the sign says which of
# the two the slot is, and the magnitude says how far through.
fn step_fireball(w, fb, at, dt, decide) =
  held = peek_f32(fb, at + 7)
  if held < 0.0 then linger(fb, at, held, dt) else fly_fireball(w, fb, at, dt, decide)

# Nothing moves. The trail is drawn from the position and the velocity the
# rocket had when it arrived, which are still in the slot and are not touched
# again — that is the whole point of leaving them there.
fn linger(fb, at, held, dt) =
  n = held - dt
  poke_f32(fb, at + 7, if n < 0.0 - smoke_after() then 0.0 else n)
  0

fn fly_fireball(w, fb, at, dt, decide) =
  life = peek_f32(fb, at + 7) - dt
  on = if life > 0.0 then 1.0 else 0.0
  vx0 = peek_f32(fb, at + 3)
  vy0 = peek_f32(fb, at + 4)
  vz0 = peek_f32(fb, at + 5)
  # The same quadratic drag the rounds get. At this speed it barely bites,
  # which is the point: the arc it flies is the one it was aimed along.
  sp = sqrt(vx0 * vx0 + vy0 * vy0 + vz0 * vz0)
  k = 1.0 - 0.00011 * sp * dt * on
  vx = vx0 * k
  vy = vy0 * k - fireball_g() * dt * on
  vz = vz0 * k
  px = peek_f32(fb, at) + vx * dt * on
  py = peek_f32(fb, at + 1) + vy * dt * on
  pz = peek_f32(fb, at + 2) + vz * dt * on
  landed = if py < stop_height(w, px, pz) then 1.0 else 0.0
  # A rocket goes off on the first solid thing it meets, not only on the
  # ground. Without this it flew through a crystal — through the whole stand of
  # them — and cratered the hillside behind, which is not what a warhead does
  # and is not what anybody aiming one expects.
  #
  # A crystal's own fire keeps flying: those are thrown *by* the crystals, and
  # one that took out the next crystal along would have the valley shelling
  # itself. The sign of the seed is what tells the two apart, the same way the
  # renderer does.
  struck = if peek_f32(fb, at + 6) < 0.0 && on > 0.5 && decide > 0 then
    rocket_stop(w, fb, at, peek_f32(fb, at), peek_f32(fb, at + 1), peek_f32(fb, at + 2), px, py, pz)
  else
    0

  # A rocket that struck something keeps the place it struck — `stopped_on`
  # parked it against the stone — rather than being written forward to where
  # the step would have ended. The smoke rises from the wall it hit, and so
  # does the blast below.
  if struck > 0 then 0 else glide(fb, at, px, py, pz)
  poke_f32(fb, at + 3, vx)
  poke_f32(fb, at + 4, vy)
  poke_f32(fb, at + 5, vz)
  # Out of the world is not an arrival: no crater, nothing to hear, just gone.
  away = gone_from_world(px, py, pz)
  # A rocket that arrived leaves its smoke behind: the life goes just negative
  # and starts counting the other way. A crystal's thrown fire does not — that
  # is a stone, and what it leaves is already drawn as the wake it had. Nor
  # does anything that left the world, which is not an arrival at all.
  ended = if landed > 0.5 || struck > 0 then 1.0 else 0.0
  smokes = if ended > 0.5 && peek_f32(fb, at + 6) < 0.0 then 1.0 else 0.0
  poke_f32(fb, at + 7, if smokes > 0.5 then 0.0 - 0.0001 else if ended > 0.5 then 0.0 else if away > 0.5 then 0.0 else life)
  poke_f32(fb, at + 8, peek_f32(fb, at + 8) + dt * on)
  # It touched the ground while it was still flying, or it touched glass: that
  # is an arrival, not an expiry, and only an arrival makes a crater. The
  # crater goes where the slot says the rocket is, which for a strike is the
  # face it struck and not the far side of it.
  if (landed * on > 0.5 || struck > 0) && decide > 0 then add_blast(w, peek_f32(fb, at), peek_f32(fb, at + 1), peek_f32(fb, at + 2), peek_f32(fb, at + 6)) else 0

fn glide(fb, at, px, py, pz) =
  poke_f32(fb, at, px)
  poke_f32(fb, at + 1, py)
  poke_f32(fb, at + 2, pz)
  1

# The rounds' own crystal test, run against a rocket. It works unchanged
# because a fireball and a bullet agree about where the life is — slot 7 in
# both — and `try_break` kills what hit by writing a nought there. So whether
# anything was struck is read back out of the same slot rather than returned
# through another path.
fn rocket_stop(w, fb, at, ax, ay, az, bx, by, bz) =
  hit_crystals(w, fb, at, ax, ay, az, bx, by, bz)
  if peek_f32(fb, at + 7) < 0.001 then 1 else if hits_stone(w, fb, at, ax, ay, az, bx, by, bz) > 0 then 1 else if hits_trunk(w, fb, at, ax, ay, az, bx, by, bz) > 0 then 1 else if hits_fire(w, fb, at, ax, ay, az, bx, by, bz) > 0 then 1 else hits_body(w, fb, at, ax, ay, az, bx, by, bz)

# And a tree is solid too — to a warhead. A rocket aimed square at a trunk
# used to pass through it and crater the hill behind, which put the blast
# outside its own felling reach of the very tree it hit: "I shot the trunk
# and nothing happened", the same wrong the walls had. The trunk is a
# vertical cylinder, forty-five centimetres wide to a warhead and seven
# metres tall; the canopy stays passable, because needles are not armour.
# Rounds still fly through — a bullet through a pine is a bullet that keeps
# going, and nobody has ever complained about that.
fn hits_trunk(w, fb, at, ax, ay, az, bx, by, bz) =
  pb = peek_ptr(w, 65)

  for i in 0..to_int(peek_f32(w, 57))
    trunk_stop(fb, at, pb, i, ax, ay, az, bx, by, bz)

  yes(peek_f32(fb, at + 7) < 0.001)

fn trunk_stop(fb, at, pb, i, ax, ay, az, bx, by, bz) =
  if peek_f32(fb, at + 7) < 0.001 then 0 else if peek_f32(pb, i * 8 + 3) <= 0.01 then 0 else trunk_cross(fb, at, pb, i, ax, ay, az, bx, by, bz)

fn trunk_cross(fb, at, pb, i, ax, ay, az, bx, by, bz) =
  px = peek_f32(pb, i * 8)
  pz = peek_f32(pb, i * 8 + 2)
  dx = bx - ax
  dz = bz - az
  l2 = dx * dx + dz * dz
  n = if l2 < 0.000001 then 1.0 else l2
  t = clampf(((px - ax) * dx + (pz - az) * dz) / n, 0.0, 1.0)
  cx = ax + dx * t
  cz = az + dz * t
  if (cx - px) * (cx - px) + (cz - pz) * (cz - pz) > 0.2 then 0 else trunk_tall(fb, at, pb, i, ay, by, t, cx, cz)

fn trunk_tall(fb, at, pb, i, ay, by, t, cx, cz) =
  g = peek_f32(pb, i * 8 + 1)
  cy = ay + (by - ay) * t
  if cy < g || cy > g + 7.0 then 0
  else
    poke_f32(fb, at, cx)
    poke_f32(fb, at + 1, cy)
    poke_f32(fb, at + 2, cz)
    poke_f32(fb, at + 7, 0.0)
    1

fn hits_fire(w, fb, at, ax, ay, az, bx, by, bz) =
  hit_fire(w, fb, at, at, ax, ay, az, bx, by, bz)
  yes(peek_f32(fb, at + 7) < 0.001)

# ---- shooting the sky down --------------------------------------------------
#
# What a crystal throws is a stone with a flame round it, and a stone can be
# hit. It takes the round with it and comes apart where it was, and the pieces
# fall the rest of the way — which is the difference between a thing you have
# to run from and a thing you can answer.
#
# Only where the world is deciding, and only the crystals' own fire: a rocket
# has a negative seed and is nobody's to shoot out of the air. Which ones went
# is sent, because a client does not know what anybody else's rounds did.
fn meteor_r() = 0.9

fn hit_fire(w, p, at, skip, ax, ay, az, bx, by, bz) =
  fb = peek_ptr(w, 74)

  for i in 0..fireball_cap()
    try_down_fire(w, fb, i, p, at, skip, ax, ay, az, bx, by, bz)
  0

fn try_down_fire(w, fb, i, p, at, skip, ax, ay, az, bx, by, bz) =
  fat = i * fireball_stride()
  if fat == skip then 0 else if peek_f32(fb, fat + 7) <= 0.0 then 0 else if peek_f32(fb, fat + 6) < 0.0 then 0 else if peek_f32(p, at + 7) < 0.001 then 0 else cross_fire(w, fb, i, fat, p, at, ax, ay, az, bx, by, bz)

fn cross_fire(w, fb, i, fat, p, at, ax, ay, az, bx, by, bz) =
  d2 = seg_dist2(ax, ay, az, bx, by, bz, peek_f32(fb, fat), peek_f32(fb, fat + 1), peek_f32(fb, fat + 2))
  if d2 > meteor_r() * meteor_r() then 0
  else
    poke_f32(p, at + 7, 0.0)
    shatter_fire(w, fb, fat)
    note_down(w, i)
    1

# Down and outward, because it was on its way down. Pieces that leapt upward
# would read as something going off; this is something being broken.
fn shatter_fire(w, fb, fat) =
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))

  cs = seg_of(w)
  fill_chunk(cs, peek_f32(fb, fat), peek_f32(fb, fat + 1), peek_f32(fb, fat + 2), 0.5, 0.36, 0.16, 0.07)
  fill_kick(cs, peek_f32(fb, fat + 3) * 0.3, peek_f32(fb, fat + 4) * 0.3 + 2.0, peek_f32(fb, fat + 5) * 0.3)
  sbase = to_float(fat) * 17.3

  for j in 0..9
    spawn_chunk(sb, k0 + j, cs, sbase + to_float(j))

  poke_f32(w, 61, to_float(k0 + 9))
  poke_f32(fb, fat + 7, 0.0)
  1

fn down_ring() = 32

fn note_down(w, i) = ring_push(w, 116, 123, down_ring(), i)

fn fires_down(w: Ptr) -> Int = to_int(peek_f32(w, 123))

fn down_which(w: Ptr, k: Int) -> Int = ring_at(w, 116, down_ring(), k)

# Being told which one went, with no round of our own to have done it.
fn down_fire(w: Ptr, i: Int) =
  fb = peek_ptr(w, 74)
  fat = i * fireball_stride()
  if i < 0 || i >= fireball_cap() then 0 else if peek_f32(fb, fat + 7) <= 0.0 then 0 else shatter_fire(w, fb, fat)

# Stone is solid, and a warhead that flew through a wall to crater the hill
# behind it is the same wrong that flying through a crystal was. The answer is
# read back out of slot 7 the way the others are.
fn hits_stone(w, fb, at, ax, ay, az, bx, by, bz) =
  sweep_walls(w, fb, at, ax, ay, az, bx, by, bz, 1.15)
  yes(peek_f32(fb, at + 7) < 0.001)

# Every wall the segment could reach, and only then the stones in it.
#
# Without this every round in the air tests every stone in the valley on every
# frame, and there are a great many more stones than there were: thirty-two
# rounds against three and a half thousand blocks is a hundred thousand tests a
# frame, for walls almost all of which are on the other side of the map.
# The segment travels in a scratch block on the world rather than as nine
# arguments, and the reason is the native ABI rather than taste. A function
# with more than eight integer or eight floating arguments takes the rest on
# the stack, and a call like that from inside a loop helper miscompiles under
# tailcc: the callee pops the caller's argument space, the caller goes on
# reading its frame at the old offsets, and twelve walls later the return
# address comes off somewhere in the heap. Every test was wasm, where pointers
# are four bytes and nothing spills, so the whole thing looked correct until
# the first rocket flew on the server. Registers only, in this whole chain.
fn seg_of(w) = peek_ptr(w, 118)

# ---- the crystal grid -------------------------------------------------------
#
# Three hundred crystals, none of which ever moves, and every round in the air
# was asking all three hundred on every step: six sphere tests each, eighteen
# hundred a projectile a tick, half of what a step cost. So the valley is cut
# into sixteen by sixteen cells of ten metres once, at init, and a segment asks
# only the cells it could reach.
#
# The layout is one flat buffer: 257 offsets — cell c's crystals are entries
# offs[c] to offs[c+1], the 257th closing the last cell — and then the crystal
# indices themselves. Built by counting, summing, and dealing, which is three
# passes and no sorting.
#
# The walk visits all 256 cell slots and compares each against the query's
# bounds rather than looping the bounds themselves — 256 integer tests cost
# nothing next to the sphere tests they avoid, and it keeps every helper here
# at five or six integer arguments, in registers on both targets. The bounds
# travel as floats in the segment scratch (slots 10-13) for the same reason
# the segment does.
fn crystal_grid(w) = peek_ptr(w, 119)

fn grid_cell(x) = clampi(to_int((x + 80.0) * 0.1), 15)

fn build_crystal_grid(w, cb, nc) =
  gr = crystal_grid(w)
  tmp = alloc_bytes(256 * 4)

  for c in 0..256
    poke_f32(tmp, c, 0.0)

  for ci in 0..nc
    count_into(tmp, cb, ci)

  poke_f32(gr, 0, 0.0)

  for c in 0..256
    poke_f32(gr, c + 1, peek_f32(gr, c) + peek_f32(tmp, c))

  for c in 0..256
    poke_f32(tmp, c, peek_f32(gr, c))

  for ci in 0..nc
    deal_into(gr, tmp, cb, ci)
  1

fn cell_of(cb, ci) = grid_cell(peek_f32(cb, ci * 8)) * 16 + grid_cell(peek_f32(cb, ci * 8 + 2))

fn count_into(tmp, cb, ci) =
  c = cell_of(cb, ci)
  poke_f32(tmp, c, peek_f32(tmp, c) + 1.0)
  1

fn deal_into(gr, tmp, cb, ci) =
  c = cell_of(cb, ci)
  at = to_int(peek_f32(tmp, c))
  poke_f32(gr, 257 + at, to_float(ci))
  poke_f32(tmp, c, to_float(at + 1))
  1

# The query. The segment and the cell bounds are already in the scratch; mode
# says what to do with each crystal found — 0 is a round's break test, 1 is a
# blast's radius test — because the walk is the same walk and a second copy of
# it would drift from the first.
fn grid_walk(w, p, at, mode) =
  for c in 0..256
    walk_cell(w, p, at, mode, c)
  0

fn walk_cell(w, p, at, mode, c) =
  sg = seg_of(w)
  cx = c / 16
  cz = c % 16
  if cx < to_int(peek_f32(sg, 10)) then 0 else if cx > to_int(peek_f32(sg, 11)) then 0 else if cz < to_int(peek_f32(sg, 12)) then 0 else if cz > to_int(peek_f32(sg, 13)) then 0 else cell_entries(w, p, at, mode, c)

fn cell_entries(w, p, at, mode, c) =
  gr = crystal_grid(w)
  e0 = to_int(peek_f32(gr, c))
  e1 = to_int(peek_f32(gr, c + 1))

  for e in e0..e1
    one_entry(w, p, at, mode, e)
  0

fn one_entry(w, p, at, mode, e) =
  sg = seg_of(w)
  ci = to_int(peek_f32(crystal_grid(w), 257 + e))
  if mode == 0 then try_break(w, peek_ptr(w, 66), ci, p, at, peek_f32(sg, 0), peek_f32(sg, 1), peek_f32(sg, 2), peek_f32(sg, 3), peek_f32(sg, 4), peek_f32(sg, 5)) else break_if_near(w, peek_ptr(w, 66), ci, peek_f32(sg, 0), peek_f32(sg, 1), peek_f32(sg, 2))

# Bounds into the scratch: the box round the segment, grown by how far a
# crystal's spheres can reach past its own centre — a charged one swells to
# two and a half times its size.
fn set_grid_bounds(sg, ax, az, bx, bz, reach) =
  lo = if ax < bx then ax else bx
  hi = if ax > bx then ax else bx
  zlo = if az < bz then az else bz
  zhi = if az > bz then az else bz
  poke_f32(sg, 10, to_float(grid_cell(lo - reach)))
  poke_f32(sg, 11, to_float(grid_cell(hi + reach)))
  poke_f32(sg, 12, to_float(grid_cell(zlo - reach)))
  poke_f32(sg, 13, to_float(grid_cell(zhi + reach)))
  1

# A stone knocked out of a wall lies where it fell, and it is still a stone:
# it stops rounds, it stops rockets, it stops a boot, and another warhead can
# break it again. The flying pieces overhead stay what they were — a visual in
# the shard ring, gone when the ring comes round — but the block itself is
# never killed, only moved: down to the ground a deterministic step away,
# four-fifths the size, lying low.
#
# Deterministic, and that is the whole design. A client is told which stone
# went — `w <i>` — and nothing else, so where it lands has to be computable
# from the stone alone: its index and where it stood. Server and every client
# run this same arithmetic and put the same stone in the same place; had the
# rubble followed the flying pieces it would lie somewhere different in every
# browser, and a wall of stones nobody else can see is a valley of invisible
# tripwires. Hashing the position in means a stone broken again rolls to a new
# spot rather than snapping back to the old one.
fn fall_to_ground(bb, i, sc) =
  x0 = block_f(bb, i, 0)
  z0 = block_f(bb, i, 2)
  a = hash2(to_float(i) * 3.1 + x0, z0 * 1.7) * 6.28318
  d = 1.2 + hash2(to_float(i), 77.0) * 1.8
  x = x0 + cos(a) * d
  z = z0 + sin(a) * d
  poke_f32(bb, i * 8, x)
  poke_f32(bb, i * 8 + 1, height(x, z) + sc * 0.3)
  poke_f32(bb, i * 8 + 2, z)
  poke_f32(bb, i * 8 + 3, sc * 0.8)
  1

# A stone that was not hit does not move. There is no settling here and there
# used to be: every break packed its column down, each survivor dropping to sit
# on however many unbroken stones were left below it.
#
# It was the wrong rule, and the way to see it is to put a rocket into the foot
# of a wall. Four courses go, and the four above them — which the warhead never
# reached, which nothing touched — sink four courses into the ground. The wall
# gets shorter. What you shot at was the bottom and what changed was the top,
# which is the one thing a player did not ask for and cannot undo.
#
# These are mortared stones and not a stack of crates. A hole blown through the
# base of a wall leaves the wall standing over it, which is what a wall is: the
# stones above carry across the gap because they are stuck to their neighbours,
# not because there is something under each one. So the hole stays a hole.
#
# The determinism the settling was written for costs nothing now — a client is
# told which stones went and nothing else, and a stone that never moves needs
# no rule at all to end up where everyone else has it.

fn fill_chunk(cs, x, y, z, sc, r, g, b) =
  poke_f32(cs, 0, x)
  poke_f32(cs, 1, y)
  poke_f32(cs, 2, z)
  poke_f32(cs, 3, sc)
  poke_f32(cs, 4, r)
  poke_f32(cs, 5, g)
  poke_f32(cs, 6, b)
  1

fn fill_kick(cs, vx, vy, vz) =
  poke_f32(cs, 7, vx)
  poke_f32(cs, 8, vy)
  poke_f32(cs, 9, vz)
  1

# `wide` is how fat the projectile is against a stone, in multiples of the
# stone's size, and it rides in the scratch with the segment. A round gets
# 0.75 — enough that a shot into the wall cannot thread the corners between
# four stones. A warhead gets 1.15: it is a hand's width of casing with a
# contact fuse, and at 0.75 a rocket aimed at the ragged edge of a hole
# slipped past the outermost stone by a few centimetres, sailed on, and
# cratered the dirt ten metres behind — which read, again, as a wall that
# would not break. Grazing the edge now bursts on the edge. The middle of a
# real hole is still a miss, because it is one.
fn sweep_walls(w, p, at, ax, ay, az, bx, by, bz, wide) =
  sg = seg_of(w)
  poke_f32(sg, 10, wide)
  # Which block answered, for whoever wants the face the round arrived on —
  # `note_mark` does, and a sphere's face is the line out of its centre. The
  # segment scratch is already this round's, and slots 14 and 15 are the two
  # the grid bounds and the width leave alone. Cleared here so a stale index
  # cannot outlive the sweep that set it.
  poke_f32(sg, 14, 0.0 - 1.0)
  poke_f32(sg, 0, ax)
  poke_f32(sg, 1, ay)
  poke_f32(sg, 2, az)
  poke_f32(sg, 3, bx)
  poke_f32(sg, 4, by)
  poke_f32(sg, 5, bz)
  poke_f32(sg, 6, (ax + bx) * 0.5)
  poke_f32(sg, 7, (ay + by) * 0.5)
  poke_f32(sg, 8, (az + bz) * 0.5)
  poke_f32(sg, 9, sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay) + (bz - az) * (bz - az)) * 0.5)
  wb = wall_box(w)
  bb = blocks_ptr(w)

  for k in 0..wall_cap()
    sweep_one_wall(wb, bb, sg, p, at, k)
  0

fn sweep_one_wall(wb, bb, sg, p, at, k) =
  if wall_near(wb, k, peek_f32(sg, 6), peek_f32(sg, 7), peek_f32(sg, 8), peek_f32(sg, 9)) then wall_blocks_hit(bb, k, p, at, sg) else 0

fn wall_blocks_hit(bb, k, p, at, sg) =
  base = k * wall_blocks()

  for j in 0..wall_blocks()
    stop_on_block(bb, base + j, p, at, sg)
  0

fn stop_on_block(bb, i, p, at, sg) =
  if block_live(bb, i) then cross_block(bb, i, p, at, sg) else 0

# A sphere round the block rather than the box itself. A block is very nearly
# as wide as it is tall and the difference is a few centimetres of corner,
# which nobody aiming a rocket is going to miss by.
fn cross_block(bb, i, p, at, sg) =
  ax = peek_f32(sg, 0)
  ay = peek_f32(sg, 1)
  az = peek_f32(sg, 2)
  bx = peek_f32(sg, 3)
  by = peek_f32(sg, 4)
  bz = peek_f32(sg, 5)
  # The factor came down the scratch with the segment: 0.75 for a round —
  # past the corner where four stones meet, with a margin, so a shot into the
  # wall cannot thread between them — and wider for a warhead; see
  # `sweep_walls` for the history both numbers were paid for.
  r = block_f(bb, i, 3) * peek_f32(sg, 10)
  d2 = seg_dist2(ax, ay, az, bx, by, bz, block_f(bb, i, 0), block_f(bb, i, 1), block_f(bb, i, 2))
  if d2 > r * r then 0 else stopped_on(bb, i, p, at, sg)

# Where along the step it happened, not merely that it did. The projectile is
# parked at the nearest point of its path to the stone — within a stone's
# radius of the face it struck — because a step is three and a half metres at
# a rocket's speed and a wall is thirty centimetres thick: a blast placed at
# the end of the step goes off a couple of metres *behind* the wall it hit,
# outside its own reach of the stones, and every so often a direct hit reads
# as a warhead that did nothing.
fn stopped_on(bb, i, p, at, sg) =
  ax = peek_f32(sg, 0)
  ay = peek_f32(sg, 1)
  az = peek_f32(sg, 2)
  dx = peek_f32(sg, 3) - ax
  dy = peek_f32(sg, 4) - ay
  dz = peek_f32(sg, 5) - az
  l2 = dx * dx + dy * dy + dz * dz
  n = if l2 < 0.000001 then 1.0 else l2
  t = clampf(((block_f(bb, i, 0) - ax) * dx + (block_f(bb, i, 1) - ay) * dy + (block_f(bb, i, 2) - az) * dz) / n, 0.0, 1.0)
  poke_f32(p, at, ax + dx * t)
  poke_f32(p, at + 1, ay + dy * t)
  poke_f32(p, at + 2, az + dz * t)
  poke_f32(p, at + 7, 0.0)
  poke_f32(sg, 14, to_float(i))
  1

# The same test for a round, which stops on a wall rather than passing through
# it. It does not take the block with it: a rifle does not knock stone out.
fn hit_stone(w, b, at, ax, ay, az, bx, by, bz) = sweep_walls(w, b, at, ax, ay, az, bx, by, bz, 0.75)

fn hits_body(w, fb, at, ax, ay, az, bx, by, bz) =
  owner = rocket_owner(peek_f32(fb, at + 6))

  for i in 0..player_count(w)
    stop_on_body(fb, at, player_at(w, i), owner, ax, ay, az, bx, by, bz)

  yes(peek_f32(fb, at + 7) < 0.001)

fn stop_on_body(fb, at, s, owner, ax, ay, az, bx, by, bz) =
  if peek_f32(s, 99) == owner then 0
  else if peek_f32(s, 82) < 0.001 then 0
  else if crossed(s, ax, ay, az, bx, by, bz) == 0 then 0
  else
    poke_f32(fb, at + 7, 0.0)
    1

# The same three spheres a round is tested against — a head, a body and the
# legs. Which one it was does not matter here: a rocket is not interested in
# where it hit you.
fn crossed(s, ax, ay, az, bx, by, bz) =
  yes(player_sphere(s, 1.62, 0.3, ax, ay, az, bx, by, bz) > 0.5
      || player_sphere(s, 1.05, 0.42, ax, ay, az, bx, by, bz) > 0.5
      || player_sphere(s, 0.45, 0.36, ax, ay, az, bx, by, bz) > 0.5)

fn step_fireballs(w, fb, dt, decide) =
  for i in 0..fireball_cap()
    step_fireball(w, fb, i * fireball_stride(), dt, decide)

fn clear_fireballs(fb) =
  for i in 0..fireball_cap()
    poke_f32(fb, i * fireball_stride() + 7, 0.0)

fn fireballs(s: Ptr) -> Ptr = peek_ptr(wd(s), 74)

fn fireballs_cap(s: Ptr) -> Int = fireball_cap()

fn bullets(s: Ptr) -> Ptr = peek_ptr(wd(s), 68)

fn bullets_cap(s: Ptr) -> Int = bullet_cap()

# ---- what lives in the lake ------------------------------------------------
#
# One shark, and it is only ever one: a lake this size with a shoal in it is an
# aquarium, and the thing that makes water frightening is that there is
# something in it rather than how many.
#
# It has four states and they are the whole animal. It wanders; it notices you;
# it comes; it bites and thinks better of it. Everything else — the turn rate,
# the fact that it will not leave the water, the way it gives up if you get out
# — falls out of those four and a couple of clamps.
#
# Slots 86..93: x, y, z, heading, mode, mode clock, swim phase, wander target.

fn shark_speed() = 5.2  # metres a second, cruising

fn shark_rush() = 11.5  # and when it has seen you

fn shark_turn() = 1.5  # radians a second it can come round

fn shark_see() = 30.0  # how far it notices someone in the water

fn shark_reach() = 2.6  # how close it has to be to bite

fn shark_bite() = 0.1  # a tenth of you

# It stays in the water and off the bottom. The lake is carved below zero, so
# the ceiling is a little under the surface — a fin breaking the surface would
# give it away to someone standing on the shore, and the whole point of it is
# that you cannot see it from up there.
fn shark_depth(x, z) =
  bed = height(x, z)
  lo = bed + 1.1
  hi = 0.0 - 1.6
  if lo > hi then hi else lo

# Where the water is deep enough to be worth swimming in.
fn deep_at(x, z) = yes(height(x, z) < 0.0 - 2.2)

# Turn toward `want`, no faster than it can. The wrap keeps the difference in
# (-π, π] so it always takes the short way round rather than unwinding the long
# way through three radians.
fn turn_to(cur, want, dt) =
  d0 = want - cur
  d1 = if d0 > 3.14159265 then d0 - 6.28318531 else d0
  d = if d1 < 0.0 - 3.14159265 then d1 + 6.28318531 else d1
  lim = shark_turn() * dt
  cur + (if d > lim then lim else if d < 0.0 - lim then 0.0 - lim else d)

# Somewhere else to be, re-rolled every few seconds. Aimed at the middle of the
# lake rather than anywhere, so it does not spend the whole time nosing the
# shore.
fn wander_angle(x, z, tnow) =
  home = atan2_like(0.0 - x, 0.0 - z)
  home + (hash2(floor(tnow * 0.25), 7.0) - 0.5) * 2.6

# There is no atan2 in this file and the shark is the only thing that wants
# one. Two quadrant tests around the cheap ratio approximation is enough for
# something that only has to point a fish.
fn atan_small(r) = r * (0.7853982 - r * (r - 1.0) * (0.2447 + 0.0663 * r))

fn atan2_like(y, x) =
  ax = if x < 0.0 then 0.0 - x else x
  ay = if y < 0.0 then 0.0 - y else y
  a = if ax > ay then atan_small(ay / (ax + 0.000001)) else 1.5707963 - atan_small(ax / (ay + 0.000001))
  b = if x < 0.0 then 3.14159265 - a else a
  if y < 0.0 then 0.0 - b else b

# Where it wants to be pointed. Backing off is away from you, hunting is at
# you, and wandering is wherever the water is still deep six metres ahead —
# otherwise back toward the middle, which is the whole of its shore avoidance.
fn shark_want(mode, toward, sx, sz, hd, tnow) =
  if mode > 2.5 then toward + 3.14159265 else shark_want2(mode, toward, sx, sz, hd, tnow)

fn shark_want2(mode, toward, sx, sz, hd, tnow) =
  if mode > 0.5 then toward else shark_wander(sx, sz, hd, tnow)

fn shark_wander(sx, sz, hd, tnow) =
  if deep_at(sx + sin(hd) * 6.0, sz + cos(hd) * 6.0) > 0 then wander_angle(sx, sz, tnow) else atan2_like(0.0 - sx, 0.0 - sz)

# The four states, in the order they can reach each other.
fn shark_next(mode, seen, near, clk) =
  if mode < 0.5 then if seen > 0 then 1.0 else 0.0 else shark_next2(mode, seen, near, clk)

fn shark_next2(mode, seen, near, clk) =
  if mode < 1.5 then shark_hunting(seen, near) else shark_next3(mode, clk)

fn shark_hunting(seen, near) =
  if near > 0 then 2.0 else if seen > 0 then 1.0 else 0.0

fn shark_next3(mode, clk) =
  if mode < 2.5 then 3.0 else if clk > 3.4 then 0.0 else 3.0

# How far away somebody in the water is, or as good as infinitely far if they
# are not in it. Standing on the shore is not being seen.
fn swimmer_d2(s, sx, sz) =
  if in_water(s) < 1 then 1000000.0
  else if peek_f32(s, 82) < 0.001 then 1000000.0
  else
    dx = peek_f32(s, 21) - sx
    dz = peek_f32(s, 23) - sz
    dx * dx + dz * dz

# The nearest swimmer within its sight, or -1. It hunts one at a time — a shark
# deciding between two people is a shark doing neither, and the nearest is the
# one it would have run into anyway.
fn nearest_swimmer(w, sx, sz, i, bi, bd) =
  if i == player_count(w) then bi else nearest_or_next(w, sx, sz, i, bi, bd, swimmer_d2(player_at(w, i), sx, sz))

fn nearest_or_next(w, sx, sz, i, bi, bd, d) =
  if d < bd then nearest_swimmer(w, sx, sz, i + 1, i, d) else nearest_swimmer(w, sx, sz, i + 1, bi, bd)

fn shark_step(w, dt, tnow) =
  sx = peek_f32(w, 86)
  sy = peek_f32(w, 87)
  sz = peek_f32(w, 88)
  hd = peek_f32(w, 89)
  mode = peek_f32(w, 90)
  clk = peek_f32(w, 91) + dt

  # Whoever it is after, if anyone. With nobody in the water it keeps its own
  # heading, which is what the wandering state was going to use anyway.
  ti = nearest_swimmer(w, sx, sz, 0, 0 - 1, shark_see() * shark_see())
  seen = if ti < 0 then 0 else 1
  target = if ti < 0 then w else player_at(w, ti)
  px = if ti < 0 then sx + sin(hd) else peek_f32(target, 21)
  pz = if ti < 0 then sz + cos(hd) else peek_f32(target, 23)
  toward = atan2_like(px - sx, pz - sz)

  want = shark_want(mode, toward, sx, sz, hd, tnow)

  hd2 = turn_to(hd, want, dt)
  sp = if mode > 0.5 && mode < 2.5 then shark_rush() else shark_speed()
  nx = sx + sin(hd2) * sp * dt
  nz = sz + cos(hd2) * sp * dt
  # It cannot leave the lake — but "stay put unless the next step is deep" is
  # a trap, because a shark that ever finds itself in the shallows can then
  # never move again, in any direction, for ever. It was spawned in exactly
  # that state and sat there: measured at the same three coordinates across
  # twenty-one samples.
  #
  # The rule that works is asymmetric. In deep water it only moves into deep
  # water; out of it, it always moves, and the steering is already pointing it
  # back at the middle. So the shallows are sticky to enter and never sticky to
  # leave.
  free = if deep_at(sx, sz) < 1 then 1 else deep_at(nx, nz)
  ox = if free > 0 then nx else sx
  oz = if free > 0 then nz else sz
  ny = shark_depth(ox, oz)

  dpx = px - ox
  dpz = pz - oz
  near = yes(dpx * dpx + dpz * dpz < shark_reach() * shark_reach())

  # roam -> charge when it sees you; charge -> bite on contact; bite is one
  # instant; then it turns away for a few seconds before it will come again.
  m2 = shark_next(mode, seen, near, clk)

  # The bite itself, once, on the frame the mode turns over, and only if
  # whoever it was biting is still there to bite.
  bit = yes(mode > 1.5 && mode < 2.5)
  if bit > 0 && ti >= 0 then
    poke_f32(target, 82, clampf(peek_f32(target, 82) - shark_bite(), 0.0, 1.0))
    0
  else 0

  poke_f32(w, 86, ox)
  poke_f32(w, 87, ny)
  poke_f32(w, 88, oz)
  poke_f32(w, 89, hd2)
  poke_f32(w, 90, m2)
  poke_f32(w, 91, if m2 == mode then clk else 0.0)
  # The tail. It beats with the speed, so a charging shark is visibly working.
  poke_f32(w, 92, peek_f32(w, 92) + dt * (1.9 + sp * 0.55))
  # And the jaw, written down rather than asked for: the host reads this block
  # of memory every frame anyway, so putting it here costs nothing and saves a
  # call across the wasm boundary — where `Int` is 64-bit and every index would
  # have to be handed over as a BigInt.
  poke_f32(w, 93, shark_gape(w))
  1

# The tail keeps beating in a valley this browser is not the one thinking
# about. What arrives twenty times a second is where the animal is and what it
# is doing, and nothing at all about its tail — so the beat is run locally, by
# the rule the server runs, with the speed taken from the mode rather than from
# a distance nobody measured here. Without it a shark in a shared valley is a
# model being dragged through the water.
fn swim_on(w: Ptr, dt: Float) =
  sp = if shark_mode(w) > 0.5 then shark_rush() else shark_speed()
  poke_f32(w, 92, peek_f32(w, 92) + dt * (1.9 + sp * 0.55))
  1

# How far the jaw is open: on the approach, wide at the bite, shut on the way
# out — so the mouth is the tell that it has decided about you.
fn shark_gape(w) =
  m = peek_f32(w, 90)
  if m > 2.5 then clampf(1.0 - peek_f32(w, 91) * 1.8, 0.0, 1.0) else if m > 0.5 then 0.85 else 0.0

# ---- where the sun is ------------------------------------------------------
#
# The path the sun runs, which used to live in host.js and is a function of the
# clock and nothing else — so it belongs beside the clock. It was moved because
# a constant that only the page knows is a constant nobody else can agree with:
# the server holds the world time and hands it down, and until this moved there
# was no way for anything but a browser to say where the light was coming from.
# `wt_sun.rill` can ask now, too, which is the other half of the reason.
#
# The circle is tilted eighty-two degrees off the vertical rather than a clean
# ninety, for one arithmetic reason: at exactly ninety the sun passes through
# the zenith, and a light straight overhead has no horizontal component for
# `light_vp` to build its basis from. Eight degrees is invisible and keeps that
# term away from zero — and `light_vp` has a floor of its own as well, because
# a constant in one place guarding a division in another is how a black screen
# at noon gets shipped.
fn sky_tilt() = 1.43116999

# A day, in seconds. Ninety was a good number for somebody who would look at
# this for a minute and a poor one for somebody living in it: the shadows
# visibly crawled and the sun set while you crossed the meadow. Six minutes is
# still nothing like a day and still shows a whole one inside a session.
fn day_secs() = 360.0

# Where in the day it starts. π minus a tenth, which is a tenth of a radian
# past the rising crossing of the *unlifted* circle — cos(θ) < 0 there is what
# makes it the rising side rather than the setting one.
#
# It is not dawn, whatever host.js said about this for years. The lift applies
# at θ as much as anywhere, so a valley opens with the sun a fifth of the way
# up and the shadows already short: mid-morning, not sunrise. `wt_sun.rill`
# measures it and writes the number down.
fn sun_phase() = 3.04159265

# The circle is lifted by half its amplitude, which is the geometry of a wider
# world: the day arc runs long and the sun dips under for exactly a third of
# the turn instead of half. sin(30°) of the amplitude is what splits it 2 to 1
# — solve elevation = A·sin(θ) + A/2 > 0 and θ spends 240 of 360 above.
fn sun_lift() = sin(sky_tilt()) * 0.5

fn sun_theta(w: Ptr) -> Float =
  sun_phase() + world_time(w) * 6.28318531 / day_secs()

# The two directions spanning the plane the sun runs round in are (0,0,1) and
# (cos tilt, -sin tilt, 0), and what comes out of them is where the sun *is*.
# What every caller wants is the other thing — the direction its light travels
# — so these are already negated, and lifted, and of length one.
fn sun_raw_x(w) = 0.0 - cos(sky_tilt()) * sin(sun_theta(w))
fn sun_raw_y(w) = sin(sky_tilt()) * sin(sun_theta(w)) - sun_lift()
fn sun_raw_z(w) = 0.0 - cos(sun_theta(w))

fn sun_len(w) =
  x = sun_raw_x(w)
  y = sun_raw_y(w)
  z = sun_raw_z(w)
  sqrt(x * x + y * y + z * z)

fn sun_x(w: Ptr) -> Float = sun_raw_x(w) / sun_len(w)
fn sun_y(w: Ptr) -> Float = sun_raw_y(w) / sun_len(w)
fn sun_z(w: Ptr) -> Float = sun_raw_z(w) / sun_len(w)

# The one call a frame makes: swing the light to wherever the clock has it and
# rebuild the shadow matrix from there. The host used to do the swinging and
# hand the answer back in; now it asks.
fn step_sun(s: Ptr) =
  w = wd(s)
  light_vp(s, sun_x(w), sun_y(w), sun_z(w))

# ---- the sun's matrix ------------------------------------------------------
#
# The sun. Orthographic view-projection over the whole valley for the shadow
# pass, column-major like everything the GPU reads. `d` is the direction the
# light travels; the shader's "toward the sun" is its negation.
#
# No longer fixed: the world turns, so the direction is an argument and this is
# recomputed every frame from whatever the clock has swung it to. That matters
# more than it sounds like it should — with the matrix baked at load and the
# sky's sun moving, the shadows would keep pointing at where the sun used to
# be, and there would be two suns in the world with only one of them visible.

fn light_vp(s, dx, dy, dz) =
  # The basis is built off the light's horizontal component, so a sun directly
  # overhead has nothing to build it from. The path is set to miss the exact
  # zenith by eight degrees, which keeps this well clear — the floor is here
  # anyway, because a constant in one file protecting a division in another is
  # how a black screen at noon gets shipped.
  hl = clampf(sqrt(dx * dx + dz * dz), 0.02, 1.0)
  rx = 0.0 - dz / hl
  rz = dx / hl
  ux = 0.0 - rz * dy
  uy = rz * dx - rx * dz
  uz = rx * dy
  inv = 1.0 / 320.0
  poke_f32(s, 32, rx / 115.0)
  poke_f32(s, 33, ux / 115.0)
  poke_f32(s, 34, dx * inv)
  poke_f32(s, 35, 0.0)
  poke_f32(s, 36, 0.0)
  poke_f32(s, 37, uy / 115.0)
  poke_f32(s, 38, dy * inv)
  poke_f32(s, 39, 0.0)
  poke_f32(s, 40, rz / 115.0)
  poke_f32(s, 41, uz / 115.0)
  poke_f32(s, 42, dz * inv)
  poke_f32(s, 43, 0.0)
  poke_f32(s, 44, 0.0)
  poke_f32(s, 45, 0.0)
  poke_f32(s, 46, 149.0 * inv)
  poke_f32(s, 47, 1.0)

# ---- building the world ----------------------------------------------------

# The world at whatever resolution the machine can afford: the host measures
# what the GPU keeps up with and asks again. The terrain function is the same
# at every grid size, so a denser mesh is the same valley drawn finer, and
# the physics — which sample the function, not the mesh — never notice.
# Nought where the pull is kept means "whatever this valley has always used",
# which is what `gravity` reads it as. Cleared here, at the one moment the
# world block comes out of the allocator, and never again: `reset_world` runs
# at every round change and a planet does not change its mind that often.
fn init(grid: Int, npine: Int, ncrys: Int, ngrass: Int) -> Ptr =
  # A kilobyte for what wasm fits in four hundred bytes. A slot number means a
  # different byte offset for a pointer than for a number once pointers are
  # eight bytes wide, so the same layout reaches twice as far on a 64-bit
  # machine as it does under wasm — and the server is a 64-bit machine. It was
  # 512, which is exactly enough for the wasm build and writes off the end of
  # the allocation for the native one.
  s = alloc_bytes(1024)
  # `alloc_bytes` hands back whatever was there. Every slot the world reads
  # before something writes it has to be cleared here — 250 always was, and
  # the pick brought three more: the two sent-up-to cursors and the hosted
  # flag, which as inherited garbage once read "somebody else's valley" and
  # quietly refused every swing this browser made in its own.
  poke_f32(s, 250, 0.0)
  poke_f32(s, 253, 0.0)
  poke_f32(s, 254, 0.0)
  poke_f32(s, 255, 0.0)
  m = alloc_bytes(grid * grid * 54 * 4)
  pine_buf = alloc_bytes(npine * 32)
  # A third as many poplars as pines, and no number of its own on the wire:
  # both ends work it out from the pine count they were already told, and the
  # placement is the same deterministic walk over the same hash. A valley that
  # agrees about its pines agrees about its poplars for nothing.
  poplar_buf = alloc_bytes(poplar_cap(npine) * 32)
  flower_buf = alloc_bytes(flower_cap(npine) * 32)
  crystal_buf = alloc_bytes(ncrys * 32)
  grass_buf = alloc_bytes(ngrass * 32)
  # A pool is a count and a stride, and every one of them was spelling out
  # the same multiplication by four.
  fn pool(cap, stride) = alloc_bytes(cap * stride * 4)

  bullet_buf = pool(bullet_cap(), bullet_stride())
  shard_buf = pool(shard_cap(), shard_stride())
  fire_buf = pool(fireball_cap(), fireball_stride())
  charge_buf = pool(charger_cap(), charger_stride())
  blast_buf = pool(blast_cap(), blast_stride())
  break_buf = alloc_bytes(break_ring() * 4)
  # Room for what gets built as well as what was placed: the walls' own
  # blocks first, and `built_cap` more behind them for the players'.
  block_buf = alloc_bytes((block_cap() + built_cap()) * 32)
  face_buf = pool(face_cap(), face_stride())
  poke_ptr(s, 85, face_buf)
  carve_buf = cleared(carve_bytes())
  # The page table rides along, its pointer in the buffer's own first slot.
  # Sized for eight-byte pointers on either target, zeroed the same way.
  page_tab = cleared(super_n() * super_n() * 8)

  poke_ptr(carve_buf, 0, page_tab)
  # An empty dirty rect is minx above maxx.
  poke_f32(carve_buf, 4, 1.0)
  poke_f32(carve_buf, 6, 0.0)
  gone_buf = alloc_bytes(block_ring() * 4)
  mark_buf = alloc_bytes(block_cap() * 4)
  down_buf = alloc_bytes(down_ring() * 4)
  wallbox_buf = alloc_bytes(wall_cap() * 4 * 4)
  seg_buf = alloc_bytes(64)
  grid_buf = alloc_bytes((257 + ncrys + 1) * 4)
  ghost_buf = alloc_bytes(ghost_cap() * 3 * 4)
  hurt_buf = alloc_bytes(hurt_ring() * 4 * 4)
  fell_buf = alloc_bytes(fell_ring() * 4)
  zap_buf = alloc_bytes(zap_ring() * 2 * 4)
  glass_buf = alloc_bytes(ncrys * 4)
  mark_buf2 = alloc_bytes(mark_ring() * 8 * 4)
  step = cell_step(grid)
  hs = buf_float((grid + 1) * (grid + 1))
  gen_heights(hs, grid, step)
  gen_cells(m, hs, grid, step)
  np = place(pine_buf, 0, 0, npine, 20000, 0)
  nc = place(crystal_buf, 0, 0, ncrys, 20000, 1)
  ng = place(grass_buf, 0, 0, ngrass, 20000, 2)
  npo = place(poplar_buf, 0, 0, poplar_cap(npine), 20000, 3)
  nfl = sow_flowers(flower_buf, 0, 0, flower_patches(npine), 20000)
  rock_buf = alloc_bytes(rock_cap() * 32)
  nrk = place_rocks(rock_buf, 0, 0)
  poke_ptr(s, 64, m)
  poke_ptr(s, 65, pine_buf)
  poke_ptr(s, 70, poplar_buf)
  poke_ptr(s, 71, flower_buf)
  poke_ptr(s, 99, rock_buf)
  poke_ptr(s, 66, crystal_buf)
  poke_ptr(s, 67, grass_buf)
  poke_ptr(s, 68, bullet_buf)
  poke_ptr(s, 69, shard_buf)
  poke_ptr(s, 106, ghost_buf)
  poke_ptr(s, 113, hurt_buf)
  poke_ptr(s, 114, block_buf)
  poke_ptr(s, 115, gone_buf)
  poke_ptr(s, 116, down_buf)
  poke_ptr(s, 117, wallbox_buf)
  poke_ptr(s, 118, seg_buf)
  poke_ptr(s, 119, grid_buf)
  poke_ptr(s, 120, mark_buf)
  poke_ptr(s, 76, fell_buf)
  poke_ptr(s, 78, zap_buf)
  poke_ptr(s, 83, glass_buf)
  poke_ptr(s, 75, mark_buf2)
  poke_ptr(s, 74, fire_buf)
  poke_ptr(s, 77, charge_buf)
  poke_ptr(s, 81, blast_buf)
  poke_ptr(s, 97, break_buf)
  poke_ptr(s, 84, carve_buf)
  poke_f32(s, 60, 0.0)
  poke_f32(s, 61, 0.0)
  poke_f32(s, 62, 0.0)
  poke_f32(s, 63, 0.0)
  poke_f32(s, 73, 0.0)
  poke_f32(s, 79, 1.0)
  poke_f32(s, 80, 0.0)
  poke_f32(s, 93, 0.0)
  poke_f32(s, 55, 0.0)
  poke_f32(s, 95, 0.0)
  # The meteors, off. `set_meteors` is what puts them back.
  poke_f32(s, 53, 0.0)
  clear_bullets(bullet_buf)
  clear_marks_ring(mark_buf2)
  clear_shards(shard_buf)
  # After the clearing, because the magazines live in the same buffer and are
  # the one thing in it that is there from the start.
  build_crystal_grid(s, crystal_buf, nc)
  clear_marks(s)
  place_walls(s, block_buf)
  place_mags(s)
  clear_fireballs(fire_buf)
  clear_chargers(charge_buf)
  clear_blasts(blast_buf)
  poke_f32(s, 54, to_float(grid))
  poke_f32(s, 56, to_float(grid * grid * 6))
  poke_f32(s, 57, to_float(np))
  poke_f32(s, 252, to_float(npo))
  poke_f32(s, 251, to_float(nfl))
  poke_f32(s, 249, to_float(nrk))
  poke_f32(s, 58, to_float(nc))
  poke_f32(s, 59, to_float(ng))
  # Everything the walls, the wire rings and the round keep, set to nought
  # rather than left to whatever the allocator handed over. `alloc_bytes` does
  # not promise zeros, and slot 129 is the round's phase: one bit of rubbish in
  # it and a brand new valley opens on ROUND OVER with a counter that never
  # reaches nought, because the twenty seconds it is counting started before
  # the world existed. Which is exactly what shipped.
  poke_f32(s, 122, 0.0)
  poke_f32(s, 123, 0.0)
  poke_f32(s, 124, 0.0)
  poke_f32(s, 125, 0.0)
  poke_f32(s, 126, 0.0)
  poke_f32(s, 127, 0.0)

  # The world points at itself, so `wd` works on it exactly as it works on a
  # player and nothing below has to ask which kind of block it was given. It
  # starts with nobody in it: even the browser with the valley to itself asks
  # for a player, because that is the same call the eighth arrival makes.
  poke_ptr(s, 94, s)
  poke_ptr(s, 96, alloc_bytes(player_cap() * 8))
  poke_f32(s, 98, 0.0)
  poke_f32(s, 100, 0.0)
  # In the deepest water there is. The lake bottoms out around (-2, -2) at nine
  # metres, and starting it anywhere shallower is starting it aground.
  poke_f32(s, 86, 0.0 - 2.0)
  poke_f32(s, 87, 0.0 - 4.0)
  poke_f32(s, 88, 0.0 - 2.0)
  poke_f32(s, 89, 1.2)
  set_sun(s, 0.58, 0.0 - 0.62, 0.0 - 0.52)
  s

# ---- the pickaxe, the carve field, and the magma under it -------------------
#
# The rock can be dug. Not the meadow and not the lake bed — the bare stone
# above the treeline, the one band of this valley with nothing living on it —
# and what a swing takes out of the hillside goes into a pocket as stones,
# which is what the walls further down are built back out of.
#
# The ground is a height field, so what digging changes is a second field laid
# over the first: a lattice of cells across the whole valley, each carrying
# how many stones have come out of it. A swing takes exactly one, and a stone
# is a cube of `block_size()` — thirty centimetres, the same stone the walls
# are built of. That is the whole scale of the thing: what the pick takes out
# and what a wall is made of are one object, so a hole in the hillside is
# measured in the units of the courses somebody stacks beside it. A cell was
# a metre once, which made one swing take twenty-seven stones of hillside in
# a single blow and made the tool read as a charge rather than a pick.
#
# Because both ends run the same base function and replay the same carve
# events, the two agree about the new ground the way they already agree about
# the old one.
#
# The field is sparse, because the valley mostly is not dug. The 568 x 568
# cells are grouped into 324 patches of 32 x 32 cells — nine and a half
# metres square — and a patch has no storage at all until somebody digs in
# it, when it gets a kilobyte page allocated on the spot and pointed at from
# a table. Sixty-four players over a whole match touch a few dozen patches; a
# pristine valley pays for none of them. The wire's door message walks the
# same pages, so what a newcomer downloads is proportional to what was dug
# rather than to the size of the map.
#
# There is a bottom. Thirty stones down is nine metres, and there the cell
# becomes magma: the floor stops falling, the pit glows, and standing in it
# burns. A cap with nothing under it would just be a rule; a cap with magma
# under it is a place.
#
# The buffer at world ptr 84, all offsets in one place:
#
#   ptr  0   the page table: 324 pointers, one per patch, live only where
#            the dir below says so
#   f32  2   how many bites have ever been dug — the carve ring's cursor
#   f32  3   how many cells have turned to magma
#   f32  4..7  dirty rect in world metres (minx, minz, maxx, maxz; 4 > 6 empty)
#   f32  8..11 the same rect in this build's mesh cells, written by rebake
#   f32  12  how many blocks have ever been built — the build ring's cursor
#   f32  13  how many pages have been allocated
#   u8   bytes 64..387        page dir: 1 where a patch has a page
#   i32  98..609              magma list: 512 x cell index
#   i32  610..705             carve ring: 96 x cell index
#   f32  706..865             build ring: 32 x (slot, x, y, z, yaw)

# One cell is one stone of the wall, and the field is the valley plus the
# rounding: 568 of them at thirty centimetres is 170.4 m across.
fn carve_q() = block_size()

fn carve_n() = 568

fn carve_org() = 85.2

fn carve_bytes() = 3584

fn page_side() = 32

# Sixteen bytes a column, because a column is no longer a number — it is a
# hundred and twenty-eight bits, one for each thirty-centimetre slab of world
# between four metres under the lake and thirty-four above it, saying whether
# that slab has been taken out.
#
# This is the change that makes it a digging engine rather than a quarrying
# one. A single depth per column can only ever mean "this whole column is cut
# down to here": strike a wall at chest height and the only thing the field
# can express is the column dropping from the top, which is why hitting the
# rock above you made the ground under you fall away. A bit per slab can say
# "this bit of the wall is gone and the roof over it is not", and that is a
# tunnel, an overhang, a doorway and a cave.
fn vox_bytes() = 16

fn vox_slabs() = 128

fn vox_y0() = 0.0 - 4.0

fn page_bytes() = page_side() * page_side() * vox_bytes()

fn super_n() = 18

# How far under the original ground the rock can be taken at all. Below this
# is bedrock: it does not come out, whatever it is struck with.
fn dig_floor() = 12.0

fn slab_of(y) = to_int(floor((y - vox_y0()) / carve_q()))

fn slab_y(k) = vox_y0() + to_float(k) * carve_q()

# Twelve metres down the rock stops being rock: either it is bedrock, which
# nothing gets through, or it is the roof of something molten. Which one it is
# depends on where you are standing — magma used to be the floor under *every*
# hole in the valley, which made the deepest thing in this world the least
# interesting. Now most shafts bottom out on stone and stop, and a few break
# through.
# Where the molten ground is. A slow field over the valley — patches a good
# thirty metres across, so it is a place you are in or out of rather than a
# speckle — thresholded high enough that most of the rock band has plain
# bedrock under it. Both ends compute it from the same two numbers they
# already agree about, so nothing about it crosses the wire.
fn magma_under(x, z) =
  n = vnoise(x * 0.031 + 17.0, z * 0.031 + 5.0) * 0.7 + vnoise(x * 0.077, z * 0.077 + 23.0) * 0.3
  n > 0.68

fn magma_cap() = 512

fn rock_line() = 9.5       # where the pines stop is where the digging starts

# `alloc_bytes` is malloc: it hands back whatever was in that memory last.
# Anything read before it is written wants this instead.
fn cleared(n) =
  p = alloc_bytes(n)

  for i in 0..n / 4
    poke_i32(p, i, 0)

  p

fn cv(w) = peek_ptr(w, 84)

fn carves(w: Ptr) -> Int = to_int(peek_f32(cv(w), 2))

fn magmas(w: Ptr) -> Int = to_int(peek_f32(cv(w), 3))

fn built(w: Ptr) -> Int = to_int(peek_f32(cv(w), 12))

fn carve_ring() = 96

fn build_ring() = 32

fn carve_ring_at(k) = 610 + k % carve_ring()

fn cr_put(cb, k, ci) =
  poke_i32(cb, carve_ring_at(k), ci)
  1

fn cr_get(cb, k) = peek_i32(cb, carve_ring_at(k))

fn build_ring_at(k) = 706 + k % build_ring() * 5

# The one place a world metre becomes a cell number. Everything that digs,
# stands, falls or draws comes through here, so there is one grid rather than
# two that nearly agree.
fn cell_ix(v) = to_int(floor((v + carve_org()) / carve_q()))

# A cell by its world position, or -1 outside the field.
fn carve_cell(x, z) = cell_at(cell_ix(x), cell_ix(z))

fn cell_x(i) = to_float(i % carve_n()) * carve_q() - carve_org() + carve_q() * 0.5

fn cell_z(i) = to_float(i / carve_n()) * carve_q() - carve_org() + carve_q() * 0.5

# Which patch a cell is in, and where inside its page.
fn super_of(i) = i / carve_n() / page_side() * super_n() + i % carve_n() / page_side()

fn cell_in(i) = i / carve_n() % page_side() * page_side() + i % carve_n() % page_side()

fn page_new(cb, sx) =
  pg = cleared(page_bytes())

  poke_ptr(peek_ptr(cb, 0), sx, pg)
  poke_i8(cb, 64 + sx, 1)
  poke_f32(cb, 13, peek_f32(cb, 13) + 1.0)
  pg

fn page_of(cb, sx) =
  if peek_u8(cb, 64 + sx) > 0 then peek_ptr(peek_ptr(cb, 0), sx)
  else page_new(cb, sx)

# One byte of a column's mask. The dir byte answers the common case — this
# patch was never dug — in one read, without touching the page table.
fn col_byte(cb, i, b) =
  if i < 0 then 0
  else if peek_u8(cb, 64 + super_of(i)) == 0 then 0
  else peek_u8(peek_ptr(peek_ptr(cb, 0), super_of(i)), cell_in(i) * vox_bytes() + b)

fn col_put_byte(cb, i, b, val) =
  poke_i8(page_of(cb, super_of(i)), cell_in(i) * vox_bytes() + b, val)
  1

fn bit_of(k) = shl(1, k % 8)

# Has the slab `k` of column `i` been taken out?
fn vox_gone(cb, i, k) =
  if k < 0 || k >= vox_slabs() then 0
  else yes(bit_and(col_byte(cb, i, k / 8), bit_of(k)) != 0)

fn vox_take(cb, i, k) =
  b = k / 8
  old = col_byte(cb, i, b)
  if bit_and(old, bit_of(k)) != 0 then 0
  else
    col_put_byte(cb, i, b, bit_or(old, bit_of(k)))
    1

# Anything at all out of this column?
fn col_any(cb, i) = ca_go(cb, i, 0)

fn ca_go(cb, i, b) =
  if b >= vox_bytes() then 0
  else if col_byte(cb, i, b) > 0 then 1
  else ca_go(cb, i, b + 1)

# For the door: which patches have pages, and how many. The server's welcome
# message walks these instead of the whole lattice.
fn carve_page_at(w: Ptr, sx: Int) -> Int = peek_u8(cv(w), 64 + sx)

fn carve_pages(w: Ptr) -> Int = to_int(peek_f32(cv(w), 13))

# How many patches there are, and how many cells in each: the wire's door
# message walks both and neither is a number it should be told twice.
fn carve_supers() -> Int = super_n() * super_n()

fn carve_page_cells() -> Int = page_side() * page_side()

# A cell of a patch, by its number inside the page. The patch grid overhangs
# the world — 18 x 32 is 576 against 568 cells — so the last columns and rows
# of the edge patches are outside the valley and answer nought.
fn page_cell(sx, c) =
  ix = sx % super_n() * page_side() + c % page_side()
  iz = sx / super_n() * page_side() + c / page_side()
  cell_at(ix, iz)

# What the door sends: a column's mask, byte by byte, and whether it is worth
# sending at all.
fn carve_col_any(w: Ptr, sx: Int, c: Int) -> Int = col_any(cv(w), page_cell(sx, c))

fn carve_col_byte(w: Ptr, sx: Int, c: Int, b: Int) -> Int = col_byte(cv(w), page_cell(sx, c), b)

fn ap_carve_col(w: Ptr, sx: Int, c: Int, b: Int, val: Int) =
  i = page_cell(sx, c)
  if i < 0 then 0
  else
    col_put_byte(cv(w), i, b, val)
    1

fn carve_col_bytes() -> Int = vox_bytes()

# Once a whole column has arrived, the ground it stands on has to be redrawn.
fn ap_carve_col_done(w: Ptr, sx: Int, c: Int) =
  i = page_cell(sx, c)
  if i < 0 then 0
  else
    cb = cv(w)
    if magma_under(cell_x(i), cell_z(i)) && vox_gone(cb, i, slab_of(height(cell_x(i), cell_z(i)) - dig_floor() + carve_q() * 0.5)) > 0 then note_magma(cb, i) else 0
    dirty_grow(cb, cell_x(i), cell_z(i), 1.5)
    1

# ---- what is rock and what is air -------------------------------------------
#
# The one question the whole engine asks. Above the original ground: air, and
# always was. Below the bedrock line: rock, and nothing takes it out. Between
# the two it is rock unless somebody has taken that slab.
fn solid_at(w, x, y, z) =
  h = height(x, z)
  if y >= h then 0
  else if y < h - dig_floor() then 1
  else
    i = carve_cell(x, z)
    if i < 0 then 1
    else if vox_gone(cv(w), i, slab_of(y)) > 0 then 0
    else 1

fn solid_cell(cb, i, k, h) =
  y = slab_y(k)
  if y >= h then 0
  else if y < h - dig_floor() then 1
  else if vox_gone(cb, i, k) > 0 then 0
  else 1

# The top of the rock in a column: the original ground, unless slabs have been
# taken out of the top of it, in which case the first one still standing.
fn top_solid(w, x, z) =
  h = height(x, z)
  i = carve_cell(x, z)
  cb = cv(w)
  if i < 0 then h
  else if col_any(cb, i) == 0 then h
  else ts_down(cb, i, h, slab_of(h - 0.001))

# Never above the ground. A slab's ceiling is where the rock in it stops, and
# for every slab but one that is below the hillside; the exception is the slab
# the ground itself falls inside, whose ceiling is up in the air. Returning it
# put the top of the rock a quarter of a metre over the top of the hill —
# measured, 23.00 against a hillside at 22.75 — and everything that reads
# `floor_at` believed it: the terrain lattice rose into a bump there, a body
# stood on nothing, and the drawn faces, which take a column's height from its
# own centre, did not follow any of it. That last disagreement is what you
# could see through.
#
# It was hidden for as long as a bite was four stones across, because a hole
# that wide always took the slab the ground was in and the walk went past it.
# A one-stone bite on a slope leaves a sliver at the up-hill edge of every dug
# column where it does not.
fn ts_down(cb, i, h, k) =
  if k < 0 then h - dig_floor()
  else if solid_cell(cb, i, k, h) > 0 then (if slab_y(k + 1) > h then h else slab_y(k + 1))
  else ts_down(cb, i, h, k - 1)

# What is under your feet: the top of the first rock at or below `y`. This is
# what a cave is made of — the answer depends on where you are, not only on
# where you are standing over.
fn ground_under(w, x, y, z) =
  h = height(x, z)
  i = carve_cell(x, z)
  cb = cv(w)
  if i < 0 then h
  else if col_any(cb, i) == 0 then h
  else if y >= h then top_solid(w, x, z)
  else ts_down(cb, i, h, slab_of(y - 0.001))

# And what is over your head: the underside of the first rock above `y`, or
# the sky.
fn roof_over(w, x, y, z) =
  h = height(x, z)
  i = carve_cell(x, z)
  cb = cv(w)
  if i < 0 || col_any(cb, i) == 0 || y >= h then 9999.0
  else ro_up(cb, i, h, slab_of(y) + 1)

fn ro_up(cb, i, h, k) =
  if k >= vox_slabs() || slab_y(k) >= h then 9999.0
  else if solid_cell(cb, i, k, h) > 0 then slab_y(k)
  else ro_up(cb, i, h, k + 1)

# The carved depth under (x, z): the deepest of the four cells around it, and
# no blending at all.
#
# Blending was what made every hole round. Four cell depths mixed by where
# the point falls between them is, by construction, a smooth surface — so a
# one-metre step became a one-metre ramp and a square pit came out a bowl.
# Taking the deepest instead gives a floor that is flat across a cell and
# drops in one go at its edge, which is the terraced, square-cut quarry the
# tool actually makes.
#
# One cell, the one the point stands in, by the same arithmetic `carve_cell`
# uses to decide what a swing hits. Everything that walks, falls, aims and
# lands reads this, so where you can stand and where you can dig are the same
# question asked once.
# What the terrain mesh draws: how far the *top* of a column has come down.
# A tunnel under standing rock does not change this at all, which is right —
# from outside, a hill with a tunnel in it is still a hill.
fn carve_depth(w, x, z) = height(x, z) - top_solid(w, x, z)

fn cell_at(ix, iz) =
  if ix < 0 || iz < 0 || ix >= carve_n() || iz >= carve_n() then 0 - 1 else iz * carve_n() + ix

# The ground with the digging in it. `height` stays pure and everything that
# places a forest keeps reading it; what stands, walks, falls and lands reads
# this.
fn floor_at(w, x, z) = height(x, z) - carve_depth(w, x, z)

# Is the dirty rect empty? Its two x's, and only its two x's: an empty rect
# is marked by minx above maxx, and asking whether minx is above *maxz* is
# asking whether a number of metres east beats a number of metres north.
# That is what this used to ask. It read "clean" for every dig in the
# quadrant where x runs positive and z runs negative — a quarter of the
# valley where the pick paid stones, the floor dropped under your feet and
# the mesh was never told, so the ground you fell into still looked whole.
fn dirty_none(cb) = peek_f32(cb, 4) > peek_f32(cb, 6)

fn dirty_clear(cb) =
  poke_f32(cb, 4, 1.0)
  poke_f32(cb, 6, 0.0)
  1

# The dirty rect, grown to take (x, z) and a margin. World metres, because the
# mesh grid differs by tier and the rect cannot know who will read it.
fn dirty_grow(cb, x, z, m) =
  if dirty_none(cb) then
    poke_f32(cb, 4, x - m)
    poke_f32(cb, 5, z - m)
    poke_f32(cb, 6, x + m)
    poke_f32(cb, 7, z + m)
    1
  else
    poke_f32(cb, 4, min(peek_f32(cb, 4), x - m))
    poke_f32(cb, 5, min(peek_f32(cb, 5), z - m))
    poke_f32(cb, 6, max(peek_f32(cb, 6), x + m))
    poke_f32(cb, 7, max(peek_f32(cb, 7), z + m))
    1

# ---- one bite ----------------------------------------------------------------
#
# Everything below runs from a cell index and nothing else, which is the whole
# of how the wire stays small: a bite is four bytes on the ring, and both ends
# open the same square from them.
#
# The bite is two stones on a side — six tenths of a metre, eight wall blocks.
#
# It was four stones, which is sixty-four blocks, and a tool whose every use
# removes sixty-four times the valley's other stone unit does not read as a
# pick; it reads as a shovel with the ground on easy. Then it was one, which
# reads right but digs like a needle. Two is the shape that says "a bite" and
# still moves rock.
#
# Two is even, so the square cannot be centred on the struck stone: across and
# along it runs from the stone struck to the one after. Downward it does not
# straddle either — the cube hangs from the strike, taking the slab struck and
# the one under it. That last word is the whole of the difference from an
# earlier version that took four *down from the top of the column*: strike a
# wall at chest height and everything above the strike came away too, which
# from inside a shaft read as the ground collapsing rather than the wall
# breaking. The rock above a strike is exactly what has to stay if a wall is
# going to open into a tunnel.
#
# What two stones does not answer: nobody fits down a shaft six tenths of a
# metre across either. See `mine_reach`, which is the whole of how deep a pit
# can get, because a digger cannot climb into their own.
fn dig_lo() = 0

fn dig_hi() = 1

fn dig_dn() = 0 - 1

fn dig_up() = 0

# A slab of one column, if there is anything there to take. Bedrock is not,
# and neither is air.
fn dig_one(cb, i, k, h) =
  if i < 0 then 0
  else if solid_cell(cb, i, k, h) == 0 then 0
  else
    got = vox_take(cb, i, k)
    # The bottom slab of a column is the roof of whatever is under it. Where
    # the field says something molten, taking it opens the roof.
    if got > 0 && slab_y(k - 1) < h - dig_floor() && magma_under(cell_x(i), cell_z(i)) then note_magma(cb, i) else 0
    got

# The cube, as the three counted walks it is. A loop that carries something
# says so — `with got` — and the count comes back out of the loop rather than
# down a chain of accumulator parameters.
fn dig_square(cb, ix, iz, k0) =
  for dz in dig_lo()..dig_hi() + 1 with got = 0
    got + dig_row(cb, ix, iz + dz, k0)

fn dig_row(cb, ix, iz, k0) =
  for dx in dig_lo()..dig_hi() + 1 with got = 0
    got + dig_col(cb, cell_at(ix + dx, iz), k0)

fn dig_col(cb, i, k0) =
  if i < 0 then 0
  else
    h = height(cell_x(i), cell_z(i))
    if h < rock_line() then 0
    else
      for dk in dig_dn()..dig_up() + 1 with got = 0
        got + dig_one(cb, i, k0 + dk, h)

# A cell that has just burned through. Once, ever — dig_write only comes this
# way on the crossing itself — so the list never carries a cell twice.
fn note_magma(cb, i) =
  n = to_int(peek_f32(cb, 3))
  if n >= magma_cap() then 0
  else
    poke_i32(cb, 98 + n, i)
    poke_f32(cb, 3, to_float(n + 1))
    1

fn magma_cell(w, k) = peek_i32(cv(w), 98 + k)

# Is this column open onto the magma? Its lowest diggable slab gone, and the
# field saying there is something under it.
fn col_magma(cb, i) =
  if i < 0 then 0
  else
    x = cell_x(i)
    z = cell_z(i)
    if magma_under(x, z) == false then 0
    else if vox_gone(cb, i, slab_of(height(x, z) - dig_floor() + carve_q() * 0.5)) > 0 then 1
    else 0

# The bite, from its ring entry. Returns the stones that came out — one, or
# nought where the cell is already magma or the ground under it is not rock.
# There used to be four chips of rock thrown out of every crater here. They
# flew through the shard pool, which draws crystal fragments — and from the
# swinging end they read as the pick *making* crystals, which is a worse
# story than no chips at all. The hole and the dug tint carry the feedback.
# A bite carries where as well as what: the column and the slab, packed into
# the one number the ring and the wire already had room for. A cell is under
# nineteen bits and a slab is seven, which is twenty-six of a thirty-two-bit
# word — so a swing still costs the wire four bytes and still replays the
# same way at both ends.
fn bite_code(i, k) = i * vox_slabs() + k

# What was standing on the rock a bite just took. A pine rooted in it comes
# down and a crystal growing out of it breaks — through the same rings the
# rest of the valley already uses, so a client is told about it the way it is
# told about a warhead's felling.
#
# The boxes fall of their own accord, because a box is a thing that falls;
# these two are rooted, and rooted things do not sink quietly into a hole.

# One blade, gone. A `poke` is Unit and the arm it stands against is Int, so
# the taking-out gets a name rather than the branches getting a cast.
fn cut_grass(gb, gat) =
  poke_f32(gb, gat + 3, 0.0)
  1

# How wide a bite is, and how far from the middle of one a thing has to be to
# have been standing on it — the square of that, because that is how it is
# asked. Both come off the bite's own bounds rather than being written down,
# which they used to be: the reach was 0.8, and 0.8 is the half-diagonal of a
# cube four stones across. Shrink the bite and leave the literal and a swing
# that takes three tenths of a metre of rock clears the grass off a metre and
# three quarters of hillside — a chip out of a wall, and a bald patch you could
# see from the lake. The margin on the end is a stone's half-width: what stands
# on the edge of the bite stands half in it.
fn bite_side() = to_float(dig_hi() - dig_lo() + 1) * carve_q()

fn undermine_r2() =
  r = bite_side() * 0.70710678 + carve_q() * 0.5
  r * r

fn undermine(w, x, z) =
  # A pine comes down when the rock it is rooted in goes, and its roots are the
  # width of the bite and not the width of a warhead's blast.
  fell_scan(w, x, floor_at(w, x, z) + 1.0, z, sqrt(undermine_r2()))
  # The grass goes with the ground it grew in. A blade standing in the middle
  # of a shaft is the same floating-scenery bug the boxes had, in miniature —
  # and nothing about a tuft of grass wants a falling animation, so it is
  # simply not there any more. Size to nought, which is how a crystal and a
  # wall block leave too, and the renderer stops drawing it.
  gb = peek_ptr(w, 67)
  floor = floor_at(w, x, z)
  r2 = undermine_r2()

  for i in 0..to_int(peek_f32(w, 59))
    gat = i * 8
    gx = peek_f32(gb, gat) - x
    gz = peek_f32(gb, gat + 2) - z
    if gx * gx + gz * gz < r2 && peek_f32(gb, gat + 1) > floor + 0.4 then cut_grass(gb, gat) else 0

  cb = peek_ptr(w, 66)

  for i in 0..to_int(peek_f32(w, 58))
    at = i * 8
    dx = peek_f32(cb, at) - x
    dz = peek_f32(cb, at + 2) - z
    rooted = dx * dx + dz * dz < r2 && peek_f32(cb, at + 3) > 0.01
    if rooted && peek_f32(cb, at + 1) > floor + 0.6 then break_crystal(w, cb, at, i) else 0

  1

fn apply_carve(w, code) =
  cb = cv(w)
  ci = code / vox_slabs()
  k = code % vox_slabs()
  if ci < 0 || height(cell_x(ci), cell_z(ci)) < rock_line() then 0
  else
    # One stone in the pocket however many the cube gave up.
    got = yes(dig_square(cb, ci % carve_n(), ci / carve_n(), k) > 0)
    # A margin that covers the cube itself and the lattice vertex beyond it:
    # sixty centimetres of bite and a metre of terrain grid.
    dirty_grow(cb, cell_x(ci), cell_z(ci), 1.8)
    if got > 0 then undermine(w, cell_x(ci), cell_z(ci)) else 0
    got

# ---- the swing ---------------------------------------------------------------
#
# From the eye, along the look: the first step that is rock is where the pick
# lands. Rock only — a swing at the meadow hits nothing, loudly. The stride and
# the range are in `mine_spot` and `mine_reach` below, which is where the two
# paragraphs that used to stand here had gone stale.
#
# How far the pick reaches. Twelve metres, and the number is not about arms —
# it is the other half of how wide a bite is, and it has now been round the
# loop twice.
#
# Twelve, first, because a bite was one stone wide and nobody fits down a shaft
# three tenths of a metre across: the only way to reach the bottom of your own
# pit was to stand on the rim and swing at ground four storeys below. Then
# three, because the bite grew to a metre and twenty — wide enough to drop
# into — and a digger standing on the floor they are cutting has nothing left
# to strike at a distance, so nothing was allowed to be.
#
# Three metres, which is an arm and a pick and a step of lean. It was twelve —
# far enough to stand on a rim and quarry the floor of a shaft four storeys
# down, which is not a pick, it is artillery. What paid for twelve was the
# one-stone bite: a shaft three tenths of a metre across is one nobody can
# climb into, so reach was the only thing left that decided how deep a pit
# could get.
#
# The bite is two stones now — six tenths, wide enough to drop into — so the
# depth looks after itself: a digger stands on the floor they just cut and
# cuts the next one. Two metres is then only about how far away a swing lands,
# and a swing should land where you are standing.
fn mine_reach() = 3.0

# How much head a standing body needs. The eye sits 1.75 up; the crown is a
# little over it.
fn stand_tall() = 1.85

# How far down you are allowed to look. It was 1.45 — eighty-three degrees —
# and eighty-three degrees is not "straight down": the look runs twelve
# centimetres sideways for every metre it runs deep. A stone is thirty
# centimetres wide, so a shaft cut from one stance walked out of its own
# column after a couple of metres and the pick started eating the stone next
# door instead of the one it was on. At 1.53 the drift is four centimetres a
# metre, which keeps a swing in its column the whole depth of a pit, and it
# is still short of the pole where a camera's up-vector stops meaning
# anything.
fn pitch_max() = 1.53

# The landing rule: the point along the look where the ray runs closest to
# the ground, provided it comes within arm's reach there. Not "where the ray
# crosses under the floor" — on this valley's hillsides that is a test that
# can simply never fire, because looking down a slope the ground falls away
# almost along the look and the two run parallel for ten metres. Every look
# has a closest approach; if that approach is inside 1.6 m the pick lands
# there, which is exactly the "the ground I am looking at" a player means.
# Arm'''s reach is 2.2 m — half a body of tolerance — because at 1.6 the
# steepest hillsides still slipped just out of it at the reach'''s end.
# Straight down, the closest approach is the floor itself and nothing about
# the old behaviour changes.
# Where the crosshair is pointing, and nothing cleverer than that: walk the
# look out from the eye a tenth of a metre at a time and stop at the first
# place that is rock. The first place — not the nearest approach to a floor,
# which is what it had to be when the world was a height field and "the
# floor" was the only thing a column had. Now a wall is as strikeable as a
# floor, and the pick takes what the crosshair is on.
fn mine_spot(w, s, t0) = ms_walk(w, s, 0.4)

fn ms_walk(w, s, t) =
  if t > mine_reach() then 0 - 1
  else
    yaw = peek_f32(s, 19)
    pitch = peek_f32(s, 20)
    cp = cos(pitch)
    x = peek_f32(s, 16) + sin(yaw) * cp * t
    y = peek_f32(s, 17) + sin(pitch) * t
    z = peek_f32(s, 18) - cos(yaw) * cp * t
    # A tenth of a metre a step, because a stone is three tenths across: a
    # longer stride could pass clean through one.
    if solid_at(w, x, y, z) == 0 then ms_walk(w, s, t + 0.1)
    else if height(x, z) < rock_line() then 0 - 1
    else if y < height(x, z) - dig_floor() then 0 - 1
    else
      i = carve_cell(x, z)
      if i < 0 then 0 - 1 else bite_code(i, slab_of(y))

# What one swing does, and what it pays. The event goes on the ring whether
# this is the server deciding or a lone browser being its own server; a
# client in somebody else's valley never calls this — it asks, and is told.
fn swing_pick(s: Ptr) -> Int =
  w = wd(s)
  ci = mine_spot(w, s, 0.5)
  if ci < 0 then 0
  else
    cb = cv(w)
    k = to_int(peek_f32(cb, 2))
    cr_put(cb, k, ci)
    poke_f32(cb, 2, to_float(k + 1))
    # One stone a swing, because one swing is one stone: the cell it takes
    # out is the cube a wall is built of, so what goes in the pocket is the
    # thing itself rather than a conversion.
    stones = apply_carve(w, ci)
    poke_f32(s, 251, peek_f32(s, 251) + to_float(stones))
    stones

# What the ring said, replayed on a client. The stones are not paid here —
# whose swing it was is the server's ledger, and the owner is told directly.
fn put_carve(s: Ptr, ci: Int) -> Int = ap_carve(wd(s), ci)

fn ap_carve(w: Ptr, ci: Int) -> Int =
  cb = cv(w)
  k = to_int(peek_f32(cb, 2))
  cr_put(cb, k, ci)
  poke_f32(cb, 2, to_float(k + 1))
  apply_carve(w, ci)

fn carve_ev(w: Ptr, k: Int) -> Int = cr_get(cv(w), k)

fn stones_of(s: Ptr) -> Int = to_int(peek_f32(s, 251))

fn set_stones(s: Ptr, n: Int) = poke_f32(s, 251, to_float(n))

fn set_carves(s: Ptr, n: Int) = poke_f32(cv(wd(s)), 2, to_float(n))

fn magma_x(w: Ptr, k: Int) -> Float = cell_x(magma_cell(w, k))

fn magma_z(w: Ptr, k: Int) -> Float = cell_z(magma_cell(w, k))

# ---- putting the digging on the mesh ------------------------------------------
#
# The terrain mesh was baked once, from a lattice that no longer exists; a
# crater has to reach it or the ground moves under a picture that does not.
# This rewrites just the mesh cells under the dirty rect — position, normal
# and band colour, by the same arithmetic `emit_corner` used at init, with
# the carve subtracted — and reports which cells it touched so the page can
# re-upload those rows and nothing else.
#
# The corner heights are sampled fresh (base less carve) rather than kept:
# nine samples a corner, six corners a cell, over a rect a crater makes is a
# few hundred sines, once per swing.
fn mesh_n(w) = to_int(peek_f32(w, 54))

# The mesh corner takes the exact top of the column it stands on, with no
# reaching about for the deepest thing nearby.
#
# It used to reach half a lattice step, from the days when a bite was one
# stone across and a lattice metres wide could step clean over it. A bite is
# one stone again — narrower than the lattice — and the reaching is still not
# wanted: it pulled the terrain down around every hole by as much as a whole
# bite, while the voxel columns beside it stood at their true height, and the
# excavation came out as a blocky lump standing proud of a dented hillside
# instead of a hole in a whole one.
#
# A shaft narrower than the lattice moves no corner at all, and that is not a
# gap in the picture: a cell with anything dug in it is blanked and the voxel
# faces draw every column of it. Measured, with a shaft sunk on a corner
# exactly: no cell that still draws sits a centimetre below the hillside,
# because the blanking scan is inclusive at a cell's edges and so all four
# cells around a dropped corner are blanked together.
fn ch(w, ix, iz, st) =
  lx = lattice(ix, st)
  lz = lattice(iz, st)
  height(lx, lz) - carve_depth(w, lx, lz)

# The colour of rock that has been opened. The band colours are the weathered
# skin; under a pick the inside shows — darker, warmer, unmistakably worked.
# It deepens with the cut, and it is decided per corner from the same carve
# field the height came from, so the paint and the bowl cannot disagree. This
# is most of what makes one swing *visible*: a metre of depression hides in
# the rock's own noise, a colour change does not.
fn dug_tint(w, lx, lz, st, r0, g0, b0) =
  d = carve_depth(w, lx, lz)
  if d < 0.04 then (r0, g0, b0)
  else
    k = if d * 0.7 > 0.9 then 0.9 else d * 0.7
    (r0 + (0.58 - r0) * k, g0 + (0.42 - g0) * k, b0 + (0.27 - b0) * k)

fn rb_corner(w, m, at, n, st, ix0, iz0, j) =
  ix = if ix0 < 0 then 0 else if ix0 > n then n else ix0
  iz = if iz0 < 0 then 0 else if iz0 > n then n else iz0
  a = if ix - 1 < 0 then ix else ix - 1
  b = if ix + 1 > n then ix else ix + 1
  c = if iz - 1 < 0 then iz else iz - 1
  d = if iz + 1 > n then iz else iz + 1
  sx = (ch(w, b, iz, st) - ch(w, a, iz, st)) / (to_float(b - a) * st)
  sz = (ch(w, ix, d, st) - ch(w, ix, c, st)) / (to_float(d - c) * st)
  il = 1.0 / sqrt(sx * sx + 1.0 + sz * sz)
  rb_vert(w, m, at, st, lattice(ix, st), ch(w, ix, iz, st), lattice(iz, st), (0.0 - sx) * il, il, (0.0 - sz) * il, j)

# `emit_vert` computes the band colours from height and slope; this replaces
# them with the dug tint where the ground has been opened.
fn rb_vert(w, m, at, st, x, y, z, nx, ny, nz, j) =
  emit_vert(m, at, x, y, z, nx, ny, nz, j)
  (r, g, b) = dug_tint(w, x, z, st, peek_f32(m, at + 6), peek_f32(m, at + 7), peek_f32(m, at + 8))
  poke_f32(m, at + 6, r)
  poke_f32(m, at + 7, g)
  poke_f32(m, at + 8, b)

fn rb_tri(w, m, at, n, st, ia, ja, ib, jb, ic, jc) =
  j = 0.965 + 0.07 * hash2(floor(lattice(ia, st) * 3.1), floor(lattice(ja, st) * 3.1))
  rb_corner(w, m, at, n, st, ia, ja, j)
  rb_corner(w, m, at + 9, n, st, ib, jb, j)
  rb_corner(w, m, at + 18, n, st, ic, jc, j)

fn rb_cell(w, m, n, st, ix, iz) =
  at = (iz * n + ix) * 54
  # A cell with a roof under it is not the height field's to draw. Written out
  # as six copies of one corner it has no area, draws nothing, and leaves the
  # hillside open where the tunnel goes in — which is the only way a mouth in
  # a cliff can exist at all in a world made of heights.
  if mcell_roofed(w, st, ix, iz) > 0 then rb_blank(w, m, at, n, st, ix, iz)
  else
    rb_tri(w, m, at, n, st, ix, iz, ix, iz + 1, ix + 1, iz + 1)
    rb_tri(w, m, at + 27, n, st, ix, iz, ix + 1, iz + 1, ix + 1, iz)
    1

fn rb_blank(w, m, at, n, st, ix, iz) =
  y = ch(w, ix, iz, st)

  for j in 0..6
    emit_vert(m, at + j * 9, lattice(ix, st), y, lattice(iz, st), 0.0, 1.0, 0.0, 1.0)

  1

fn rb_span(w, m, n, st, ix0, ix1, iz) =
  if ix0 > ix1 then 0
  else
    rb_cell(w, m, n, st, ix0, iz)
    rb_span(w, m, n, st, ix0 + 1, ix1, iz)

fn rb_rows(w, m, n, st, ix0, ix1, iz, iz1) =
  if iz > iz1 then 0
  else
    rb_span(w, m, n, st, ix0, ix1, iz)
    rb_rows(w, m, n, st, ix0, ix1, iz + 1, iz1)

fn mcell(v, st, lo) =
  i = to_int(floor((v + world_w() * 0.5) / st))
  if i < lo then lo else i

fn mcell_hi(v, st, hi) =
  i = to_int(floor((v + world_w() * 0.5) / st))
  if i > hi then hi else i

# Rebake whatever is dirty. Returns 1 if anything was, with the touched mesh
# cells left in header slots 6..9 for the page; 0 means nothing to upload.
fn rebake(s: Ptr) -> Int =
  w = wd(s)
  cb = cv(w)
  if dirty_none(cb) then 0
  else
    n = mesh_n(w)
    st = cell_step(n)
    ix0 = mcell(peek_f32(cb, 4), st, 0)
    iz0 = mcell(peek_f32(cb, 5), st, 0)
    ix1 = mcell_hi(peek_f32(cb, 6), st, n - 1)
    iz1 = mcell_hi(peek_f32(cb, 7), st, n - 1)
    rb_rows(w, peek_ptr(w, 64), n, st, ix0, ix1, iz0, iz1)
    poke_f32(cb, 8, to_float(ix0))
    poke_f32(cb, 9, to_float(iz0))
    poke_f32(cb, 10, to_float(ix1))
    poke_f32(cb, 11, to_float(iz1))
    dirty_clear(cb)
    1

fn dirty_at(w: Ptr, j: Int) -> Int = to_int(peek_f32(cv(w), 8 + j))

# ---- drawing what the height field cannot -----------------------------------
#
# A terrain mesh is a lattice of heights, so it can draw a pit — a pit is
# just lower ground — and it cannot draw a roof. The moment somebody cuts
# sideways into a wall and leaves the rock above it standing, there is a
# surface in this world with rock over it and air under it, and no height
# anywhere says so.
#
# So the tunnels get geometry of their own: one quad per face of rock that
# has air against it, built here and drawn instanced. And where they do, the
# terrain mesh has to get out of the way — a height field laid over a tunnel
# mouth is a ramp of hillside sealing the entrance — so any mesh cell holding
# a roofed column is written out as zero-area triangles and the faces below
# take over the drawing of it entirely, its untouched columns included.
#
# Only roofed columns pull this in. An open pit is still the height field's
# to draw, which is both cheaper and free of two surfaces fighting over the
# same millimetre.
fn face_cap() = 60000

fn face_stride() = 16

fn rock_faces(w: Ptr) -> Int = to_int(peek_f32(cv(w), 14))

fn face_buf(w) = peek_ptr(w, 85)

fn face_at(w: Ptr, k: Int, j: Int) -> Float = peek_f32(face_buf(w), k * face_stride() + j)

# Has anything at all been taken out of this column?
#
# It used to ask a narrower question — is there rock over air in it, a roof —
# on the grounds that an open pit is just lower ground and a height field can
# draw lower ground perfectly well. It cannot. A terrain cell is a metre
# across and a pit's wall is vertical, so what the height field drew was a
# funnel: a wide smooth apron sloping from the rim to the floor, with the
# actual shaft a black hole in the middle of it. The voxels can draw a
# vertical wall and the height field never will, so the voxels get every cell
# that has been dug in, roofed or not.
fn col_dug(cb, i) = if i < 0 then 0 else col_any(cb, i)

# Has any column of this terrain mesh cell been dug?
fn mcell_roofed(w, st, ix, iz) =
  cb = cv(w)
  x0 = lattice(ix, st)
  z0 = lattice(iz, st)
  mr_rows(cb, cell_ix(x0), cell_ix(x0 + st), cell_ix(z0), cell_ix(z0 + st))

fn mr_rows(cb, x0, x1, iz, z1) =
  if iz > z1 then 0
  else if mr_row(cb, x0, x1, iz) > 0 then 1
  else mr_rows(cb, x0, x1, iz + 1, z1)

fn mr_row(cb, ix, x1, iz) =
  if ix > x1 then 0
  else if col_dug(cb, cell_at(ix, iz)) > 0 then 1
  else mr_row(cb, ix + 1, x1, iz)

# ---- the faces themselves ----------------------------------------------------
#
# One quad per face of rock with air against it. Six directions, numbered so
# the shader can build the corners from the number alone: 0 and 1 are the two
# faces across x, 2 and 3 up and down, 4 and 5 across z. The position written
# is the low corner of the face.
fn put_face(w, x, y, z, dir, r, g, b) = put_tall(w, x, y, z, dir, carve_q(), carve_q(), r, g, b)

# A face with a light of its own. The top of a column sits flat, and a flat
# top on a hillside catches the sun straight on while the slope around it is
# in shadow — so a dug patch read as a bright blocky lump stuck on a dark
# hill even when its height matched to the centimetre. Given the slope's own
# normal it lights the way the hillside does and the steps go back to being
# steps.
fn put_lit(w, x, y, z, dir, tall, tall2, wide, nx, ny, nz, r, g, b) =
  # The taller end decides whether there is a face here at all. `put_tall`
  # throws away anything with no height, and it was being shown only the
  # first end — so a wall that ran out to nothing where the hillside dipped
  # under it was thrown away whole instead of drawn as the triangle it is.
  hi = if tall > tall2 then tall else tall2
  ok = put_tall(w, x, y, z, dir, hi, wide, r, g, b)
  if ok == 0 then 0
  else
    cb = cv(w)
    at = (to_int(peek_f32(cb, 14)) - 1) * face_stride()
    fb = face_buf(w)
    poke_f32(fb, at + 7, tall)
    poke_f32(fb, at + 8, nx)
    poke_f32(fb, at + 9, ny)
    poke_f32(fb, at + 10, nz)
    poke_f32(fb, at + 11, 0.0)
    poke_f32(fb, at + 12, tall2)
    1

# A face is a stone wide and, usually, a stone tall. Usually: the top of a
# column has to reach the ground the terrain mesh draws beside it, and the
# ground is where the ground is rather than on a slab boundary, so the side
# faces at the top of a column are given whatever height closes that gap. A
# face of fixed height leaves a slot of daylight all round the edge of a
# tunnel mouth, which is a crack you can see the void through.
fn put_tall(w, x, y, z, dir, tall, wide, r, g, b) =
  cb = cv(w)
  n = to_int(peek_f32(cb, 14))
  if n >= face_cap() || tall < 0.001 || wide < 0.0005 then 0
  else
    at = n * face_stride()
    fb = face_buf(w)
    poke_f32(fb, at, x)
    poke_f32(fb, at + 1, y)
    poke_f32(fb, at + 2, z)
    poke_f32(fb, at + 3, to_float(dir))
    poke_f32(fb, at + 4, r)
    poke_f32(fb, at + 5, g)
    poke_f32(fb, at + 6, b)
    poke_f32(fb, at + 7, tall)
    # Nought for a normal means "the one your own direction implies", which
    # is what every face of the inside of a tunnel wants. And one for the
    # eleventh: this is rock somebody opened, and it takes the stone texture
    # whatever the band under it would have been. `put_lit` writes nought
    # there, because what it draws is hillside that was always hillside.
    poke_f32(fb, at + 8, 0.0)
    poke_f32(fb, at + 9, 0.0)
    poke_f32(fb, at + 10, 0.0)
    poke_f32(fb, at + 11, 1.0)
    # How tall the face is at its far end. The same by default, because a slab
    # in the middle of a column is a stone tall from one side of it to the
    # other; it is the *cap* faces that are not, and `put_lit` writes over
    # this. See `slab` in `col_faces` for what a flat top cost.
    poke_f32(fb, at + 12, tall)
    # How wide the face runs. A stone, unless it has been cut to the cell that
    # asked for it — see `put_side` in `col_faces`. A ground quad writes over
    # this with a corner height and carries its own width in slot 7.
    poke_f32(fb, at + 13, wide)
    poke_f32(cb, 14, to_float(n + 1))
    1

# The colour of opened rock. The band colours are the weathered skin; under a
# pick the inside shows — warmer, and a little darker the deeper it was.
#
# It was 0.62 at the surface, which is two thirds brighter than the hillside
# the cut is made in, and at any hour but noon a mine mouth came out as a
# pale scar stuck on a dark slope. Broken stone is not brighter than the hill
# it came out of; it is the same stone with the weather off it.
#
# And barely warmer, where it used to be a great deal warmer: 0.90 and 0.78 on
# the green and the blue is a brown, and the stone photograph the shader folds
# in is itself a brown, so the two agreed with each other all the way down a
# shaft until the inside of the hill read as clay. The hillside's own stone
# band is (0.38, 0.38, 0.46) — if anything cool — and what a pick opens should
# sit beside it, a shade of warmth away, at the same brightness.
fn face_grey(y, h, up) =
  d = clampf((h - y) / dig_floor(), 0.0, 1.0)
  k = 0.40 - d * 0.11
  (k * 1.04, k, k * 0.99)

# The speckle the terrain gives itself, per stone rather than per triangle.
# Without it a dug patch is a smooth plate laid on a mottled hillside, which
# is a seam the eye finds long before it finds the geometry.
fn face_jitter(x, z) = 0.94 + 0.12 * hash2(floor(x * 3.1), floor(z * 3.1))

# One column's faces. Walks its slabs from the bedrock to the sky and asks, of
# every solid one, which of its six neighbours is air.
fn col_faces(w, cb, ix, iz, gx0, gz0, gst) =
  i = cell_at(ix, iz)
  if i < 0 then 0
  else
    q = carve_q()
    cx = cell_x(i)
    cz = cell_z(i)
    x = cx - q * 0.5
    z = cz - q * 0.5
    # The ground this column is drawn against — the same surface the hillside
    # beside it is drawn on, or the two part company.
    h = mesh_h(w, cx, cz)
    # The hillside's own slope at this column, off the same lattice the
    # terrain mesh uses, so a cap face lights the way the hill does.
    st = cell_step(mesh_n(w))
    sx = (mesh_h(w, cx + st, cz) - mesh_h(w, cx - st, cz)) / (st * 2.0)
    sz = (mesh_h(w, cx, cz + st) - mesh_h(w, cx, cz - st)) / (st * 2.0)
    il = 1.0 / sqrt(sx * sx + 1.0 + sz * sz)
    nx = (0.0 - sx) * il
    ny = il
    nz = (0.0 - sz) * il
    ht = mesh_h(w, cx, cz)

    # Everything below is one column's business, so it is written inside the
    # column rather than passed to it. A local function sees the names around
    # it and still compiles to a jump — thirteen parameters of unchanging
    # context went away without anything being allocated to replace them.
    # The four corners of this column's top, which is what its ground quad is
    # a ramp between — and what its side faces have to reach.
    ca = mesh_h(w, x, z)
    cbb = mesh_h(w, x + q, z)
    cc = mesh_h(w, x, z + q)
    cd = mesh_h(w, x + q, z + q)

    hc = mesh_h(w, cx, cz)

    # A cap face is given the two heights its run ends at rather than one for
    # the whole of it; anything under a cap is a stone tall from end to end and
    # takes the plain one.
    # Never below nought. A cap face now reaches a *corner* height at each end
    # rather than one height for the whole run, and on a slope one of those two
    # corners can sit under the bottom of the slab the face stands on — the
    # centre is inside the slab, which is what made it the cap, and a corner
    # need not be. A negative height turns the quad inside out and the
    # rasteriser drops the half of it that inverted: a triangle of daylight,
    # which is the shape this bug is recognisable by. Where an end is clamped,
    # the full-stone face under it already covers that corner and a little
    # above it, which is over-draw and costs nothing.
    # How much of this slab the ground leaves standing.
    #
    # The ground here is `mesh_h`, the hillside as it is drawn, and it is not
    # the same surface the rock is decided by: `ch` takes `carve_depth` off
    # every lattice corner, so a corner that sits inside a pit drags the drawn
    # hillside down across the whole cell — a metre and a half of it, measured
    # at the rim of a shaft, under a column nobody had dug.
    #
    # This used to answer nought whenever the ground came out under the slab,
    # and nought is a face with no height, and a face with no height is thrown
    # away by `put_tall`. So along the rim of every pit stood columns the body
    # collided with and the eye went straight through — thirty-three of them in
    # one seven-column patch, and what was behind them was the lake. It is the
    # band along the bottom of a dug edge in every photograph of this.
    #
    # Under the slab means the rock is exposed for the whole of it, which is
    # `tall`, not nothing.
    # Under the slab means the rock is exposed for the whole of it, which is
    # `tall`, not nothing. Above the slab it means the hillside is drawn higher
    # than the rock the column is made of, and then the face has to *follow it
    # up*: the ground quad beside it is a ramp between the same corner heights,
    # and a face that stopped at the rock instead left exactly the triangle
    # between the two — which is what capping this at `tall` put back.
    # How high the ground stands over this slab's base at one end of a run.
    # Nought is a real answer: where the hillside dips under the slab the face
    # simply runs out, and a face that is a stone tall at one end and nothing
    # at the other is a triangle, which is exactly the shape a wall meeting a
    # slope wants. It takes two heights to say that and the buffer has carried
    # two since the ramped caps went in.
    fn rise(t, py, tall) = if t <= py then 0.0 else if t - py > tall then tall else t - py

    # A riser, split where it crosses a lattice cell's edge — not clipped to
    # the cell, which is what a ground quad gets and what this had first.
    #
    # Two things want the split. `mesh_h` is bilinear *inside* a cell and kinks
    # at the edge between two of them, so the top of a run that crosses an edge
    # is a straight chord under a surface that bends, and the ground quad above
    # it — which is cut at the edge, and so does not bend across it — sits above
    # the chord. Measured on a rim: the quad at 15.4675 against a chord at
    # 15.4626, five millimetres of daylight, a wedge several pixels wide seen
    # along the slope.
    #
    # But *clipping* a riser is wrong where a quad may be clipped freely. The
    # half of a quad beyond the line is drawn by whoever owns that ground —
    # another blanked cell, or the terrain itself. There is nothing vertical in
    # the terrain: the half of a riser beyond the line is drawn by nobody, and
    # if the cell over there has nothing dug in it, it never visits this column
    # to draw it. Measured: a run covering 0.0875 of its three tenths, and a
    # slit of lake along the bottom of a wall.
    #
    # So both halves are emitted here, by whichever cell is asking. A column is
    # three tenths and a cell is a metre, so at most one edge falls inside a
    # run and there are never more than two pieces. The pieces are written twice
    # when two blanked cells share the column, and twice is harmless: the same
    # quad at the same depth.
    fn side_piece(px, py, pz, dir, tall, cap, a0, a1, r, g, b) =
      alongz = dir < 2
      wide = a1 - a0
      if wide < 0.0005 then 0
      else
        qx = if alongz then px else a0
        qz = if alongz then a0 else pz
        ex = if alongz then px else a1
        ez = if alongz then a1 else pz
        ta = mesh_h(w, qx, qz)
        tb = mesh_h(w, ex, ez)
        put_lit(w, qx, py, qz, dir, rise(ta, py, tall), rise(tb, py, tall), wide, nx, ny, nz, r, g, b)

    # Where a run crosses a diagonal of the lattice.
    #
    # The edge is not the only place the ground bends. A cell is drawn as two
    # triangles cut from its low corner to its high one — see `rb_cell` — so
    # the surface creases along that cut as well, and `mesh_h` follows the
    # crease exactly. A riser capped with one straight chord from end to end
    # therefore cuts the corner off the crease, and what is left open under the
    # chord is bounded by the crease above and the two quads either side: a
    # triangle, sitting wherever a wall happens to cross a cell's diagonal.
    # `mesh_h` already says this in its own comment. It was only ever half
    # fixed — the *samples* were put on the triangulation and the *chord*
    # between two of them was left as it was.
    #
    # Taken off the lattice, not off `gx0`: a column at the edge of a cell
    # hangs over into the next one, and the piece that hangs over crosses that
    # cell's diagonal, not this one's. A run is three tenths of a metre and a
    # cell is 170/grid, so at most one diagonal falls inside it.
    fn diag_at(fixed, s0, s1) =
      f = (fixed + world_w() * 0.5) / gst
      fr = f - floor(f)
      k = floor((s0 + world_w() * 0.5) / gst)
      d0 = (k + fr) * gst - world_w() * 0.5
      d1 = (k + 1.0 + fr) * gst - world_w() * 0.5
      if d0 > s0 && d0 < s1 then d0 else if d1 > s0 && d1 < s1 then d1 else s0

    # A riser, split where it crosses either of the two lines the ground bends
    # on. Both can fall inside one run, so three pieces are laid out and the
    # empty ones fall out on `side_piece`'s own width guard.
    fn put_side(px, py, pz, dir, tall, cap, r, g, b) =
      s0 = if dir < 2 then pz else px
      s1 = s0 + q
      e0 = if dir < 2 then gz0 else gx0
      e1 = e0 + gst
      ce = if e0 > s0 && e0 < s1 then e0 else if e1 > s0 && e1 < s1 then e1 else s0
      cd = diag_at(if dir < 2 then px else pz, s0, s1)
      c1 = if ce < cd then ce else cd
      c2 = if ce < cd then cd else ce
      n1 = side_piece(px, py, pz, dir, tall, cap, s0, c1, r, g, b)
      n2 = side_piece(px, py, pz, dir, tall, cap, c1, c2, r, g, b)
      n3 = side_piece(px, py, pz, dir, tall, cap, c2, s1, r, g, b)
      n1 + n2 + n3

    fn top(py, cap) =
      if cap then ground_quad(w, x, z, nx, ny, nz, gx0, gz0, gst)
      else
        (r, g, b) = face_grey(py, h, 1)
        put_face(w, x, py, z, 2, r, g, b)

    fn slab(k) =
      y = slab_y(k)
      # The topmost slab of a standing column ends at the ground, not at the
      # slab's ceiling — and the ground it ends at is the one the terrain mesh
      # draws, or the two surfaces meet at a step and the step is a hole.
      cap = slab_y(k + 1) > hc
      # To the rock's own top, and then trimmed *down* to the hillside by
      # `rise`, one end at a time.
      #
      # This used to go straight to `ht`, the hillside as it is drawn — and the
      # two are not the same surface. `ch` takes `carve_depth` off every
      # lattice corner, so a corner sitting inside a pit drags the drawn ground
      # down across the whole cell; at the rim of a shaft the hillside came out
      # a metre and a half *under* the slab, `ht - y` was negative, and
      # `put_tall` threw the face away for having no height. The rock stayed
      # where it was — a body still walks into it, a pick still reads it — and
      # nothing at all was drawn on its side. That is the band of lake along
      # the bottom of every dug edge: not a crack, the top fifth of a stone,
      # and it stood open on every column round the rim.
      yt = slab_y(k + 1)
      tall = yt - y
      # A cap slab is hillside: its faces take the band colour and the slope.
      # Anything under it is broken stone.
      (gr, gg, gb) = face_grey(y, h, 1)
      jj = face_jitter(x, z + slab_y(k))
      (fr, fg, fb) = if cap then (band_r(y, ny) * jj, band_g(y, ny) * jj, band_b(y, ny) * jj) else (gr * jj, gg * jj, gb * jj)
      # A riser is only wanted where the neighbour is a hole, not merely
      # lower: two pieces of untouched hillside share their corner heights
      # and meet without one.
      # A cap face reaches the ground at *both* ends of its run, and the two
      # ends are two corners of the column: which two is decided by which way
      # the face points. A single height here was a flat line meeting a ramp,
      # and every slope opened a triangle between them that you could see the
      # lake through — measured at five centimetres on a gentle slope and a
      # good twenty on the steep ground the digging actually happens on.
      # Which two corners a face runs between is decided by which way it
      # points: a face on the low-x side runs along z from the (x, z) corner to
      # the (x, z+q) one, and so on round the column.
      if nb_open(w, cb, ix - 1, iz, k, cap) then put_side(x, y, z, 0, tall, cap, fr, fg, fb) else 0
      if nb_open(w, cb, ix + 1, iz, k, cap) then put_side(x + q, y, z, 1, tall, cap, fr, fg, fb) else 0
      if nb_open(w, cb, ix, iz - 1, k, cap) then put_side(x, y, z, 4, tall, cap, fr, fg, fb) else 0
      if nb_open(w, cb, ix, iz + 1, k, cap) then put_side(x, y, z + q, 5, tall, cap, fr, fg, fb) else 0
      # Against the same ground the walk uses. Asked of the middle of the
      # column while the walk ran to its highest corner, every slab between
      # the two believed it had sky over it and laid a floor there: a stack of
      # shelves standing over the hillside, with their sides trimmed away to
      # nothing because the hillside really is below them. What shows between
      # the shelves is daylight, one thin sliver per slab.
      if solid_cell(cb, i, k - 1, hc) == 0 then put_face(w, x, y, z, 3, gr, gg, gb) else 0
      if solid_cell(cb, i, k + 1, hc) == 0 || cap then top(yt, cap) else 0
      1

    for k in slab_of(h - dig_floor())..slab_of(hc) + 1
      if solid_cell(cb, i, k, hc) > 0 then slab(k) else 0

    1

# The height the terrain mesh would have drawn at this point: its lattice
# corners, blended the way a triangle blends them. The voxel surface has to
# agree with it exactly where the two meet, and `height` sampled per column
# does not — the mesh only knows its corners, and between them it is a plane.
fn mesh_h(w, x, z) =
  n = mesh_n(w)
  st = cell_step(n)
  ix = to_int(floor((x + world_w() * 0.5) / st))
  iz = to_int(floor((z + world_w() * 0.5) / st))
  ux = (x - lattice(ix, st)) / st
  uz = (z - lattice(iz, st)) / st
  a = ch(w, ix, iz, st)
  b = ch(w, ix + 1, iz, st)
  c = ch(w, ix, iz + 1, st)
  d = ch(w, ix + 1, iz + 1, st)
  # The *triangulation*, not the bilinear over the four corners.
  #
  # This used to be `a + (b-a)ux + (c-a)uz + (a-b-c+d)ux·uz`, which is the
  # smooth patch those four corners define. The terrain does not draw that
  # patch. It draws two triangles — see `rb_cell`, which cuts the cell from
  # (0,0) to (1,1) — and a triangle is flat. The two surfaces agree at the
  # corners and along the cell's edges and nowhere else in between, by up to a
  # quarter of the cell's twist.
  #
  # Everything the voxels build reads this: the top of a riser, the corners of
  # a piece of hillside. So a wall's top followed the smooth patch while the
  # ground beside it was drawn as flats, the two crossed somewhere over the
  # cell, and what was left open was bounded by the cut — which is why every
  # one of these has been a *triangle* and why they sat where they sat.
  #
  # The diagonal runs from the low corner to the high one. Above it the
  # triangle is (a, c, d); below it, (a, d, b).
  if uz > ux then a + (uz - ux) * (c - a) + ux * (d - a)
  else a + uz * (d - a) + (ux - uz) * (b - a)

# A piece of hillside, cut to the terrain cell that asked for it.
#
# The cut is the whole of this. A mesh cell is 170/grid metres and a column is
# three tenths, and the one does not divide by the other, so a column at the
# edge of a cell hangs over into the next one. `cell_faces` draws every column
# its cell *touches*, because drawing only the ones that start inside leaves a
# strip of hillside along every edge that nobody draws — that hole has been
# paid for once already. But the overhang is not free either: if the cell next
# door has nothing dug in it, the terrain is still drawing that ground, and
# then two surfaces are on the same millimetre. Measured: seventeen of
# sixty-five ground quads. They are computed differently — this one samples
# the lattice at three-tenths steps, the terrain interpolates its own triangle
# — so along the terrain's diagonal one wins by a hair and along the rim the
# other does, and where they part company you see the lake through the seam.
#
# So the quad is clipped to the cell instead. Two blanked cells sharing a
# column each draw their own half of it and together cover it exactly; a
# blanked cell beside a drawn one stops at the line the terrain starts on.
# Neither a gap nor an overlap, because both sides now end at the same edge.
#
# The clipped width and depth travel in the face record: the height slot,
# which a flat quad has no use for, and the stone slot, which for a piece of
# hillside is nought by definition and the shader can say so itself.
# One piece of hillside, laid down as it stands.
fn gq_put(w, lx, lz, hx, hz, nx, ny, nz, j) =
  wx = hx - lx
  wz = hz - lz
  a = mesh_h(w, lx, lz)
  b = mesh_h(w, hx, lz)
  c = mesh_h(w, lx, hz)
  d = mesh_h(w, hx, hz)
  ok = put_lit(w, lx, a, lz, 6, wx, wx, wx, nx, ny, nz, band_r(a, ny) * j, band_g(a, ny) * j, band_b(a, ny) * j)
  if ok == 0 then 0
  else
    cb = cv(w)
    at = (to_int(peek_f32(cb, 14)) - 1) * face_stride()
    fb = face_buf(w)
    poke_f32(fb, at + 11, wz)
    poke_f32(fb, at + 12, a)
    poke_f32(fb, at + 13, b)
    poke_f32(fb, at + 14, c)
    poke_f32(fb, at + 15, d)
    1

# How far the piece as drawn misses the ground it stands for, at its middle.
#
# The shader stretches the four corner heights across the piece bilinearly, so
# the middle of a piece is the mean of its corners. The ground is not a
# bilinear patch: a cell is two triangles and creases along the diagonal
# between them. Where a piece straddles that crease the two part company, and
# on the steepest rock in the valley they parted by sixty-six centimetres.
fn gq_miss(w, lx, lz, hx, hz) =
  a = mesh_h(w, lx, lz)
  b = mesh_h(w, hx, lz)
  c = mesh_h(w, lx, hz)
  d = mesh_h(w, hx, hz)
  absf((a + b + c + d) * 0.25 - mesh_h(w, (lx + hx) * 0.5, (lz + hz) * 0.5))

# A crease cannot be cut out of an axis-aligned rectangle — the line runs at
# forty-five degrees to both its sides — so the piece is quartered instead,
# and quartered again, until what is left is flat enough to draw.
fn gq_split(w, lx, lz, hx, hz, nx, ny, nz, j, depth) =
  if depth <= 0 || gq_miss(w, lx, lz, hx, hz) < 0.01 then gq_put(w, lx, lz, hx, hz, nx, ny, nz, j)
  else
    mx = (lx + hx) * 0.5
    mz = (lz + hz) * 0.5
    n1 = gq_split(w, lx, lz, mx, mz, nx, ny, nz, j, depth - 1)
    n2 = gq_split(w, mx, lz, hx, mz, nx, ny, nz, j, depth - 1)
    n3 = gq_split(w, lx, mz, mx, hz, nx, ny, nz, j, depth - 1)
    n4 = gq_split(w, mx, mz, hx, hz, nx, ny, nz, j, depth - 1)
    if n1 + n2 + n3 + n4 > 0 then 1 else 0

# A piece of hillside, cut to the terrain cell that asked for it.
fn ground_quad(w, x, z, nx, ny, nz, gx0, gz0, gst) =
  q = carve_q()
  lx = max(x, gx0)
  lz = max(z, gz0)
  hx = min(x + q, gx0 + gst)
  hz = min(z + q, gz0 + gst)
  if hx - lx < 0.0005 || hz - lz < 0.0005 then 0
  else
    # The speckle keeps the column's own seed, not the clipped piece's, so a
    # column split between two cells does not come out as two colours.
    j = face_jitter(x, z)
    gq_split(w, lx, lz, hx, hz, nx, ny, nz, j, 7)

# Air because somebody took it out, rather than air because the hill is lower
# over there. Only the first wants a face standing between them: two pieces of
# untouched hillside share their corner heights and meet without a riser, and
# putting one in anyway is a fin standing along every contour of the hill.
#
# The test for that used to be, at a cap slab, whether the neighbour's slab
# *k* had been dug — and that is the wrong question by exactly one slab. On a
# slope the uphill column's cap slab sits above the downhill column's original
# ground: there was never any rock there to take out, so `vox_gone` says no and
# no riser is built. But the downhill column is a hole, and the riser under the
# cap stops at a slab boundary, so what is left between that boundary and the
# uphill ground is open — six centimetres on gentle ground, a whole stone on
# steep. It is the last of the slots you could see the lake through, and the
# hardest to find, because the face it wanted was never counted as missing:
# nothing had asked for it.
#
# What decides it is whether the neighbour is a hole at all. A column somebody
# has dug is no longer hillside, and the shared-corner argument that makes a
# riser unnecessary does not hold against it at any height.
fn nb_open(w, cb, ix, iz, k, cap) =
  i = cell_at(ix, iz)
  if i < 0 then false
  else if nb_air(w, cb, ix, iz, k) == false then false
  else if cap == false then true
  else vox_gone(cb, i, k) > 0 || col_dug(cb, i) > 0

fn nb_air(w, cb, ix, iz, k) =
  i = cell_at(ix, iz)
  if i < 0 then false
  else solid_cell(cb, i, k, mesh_h(w, cell_x(i), cell_z(i))) == 0

# Every column of every terrain mesh cell that has lost its roof to a tunnel.
# The mesh cell is the unit because the mesh cell is what gets blanked, and a
# blanked cell has to be filled edge to edge — untouched columns included, or
# the hole in the hillside is a hole in the picture as well.
fn faces_build(s: Ptr) -> Int =
  w = wd(s)
  cb = cv(w)
  poke_f32(cb, 14, 0.0)
  n = mesh_n(w)
  st = cell_step(n)

  # Four nested walks over two grids — mesh cells, and the columns inside the
  # ones that have lost their roof. As five functions passing `w, cb, n, st`
  # to each other this was thirty lines that said nothing about what it did.
  for iz in 0..n
    for ix in 0..n
      if mcell_roofed(w, st, ix, iz) > 0 then cell_faces(w, cb, st, ix, iz) else 0

  rock_faces(w)

# The columns of one blanked terrain cell — and every one of them, which is
# less obvious than it sounds. A terrain cell is 170/grid metres across and a
# column is thirty centimetres, and the one does not divide by the other: a
# loop from the column at the cell's near edge to the column at its far edge
# stops short by up to a column, and what it stops short of is a strip of
# hillside nobody draws. Fifteen per cent of every blanked cell was a hole you
# could see the lake through.
#
# Every column the cell *touches*, not every column that starts inside it.
# Assigning each column to one cell — by its near corner, or by its middle —
# leaves the ones that straddle the boundary drawn by whichever cell claimed
# them, and if that cell is not blanked they are drawn by nobody: a sliver of
# hillside missing along every edge.
#
# A column claimed by two blanked cells is written twice, and twice is
# harmless: the two quads are the same quad, and the depth test keeps the
# first and drops the second.
fn col_lo(ix) = to_float(ix) * carve_q() - carve_org()

fn overlaps(ix, lo, len) = col_lo(ix) < lo + len && col_lo(ix) + carve_q() > lo

fn cell_faces(w, cb, st, mx, mz) =
  x0 = lattice(mx, st)
  z0 = lattice(mz, st)

  for iz in cell_ix(z0) - 1..cell_ix(z0 + st) + 2
    for ix in cell_ix(x0) - 1..cell_ix(x0 + st) + 2
      if overlaps(ix, x0, st) && overlaps(iz, z0, st) then col_faces(w, cb, ix, iz, x0, z0, st) else 0

  1

# ---- standing in it ----------------------------------------------------------
#
# Magma burns by the cell: your own cell and the four beside it, and only down
# in the pit — a metre and a half over the floor is a ledge, not a bath. A
# fifth of a bar a second, which is time to climb out and not much more.
# Whether this world is somebody else's — a client being told — in which case
# the tools ask instead of acting. On the server and in a browser playing
# alone this stays nought and the swing lands where it is swung.
fn hosted(w: Ptr) -> Int = to_int(peek_f32(w, 255))

fn set_hosted(w: Ptr, n: Int) = poke_f32(w, 255, to_float(n))

# Is there rock under the crosshair, in reach, right now? The HUD turns the
# crosshair gold on this, so the answer has to be exactly the swing's own —
# it calls the same ray with the same reach.
fn can_mine(s: Ptr) -> Int = if mine_spot(wd(s), s, 0.5) < 0 then 0 else 1

# The two tools, from the hand: decided in the engine, not on the page. A
# hosted world only raises the event — the page carries the one-byte ask to
# the server, and the answer comes back through the rings like anybody
# else's swing.
fn pick_used(s: Ptr) -> Int = if hosted(wd(s)) > 0 then 0 else swing_pick(s)

fn build_used(s: Ptr) -> Int = if hosted(wd(s)) > 0 then 0 else try_build(s)

fn magma_bite() = 0.22

# Magma within a metre of where you stand, in any direction. By the metre
# rather than by the cell: cells are thirty centimetres now, so "mine and the
# four beside it" would be a bath you could stand in the middle of and stay
# dry.
fn on_magma(w, s, py) =
  cb = cv(w)
  x = peek_f32(s, 21)
  z = peek_f32(s, 23)
  om_rows(cb, cell_ix(x - 1.0), cell_ix(x + 1.0), cell_ix(z - 1.0), cell_ix(z + 1.0))

fn om_rows(cb, x0, x1, iz, z1) =
  if iz > z1 then 0
  else if om_row(cb, x0, x1, iz) > 0 then 1
  else om_rows(cb, x0, x1, iz + 1, z1)

fn om_row(cb, ix, x1, iz) =
  if ix > x1 then 0
  else if col_magma(cb, cell_at(ix, iz)) > 0 then 1
  else om_row(cb, ix + 1, x1, iz)

fn magma_burn(w, s, py, gnd, dt) =
  if on_magma(w, s, py) == 0 then 0
  else if py > gnd + 1.5 then 0
  else
    poke_f32(s, 82, clampf(peek_f32(s, 82) - magma_bite() * dt, 0.0, 1.0))
    1

# ---- building back -----------------------------------------------------------
#
# The stones go down as rocks the size of a pace, appended to the same table
# the walls' blocks live in — which is why a built wall collides, shadows and
# breaks without a line of new machinery for any of it. Eight stones a rock.
#
# The scale is in the block mesh's own units, where the walls' stones run
# 0.4 to 0.53: three times their size is a rock knee-high to chest-high,
# which is a thing you hide behind, not a monolith. The first number here was
# 3.0 on the guess that scale was metres; it made six-metre megaliths.
fn build_cost() = 8

fn built_cap() = 256

fn built_scale() = 1.4

# Where a rock would go: three metres out along the look, on the carved floor.
# Or on top of a rock already there, which is how a wall gets a second course.
fn build_spot_y(w, x, z) =
  top = stack_top(w, x, z, block_count(w), 0.0 - 999.0)
  if top > 0.0 - 998.0 then top else floor_at(w, x, z)

fn stack_top(w, x, z, i0, floor0) =
  bb = peek_ptr(w, 114)

  for i in i0..i0 + built(w) with best = floor0
    dx = peek_f32(bb, i * 8) - x
    dz = peek_f32(bb, i * 8 + 2) - z
    sc = peek_f32(bb, i * 8 + 3)
    near = dx * dx + dz * dz < 0.81 && sc > 0.01
    if near then max(best, peek_f32(bb, i * 8 + 1) + 0.6 * sc) else best

fn try_build(s: Ptr) -> Int =
  w = wd(s)
  if stones_of(s) < build_cost() then 0
  else if built(w) >= built_cap() then 0
  else
    yaw = peek_f32(s, 19)
    x = peek_f32(s, 21) + sin(yaw) * 3.0
    z = peek_f32(s, 23) - cos(yaw) * 3.0
    y = build_spot_y(w, x, z)
    poke_f32(s, 251, to_float(stones_of(s) - build_cost()))
    place_built(w, x, y, z, yaw)

# The rock into the table and onto the ring, one entry each. Shared by the
# deciding end and the told end: `put_built` hands in the server's numbers.
fn place_built(w, x, y, z, yaw) =
  cb = cv(w)
  k = to_int(peek_f32(cb, 12))
  slot = block_count(w) + k % built_cap()
  bb = peek_ptr(w, 114)
  poke_f32(bb, slot * 8, x)
  poke_f32(bb, slot * 8 + 1, y)
  poke_f32(bb, slot * 8 + 2, z)
  poke_f32(bb, slot * 8 + 3, built_scale())
  poke_f32(bb, slot * 8 + 4, yaw)
  poke_f32(bb, slot * 8 + 5, 0.62)
  poke_f32(bb, slot * 8 + 6, 0.60)
  poke_f32(bb, slot * 8 + 7, 0.57)
  at = build_ring_at(k)
  poke_f32(cb, at, to_float(slot))
  poke_f32(cb, at + 1, x)
  poke_f32(cb, at + 2, y)
  poke_f32(cb, at + 3, z)
  poke_f32(cb, at + 4, yaw)
  poke_f32(cb, 12, to_float(k + 1))
  1

fn put_built(s: Ptr, x: Float, y: Float, z: Float, yaw: Float) -> Int =
  place_built(wd(s), x, y, z, yaw)

fn ap_built(w: Ptr, x: Float, y: Float, z: Float, yaw: Float) -> Int = place_built(w, x, y, z, yaw)

fn ap_set_carves(w: Ptr, n: Int) = poke_f32(cv(w), 2, to_float(n))

fn ap_set_built(w: Ptr, n: Int) = poke_f32(cv(w), 12, to_float(n))

fn built_ev(w: Ptr, k: Int, j: Int) -> Float = peek_f32(cv(w), build_ring_at(k) + j)

fn set_built(s: Ptr, n: Int) = poke_f32(cv(wd(s)), 12, to_float(n))

# How many rocks the renderer should draw: the walls' own, and everything
# built since.
fn blocks_total(w: Ptr) -> Int = block_count(w) + built(w)

# How far the server has broadcast each ring — the world's own slots so the
# hub does not need state of its own. Craters and rocks land between ticks,
# where a before/after read around the tick cannot see them.
# The field, across a rebuild. A tier change tears the whole valley down and
# builds a new one, and `wire_replay` re-tells the new one everything the wire
# remembered — but the wire does not remember the field: at the door it is one
# RLE message, and after that it is craters that were applied and let go. So
# the page carries it over by hand: saved off the old world before the free,
# loaded into the new one after, everything marked dirty so the fresh mesh
# picks it up on the first frame.
fn carve_save(w: Ptr) -> Ptr =
  keep = alloc_bytes(carve_bytes())

  for i in 0..carve_bytes() / 4
    poke_i32(keep, i, peek_i32(cv(w), i))

  keep

# The copy carried the page-table pointer with it, so the pages themselves
# move to the new world untouched; what the new world was born with is one
# empty table, freed here before the old one takes its slot.
fn carve_load(s: Ptr, keep: Ptr) =
  w = wd(s)
  cb = cv(w)
  free_ptr(peek_ptr(cb, 0))

  for i in 0..carve_bytes() / 4
    poke_i32(cb, i, peek_i32(keep, i))

  free_ptr(keep)
  dirty_grow(cb, 0.0 - 85.0, 0.0 - 85.0, 1.0)
  dirty_grow(cb, 85.0, 85.0, 1.0)
  1

fn carve_sent(w: Ptr) -> Int = to_int(peek_f32(w, 253))

fn built_sent(w: Ptr) -> Int = to_int(peek_f32(w, 254))

fn mark_carves_sent(w: Ptr) =
  poke_f32(w, 253, to_float(carves(w)))
  poke_f32(w, 254, to_float(built(w)))
  1

# ---- arriving and leaving --------------------------------------------------
#
# A player is a block of the same shape as the world's, pointing at it. There
# is no copy of anything: the crystals, the rounds and the shark are the
# world's and are reached through that pointer, so two players cannot disagree
# about what the valley is doing.

# Where somebody comes in: somewhere dry, and somewhere else each time.
#
# It was a spiral round one patch of grass, which put everybody within sight of
# each other the moment they arrived and put whoever had just been shot back
# where they fell, in front of whoever shot them. A valley a hundred and sixty
# metres across has better places to start than one of them.
#
# The spot is a hash of who is arriving and when, so two people who arrive
# together are not on the same metre and coming back is not coming back to the
# same corner. It is tried up to eight times and the first dry one wins: the
# lake is most of the middle of this valley and there is no sense in starting
# somebody in it. Eight failures — which the hash does not do, but a different
# terrain might — fall back to the old spot rather than to the water.
fn spawn_x(seed, t) = (hash2(seed * 12.9898 + to_float(t) * 7.13, 78.233) - 0.5) * 150.0

fn spawn_z(seed, t) = (hash2(seed * 39.3467 + to_float(t) * 3.71, 11.135) - 0.5) * 150.0

# Which try landed somewhere worth standing, or `spawn_tries` if none did. Dry,
# and below the rocks: the band between the waterline and nine metres is the
# grass the pines grow on, and putting somebody down on a peak thirty metres up
# is not a spawn, it is a punishment.
#
# Eight tries were not enough when the ground was the only question either,
# which is worth writing down because it was never noticed. Measured over
# twenty thousand candidates in the valley the ultra tier builds: a quarter of
# them stand on ground a spawn is allowed — the rest are the lake and the
# peaks — so eight tries missed nine times in a hundred, and nine spawns in a
# hundred were the same corner. The spread the hash was there to give was
# quietly not being given.
#
# The glass takes that quarter down to a ninth: three hundred and eighty
# crystals with four and a half metres kept clear of each cover most of the
# band they stand in, which is the same band the ground test likes.
#
# Sixty-four tries put the corner at two in a thousand. What it costs is
# sixty-four terrain samples in the worst case — twelve sines each — once, on
# the frame somebody is being put down. Nothing that happens on a respawn is
# measured in sines.
fn spawn_tries() = 64

fn spawn_try(w, seed, t) =
  if t >= spawn_tries() then spawn_tries()
  else if fine_spot(w, spawn_x(seed, t), spawn_z(seed, t)) then t
  else spawn_try(w, seed, t + 1)

fn fine_spot(w, x, z) = good_spot(height(x, z)) && off_the_glass(w, x, z) && on_magma_xz(w, x, z) == 0

fn on_magma_xz(w, x, z) = col_magma(cv(w), carve_cell(x, z))

# The rock band and nothing else, for now: everybody starts where the pick
# works, which while the digging is the new thing is where the game is. The
# meadow spawns can come back when there is a reason to start in the meadow.
# Twenty still keeps the spawn off the rim wall, which is a ledge, not a
# place.
fn good_spot(h) = h > 10.0 && h < 20.0

# ---- and clear of the glass -------------------------------------------------
#
# A crystal answers whatever stands against it: a twentieth of a bar every
# three seconds, out to `zap_reach` from its surface — see "the crystals bite
# back". Being *put* inside that ring is not a wager anybody made. It cost
# health before the screen had finished fading in, and it was not rare: the
# crystals are thickest between the waterline and three and a half metres,
# which is most of the ground a spawn is allowed to land on.
#
# So the reach is the second half of what makes a spot good, with a stride of
# clearance on top. At the exact edge one step in the wrong direction is a
# bite, and a spawn you have to walk away from carefully is the same bug with
# a smaller radius.
#
# The rule is `near_glass`'s own, read off the same buffer: the same surface
# offset, and the same indifference to anything under 0.35, which is both the
# shards too small to bite and every crystal somebody has already broken.
fn spawn_clear() = 2.0

fn off_the_glass(w, x, z) =
  cb = peek_ptr(w, 66)
  if is_null(cb) then true else glass_scan(cb, to_int(peek_f32(w, 58)), x, z, 0)

fn glass_scan(cb, n, x, z, i) =
  if i >= n then true else if inside_glass(cb, i, x, z) then false else glass_scan(cb, n, x, z, i + 1)

fn inside_glass(cb, i, x, z) =
  at = i * 8
  sc = peek_f32(cb, at + 3)
  if sc < 0.35 then false
  else
    dx = peek_f32(cb, at) - x
    dz = peek_f32(cb, at + 2) - z
    r = 0.55 * sc + zap_reach() + spawn_clear()
    dx * dx + dz * dz < r * r

fn place_player(s) =
  # Standing somewhere new with a full pack: a respawn is not the moment to
  # find out the last flight emptied it.
  poke_f32(s, 244, 1.0)
  poke_f32(s, 245, 0.0)
  poke_f32(s, 246, 0.0)
  # No key behind them, and no press to be the second of: somebody put down
  # here with the space bar already held does not take off on the first frame.
  poke_f32(s, jet_was(), 1.0)
  poke_f32(s, jet_since(), 99.0)
  poke_f32(s, jet_armed(), 0.0)
  poke_f32(s, h_crouch(), 0.0)
  # Who, when, and whatever the caller has stirred in: without the clock every
  # respawn is the same spot for the same person, which is the old problem with
  # extra steps.
  #
  # The clock is enough for a *re*spawn and not for a first one. A browser on
  # its own is player nought in a valley whose clock has not started, so both
  # terms are nought and the seed is the same number every time the page is
  # opened: the same tree, the same view, every single run. Slot 124 is what
  # the caller may add — the page rolls one before it places anybody, see
  # `spawn_salt` — and it is nought on the server, where spawns are already
  # spread by an id that counts up and a clock that has been running.
  w = wd(s)
  seed = peek_f32(s, 99) * 1.618 + peek_f32(w, 28) * 0.37 + peek_f32(s, 124)
  t = spawn_try(w, seed, 0)
  # The old corner, which is the one patch of this valley nothing was ever
  # placed on: `placed` turns down every candidate inside `near_spawn`, so the
  # fallback is nine metres clear of the nearest crystal by construction.
  x = if t >= spawn_tries() then 0.0 - 14.0 else spawn_x(seed, t)
  z = if t >= spawn_tries() then 0.0 - 34.0 else spawn_z(seed, t)
  # The carved floor, not the original one: a spawn over somebody's pit is a
  # fall into it, which is at least honest, but a spawn *in* the ground the
  # digging removed would be standing on air that used to be rock.
  y = floor_at(w, x, z)
  poke_f32(s, 19, 2.75)
  poke_f32(s, 20, 0.0 - 0.1)
  poke_f32(s, 21, x)
  poke_f32(s, 22, y)
  poke_f32(s, 23, z)
  poke_f32(s, 24, 0.0)
  poke_f32(s, 25, 1.0)
  poke_f32(s, 16, x)
  poke_f32(s, 17, y + 1.75)
  poke_f32(s, 18, z)
  poke_f32(s, 82, 1.0)
  poke_f32(s, 115, 1.0)
  poke_f32(s, 116, 0.0)
  poke_f32(s, 118, to_float(mag_size()))
  poke_f32(s, 119, 2.0)
  poke_f32(s, 120, to_float(rocket_full()))
  poke_f32(s, 106, to_float(ak_full()))
  poke_f32(s, 117, to_float(ak_mag_count() - 1))
  poke_f32(s, 252, to_float(mg_full()))
  poke_f32(s, 254, to_float(mg_belt_count() - 1))
  poke_f32(s, 84, 0.0)
  poke_f32(s, 85, 0.0)
  poke_f32(s, 107, 0.0)
  poke_f32(s, 30, 0.0)
  poke_f32(s, 31, 0.0)
  poke_f32(s, 52, 0.0 - 99.0)
  1

# What the caller adds to a spawn's seed, and it stays on the block: set it
# once and every place this player is put afterwards is drawn from the same
# roll. Nought until somebody sets it, which is the server's case and leaves
# its spawns exactly where they were.
fn spawn_salt(s: Ptr, v: Float) =
  poke_f32(s, 124, v)
  1

# A block for one more person, or null when the valley is full. The id it
# carries is never reused, which is what lets a round in the air outlive the
# table slot of whoever fired it.
fn join(w: Ptr) -> Ptr =
  if player_count(w) == player_cap() then null_ptr() else admit(w)

fn admit(w) =
  s = alloc_bytes(1024)

  # `alloc_bytes` hands back whatever was there, and the host reads the whole
  # block: a matrix of old bytes is a frame drawn from nowhere.
  for i in 0..256
    poke_f32(s, i, 0.0)

  n = player_count(w)
  id = peek_f32(w, 100)
  poke_ptr(s, 94, w)
  poke_f32(s, 99, id)
  # Long ago, so the first name anybody asks for is never one that is refused.
  poke_f32(s, 108, 0.0 - 1000.0)
  poke_f32(s, 51, peek_f32(w, 28))
  poke_f32(w, 100, id + 1.0)
  poke_ptr(peek_ptr(w, 96), n, s)
  poke_f32(w, 98, to_float(n + 1))
  place_player(s)
  set_sun(s, 0.58, 0.0 - 0.62, 0.0 - 0.52)
  s

# By the id rather than by the pointer, because a block is found by what it
# says it is and two pointers being the same is not a question this language
# asks.
fn index_of(w, id, i) =
  if i == player_count(w) then 0 - 1 else if peek_f32(player_at(w, i), 99) == id then i else index_of(w, id, i + 1)

# Out of the table and freed. The last one in the table takes the empty place,
# so the table stays packed and `for i in 0..player_count(w)` remains the only
# way anything here walks it.
fn leave(w: Ptr, s: Ptr) =
  n = player_count(w)
  i = index_of(w, peek_f32(s, 99), 0)
  if i < 0 then 0 else drop_at(w, i, n)

fn drop_at(w, i, n) =
  gone = player_at(w, i)
  poke_ptr(peek_ptr(w, 96), i, player_at(w, n - 1))
  poke_f32(w, 98, to_float(n - 1))
  free_ptr(gone)
  1

fn player_id(s: Ptr) -> Int = to_int(peek_f32(s, 99))

fn players(w: Ptr) -> Int = player_count(w)

fn player_block(w: Ptr, i: Int) -> Ptr = player_at(w, i)

# ---- reading it from outside -----------------------------------------------
#
# What a server has to put on the wire, and what a client has to put back.
# They are one line each and they are here rather than in the server because
# the slot numbers are this file's business — a second file that knew the
# state block by heart would be a second file to change when it moves.

# ---- what one player can see of another -------------------------------------
#
# The snapshot used to carry everybody's position to everybody, whether or not
# there was any way to look at them. Nothing a browser does can fix that: a
# client that has been told where somebody is can draw them through a hill, and
# a client that has not cannot. So the answer has to be here, and it is the
# only one of the three defences in this file that a modified client cannot
# work around — it is not a rule it is asked to follow, it is a fact it is not
# told.
#
# The line is eye to eye, which makes it the same question both ways round and
# is close enough: a head that is behind the ridge takes the rest with it. The
# ground is allowed to come up to a third of a metre above the line before it
# counts as blocking, so that somebody standing right on a crest reads as
# visible rather than flickering between the two as they breathe.
#
# Trees and crystals are not asked. They are thin, they move, and a defence
# that hides somebody behind a sapling costs more in shots that should have
# landed than it takes away from anybody cheating.

fn eye_up() = 1.62

fn sight_slack() = 0.33

# One sample every three metres, and never more than twenty-four of them: the
# far end of the valley is a hundred and fifty metres away and sampling it
# every three would cost fifty for a pair nobody can make out anyway.
fn sight_steps(d) = if d < 12.0 then 4 else if d > 72.0 then 24 else to_int(d / 3.0)

fn can_see(a: Ptr, b: Ptr) -> Int =
  ax = player_x(a)
  ay = player_y(a) + eye_up()
  az = player_z(a)
  bx = player_x(b)
  by = player_y(b) + eye_up()
  bz = player_z(b)
  dx = bx - ax
  dz = bz - az
  clear_to(ax, ay, az, bx, by, bz, sight_steps(sqrt(dx * dx + dz * dz)), 1)

fn clear_to(ax, ay, az, bx, by, bz, n, i) =
  if i >= n then 1 else if blocked_at(ax, ay, az, bx, by, bz, to_float(i) / to_float(n)) then 0 else clear_to(ax, ay, az, bx, by, bz, n, i + 1)

fn blocked_at(ax, ay, az, bx, by, bz, t) =
  height(ax + (bx - ax) * t, az + (bz - az) * t) > ay + (by - ay) * t + sight_slack()

# Whether the feet are down. One while standing on something, nought in the
# air — the world's own word for it, and the only thing the weapon's stride
# needs to know about jumping.
fn grounded(s: Ptr) -> Float = peek_f32(s, 25)

# What the legs did on the last step, in metres a second. Written by `walk`.
fn stride_speed(s: Ptr) -> Float = peek_f32(s, 242)

fn player_x(s: Ptr) -> Float = peek_f32(s, 21)

fn player_y(s: Ptr) -> Float = peek_f32(s, 22)

fn player_z(s: Ptr) -> Float = peek_f32(s, 23)

fn player_yaw(s: Ptr) -> Float = peek_f32(s, 19)

fn player_pitch(s: Ptr) -> Float = peek_f32(s, 20)

# Where someone is looking is theirs to decide: a server that corrected an aim
# would be a server that moved somebody's crosshair while they were using it.
# Where they *are* is the server's, which is the other half of `walk`.
# The look is the client's to decide and the server's to keep sane. Pitch is
# held to the same limits `walk` holds it to — a browser clamps its own, and a
# server that took a client's word for it would let somebody aim through their
# own feet. Yaw wraps, so it is only kept finite and inside a turn or two;
# `sin` and `cos` do the rest.
fn set_look(s: Ptr, yaw: Float, pitch: Float) =
  poke_f32(s, 19, clamped(yaw, 0.0 - 100.0, 100.0))
  poke_f32(s, 20, clamped(pitch, 0.0 - pitch_max(), pitch_max()))
  1

fn set_at(s: Ptr, x: Float, y: Float, z: Float) =
  poke_f32(s, 21, x)
  poke_f32(s, 22, y)
  poke_f32(s, 23, z)
  poke_f32(s, 16, x)
  poke_f32(s, 17, y + 1.75)
  poke_f32(s, 18, z)
  1

fn set_health(s: Ptr, h: Float) =
  poke_f32(s, 82, h)
  1

# What the server says is in the rifle. The browser keeps its own count so that
# the number falls on the frame the trigger was pulled rather than a tenth of a
# second later, and the two only ever disagree in that tenth of a second — the
# same code fires and the same code picks magazines up on both sides. So this
# is written only when the disagreement is bigger than the round trip can
# explain: a magazine one side saw and the other did not.
fn set_rounds(s: Ptr, n: Int) =
  poke_f32(s, 118, to_float(n))
  1

# ---- what a player has asked for -------------------------------------------
#
# A browser alone in the valley acts the moment the key goes down. A server
# cannot: it has to hold what arrived until the next tick, or how fast you walk
# and who shot first would both come down to how often your machine sent a
# packet. So an input is stored on the player and read by the tick — which is
# also what makes one tick a point in time everybody's inputs are resolved at.

# Only the seven bits that mean anything: forward, back, left, right, jump,
# sprint, crouch. What arrives is whatever somebody typed into a socket, and a
# key that is not a key should not be one the first time something new is
# hung off the eighth bit.
# The eighth bit is not a key. It is which weapon is up — the rifle or the
# launcher — and it travels in the same number for the same reason the keys do:
# a client that is telling a server what it is doing this frame is already
# sending one integer, and what it is holding is part of that. Nothing else in
# the message had to change and an old server simply masks it off.
fn set_keys(s: Ptr, keys: Int) =
  poke_f32(s, 30, to_float(bit_and(keys, 127)))
  # Two bits of weapon above the seven of movement, and a third parked out at
  # bit eleven: nought the rifle, one the launcher, two the AK, five the MG3.
  # The pair filled up the day the machine gun arrived, and the next bit in
  # line — nine — was already the lamp, ten already the pack, so the high bit
  # lives past both. An encoder that shifted five whole bits left would have
  # lit the lamp instead, which was checked before it was shipped rather than
  # after.
  said = bit_or(bit_and(shr(keys, 7), 3), shl(bit_and(shr(keys, 11), 1), 2))
  poke_f32(s, 119, if weapon_off(said) > 0 then peek_f32(s, 119) else to_float(said))
  # And the tenth bit is the lamp. It rides here for the reason the weapon
  # does — the message is already going and this is part of what somebody is
  # doing — and it is a *state* rather than a press, so a packet that goes
  # missing costs a frame of somebody else's light and nothing more. A press
  # sent once would leave the two ends disagreeing about a light for the rest
  # of the round.
  poke_f32(s, 123, to_float(bit_and(shr(keys, 9), 1)))
  1

# Whether this player's lamp is lit. The world does not care — it lights
# nothing here and costs nothing to carry — but everybody else's client does,
# so it goes out in the snapshot beside the pose.
fn torch(s: Ptr) -> Int = to_int(peek_f32(s, 123))

fn set_torch(s: Ptr, on: Int) =
  poke_f32(s, 123, to_float(on))
  1

# Which weapon is up: nought the rifle, one the launcher, two the AK.
fn weapon(s: Ptr) -> Int = to_int(peek_f32(s, 119))

fn set_weapon(s: Ptr, n: Int) =
  poke_f32(s, 119, to_float(n))
  1

# The two that are out of play: the pick and the wall.
#
# Taken out rather than deleted. Everything they are made of is still here —
# the digging, the voxels the pick opens, the courses a wall is built in, the
# stones in a pocket that pay for both — and none of it is reachable, because
# reaching it goes through one of three doors and all three ask this first:
# the key that chooses a weapon, the wheel that cycles through them, and the
# weapon a far end says it is holding. Deleting the code would have cost a
# week to write again; this costs one line to undo.
#
# It is asked of the far end too, and not only of this browser's keys. A
# player who is out of play here would otherwise be in play for everybody
# watching them, which is the sort of disagreement that only ever shows up in
# somebody else's screenshot.
fn weapon_off(n: Int) -> Int = yes(n == 3 || n == 4)

# How many rockets are left, and how many the tube holds. Fewer than the rifle
# has rounds by a long way: one of these is a meteor you aimed.
fn rockets(s: Ptr) -> Int = to_int(peek_f32(s, 120))

fn rocket_full() -> Int = 3

# How fast it leaves the tube. Five times the crystals' lobbed fourteen,
# because this is a thing that is aimed rather than arced. It shares their
# gravity — a third of the world's, which is the one unphysical number in this
# file — and at this speed that comes to eight tenths of a metre of drop at
# fifty and three and a third at a hundred, which is a weapon you lead with at
# range and point at anything close. Measured: a level shot travels two hundred
# and eighty metres in four seconds.
fn rocket_speed() = 70.0

fn keys_of(s: Ptr) -> Int = to_int(peek_f32(s, 30))

# When anything was last heard from them.
#
# A connection that is gone says so — the read comes back empty and the strand
# waiting on it ends. A connection whose far end fell asleep, lost its network
# or was unplugged says nothing at all, and TCP will not mention it for hours:
# the read simply never returns. So the only thing that can tell the two apart
# is the silence itself, and this is what measures it.
fn heard(s: Ptr, t: Float) =
  poke_f32(s, 51, t)
  1

fn last_heard(s: Ptr) -> Float = peek_f32(s, 51)

# Nothing off the wire is believed. A number that arrived from somewhere else
# is a number somebody chose, and `str_to_float` will hand back a NaN for
# "nan" and an infinity for "1e400" as happily as it hands back 2.75.
#
# NaN is the one that spreads: it compares false against everything, so a
# player at a NaN position is not hit by anything, is not seen by the shark,
# is always far enough away to be worth throwing at, and puts NaN into every
# snapshot everybody else reads.
fn finite(x) = if x == x then x else 0.0

fn clamped(x, lo, hi) = clampf(finite(x), lo, hi)

# Where the sights point, made a unit vector here rather than trusted.
#
# `fire` multiplies this by the muzzle velocity, so a client that sent a
# direction a million long got a round at a hundred thousand kilometres a
# second — one that crosses the whole valley inside a single step, and the
# segment it sweeps takes out every crystal along a line through the world. A
# rifle, not a rail gun. A direction too short to normalise is no direction,
# and the shot is dropped.
fn want_fire(s: Ptr, dx0: Float, dy0: Float, dz0: Float) =
  dx = finite(dx0)
  dy = finite(dy0)
  dz = finite(dz0)
  l = sqrt(dx * dx + dy * dy + dz * dz)
  if l < 0.001 then 0 else aim_at(s, dx / l, dy / l, dz / l)

fn aim_at(s, dx, dy, dz) =
  if faces(s, dx, dy, dz) == 0 then refused(s) else asked(s, dx, dy, dz)

# Refusing the shot is the whole defence; counting the refusals is what makes
# it worth having.
#
# The client we ship cannot produce one of these. It works out the direction
# from the same camera matrix it just sent the look from, so the two disagree
# by at most one frame of turning — nine degrees at twenty frames a second and
# a half-turn every second, and the slack is twenty. A run of them is not a bad
# connection or an unlucky flick. It is somebody talking to the socket with
# something that is not our client, and it is the clearest single signal this
# server can get.
#
# A streak rather than a total: the honest number is zero, so anything that
# reaches the limit did it in one breath. The count is not logged as it climbs
# — a client can ask to fire a hundred and fifty times a second, and a line
# each would be a way to fill the disk from outside.
fn refused(s) =
  poke_f32(s, 114, peek_f32(s, 114) + 1.0)
  0

fn wild_limit() = 12

# For the server, which drops them the way it drops anyone who has gone quiet.
fn shooting_wild(s: Ptr) -> Int =
  yes(peek_f32(s, 114) >= to_float(wild_limit()))

# A shot has to go roughly where its owner says they are looking.
#
# The look and the shot arrive on separate lines and the server keeps only the
# latest of each, so they can be a frame apart on a fast turn — twenty degrees
# of slack covers that and more. What it does not cover is a hundred and
# eighty: without this a client could face north and put a round through
# somebody standing south of it, and everybody else would watch it stare into
# the distance while they fell over.
#
# It does not stop anybody aiming perfectly — that is between a player and
# their own mouse, and no server can see the difference. It makes them turn to
# do it, which is the part everybody else can see.
fn faces(s, dx, dy, dz) =
  cp = cos(peek_f32(s, 20))
  fx = sin(peek_f32(s, 19)) * cp
  fy = sin(peek_f32(s, 20))
  fz = (0.0 - cos(peek_f32(s, 19))) * cp
  yes(fx * dx + fy * dy + fz * dz > 0.94)

# How many asks may be waiting at once, and how many gaps of credit the fire
# clock may fall behind by.
#
# Two, not three. It is the smallest number that repairs what it is for — two
# messages landing in one tick window, which is the whole of the jitter this
# gun cannot absorb — and every number above it is a number of rounds the
# server may fire *ahead* of the player at the start of a burst, which is the
# same disagreement in the other direction. Measured over the wire at three:
# the server took two in one tick and stayed a round in front for the rest of
# the belt.
fn ask_cap() = 2.0

fn asked(s, dx, dy, dz) =
  poke_f32(s, 114, 0.0)
  # A count, not a flag.
  #
  # It was a flag, and a flag is a shot dropped every time two arrive between
  # one tick and the next. That is not a rare event for the MG3: the server
  # ticks every fifty milliseconds and the gun's gap *is* fifty milliseconds,
  # so a client firing exactly on rate has one message per tick and no margin
  # at all — the first piece of jitter puts two in one window, the second
  # window gets none, and one round is gone from the server's count for good.
  # The AK never showed it because its gap is two ticks wide.
  #
  # And gone from the server's count means the server has *more* rounds left
  # than the player does. Once the two differ by more than `ammo_slack`, the
  # page obeys the server — which is a magazine refilling itself while you
  # hold the trigger down, in the corner of the screen, over and over.
  poke_f32(s, 31, min(peek_f32(s, 31) + 1.0, ask_cap()))
  poke_f32(s, 48, dx)
  poke_f32(s, 49, dy)
  poke_f32(s, 50, dz)
  1

# Takes the shot, if one was asked for and the bolt is closed and the rifle is
# not under water. `gap` is how long working the bolt takes: the animation is
# the browser's, but a client that simply did not play it could otherwise send
# five hundred rounds a second.
fn try_fire(s: Ptr, tnow: Float, gap: Float) =
  # Every ask that is waiting and that the gap will allow, not one of them.
  #
  # One a tick was the ceiling before, and for a gun whose gap is exactly one
  # tick that ceiling is also the floor: it could match a client firing on
  # rate and it could never make up a single round it had missed. It missed
  # them constantly — see `asked`.
  take_all(s, tnow, gap, to_int(peek_f32(s, 31)))

# Three answers, not two, and the third is the one that makes this work.
#
#    1  fired
#    0  the gap said not yet — the ask is still a good ask and waits
#   -1  refused for a reason that will not improve by waiting: under water,
#       down, or nothing left in the gun
#
# Keeping a gap-refused ask is the whole of how the server catches up. The
# client fires on a fifty-millisecond clock and the server ticks on one of
# its own; the two beat against each other, so a tick sees two asks and the
# next sees none. Discard the second one and the round is gone for good —
# which is the drift that had the belt filling itself back up on screen. Hold
# it, and it is fired on the next tick, where there was going to be nothing to
# fire anyway. Nothing is banked beyond `ask_cap`, so the catching up cannot
# turn into a burst.
fn take_all(s, tnow, gap, left) =
  if left <= 0 then 0
  else
    took = take_fire(s, tnow, gap)
    if took < 0 then
      poke_f32(s, 31, 0.0)
      0
    else if took == 0 then 0
    else
      poke_f32(s, 31, max(peek_f32(s, 31) - 1.0, 0.0))
      take_all(s, tnow, gap, left - 1)

fn take_fire(s, tnow, gap) =
  # The bolt's gap for the rifle, its own hundred milliseconds for the AK. The
  # launcher rides the rifle's — its real cycle is the client's animation and
  # the tube's own count.
  g = if weapon(s) == 2 then ak_gap() else if weapon(s) == 5 then mg_gap() else gap
  # How far behind the gap's own clock is allowed to fall. Without a floor a
  # player who held their fire for a minute would come back with a minute of
  # credit and empty a belt in one tick; with it, the most anybody can bank is
  # the same few shots `ask_cap` already lets them ask for.
  last = max(peek_f32(s, 52), tnow - g * ask_cap())
  # Half a millisecond of tolerance, because the clock this is compared
  # against is a sum of tick lengths and the gap is a literal: at the MG3's
  # fifty milliseconds the two land on either side of each other depending on
  # the last bit of a float, and a shot that is a millionth of a second early
  # is a shot. It is half a millisecond in fifty — one part in a hundred of
  # the rate limit, and it buys a gate that answers the same way twice.
  if tnow - last < g - 0.0005 then 0
  else if in_water(s) > 0 then 0 - 1
  else if peek_f32(s, 82) < 0.001 then 0 - 1
  else if may_fire(s) < 1 then 0 - 1
  else
    # An empty magazine is the one refusal that is not about the shot being
    # wrong, so it does not count against the wild-shot allowance either: the
    # trigger is being pulled honestly, there is simply nothing in there.
    #
    # And the clock moves on by exactly one gap rather than snapping to now,
    # which is the whole of how a shot that arrived late is still a shot. It
    # snapped, and every snap threw away the fraction of a gap that a client
    # firing on rate has no spare of at all.
    poke_f32(s, 52, last + g)
    fire(s, peek_f32(s, 48), peek_f32(s, 49), peek_f32(s, 50))

fn world_time(w: Ptr) -> Float = peek_f32(w, 28)

fn set_world_time(w: Ptr, t: Float) =
  poke_f32(w, 28, t)
  1

# The shark, which is one animal and so is six numbers rather than a buffer.
fn shark_x(w: Ptr) -> Float = peek_f32(w, 86)

fn shark_y(w: Ptr) -> Float = peek_f32(w, 87)

fn shark_z(w: Ptr) -> Float = peek_f32(w, 88)

fn shark_heading(w: Ptr) -> Float = peek_f32(w, 89)

fn shark_mode(w: Ptr) -> Float = peek_f32(w, 90)

fn set_shark(w: Ptr, x: Float, y: Float, z: Float, hd: Float, mode: Float, gape: Float) =
  poke_f32(w, 86, x)
  poke_f32(w, 87, y)
  poke_f32(w, 88, z)
  poke_f32(w, 89, hd)
  poke_f32(w, 90, mode)
  poke_f32(w, 93, gape)
  1

# The rings, as an event log. Each cursor only ever counts up, so the
# difference between what a client was last told and what the cursor says now
# is exactly the set of rounds, throws and craters it has not heard about —
# and each of those is a slot that can be read back out and sent.
fn shots(w: Ptr) -> Int = to_int(peek_f32(w, 60))

fn throws(w: Ptr) -> Int = to_int(peek_f32(w, 63))

fn bullet_f(w: Ptr, k: Int, j: Int) -> Float =
  peek_f32(peek_ptr(w, 68), k % bullet_cap() * bullet_stride() + j)

fn fireball_f(w: Ptr, k: Int, j: Int) -> Float =
  peek_f32(peek_ptr(w, 74), k % fireball_cap() * fireball_stride() + j)

fn blast_f(w: Ptr, k: Int, j: Int) -> Float =
  peek_f32(peek_ptr(w, 81), k % blast_cap() * blast_stride() + j)

fn crystal_scale(w: Ptr, i: Int) -> Float = peek_f32(peek_ptr(w, 66), i * 8 + 3)

# Which crystal the k'th break was. Only the last thirty-two are recoverable,
# which is a second and a half of the busiest the valley gets.
fn break_which(w: Ptr, k: Int) -> Int = ring_at(w, 97, break_ring(), k)

# ---- putting one back ------------------------------------------------------
#
# What a client does with an event: it did not decide any of this, it is being
# told, and every one of these is the same write the world made when it
# happened there.

fn put_bullet(w: Ptr, x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, owner: Float) =
  b = peek_ptr(w, 68)
  k = to_int(peek_f32(w, 60))
  at = k % bullet_cap() * bullet_stride()
  poke_f32(b, at, x)
  poke_f32(b, at + 1, y)
  poke_f32(b, at + 2, z)
  poke_f32(b, at + 3, vx)
  poke_f32(b, at + 4, vy)
  poke_f32(b, at + 5, vz)
  poke_f32(b, at + 6, owner)
  poke_f32(b, at + 7, bullet_life())
  poke_f32(w, 60, to_float(k + 1))
  1

fn put_fireball(w: Ptr, x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, seed: Float, life: Float) =
  fb = peek_ptr(w, 74)
  k = to_int(peek_f32(w, 63))
  at = k % fireball_cap() * fireball_stride()
  poke_f32(fb, at, x)
  poke_f32(fb, at + 1, y)
  poke_f32(fb, at + 2, z)
  poke_f32(fb, at + 3, vx)
  poke_f32(fb, at + 4, vy)
  poke_f32(fb, at + 5, vz)
  poke_f32(fb, at + 6, seed)
  poke_f32(fb, at + 7, life)
  poke_f32(fb, at + 8, 0.0)
  poke_f32(w, 63, to_float(k + 1))
  1

# The crater, the debris and the tally — but not the damage, which the server
# has already worked out and will send as a health.
fn put_blast(w: Ptr, x: Float, y: Float, z: Float, seed: Float) =
  bb = peek_ptr(w, 81)
  k = to_int(peek_f32(w, 80))
  at = k % blast_cap() * blast_stride()
  poke_f32(bb, at, x)
  poke_f32(bb, at + 1, y)
  poke_f32(bb, at + 2, z)
  poke_f32(bb, at + 3, seed)
  poke_f32(bb, at + 4, 0.0)
  poke_f32(w, 80, to_float(k + 1))
  sb = peek_ptr(w, 69)
  k0 = to_int(peek_f32(w, 61))

  for j in 0..18
    spawn_shard(sb, k0 + j, x, y, z, 1.1, 0.34, 0.13, 0.05, 1.9, 0.0, seed * 97.0 + to_float(j))

  poke_f32(w, 61, to_float(k0 + 18))
  1

# A crystal that was already gone when this page arrived. Not `put_break`:
# that is what a crystal *doing* means — eight chips, a bang and a tally — and
# a valley that has been running an hour would arrive as three hundred
# simultaneous explosions.
fn put_gone(w: Ptr, i: Int) =
  poke_f32(peek_ptr(w, 66), i * 8 + 3, 0.0)
  1

fn put_break(w: Ptr, i: Int) =
  cb = peek_ptr(w, 66)
  cat = i * 8
  if peek_f32(cb, cat + 3) < 0.01 then 0 else break_crystal(w, cb, cat, i)

# Where the light comes from, this frame. The host works out the swing and
# hands it over here, so the shadow matrix and the sun in the sky are the same
# sun and cannot drift apart.
fn set_sun(s: Ptr, dx: Float, dy: Float, dz: Float) =
  il = 1.0 / sqrt(dx * dx + dy * dy + dz * dz)
  light_vp(s, dx * il, dy * il, dz * il)

fn terrain(s: Ptr) -> Ptr = peek_ptr(wd(s), 64)

fn terrain_verts(s: Ptr) -> Int = to_int(peek_f32(wd(s), 56))

fn pines(s: Ptr) -> Ptr = peek_ptr(wd(s), 65)

# How many poplars a valley of this many pines has. A third, which came out
# of looking at it: fewer and the shore reads as a few stray trees, more and
# the belt closes into a second forest and the lake stops being open.
fn poplar_cap(npine: Int) -> Int = npine / 3

fn poplars(s: Ptr) -> Ptr = peek_ptr(wd(s), 70)

fn poplar_count(s: Ptr) -> Int = to_int(peek_f32(wd(s), 252))

fn pine_count(s: Ptr) -> Int = to_int(peek_f32(wd(s), 57))

# The boulders, and where their two slots came from.
#
# The world block is full below a hundred and twenty-eight, which is where
# `tools/slots.py` looks — so both of these are picked the way the note above
# `block_size` says they have to be: a pointer whose float twin belongs to a
# *player* and never to the world, and a count high enough that no pointer
# reaches it. Pointer ninety-nine is a player's own id, which no world block
# has; float two hundred and forty-nine is a player's jetpack arming flag,
# and its native pointer twin is slot a hundred and twenty-four, unclaimed.
# Neither block is ever the other, which is the whole of why this is safe —
# the same reason the nine pairs in `slots.py`'s own list are safe.
fn rocks(s: Ptr) -> Ptr = peek_ptr(wd(s), 99)

fn rock_count(s: Ptr) -> Int = to_int(peek_f32(wd(s), 249))

fn crystals(s: Ptr) -> Ptr = peek_ptr(wd(s), 66)

fn crystal_count(s: Ptr) -> Int = to_int(peek_f32(wd(s), 58))

fn grass(s: Ptr) -> Ptr = peek_ptr(wd(s), 67)

fn grass_count(s: Ptr) -> Int = to_int(peek_f32(wd(s), 59))

# The terrain function itself, for the host to sample: the water mesh carries
# the exact depth under every vertex, so the shore foam sits where the shore
# is rather than where a 32-bit re-derivation guesses it might be.
fn ground(x: Float, z: Float) -> Float = height(x, z)

# ---- what grows on the bottom of the lake, and what flies over the meadow ---
#
# Both of these were scattered in host.js with `Math.random`, and they were
# the last two things in this world placed that way. Everything else — the
# pines, the poplars, the crystals, the grass, the flowers, the walls — is a
# deterministic walk over a hash, which is what lets a server say "four
# hundred pines" and every browser grow the same forest from it.
#
# So every player had *different* weed on the same lakebed, and the difference
# could not be talked about: not on the wire, not in a test, not between two
# people looking at the same patch of sand. Nothing in the simulation touches
# a frond, so nothing broke — but "nothing depends on it" is a reason to keep
# it cheap, not a reason to keep it unrepeatable.
#
# They are filled into a buffer the caller owns rather than into the world,
# because that is what they are: a picture, asked for when the renderer is
# built and thrown away when the tier changes.

fn weed_beds() = 110
fn weed_per() = 16
fn weed_cap() = weed_beds() * weed_per()
# Most of the valley is not lakebed, so most candidate centres are thrown
# away. Thirty tries a bed is what it takes to find a hundred and ten.
fn weed_tries() = weed_beds() * 30

# Where a frond will stand, or a number no depth can be. Off the shallows as
# well as off the land: a plant in ten centimetres of water sticks out of it,
# which reads as weed growing on a beach.
fn weed_deep(x, z) =
  y = height(x, z)
  if y < 0.0 - 0.9 && y > 0.0 - 11.0 then y else 999.0

fn weed_build(out: Ptr, cap: Int) -> Int = weed_bed(out, cap, 0, 0, 0)

# In beds, not sprinkled. Weed spreads from where weed already is, so an even
# scatter over a lakebed is the one arrangement it never takes: what it makes
# is patches, thick in the middle and thinning at the edge, with clear sand
# between them.
fn weed_bed(out, cap, try, beds, n) =
  if try >= weed_tries() || beds >= weed_beds() || n >= cap then n
  else
    cx = (hash2(to_float(try), 11.0) - 0.5) * 156.0
    cz = (hash2(to_float(try), 29.0) - 0.5) * 156.0
    if weed_deep(cx, cz) > 900.0 then weed_bed(out, cap, try + 1, beds, n)
    else weed_bed(out, cap, try + 1, beds + 1,
                  weed_fill(out, cap, try, cx, cz,
                            1.1 + hash2(to_float(try), 47.0) * 2.4, 0, n))

# Every frond is put to the depth test again, so a bed that runs over the
# shoreline stops at the shoreline instead of climbing out of the water.
fn weed_fill(out, cap, try, cx, cz, spread, k, n) =
  if k >= weed_per() || n >= cap then n
  else
    sd = to_float(try * 32 + k)
    # Square-rooted, so a bed is dense at its middle and thins outward rather
    # than being a disc of even scatter.
    a = hash2(sd, 3.0) * 6.28318
    r = sqrt(hash2(sd, 7.0)) * spread
    x = cx + cos(a) * r
    z = cz + sin(a) * r
    y = weed_deep(x, z)
    if y > 900.0 then weed_fill(out, cap, try, cx, cz, spread, k + 1, n)
    else weed_fill(out, cap, try, cx, cz, spread, k + 1,
                   n + weed_one(out, n * 8, x, y, z, sd))

fn weed_one(out, at, x, y, z, sd) =
  poke_f32(out, at, x)
  # Rooted a little under the sand, so the base of the card is not a visible
  # edge where it meets the bottom.
  poke_f32(out, at + 1, y - 0.05)
  poke_f32(out, at + 2, z)
  poke_f32(out, at + 3, 0.85 + hash2(sd, 13.0) * 1.5)
  poke_f32(out, at + 4, hash2(sd, 19.0) * 6.28318)
  poke_f32(out, at + 5, 0.12 + hash2(sd, 23.0) * 0.22)
  poke_f32(out, at + 6, 0.30 + hash2(sd, 29.0) * 0.30)
  poke_f32(out, at + 7, 0.18 + hash2(sd, 31.0) * 0.22)
  1

# The fireflies' starting places. The compute shader takes them from here and
# never asks again — it is a seed, not a state — so this is the one moment
# their arrangement is decided, and it may as well be decided the same way
# twice.
fn fly_seed(out: Ptr, n: Int) -> Int = fly_one(out, n, 0)

fn fly_one(out, n, i) =
  if i >= n then n
  else
    sd = to_float(i)
    a = hash2(sd, 5.0) * 6.28318
    r = 12.0 + hash2(sd, 17.0) * 32.0
    poke_f32(out, i * 8, cos(a) * r)
    poke_f32(out, i * 8 + 1, 1.0 + hash2(sd, 23.0) * 3.5)
    poke_f32(out, i * 8 + 2, sin(a) * r)
    poke_f32(out, i * 8 + 3, hash2(sd, 37.0))
    fly_one(out, n, i + 1)

# Hands a world back. `alloc_bytes` is malloc, so `free_ptr` is its pair;
# the host calls this before asking for the valley at another resolution.
fn free_world(s: Ptr) =
  w = wd(s)

  # Whoever is still standing in it. The blocks are the world's to free: a
  # player that has not left is not a player that can be asked to.
  for i in 0..player_count(w)
    free_ptr(player_at(w, i))

  free_ptr(peek_ptr(w, 96))
  free_ptr(peek_ptr(w, 64))
  free_ptr(peek_ptr(w, 65))
  free_ptr(peek_ptr(w, 66))
  free_ptr(peek_ptr(w, 67))
  # The projectiles too. These were never freed — the host asks for the valley
  # at another resolution a few times while it settles on one, and each of
  # those left the rounds, the shards, the fireballs, the chargers and the
  # blasts behind it.
  free_ptr(peek_ptr(w, 68))
  free_ptr(peek_ptr(w, 69))
  free_ptr(peek_ptr(w, 74))
  free_ptr(peek_ptr(w, 77))
  free_ptr(peek_ptr(w, 81))
  free_ptr(peek_ptr(w, 97))
  free_ptr(peek_ptr(w, 85))
  free_ptr(w)

# ---- wind -------------------------------------------------------------------
#
# One wind for the whole valley: a direction that wanders and a moderate
# strength that gusts. The water's ripples, the pines and the grass all read
# these two numbers — movement agreeing about its cause is what makes it
# read as weather rather than as three separate effects.

fn wind_angle(t) = 2.1 + 0.5 * sin(t * 0.05) + 0.17 * sin(t * 0.13)

fn wind_strength(t) =
  g = 0.55 + 0.22 * sin(t * 0.31) + 0.13 * sin(t * 0.83 + 1.7) + 0.06 * sin(t * 2.3)
  clampf(g, 0.15, 1.0)

# What everything that sways reads its phase from, rather than the clock.
#
# The rate a tree flutters at rises with the wind, and the obvious way to
# write that — `sin(t * rate(t))` — is wrong: differentiate it and the angular
# velocity is `rate + t * rate'`, so a change in the wind moves the phase by
# that change times however long the program has been running. A minute in, a
# gust makes everything shiver; an hour in it tears. The phase has to be
# integrated instead, a step at a time, and then a change in the wind changes
# only what happens next.
fn wind_rate(w) = 1.0 + 2.0 * w

# ---- collision --------------------------------------------------------------
#
# The player is a circle; a trunk or a crystal is a circle of its own scale.
# Overlap pushes the player back to the boundary. The camera's position lives
# in the state, so the loop reads it, resolves one instance, writes it back
# and moves on — the state block doubling as the accumulator.

fn collide_all(s, buf, n, factor) =
  for i in 0..n
    collide_one(s, buf, i, factor)

# Nothing under a hundredth of scale stops anybody: a broken crystal is a heap
# of glass, not a post, and a felled pine — whose mark is a *negative* scale —
# is a log you step over rather than a trunk you walk into.
fn collide_one(s, buf, i, factor) =
  sc = peek_f32(buf, i * 8 + 3)
  if sc <= 0.01 then 1 else collide_live(s, buf, i, factor, sc)

fn collide_live(s, buf, i, factor, sc) =
  ix = peek_f32(buf, i * 8)
  iz = peek_f32(buf, i * 8 + 2)
  r = factor * sc + 0.35
  dx = peek_f32(s, 21) - ix
  dz = peek_f32(s, 23) - iz
  d2 = dx * dx + dz * dz
  if d2 < r * r && d2 > 0.0001 then push_out(s, ix, iz, dx, dz, sqrt(d2), r) else 1

# Stone is solid to walk into as well as to shoot at, and it needs two things
# the trunks and the crystals do not.
#
# A block that has been shot has its size set to nought, and the general test
# adds 0.35 to whatever the size is — so a destroyed block would go on stopping
# people with a thirty-five centimetre post standing where it used to be.
#
# And a wall is stacked. The blocks are laid three high, so a test that only
# looks at x and z stops you at every height at once: blow the bottom out of a
# wall and you would still be walking into the one left floating above the
# hole. This asks whether the block is where the body is, which is what lets
# somebody through a breach and under an overhang.
fn collide_walls(s, w) =
  wb = wall_box(w)
  bb = blocks_ptr(w)

  for k in 0..wall_cap()
    collide_one_wall(s, wb, bb, k)

fn collide_one_wall(s, wb, bb, k) =
  if wall_near(wb, k, peek_f32(s, 21), peek_f32(s, 22) + 1.0, peek_f32(s, 23), 1.5) then wall_blocks_push(s, bb, k) else 0

fn wall_blocks_push(s, bb, k) =
  base = k * wall_blocks()

  for j in 0..wall_blocks()
    collide_block(s, bb, base + j)
  0

fn collide_block(s, bb, i) =
  sc = block_f(bb, i, 3)
  if sc < 0.01 then 0
  else
    feet = peek_f32(s, 22)
    by = block_f(bb, i, 1)
    if by + sc * 0.5 < feet + 0.25 then 0 else if by - sc * 0.5 > feet + 1.7 then 0 else block_push(s, bb, i, sc)

fn block_push(s, bb, i, sc) =
  ix = block_f(bb, i, 0)
  iz = block_f(bb, i, 2)
  r = sc * 0.72 + 0.35
  dx = peek_f32(s, 21) - ix
  dz = peek_f32(s, 23) - iz
  d2 = dx * dx + dz * dz
  if d2 < r * r && d2 > 0.0001 then push_out(s, ix, iz, dx, dz, sqrt(d2), r) else 1

fn push_out(s, ix, iz, dx, dz, d, r) =
  poke_f32(s, 21, ix + dx / d * r)
  poke_f32(s, 23, iz + dz / d * r)
  1

# ---- one step of the walk --------------------------------------------------
#
# `keys` is a bitmask: 1 forward, 2 back, 4 left, 8 right, 16 jump,
# 32 sprint. Mouse movement arrives in pixels and leaves as radians.

fn walk_axis(keys, plus, minus) =
  a = if bit_and(keys, plus) == plus then 1.0 else 0.0
  b = if bit_and(keys, minus) == minus then 1.0 else 0.0
  a - b

# Radians of turn per pixel of mouse. A number rather than two, because yaw
# and pitch reading differently is the thing that makes aiming feel wrong and
# nobody can say why.
#
# This was 0.0026, which is about a hundred and fifty degrees across a hand's
# worth of desk — quick enough to spin round, and quicker than a rifle wants:
# putting the crosshair on somebody across the meadow meant a movement smaller
# than the smallest one a hand makes on purpose. The scope divides this by its
# magnification already, so the far shot was the one that suffered.
fn look_per_pixel() = 0.0018

# ---- what the planet pulls with ---------------------------------------------
#
# Twenty-six metres a second squared, which is not Earth and never was: this
# valley was tuned by eye long before anything here asked what a planet is,
# and two and a half gravities is what a jump that reads as a jump felt like
# at these walking speeds. It lives on the world now rather than inside the
# fall, so it can be turned — and everything that answers to it answers on
# its own terms rather than by a second number somebody has to remember to
# change too.
#
# What follows from it, and what does not:
#
#   The legs push the same. `jump_vel` is a speed, not a height — nine and a
#   half metres a second out of a standing start — so lowering gravity does
#   not make the legs stronger, it makes the same push carry further. At the
#   default that is a jump of one metre and three quarters; at a tenth of it,
#   seventeen.
#
#   The pack pushes proportionally. Its thrust is a multiple of gravity, so
#   it lifts on any planet rather than being a number that happens to beat
#   one particular fall. What it cannot do is exceed its own climb rate — see
#   `jet_climb` — so a weak planet gets you up no faster, only for longer.
#   Both of the pack's numbers doubled on 2026-08-29; the shape of that rule
#   did not.
fn gravity_default() = 26.0

fn gravity(w: Ptr) -> Float =
  g = peek_f32(w, 250)
  if g > 0.001 then g else gravity_default()

fn set_gravity(w: Ptr, g: Float) =
  poke_f32(w, 250, clampf(g, 0.5, 120.0))

fn jump_vel(keys, grounded, vy) =
  if bit_and(keys, 16) == 16 then if grounded > 0.5 then 9.5 else vy else vy

# ---- the pack ---------------------------------------------------------------
#
# The same key the legs use — a press is a jump, a second press soon after it
# is the pack. See `jet_watch` for which is which.
#
# Two and a bit seconds of burn, which is height enough to clear the pines and
# not enough to cross the valley: the point of it is to get somewhere a moment
# sooner and to be somewhere nobody expected, not to leave the ground behind.
# The doubling of 2026-08-29 raised what one tank buys from fifteen metres of
# climb to thirty-two — measured, not predicted: it is a shade over twice
# because the faster wind-up also spends less of the burn getting there, so
# more of the tank is flown at the ceiling. The tank itself was left where it
# was, so the pack is twice as strong and not one second longer.
#
# And it fills only while standing, at a sixth of the rate it empties. Two
# seconds of flight now costs thirteen on the ground.
#
# It was four and a half — half the burn rate — and at that price the pack was
# not a resource, it was a cooldown: by the time anybody had walked anywhere it
# was full again, so there was never a moment of choosing to keep it. At a
# sixth, spending it is a decision, and somebody who has just landed is
# somebody who cannot leave again for a while, which is worth something to the
# person watching them land.
fn jet_secs() = 2.2

fn jet_fill_secs() = 13.2

# Relit only after a quarter of the tank is back, for the reason the sprint is
# gated on a third: at nought exactly, held, it would be one frame of thrust
# for every frame of fall, which reads as a broken pack rather than an empty
# one.
fn jet_back() = 0.25

# Thrust as a multiple of the planet's own pull. Thirty-four tenths, so what
# is left after the fall is two and two fifths of a gravity going up — and
# still quick enough to reach the ceiling below well inside a burn, so that
# the climb rate is what decides how fast you rise rather than a number
# nobody set. It was 1.7, a net seven tenths, doubled 2026-08-29 by request.
#
# What this half buys is authority rather than height: at the default pull it
# arrests a thirty-metre-a-second fall in half a second where it used to take
# a second and a half. Falling onto the pack is now a save; it used to be a
# negotiation.
fn jet_thrust() = 3.4

# And the ceiling on the climb: thirteen metres a second, whatever the
# planet. A pack that accelerated for the whole burn would leave at eighty
# metres a second on this world and at twenty on a small one, which is two
# different toys wearing one name.
#
# This is the half that is felt as height, and it had to move with the thrust
# rather than instead of it. Raising the ceiling alone is a promise the burn
# cannot keep: the pack would spend a longer share of its two and a fifth
# seconds still winding up to a speed it reaches just as the tank runs out,
# and the difference nobody sees is the same as no difference.
fn jet_climb() = 13.0

# What the pack does to the ground speed, on top of what it does to the climb
# — the lean a flier puts into it. Eleven metres a second under thrust
# against five and a half on foot, and twenty-four with the sprint key.
#
# The whole of the doubling is here, and it is here rather than in `walk` so
# that the number can be asked for by a test and read by anybody wondering
# why the valley goes past so much faster with the pack lit.
fn jet_lean() = 2.0

fn jet_fuel(s: Ptr) -> Float = peek_f32(s, 244)

fn jet_on(s: Ptr) -> Int = yes(peek_f32(s, 245) > 0.5)

fn jet_dry(s: Ptr) -> Int = yes(peek_f32(s, 246) > 0.5)

# ---- the pack is asked for twice ---------------------------------------------
#
# One key does two things, and which one it is doing is now decided by how it
# was pressed rather than by where the feet are.
#
# It used to be that a press jumped and the same key *held* lit the pack the
# moment the feet left the ground. That is one gesture doing both, and it
# meant nobody could jump over a rock without taking off: the hold is what
# jumping feels like, and half a second of pack is what it cost.
#
# So: a press is a jump and only a jump, however long it is held. A second
# press soon after the first arms the pack, and the pack then burns for as
# long as that press lasts. Tap to jump, tap-and-hold to fly — which is the
# gesture every game with a double jump already taught everybody.
#
# Three numbers on the block, all of them above 242 where a float slot and a
# pointer slot cannot collide on either target — see the note by `spawn_salt`.
fn jet_gap() = 0.45        # how soon the second press has to come

# The bit a client sets once its own pair has landed.
#
# The edge is the thing being detected and an edge is exactly what a tick
# loses. The page runs `walk` sixty times a second and sees both presses; the
# server runs it twenty times a second on whatever mask arrived last, so a tap
# two frames long stands a fair chance of falling entirely between two ticks —
# and then the server sees one press where the player made two, does not arm,
# and pulls a flying player back to the ground. It is worst on the first
# attempt, which is the one nobody has found their rhythm on yet.
#
# So the pair is detected where it can be seen and the *state* is what
# travels. A client that has armed its pack says so on every frame it stays
# armed, and a tick that lands anywhere inside the burn reads it correctly.
# This is the same trust the other keys already get: the server believes what
# is held, and decides for itself what holding it is worth.
fn jet_told() = 1024

fn jet_was() = 247         # the key, as it was on the frame before
fn jet_since() = 248       # and how long since it last went down
fn jet_armed() = 249       # whether that press was the second of a pair

# Run once a frame, before anything asks whether the pack is alight. Every
# branch here is an edge — the key going down, the key coming up — so it has
# to see every frame exactly once, which is why it lives in `walk` and not in
# `wants_jet`.
fn jet_watch(s, keys, dt) =
  down = if bit_and(keys, 16) == 16 then 1.0 else 0.0
  was = peek_f32(s, jet_was())
  since = peek_f32(s, jet_since()) + dt
  poke_f32(s, jet_was(), down)
  n = if down > 0.5 && was < 0.5 then jet_pressed(s, since) else jet_held(s, down, since)
  # And the far end's word, if it sent one — see `jet_told`.
  jet_hear(s, bit_and(keys, jet_told()) == jet_told())
  n

fn jet_hear(s, told) =
  if told then poke_f32(s, jet_armed(), 1.0) else poke_f32(s, jet_armed(), peek_f32(s, jet_armed()))
  1

# The key went down. If the last one was recent this is the second of a pair
# and the pack is armed; otherwise it is an ordinary jump and the pack is not.
fn jet_pressed(s, since) =
  poke_f32(s, jet_armed(), if since < jet_gap() then 1.0 else 0.0)
  poke_f32(s, jet_since(), 0.0)
  1

# The key is where it was. Letting go disarms: the burn lasts as long as the
# press that started it and no longer, so coming down is releasing the key
# rather than waiting for a tank to empty.
fn jet_held(s, down, since) =
  poke_f32(s, jet_since(), since)
  if down < 0.5 then poke_f32(s, jet_armed(), 0.0) else poke_f32(s, jet_armed(), peek_f32(s, jet_armed()))
  1

# Whether the pack is alight this frame: armed by a double press, the key
# still held, off the ground, fuel in it, not still dry from the last time it
# emptied, and alive.
fn wants_jet(s, keys, grounded, fuel) =
  if peek_f32(s, jet_armed()) < 0.5 then 0.0
  else if bit_and(keys, 16) != 16 then 0.0
  else if grounded > 0.5 then 0.0
  else if fuel <= 0.0 then 0.0
  else if peek_f32(s, 246) > 0.5 then 0.0
  else 1.0

# The tank: spent while burning, filled while standing, and untouched in the
# air with the key up — a fall is not a rest.
fn fuel_after(f0, dt, burning, grounded) =
  if burning > 0.5 then f0 - dt / jet_secs()
  else if grounded > 0.5 then f0 + dt / jet_fill_secs()
  else f0

fn spend_fuel(s, dt, burning, grounded) =
  f0 = peek_f32(s, 244)
  f = clampf(fuel_after(f0, dt, burning, grounded), 0.0, 1.0)
  poke_f32(s, 244, f)
  poke_f32(s, 245, burning)
  poke_f32(s, 246, if f <= 0.0 then 1.0 else if f >= jet_back() then 0.0 else peek_f32(s, 246))
  f

# What the thrust does to a rising or falling body: it moves the climb toward
# `jet_climb` and stops there. Written as a move toward a target rather than
# as an acceleration with a clamp, so arresting a long fall takes exactly as
# long as it should — the pack has one thrust and a fall of thirty metres a
# second is simply further from the target than a standing start.
fn jet_vy(vy, g, dt) =
  step = jet_thrust() * g * dt
  if vy >= jet_climb() then vy
  else if vy + step > jet_climb() then jet_climb()
  else vy + step

# ---- crouching ---------------------------------------------------------------
#
# `C` used to be a key that changed what other people saw of you and nothing
# else: the server put a 3 in the pose byte, the far end played the crouch
# clip, and the person pressing it saw their own view exactly where it had
# been. It read as a key that did not work, which is what it was from the
# only seat that mattered.
#
# So it comes down here, in `walk`, which is the arithmetic both ends run: the
# eye drops six tenths of a metre and the walk loses nearly half its speed,
# and because it is `walk` the server agrees about both — a shot taken from a
# crouch leaves from where the crouched eye is, and the position it is taken
# from is one nobody had to be told about separately.
#
# Eased rather than switched. Six tenths of a metre is a long way for a head
# to move and a cut is a flinch; a fifth of a second of it is a person going
# down on one knee.
fn crouch_drop() = 0.62

fn crouch_rate() = 6.0     # per second, so a fifth of a second down or up

# What it costs to move: nearly four fifths of the walk, so a crouch is a
# crawl — a metre and a quarter a second against five and a half. That is the
# whole of the trade the key offers. Down there you are a metre lower, your
# name is not over your head, and crossing the meadow takes four times as
# long; a crouch that moved at anything like walking pace would simply be a
# better walk, and everyone would spend the match on one knee.
fn crouch_slow() = 0.78    # how much of the walk it costs

fn h_crouch() = 250        # how far down, 0..1, on the player's own block

fn crouch_of(s: Ptr) -> Float = peek_f32(s, h_crouch())

fn jet_armed_now(s: Ptr) -> Int = yes(peek_f32(s, jet_armed()) > 0.5)

# It follows the key and nothing else.
#
# It was gated on being on the ground, which sounds right and is not: walking
# down any slope in this valley takes the feet off it for a frame at a time,
# so the gate flickered and the eye bobbed up and down the whole way down a
# hill. Worse, it was silently doing nothing at all — a crouch measured while
# walking never engaged, because walking is when the gate is open least.
#
# In the air it costs nothing to allow: the speed it slows is the walk, and
# the eye it lowers is lowered relative to a body that is where it is either
# way.
fn crouch_step(s, keys, grounded, dt) =
  want = if bit_and(keys, 64) == 64 then 1.0 else 0.0
  a = peek_f32(s, h_crouch())
  d = crouch_rate() * dt
  # Toward `want`, and stopping there. It was written as `if want > a then a +
  # d else a - d` clamped to nought and one, which is the same thing to read
  # and not the same thing to run: once the two are equal the first test is
  # false, so a key still held took the second branch and the crouch slid back
  # down — then rose again on the next frame, and shook at three tenths a step
  # for as long as the key was down. Standing hid it, because a value already
  # at nought clamps to nought whichever way it is pushed.
  n = if a < want then clampf(a + d, 0.0, want) else clampf(a - d, want, 1.0)
  poke_f32(s, h_crouch(), n)
  n

# Whether the sprint key does anything this frame: it is held, there is
# somewhere to go, there is breath left, and the last time it ran out is far
# enough behind. Standing still with it held is not running and costs nothing.
fn wants_run(s: Ptr, keys: Int, wl: Float) =
  if bit_and(keys, 32) != 32 then 0.0 else if wl < 0.01 then 0.0 else if peek_f32(s, 116) > 0.5 then 0.0 else if peek_f32(s, 115) <= 0.0 then 0.0 else 1.0

fn breath_spend() = 0.166

fn breath_fill() = 0.11

# A third of a tank is what it takes to be allowed to run again, which at the
# rate above is about three seconds of standing — long enough to feel like
# catching your breath, short enough not to be a punishment on top of one.
fn breath_back() = 0.34

fn spend_breath(s: Ptr, dt: Float, sprinting: Float, wl: Float) =
  b0 = peek_f32(s, 115)
  b1 = if sprinting > 0.5 then b0 - breath_spend() * dt else if wl < 0.01 then b0 + breath_fill() * dt else b0
  b = clampf(b1, 0.0, 1.0)
  poke_f32(s, 115, b)
  poke_f32(s, 116, if b <= 0.0 then 1.0 else if b >= breath_back() then 0.0 else peek_f32(s, 116))
  b

# One player's own step: where they are looking, where that takes them, and
# what they walk into. Nothing here is shared, so a server runs it once per
# player and the order it runs them in does not matter.
fn walk(s: Ptr, dt: Float, mdx: Float, mdy: Float, keys: Int) =
  w = wd(s)
  # Somebody on the ground does not walk and does not look about. Both ends run
  # this, so the keys a dead client keeps sending are ignored in the same way
  # in both places rather than only where somebody thought to check.
  dead = if peek_f32(s, 82) < 0.001 then 1.0 else 0.0
  lie(s, dead, dt)
  live = 1.0 - dead
  k = if dead > 0.5 then 0 else keys
  yaw = peek_f32(s, 19) + mdx * look_per_pixel() * live
  pitch = clampf(peek_f32(s, 20) - mdy * look_per_pixel() * live, 0.0 - pitch_max(), pitch_max())
  fx = sin(yaw)
  fz = 0.0 - cos(yaw)
  wx = walk_axis(k, 1, 2) * fx + walk_axis(k, 8, 4) * (0.0 - fz)
  wz = walk_axis(k, 1, 2) * fz + walk_axis(k, 8, 4) * fx
  wl = sqrt(wx * wx + wz * wz)
  # Running is not free. What it spends is slot 115, a tank that empties in
  # about six seconds of running — seventy metres, which is most of the way
  # across the meadow — and fills again only while you are standing still, at
  # two thirds of the rate it empties, so nine seconds of standing buys back
  # six of running. Walking neither spends nor fills it: what buys breath back
  # is stopping, which is exactly what a valley with meteors aimed at where
  # people are standing makes expensive.
  #
  # Emptying it leaves you out of breath rather than merely at zero: slot 116
  # is set, and until the tank is a third full again the sprint key does
  # nothing. Without that, running at zero would be a stutter — one frame of
  # sprint for every frame of standing — which reads as a bug rather than as
  # being winded.
  crouched = crouch_step(s, k, peek_f32(s, 25), dt)
  # You cannot sprint on one knee. Asked here rather than inside `wants_run`
  # because that one is about breath and this is about posture.
  sprinting = if crouched > 0.5 then 0.0 else wants_run(s, k, wl)
  spend_breath(s, dt, sprinting, wl)
  # Whether the pack is alight, asked before the legs rather than after them.
  #
  # It used to be worked out further down, next to the fall it feeds, which
  # was fine while the pack only ever changed which way was up. It decides
  # how fast you cross the valley now as well — see `jet_lean` — and that is
  # a question the horizontal step has to have answered before it takes one.
  # Nothing here reads anything the step writes: the grounded flag and the
  # tank are both last frame's until the very end of this function, which is
  # exactly what they were when this ran twenty lines lower down.
  jet_watch(s, k, dt)
  burning = wants_jet(s, k, peek_f32(s, 25), peek_f32(s, 244))
  spend_fuel(s, dt, burning, peek_f32(s, 25))
  # Five and a half metres a second, and twelve with the sprint key. Both were
  # a quarter faster and it read as skating: at seven and a half the valley
  # went past faster than anything on the ground in it could account for, and
  # a shot at somebody crossing the meadow was a lead nobody could judge.
  #
  # Under thrust it is doubled. What the ground could not account for, the air
  # can: there is nothing under you to read the speed against, the pack is
  # loud and visible and lasts four and a half seconds, and a flight that
  # crossed the ground no faster than a walk was a climb with a view rather
  # than a way of getting anywhere.
  step = (if sprinting > 0.5 then 12.0 else 5.625)
    * (if burning > 0.5 then jet_lean() else 1.0)
    * (1.0 - crouch_slow() * crouched) * dt
  # What a blast is still pushing you by, spent down over about a fifth of a
  # second. It goes in beside the walk rather than instead of it, so you can
  # walk against it and the collisions below still run on where you end up.
  shx = peek_f32(s, 84)
  shz = peek_f32(s, 85)
  keep = 1.0 / (1.0 + dt * 5.0)
  poke_f32(s, 84, shx * keep)
  poke_f32(s, 85, shz * keep)
  # Where they were before this step, so that what the legs did can be told
  # apart from what the network did. See `stride_speed`.
  px_was = peek_f32(s, 21)
  pz_was = peek_f32(s, 23)
  px0 = clampf(px_was + (if wl > 0.01 then wx / wl * step else 0.0) + shx * dt, 0.0 - 80.0, 80.0)
  pz0 = clampf(pz_was + (if wl > 0.01 then wz / wl * step else 0.0) + shz * dt, 0.0 - 80.0, 80.0)
  poke_f32(s, 21, px0)
  poke_f32(s, 23, pz0)
  collide_all(s, peek_ptr(w, 65), to_int(peek_f32(w, 57)), 0.3)
  collide_all(s, peek_ptr(w, 66), to_int(peek_f32(w, 58)), 0.55)
  # And the boulders, which are a wall only up to their own top — see
  # `collide_rocks`. Half the point of an outcrop is that it is something to
  # put between you and a rifle, and the other half is that you can get on it.
  collide_rocks(s, w)
  collide_walls(s, w)
  px = peek_f32(s, 21)
  pz = peek_f32(s, 23)
  # How fast the feet carried this player over the ground on this step, in
  # metres a second — after the collisions, so walking into a hillside is not
  # walking, and before anything else touches the position.
  #
  # This is written for the weapon's stride and it exists because the obvious
  # source is wrong: a browser in a shared valley predicts its own walk every
  # frame and is corrected toward the server's answer twenty times a second,
  # so the *change in position* is a stride plus a correction, and the
  # correction arrives in lumps. Measured that way the gun shook while walking
  # in a shared valley and was perfectly steady alone — which is the shape of
  # a bug that hides until the day multiplayer becomes the default.
  #
  # A blast's shove is in here too. It is brief and it does move the feet, and
  # separating it would cost a slot to save an eyeblink.
  poke_f32(s, 242, sqrt((px - px_was) * (px - px_was) + (pz - pz_was) * (pz - pz_was)) / max(dt, 0.0001))
  # And the same thing as a vector, for the reconciler: what the legs (or the
  # jetpack's forward lean) did this step on each ground axis, which is what
  # lets a stale snapshot's trail be told apart from a disagreement. The
  # vertical twin is slot 24, which the fall already keeps.
  poke_f32(s, 243, (px - px_was) / max(dt, 0.0001))
  poke_f32(s, 255, (pz - pz_was) / max(dt, 0.0001))
  # The ground under the feet, not the ground under the map square: in a
  # world with roofs in it those are different questions, and only the first
  # one lets somebody stand in a tunnel instead of on the hill above it.
  # The ground under the feet, and the top of any boulder they are over: a
  # stone is something to stand on, and standing on one is being held up by it
  # rather than by the hillside it is lying on.
  gnd = max(ground_under(w, px, peek_f32(s, 22) + 0.05, pz),
            rock_floor(w, px, peek_f32(s, 22), pz))
  g = gravity(w)
  grounded = peek_f32(s, 25)
  fell = jump_vel(k, grounded, peek_f32(s, 24)) - g * dt
  vy = if burning > 0.5 then jet_vy(fell, g, dt) else fell
  py0 = peek_f32(s, 22) + vy * dt
  # And the roof over the head. Rising into rock stops at it — without this
  # a jump inside a tunnel goes straight up through the hill.
  roof = roof_over(w, px, peek_f32(s, 22) + 0.05, pz) - stand_tall()
  pyr = if py0 > roof then roof else py0
  py = if pyr < gnd then gnd else pyr
  poke_f32(s, 19, yaw)
  poke_f32(s, 20, pitch)
  poke_f32(s, 22, py)
  poke_f32(s, 24, if py0 < gnd then 0.0 else if py0 > roof then 0.0 else vy)
  poke_f32(s, 25, if py0 < gnd then 1.0 else 0.0)
  # Where the eye is, written down rather than left to the camera. The rifle
  # fires from here and a server has no camera to work it out — and the two
  # must agree about it, or a shot leaves from somewhere other than where the
  # person taking it was standing.
  magma_burn(w, s, py, gnd, dt)
  poke_f32(s, 16, px)
  poke_f32(s, 17, py + 1.75 - crouch_drop() * crouched)
  note_hit(s, dt)
  poke_f32(s, 18, pz)

# Everything the valley does whether or not anybody is watching: the wind, the
# rounds in the air, the shards falling, the crystals winding up, whatever the
# shark has decided. Once a tick, however many people are in it.
# ---- the match --------------------------------------------------------------
#
# Ten minutes of valley, then twenty seconds of looking at who did what to
# whom, then all of it again with the walls rebuilt and everybody somewhere
# else. The clock lives on the world and not on the server, so a browser alone
# in its own valley plays the same rounds a shared one does, and a client can
# put the number on the screen without being told it every tick.
# How long a round is, and how long the board is up afterwards. On the world
# rather than as constants, because a server is told them on the command line
# and a browser alone in its valley should be able to differ. Nought means
# nobody said, which is half an hour and twenty seconds. It was ten minutes,
# and ten minutes was a round of shooting; a valley you can quarry wants
# time to quarry it in.
fn match_len(w) = if peek_f32(w, 126) > 0.5 then peek_f32(w, 126) else 1800.0

fn report_len(w) = if peek_f32(w, 127) > 0.5 then peek_f32(w, 127) else 20.0

fn set_match_len(w: Ptr, secs: Int, report: Int) =
  poke_f32(w, 126, to_float(secs))
  poke_f32(w, 127, to_float(report))
  1

fn match_clock(w: Ptr) -> Float = peek_f32(w, 124)

fn match_phase(w: Ptr) -> Int = yes(peek_f32(w, 125) > 0.5)

# What the clock counts *down* to, which is what anybody wants to read: how
# long is left of the match, or of the twenty seconds before the next one.
fn match_left(w: Ptr) -> Float =
  if match_phase(w) > 0 then report_len(w) - peek_f32(w, 124) else match_len(w) - peek_f32(w, 124)

fn step_match(w, dt) =
  t = peek_f32(w, 124) + dt
  if match_phase(w) > 0 then
    if t >= report_len(w) then new_match(w) else tick_clock(w, t)
  else if t >= match_len(w) then
    poke_f32(w, 125, 1.0)
    poke_f32(w, 124, 0.0)
    1
  else
    tick_clock(w, t)

fn tick_clock(w, t) =
  poke_f32(w, 124, t)
  1

# Everything that was, gone. The valley comes back whole — every crystal
# standing, every wall rebuilt, every ring emptied — and everybody in it is put
# down somewhere new with a full bar and nothing on their record.
#
# The blocks are laid again rather than un-broken one at a time: `place_walls`
# is a pure function of the terrain, so running it a second time gives the same
# twelve walls with all their stones back, which is both simpler and exactly
# what "a new valley" means here.
fn new_match(w) =
  reset_world(w)
  clear_marks(w)
  place_walls(w, blocks_ptr(w))
  place_mags(w)
  raise_pines(peek_ptr(w, 65), to_int(peek_f32(w, 57)))
  poke_f32(w, 93, 0.0)
  poke_f32(w, 121, peek_f32(w, 121))
  poke_f32(w, 122, 0.0)
  poke_f32(w, 123, 0.0)
  poke_f32(w, 124, 0.0)
  poke_f32(w, 125, 0.0)

  for i in 0..player_count(w)
    new_match_player(player_at(w, i))
  1

# The felled stand back up. The exact yaw each tree had is not recoverable —
# it was hashed from a candidate index nobody kept — so a raised pine faces a
# way hashed from where it stands, which every client computes identically,
# and a tree facing a new way after the world began again is the least of
# what changed.
fn raise_pines(pb, n) =
  for i in 0..n
    raise_pine(pb, i)

fn raise_pine(pb, i) =
  sc = peek_f32(pb, i * 8 + 3)
  if sc < 0.0 then stood_up(pb, i, sc) else 0

fn stood_up(pb, i, sc) =
  poke_f32(pb, i * 8 + 3, 0.0 - sc)
  poke_f32(pb, i * 8 + 4, hash2(peek_f32(pb, i * 8) * 3.7, peek_f32(pb, i * 8 + 2) * 1.3) * 6.28)
  1

fn new_match_player(s) =
  poke_f32(s, 111, 0.0)
  poke_f32(s, 112, 0.0)
  poke_f32(s, 109, 0.0)
  poke_f32(s, 110, 0.0)
  place_player(s)
  1

# The server's clock, put on a client's world. The seconds left are what
# crosses the wire, because that is what anybody reads; the clock itself is how
# far into the phase we are, which is the other end of the same number.
fn set_match(w: Ptr, phase: Int, left: Float) =
  poke_f32(w, 125, if phase > 0 then 1.0 else 0.0)
  poke_f32(w, 124, clampf(if phase > 0 then report_len(w) - left else match_len(w) - left, 0.0, match_len(w)))
  1

fn kills(s: Ptr) -> Int = to_int(peek_f32(s, 111))

fn deaths(s: Ptr) -> Int = to_int(peek_f32(s, 112))

# One place knows a death happened, and it already knows both names.
fn tally_end(w, victim, shooter) =
  add_to(w, victim, 112)
  if shooter == victim then 0 else add_to(w, shooter, 111)
  1

fn add_to(w, id, slot) =
  i = index_of(w, id, 0)
  if i < 0 then 0 else add_one(player_at(w, i), slot)

fn add_one(s, slot) =
  poke_f32(s, slot, peek_f32(s, slot) + 1.0)
  1

fn step_world(w: Ptr, dt: Float) =
  step_match(w, dt)
  t = step_wind(w, dt)
  step_bullets(w, peek_ptr(w, 68), dt, 1)
  step_shards(w, peek_ptr(w, 69), dt)
  step_fireballs(w, peek_ptr(w, 74), dt, 1)
  step_blasts(peek_ptr(w, 81), dt)
  run_charge(w, dt, t)
  shark_step(w, dt, t)
  step_zaps(w)

# ---- the crystals bite back -------------------------------------------------
#
# Stand against a crystal and it answers: a tenth of you, down a line of its
# own light, every three seconds you keep standing there. The glass was the
# one thing in the valley with no opinion about being leaned on — people
# fought from inside the stands because the crystals made better walls than
# the walls. Now proximity is a wager.
#
# Only where the world decides — this runs in `step_world`, which a client in
# somebody else's valley never steps — and only the *event* crosses the wire:
# who was bitten and by which crystal, one `z` each. The damage arrives the
# way all server damage does, in the snapshot; the ring is for the light and
# the sound, which every browser draws from the same two numbers.
fn zap_reach() = 1.8

# A twentieth of a bar, halved from a tenth. Standing against the glass was
# costing a third of a life for every ten seconds of it, which made the
# crystals a wall you could not go near rather than one you crossed with care.
# It is still a wager and now it is one worth taking.
fn zap_bite() = 0.05

fn zap_every() = 3.0

fn zap_ring() = 32

fn step_zaps(w) =
  for i in 0..player_count(w)
    zap_check(w, player_at(w, i))

fn zap_check(w, s) =
  if world_time(w) - peek_f32(s, 105) < zap_every() then 0 else if peek_f32(s, 82) < 0.001 then 0 else zap_scan(w, s, peek_ptr(w, 66), to_int(peek_f32(w, 58)), 0)

fn zap_scan(w, s, cb, n, i) =
  if i >= n then 0 else if near_glass(s, cb, i) > 0 then zap(w, s, cb, i) else zap_scan(w, s, cb, n, i + 1)

# Near the glass: within arm-and-a-step of the crystal's *surface*, and at
# its height. From the surface, not the centre — the body already cannot walk
# nearer a big prism than about 0.55 of its scale, so a reach measured from
# the centre left the giants unable to bite the one thing standing hard
# against them. The smallest shards of standing crystal do not bite — a thing
# that reaches your knee is not a thing you were warned about.
fn near_glass(s, cb, i) =
  at = i * 8
  sc = peek_f32(cb, at + 3)
  if sc < 0.35 then 0
  else
    dx = peek_f32(cb, at) - peek_f32(s, 21)
    dz = peek_f32(cb, at + 2) - peek_f32(s, 23)
    dy = peek_f32(cb, at + 1) - peek_f32(s, 22)
    r = 0.55 * sc + zap_reach()
    if dx * dx + dz * dz > r * r then 0 else if dy > 2.0 || dy < 0.0 - 4.0 then 0 else 1

fn zap(w, s, cb, i) =
  poke_f32(s, 105, world_time(w))
  poke_f32(s, 82, clampf(peek_f32(s, 82) - zap_bite(), 0.0, 1.0))
  # And a small shove off the glass, so being bitten reads on the body as
  # well as on the bar — a fraction of a blast's, from the crystal outward.
  dx = peek_f32(s, 21) - peek_f32(cb, i * 8)
  dz = peek_f32(s, 23) - peek_f32(cb, i * 8 + 2)
  d = sqrt(dx * dx + dz * dz) + 0.2
  poke_f32(s, 84, peek_f32(s, 84) + dx / d * 7.0)
  poke_f32(s, 85, peek_f32(s, 85) + dz / d * 7.0)
  note_zap(w, player_id(s), i)
  1

fn note_zap(w, who, ci) =
  n = to_int(peek_f32(w, 95))
  zb = peek_ptr(w, 78)
  poke_f32(zb, n % zap_ring() * 2, to_float(who))
  poke_f32(zb, n % zap_ring() * 2 + 1, to_float(ci))
  poke_f32(w, 95, peek_f32(w, 95) + 1.0)
  1

# `wd`, like every counter a host reads: the browser hands these its own
# player block, and the world is one hop from either kind.
# ---- the crystals' light ----------------------------------------------------
#
# A crystal bites whoever stands against it, and the bolt is drawn from the
# crystal's tip down to that player's foot. The world keeps the bites in a ring
# — which crystal, and whom — and the page used to turn that ring into beams
# itself: reading the crystal's instance, finding the target, stamping the
# clock, and holding a list with a cap and a lifetime.
#
# All of that is arithmetic over things kept here, so it is here. What is left
# in the page is the buffer write and the draw.
#
# The endpoints are captured when the bolt strikes and never recomputed, which
# is the one thing that has to be got right: a beam that followed its target
# would be dragged across the valley by somebody walking away, and a discharge
# does not follow anybody.
#
# The memory is the caller's — ring, then the run it draws, then a cursor —
# because a beam is a picture and pictures belong to whoever is drawing. The
# same reason the weed's buffer is the page's.
fn zap_cap() = 16
fn zap_floats() = 10
fn zap_life() = 0.55
fn zap_out_off() = zap_cap() * zap_floats()
fn zap_cursor_off() = zap_cap() * zap_floats() * 2
fn zap_room() = zap_cap() * zap_floats() * 2 + 1

# `rows` is the interpolated players, twelve floats each, and `n` how many —
# nought when nobody is sharing this valley, which is when every bolt is aimed
# at the only person in it.
fn zap_beams(s: Ptr, r: Ptr, rows: Ptr, n: Int, now: Float) -> Int =
  end = zaps(s)
  seen = to_int(peek_f32(r, zap_cursor_off()))
  # A client that has been away — a tier rebuild, a round change — comes back
  # to a cursor the world has run on past. Only the last few are worth drawing;
  # the rest happened while there was nothing on screen.
  from = if seen < end - zap_cap() then end - zap_cap() else seen
  take_zaps(s, r, rows, n, from, end, now)
  poke_f32(r, zap_cursor_off(), to_float(end))
  live_zaps(r, now, 0, 0)

fn take_zaps(s, r, rows, n, k, end, now) =
  if k >= end then 0
  else
    one_zap(s, r, rows, n, k, now)
    take_zaps(s, r, rows, n, k + 1, end, now)

fn one_zap(s, r, rows, n, k, now) =
  ci = zap_which(s, k)
  cb = crystals(s)
  at = (k % zap_cap()) * zap_floats()
  # From the tip: the instance says where the crystal stands and how big it is,
  # and the point is a shade over its own height.
  poke_f32(r, at, peek_f32(cb, ci * 8))
  poke_f32(r, at + 1, peek_f32(cb, ci * 8 + 1) + peek_f32(cb, ci * 8 + 3) * 1.05)
  poke_f32(r, at + 2, peek_f32(cb, ci * 8 + 2))
  aim_zap(s, r, rows, n, at, zap_who(s, k))
  # In the crystal's own colour, stamped with the clock it struck on.
  poke_f32(r, at + 6, peek_f32(cb, ci * 8 + 5))
  poke_f32(r, at + 7, peek_f32(cb, ci * 8 + 6))
  poke_f32(r, at + 8, peek_f32(cb, ci * 8 + 7))
  poke_f32(r, at + 9, now)
  0

# To the foot. Ending it at the camera put the last stretch of the bolt behind
# the near plane, so a hit you were not already looking at arrived as damage
# with nothing on screen; the chest left it reaching out of the middle of the
# view, from nowhere. A discharge goes to earth, and what you are standing on
# is the earth — slot 22 is the foot the world walks on, jump and all.
fn aim_zap(s, r, rows, n, at, who) =
  if who == to_int(peek_f32(s, 99)) then land_zap(r, at, peek_f32(s, 16), peek_f32(s, 22), peek_f32(s, 18))
  else zap_at_other(r, rows, n, at, who, 0)

fn land_zap(r, at, x, y, z) =
  poke_f32(r, at + 3, x)
  poke_f32(r, at + 4, y + 0.12)
  poke_f32(r, at + 5, z)
  0

# Somebody else, off the interpolated rows. If they are not on them — behind a
# hill, and blanked — the bolt is left standing at the crystal, which draws as
# nothing rather than as a beam to the origin.
fn zap_at_other(r, rows, n, at, who, i) =
  if i >= n then land_zap(r, at, peek_f32(r, at), peek_f32(r, at + 1) - 0.12, peek_f32(r, at + 2))
  else if to_int(peek_f32(rows, i * 12)) == who then
    land_zap(r, at, peek_f32(rows, i * 12 + 1), peek_f32(rows, i * 12 + 2), peek_f32(rows, i * 12 + 3))
  else zap_at_other(r, rows, n, at, who, i + 1)

# How many are still burning, copied into one run so the page writes that many
# and draws them. The ring itself is left alone: it is addressed by the world's
# own event number, and compacting it would move a beam out from under the slot
# the next strike is about to write.
fn live_zaps(r, now, i, k) =
  if i >= zap_cap() then k
  else
    born = peek_f32(r, i * zap_floats() + 9)
    age = now - born
    if born > 0.0 && age >= 0.0 && age < zap_life() then live_zaps(r, now, i + 1, k + copy_zap(r, i, k))
    else live_zaps(r, now, i + 1, k)

fn copy_zap(r, i, k) =
  for j in 0..zap_floats()
    poke_f32(r, zap_out_off() + k * zap_floats() + j, peek_f32(r, i * zap_floats() + j))
  1

fn zaps(s: Ptr) -> Int = to_int(peek_f32(wd(s), 95))

fn zap_who(s: Ptr, k: Int) -> Int = to_int(peek_f32(peek_ptr(wd(s), 78), k % zap_ring() * 2))

fn zap_which(s: Ptr, k: Int) -> Int = to_int(peek_f32(peek_ptr(wd(s), 78), k % zap_ring() * 2 + 1))

# Being told about a bite this browser did not decide: the ring and the
# counter move, the light and the sound follow, and the health arrives in the
# snapshot the way it always does.
fn put_zap(s: Ptr, who: Int, ci: Int) = note_zap(wd(s), who, ci)

# The wind is a function of the clock and of nothing else, which is why a
# client can run it without being told anything: give two machines the same
# time and they agree about the weather.
fn step_wind(w, dt) =
  t = peek_f32(w, 28) + dt
  gust = wind_strength(t)
  poke_f32(w, 26, wind_angle(t))
  poke_f32(w, 27, gust)
  poke_f32(w, 28, t)
  poke_f32(w, 29, peek_f32(w, 29) + wind_rate(gust) * dt)
  t

# What a client steps between snapshots: everything that moves, and nothing
# that decides. Rounds fly and hit nothing, fireballs arc and leave no crater,
# shards fall, craters age, the wind blows. What a round hit, what a crater did
# to somebody, which crystal went and where the shark is are the server's, and
# arrive as events.
fn step_visuals(w: Ptr, dt: Float) =
  # The round runs here too. It was only in `step_world`, which a client never
  # calls, so the clock on a client sat at ten minutes for ever — and worse,
  # the turn of the round never reached one: the server rebuilt its valley and
  # the client went on looking at the crystals it had broken and the holes it
  # had shot. Running it on both sides means a client rebuilds its own valley
  # at the same moment, and `set_match` keeps the two clocks honest.
  step_match(w, dt)
  swim_on(w, dt)
  step_wind(w, dt)
  step_bullets(w, peek_ptr(w, 68), dt, 0)
  step_shards(w, peek_ptr(w, 69), dt)
  step_fireballs(w, peek_ptr(w, 74), dt, 0)
  step_blasts(peek_ptr(w, 81), dt)

# Whoever has been down long enough is put back on their feet where they
# started, in the valley as it now is: the crystals they broke stay broken and
# the crater they fell in is still there.
#
# Called by the server and not by `step_world`, which a browser alone in its
# own valley also runs: there, running out of health is the end of the thing
# and there is a screen that says so. Standing somebody back up is a decision,
# and the decisions are the server's.
fn rise_all(w) =
  for i in 0..player_count(w)
    rise_one(player_at(w, i))

fn rise_one(s) = if may_rise(s) > 0 then respawn(s) else 0

# What one player sweeps up off the ground, after the world has finished
# moving it about.
# What one was worth. A chip off a crystal still has the light in it and mends
# you a little; a magazine fills the rifle and says when it will be back.
# Anything else is scenery and does not reach here.
# How many boxes this player has lifted off the ground, ever. Only a pickup
# writes it, which is the whole point of it existing.
#
# The ears used to work this out by watching the ammunition count and calling
# any rise a pickup. That is true in a valley of one and false in a shared
# one: the server's figure arrives twenty times a second and is written back
# whenever it differs by more than two, and a gun firing sixteen rounds a
# second is always more than two ahead of what the server last said. So the
# count jumped *up* twenty times a second while the trigger was down, the
# ears called every jump a pickup, and a magazine's metal tap twenty times a
# second is a bell. A counter that only a pickup can raise cannot be lied to
# that way.
# 113 on the player's own block. The world's block uses 112..113 for the hurt
# ring, and the two never share a block — the layout note at the top of this
# file is the authority, and it lists nothing for the player between 111 and
# 115. Deliberately not near 242, where the jetpack and the machine gun have
# already taken everything: this session lost an afternoon to slot 247 and
# very nearly repeated it here on 249.
fn took_at() = 113

fn took_count(s: Ptr) -> Int = to_int(peek_f32(s, took_at()))

fn note_took(s) =
  poke_f32(s, took_at(), peek_f32(s, took_at()) + 1.0)
  1

fn worth_of(w, s, sb, i, at, mend) =
  if peek_f32(sb, at + 16) > 3.5 then
    # A belt is the machine gun's own supply and nothing else's.
    #
    # It used to come out of a rifle magazine — a stopgap from the day the
    # gun arrived, when there was nothing on the ground that was its. That
    # made a magazine worth taking to a player who was full of rifle rounds
    # and empty of belted ones, which `wanted` had no way to say, and it made
    # four hundred and fifty rounds of machine-gun ammunition a free rider on
    # a box of ten.
    poke_f32(s, 252, to_float(mg_full()))
    poke_f32(s, 254, to_float(mg_belt_count() - 1))
    note_took(s)
    place_mag(w, sb, i, to_int(peek_f32(sb, at + 17)) + 1)
    1
  else if peek_f32(sb, at + 16) > 2.5 then
    # A crate of rockets fills the tube and nothing else. `wanted` has already
    # said the tube has room, which is the whole of "only if you carry the
    # launcher" in a valley where everybody does: a full tube walks past it.
    poke_f32(s, 120, to_float(rocket_full()))
    note_took(s)
    place_mag(w, sb, i, to_int(peek_f32(sb, at + 17)) + 1)
    1
  else if peek_f32(sb, at + 16) > 1.5 then
    # And a magazine fills the guns that take rounds — the rifle and the AK —
    # and not the tube.
    #
    # Taken here, and it turns up somewhere else. Which somewhere is a
    # function of nothing but the box's number and how many times it has been
    # taken, so a server and a browser that have both seen the same pickups
    # agree about where it went without either telling the other.
    poke_f32(s, 118, to_float(mag_size()))
    poke_f32(s, 106, to_float(ak_full()))
    poke_f32(s, 117, to_float(ak_mag_count() - 1))
    note_took(s)
    place_mag(w, sb, i, to_int(peek_f32(sb, at + 17)) + 1)
    1
  else if mend < 1 then 1
  else
    poke_f32(s, 82, clampf(peek_f32(s, 82) + peek_f32(sb, at + 16), 0.0, 1.0))
    1

fn pick_up(s: Ptr) = gather(wd(s), s, peek_ptr(wd(s), 69), 1)

# Sweeping up without the mending, which is what a browser in somebody else's
# valley does.
#
# There, health is the server's: it arrives in every snapshot and is written
# over whatever this browser had decided. So healing locally buys nothing —
# it is overwritten a tenth of a second later — and it costs something, because
# what it is overwritten *with* is the health from before the pickup, and a
# health that goes down is exactly how this file decides somebody has been
# shot. Every chip picked up in a shared valley threw the player's head, at the
# full strength a graze gets, which is the floor in `start_kick`.
#
# The pieces still vanish and the boxes still move and still fill the rifle,
# for the same reason walking is done locally: those answer the key. Only the
# fraction of a per cent is left to the one that owns it.
fn pick_up_quiet(s: Ptr) = gather(wd(s), s, peek_ptr(wd(s), 69), 0)

# The three of them and a camera, which is a browser with the valley to itself.
# The order is the one this file has always had: the player moves, then the
# world moves, then the player picks up whatever is now at their feet.
fn frame(s: Ptr, dt: Float, mdx: Float, mdy: Float, keys: Int, aspect: Float) =
  walk(s, dt, mdx, mdy, keys)
  step_world(wd(s), dt)
  pick_up(s)
  look(s, aspect)

# ---- what being shot does to the head ---------------------------------------
#
# Nobody announces a hit. Health only ever goes down, so the frame it goes down
# on is the frame this player was hit — which is how the page already decides
# which clip to play for everybody else, and it is the same argument: both ends
# have the health, and sending the hit again would only make it arrive later.
#
# It is noticed here rather than at each of the places that do damage, of which
# there are three and could be four. A round, a blast and whatever a server has
# decided all land in the same slot in the end, and watching the slot cannot
# miss one.
fn kick_secs() = 0.42

# ---- and what dying does ----------------------------------------------------
#
# Ten seconds on the ground. Long enough that it is an event and not a stutter
# — you watch the valley from where you fell, your rifle in the grass beside
# you, and whoever shot you walks past — and short enough that it is not a
# punishment.
#
# The clock is kept by whoever is running `walk`, which is both ends: a client
# needs it for the camera and for the number on the screen, a server needs it
# to decide when somebody may stand up. The standing up itself is `step_world`'s
# and so the server's, like every other decision in here.
fn dead_secs() = 10.0

fn down_for(s: Ptr) -> Float = peek_f32(s, 107)

# How often somebody may change what they are called. Not a matter of taste: a
# name goes out to everybody in the valley, so this is the rate of the only
# thing one client can make the server say to all the others.
fn rename_gap() = 3.0

fn may_rename(s: Ptr, t: Float) -> Int = yes(t - peek_f32(s, 108) > rename_gap())

fn renamed(s: Ptr, t: Float) =
  poke_f32(s, 108, t)
  1

# And how often they may say something, which is the same problem wearing
# different clothes: a line of chat is the other thing one client can make the
# server repeat to everybody in the valley, and it is longer than a name.
#
# A second and a half. Slower than anybody types a sentence and fast enough for
# an argument — and a refusal rather than a disconnection, because somebody
# leaning on the return key is impatient and not hostile.
fn say_gap() = 1.5

fn may_say(s: Ptr, t: Float) -> Int = yes(t - peek_f32(s, 125) > say_gap())

fn said_at(s: Ptr, t: Float) =
  poke_f32(s, 125, t)
  1

fn may_rise(s: Ptr) -> Int =
  yes(peek_f32(s, 82) < 0.001 && peek_f32(s, 107) > dead_secs())

fn lie(s, dead, dt) =
  poke_f32(s, 107, if dead > 0.5 then peek_f32(s, 107) + dt else 0.0)
  1

# The fall, nought to one over three quarters of a second and smooth at both
# ends. The eye goes down to where a head on the ground is and the horizon
# rolls over with it — a camera that simply cut to ankle height would read as
# a bug, and one that stayed at eye level while the figure fell would read as
# a ghost.
fn fell(s) =
  u = clampf(peek_f32(s, 107) / 0.75, 0.0, 1.0)
  u * u * (3.0 - 2.0 * u)

# Which way they go over: the side the last round threw their head, so falling
# finishes the motion being shot started. Nought is nobody's side, and goes
# right.
fn fall_side(s) = if peek_f32(s, 104) < 0.0 then 0.0 - 1.0 else 1.0

fn note_hit(s: Ptr, dt: Float) =
  hp = peek_f32(s, 82)
  was = peek_f32(s, 101)
  poke_f32(s, 101, hp)
  if hp < was - 0.001 then start_kick(s, was - hp) else fade_kick(s, dt)

fn fade_kick(s, dt) =
  poke_f32(s, 102, if peek_f32(s, 102) < dt then 0.0 else peek_f32(s, 102) - dt)
  1

# How hard is what it cost, floored so that a graze still registers: being shot
# at all is the thing worth telling somebody about, and a hit that took a
# thirtieth of them off is exactly the one they might otherwise miss.
#
# Which way it throws them comes off the wind's clock rather than a random
# number this file does not have. Two hits running do not throw the head the
# same way, and a browser and a server working from the same world agree about
# it without either being asked.
fn start_kick(s, lost) =
  poke_f32(s, 102, kick_secs())
  poke_f32(s, 103, clampf(0.42 + lost * 1.7, 0.0, 1.3))
  poke_f32(s, 104, if sin(peek_f32(wd(s), 28) * 9.7) < 0.0 then 0.0 - 1.0 else 1.0)
  1

# One clock, one strength, one side, and a shape that starts at full and rings
# down: `u` runs one to zero over the four hundred milliseconds, and the cosine
# turns what would be a single lean into a couple of wobbles settling out. The
# square is what makes it snap rather than drift back.
fn kick_at(s) =
  u = peek_f32(s, 102) / kick_secs()
  if u <= 0.0 then 0.0 else peek_f32(s, 103) * u * u * cos((1.0 - u) * 15.0)

# The camera alone. A client in someone else's valley walks, steps what it is
# allowed to step, applies what it has been told, and only then works out where
# to look from — which is why this is a call of its own rather than the tail of
# `frame`.
#
# The kick goes on the camera and not on the yaw and pitch themselves: a round
# should throw the view about, not turn the player. Roll is most of what sells
# it — three degrees of tilt reads as a head snapping sideways in a way that
# the same angle spent on the pitch reads only as recoil — and the rifle rides
# it for nothing, being placed relative to the eye.
# What the sights are doing to the field of view. One is the eye's own; three
# is a scope. The host eases it rather than switching it, because a field of
# view that changes between one frame and the next reads as a cut and not as
# somebody raising a rifle.
#
# Nought means nobody has set it — a server never calls `look` at all — and a
# nought here would collapse the projection, so it is read as one.
fn set_zoom(s: Ptr, z: Float) =
  poke_f32(s, 111, clampf(finite(z), 1.0, 8.0))
  1

fn zoom_of(s) = if peek_f32(s, 111) < 1.0 then 1.0 else peek_f32(s, 111)

fn look(s: Ptr, aspect: Float) = aimed(s, aspect, kick_at(s), peek_f32(s, 104), fell(s))

# The eye's height is the one `walk` wrote, less whatever the fall is doing to
# it. It used to be a plain `+ 1.75` here, which is where the crouch went to
# die: `walk` was lowering slot 17 — the eye every shot leaves from, every tag
# hangs off and the lamp sits at — and this was building the view matrix from
# the standing height regardless, so a crouch moved everything about a player
# except what they could see.
fn eye_y(s, f) = peek_f32(s, 22) + 1.75 - crouch_drop() * crouch_of(s) - 1.4 * f

fn aimed(s, aspect, k, side, f) =
  camera(s, peek_f32(s, 21), eye_y(s, f), peek_f32(s, 23), peek_f32(s, 19) + k * side * 0.05, clampf(peek_f32(s, 20) + k * 0.075 - 0.45 * f, 0.0 - 1.55, 1.55), k * side * 0.14 + fall_side(s) * 1.3 * f, aspect)

# The view-projection matrix, written straight into the state.
#
# The basis: forward from yaw and pitch, right flat on the ground, up their
# cross product. The projection is WebGPU's zero-to-one depth, near 0.1, far
# 420, and the product with the view collapses because the projection is
# almost diagonal — each column below is `P * V` worked out by hand.
fn camera(s, ex, ey, ez, yaw, pitch, roll, aspect) =
  cp = cos(pitch)
  dx = sin(yaw) * cp
  dy = sin(pitch)
  dz = (0.0 - cos(yaw)) * cp
  r0x = cos(yaw)
  r0z = sin(yaw)
  u0x = 0.0 - r0z * dy
  u0y = r0z * dx - r0x * dz
  u0z = r0x * dy
  # Rolled about the forward direction, which leaves the direction alone and
  # tilts only what across and up mean. Right has no height of its own until
  # this happens, which is why it grows a y here and had none above.
  cr = cos(roll)
  sr = sin(roll)
  rx = r0x * cr + u0x * sr
  ry = u0y * sr
  rz = r0z * cr + u0z * sr
  ux = u0x * cr - r0x * sr
  uy = u0y * cr
  uz = u0z * cr - r0z * sr
  bx = 0.0 - dx
  by = 0.0 - dy
  bz = 0.0 - dz
  pb = zoom_of(s) / tan(0.53)
  pa = pb / aspect
  pc = 420.0 / (0.1 - 420.0)
  pd = 0.1 * 420.0 / (0.1 - 420.0)
  poke_f32(s, 0, pa * rx)
  poke_f32(s, 1, pb * ux)
  poke_f32(s, 2, pc * bx)
  poke_f32(s, 3, 0.0 - bx)
  poke_f32(s, 4, pa * ry)
  poke_f32(s, 5, pb * uy)
  poke_f32(s, 6, pc * by)
  poke_f32(s, 7, 0.0 - by)
  poke_f32(s, 8, pa * rz)
  poke_f32(s, 9, pb * uz)
  poke_f32(s, 10, pc * bz)
  poke_f32(s, 11, 0.0 - bz)
  poke_f32(s, 12, pa * (0.0 - (rx * ex + ry * ey + rz * ez)))
  poke_f32(s, 13, pb * (0.0 - (ux * ex + uy * ey + uz * ez)))
  poke_f32(s, 14, pc * (0.0 - (bx * ex + by * ey + bz * ez)) + pd)
  poke_f32(s, 15, bx * ex + by * ey + bz * ez)
  poke_f32(s, 16, ex)
  poke_f32(s, 17, ey)
  poke_f32(s, 18, ez)
