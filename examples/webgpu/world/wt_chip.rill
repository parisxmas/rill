# A round that stops on a wall leaves a chip there, and it does so in
# somebody else's valley as well as in your own.
#
# It did not. `hit_stone` — the sweep that stops a round on stone — was behind
# the `decide` flag, which is the right to change the world; and a browser in
# a shared valley does not have it, because the server owns what happens to
# crystals and people. But stopping on a stone changes nothing except the
# round: a rifle does not knock stone out. What the gate really did was leave
# every client ignorant of every wall — its own rounds flew through them, and
# a chip is recorded where a round stopped, so no wall in a shared valley ever
# sparked. The ground did, which is what made it look like the sparks worked.
#
# Nothing carries the marks on the wire. They are worked out at both ends or
# they are not seen at all, which is why this file runs the same shot twice.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn at(bb, i, k) = peek_f32(bb, i * 8 + k)

# A stone high up a wall, and a shot fired at it from two metres out along
# +x — far enough to be a flight and near enough to be one step of it.
#
# High up, and that matters: the bottom course is set into the hill, so a
# round aimed at one is a round aimed under the ground, and it stops on the
# hillside and marks *that*. The first draft of this file did exactly that
# and passed with the bug still in — a ground chip counts the same as a wall
# chip to anything that only counts chips.
fn a_block(w) =
  bb = v.blocks_ptr(w)
  high_one(bb, 0, v.blocks_total(w))

fn high_one(bb, i, n) =
  if i >= n then 0
  else if at(bb, i, 3) > 0.01 && at(bb, i, 1) - v.ground(at(bb, i, 0), at(bb, i, 2)) > 1.5 then i
  else high_one(bb, i + 1, n)

# One round put straight into the ring, aimed at the block, and one step of
# the world run over it. Returns how many marks the valley has afterwards.
fn shoot_at(w, x, y, z, decide) =
  b = peek_ptr(w, 68)
  for i in 0..v.bullet_cap()
    poke_f32(b, i * v.bullet_stride() + 7, 0.0)
  at0 = 0
  poke_f32(b, at0, x + 1.0)
  poke_f32(b, at0 + 1, y)
  poke_f32(b, at0 + 2, z)
  # A metre out and ninety metres a second toward it: one sixtieth of a second
  # is a metre and a half of flight, so the step starts in front of the stone
  # and ends behind it and the stone is somewhere inside the sweep. Two metres
  # out it fell half a metre short and nothing was hit at all.
  poke_f32(b, at0 + 3, 0.0 - 90.0)
  poke_f32(b, at0 + 4, 0.0)
  poke_f32(b, at0 + 5, 0.0)
  poke_f32(b, at0 + 6, 0.0)
  poke_f32(b, at0 + 7, v.bullet_life())
  # The ninth float says which gun fired it, and only a gun that leaves chips
  # leaves chips: the rifle's rounds are drawn on the way and say it once.
  poke_f32(b, at0 + 8, v.from_ak())
  before = to_int(peek_f32(w, 55))
  v.step_bullets(w, b, 1.0 / 60.0, decide)
  to_int(peek_f32(w, 55)) - before

fn main() =
  w = v.init(48, 400, 300, 900)
  bb = v.blocks_ptr(w)
  i = a_block(w)
  # The top course of that column, which is the one a shot from head height
  # would meet.
  x = at(bb, i, 0)
  y = at(bb, i, 1)
  z = at(bb, i, 2)

  println("a round on a wall")
  say("deciding, it leaves a chip", shoot_at(w, x, y, z, 1), 1)
  # The case that was broken, and the whole reason this file exists: the same
  # shot in a valley this end does not own.
  say("and not deciding, it still does", shoot_at(w, x, y, z, 0), 1)

  println("and the round stopped")
  # A chip in the air over a wall the round flew through would be worse than
  # no chip at all, so what is asserted is that it is dead as well as marked.
  b = peek_ptr(w, 68)
  say("the wall stopped it", if peek_f32(b, 7) < 0.001 then 1 else 0, 1)
  println("done")
