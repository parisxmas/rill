# The valley, with other people in it.
#
# One process holds one world and steps it twenty times a second. Everybody
# connected gets the same valley because there is only one — the crystals, the
# rounds in the air, the craters and the shark are this program's, and a
# browser is told about them rather than deciding any of it for itself.
#
# The shape is three kinds of strand:
#
#   a reader per connection   the socket, turned into messages for the hub
#   a writer per connection   an outbox, turned back into frames
#   one hub                   the world, and the only thing that touches it
#
# The hub is what makes this safe without a lock anywhere: the world block is
# reached from exactly one strand, and everything else talks to it over
# channels. It is also why a tick is a message like any other — a `Tick` in the
# same inbox as an arriving key press, so the two cannot interleave halfway.
#
# `valley.rill` is the same file the browser compiles into `world.wasm`. That
# is the whole point: a server that reimplemented the walk would be a server
# that disagreed with it.
import "valley" as v
import "ws"

# ---- what it costs to be here ----------------------------------------------

# The one thing this program is told rather than knows. 8091 is what the page
# opens when it is served over plain http, which is how this runs while it is
# being worked on, so that stays the default and a local run needs no argument.
# A box it is deployed to may have that port spoken for by something else
# entirely — and did: the machine serving this had a container on 8091, so the
# valley there listens on 8291 and nginx hands `/valley` to it. That number
# lived only in the binary running on the box for a while, which meant the
# thing in production could not be rebuilt from what is written down here. Now
# it is an argument, and the source is the whole story again.
# ---- settings ---------------------------------------------------------------
#
# What this valley is, said on the command line rather than in this file:
#
#     ./valleyd 8291 meteors=off crystals=180 match=300
#
# A setting is `name=value`, anywhere after the port, in any order. The port
# stays where it was — first argument, bare — because every script that starts
# this server already passes it that way, and `port=8291` works too.
#
# The point is not the three settings that exist today. It is that turning
# something off no longer means editing a constant, rebuilding, and shipping a
# binary to find out.

fn setting(key, dflt) = setting_from(args(), key, dflt)

fn setting_from(l, key, dflt) = match l
  Nil -> dflt
  Cons(a, rest) -> if starts_with(a, key + "=") then str_sub(a, #key + 1, #a - #key - 1) else setting_from(rest, key, dflt)

fn setting_int(key, dflt) =
  v = setting(key, "")
  if #v == 0 then dflt else str_to_int(v)

# `off`, `no`, `false` and `0` are all off, because whoever is typing it at four
# in the morning should not have to remember which one this program wanted.
fn setting_on(key, dflt) =
  v = setting(key, "")
  if #v == 0 then dflt else if v == "off" || v == "no" || v == "false" || v == "0" then 0 else 1

# The first argument is the port, for the keeper's sake — `./valleyd 8291`.
# Only if it looks like one: everything else on the line is `key=value`, and
# `str_to_int` reads `gravity=60` as nought, which is a port nothing can
# listen on and a puzzling way to find out you have a setting.
fn positional_port() =
  if arg_count() > 1 && str_find(arg(1), "=") < 0 then str_to_int(arg(1)) else 8091

fn port() = setting_int("port", positional_port())

# What this planet pulls with, in tenths of a metre per second squared —
# `gravity=26` is the valley as it has always been, `gravity=6` is a moon to
# jump about on. Tenths because a setting is an integer and a planet is not:
# `gravity=98` is Earth to the nearest tenth.
#
# Physics is the server's here, so this is the only place it can be set for a
# shared valley: a browser that turned its own gravity down would predict a
# jump the server never made and be pulled back down by the next snapshot.
# It goes out in `hello` so every client predicts against the same number.
fn gravity_tenths() = setting_int("gravity", 260)

# Fifty milliseconds. Fast enough that a walk looks like a walk once the
# client interpolates between two of them, slow enough that a valley with
# eight people in it is a few kilobytes a second.
fn tick_ms() = 50

fn dt() = 0.05

# What the world is made of. The client is told these and builds the same
# valley from them — the placement is a deterministic walk over a hash, so the
# same three numbers give the same trees and the same crystals in the same
# places. The grid is *not* here: it is the terrain mesh's resolution and
# nothing else samples it, so a slow machine may draw a coarser valley and
# still stand on exactly the same ground.
fn n_pines() = setting_int("pines", 400)

fn n_crystals() = setting_int("crystals", 300)

fn n_grass() = setting_int("grass", 900)

# A bolt action, enforced where it matters. The animation is the browser's,
# but a client that simply did not play it could otherwise send five hundred
# rounds a second.
fn reload_s() = 0.55

# How long a silence is allowed to last before somebody is taken out of the
# valley. A client sends its keys and its look every frame it draws, so ten
# seconds is two or three hundred messages that did not arrive — and until
# they are dropped they are still standing there: in the snapshot, in the
# count, in the way, and a target for whatever the crystals throw.
# Thirty seconds. A client sends a heartbeat every two whether or not anybody
# is looking at it, so this is fifteen missed in a row — but a browser throttles
# its timers in a tab that has been hidden for a while, and being thrown out of
# the valley for looking at another tab is worse than holding a dead
# connection's place for another twenty seconds.
fn quiet_s() = 30.0

# How many messages a second one connection may have listened to. A browser
# sends its keys sixty times a second and a ping once, so a hundred and fifty
# is well above anything honest and far below what a machine can send — and it
# is what keeps one client from spending the whole server on itself. Over the
# budget the reader sleeps out the rest of the second; see `hush`.
#
# It was ninety, which is above sixty and looked like plenty. It was not: a
# browser sent one input a *frame*, and a hundred-and-twenty hertz screen sends
# a hundred and twenty a second. Nineteen of them a second went unread, waited
# in the kernel buffer, and everything sent after them waited behind — so the
# player's own ping, which is a message like any other, came back reading half
# a minute. The page sends sixty a second now whatever the screen does, and the
# allowance has room above it for the shots and the pings and for a client that
# does not know about the cap.
#
# The number below is the fix for a real starvation, not a theoretical one: the
# hub takes its tick off the same channel as the key presses, and with an
# unbounded sender the tick never wins. Measured on a model of it — four busy
# senders, and in eight seconds the ticker got through exactly zero times.
fn heard_per_second() = 150

# How many sockets may be open at once, whether or not their owners ever say
# anything. The valley holds thirty-two; the rest of these are room for the
# handshake and for connections on their way out.
fn max_connections() = 64

# How long a connection has to get its handshake in. A browser sends it in the
# same breath as opening the socket; anything that has not managed it in five
# seconds is not a browser, and until it does it is holding one of the places
# above.
fn handshake_ms() = 5000

# And how many of those one address may have. The whole cap is no use against
# somebody who simply opens sixty-four connections: they are then the only
# person who can get in. Sixteen is generous for a household or an office
# behind one address — everybody there shares it — and still leaves
# three-quarters of the valley to everyone else.
fn per_address() = 16

# How many people this valley admits. The world itself has room for thirty-two
# — `player_cap` in `valley.rill`, which is a shape the browser compiles too —
# and this is not that: it is what this server chooses to let in, and it can be
# lowered without touching the file the client shares. Eight is what a tick of
# fifty milliseconds carries comfortably, everybody being told about everybody.
fn max_players() = 16

# Whether the crystals throw fire in the shared valley. On: what a meteor is
# aimed at is where somebody is standing, and standing about is most of what
# people do while there are others to look at — which is the argument for
# leaving it off and turned out to be the argument for turning it on, since
# something that makes standing about dangerous is the point. The throws and
# the craters were already on the wire, one line each per tick, so a browser
# sees this valley's meteors exactly as it sees its own.
# Off by default here. A browser alone in its own valley was what the thrown
# fire was written for; a shared one is a place people are trying to stand
# about in and shoot each other, and being shelled from the hillside while
# doing it is somebody else's game. `meteors=on` puts them back.
fn meteors() = setting_on("meteors", 0)

fn match_secs() = setting_int("match", 1800)

fn report_secs() = setting_int("report", 20)

# How many addresses are tracked at once. One row per connection is more than
# enough: a row is only in use while at least one connection from that address
# is, so they come back as people leave.
fn address_rows() = 64

# ---- what goes between them ------------------------------------------------
#
# One inbox, one message type. `Tick` arrives on the same channel as the key
# presses, which is what makes a tick a point in time everybody agrees on
# rather than something that cuts across a message being handled.

type Msg
  Arrived(out: Chan(Str), token: Str)
  Named(id: Int, name: Str)
  Moved(id: Int, keys: Int, yaw: Float, pitch: Float)
  Shot(id: Int, dx: Float, dy: Float, dz: Float)
  Reloaded(id: Int)
  Mined(id: Int)
  Built(id: Int)
  Said(id: Int, text: Str)
  Pinged(id: Int, token: Str)
  Left(id: Int)
  Tick

# A connection, from the hub's side: who it is, their block in the world, and
# the channel their writer is listening on. What they have asked to do lives on
# the block, so that the tick reads one thing rather than two that have to be
# kept in step.
type Conn
  Conn(id: Int, block: Ptr, out: Chan(Str), name: Str, token: Str)

# ---- the hub ---------------------------------------------------------------

fn hub(w, conns, inbox, joins, said) =
  m = recv(inbox)
  next = handle(w, conns, inbox, joins, m, said)
  hub(w, next, inbox, if_arrived(m, joins), said)

# The id to hand out next. It comes off the world's own counter rather than
# being kept here, so a player's id and their block agree about who they are.
fn if_arrived(m, joins) = match m
  Arrived(_, _) -> joins + 1
  _ -> joins

fn handle(w, conns, inbox, joins, m, said) = match m
  Arrived(out, token) -> admit(w, conns, out, token)
  Named(id, name) -> name_one(w, conns, id, name)
  Moved(id, keys, yaw, pitch) -> move_one(w, conns, id, keys, yaw, pitch)
  Shot(id, dx, dy, dz) -> shoot_one(w, conns, id, dx, dy, dz)
  Reloaded(id) -> reload_one(w, conns, id)
  Mined(id) -> mine_one(w, conns, id)
  Built(id) -> build_one(w, conns, id)
  Said(id, text) -> say_one(w, conns, id, text)
  Pinged(id, token) -> pong(conns, id, token)
  Left(id) -> drop_one(w, conns, id)
  Tick -> tick(w, conns, said)

fn admit(w, conns, out, token) =
  if v.players(w) >= max_players() then refuse(conns, out) else take_in(w, conns, out, token)

fn take_in(w, conns, out, token) =
  s = v.join(w)
  if is_null(s) then refuse(conns, out) else welcome(w, conns, s, out, token)

fn refuse(conns, out) =
  b = strbuf()
  put_u8(b, op_no())
  strbuf_add(b, "the valley is full")
  send(out, strbuf_str(b))
  conns

# What a client needs before it can draw anything: which player it is, and how
# much valley to build.
fn welcome(w, conns, s, out, token) =
  id = v.player_id(s)
  # The name they left with, if that token has one and nobody in the valley is
  # wearing it this second — two people cannot both be `ada`, whoever owns it.
  mine = name_of(read_file_raw(who_file()), token)
  name = if str_len(mine) > 0 && !taken(conns, id, mine) then mine else called(id)
  send(out, hello_msg(w, id, token))
  send(out, ver_msg())
  send(out, pull_msg(w))
  send(out, gone_list(w))
  send(out, stones_list(w))
  send(out, fells_list(w))
  send(out, carve_field_msg(w))
  send_built_list(w, out)
  send_mags(w, out, 0)
  roster(conns, out)
  println("player " + int_to_str(id) + " arrived as " + name + ", " + int_to_str(v.players(w)) + " in the valley")
  joined(Cons(Conn(id, s, out, name, token), conns), id, name)

# Everybody hears about the new arrival straight away, under the name they get
# for nothing. A client that goes on to say what it would rather be called
# sends that separately, and everyone hears again.
# Under the name they arrived with, which is the one they took last time if
# they have been here before — `called(id)` was right back when it was the only
# name anybody could have on arrival, and saying it now would announce
# `player7` and then correct itself to `ada` a moment later.
fn joined(conns, id, name) =
  tell_all(conns, who_msg(id, name))
  conns

# `alloc_bytes` is deliberately uncounted, so every scratch taken here is
# handed back with `free_ptr` before the function returns. The lesson cost a
# soak test: a scratch per snapshot at twenty a second per player was half a
# megabyte a minute that never came back.
fn hello_msg(w, id, token) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_hello())
  put_u16(b, id)
  put_u32(b, n_pines())
  put_u32(b, n_crystals())
  put_u32(b, n_grass())
  put_f32(b, sc, v.world_time(w))
  strbuf_add(b, token)
  free_ptr(sc)
  strbuf_str(b)

# One float: what everybody in this valley falls at.
fn pull_msg(w) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_pull())
  put_f32(b, sc, v.gravity(w))
  free_ptr(sc)
  strbuf_str(b)

fn ver_msg() =
  b = strbuf()
  put_u8(b, op_ver())
  put_u16(b, version())
  strbuf_str(b)

fn who_msg(id, name) =
  b = strbuf()
  put_u8(b, op_who())
  put_u16(b, id)
  strbuf_add(b, name)
  strbuf_str(b)

# Which crystals are already gone. A break is an event from here on, but
# somebody arriving an hour in has missed several hundred of them, and a
# client drawing crystals that were shot before it connected would be a client
# shooting at nothing.
# Which stones are already broken, for the same reason and by the same means:
# one line at the door with every index on it, read straight off the marks the
# world keeps. The client computes where each one lies — the resting place is
# a function of the index, which is the whole reason it could be.
fn stones_list(w) =
  b = strbuf()
  put_u8(b, op_wall())

  for i in 0..v.block_count(w)
    if_broken(w, b, i)

  strbuf_str(b)

# And the pines already down, by the same door and the same means.
fn fells_list(w) =
  b = strbuf()
  put_u8(b, op_pinelist())

  for i in 0..v.pine_count(w)
    if_felled(w, b, i)

  strbuf_str(b)

fn if_felled(w, b, i) = if v.pine_felled(w, i) > 0 then note_gone(b, i) else 0

fn if_broken(w, b, i) = if v.block_broken(w, i) > 0 then note_gone(b, i) else 0

# The carve field for somebody at the door: op, the two cursors, then one
# entry per dug patch — the engine keeps the field as pages and this walks
# only the pages that exist. A patch entry is (u16 patch, u16 n) and then n
# columns of (u16 cell, sixteen bytes of mask), which is what a column is
# now: a bit for every thirty-centimetre slab of it that has been taken out.
# An untouched valley is nine bytes, a sunk shaft is a few hundred, and a
# valley is downloaded in proportion to what was dug out of it.
fn carve_field_msg(w) =
  b = strbuf()
  put_u8(b, op_carvefield())
  put_u32(b, v.carves(w))
  put_u32(b, v.built(w))
  cf_pages(w, b)
  strbuf_str(b)

fn cf_pages(w, b) =
  for sx in 0..v.carve_supers()
    if v.carve_page_at(w, sx) > 0 then cf_page(w, b, sx) else 0

  1

fn cf_page(w, b, sx) =
  n = cf_count(w, sx)
  if n == 0 then 0
  else
    put_u16(b, sx)
    put_u16(b, n)
    cf_cols(w, b, sx)

fn cf_count(w, sx) =
  for c in 0..v.carve_page_cells() with n = 0
    n + v.yes(v.carve_col_any(w, sx, c) > 0)

fn cf_cols(w, b, sx) =
  for c in 0..v.carve_page_cells()
    if v.carve_col_any(w, sx, c) > 0 then cf_col(w, b, sx, c) else 0

  1

fn cf_col(w, b, sx, c) =
  put_u16(b, c)

  for i in 0..v.carve_col_bytes()
    put_u8(b, v.carve_col_byte(w, sx, c, i))

  1
  1

fn send_built_list(w, out) =
  for k in 0..v.built(w)
    send(out, built_msg(w, k))

  1

fn gone_list(w) =
  b = strbuf()
  put_u8(b, op_gone())

  for i in 0..v.crystal_count(w)
    if_gone(w, b, i)

  strbuf_str(b)

fn if_gone(w, b, i) = if v.crystal_scale(w, i) < 0.01 then note_gone(b, i) else 0

# Where the ammunition is, for somebody who has just walked in. One line each
# and only at the door: a box moves when it is picked up and not otherwise, so
# after this the client hears about them one at a time.
fn send_mags(w, out, i) =
  if i >= v.mag_count() then 0 else say_mag(w, out, i)

fn say_mag(w, out, i) =
  send(out, mag_msg(i, v.mag_times(w, i)))
  send_mags(w, out, i + 1)

fn mag_msg(i, times) =
  b = strbuf()
  put_u8(b, op_mag())
  put_u8(b, i)
  put_u32(b, times)
  strbuf_str(b)

fn note_gone(b, i) =
  put_u16(b, i)
  1

fn find(conns, id) = match conns
  Nil -> None
  Cons(c, rest) -> if conn_id(c) == id then Some(c) else find(rest, id)

fn conn_id(c) = match c
  Conn(id, _, _, _, _) -> id

fn conn_block(c) = match c
  Conn(_, s, _, _, _) -> s

fn conn_out(c) = match c
  Conn(_, _, out, _, _) -> out

fn conn_name(c) = match c
  Conn(_, _, _, n, _) -> n

fn conn_token(c) = match c
  Conn(_, _, _, _, t) -> t

# ---- bytes on the wire ------------------------------------------------------
#
# The protocol is binary: one message per frame, little-endian, and the first
# byte says which message it is. The byte chosen is the letter the old text
# protocol used, so a hexdump of the wire still reads — a snapshot still
# starts with an `s`.
#
# Down:  h  u16 id, u32 pines, u32 crystals, u32 grass, f32 clock, token…
#        n  the words of a refusal
#        g  u16 crystal indices, one per pair to the end of the frame
#        W  u16 stone indices, likewise
#        m  u8 box, u32 times taken
#        u  u16 id, name…                        (the text protocol's `who`)
#        p  the ping token, handed straight back
#        s  f32 clock, f32 shark x y z heading mode, u8 phase, f32 left,
#           u8 count, then 37 bytes a player: u16 id, f32 x y z yaw pitch
#           health, u8 pose, u16 hit, u16 shot, u8 seen, i8 ammo,
#           u16 kills, u16 deaths
#        r  f32 x y z vx vy vz owner
#        t  f32 x y z vx vy vz seed life
#        k  f32 x y z seed
#        x  u16 who, u16 by whom, f32 how much, u8 down
#        d/w/b  u16 index
#        y  u16 pine index, felled by a warhead
#        P  u16 pine indices already down, for whoever walks in late
#        z  u16 who, u16 crystal — a crystal bit somebody standing against it
#
# Up:    i  u16 keys, f32 yaw, f32 pitch — bits 7-8 carry which weapon
#        f  f32 dx dy dz
#        n  the name
#        p  the ping token
#
# A float travels through a scratch buffer: `poke_f32` lays the four bytes
# down and `peek_u8` picks them back up, which moves the bit pattern and
# nothing else. Both ends of this wire are little-endian and so is the wire.

fn op_hello() = 104
fn op_no() = 110
fn op_gone() = 103
fn op_wall() = 87
fn op_mag() = 109

# `R`, and it only ever comes inward: somebody has asked for a fresh magazine
# with rounds still in the old one. Free in the table — the letters the server
# sends are all elsewhere in it.
fn op_reload() = 82

# Chat, and the one thing in the table that needs a letter each way: `c` is
# somebody saying something, `C` is the valley being told who said it. The
# other messages are one direction each and could share, and these cannot —
# a client that echoed its own `c` back at itself would be a client talking
# to nobody.
fn op_say() = 99
fn op_said() = 67

# `v`, once, at the door: which build this server is. Its own message rather
# than a field grown onto `hello`, because the token rides at hello's tail and
# anything inserted before it would shift what an old page reads as its
# identity — a new message an old client quietly drops costs nobody anything.
#
# The number is the same one `V` is in host.js, bumped in the same breath at
# every deploy. That is the point of showing both ends: a page left open
# across a deploy reads `valley 388 · server 389` and knows the fix it is
# missing is one reload away.
fn op_ver() = 118

# What the planet pulls with, said once on arrival. Its own message rather
# than four more bytes on the end of `hello`, because `hello` is followed by a
# token whose offset a client of any age knows.
fn op_pull() = 71

fn version() = 489
fn op_who() = 117
fn op_pong() = 112
fn op_snap() = 115
fn op_round() = 114
fn op_throw() = 116
fn op_crater() = 107
fn op_hurt() = 120
fn op_downed() = 100
fn op_stone() = 119
fn op_break() = 98
fn op_fell() = 121
fn op_pinelist() = 80
fn op_zap() = 122
fn op_input() = 105
fn op_fire() = 102

fn op_mine() = 77

fn op_build() = 78

fn op_carve() = 84

fn op_carvefield() = 85

fn op_built() = 86

fn op_pocket() = 93
fn op_name() = 110
fn op_ping() = 112

fn put_u8(b, n) = strbuf_byte(b, bit_and(n, 255))

fn put_u16(b, n) =
  strbuf_byte(b, bit_and(n, 255))
  strbuf_byte(b, bit_and(shr(n, 8), 255))

fn put_u32(b, n) =
  put_u16(b, n)
  put_u16(b, shr(n, 16))

fn put_f32(b, sc, v) =
  poke_f32(sc, 0, v)
  strbuf_byte(b, peek_u8(sc, 0))
  strbuf_byte(b, peek_u8(sc, 1))
  strbuf_byte(b, peek_u8(sc, 2))
  strbuf_byte(b, peek_u8(sc, 3))

fn u16_at(msg, i) = bit_or(str_get(msg, i), shl(str_get(msg, i + 1), 8))

fn f32_at(msg, sc, i) =
  poke_i8(sc, 0, str_get(msg, i))
  poke_i8(sc, 1, str_get(msg, i + 1))
  poke_i8(sc, 2, str_get(msg, i + 2))
  poke_i8(sc, 3, str_get(msg, i + 3))
  peek_f32(sc, 0)

# Everything after the opcode byte, for the messages that carry words.
fn rest_of(msg) = str_sub(msg, 1, str_len(msg) - 1)

# A cell number, which no longer fits the two bytes the other indices use:
# the field is 568 cells square now that a cell is a wall stone, so a bite is
# an opcode and four bytes. Still the whole of what a swing costs the wire.
fn cell_msg(op, i) =
  b = strbuf()
  put_u8(b, op)
  put_u32(b, i)
  strbuf_str(b)

# The messages that are an opcode and one index, which is most of the ring
# traffic: a stone, a crystal, a downed meteor.
fn index_msg(op, i) =
  b = strbuf()
  put_u8(b, op)
  put_u16(b, i)
  strbuf_str(b)

# ---- who everyone is -------------------------------------------------------
#
# A name is sent once and remembered rather than riding in every snapshot
# twenty times a second: it changes about as often as a person arrives.
#
# What comes off the wire is somebody's to choose, so it is cut down to what
# can be drawn and what cannot break the protocol — letters and digits, eight
# of them at most. A space would split the line it is sent on, which is the
# whole reason this is not passed through as it came.
#
# And it has to be somebody else's name than everybody else's. Two players
# called the same thing is not a cosmetic problem: the tag over a head and the
# row in the roster are the only way anybody tells who shot them, and a valley
# with two `baris` in it cannot be reasoned about by the people in it. Taken
# names get a number, which is done here rather than refused back to the
# client — a join that fails on the last step, after the world has been built
# and the socket is open, is a worse thing to hand somebody than a name with a
# 2 after it. The client is told what it ended up with, on the same `who` line
# everybody else gets, so it is never guessing.
fn name_cap() = 8

fn called(id) = "player" + int_to_str(id)

fn clean_name(raw, id) =
  b = strbuf()

  for i in 0..str_len(raw)
    keep_char(b, raw, i)

  short = str_sub(strbuf_str(b), 0, name_cap())
  if str_len(short) == 0 then called(id) else short

fn keep_char(b, raw, i) = if ok_char(str_get(raw, i)) then took(b, str_get(raw, i)) else 0

fn took(b, c) =
  strbuf_byte(b, c)
  1

fn ok_char(c) =
  c >= 48 && c <= 57 || (c >= 65 && c <= 90 || c >= 97 && c <= 122)

fn name_one(w, conns, id, raw) = match find(conns, id)
  None -> conns
  Some(c) -> wants(w, conns, c, id, clean_name(raw, id), read_file_raw(who_file()))

# Read once and carried down, because `unique` asks about a name several times
# and a file read for each would be a file read per letter of the suffix.
fn wants(w, conns, c, id, name, book) =
  maybe_rename(w, conns, c, id, unique(conns, c, id, name, book), book)

# A name change goes out to everybody in the valley, so one client renaming as
# fast as it is allowed to speak is that many lines times everybody here — the
# cheapest amplifier in the protocol. Two things stop it: a name that is not
# actually different is not news, and nobody needs to change theirs more than
# once every few seconds. Both are refusals rather than disconnections, because
# a client repeating itself is a bug and not an attack and the two look the
# same from this side.
fn maybe_rename(w, conns, c, id, name, book) =
  s = conn_block(c)
  if conn_name(c) == name then conns else if v.may_rename(s, v.world_time(w)) == 0 then conns else rename(w, conns, c, id, name, book)

# The first free one of `name`, `name2`, `name3` and so on. The suffix eats
# into the cap rather than pushing past it, so what comes out is still a name
# eight characters long at most. Sixty-four connections is the ceiling, so
# `n` cannot climb past two digits and the search cannot fail to terminate.
fn unique(conns, c, id, name, book) =
  if spoken_for(conns, c, id, name, book) then unique_from(conns, c, id, name, book, 2) else name

fn unique_from(conns, c, id, name, book, n) =
  tag = int_to_str(n)
  tried = str_sub(name, 0, name_cap() - str_len(tag)) + tag
  if spoken_for(conns, c, id, tried, book) then unique_from(conns, c, id, name, book, n + 1) else tried

# Two ways a name can be somebody else's: they are standing in the valley
# wearing it, or they took it once and are not here. The second is the whole
# point of a token — a name somebody walked away with is still theirs when
# they come back, and the way to make that true is to refuse it to everybody
# else while they are gone.
fn spoken_for(conns, c, id, name, book) =
  taken(conns, id, name) || mine_elsewhere(owner_of(book, name), conn_token(c))

fn mine_elsewhere(owner, token) = str_len(owner) > 0 && owner != token

# Whoever is asking does not count against themselves — sending the same name
# twice is a client repeating itself, not a collision.
fn taken(conns, id, name) = match conns
  Nil -> false
  Cons(c, rest) -> conn_id(c) != id && conn_name(c) == name || taken(rest, id, name)

fn rename(w, conns, c, id, name, book) =
  v.renamed(conn_block(c), v.world_time(w))
  remember(book, conn_token(c), name)
  next = replace(conns, id, Conn(id, conn_block(c), conn_out(c), name, conn_token(c)))
  tell_all(next, who_msg(id, name))
  next

fn replace(conns, id, c2) = match conns
  Nil -> Nil
  Cons(c, rest) -> if conn_id(c) == id then Cons(c2, rest) else Cons(c, replace(rest, id, c2))

fn tell_all(conns, line) = match conns
  Nil -> 0
  Cons(c, rest) -> tell_one(c, rest, line)

fn tell_one(c, rest, line) =
  offer(conn_out(c), line)
  tell_all(rest, line)

# ---- how far away the server is --------------------------------------------
#
# The token comes back on the same channel everything else does, which is the
# point: a reply sent from the reader strand would time the socket and the
# kernel and nothing else, and the socket is not what a player is waiting on.
# Queued behind the ticks and the inputs like a snapshot is, it measures the
# thing that actually decides whether a shot lands — how long it takes this
# server to get round to you.
#
# The token itself is never read here, only handed back. It is the client's
# clock, and the server has no business having an opinion about it. On a text
# wire it went through the same cleaner a name did, so a client could not make
# the server emit an arbitrary line to itself; on a binary one the token is
# payload and nothing parses it, so the only guard it needs is a length.
fn pong(conns, id, token) = match find(conns, id)
  None -> conns
  Some(c) -> ponged(conns, c, token)

fn ponged(conns, c, token) =
  b = strbuf()
  put_u8(b, op_pong())
  strbuf_add(b, str_sub(token, 0, 20))
  offer(conn_out(c), strbuf_str(b))
  conns

# Everyone already here, for somebody who has just walked in.
fn roster(conns, out) = match conns
  Nil -> 0
  Cons(c, rest) -> roster_one(c, rest, out)

fn roster_one(c, rest, out) =
  offer(out, who_msg(conn_id(c), conn_name(c)))
  roster(rest, out)

# An input is a look and a set of keys, and the walk is run at the tick rate
# from whatever the last one said. Running it on arrival instead would let a
# client walk faster by talking faster, which is the oldest trick there is.
fn move_one(w, conns, id, keys, yaw, pitch) = match find(conns, id)
  None -> conns
  Some(c) -> apply_input(w, conns, c, keys, yaw, pitch)

fn apply_input(w, conns, c, keys, yaw, pitch) =
  v.set_look(conn_block(c), yaw, pitch)
  v.set_keys(conn_block(c), keys)
  v.heard(conn_block(c), v.world_time(w))
  conns

# A shot is asked for here and taken at the next tick, with everybody else's.
fn shoot_one(w, conns, id, dx, dy, dz) = match find(conns, id)
  None -> conns
  Some(c) -> asked_to_fire(w, conns, conn_block(c), dx, dy, dz)

fn asked_to_fire(w, conns, s, dx, dy, dz) =
  v.want_fire(s, dx, dy, dz)
  v.heard(s, v.world_time(w))
  conns

# The world decides whether it takes — `ask_reload` holds both ends to the same
# rule — and this only says who asked. `heard` for the same reason a shot does
# it: a message is a sign of life and the timeout is watching.
fn reload_one(w, conns, id) = match find(conns, id)
  None -> conns
  Some(c) -> asked_to_reload(w, conns, conn_block(c))

fn asked_to_reload(w, conns, s) =
  v.ask_reload(s)
  v.heard(s, v.world_time(w))
  conns

# A swing or a rock, asked for by one byte. The world holds every rule — the
# reach, the rock line, the price — so the server's whole part is to run it
# on the asker's block and, when the pocket moved, say so to the one pocket
# it belongs to. The craters and the rocks reach everybody through the tick's
# rings, like every other change to the world.
fn mine_one(w, conns, id) = match find(conns, id)
  None -> conns
  Some(c) -> did_mine(w, conns, c)

fn did_mine(w, conns, c) =
  s = conn_block(c)
  got = v.swing_pick(s)
  v.heard(s, v.world_time(w))
  if got > 0 then say_pocket(c, s) else 0
  conns

fn build_one(w, conns, id) = match find(conns, id)
  None -> conns
  Some(c) -> did_build(w, conns, c)

fn did_build(w, conns, c) =
  s = conn_block(c)
  ok = v.try_build(s)
  v.heard(s, v.world_time(w))
  if ok > 0 then say_pocket(c, s) else 0
  conns

fn say_pocket(c, s) =
  b = strbuf()
  put_u8(b, op_pocket())
  put_u16(b, v.stones_of(s))
  offer(conn_out(c), strbuf_str(b))
  1

# ---- somebody said something -----------------------------------------------
#
# The only message a client can put in front of every other player's eyes with
# words of its own choosing, so it is the one that has to be read carefully:
# what arrives is bytes from a socket and what goes out is a line on fifteen
# screens.
#
# Three things stand between them. The text is cut to printable ASCII, which
# takes out the control bytes that would otherwise walk across somebody's log —
# and every byte that survives is one the far end renders as *text* rather than
# as markup, which is where the real defence is and why it is written down at
# both ends. It is cut to a length. And nobody may do it faster than once every
# second and a half.
#
# An empty line is not news and does not go out. Nor is it an error: it is what
# pressing return twice looks like.
fn say_cap() = 120

fn say_one(w, conns, id, raw) = match find(conns, id)
  None -> conns
  Some(c) -> maybe_say(w, conns, c, id, clean_say(raw))

fn maybe_say(w, conns, c, id, text) =
  s = conn_block(c)
  v.heard(s, v.world_time(w))
  if str_len(text) == 0 then conns else if v.may_say(s, v.world_time(w)) == 0 then conns else spoke(w, conns, s, id, text)

fn spoke(w, conns, s, id, text) =
  v.said_at(s, v.world_time(w))
  broadcast(w, conns, said_msg(id, text))
  conns

fn said_msg(id, text) =
  b = strbuf()
  put_u8(b, op_said())
  put_u16(b, id)
  strbuf_add(b, text)
  strbuf_str(b)

# Space to tilde, and nothing else. A tab would be a tab in somebody's log, a
# newline would be two lines where one was sent, and a byte under thirty-two is
# neither of those things and has no business on a screen at all.
fn clean_say(raw) =
  b = strbuf()

  for i in 0..str_len(raw)
    keep_said(b, raw, i)

  trim_run(str_sub(strbuf_str(b), 0, say_cap()))

fn keep_said(b, raw, i) = if said_char(str_get(raw, i)) then took(b, str_get(raw, i)) else 0

fn said_char(c) = c >= 32 && c <= 126

# A line of nothing but spaces is a line of nothing. Trimmed from the front and
# then from the back, which between them make one of the two the same as none.
fn trim_run(s) = trim_end(trim_front(s, 0))

fn trim_front(s, i) =
  if i >= str_len(s) then "" else if str_get(s, i) == 32 then trim_front(s, i + 1) else str_sub(s, i, str_len(s) - i)

fn trim_end(s) =
  if str_len(s) == 0 then s else if str_get(s, str_len(s) - 1) == 32 then trim_end(str_sub(s, 0, str_len(s) - 1)) else s

fn drop_one(w, conns, id) = match find(conns, id)
  None -> conns
  Some(c) -> forget(w, conns, c, id)

fn forget(w, conns, c, id) =
  v.leave(w, conn_block(c))
  println("player " + int_to_str(id) + " left, " + int_to_str(v.players(w)) + " remain")
  without(conns, id)

fn without(conns, id) = match conns
  Nil -> Nil
  Cons(c, rest) -> if conn_id(c) == id then rest else Cons(c, without(rest, id))

# ---- one tick --------------------------------------------------------------
#
# Everybody walks, the world moves, everybody picks up what is now at their
# feet — the same order, and the same three calls, that `frame` makes in a
# browser with the valley to itself.

fn tick(w, conns, said) =
  # What the rings said before the world moved. Everything that happens in
  # between is the difference, which is the whole of the event log: a cursor
  # that only counts up and a ring behind it means nothing has to be recorded
  # a second time in order to be sent.
  shots0 = v.shots(w)
  throws0 = v.throws(w)
  craters0 = v.blasts_fired(w)
  breaks0 = v.breaks(w)
  stones0 = v.blocks_gone(w)
  downed0 = v.fires_down(w)
  hurts0 = v.hurts(w)
  fells0 = v.pines_down(w)
  zaps0 = v.zaps(w)
  walk_all(conns)
  fire_all(w, conns)
  v.step_world(w, dt())
  pick_all(conns)
  v.rise_all(w)
  left = drop_quiet(w, conns, v.world_time(w))
  drain(w, left, since(shots0, v.shots(w)), v.shots(w), \k -> shot_msg(w, k))
  drain(w, left, since(throws0, v.throws(w)), v.throws(w), \k -> throw_msg(w, k))
  drain(w, left, since(craters0, v.blasts_fired(w)), v.blasts_fired(w), \k -> crater_msg(w, k))
  drain(w, left, since(breaks0, v.breaks(w)), v.breaks(w), \k -> index_msg(op_break(), v.break_which(w, k)))
  drain(w, left, since(stones0, v.blocks_gone(w)), v.blocks_gone(w), \k -> index_msg(op_stone(), v.block_which(w, k)))
  drain(w, left, v.carve_sent(w), v.carves(w), \k -> cell_msg(op_carve(), v.carve_ev(w, k)))
  drain(w, left, v.built_sent(w), v.built(w), \k -> built_msg(w, k))
  v.mark_carves_sent(w)
  drain(w, left, since(downed0, v.fires_down(w)), v.fires_down(w), \k -> index_msg(op_downed(), v.down_which(w, k)))
  drain(w, left, since(hurts0, v.hurts(w)), v.hurts(w), \k -> hurt_msg(w, k))
  drain(w, left, since(fells0, v.pines_down(w)), v.pines_down(w), \k -> index_msg(op_fell(), v.fell_which(w, k)))
  drain(w, left, since(zaps0, v.zaps(w)), v.zaps(w), \k -> zap_msg(w, k))
  again(said)
  send_mag_moves(w, left, said, 0)
  tell_each(w, left, left)
  left

# A ring cursor read before the world stepped, made safe against that step
# having been the one that ended the match. `new_match` empties the rings —
# stones, breaks, downed fire back to nought — so a cursor carried over from
# the old match is a count the new one may never reach, and a send loop that
# walks `from` upward until it *equals* the cursor walks for ever, broadcasting
# as it goes. The hub never comes back from that tick: nobody new can be
# admitted, nobody quiet can be dropped, and the whole server reads as one
# spinning core. Behind a reset the honest place to start is nought — the new
# match's events begin there, and whatever the old match had not yet said died
# with it.
fn since(from, now) = if from > now then 0 else from

# One box said again every second, whether it moved or not.
#
# The count a client keeps is its own until it hears otherwise, and it moves a
# box the moment it walks onto one rather than waiting for the round trip. Two
# ways that can come apart: a pickup this server did not agree with — somebody
# standing on the edge of the reach, where a few centimetres of disagreement
# about where they are is the difference — and a message that did not arrive.
# Neither would ever be corrected by a scheme that only speaks when something
# changes, and what they leave behind is a box drawn where there is none.
#
# So the last slot of the buffer counts ticks, and every twentieth one forgets
# what was said about one box, which sends it again. Sixteen seconds to work
# right round, one short line a second, and nothing to go wrong in the quiet.
fn again(said) =
  c = peek_i64(said, mag_count_slot()) + 1
  poke_i64(said, mag_count_slot(), c)
  if c % 20 != 0 then 0 else forget_one(said, c / 20)

fn forget_one(said, k) =
  poke_i64(said, k % v.mag_count(), 0 - 1)
  1

# Where that counter lives: one past the boxes.
fn mag_count_slot() = v.mag_count()

# A box that is not where this server last said it was. Sixteen comparisons a
# tick against sixteen numbers written down here, which is cheaper than either
# putting them all in every snapshot or making the world keep a log of its own
# — and it says nothing at all on a tick where nobody picked anything up.
fn send_mag_moves(w, conns, said, i) =
  if i >= v.mag_count() then 0 else moved_mag(w, conns, said, i)

fn moved_mag(w, conns, said, i) =
  now = v.mag_times(w, i)
  if now == peek_i64(said, i) then send_mag_moves(w, conns, said, i + 1) else tell_moved(w, conns, said, i, now)

fn tell_moved(w, conns, said, i, now) =
  poke_i64(said, i, now)
  broadcast(w, conns, mag_msg(i, now))
  send_mag_moves(w, conns, said, i + 1)

# Whoever is still talking. The socket is deliberately not closed here: a
# strand is parked on that descriptor inside the poller, closing it from
# another strand does not wake it, and the number could be handed to the next
# connection while the old registration is still armed — which is a great deal
# worse than a descriptor held open until TCP gives up on it. What matters is
# that they are out of the valley, and that happens here; the reader ends on
# its own whenever the connection is finally noticed to be gone.
fn drop_quiet(w, conns, now) = match conns
  Nil -> Nil
  Cons(c, rest) -> keep_or_drop(w, c, drop_quiet(w, rest, now), now)

fn keep_or_drop(w, c, rest, now) =
  if v.shooting_wild(conn_block(c)) > 0 then shooting_wild(w, c, rest) else if now - v.last_heard(conn_block(c)) < quiet_s() then Cons(c, rest) else gone_quiet(w, c, rest)

# Out the same door as anyone who has gone quiet, and for a related reason:
# whatever is on the other end of that socket, it is not the client we ship.
# The valley refuses a shot that goes nowhere near where its owner says they
# are looking, and a browser running our code cannot produce a run of them —
# so a run of them says the connection is being driven by hand, and the rest of
# what it sends is worth no more than the shots were.
#
# The socket is left to TCP, as above. Being out of the valley is what matters:
# the connection can go on talking, and every line it sends will find nobody to
# apply it to.
fn shooting_wild(w, c, rest) =
  v.leave(w, conn_block(c))
  println("player " + int_to_str(conn_id(c)) + " " + conn_name(c) + " was shooting where they were not looking, dropped; " + int_to_str(v.players(w)) + " left in the valley")
  rest

fn gone_quiet(w, c, rest) =
  v.leave(w, conn_block(c))
  println("player " + int_to_str(conn_id(c)) + " went quiet, dropped; " + int_to_str(v.players(w)) + " left in the valley")
  rest

# Everything below is the same shape: from where the cursor was to where it is
# now, one line each. They go out before the snapshot, so a client applies what
# happened and then is told where everyone ended up.

# Every ring is drained the same way: from where the cursor was to where it
# is now, one message each. That was eleven pairs of functions — twenty-two
# of them, each the same four lines with a different noun — and it is one
# loop and a lambda now. The message a ring makes is the only thing that
# differs, so the message is the only thing passed.
fn drain(w, conns, from, upto, msg) =
  for k in from..upto
    broadcast(w, conns, msg(k))

  1

fn shot_msg(w, k) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_round())

  for j in 0..7
    put_f32(b, sc, v.bullet_f(w, k, j))

  free_ptr(sc)
  strbuf_str(b)

fn throw_msg(w, k) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_throw())

  for j in 0..8
    put_f32(b, sc, v.fireball_f(w, k, j))

  free_ptr(sc)
  strbuf_str(b)

fn crater_msg(w, k) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_crater())

  for j in 0..4
    put_f32(b, sc, v.blast_f(w, k, j))

  free_ptr(sc)
  strbuf_str(b)

# Who hit whom, and for how much. Sent to everybody rather than to the one it
# happened to: it costs three numbers, and a client that knows what happened to
# the person beside it can say so — which is the difference between a valley
# where things happen and one where they happen to you.
fn hurt_msg(w, k) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_hurt())
  put_u16(b, to_int(v.hurt_f(w, k, 0)))
  put_u16(b, to_int(v.hurt_f(w, k, 1)))
  put_f32(b, sc, v.hurt_f(w, k, 2))
  put_u8(b, to_int(v.hurt_f(w, k, 3)))
  free_ptr(sc)
  strbuf_str(b)

fn built_msg(w, k) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_built())
  put_f32(b, sc, v.built_ev(w, k, 1))
  put_f32(b, sc, v.built_ev(w, k, 2))
  put_f32(b, sc, v.built_ev(w, k, 3))
  put_f32(b, sc, v.built_ev(w, k, 4))
  free_ptr(sc)
  strbuf_str(b)

# Who a crystal bit, and which crystal: the light and the sound are drawn
# from these two numbers in every browser, and the hurt itself rides the
# snapshot like all the server's hurts do.
fn zap_msg(w, k) =
  b = strbuf()
  put_u8(b, op_zap())
  put_u16(b, v.zap_who(w, k))
  put_u16(b, v.zap_which(w, k))
  strbuf_str(b)

fn walk_all(conns) = match conns
  Nil -> 0
  Cons(c, rest) -> walk_one(c, rest)

fn walk_one(c, rest) =
  s = conn_block(c)
  v.walk(s, dt(), 0.0, 0.0, v.keys_of(s))
  walk_all(rest)

fn fire_all(w, conns) = match conns
  Nil -> 0
  Cons(c, rest) -> fire_one(w, c, rest)

fn fire_one(w, c, rest) =
  v.try_fire(conn_block(c), v.world_time(w), reload_s())
  fire_all(w, rest)

fn pick_all(conns) = match conns
  Nil -> 0
  Cons(c, rest) -> pick_one(c, rest)

fn pick_one(c, rest) =
  v.pick_up(conn_block(c))
  pick_all(rest)

# Being killed leaves you on the ground for five seconds and then puts you back
# at the spawn with the valley as you left it. There is nothing else sensible
# to do with somebody in a world that does not end: the crystals they broke
# stay broken and the crater they were standing in is still there. Both halves
# of that — the clock and the standing up — are `valley.rill`'s, so a browser
# alone in its own valley falls over the same way.

# ---- what goes on the wire -------------------------------------------------
#
# One line per tick. The clock first, because the wind and the sun are
# functions of it and a client that has the time needs to be told neither.
# Then the shark, which is one animal and so is six numbers. Then everybody,
# seven numbers each.

# One snapshot per player now, rather than one for everybody.
#
# Everybody is still in every snapshot — the names, the health bars and the two
# counts down the left are who is in the valley, and that is not a secret from
# anyone standing in it. What is withheld is *where*: a player with a hill
# between them and the reader is sent with their position blanked and a zero on
# the end, and there is nothing in the line to draw them from.
#
# This is what costs the one-line broadcast, which was the cheapest thing in
# the loop. At eight players it is eight strings a tick instead of one and the
# line-of-sight work is a few hundred samples of a function that is arithmetic;
# at the sixty-four the valley can hold it is the most expensive thing here.
# The alternative is telling every client where everybody is and asking it
# nicely not to look.
fn snapshot(w, conns, eye) =
  b = strbuf()
  sc = alloc_bytes(8)
  put_u8(b, op_snap())
  put_f32(b, sc, v.world_time(w))
  put_f32(b, sc, v.shark_x(w))
  put_f32(b, sc, v.shark_y(w))
  put_f32(b, sc, v.shark_z(w))
  put_f32(b, sc, v.shark_heading(w))
  put_f32(b, sc, v.shark_mode(w))
  # Which part of the round this is, and how much of it is left. On the header
  # rather than per player: it is the same for everybody in the valley.
  put_u8(b, v.match_phase(w))
  put_f32(b, sc, v.match_left(w))
  put_u8(b, count_conns(conns, 0))
  add_players(b, sc, conns, eye)
  free_ptr(sc)
  strbuf_str(b)

fn count_conns(conns, n) = match conns
  Nil -> n
  Cons(_, rest) -> count_conns(rest, n + 1)

fn add_players(b, sc, conns, eye) = match conns
  Nil -> 0
  Cons(c, rest) -> add_player(b, sc, c, rest, eye)

fn add_player(b, sc, c, rest, eye) =
  s = conn_block(c)
  # Themselves always, and `can_see` of a block with itself would be a line of
  # length zero: two pointers are not compared here because they cannot be, so
  # it goes by the id the world gave them.
  seen = if v.player_id(s) == v.player_id(eye) then 1 else v.can_see(eye, s)
  put_u16(b, conn_id(c))
  place(b, sc, s, seen)
  put_f32(b, sc, v.health(s))
  put_u8(b, pose_of(s))
  put_u16(b, v.hits_given(s))
  put_u16(b, v.hits_taken(s))
  put_u8(b, seen)
  # How many rounds are in the rifle, and only ever your own. Whether the man
  # behind the rock is reloading is the sort of thing a client should have to
  # watch for rather than read off the wire, so everybody else's byte says
  # minus one, which is not a count and cannot be mistaken for an empty one.
  put_u8(b, if v.player_id(s) == v.player_id(eye) then v.held_ammo(s) else 0 - 1)
  # Kills and deaths, everybody's. Unlike the rifle's count these are meant to
  # be read about other people — that is what the board at the end of a round
  # is — and they are the server's to say.
  put_u16(b, v.kills(s))
  put_u16(b, v.deaths(s))
  add_players(b, sc, rest, eye)

# Zeros where the numbers would be. Not the last place they were seen, which
# would be a slower leak of the same thing, and not a plausible-looking guess,
# which would put a figure where nobody is — this says nothing, and the client
# draws nobody.
fn place(b, sc, s, seen) =
  if seen == 1 then placed(b, sc, s) else blanked(b)

fn placed(b, sc, s) =
  put_f32(b, sc, v.player_x(s))
  put_f32(b, sc, v.player_y(s))
  put_f32(b, sc, v.player_z(s))
  put_f32(b, sc, v.player_yaw(s))
  put_f32(b, sc, v.player_pitch(s))
  0

fn blanked(b) =
  for j in 0..20
    strbuf_byte(b, 0)
  0

# What somebody looks like they are doing, for whoever has to draw them.
#
# Worked out here rather than guessed at the far end from how fast a figure
# seems to be sliding: the server has the keys and the health, and two clients
# watching the same person should not disagree about whether they are running.
#
#   0 standing   1 walking   2 running   3 crouching   4 down
#
# And the lamp above them, on bit three of the same byte. It goes here rather
# than in a byte of its own because a byte of its own is a change to the length
# of every player's record on the wire, and the pose is a number that reaches
# four and is carried in something that reaches two hundred and fifty-five. The
# far end masks: `pose & 7` is what they are doing, `pose & 8` is whether their
# light is on.
# Bits 0-2 what they are doing, bit 3 the lamp, bits 4-5 what is in their
# hands — so the far end can put the right weapon in the right fists. A
# client old enough not to know masks the low bits and sees no change.
# Bits 0-2 what they are doing, bit 3 the lamp, bits 4-5 what is in their
# hands, bit 6 whether the pack is alight — everything about a player that is
# a small number rather than a position, in the one byte that was already
# being sent. A client old enough not to know masks the low bits and sees no
# change.
# The weapon field is two bits and there are five things a hand can hold now:
# both tools go out as 3, which the far end draws as empty hands. A 4 would
# carry into bit six and light everybody's jet, which is the kind of bug that
# gets found in production at night.
fn pose_of(s) =
  bit_or(bit_or(bit_or(doing(s), if v.torch(s) > 0 then 8 else 0), shl(pose_w(s), 4)),
         if v.jet_on(s) > 0 then 64 else 0)

fn pose_w(s) = if v.weapon(s) > 3 then 3 else v.weapon(s)

fn doing(s) =
  k = v.keys_of(s)
  if v.health(s) < 0.001 then 4 else if bit_and(k, 64) == 64 then 3 else if bit_and(k, 15) == 0 then 0 else if bit_and(k, 32) == 32 then 2 else 1

# A snapshot goes into every outbox that will take one without waiting. A
# client whose connection has backed up does not get to hold up the tick for
# everybody else — it misses this one and is told the next, which is the whole
# advantage of sending state rather than a list of changes.
fn broadcast(w, conns, line) = match conns
  Nil -> 0
  Cons(c, rest) -> broadcast_one(w, c, rest, line)

fn broadcast_one(w, c, rest, line) =
  offer(conn_out(c), line)
  broadcast(w, rest, line)

# The snapshot is built once per reader, because what is in it depends on where
# the reader is standing. `all` is everybody — the list being written about —
# and `to` is who is left to write it for.
fn tell_each(w, all, to) = match to
  Nil -> 0
  Cons(c, rest) -> tell_theirs(w, all, c, rest)

fn tell_theirs(w, all, c, rest) =
  offer(conn_out(c), snapshot(w, all, conn_block(c)))
  tell_each(w, all, rest)

fn offer(out, line) =
  sent = select
    send(out, line) -> 1
    default -> 0
  sent

# ---- the clock -------------------------------------------------------------
#
# The deadline is carried rather than recomputed, so the slack in the
# operating system's timers does not accumulate: a tick that woke up two
# milliseconds late is followed by one that sleeps two milliseconds less.

fn ticker(inbox, next) =
  now = now_nanos()
  sleep_ms(if next > now then (next - now) / 1000000 else 0)
  send(inbox, Tick)
  ticker(inbox, next + tick_ms() * 1000000)

# ---- who somebody is -------------------------------------------------------
#
# A name is worth nothing if the next person to walk in can wear it. Everybody
# gets a token the first time they arrive, their browser keeps it, and it comes
# back in the query the next time — so a name belongs to whoever first took it,
# and goes on belonging to them while they are away.
#
# It is not a password and it is not an account. It is not typed and it cannot
# be recovered; anybody who copies the string out of a browser is that player
# as far as this server is concerned. What it buys is exactly two things: a
# name that stays yours, and a way to say that one particular person is not
# welcome any more — neither of which is possible when everybody is anonymous
# and the only handle is an address that changes with the weather.

fn who_file() = "who.txt"

fn ban_file() = "banned.txt"

fn token_len() = 16

# Enough of a mix that two people arriving in the same millisecond do not get
# the same token, and enough that a third party cannot sit and guess them.
#
# The clock alone would not do the second part: a token minted at a known
# moment is a token somebody can search for. The other half comes from the
# client — a browser puts sixteen random bytes in `Sec-WebSocket-Key` for every
# connection it opens, and hashing the whole request takes that in along with
# everything else about it. Both halves are needed: the clock stops one client
# from getting the same token twice, the key stops anybody else from working
# out what it was.
fn mint(request) =
  hex_str(mix64(now_nanos() * 6364136223846793005 + hash_str(request)), token_len(), "")

fn mix64(x0) =
  a = bit_xor(x0, shr(x0, 33)) * 7109453100751455733
  b = bit_xor(a, shr(a, 29)) * 6329220948346402883
  bit_xor(b, shr(b, 32))

# The FNV basis, written as what it is in a signed sixty-four-bit world: the
# constant everyone quotes is above the top of an `Int` by a hair, and it is
# the same bits either way.
fn hash_str(s) = hash_from(s, 0, 0 - 3750763034362895579)

fn hash_from(s, i, h) =
  if i >= str_len(s) then h else hash_from(s, i + 1, bit_xor(h, str_get(s, i)) * 1099511628211)

fn hex_str(n, left, acc) =
  if left == 0 then acc else hex_str(shr(n, 4), left - 1, hex_digit(bit_and(n, 15)) + acc)

fn hex_digit(d) = str_sub("0123456789abcdef", d, 1)

# What the client sent back, if it sent anything: `who=` in the query, hex and
# nothing else, and exactly as long as one of ours. A token this cannot read is
# no token, and whoever sent it gets a new one rather than an argument.
fn token_at(request) =
  line = str_sub(request, 0, headline(request))
  at = str_find(line, "who=")
  if at < 0 then "" else hex_run(line, at + 4, "")

fn hex_run(line, i, acc) =
  if i >= str_len(line) || str_len(acc) >= token_len() then good_token(acc) else if is_hex(str_get(line, i)) then hex_run(line, i + 1, acc + str_sub(line, i, 1)) else good_token(acc)

fn good_token(acc) = if str_len(acc) == token_len() then acc else ""

fn is_hex(c) = c >= 48 && c <= 57 || c >= 97 && c <= 102

# ---- the two files ---------------------------------------------------------
#
# Read on the way in and written when a name is taken, rather than held in
# memory: at this size a few kilobytes is nothing next to a connection, and it
# means a ban takes hold on the next person to knock instead of on the next
# restart. It also means the names outlive the process, which is the point of
# having them at all.

fn banned(token) =
  if str_len(token) == 0 then 0 else has_line(read_file_raw(ban_file()), token)

fn has_line(text, want) = if str_find("\n" + text + "\n", "\n" + want + "\n") < 0 then 0 else 1

# The name this token has taken, or nothing. Lines are `<token> <name>`.
fn name_of(book, token) =
  if str_len(token) == 0 then "" else after_token(book, str_find("\n" + book, "\n" + token + " "))

fn after_token(book, at) =
  if at < 0 then "" else to_eol(book, at + token_len() + 1, "")

fn to_eol(book, i, acc) =
  if i >= str_len(book) then acc else if str_get(book, i) == 10 || str_get(book, i) == 13 then acc else to_eol(book, i + 1, acc + str_sub(book, i, 1))

# Who owns this name, if anybody. Reading it the other way round: the name is
# at the end of its line, so a line ends with a space and the name.
fn owner_of(book, name) = owner_at(book, str_find(book, " " + name + "\n"))

# The space is the one between the token and the name, so the token is the
# sixteen characters in front of it.
fn owner_at(book, at) =
  if at < token_len() then "" else str_sub(book, at - token_len(), token_len())

# Writing it back is a rewrite of the whole file, which at one line per player
# ever is cheap and is atomic in the only sense that matters here: the process
# that writes it is the only one that reads it.
fn remember(book, token, name) =
  write_file(who_file(), without_line(book, token) + token + " " + name + "\n")
  0

fn without_line(book, token) = strip_lines(split(book, "\n"), token, "")

fn strip_lines(lines, token, acc) = match lines
  Nil -> acc
  Cons(l, rest) -> strip_lines(rest, token, if keep_line(l, token) then acc + l + "\n" else acc)

fn keep_line(l, token) = str_len(l) > 0 && str_sub(l, 0, token_len()) != token

# ---- one connection --------------------------------------------------------

# The per-address gate is here rather than at `accept` because who somebody is
# is not known until the request has been read — see `whose`. The total gate is
# still taken at the door, so a flood of half-open handshakes cannot get past
# `max_connections()` however it dresses them up.
fn serve(conn, inbox, live) =
  request = fill_until(conn, "", 4, now_nanos() + handshake_ms() * 1000000)
  if said_the_word(request) == 0 then no_entry(conn, live) else past_the_word(conn, inbox, live, request)

# A ban is checked before the address gate and before the handshake, and it
# reads the list every time rather than at boot: a ban that needs a restart to
# take hold is a ban nobody applies while the valley has people in it.
fn past_the_word(conn, inbox, live, request) =
  if banned(token_at(request)) == 1 then no_entry(conn, live) else at_the_door(conn, inbox, live, request)

fn at_the_door(conn, inbox, live, request) =
  addr = whose(conn, request)
  if take_addr(live, addr) <= 0 then turn_away(conn, live, addr) else admitted(conn, inbox, live, addr, request)

# ---- the word at the door ---------------------------------------------------
#
# A shared word, in the query of the address the socket is opened to, checked
# before the handshake is answered and before anything is allocated for whoever
# is asking. It is a latch and not a lock: one word for everybody, sent in
# plain sight inside the TLS, and anybody who has it can pass it on. It keeps
# the valley to the people who were told about it, which is all it is for.
#
# The line it travels on is the request line, and nginx is asked not to log
# that for this location — a password in an access log outlives the password.
fn word() = "135"

# The gate is open for now: the word cost more friction than it bought while
# the valley is being built in the open — a blank or mistyped word dropped
# people silently into a single-player world, which read as every multiplayer
# feature being broken at once. The machinery stays; opening it is one line,
# and closing it again is deleting that line.
fn said_the_word(request) =
  if 1 == 1 then 1
  else said_the_word_really(request)

fn said_the_word_really(request) =
  line = str_sub(request, 0, headline(request))
  at = str_find(line, "p=" + word())
  if at < 0 then 0 else ends_there(line, at + 2 + str_len(word()))

# What follows the word has to be the end of it: a space, because the request
# line ends ` HTTP/1.1`, or an ampersand if something else follows in the
# query. Without this the word `135` also admits `1350`, and `1` would admit
# everything — the sort of hole nobody looks for until the word is short.
fn ends_there(line, i) =
  c = if i < str_len(line) then str_get(line, i) else 32
  v.yes(c == 32 || c == 38)

# Only the request line: a word further down would be a header, and a header is
# somebody else's to write.
fn headline(request) =
  i = str_find(request, "\r\n")
  if i < 0 then str_len(request) else i

fn no_entry(conn, live) =
  drop_slot(live)
  sock_close(conn)
  0

fn admitted(conn, inbox, live, addr, request) =
  if ws_accept(conn, request) then play(conn, inbox, known_or_new(request)) else sock_close(conn)
  drop_slot(live)
  drop_addr(live, addr)
  0

# Whoever they say they are, or a name for somebody nobody has met. Minting one
# for a token this server has never issued is deliberate: it costs nothing, it
# needs no table of what is outstanding, and a made-up token simply becomes
# theirs. Guessing somebody else's is the thing that matters, and that is what
# the sixteen random bytes in the handshake are for.
fn known_or_new(request) =
  said = token_at(request)
  if str_len(said) == token_len() then said else mint(request)

# ---- who is really on the other end ----------------------------------------
#
# Straight off the socket, unless the socket is the loopback — which on this
# machine means nginx, because nothing else can reach the port. A proxy makes
# every player look like 127.0.0.1, and a per-address limit that counts them
# all as one address stops the seventeenth person in the world rather than the
# seventeenth from one house. So behind it the address comes from the
# `X-Real-IP` header nginx sets.
#
# Only from the loopback, and that is the whole of the security in it: a header
# is something the client writes, and a client that could name its own address
# would walk round the limit by inventing a new one for every connection.
fn loopback() = 2130706433

fn whose(conn, request) =
  peer = sock_peer(conn)
  if peer == loopback() then behind_proxy(request, peer) else peer

fn behind_proxy(request, peer) =
  at = real_ip_at(request)
  if at < 0 then peer else ip_from(request, at, 0, 0)

fn real_ip_at(request) =
  a = str_find(request, "X-Real-IP: ")
  if a >= 0 then a + 11 else lower_real_ip_at(request)

# Header names are case-insensitive and this has no case-folding to hand, so
# the two spellings anything would actually send are both looked for.
fn lower_real_ip_at(request) =
  b = str_find(request, "x-real-ip: ")
  if b >= 0 then b + 11 else 0 - 1

# A dotted quad into the one integer `sock_peer` hands back, high octet first.
# Anything that is not a digit or a dot ends it, which includes the carriage
# return at the end of the header and the colon of an address that is not IPv4
# — and an address this cannot read becomes some number, which is fine: it is a
# key in a table of counts and not something anybody looks up.
fn ip_from(s, i, acc, part) =
  c = if i < str_len(s) then str_get(s, i) else 13
  if c >= 48 && c <= 57 then ip_from(s, i + 1, acc * 10 + (c - 48), part) else if c == 46 then ip_from(s, i + 1, 0, shl(part, 8) + acc) else shl(part, 8) + acc

fn play(conn, inbox, token) =
  # A hundred and twenty-eight, not four. `offer` drops a line when this is
  # full rather than stall the hub on a slow reader, which is right — but four
  # was sized for the steady state of one snapshot a tick, and a rocket into a
  # wall is not the steady state: one tick emits the snapshot, the rocket, the
  # crater and sixteen stones, and at four deep, twelve of those stones were
  # silently thrown away. The client never learned they had died, and a wall
  # that keeps stones the server has broken looks exactly like a wall that
  # cannot be broken.
  out = channel(128)
  send(inbox, Arrived(out, token))
  # The first thing in the outbox is the welcome, and it carries the id
  # everything else is in terms of.
  first = recv(out)
  ws_write_bin(conn, first)
  # By what it is, not by reading a number out of whatever turned up. The
  # refusal a full valley sends is words behind an `n`, and reading an id out
  # of words is how a client that had been turned away used to decide it was
  # player zero and start driving whoever that was.
  if str_len(first) >= 3 && str_get(first, 0) == op_hello() then both_ways(conn, inbox, out, u16_at(first, 1)) else sock_close(conn)

fn both_ways(conn, inbox, out, id) =
  spawn writer(conn, out)
  reader(conn, inbox, id, heard_per_second(), now_nanos() + 1000000000, "")
  # The socket first, so that anything the writer still has to send fails at
  # once instead of parking on a connection with nobody at the other end. Then
  # an empty line, which is the one thing that reaches a strand waiting on a
  # channel nothing will ever be sent to again — without it the writer sits
  # there for the life of the process.
  #
  # It cannot block: a full outbox is a writer with four lines to get through
  # and a socket that will refuse the first of them, so it is leaving anyway.
  sock_close(conn)
  select
    send(out, "") -> 1
    default -> 0
  send(inbox, Left(id))

fn writer(conn, out) =
  line = recv(out)
  if str_len(line) == 0 then 0 else keep_writing(conn, out, line)

fn keep_writing(conn, out, line) =
  if ws_write_bin(conn, line) < 0 then 0 else writer(conn, out)

# One frame is one message, so a read that comes back empty is the end of the
# connection and nothing else.
#
# `budget` is what is left of this second's allowance and `until` is when the
# second is up. Over the allowance the line is read and thrown away without
# being parsed, which is the point: the cost of a message is the parsing and
# the hub's attention, and neither is spent on the ten-thousandth one.
# `acc` is whatever arrived after the last frame. A read is not a frame: a
# client that sends two messages quickly puts both in one, and one message can
# arrive in two — so the leftovers are carried rather than thrown away, which
# is what keeps the rest of a connection from turning into noise the first time
# a message is split.
# The message and the leftovers travel through this loop as the tuple
# `ws_take` handed back, not as two arguments — and that is load-bearing, not
# style. Seven parameters is one more than x86-64 has integer argument
# registers, and a Rill function whose arguments would touch the stack is
# quietly given the C calling convention, under which a call in tail position
# is a hint rather than the promise. LLVM kept the hint for shapes it could
# turn into loops and dropped it here, where a channel send sits in the body:
# every message left two frames on the strand's stack, and after forty-odd
# thousand messages — half an hour of one person playing — the stack walked
# down into the heap and the next `malloc` anywhere killed the server. The
# core read `reader → gate_on → reader`, 87,385 frames deep.
#
# One tuple is one pointer, so at six parameters the whole chain is `tailcc`
# and every one of these calls is the jump it reads as. The tuple is the very
# one `ws_take` allocated — nothing extra is built per message.
fn reader(conn, inbox, id, budget, until, acc) =
  gate(conn, inbox, id, budget, until, ws_take(conn, acc))

fn gate(conn, inbox, id, budget, until, pair) =
  (msg, _) = pair
  if str_len(msg) == 0 then 0 else on_clock(conn, inbox, id, budget, until, pair)

fn on_clock(conn, inbox, id, budget, until, pair) =
  now = now_nanos()
  if now > until then gate_on(conn, inbox, id, heard_per_second(), now + 1000000000, pair) else gate_on(conn, inbox, id, budget, until, pair)

fn gate_on(conn, inbox, id, budget, until, pair) =
  (_, rest) = pair
  if budget <= 0 then hush(conn, inbox, id, until, rest) else handle_line(conn, inbox, id, budget, until, pair)

# Over the allowance, stop listening rather than listen and throw away.
#
# Reading is most of what a message costs. The frame walk and the unmask happen
# before anything can decide the line is unwanted, so a client sending a million
# lines a second was still being read a million times a second, and the tick
# starved behind it: an honest player in the same valley got no snapshots at all
# for as long as it went on. The budget was stopping the hub from being
# bothered and not the reader from working.
#
# So sleep out the rest of the second instead. The frames stay in the kernel
# buffer where they belong, the window fills, the sender's own writes start
# blocking, and this strand is off the run queue while it happens — which is
# what makes it free rather than merely cheaper.
fn hush(conn, inbox, id, until, rest) =
  left = (until - now_nanos()) / 1000000
  sleep_ms(if left < 1 then 1 else left)
  reader(conn, inbox, id, heard_per_second(), now_nanos() + 1000000000, rest)

fn handle_line(conn, inbox, id, budget, until, pair) =
  (msg, rest) = pair
  route(inbox, id, msg)
  reader(conn, inbox, id, budget - 1, until, rest)

# A message shorter than its own layout is dropped whole rather than read off
# the end of: `str_get` past the end is not a guard, the length is.
fn route(inbox, id, msg) =
  k = str_get(msg, 0)
  if k == op_input() && str_len(msg) >= 11 then moved(inbox, id, msg) else if k == op_fire() && str_len(msg) >= 13 then fired(inbox, id, msg) else if k == op_reload() then tell(inbox, Reloaded(id)) else if k == op_mine() then tell(inbox, Mined(id)) else if k == op_build() then tell(inbox, Built(id)) else if k == op_say() then tell(inbox, Said(id, rest_of(msg))) else if k == op_name() then tell(inbox, Named(id, rest_of(msg))) else if k == op_ping() then tell(inbox, Pinged(id, rest_of(msg))) else 0

fn moved(inbox, id, msg) =
  sc = alloc_bytes(8)
  m = Moved(id, u16_at(msg, 1), f32_at(msg, sc, 3), f32_at(msg, sc, 7))
  free_ptr(sc)
  tell(inbox, m)

fn fired(inbox, id, msg) =
  sc = alloc_bytes(8)
  m = Shot(id, f32_at(msg, sc, 1), f32_at(msg, sc, 5), f32_at(msg, sc, 9))
  free_ptr(sc)
  tell(inbox, m)

fn tell(inbox, m) =
  send(inbox, m)
  1

# ---- and the door ----------------------------------------------------------

# The count of open connections lives in memory the strands share, with the
# per-address rows after it: an address and a count, eight bytes each. One
# worker runs all of them and nothing here yields between a read and the write
# that follows it, so none of this needs to be atomic — which it could not be
# anyway. Build this `--parallel` and that stops being true.
#
# Row zero of the number space is the total, so the rows start at one.
fn total_at() = 0

fn row_addr(i) = 1 + i * 2

fn row_count(i) = 2 + i * 2

fn take_slot(live) =
  n = peek_i64(live, total_at())
  if n >= max_connections() then 0 else claim_slot(live, n)

fn claim_slot(live, n) =
  poke_i64(live, total_at(), n + 1)
  1

fn drop_slot(live) =
  poke_i64(live, total_at(), peek_i64(live, total_at()) - 1)
  1

# The row this address already has, or -1. A row with nobody on it is free
# whatever address it used to hold.
fn addr_row(live, addr, i) =
  if i == address_rows() then 0 - 1 else if peek_i64(live, row_count(i)) > 0 && peek_i64(live, row_addr(i)) == addr then i else addr_row(live, addr, i + 1)

fn free_row(live, i) =
  if i == address_rows() then 0 - 1 else if peek_i64(live, row_count(i)) == 0 then i else free_row(live, i + 1)

fn take_addr(live, addr) =
  r = addr_row(live, addr, 0)
  if r >= 0 then one_more(live, r) else first_from(live, addr)

fn one_more(live, r) =
  n = peek_i64(live, row_count(r))
  if n >= per_address() then 0 else count_up(live, r, n)

fn count_up(live, r, n) =
  poke_i64(live, row_count(r), n + 1)
  1

fn first_from(live, addr) =
  f = free_row(live, 0)
  if f < 0 then 0 else start_row(live, f, addr)

fn start_row(live, f, addr) =
  poke_i64(live, row_addr(f), addr)
  poke_i64(live, row_count(f), 1)
  1

fn drop_addr(live, addr) =
  r = addr_row(live, addr, 0)
  if r < 0 then 0 else count_down(live, r)

fn count_down(live, r) =
  poke_i64(live, row_count(r), peek_i64(live, row_count(r)) - 1)
  1

# Two gates, and the second one gives its place back if the first refuses.
fn accept_loop(server, inbox, live) =
  conn = tcp_accept(server)
  admit_conn(conn, inbox, live)
  accept_loop(server, inbox, live)

fn admit_conn(conn, inbox, live) =
  if take_slot(live) <= 0 then sock_close(conn) else spawn serve(conn, inbox, live)

fn turn_away(conn, live, addr) =
  drop_slot(live)
  println("too many connections from one address, refusing " + dotted(addr))
  sock_close(conn)
  0

fn dotted(a) =
  int_to_str(bit_and(shr(a, 24), 255)) + "." + int_to_str(bit_and(shr(a, 16), 255)) + "." + int_to_str(bit_and(shr(a, 8), 255)) + "." + int_to_str(bit_and(a, 255))

fn main() = match listen_on(port())
  Err(e) -> println(e)
  Ok(server) -> run(server)

fn run(server) =
  # The total, then two numbers per address row.
  live = alloc_bytes((1 + address_rows() * 2) * 8)

  for i in 0..1 + address_rows() * 2
    poke_i64(live, i, 0)

  w = v.init(64, n_pines(), n_crystals(), n_grass())
  v.set_meteors(w, meteors())
  v.set_match_len(w, match_secs(), report_secs())
  # A rebuilt valley is a new world block, and `reset_world` puts the pull
  # back to nought — which reads as the default. `again` sets it there too,
  # so a round change does not quietly return everybody to Earth-and-a-half.
  v.set_gravity(w, to_float(gravity_tenths()) / 10.0)
  println("settings: meteors=" + (if meteors() > 0 then "on" else "off") + " crystals=" + int_to_str(n_crystals()) + " pines=" + int_to_str(n_pines()) + " grass=" + int_to_str(n_grass()) + " match=" + int_to_str(match_secs()) + "s report=" + int_to_str(report_secs()) + "s gravity=" + int_to_str(gravity_tenths()) + "/10")
  println("the valley is up on " + int_to_str(port()) + ": " + int_to_str(v.crystal_count(w)) + " crystals, " + int_to_str(v.pine_count(w)) + " pines")
  # What this server has last told anybody about each ammunition box. Zeros,
  # which is where `v.init` put them.
  # One slot per box and one more for the tick counter `again` keeps.
  said = alloc_bytes((v.mag_count() + 1) * 8)

  for i in 0..v.mag_count() + 1
    poke_i64(said, i, 0)

  inbox = channel()
  spawn accept_loop(server, inbox, live)
  spawn ticker(inbox, now_nanos() + tick_ms() * 1000000)
  hub(w, Nil, inbox, 0, said)
