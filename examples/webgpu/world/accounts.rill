# Who somebody is, kept in the store the valleys already share.
#
# Four things live here: the rules a name has to keep, the record a password
# turns into, the token that stands in for having typed it, and the counter
# that hands out valley numbers. All of it in OxiMem, because a person who
# signs in should find their valleys whichever of the four doors they came
# through — an account kept in a file beside one server is an account that
# exists on one server.
#
# What is deliberately *not* here: any way to read a password back. The record
# is a salt and a derived key, and the only question it can answer is whether
# a given word makes the same key again.
# `oxiresp` comes in unqualified because it declares a type: a module that
# exports one cannot be given an alias here — the alias would make the type
# `kv.Resp`, which is a name the resolver has no rule for.
import "oxiresp"
import "passwd" as pw

# -- what the store is called -------------------------------------------------

fn user_key(who) = "user:" + who
fn sess_key(token) = "sess:" + token
fn mine_key(who) = "mine:" + who
fn vdef_key(id) = "vdef:" + int_to_str(id)
fn vnext_key() = "vnext"

# How long a signed-in browser stays signed in. Long, because the cost of
# being wrong is retyping a word, and short enough that a shared machine
# forgets eventually.
fn sess_secs() = 30 * 24 * 3600

# The stretching this side does. Small on purpose, and the reasoning is in
# `passwd.rill`: the browser has already run six hundred thousand rounds of
# PBKDF2-SHA-256 over the typed word before anything was sent, so what arrives
# is a high-entropy key rather than a guessable word. This is the second lock
# on a door whose first lock is the heavy one — and it is bounded by the fact
# that it runs on a thread that owes sixteen people a snapshot in fifty
# milliseconds. Two hundred rounds is about fourteen of those milliseconds.
#
# It is written into every record, so raising it later does not invalidate the
# accounts made before: a record says how many rounds made it.
fn rounds_now() = 200

# -- secrets ------------------------------------------------------------------

# `n` sixty-four-bit words from the operating system's pool, as hex. Not the
# clock and not a counter: this is what a session token and a salt are made of,
# and both are only worth anything if nobody can work out the next one.
fn secret_hex(n) = secret_from(n, "")

fn secret_from(n, acc) =
  if n <= 0 then acc else secret_from(n - 1, acc + hex64(random_i64(), 16, ""))

fn hex64(v, left, acc) =
  if left <= 0 then acc
  else hex64(shr(v, 4), left - 1, str_sub("0123456789abcdef", bit_and(v, 15), 1) + acc)

# -- the rules a name keeps ---------------------------------------------------

# Lower case, letters and digits and the hyphen, starting with a letter, three
# to twelve long. Narrow on purpose: this name goes in a URL, in a key in the
# store, and above somebody's head in the valley, and a name that needs
# escaping in any of those is a name that will one day not be escaped in one
# of them.
fn who_wrong(who) =
  n = str_len(who)
  if n < 3 then "a name is at least three letters"
  else if n > 12 then "a name is at most twelve letters"
  # The alphabet before the first letter, so that `Ada` is told what is
  # actually wrong with it. Asked the other way round it was told "a name
  # starts with a letter", which is both true of it and no help at all.
  else if name_clean(who, 0) == 0 then "a name is lower-case letters, digits and hyphens"
  else if letterish(str_get(who, 0)) == 0 then "a name starts with a letter"
  else ""

fn letterish(c) = if c >= 97 && c <= 122 then 1 else 0

fn name_clean(s, i) =
  if i >= str_len(s) then 1
  else
    c = str_get(s, i)
    ok = if letterish(c) == 1 then 1 else if c >= 48 && c <= 57 then 1 else if c == 45 then 1 else 0
    if ok == 0 then 0 else name_clean(s, i + 1)

# -- the record ---------------------------------------------------------------

# `salt:key:rounds:made`, four fields no field can contain: the first two are
# hex, the last two are digits.
fn record_of(key_hex, made) =
  salt = secret_hex(2)
  salt + ":" + pw.to_hex(pw.pbkdf2_sha1(pw.from_hex(key_hex), pw.from_hex(salt), rounds_now())) + ":" + int_to_str(rounds_now()) + ":" + int_to_str(made)

fn field(rec, n) = field_from(rec, n, 0, "")

fn field_from(rec, n, i, acc) =
  if i >= str_len(rec) then (if n == 0 then acc else "")
  else if str_get(rec, i) == 58 then (if n == 0 then acc else field_from(rec, n - 1, i + 1, ""))
  else field_from(rec, n, i + 1, acc + str_sub(rec, i, 1))

# Whether this key makes the record's key again. The comparison is the
# constant-time one: an early return here would leak how much of a guess was
# right, one byte at a time.
fn record_admits(rec, key_hex) =
  salt = field(rec, 0)
  want = field(rec, 1)
  turns = str_to_int(field(rec, 2))
  if str_len(salt) == 0 || str_len(want) == 0 || turns <= 0 then 0
  else pw.same_secret(want, pw.to_hex(pw.pbkdf2_sha1(pw.from_hex(key_hex), pw.from_hex(salt), turns)))

# -- making an account --------------------------------------------------------

# `SETNX`, so that two people registering the same name in the same instant
# cannot both be told yes. Checking and then writing would leave a window
# exactly wide enough for that, and a name is the one thing here that must be
# one person's.
fn acct_make(fd, who, key_hex, now) =
  bad = who_wrong(who)
  if str_len(bad) > 0 then bad
  else if str_len(key_hex) < 32 then "that word did not arrive"
  else match kv_command(fd, kv_args3("SETNX", user_key(who), record_of(key_hex, now)))
    Ok(v) -> if kv_int(v) == 1 then "" else "that name is taken"
    Err(e) -> "the store said: " + e

# Whether this is really them. A missing account and a wrong word answer the
# same way on purpose: telling them apart turns this into a way of asking
# which names exist.
fn acct_admits(fd, who, key_hex) =
  match kv_get(fd, user_key(who))
    Ok(v) -> record_admits(kv_text(v), key_hex)
    Err(_) -> 0

# -- being signed in ----------------------------------------------------------

# A token is a hundred and twenty-eight bits from the pool, and the store maps
# it to a name for a month. Nothing about the account is in the token itself,
# so one that leaks can be dropped without touching the account.
fn sess_open(fd, who) =
  token = secret_hex(2)
  match kv_setex(fd, sess_key(token), sess_secs(), who)
    Ok(_) -> token
    Err(_) -> ""

fn sess_whose(fd, token) =
  if str_len(token) != 32 then ""
  else match kv_get(fd, sess_key(token))
    Ok(v) -> kv_text(v)
    Err(_) -> ""

fn sess_close(fd, token) =
  if str_len(token) != 32 then 0
  else match kv_del(fd, sess_key(token))
    Ok(_) -> 1
    Err(_) -> 0
