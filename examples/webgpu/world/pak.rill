# The unpacker: the other half of pack.rill, and the half that ships.
#
# The page fetches valley.rpak once, copies it into a block this module
# handed out, and asks for the assets by index: where a name is, how big the
# raw bytes are, and finally `unpack`, which allocates the raw size and either
# copies the entry out (stored) or runs the LZ stream back into bytes. The
# format is described at the top of pack.rill; this file only reads it.
#
# Everything here is `for` loops over byte counts, not recursion: on the wasm
# target a tail call is a hint rather than a promise, and a three-megabyte
# file is three million tokens — a loop cannot overflow anything.

# The little-endian words of the header and the directory, read a byte at a
# time because nothing in the file is aligned to anything.
fn u32_at(p: Ptr, o: Int) -> Int =
  peek_u8(p, o) + shl(peek_u8(p, o + 1), 8) + shl(peek_u8(p, o + 2), 16) + shl(peek_u8(p, o + 3), 24)

# "RPAK", version 1.
fn ok(p: Ptr) -> Int =
  if peek_u8(p, 0) == 82 && peek_u8(p, 1) == 80 && peek_u8(p, 2) == 65 && peek_u8(p, 3) == 75 then
    if u32_at(p, 4) == 1 then 1 else 0
  else 0

fn count(p: Ptr) -> Int = u32_at(p, 8)

fn dir_bytes(p: Ptr) -> Int = u32_at(p, 12)

# The byte offset of entry `i`'s directory record: a walk, because the names
# make the records ragged. Sixty-nine entries deep at most.
fn entry_from(p: Ptr, i: Int, o: Int, k: Int) -> Int =
  if k == i then o else entry_from(p, i, o + 14 + peek_u8(p, o), k + 1)

fn entry(p: Ptr, i: Int) -> Int = entry_from(p, i, 16, 0)

fn name_len(p: Ptr, i: Int) -> Int = peek_u8(p, entry(p, i))

fn name_ptr(p: Ptr, i: Int) -> Ptr = ptr_offset(p, entry(p, i) + 1)

fn raw_size(p: Ptr, i: Int) -> Int =
  e = entry(p, i)
  u32_at(p, e + 2 + peek_u8(p, e))

fn data_at(p: Ptr, i: Int) -> Int =
  e = entry(p, i)
  16 + dir_bytes(p) + u32_at(p, e + 10 + peek_u8(p, e))

fn method(p: Ptr, i: Int) -> Int =
  e = entry(p, i)
  peek_u8(p, e + 1 + peek_u8(p, e))

# ---- unpacking --------------------------------------------------------------

# The whole entry, as fresh bytes the caller owns (and frees, over the ABI,
# with pak_free — the page copies them out and lets go at once).
fn unpack(p: Ptr, i: Int) -> Ptr =
  raw = raw_size(p, i)
  d = alloc_bytes(if raw > 0 then raw else 1)
  off = data_at(p, i)
  if method(p, i) == 0 then copy_stored(p, off, d, raw)
  else undo(p, off, d, raw)
  d

fn copy_stored(p, off, d, raw) =
  for j in 0..raw
    poke_i8(d, j, peek_u8(p, off + j))
  1

# The LZ stream back into bytes. One token per turn of the loop, cursors in a
# scratch block: i32 0 is the read position, 1 the write position, 2 the
# group's control byte, 3 which of its eight tokens is next. A token writes
# at least one byte, so the raw size bounds the token count and the loop can
# simply run that far — the turns after the last token see the output full
# and do nothing.
fn undo(p, off, d, raw) =
  st = alloc_bytes(16)
  poke_i32(st, 0, off)
  for t in 0..raw
    token(p, d, st, raw)
  free_ptr(st)
  1

fn token(p, d, st, raw) =
  if peek_i32(st, 1) >= raw then 0
  else
    if peek_i32(st, 3) == 0 then
      poke_i32(st, 2, peek_u8(p, peek_i32(st, 0)))
      poke_i32(st, 0, peek_i32(st, 0) + 1)
      1
    else 0
    take(p, d, st)

# The token itself: a clear bit is a literal byte, a set bit is a match —
# distance back, then length minus four. A match may overlap what it is
# still writing; copied forward a byte at a time, that is exactly what says
# a run.
fn take(p, d, st) =
  si = peek_i32(st, 0)
  di = peek_i32(st, 1)
  if bit_and(shr(peek_i32(st, 2), peek_i32(st, 3)), 1) == 0 then
    poke_i8(d, di, peek_u8(p, si))
    poke_i32(st, 0, si + 1)
    poke_i32(st, 1, di + 1)
  else
    dist = peek_u8(p, si) + shl(peek_u8(p, si + 1), 8)
    l = peek_u8(p, si + 2) + 4
    for j in 0..l
      poke_i8(d, di + j, peek_u8(d, di - dist + j))
    poke_i32(st, 0, si + 3)
    poke_i32(st, 1, di + l)
  poke_i32(st, 3, (peek_i32(st, 3) + 1) % 8)
  1
