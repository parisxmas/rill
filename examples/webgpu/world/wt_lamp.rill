# The six head lamps, now that gathering them is the engine's job.
#
# It was a filter, a sort and a loop in host.js, over the interpolated rows
# wire.rill builds — which meant that file's row layout was written down twice,
# once in Rill and once in JavaScript, and the second copy could only be
# checked by looking at a dark hillside in a browser.
#
# What is pinned: who gets a slot (lit, and alive), how many (six), in what
# order (nearest this eye first), and what a slot says (the lamp at head
# height, and the beam along their own yaw and pitch).
import "wire" as wr
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

fn absf(x) = v.absf(x)

# A player on the interpolated list: where they are, which way they are
# looking, whether they are alive and whether their torch is on. Straight into
# the rows rather than through a snapshot, because what is under test is the
# gathering and not the parsing — `wt_wire.rill` covers the parsing.
fn put_row(b, i, x, z, yaw, health, torch) =
  o = wr.interp_at() + i * 12
  poke_f32(b, o, to_float(i + 1))
  poke_f32(b, o + 1, x)
  poke_f32(b, o + 2, 10.0)
  poke_f32(b, o + 3, z)
  poke_f32(b, o + 4, yaw)
  poke_f32(b, o + 5, 0.0)
  poke_f32(b, o + 6, health)
  poke_f32(b, o + 7, 0.0)
  poke_f32(b, o + 8, to_float(torch))
  0

fn rows(b, n) = poke_f32(b, wr.h_interp_n(), to_float(n))

fn lamp_x(b, k) = peek_f32(b, wr.lamps_at() + k * 8)
fn lamp_y(b, k) = peek_f32(b, wr.lamps_at() + k * 8 + 1)
fn lamp_lit(b, k) = peek_f32(b, wr.lamps_at() + k * 8 + 3)
fn lamp_dx(b, k) = peek_f32(b, wr.lamps_at() + k * 8 + 4)
fn lamp_dz(b, k) = peek_f32(b, wr.lamps_at() + k * 8 + 6)

# The eye this is all measured from.
fn stand(s, x, z) =
  poke_f32(s, 16, x)
  poke_f32(s, 17, 11.75)
  poke_f32(s, 18, z)
  0

fn lit_slots(b, k, n) =
  if k >= 6 then n else lit_slots(b, k + 1, n + (if lamp_lit(b, k) > 0.5 then 1 else 0))

# Are the slots in order — each one further off than the one before it?
fn sorted(b, s, k, ok) =
  if k >= 6 || lamp_lit(b, k) < 0.5 then ok
  else if k == 0 then sorted(b, s, 1, ok)
  else sorted(b, s, k + 1,
              if absf(lamp_x(b, k) - peek_f32(s, 16)) >= absf(lamp_x(b, k - 1) - peek_f32(s, 16)) then ok else 0)

fn main() =
  w = v.init(32, 4, 4, 4)
  s = v.join(w)
  b = wr.make()

  println("the lamps")

  # ---- who gets one ---------------------------------------------------------
  #
  # Four people at four, eight, twelve and sixteen metres east. The near two
  # are not carrying a light and the far two are, so the slots have to skip
  # the two standing closest — a nearest-first rule that only ever took the
  # nearest bodies would look right in every test where everybody's torch is
  # on, and wrong the moment one is off.
  stand(s, 0.0, 0.0)
  put_row(b, 0, 4.0, 0.0, 0.0, 1.0, 0)
  put_row(b, 1, 8.0, 0.0, 0.0, 1.0, 0)
  put_row(b, 2, 12.0, 0.0, 0.0, 1.0, 1)
  put_row(b, 3, 16.0, 0.0, 0.0, 1.0, 1)
  rows(b, 4)
  say("lamps gathered", wr.wire_lamps(b, s), 2)
  say("and only the lit ones", lit_slots(b, 0, 0), 2)
  say("the nearest lit one leads, m", to_int(lamp_x(b, 0)), 12)
  say("then the far one", to_int(lamp_x(b, 1)), 16)

  # A body with no health in it is carrying nothing, whatever its flag says.
  put_row(b, 2, 12.0, 0.0, 0.0, 0.0, 1)
  rows(b, 4)
  say("the dead carry no light", wr.wire_lamps(b, s), 1)
  say("and the living one moves up, m", to_int(lamp_x(b, 0)), 16)

  # ---- nearest first, and only six -----------------------------------------
  #
  # Eight lit lamps, laid out furthest first so that a gather which simply
  # took them in the order they arrived would fail this. Two have to be cut,
  # and they have to be the two at the back.
  for i in 0..8
    put_row(b, i, to_float(80 - i * 10), 0.0, 0.0, 1.0, 1)
  rows(b, 8)
  say("eight lit, six slots", wr.wire_lamps(b, s), 6)
  say("the nearest leads, m", to_int(lamp_x(b, 0)), 10)
  say("the sixth is the sixth nearest, m", to_int(lamp_x(b, 5)), 60)
  say("in order all the way down", sorted(b, s, 0, 1), 1)

  # And it is measured from this eye, not from the origin: stand at the far
  # end and the list turns round.
  stand(s, 100.0, 0.0)
  say("still six from the other end", wr.wire_lamps(b, s), 6)
  say("nearest to the new eye leads, m", to_int(lamp_x(b, 0)), 80)
  say("in order from there too", sorted(b, s, 0, 1), 1)

  # ---- what a slot says ----------------------------------------------------
  #
  # The lamp is on somebody's head, not at their feet, and the beam is their
  # own look. Facing due south — yaw nought is -z — so the beam is -z and
  # nothing else.
  stand(s, 0.0, 0.0)
  put_row(b, 0, 3.0, 0.0, 0.0, 1.0, 1)
  rows(b, 1)
  wr.wire_lamps(b, s)
  say("the lamp is at head height, cm", cm(lamp_y(b, 0) - 10.0), 175)
  say("the beam runs along -z, hundredths", cm(lamp_dz(b, 0)) / 1, 0 - 100)
  say("and has nothing across it", cm(lamp_dx(b, 0)), 0)

  # Turned a quarter to the left, the beam is +x.
  put_row(b, 0, 3.0, 0.0, 1.57079633, 1.0, 1)
  rows(b, 1)
  wr.wire_lamps(b, s)
  say("a quarter turn puts it along +x, hundredths", cm(lamp_dx(b, 0)), 100)

  # ---- nobody home ---------------------------------------------------------
  rows(b, 0)
  say("an empty valley lights nothing", wr.wire_lamps(b, s), 0)
  say("and leaves no slot claiming to be lit", lit_slots(b, 0, 0), 0)
  println("done")
