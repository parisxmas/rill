# Stand against a crystal for nine seconds and it bites three times, a tenth
# each, down its own ring — and a browser that was only told about the bite
# ends with the same ring.
import "valley" as v

fn crystal_spot(w) =
  cb = peek_ptr(w, 66)
  (peek_f32(cb, 0), peek_f32(cb, 1), peek_f32(cb, 2))

fn run_ticks(w, n) =
  if n == 0 then 0 else run_tick(w, n)

fn run_tick(w, n) =
  v.step_world(w, 0.05)
  run_ticks(w, n - 1)

fn main() =
  w = v.init(48, 400, 300, 900)
  s = v.join(w)
  (cx, cy, cz) = crystal_spot(w)
  poke_f32(s, 21, cx + 1.0)
  poke_f32(s, 22, cy + 1.6)
  poke_f32(s, 23, cz)
  h0 = v.health(s)
  run_ticks(w, 20)
  println("after 1s at the glass: health " + float_to_str(v.health(s)) + " (want 0.9), zaps " + int_to_str(v.zaps(w)))
  run_ticks(w, 130)
  println("after 7.5s: health " + float_to_str(v.health(s)) + " (want 0.7), zaps " + int_to_str(v.zaps(w)) + ", who " + int_to_str(v.zap_who(w, 0)) + " by crystal " + int_to_str(v.zap_which(w, 0)))
  w2 = v.init(48, 400, 300, 900)
  v.put_zap(w2, v.zap_who(w, 0), v.zap_which(w, 0))
  println("replayed: zaps " + int_to_str(v.zaps(w2)) + ", which " + int_to_str(v.zap_which(w2, 0)))
