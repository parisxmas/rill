# A native run for the HUD's layout arithmetic: no GPU, no page — fake
# metrics, a few pushed strings, and the display list the engine emits from
# them. What is asserted is the part a screenshot cannot pin down: counts,
# widths, wrapping, and that the theme knobs actually steer the output.
import "hud" as hud

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

# A pretend atlas: every strip advances 7 px with 3 px of pad, cells 12 tall.
fn fake_metrics(h) =
  for s in 0..hud.strips()
    fake_strip(h, s)

fn fake_strip(h, s) =
  for c in 0..99
    fake_cell(h, s, c)
  at = hud.met_at() + (s * 100 + 99) * 4
  poke_f32(h, at, 7.0)
  poke_f32(h, at + 1, 3.0)

fn fake_cell(h, s, c) =
  at = hud.met_at() + (s * 100 + c) * 4
  poke_f32(h, at, to_float(c))
  poke_f32(h, at + 1, to_float(s))
  poke_f32(h, at + 2, 13.0)
  poke_f32(h, at + 3, 12.0)

# Bytes into a slot, from a string, with meta.
fn push(h, slot, s, m1, m2, m3) =
  at = hud.slot_at(slot)

  for i in 0..str_len(s)
    poke_u8_at(h, at + i, str_get(s, i))

  m = hud.slot_meta(slot)
  poke_f32(h, m, to_float(str_len(s)))
  poke_f32(h, m + 1, m1)
  poke_f32(h, m + 2, m2)
  poke_f32(h, m + 3, m3)

fn poke_u8_at(h, i, v) = poke_i8(h, i, v)

fn main() =
  h = hud.make()
  fake_metrics(h)
  poke_f32(h, hud.h_sw(), 1200.0)
  poke_f32(h, hud.h_sh(), 800.0)
  poke_f32(h, hud.h_dpr(), 2.0)
  poke_f32(h, hud.h_now(), 100.0)
  poke_f32(h, hud.h_health(), 0.8)
  poke_f32(h, hud.h_breath(), 0.5)
  poke_f32(h, hud.h_mag_cap(), 10.0)
  poke_f32(h, hud.h_rounds(), 6.0)
  poke_f32(h, hud.h_left(), 125.0)
  poke_f32(h, hud.h_tally_all(), 300.0)
  poke_f32(h, hud.h_tally_stand(), 299.0)
  poke_f32(h, hud.h_tally_broke(), 1.0)
  poke_f32(h, hud.h_cross(), 1.0)

  n0 = hud.build(h)
  println("a bare frame emits " + int_to_str(n0) + " instances")
  say("more than the furniture alone", if n0 > 120 then 1 else 0, 1)

  # Text measure: "abc" is three cells of 7px advance.
  say("three characters at zero tracking, in px", to_int(hud.str_w(h, hud.st_12(), 0.0, "abc")), 21)
  # The middle dot is one visible cell, whatever its byte count.
  say("'a · b' counts five cells", to_int(hud.str_w(h, hud.st_12(), 0.0, "a · b") / 7.0), 5)

  # A pushed log line appears, and a said line wraps at the panel.
  push(h, hud.sl_log0(), "a plain line", 0.0, 99.5, 0.0)
  n1 = hud.build(h)
  say("a log line adds its glyphs", if n1 > n0 + 8 then 1 else 0, 1)
  # 60 visible cells at ~7.7px a cell in a 320px panel is two rows.
  push(h, hud.sl_log0() + 1, "0123456789012345678901234567890123456789012345678901234567890", 1.0, 99.5, 0.0)
  say("sixty-one said cells make rows", hud.slot_rows(h, hud.sl_log0() + 1), 2)

  # The clock knows its arithmetic.
  say("125 seconds reads 2:05, width 4 cells + tracking", to_int(hud.str_w(h, hud.st_20(), 0.0, "2:05") / 7.0), 4)

  # Aim brings the vignette and the reticle with it, on the rifle only.
  poke_f32(h, hud.h_aim(), 1.0)
  poke_f32(h, hud.h_weapon(), 0.0)
  na = hud.build(h)
  poke_f32(h, hud.h_weapon(), 2.0)
  nb = hud.build(h)
  say("the scope belongs to the rifle alone", if na > nb then 1 else 0, 1)
  poke_f32(h, hud.h_aim(), 0.0)

  # The board takes over from the clock at the flip, with pushed rows.
  push(h, hud.sl_board0(), "Avci", 3.0, 1.0, 1.0)
  poke_f32(h, hud.h_board_n(), 1.0)
  poke_f32(h, hud.h_phase(), 1.0)
  poke_f32(h, hud.h_board_left(), 12.0)
  nboard = hud.build(h)
  say("the board emits", if nboard > 40 then 1 else 0, 1)
  poke_f32(h, hud.h_phase(), 0.0)

  # A theme knob steers the output: margin pushed right moves the title.
  x0 = peek_f32(h, hud.inst_at() + to_int(peek_f32(h, hud.h_count())) * 0)
  hud.build(h)
  first_x = title_x(h)
  poke_f32(h, hud.t_at(hud.s_margin()), 60.0)
  hud.build(h)
  say("the margin knob moves the title, px", to_int(title_x(h) - first_x), 40)

  println("done")

# The first glyph the build emits is the title's first letter; its x is the
# margin minus the pad.
fn title_x(h) =
  find_glyph(h, 0)

fn find_glyph(h, i) =
  if i >= to_int(peek_f32(h, hud.h_count())) then 0.0 - 1.0
  else if peek_f32(h, hud.inst_at() + i * 16 + 12) > 0.5 && peek_f32(h, hud.inst_at() + i * 16 + 12) < 1.5 then peek_f32(h, hud.inst_at() + i * 16)
  else find_glyph(h, i + 1)
