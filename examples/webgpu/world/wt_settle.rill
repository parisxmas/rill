# A wt-style native run for the walls: blast the foot of one column and check
# that nothing above the hole moved.
#
# This checked the opposite rule until the hole was made to stay a hole. The
# column used to pack down after every break, so a rocket into the foot of a
# wall took the top of it four courses nearer the ground — see the note above
# `note_mark`'s neighbours in valley.rill. Now a stone that was not hit is
# where it was laid, to the float, and that is what is asserted: every survivor
# still stands at the course its own index says, whatever went from under it.
import "valley" as v

extern fn sqrt(x: Float) -> Float

fn tall() = 8

# The first column of the first wall that was actually laid.
fn first_base(w) = 0

fn col_x(bb) = peek_f32(bb, 0)

fn col_z(bb) = peek_f32(bb, 2)

fn standing(w, i) = if v.block_broken(w, i) > 0 then 0 else 1

fn count_standing(w, c) = count_up(w, c, 0, 0)

fn count_up(w, c, k, n) = if k >= tall() then n else count_up(w, c, k + 1, n + standing(w, c + k))

# The offence now: a standing stone that is anywhere but the course it was laid
# at. It does not matter what is under it — a stone with nothing below it is a
# wall carrying across a hole, which is the whole point.
fn movers(w, bb, c) = move_up(w, bb, c, 0, 0)

fn move_up(w, bb, c, k, n) =
  if k >= tall() then n else move_up(w, bb, c, k + 1, n + moved(w, bb, c, k))

# A slot the arm never filled has size nought: not a stone, and nobody's to
# move. Broken stones are rubble and lie where `fall_to_ground` put them.
fn moved(w, bb, c, k) =
  if v.block_broken(w, c + k) > 0 then 0 else if peek_f32(bb, (c + k) * 8 + 3) < 0.01 then 0 else moved_where(w, bb, c + k, k)

fn moved_where(w, bb, i, k) =
  x = peek_f32(bb, i * 8)
  z = peek_f32(bb, i * 8 + 2)
  y = peek_f32(bb, i * 8 + 1)
  want = v.height(x, z) + 0.3 * (0.5 + to_float(k))
  if y - want > 0.01 || want - y > 0.01 then 1 else 0

# Every column of the whole valley, not just the one that was shot at: a
# blast reaches sideways into the neighbours too.
fn all_movers(w, bb) = wm_up(w, bb, 0, 0)

fn wm_up(w, bb, c, n) =
  if c >= v.block_count(w) then n else wm_up(w, bb, c + tall(), n + movers(w, bb, c))

# The survivors must stand in the same place in both valleys, to the float.
fn same_wall(w, bb, bb2, c) = same_up(w, bb, bb2, c, 0)

fn same_up(w, bb, bb2, c, k) =
  if k >= tall() then 1 else if same_one(w, bb, bb2, c + k) > 0 then same_up(w, bb, bb2, c, k + 1) else 0

fn same_one(w, bb, bb2, i) =
  if v.block_broken(w, i) > 0 then 1 else if peek_f32(bb, i * 8 + 1) == peek_f32(bb2, i * 8 + 1) then 1 else 0

# What is left over the hole: standing stones with a broken one directly under
# them. Zero of these would mean the blast never cut into the middle of a
# column and the test proved nothing.
fn hanging(w, c) = hang_up(w, c, 1, 0)

fn hang_up(w, c, k, n) =
  if k >= tall() then n else hang_up(w, c, k + 1, n + hangs(w, c, k))

fn hangs(w, c, k) =
  if v.block_broken(w, c + k) > 0 then 0 else if v.block_broken(w, c + k - 1) > 0 then 1 else 0

fn main() =
  w = v.init(48, 400, 300, 900)
  bb = v.blocks_ptr(w)
  n = v.block_count(w)
  println("blocks laid: " + int_to_str(n))
  c = first_base(w)
  x = col_x(bb)
  z = col_z(bb)
  g = v.height(x, z)
  println("column stands " + int_to_str(count_standing(w, c)) + " tall, stones out of place in the valley: " + int_to_str(all_movers(w, bb)))

  # A warhead against the foot of the column. Negative seed is what a rocket
  # sends; a positive one is a meteor and leaves the stone alone.
  v.break_blocks(w, x, g + 0.3, z, 0.0 - 1.0)
  println("after the blast it stands " + int_to_str(count_standing(w, c)) + ", out of place: " + int_to_str(all_movers(w, bb)) + " (want 0)")
  println("  standing over a hole: " + int_to_str(hanging(w, c)) + " (want more than 0)")

  # The late joiner's path, taken at half time: a fresh valley told only which
  # stones went must end with the same wall — same survivors, same heights.
  w2 = v.init(48, 400, 300, 900)
  replay(w, w2, 0)
  bb2 = v.blocks_ptr(w2)
  println("replayed valley stands " + int_to_str(count_standing(w2, c)) + ", out of place: " + int_to_str(all_movers(w2, bb2)) + ", same wall: " + int_to_str(same_wall(w, bb, bb2, c)))

  # And again, higher, into what is left standing over the hole.
  v.break_blocks(w, x, g + 1.5, z, 0.0 - 2.0)
  println("after the second it stands " + int_to_str(count_standing(w, c)) + ", out of place: " + int_to_str(all_movers(w, bb)) + " (want 0)")
  println("done")

fn replay(w, w2, k) =
  if k >= v.blocks_gone(w) then 0 else replay_one(w, w2, k)

fn replay_one(w, w2, k) =
  v.drop_block(w2, v.block_which(w, k))
  replay(w, w2, k + 1)
