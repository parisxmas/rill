# The ones nobody is driving.
#
# A bot is a player — the same block, the same table, the same rules — and
# almost everything this file could assert is therefore already asserted
# somewhere else: that a round hits it, that a blast pushes it, that it goes
# down and gets up. What is its own is the handful of decisions it makes for
# itself, and the two promises that were asked for by name: it shoots people,
# and it does not shoot the planet it is keeping.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

fn absf(x) = if x < 0.0 then 0.0 - x else x

# The server's own tick order: decide, then walk by what was decided.
fn walk_them(w, s, n) =
  if n == 0 then 1
  else
    v.bot_think(w, s, 1.0 / 20.0)
    v.walk(s, 1.0 / 20.0, 0.0, 0.0, to_int(peek_f32(s, 30)))
    walk_them(w, s, n - 1)

fn think(w, s, n) =
  if n == 0 then 1
  else
    v.bot_think(w, s, 1.0 / 20.0)
    think(w, s, n - 1)

# Where a bot is looking, as a direction.
fn look_x(s) = sin(peek_f32(s, 19)) * cos(peek_f32(s, 20))

fn look_z(s) = (0.0 - cos(peek_f32(s, 19))) * cos(peek_f32(s, 20))

extern fn sin(x: Float) -> Float
extern fn cos(x: Float) -> Float
extern fn sqrt(x: Float) -> Float

fn main() =
  w = v.init(48, 40, 200, 40)
  me = v.join(w)
  b = v.join(w)
  v.make_bot(b, 0.6)

  println("what it is")
  say("a person is not a bot", v.is_bot(me), 0)
  say("and a bot is", v.is_bot(b), 1)
  say("carrying the skill it was given, in per cent", to_int(v.bot_skill(b) * 100.0 + 0.5), 60)
  # And nothing has shot it. A world's clock starts at nought and so does an
  # unwritten slot, so a fresh guardian read as "hit a moment ago by whoever
  # has id nought" — a real person — and spent its first eight seconds running
  # for cover from a man who had not fired. It cost three other stages of this
  # file, which is how it was found.
  say("and nothing has shot it yet", if is_null(v.struck_by(w, b)) then 1 else 0, 1)

  println("it keeps a place")
  # A guardian starts on the wall it is keeping, and stays there. Left to walk
  # to it from wherever a spawn put it, it does not arrive: measured, they
  # began seventy-seven and a hundred and three metres out and were still
  # forty-four and sixty-seven away half a minute later.
  wb = v.wall_box(w)
  pk = v.bot_post(w, b)
  (sx, sz) = v.post_spot(w, pk, peek_f32(b, 99), 0)
  gap = sqrt((sx - v.player_x(b)) * (sx - v.player_x(b))
           + (sz - v.player_z(b)) * (sz - v.player_z(b)))
  # Within the distance it calls "at my post", or it will spend the round
  # walking to a place it is already standing at — which is what four
  # centimetres too far cost the first draft of this.
  say("it is standing on its post", if gap < v.bot_at_cover() then 1 else 0, 1)
  # And the post is beside the wall, not in it. The sphere `wall_box` holds is
  # the whole L and its centre is the corner, where the stones are: a guardian
  # sent there walks into the wall, is pushed out, walks back in and wedges.
  # A name and a health bar floating against stone with no figure under them
  # and nothing to shoot at is what that looked like.
  say("and clear of the stone", if v.clear_of_wall(w, pk, sx, sz) then 1 else 0, 1)
  # And then it walks a beat around it. A guardian that reaches its post and
  # kneels there for the rest of the round is a statue: what was asked for is
  # something keeping a place, and keeping a place is walking round it.
  #
  # Ninety seconds of it, with the world's clock wound on by hand — the
  # station is drawn from that clock and `walk` does not touch it, so a test
  # that only ticks the legs watches a guardian walk to one spot and stop. The
  # clock is put back afterwards, because the stages below were written
  # against the one it had.
  t0 = peek_f32(w, 28)
  rr = peek_f32(wb, pk * 4 + 3) * 0.5 + v.bot_round()
  (path, worst, inside, still) = walk_beat(w, b, pk, sx, sz, 1800, 1.0 / 20.0, 0.0, 0.0, 0, 0)
  poke_f32(w, 28, t0)
  # Sixty-nine metres in a minute and a half, measured: seven or so to each
  # station and the rest of the beat spent standing at it.
  say("it walks its beat", if path > 20.0 then 1 else 0, 1)
  # But only round the thing it is keeping. A guardian that wanders off is one
  # more bot roaming the valley, which is the behaviour this whole design
  # exists to be the opposite of.
  say("and never leaves the ground it keeps",
      if worst < rr + 4.0 then 1 else 0, 1)
  # And never inside it. A guardian wedged in the stone is pushed out by
  # `collide_walls` every tick and walks back in every tick, and what that
  # looks like from outside is a name and a health bar against a wall with no
  # figure under them and nothing you can shoot. Asked every tick of the walk,
  # because a beat takes it round places a single reading would never visit.
  say("and is never inside the stone it keeps", inside, 0)
  # It walks and it stops. Both halves: a beat with no pauses in it is a
  # patrol nobody could ever catch standing, and one with no walking is the
  # statue again.
  say("and stands its watch as well as walking it", if still > 0 then 1 else 0, 1)
  # Somebody the far side of the valley is not its business. This is the whole
  # of "they should not hunt you across the map": three guardians converging
  # on the one person in it from seventy metres took a motionless man down in
  # eight and a half seconds.
  poke_f32(me, 16, sx + 60.0)
  poke_f32(me, 18, sz)
  poke_f32(b, 31, 0.0)
  poke_f32(b, 127, 0.0)
  think(w, b, 20)
  say("somebody far from it is not its business", to_int(peek_f32(b, 31)), 0)
  say("never crouched while walking",
      if bit_and(to_int(peek_f32(b, 30)), 15) != 0 && bit_and(to_int(peek_f32(b, 30)), 64) == 64
      then 0 else 1, 1)

  println("it moves")
  # Put them far apart, so the bot has to come. Standing still for a second
  # of ticks is the failure this catches: a bot that thinks but never walks.
  v.set_at(me, 40.0, v.ground(40.0, 40.0) + 0.1, 40.0)
  poke_f32(me, 16, 40.0)
  poke_f32(me, 17, v.ground(40.0, 40.0) + 1.75)
  poke_f32(me, 18, 40.0)
  v.set_at(b, 0.0, v.ground(0.0, 0.0) + 0.1, 0.0)
  poke_f32(b, 16, 0.0)
  poke_f32(b, 17, v.ground(0.0, 0.0) + 1.75)
  poke_f32(b, 18, 0.0)
  # Thinking is not moving. A bot decides what a browser would have sent —
  # where it is looking and which keys are down — and then `walk_all` walks it
  # with everybody else, through the one path that knows about slopes,
  # collisions and breath. So what is checked here is both halves: that it
  # asks to go forward, and that asking carries it.
  x0 = v.player_x(b)
  z0 = v.player_z(b)
  think(w, b, 1)
  say("it asks to walk forward", bit_and(to_int(peek_f32(b, 30)), 1), 1)
  say("and not by moving itself", cm(v.player_x(b) - x0), 0)
  walk_them(w, b, 40)
  moved = sqrt((v.player_x(b) - x0) * (v.player_x(b) - x0) + (v.player_z(b) - z0) * (v.player_z(b) - z0))
  say("two seconds of it carries it somewhere", if moved > 1.0 then 1 else 0, 1)

  println("it looks at people")
  # From a standing start facing nowhere in particular, it should come round
  # to face the one person in the valley. Not exactly — it is allowed to miss
  # — but within a quarter turn.
  # Inside the place it is keeping, which is the only place it looks at
  # anybody: see `bot_wake`.
  poke_f32(me, 16, sx + 14.0)
  poke_f32(me, 18, sz + 14.0)
  poke_f32(me, 17, v.ground(peek_f32(me, 16), peek_f32(me, 18)) + 1.75)
  poke_f32(b, 19, 3.0)
  think(w, b, 30)
  dx = peek_f32(me, 16) - peek_f32(b, 16)
  dz = peek_f32(me, 18) - peek_f32(b, 18)
  d = sqrt(dx * dx + dz * dz)
  dot = (look_x(b) * dx + look_z(b) * dz) / d
  say("and comes round to face them", if dot > 0.7 then 1 else 0, 1)

  println("it shoots them")
  # Close enough to be worth shooting at. What is asserted is the ask, not the
  # round: the ask is the bot's decision and the round is the world's answer
  # to it, and the world's answer is `wt_rate`'s business.
  poke_f32(b, 16, peek_f32(me, 16) - 12.0)
  poke_f32(b, 18, peek_f32(me, 18))
  poke_f32(b, 17, peek_f32(me, 17))
  v.set_at(b, peek_f32(me, 16) - 12.0, peek_f32(me, 22), peek_f32(me, 18))
  poke_f32(b, 16, peek_f32(me, 16) - 12.0)
  poke_f32(b, 17, peek_f32(me, 17))
  poke_f32(b, 18, peek_f32(me, 18))
  poke_f32(b, 31, 0.0)
  poke_f32(b, 127, 0.0)
  think(w, b, 30)
  say("it pulls the trigger", if peek_f32(b, 31) > 0.5 then 1 else 0, 1)

  println("it does not shoot the planet")
  # The promise this file exists for. A guardian's round passes through the
  # crystals; anybody else's breaks them.
  broke0 = v.breaks(me)
  fire_across(w, b, 1)
  say("a guardian's round leaves the crystals standing", v.breaks(me) - broke0, 0)
  broke1 = v.breaks(me)
  fire_across(w, me, 0)
  say("and a person's does not", if v.breaks(me) - broke1 > 0 then 1 else 0, 1)

  println("and it does not jump")
  # A guardian keeps a post and crosses ground at half your pace; a thing that
  # bunny-hops across one reads as a game character rather than as something
  # standing watch. The hop was drawn from the same clock the strafe and the
  # sprint are, and fired about one window in sixteen, so the sweep is over
  # ten minutes of that clock and all three distance bands — without the fix
  # it lands about forty times, which is teeth enough.
  say("no jump at any range, over ten minutes of the clock",
      hopped(w, b, 0, 0), 0)

  println("a tenth of you wherever it lands")
  # The head-body-legs table is a thing between people: it pays for an aim
  # somebody chose. A guardian points at the middle of you with an error drawn
  # from its skill and the range, so which sphere the round passes through is
  # the dice — and a guardian that killed outright on a dice roll is a coin,
  # not a difficulty. Ten rounds on target, however they land.
  say("a guardian's round to the head takes, in per cent", took(w, b, me, 1.62), 10)
  say("to the chest, the same", took(w, b, me, 1.05), 10)
  say("to the legs, the same", took(w, b, me, 0.45), 10)
  # And nothing of the table between people has moved: a head shot is still
  # the whole of somebody and a leg is still a tenth. This half is what an
  # edit meant for the guardians will break by accident.
  say("a person's to the head still takes all of them", took(w, me, b, 1.62), 100)
  say("to the chest, thirty", took(w, me, b, 1.05), 30)
  say("to the legs, ten", took(w, me, b, 0.45), 10)

  println("and the planet does not bite it")
  # The other side of the same bargain. A guardian is posted and then stands
  # still for minutes, and the glass bites whatever leans on it every three
  # seconds — so a post that landed beside a crystal killed its guardian on a
  # loop, and every bite was broadcast as a bolt the whole valley drew. What
  # that looked like from inside was crystals firing at people from across the
  # map. The reach itself is right: measured, nothing is bitten past two and a
  # half metres.
  cb2 = peek_ptr(w, 66)
  ci = live_crystal(cb2, 0, to_int(peek_f32(w, 58)))
  gx = peek_f32(cb2, ci * 8)
  gz = peek_f32(cb2, ci * 8 + 2)
  stand_at(b, gx, peek_f32(cb2, ci * 8 + 1), gz)
  stand_at(me, gx, peek_f32(cb2, ci * 8 + 1), gz)
  poke_f32(b, 82, 1.0)
  poke_f32(me, 82, 1.0)
  poke_f32(b, 105, 0.0 - 100.0)
  poke_f32(me, 105, 0.0 - 100.0)
  v.step_zaps(w)
  say("a guardian leaning on the glass is left alone", cm(1.0 - v.health(b)), 0)
  # And it is still a wager for everybody else, or the stage above passes on a
  # valley whose crystals have simply stopped biting.
  say("and a person in the same spot is not",
      if v.health(me) < 0.999 then 1 else 0, 1)

  println("shot at from further than it can answer, it gets out of the open")
  # A round out of nowhere used to mean nothing at all: a guardian's world was
  # whoever had walked into the ground it keeps, so a man sixty metres off
  # with a rifle was not in it, and it walked its beat and was shot off it one
  # round at a time without ever turning round.
  stand_at(b, sx, v.ground(sx, sz), sz)
  stand_at(me, sx + 60.0, v.ground(sx + 60.0, sz), sz)
  poke_f32(me, 82, 1.0)
  # Stamped with somebody who does not exist first: the man's own id here is
  # nought, and an assertion that nought came back would pass just as happily
  # on a slot nothing had ever written.
  poke_f32(b, 128, 77.0)
  fire_at(w, me, b)
  poke_f32(b, 31, 0.0)
  poke_f32(b, 127, 0.0)
  say("it knows who hit it", to_int(peek_f32(b, 128)), to_int(peek_f32(me, 99)))
  # The cover is chosen once, at the moment the round lands, and then run to.
  # Recomputing "the nearest thing to get behind" every tick looked right and
  # does not work — it is measured from where the guardian is standing, so it
  # moves as it runs: measured, three different walls in six seconds and it
  # arrived at none of them, which is twenty-three metres of running that ends
  # in the open.
  hx = peek_f32(b, 130)
  hz = peek_f32(b, 131)
  g0 = sqrt((hx - v.player_x(b)) * (hx - v.player_x(b))
          + (hz - v.player_z(b)) * (hz - v.player_z(b)))
  say("and it has picked somewhere to be instead", if g0 > 1.0 then 1 else 0, 1)
  d0 = apart(b, me)
  walk_them(w, b, 120)
  g1 = sqrt((hx - v.player_x(b)) * (hx - v.player_x(b))
          + (hz - v.player_z(b)) * (hz - v.player_z(b)))
  say("and it gets there", if g1 < v.bot_at_cover() then 1 else 0, 1)
  say("without walking towards the man", if apart(b, me) > d0 - 1.0 then 1 else 0, 1)
  say("and does not fire at one it cannot reach", to_int(peek_f32(b, 31)), 0)
  # But it is watching where the round came from, not the wall.
  dx2 = peek_f32(me, 16) - peek_f32(b, 16)
  dz2 = peek_f32(me, 18) - peek_f32(b, 18)
  d2 = sqrt(dx2 * dx2 + dz2 * dz2)
  say("while looking his way",
      if (look_x(b) * dx2 + look_z(b) * dz2) / d2 > 0.7 then 1 else 0, 1)

  println("and from close, it shoots back")
  # The other half, and the one an edit meant for the running away will break:
  # a guardian that hides from everything is as useless as one that hides from
  # nothing. Turned away from him first, so what is asserted is that being hit
  # brought it round.
  stand_at(b, sx, v.ground(sx, sz), sz)
  stand_at(me, sx + 18.0, v.ground(sx + 18.0, sz), sz)
  poke_f32(b, 19, 3.0)
  fire_at(w, me, b)
  poke_f32(b, 31, 0.0)
  poke_f32(b, 127, 0.0)
  think(w, b, 60)
  say("it answers", if peek_f32(b, 31) > 0.5 then 1 else 0, 1)

  println("it leaves its own kind alone")
  c = v.join(w)
  v.make_bot(c, 0.6)
  # The other bot is put right beside it and the person is taken far away, so
  # the only thing within reach is one of its own.
  v.set_at(c, peek_f32(b, 16) + 3.0, peek_f32(b, 22), peek_f32(b, 18))
  poke_f32(c, 16, peek_f32(b, 16) + 3.0)
  poke_f32(c, 17, peek_f32(b, 17))
  poke_f32(c, 18, peek_f32(b, 18))
  poke_f32(me, 82, 0.0)
  poke_f32(b, 31, 0.0)
  poke_f32(b, 127, 0.0)
  think(w, b, 30)
  say("with nobody but another guardian about, it holds its fire",
      to_int(peek_f32(b, 31)), 0)
  println("done")

# Sweep a round through the crystal field from `s`, whoever `s` is, and let
# the world decide what it hit.
fn fire_across(w, s, decide) =
  bb = peek_ptr(w, 68)

  for i in 0..v.bullet_cap()
    poke_f32(bb, i * v.bullet_stride() + 7, 0.0)

  cb = peek_ptr(w, 66)
  # The first crystal still standing, and a round put right through it.
  i = live_crystal(cb, 0, to_int(peek_f32(w, 58)))
  cx = peek_f32(cb, i * 8)
  cy = peek_f32(cb, i * 8 + 1)
  cz = peek_f32(cb, i * 8 + 2)
  poke_f32(bb, 0, cx - 3.0)
  poke_f32(bb, 1, cy + 0.6)
  poke_f32(bb, 2, cz)
  poke_f32(bb, 3, 240.0)
  poke_f32(bb, 4, 0.0)
  poke_f32(bb, 5, 0.0)
  poke_f32(bb, 6, peek_f32(s, 99))
  poke_f32(bb, 7, v.bullet_life())
  poke_f32(bb, 8, v.from_ak())
  v.step_bullets(w, bb, 1.0 / 60.0, 1)
  1

fn apart(a, c) =
  sqrt((peek_f32(a, 16) - peek_f32(c, 16)) * (peek_f32(a, 16) - peek_f32(c, 16))
     + (peek_f32(a, 18) - peek_f32(c, 18)) * (peek_f32(a, 18) - peek_f32(c, 18)))

# One round through `victim`'s chest, fired by `shooter` — the path that makes
# a guardian remember being shot at, which is `landed` and nothing shorter.
fn fire_at(w, shooter, victim) =
  took(w, shooter, victim, 1.05)

# A stretch of the beat, tick by tick, with the world's clock wound on beside
# it. What comes back is how far it walked, how far from its post it ever got,
# how many ticks it spent standing inside the stone, and how many it spent not
# walking at all.
fn walk_beat(w, s, k, px, pz, n, dt, path, worst, inside, still) =
  if n == 0 then (path, worst, inside, still)
  else
    x0 = v.player_x(s)
    z0 = v.player_z(s)
    poke_f32(w, 28, peek_f32(w, 28) + dt)
    v.bot_think(w, s, dt)
    v.walk(s, dt, 0.0, 0.0, to_int(peek_f32(s, 30)))
    x = v.player_x(s)
    z = v.player_z(s)
    g = sqrt((x - px) * (x - px) + (z - pz) * (z - pz))
    walk_beat(w, s, k, px, pz, n - 1, dt,
      path + sqrt((x - x0) * (x - x0) + (z - z0) * (z - z0)),
      if g > worst then g else worst,
      inside + if v.clear_of_wall(w, k, x, z) then 0 else 1,
      still + if bit_and(to_int(peek_f32(s, 30)), 15) == 0 then 1 else 0)

# One round put through `victim` at a given height above their feet, fired by
# `shooter`, and how much of them it took in per cent. Started three metres
# short and flown four in the step, so it passes through whichever sphere that
# height belongs to and stops in it.
fn took(w, shooter, victim, up) =
  poke_f32(victim, 82, 1.0)
  bb = peek_ptr(w, 68)

  for i in 0..v.bullet_cap()
    poke_f32(bb, i * v.bullet_stride() + 7, 0.0)

  poke_f32(bb, 0, peek_f32(victim, 21) - 3.0)
  poke_f32(bb, 1, peek_f32(victim, 22) + up)
  poke_f32(bb, 2, peek_f32(victim, 23))
  poke_f32(bb, 3, 240.0)
  poke_f32(bb, 4, 0.0)
  poke_f32(bb, 5, 0.0)
  poke_f32(bb, 6, peek_f32(shooter, 99))
  poke_f32(bb, 7, v.bullet_life())
  poke_f32(bb, 8, v.from_ak())
  v.step_bullets(w, bb, 1.0 / 60.0, 1)
  to_int((1.0 - v.health(victim)) * 100.0 + 0.5)

# The clock wound forward by hand rather than by stepping the world six
# hundred times: what is being swept is the hash `bot_keys` draws its strafe
# and its sprint out of, and that reads slot 28 and nothing else.
fn hopped(w, s, n, acc) =
  if n >= 600 then acc
  else
    poke_f32(w, 28, to_float(n))
    hopped(w, s, n + 1,
      acc + jump_bit(v.bot_keys(w, s, 40.0, 0.8))
          + jump_bit(v.bot_keys(w, s, 15.0, 0.8))
          + jump_bit(v.bot_keys(w, s, 4.0, 0.8))
          + jump_bit(v.bot_keys(w, s, 15.0, 0.3))
          + jump_bit(v.bot_keys(w, s, 4.0, 0.3)))

fn jump_bit(k) = if bit_and(k, 16) != 0 then 1 else 0

# Body and eye together, which is what every other mover does and what a test
# poking one of them by hand keeps forgetting.
fn stand_at(s, x, y, z) =
  v.set_at(s, x, y, z)
  poke_f32(s, 16, x)
  poke_f32(s, 17, y + 1.75)
  poke_f32(s, 18, z)
  1

fn live_crystal(cb, i, n) =
  if i >= n then 0 else if peek_f32(cb, i * 8 + 3) > 0.01 then i else live_crystal(cb, i + 1, n)
