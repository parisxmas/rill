# The crystals' bolts, now that the engine draws the line.
#
# The page used to turn the world's ring of bites into beams itself: read the
# crystal, find whoever was struck, stamp the clock, hold the list, and know
# how long a bolt lasts. Four of those five are facts about this world.
#
# The one that matters most is the one that is easiest to get wrong: a bolt is
# aimed **when it strikes** and never again. Recomputed each frame it would be
# dragged across the valley by somebody walking away, and a discharge does not
# follow anybody. That is the third block below.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

fn out_x(r, k) = peek_f32(r, v.zap_out_off() + k * v.zap_floats() + 3)
fn out_z(r, k) = peek_f32(r, v.zap_out_off() + k * v.zap_floats() + 5)
fn out_ay(r, k) = peek_f32(r, v.zap_out_off() + k * v.zap_floats() + 1)
fn out_born(r, k) = peek_f32(r, v.zap_out_off() + k * v.zap_floats() + 9)

# A bite, written straight into the world's ring the way `step_world` writes
# one: which crystal, and whom.
fn bite(w, who, which) =
  zb = peek_ptr(w, 78)
  k = to_int(peek_f32(w, 95))
  poke_f32(zb, k % 32 * 2, to_float(who))
  poke_f32(zb, k % 32 * 2 + 1, to_float(which))
  poke_f32(w, 95, to_float(k + 1))
  0

# An interpolated row, as the wire would leave it.
fn put_row(rows, i, id, x, z) =
  poke_f32(rows, i * 12, to_float(id))
  poke_f32(rows, i * 12 + 1, x)
  poke_f32(rows, i * 12 + 2, 4.0)
  poke_f32(rows, i * 12 + 3, z)
  poke_f32(rows, i * 12 + 6, 1.0)
  0

fn main() =
  w = v.init(32, 4, 40, 4)
  s = v.join(w)
  r = alloc_bytes(v.zap_room() * 4)

  for i in 0..v.zap_room()
    poke_f32(r, i, 0.0)

  rows = alloc_bytes(32 * 12 * 4)

  # Where this player is standing when the bolts land.
  poke_f32(s, 16, 10.0)
  poke_f32(s, 22, 3.0)
  poke_f32(s, 18, 20.0)

  println("the bolts")
  say("a quiet valley draws nothing", v.zap_beams(s, r, rows, 0, 100.0), 0)

  # ---- struck yourself ------------------------------------------------------
  bite(w, v.player_id(s), 2)
  say("one bite, one beam", v.zap_beams(s, r, rows, 0, 100.0), 1)
  say("it ends at your foot, x in cm", cm(out_x(r, 0)), 1000)
  say("and at the foot, not the eye, z in cm", cm(out_z(r, 0)), 2000)
  say("it starts above the crystal", if out_ay(r, 0) > 0.0 then 1 else 0, 1)
  say("stamped with the clock", cm(out_born(r, 0)), 10000)

  # ---- it goes out ----------------------------------------------------------
  say("still burning at half a second", v.zap_beams(s, r, rows, 0, 100.5), 1)
  say("out at six tenths", v.zap_beams(s, r, rows, 0, 100.6), 0)

  # ---- aimed once, not followed --------------------------------------------
  #
  # Somebody else is struck while standing at x = 40. They then walk to 200.
  # The beam has to stay where it was aimed.
  put_row(rows, 0, 7, 40.0, 50.0)
  bite(w, 7, 3)
  say("their bolt lands", v.zap_beams(s, r, rows, 1, 200.0), 1)
  say("aimed where they stood, x in cm", cm(out_x(r, 0)), 4000)
  put_row(rows, 0, 7, 200.0, 50.0)
  say("the same beam a frame later", v.zap_beams(s, r, rows, 1, 200.1), 1)
  say("has not followed them, x in cm", cm(out_x(r, 0)), 4000)

  # ---- somebody the wire is hiding -----------------------------------------
  #
  # Struck behind a hill: the server blanks their position, so there is no row
  # to aim at. The bolt collapses onto the crystal rather than reaching for the
  # origin, which is what a beam to (0,0,0) would have drawn across the valley.
  bite(w, 9, 4)
  n = v.zap_beams(s, r, rows, 1, 300.0)
  say("a hidden target still makes a beam", if n > 0 then 1 else 0, 1)
  say("that goes nowhere: it ends where it starts", cm(out_x(r, 0) - peek_f32(r, v.zap_out_off())), 0)

  # ---- the ring holds ------------------------------------------------------
  #
  # Twenty bites at once, of which the ring keeps sixteen. Nothing may run off
  # the end of the caller's room.
  for i in 0..20
    bite(w, v.player_id(s), i % 40)
  say("twenty bites, sixteen beams", v.zap_beams(s, r, rows, 0, 400.0), 16)
  say("and the cursor caught up", to_int(peek_f32(r, v.zap_cursor_off())), to_int(peek_f32(w, 95)))

  # ---- a round starts over -------------------------------------------------
  #
  # `restart` puts the world's counter back to nought while the ring still
  # holds the last round's bolts. Nothing may be replayed, and nothing from
  # before may still be burning — this is the frame the page's own cursor used
  # to get wrong.
  poke_f32(w, 95, 0.0)
  say("a fresh round draws none of the old ones", v.zap_beams(s, r, rows, 0, 1.0), 0)
  println("done")
