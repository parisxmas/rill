# The client's end of the wire, in the engine.
#
# The page used to keep a second copy of the protocol: net.js parsed every
# frame the server sent and host.js walked the parsed events into the world,
# while server.rill wrote the same layouts from the other side. Two mirrors of
# one wire is a standing invitation to the bug where they disagree — the world
# clock spent a week comparing itself against a field that was never there —
# so the parsing, the applying, the snapshot ring, the interpolation, the
# names, the ping and the announcements all live here now. The page's share of
# the protocol is a socket: bytes in, bytes out, and nothing about what any of
# them mean.
#
# The layouts mirror server.rill's "bytes on the wire" section exactly, and
# nothing else mirrors them anywhere.
#
# ---- the block --------------------------------------------------------------
#
#   f32     0..63     header — the h_* indices below
#   bytes  256..511   OUT: the frame being built to send
#   bytes  512..575   the identity token out of `hello`
#   bytes  576..767   the words of a refusal
#   bytes  768..2815  names: 64 slots of 32 — u8 len, u16 id, pad, 28 bytes
#   f32   1024..2071  two snapshots — see SNAP below
#   f32   2080..2463  interpolated players, 32 x 12 — see wire_interp
#   f32   2464..2527  page events, 16 x 4 — sounds the page still plays
#   f32   2528..2591  ids already announced (the told table)
#   f32   4700..4827  when each id was first seen named, 64 x [id, ms]
#   f32   2600..4647  crystals gone, for replay across a tier rebuild
#   bytes 65536..131071  the event queue: [u16 len][frame bytes] ...
#   bytes 131072..172031 IN: the frame the page just received
#
# A snapshot record: 12 header floats — at, clock, shark x y z heading mode,
# phase, left, count — then 32 players of 16: id, x, y, z, yaw, pitch, health,
# pose, torch, hit, shot, seen, ammo, kills, deaths, spare.

import "valley" as v
import "hud" as hud

fn wire_bytes() = 172032

fn out_at() = 256
fn token_at() = 512
fn refuse_at() = 576
fn names_at() = 768
fn name_cap() = 64
fn snap_at(which) = 1024 + which * 524
fn interp_at() = 2080
fn pev_at() = 2464
fn told_at() = 2528
# When each id was first seen wearing a name, two floats apiece — see
# `maybe_hello` for why a join is not announced the instant a name arrives.
fn waited_at() = 4700
fn wait_cap() = 64
fn gone_at() = 2600
fn gone_cap() = 2048
fn evq_at() = 65536
fn evq_cap() = 65536
fn in_at() = 131072
fn in_cap() = 40960

# ---- the header -------------------------------------------------------------

fn h_id() = 0          # my id, -1 until hello
fn h_hello() = 1
fn h_pines() = 2
fn h_crystals() = 3
fn h_grass() = 4
fn h_clock0() = 5
fn h_ping() = 6        # ms, -1 until the first pong
fn h_ver() = 7         # -1 until said
fn h_span() = 8        # ms between snapshots, smoothed
fn h_last_at() = 9
fn h_prev_at() = 10
fn h_which() = 11      # which snap slot is the newest
fn h_have() = 12       # how many snapshots have ever landed
fn h_refused() = 13    # length of the refusal, 0 for none
fn h_token_len() = 14
fn h_out_len() = 15
fn h_evw() = 16        # event queue write offset
fn h_evr() = 17        # and read
fn h_pev_n() = 18      # page events waiting
fn h_interp_n() = 19
fn h_told_n() = 20
fn h_first_roster() = 21
fn h_gone_n() = 22
fn h_synced_at() = 23  # the snapshot the match clock was last set from
fn h_applied_at() = 24 # and the one reconcile last ran against
fn h_shark_x() = 25    # ..29: the shark, interpolated at the last tick
fn h_evq_dropped() = 30
fn h_pull() = 31

# The stones the server says this player holds, plus one — nought means
# nothing has been said yet, so a rejoin does not wipe a real count with a 0.
fn h_pocket() = 33

fn pocket(b: Ptr) -> Int = to_int(peek_f32(b, h_pocket())) - 1       # what the server says this planet pulls with, 0 unsaid
fn h_now() = 60       # the page's clock in ms, stamped before frame() and tick()

fn make() =
  b = alloc_bytes(wire_bytes())

  for i in 0..wire_bytes() / 4
    poke_f32(b, i, 0.0)

  poke_f32(b, h_id(), 0.0 - 1.0)
  poke_f32(b, h_ping(), 0.0 - 1.0)
  poke_f32(b, h_ver(), 0.0 - 1.0)
  poke_f32(b, h_first_roster(), 1.0)
  b

# ---- reading the wire's own integers ---------------------------------------

fn u8_at(b, at) = peek_u8(b, at)

fn u16_at(b, at) = bit_or(peek_u8(b, at), shl(peek_u8(b, at + 1), 8))

fn u32_at(b, at) = bit_or(u16_at(b, at), shl(u16_at(b, at + 2), 16))

# A little-endian f32 out of raw bytes: the four bytes are already lying in
# the block, so reading them as a float is one aligned peek away — except the
# wire's floats are not aligned. Copied through the scratch corner of the
# header instead, byte by byte.
fn f32_at(b, at) =
  poke_i8(b, 252, peek_u8(b, at))
  poke_i8(b, 253, peek_u8(b, at + 1))
  poke_i8(b, 254, peek_u8(b, at + 2))
  poke_i8(b, 255, peek_u8(b, at + 3))
  peek_f32(b, 63)

# ---- one frame arrives ------------------------------------------------------
#
# The page copied `len` bytes into IN and calls this. Frames that touch the
# world go into the queue for the next tick — the world may not even exist
# yet, and the door lists arrive before it does. Frames that are pure state —
# names, the ping, the version, `hello` — land at once.

fn frame(b, len) =
  if len < 1 then 0
  else
    k = u8_at(b, in_at())
    if k == 104 then hello(b, len)
    else if k == 117 then who(b, len)
    else if k == 118 then said_ver(b)
    else if k == 112 then pong(b)
    else if k == 110 then refused(b, len)
    else if k == 115 then snapshot(b, len)
    else queue(b, len)

fn hello(b, len) =
  poke_f32(b, h_id(), to_float(u16_at(b, in_at() + 1)))
  poke_f32(b, h_pines(), to_float(u32_at(b, in_at() + 3)))
  poke_f32(b, h_crystals(), to_float(u32_at(b, in_at() + 7)))
  poke_f32(b, h_grass(), to_float(u32_at(b, in_at() + 11)))
  poke_f32(b, h_clock0(), f32_at(b, in_at() + 15))
  n = if len - 19 > 63 then 63 else len - 19

  for i in 0..n
    poke_i8(b, token_at() + i, u8_at(b, in_at() + 19 + i))

  poke_f32(b, h_token_len(), to_float(n))
  poke_f32(b, h_hello(), 1.0)
  1

fn who(b, len) =
  id = u16_at(b, in_at() + 1)
  s = name_slot(b, id)
  n = if len - 3 > 28 then 28 else len - 3
  poke_i8(b, names_at() + s * 32, n)
  poke_i8(b, names_at() + s * 32 + 1, bit_and(id, 255))
  poke_i8(b, names_at() + s * 32 + 2, shr(id, 8))

  for i in 0..n
    poke_i8(b, names_at() + s * 32 + 4 + i, u8_at(b, in_at() + 3 + i))
  1

# The slot this id already holds, or a free one, or slot zero worn out.
fn name_slot(b, id) = ns_find(b, id, 0, 0 - 1)

fn ns_find(b, id, i, free) =
  if i >= name_cap() then if free >= 0 then free else 0
  else if u8_at(b, names_at() + i * 32) > 0 && name_id(b, i) == id then i
  else if u8_at(b, names_at() + i * 32) == 0 && free < 0 then ns_find(b, id, i + 1, i)
  else ns_find(b, id, i + 1, free)

fn name_id(b, i) = u8_at(b, names_at() + i * 32 + 1) + u8_at(b, names_at() + i * 32 + 2) * 256

fn name_len(b, id) = nl_go(b, id, 0)

fn nl_go(b, id, i) =
  if i >= name_cap() then 0
  else if u8_at(b, names_at() + i * 32) > 0 && name_id(b, i) == id then u8_at(b, names_at() + i * 32)
  else nl_go(b, id, i + 1)

fn name_bytes(b, id) = nb_go(b, id, 0)

fn nb_go(b, id, i) =
  if i >= name_cap() then names_at()
  else if u8_at(b, names_at() + i * 32) > 0 && name_id(b, i) == id then names_at() + i * 32 + 4
  else nb_go(b, id, i + 1)

fn said_ver(b) =
  poke_f32(b, h_ver(), to_float(u16_at(b, in_at() + 1)))
  1

# The token is this page's own clock as eight bytes; the difference is the
# round trip. Smoothed a quarter at a time, the way it always was.
fn pong(b) =
  poke_i8(b, 248, u8_at(b, in_at() + 1))
  poke_i8(b, 249, u8_at(b, in_at() + 2))
  poke_i8(b, 250, u8_at(b, in_at() + 3))
  poke_i8(b, 251, u8_at(b, in_at() + 4))
  poke_i8(b, 252, u8_at(b, in_at() + 5))
  poke_i8(b, 253, u8_at(b, in_at() + 6))
  poke_i8(b, 254, u8_at(b, in_at() + 7))
  poke_i8(b, 255, u8_at(b, in_at() + 8))
  0

# The pong carries an f64 the page must difference against its own clock — the
# page hands `now` in when it feeds the frame. See wire_pong in world.rill.
fn pong_took(b, now) =
  rtt = now - peek_f64(b, 31)
  old = peek_f32(b, h_ping())
  poke_f32(b, h_ping(), if old < 0.0 then rtt else old * 0.75 + rtt * 0.25)
  1

fn refused(b, len) =
  n = if len - 1 > 191 then 191 else len - 1

  for i in 0..n
    poke_i8(b, refuse_at() + i, u8_at(b, in_at() + 1 + i))

  poke_f32(b, h_refused(), to_float(n))
  1

# ---- the snapshot ring ------------------------------------------------------

fn snapshot(b, len) =
  if len < 27 then 0
  else
    at = peek_f32(b, h_now())
    prev_at = peek_f32(b, h_last_at())
    which = 1 - to_int(peek_f32(b, h_which()))
    s = snap_at(which)
    poke_f32(b, s, at)
    poke_f32(b, s + 1, f32_at(b, in_at() + 1))

    for i in 0..5
      poke_f32(b, s + 2 + i, f32_at(b, in_at() + 5 + i * 4))

    poke_f32(b, s + 7, to_float(u8_at(b, in_at() + 25)))
    poke_f32(b, s + 8, f32_at(b, in_at() + 26))
    count = u8_at(b, in_at() + 30)
    n = if count > 32 then 32 else count
    poke_f32(b, s + 9, to_float(n))

    for i in 0..n
      snap_player(b, s + 12 + i * 16, in_at() + 31 + i * 37)

    poke_f32(b, h_which(), to_float(which))
    poke_f32(b, h_prev_at(), prev_at)
    poke_f32(b, h_last_at(), at)
    gap = at - prev_at
    if peek_f32(b, h_have()) > 0.5 && gap > 1.0 && gap < 500.0 then span_learn(b, gap) else 0
    poke_f32(b, h_have(), peek_f32(b, h_have()) + 1.0)
    1

fn span_learn(b, gap) =
  old = peek_f32(b, h_span())
  poke_f32(b, h_span(), if old > 0.5 then old * 0.8 + gap * 0.2 else gap)
  1

fn snap_player(b, p, src) =
  poke_f32(b, p, to_float(u16_at(b, src)))

  for i in 0..6
    poke_f32(b, p + 1 + i, f32_at(b, src + 2 + i * 4))

  pose = u8_at(b, src + 26)
  poke_f32(b, p + 7, to_float(pose % 8))
  # Slot 8 carries three small facts in one float: bit nought the lamp, the
  # next two which weapon is in their hands, the one above that whether their
  # pack is burning. Exact in an f32, and the row stays twelve wide.
  poke_f32(b, p + 8, to_float(pose / 8 % 2 + pose / 16 % 4 * 2 + pose / 64 % 2 * 8))
  poke_f32(b, p + 9, to_float(u16_at(b, src + 27)))
  poke_f32(b, p + 10, to_float(u16_at(b, src + 29)))
  poke_f32(b, p + 11, to_float(u8_at(b, src + 31)))
  ammo = u8_at(b, src + 32)
  poke_f32(b, p + 12, if ammo > 127 then 0.0 - 1.0 else to_float(ammo))
  poke_f32(b, p + 13, to_float(u16_at(b, src + 33)))
  poke_f32(b, p + 14, to_float(u16_at(b, src + 35)))
  1

# ---- the event queue --------------------------------------------------------
#
# World frames wait here as raw bytes until a tick has a world to apply them
# to. Flat, not a ring: the read chases the write and both go back to nought
# when they meet, which they do every frame in practice.

fn queue(b, len) =
  w = to_int(peek_f32(b, h_evw()))
  if w + 2 + len > evq_cap() then
    poke_f32(b, h_evq_dropped(), peek_f32(b, h_evq_dropped()) + 1.0)
    0
  else
    poke_i8(b, evq_at() + w, bit_and(len, 255))
    poke_i8(b, evq_at() + w + 1, shr(len, 8))

    for i in 0..len
      poke_i8(b, evq_at() + w + 2 + i, u8_at(b, in_at() + i))

    poke_f32(b, h_evw(), to_float(w + 2 + len))
    1

# ---- one tick ---------------------------------------------------------------
#
# Everything the page used to do between taking events and drawing: drain the
# queue into the world, square this player with the newest snapshot, work out
# where everybody is right now, and say all of it to the HUD.

fn tick(b, w, s, h, now, hold_ammo) =
  drain(b, w, s, h, now)
  reconcile(b, w, s, hold_ammo)
  interp(b, now)
  shark(b, now)
  announce(b, h, now)
  hud_rows(b, h, now)
  to_int(peek_f32(b, h_interp_n()))

fn drain(b, w, s, h, now) =
  r = to_int(peek_f32(b, h_evr()))
  wr = to_int(peek_f32(b, h_evw()))
  if r >= wr then
    poke_f32(b, h_evr(), 0.0)
    poke_f32(b, h_evw(), 0.0)
    0
  else
    len = u8_at(b, evq_at() + r) + u8_at(b, evq_at() + r + 1) * 256
    apply(b, w, s, h, evq_at() + r + 2, len, now)
    poke_f32(b, h_evr(), to_float(r + 2 + len))
    drain(b, w, s, h, now)

# One world frame, by its letter — the same letters server.rill sends.
fn apply(b, w, s, h, at, len, now) =
  k = u8_at(b, at)
  if k == 103 then gone_list(b, w, at, len)
  else if k == 87 then stone_list(w, b, at, len)
  else if k == 114 then put_round(b, w, at)
  else if k == 116 then put_thrown(b, w, at)
  else if k == 107 then put_crater(b, w, at)
  else if k == 98 then took_break(b, w, at)
  else if k == 119 then ap_stone(w, u16_at(b, at + 1))
  else if k == 100 then ap_down(w, u16_at(b, at + 1))
  else if k == 121 then ap_fell(w, u16_at(b, at + 1))
  else if k == 80 then fell_list(w, b, at, len)
  else if k == 122 then ap_zap(w, u16_at(b, at + 1), u16_at(b, at + 3))
  else if k == 109 then ap_mag(w, u8_at(b, at + 1), u32_at(b, at + 2))
  else if k == 67 then said_line(b, h, at, len, now)
  else if k == 120 then hurt_line(b, h, at, now)
  # What this planet pulls with. Through the queue rather than applied on
  # arrival, because it is about the world and the world may not be built
  # yet — the same reason the door lists wait here.
  else if k == 71 then ap_pull(b, w, at)
  # The pickaxe's traffic. 84 is one crater by its cell; 86 a built rock by
  # its place; 85 the whole carve field at the door, walked by dug patch, with
  # the two cursors that make later events land in step; 93 how many stones
  # this player's own pocket holds, which only the server counts.
  else if k == 84 then ap_carve_ev(w, u32_at(b, at + 1))
  else if k == 86 then ap_built_ev(w, b, at)
  else if k == 85 then ap_carve_field(w, b, at, len)
  else if k == 93 then ap_pocket(b, u16_at(b, at + 1))
  else 0

fn ap_carve_ev(w, ci) =
  v.ap_carve(w, ci)
  1

fn ap_built_ev(w, b, at) =
  v.ap_built(w, f32_at(b, at + 1), f32_at(b, at + 5), f32_at(b, at + 9), f32_at(b, at + 13))
  1

# The field: op, u32 carves-so-far, u32 built-so-far, then one entry per dug
# patch — (u16 patch, u16 n) and either n (u16 cell-in-patch, u8 level)
# triples, or, where a patch is more than a third dug (n == 0 marks it), its
# whole page raw, a byte a cell. A pristine valley is nine bytes; a valley is
# downloaded in proportion to how much of it was dug.
fn ap_carve_field(w, b, at, len) =
  v.ap_set_carves(w, u32_at(b, at + 1))
  v.ap_set_built(w, u32_at(b, at + 5))
  cf_pages(w, b, at + 9, at + len)

fn cf_pages(w, b, p, end) =
  if p + 3 >= end then 1
  else
    sx = u16_at(b, p)
    n = u16_at(b, p + 2)
    cf_cols(w, b, p + 4, sx, n)
    cf_pages(w, b, p + 4 + n * (2 + v.carve_col_bytes()), end)

fn cf_cols(w, b, p0, sx, n) =
  wide = 2 + v.carve_col_bytes()

  for j in 0..n
    p = p0 + j * wide
    c = u16_at(b, p)

    for i in 0..v.carve_col_bytes()
      v.ap_carve_col(w, sx, c, i, u8_at(b, p + 2 + i))

    v.ap_carve_col_done(w, sx, c)

  1

# The pocket is not applied to the world — it is this player's own count, and
# it lands on the block the page reads the HUD from.
fn ap_pocket(b, n) =
  poke_f32(b, h_pocket(), to_float(n) + 1.0)
  1

# The pull this connection was told about, put back on a valley that has just
# been rebuilt under it.
fn pull_again(b, w) =
  g = peek_f32(b, h_pull())
  if g > 0.001 then setg(w, g) else 0

fn setg(w, g) =
  v.set_gravity(w, g)
  1

fn ap_pull(b, w, at) =
  g = f32_at(b, at + 1)
  # Kept as well as applied: a tier change builds a new valley out of the same
  # connection, and the server says this once, on arrival. Without somewhere
  # to remember it, a browser that re-tiered mid-round would go back to
  # predicting against the default while the server went on using the setting
  # — which is a jump that starts right and lands wrong.
  poke_f32(b, h_pull(), g)
  setg(w, g)

fn ap_stone(w, i) =
  v.drop_block(w, i)
  1

fn ap_down(w, i) =
  v.down_fire(w, i)
  1

fn ap_fell(w, i) =
  v.put_fell(w, i)
  1

fn ap_zap(w, who0, ci) =
  v.put_zap(w, who0, ci)
  1

fn ap_mag(w, i, times) =
  v.set_mag(w, i, times)
  1

fn gone_list(b, w, at, len) = gl_go(b, w, at + 1, len - 1)

fn gl_go(b, w, at, left) =
  if left < 2 then 0
  else
    i = u16_at(b, at)
    v.put_gone(w, i)
    remember_gone(b, i)
    gl_go(b, w, at + 2, left - 2)

fn stone_list(w, b, at, len) = sl_go(w, b, at + 1, len - 1)

fn sl_go(w, b, at, left) =
  if left < 2 then 0
  else
    ap_stone(w, u16_at(b, at))
    sl_go(w, b, at + 2, left - 2)

fn fell_list(w, b, at, len) = fl_go(w, b, at + 1, len - 1)

fn fl_go(w, b, at, left) =
  if left < 2 then 0
  else
    ap_fell(w, u16_at(b, at))
    fl_go(w, b, at + 2, left - 2)

# A break that arrives as an event joins the replay list too, so a tier
# rebuild — a fresh world mid-round — can be told everything at once.
fn took_break(b, w, at) =
  i = u16_at(b, at + 1)
  v.put_break(w, i)
  remember_gone(b, i)
  1

fn remember_gone(b, i) =
  n = to_int(peek_f32(b, h_gone_n()))
  if n >= gone_cap() then 0
  else
    poke_f32(b, gone_at() + n, to_float(i))
    poke_f32(b, h_gone_n(), to_float(n + 1))
    1

# A round of this player's own is already in the air — it was fired here the
# moment the mouse went down. Everybody else's goes into the ring, and the
# owner's shot is a page event either way: the sound and the figure's flinch
# are the page's.
fn put_round(b, w, at) =
  owner = f32_at(b, at + 25)
  if to_int(owner) != to_int(peek_f32(b, h_id())) then ap_round(b, w, at, owner) else 0
  page_event(b, 1.0, owner, 0.0, 0.0)

fn ap_round(b, w, at, owner) =
  v.put_bullet(w, f32_at(b, at + 1), f32_at(b, at + 5), f32_at(b, at + 9), f32_at(b, at + 13), f32_at(b, at + 17), f32_at(b, at + 21), owner)
  1

# The slot rides with it — see `put_fireball_at`. Without it a client that
# joined late names every fireball differently from the server for the rest
# of the match, and the message that says one has been shot down lands on
# whatever else is living at that number.
fn put_thrown(b, w, at) =
  v.put_fireball_at(w, u16_at(b, at + 33),
    f32_at(b, at + 1), f32_at(b, at + 5), f32_at(b, at + 9),
    f32_at(b, at + 13), f32_at(b, at + 17), f32_at(b, at + 21),
    f32_at(b, at + 25), f32_at(b, at + 29))
  1

fn put_crater(b, w, at) =
  v.put_blast(w, f32_at(b, at + 1), f32_at(b, at + 5), f32_at(b, at + 9), f32_at(b, at + 13))
  1

fn page_event(b, kind, a, c, d) =
  n = to_int(peek_f32(b, h_pev_n()))
  if n >= 16 then 0
  else
    poke_f32(b, pev_at() + n * 4, kind)
    poke_f32(b, pev_at() + n * 4 + 1, a)
    poke_f32(b, pev_at() + n * 4 + 2, c)
    poke_f32(b, pev_at() + n * 4 + 3, d)
    poke_f32(b, h_pev_n(), to_float(n + 1))
    1

# Somebody said something: the name in green, the words as they came, into
# the HUD's log ring — as text, never as anything else.
fn said_line(b, h, at, len, now) =
  who0 = u16_at(b, at + 1)
  sl = hud.log_push_start(h, true, now)
  add_name(b, h, sl, who0, 5)
  hud.slot_add(h, sl, 9, " ")
  hud.slot_add_bytes(h, sl, 9, b, at + 3, len - 3)
  1

fn add_name(b, h, sl, id, color) =
  n = name_len(b, id)
  if n > 0 then hud.slot_add_bytes(h, sl, color, b, name_bytes(b, id), n)
  else hud.slot_add(h, sl, color, "somebody")

# A round found somebody, and the two people it concerns each get their own
# sentence. The page's only share is the sound, which goes out as an event.
fn hurt_line(b, h, at, now) =
  who0 = u16_at(b, at + 1)
  by = u16_at(b, at + 3)
  much = f32_at(b, at + 5)
  down = u8_at(b, at + 9)
  myid = to_int(peek_f32(b, h_id()))
  if who0 != myid && by != myid then 0
  else
    mine = by == myid
    if !mine then page_event(b, 2.0, much, 0.0, 0.0) else 0
    took_words(b, h, mine, if mine then who0 else by, much, down, now)
    log_words(b, h, mine, if mine then who0 else by, much, down, now)
    1

fn took_words(b, h, mine, them, much, down, now) =
  sl = hud.sl_took()
  m = hud.slot_meta(sl)
  poke_f32(h, m, 0.0)
  pct = int_to_str(to_int(much * 100.0 + 0.5))
  if mine && down > 0 then
    hud.slot_add(h, sl, 0, "† you killed ")
    add_name(b, h, sl, them, 1)
  else if mine then
    hud.slot_add(h, sl, 0, "you hit ")
    add_name(b, h, sl, them, 1)
    hud.slot_add(h, sl, 0, " for ")
    hud.slot_add(h, sl, 8, pct)
  else
    add_name(b, h, sl, them, 1)
    hud.slot_add(h, sl, 0, " hit you for ")
    hud.slot_add(h, sl, 8, pct)
  poke_f32(h, hud.h_took_at(), now)
  poke_f32(h, hud.h_took_mine(), if mine then 1.0 else 0.0)
  1

fn log_words(b, h, mine, them, much, down, now) =
  sl = hud.log_push_start(h, false, now)
  if mine then hud.slot_add(h, sl, 1, "you") else add_name(b, h, sl, them, 1)
  hud.slot_add(h, sl, 2, if down > 0 then " † " else " → ")
  if mine then add_name(b, h, sl, them, 0) else hud.slot_add(h, sl, 0, "you")
  if down > 0 then 0
  else hud.slot_add(h, sl, 6, " " + int_to_str(to_int(much * 100.0 + 0.5)))
  1

# ---- squaring this player with the server ----------------------------------

fn last_snap(b) = snap_at(to_int(peek_f32(b, h_which())))

fn prev_snap(b) = snap_at(1 - to_int(peek_f32(b, h_which())))

fn my_row(b) =
  s = last_snap(b)
  mr_go(b, s, to_int(peek_f32(b, s + 9)), to_int(peek_f32(b, h_id())), 0)

fn mr_go(b, s, n, id, i) =
  if i >= n then 0 - 1
  else if to_int(peek_f32(b, s + 12 + i * 16)) == id then s + 12 + i * 16
  else mr_go(b, s, n, id, i + 1)

fn reconcile(b, w, s, hold_ammo) =
  at = peek_f32(b, h_last_at())
  if peek_f32(b, h_have()) < 0.5 || at == peek_f32(b, h_applied_at()) then 0
  else
    poke_f32(b, h_applied_at(), at)
    sn = last_snap(b)
    v.set_match(w, to_int(peek_f32(b, sn + 7)), peek_f32(b, sn + 8))
    clock = peek_f32(b, sn + 1)
    dc = v.world_time(w) - clock
    if dc > 0.5 || dc < 0.0 - 0.5 then v.set_world_time(w, clock) else 0
    m = my_row(b)
    if m < 0 then 0
    else
      v.set_health(s, peek_f32(b, m + 6))
      # The ammunition, and the two directions are not the same question.
      #
      # A snapshot is half a round trip old, and in that time the trigger has
      # gone on emptying the gun — so the server always says *more* than the
      # client has, by about as many rounds as the gun fires in that gap.
      # A bolt gun fires one round a second and the difference never reached
      # the old threshold of two; a machine gun fires sixteen, and the count
      # was written back up two or three every snapshot, twenty times a
      # second. On screen the belt refilled itself while the trigger was
      # down.
      #
      # So: the server saying *fewer* is obeyed at once — that is the client
      # having fired something the server refused, and the server owns the
      # magazine. The server saying *more* is ordinary flight time and is
      # left alone, unless it is more than any latency could account for,
      # which is a reload or a box this client missed entirely.
      ammo = to_int(peek_f32(b, m + 12))
      held = v.held_ammo(s)
      if ammo >= 0 && hold_ammo == 0 then ammo_agrees(s, ammo, held) else 0
      x = v.player_x(s)
      y = v.player_y(s)
      z = v.player_z(s)
      # The snapshot is old, and while falling that is not an error.
      #
      # It left the server half a round trip ago, so during any fast vertical
      # motion it shows this player where they *were* — above, when falling —
      # and comparing it raw against the current position manufactures a
      # mismatch of speed times latency. Blended at 35% twenty times a second
      # that was a sawtooth the whole screen rode: pulled up each snapshot,
      # dropped by gravity between them, 58 upward jerks measured in one
      # eleven-metre fall. Past eleven metres a second of fall the fabricated
      # gap crossed the four-metre line and the sawtooth became a teleport.
      #
      # Both ends run the same gravity, so the foreseeable part of the lag is
      # subtracted before anything is judged: the client's own vertical
      # velocity times the snapshot's age. Vertical only — walking is five
      # metres a second and its lag is centimetres, but a long fall is fifty
      # and its lag is metres. `span` alone stands in for the age when the
      # ping has not been measured yet.
      age = age_of(b)
      # All three axes, not one: the vertical alone fixed the fall and left
      # the flight — crossing the valley under the jetpack at five metres a
      # second, the horizontal trail read as an error and yanked the flier
      # backward eighteen centimetres a tick, twenty times a second. The
      # ground velocities are what `walk` says the step did (slots 243 and
      # 255), so a wall that stopped the legs stops the compensation too.
      dx = peek_f32(b, m + 1) - x + peek_f32(s, 243) * age
      dy = peek_f32(b, m + 2) - y + peek_f32(s, 24) * age
      dz = peek_f32(b, m + 3) - z + peek_f32(s, 255) * age
      d = sqrt(dx * dx + dy * dy + dz * dz)
      if d > 4.0 then v.set_at(s, x + dx, y + dy, z + dz)
      else if d > 0.03 then eased_in(s, x, y, z, dx, dy, dz)
      else 0
      1

# The ordinary correction, and the vertical is not like the other two.
#
# Sideways, a gap between here and the server's answer is a mistake that was
# already made — blend 35% a tick and it is gone. Vertically a gap can be
# *alive*: let go of the jetpack and the server burns on for the width of the
# wire before it hears, which leaves it climbing about two metres a second
# faster for the whole fall that follows. A position-only blend cannot close
# a gap that is being refilled — it settles into pulling a quarter metre up
# every tick, twenty times a second, which is the shudder that arrived the
# day the pack's numbers doubled and its transitions got twice as sharp.
#
# So the vertical correction is split: the *velocity* absorbs the persistent
# part — nudged toward the server a bounded step per snapshot, so the two
# trajectories agree within a third of a second — and the position takes a
# sip small enough to be invisible. The horizontal keeps the old blend; a
# walk has no throttle to disagree about.
# Eight, because the smallest thing that can honestly appear in a magazine
# out of nowhere is a pickup, and the smallest pickup is a rifle's ten. Below
# that, a server that is ahead of the client is a server that has not heard
# the last few shots yet.
fn ammo_slack() = 8

fn ammo_agrees(s, ammo, held) =
  if ammo < held - 2 then v.set_held_ammo(s, ammo)
  else if ammo > held + ammo_slack() then v.set_held_ammo(s, ammo)
  else 0

fn eased_in(s, x, y, z, dx, dy, dz) =
  poke_f32(s, 24, peek_f32(s, 24) + clampf(dy * 1.5, 0.0 - 0.6, 0.6))
  v.set_at(s, x + dx * 0.35, y + dy * 0.15, z + dz * 0.35)

fn clampf(v, lo, hi) = if v < lo then lo else if v > hi then hi else v

# How old the snapshot being reconciled against is, in seconds: half the round
# trip to send it, plus the tick it waited to be built. Clamped, because a ping
# spike is not a licence to trust prediction for a quarter of a minute.
fn age_of(b) =
  ping = peek_f32(b, h_ping())
  half = if ping > 0.0 then ping * 0.5 else 0.0
  v.clampf((half + peek_f32(b, h_span())) / 1000.0, 0.0, 0.25)

extern fn sqrt(x: Float) -> Float

# ---- where everybody is right now ------------------------------------------
#
# Between the last two snapshots, a snapshot behind — the point that arrives
# just as the next one lands. Yaw takes the short way round.

fn lerp_t(b, now) =
  span = if peek_f32(b, h_span()) > 0.5 then peek_f32(b, h_span()) else peek_f32(b, h_last_at()) - peek_f32(b, h_prev_at())
  if span <= 1.0 then 1.0
  else v.clampf((now - peek_f32(b, h_last_at())) / span, 0.0, 1.0)

fn wrap_pi(a) =
  if a > 3.14159265 then wrap_pi(a - 6.2831853)
  else if a < 0.0 - 3.14159265 then wrap_pi(a + 6.2831853)
  else a

fn interp(b, now) =
  if peek_f32(b, h_have()) < 0.5 then no_interp(b) else do_interp(b, now)

fn no_interp(b) =
  poke_f32(b, h_interp_n(), 0.0)
  0

fn do_interp(b, now) =
  t = lerp_t(b, now)
  sn = last_snap(b)
  n = to_int(peek_f32(b, sn + 9))
  poke_f32(b, h_interp_n(), 0.0)

  for i in 0..n
    interp_one(b, sn + 12 + i * 16, t)
  0

fn interp_one(b, p, t) =
  id = to_int(peek_f32(b, p))
  if id == to_int(peek_f32(b, h_id())) || peek_f32(b, p + 11) < 0.5 then 0
  else
    q = prev_row(b, id)
    src = if q >= 0 then q else p
    k = to_int(peek_f32(b, h_interp_n()))
    o = interp_at() + k * 12
    poke_f32(b, o, to_float(id))
    poke_f32(b, o + 1, peek_f32(b, src + 1) + (peek_f32(b, p + 1) - peek_f32(b, src + 1)) * t)
    poke_f32(b, o + 2, peek_f32(b, src + 2) + (peek_f32(b, p + 2) - peek_f32(b, src + 2)) * t)
    poke_f32(b, o + 3, peek_f32(b, src + 3) + (peek_f32(b, p + 3) - peek_f32(b, src + 3)) * t)
    poke_f32(b, o + 4, peek_f32(b, src + 4) + wrap_pi(peek_f32(b, p + 4) - peek_f32(b, src + 4)) * t)
    poke_f32(b, o + 5, peek_f32(b, src + 5) + (peek_f32(b, p + 5) - peek_f32(b, src + 5)) * t)
    poke_f32(b, o + 6, peek_f32(b, p + 6))
    poke_f32(b, o + 7, peek_f32(b, p + 7))
    poke_f32(b, o + 8, peek_f32(b, p + 8))
    hue(b, o, id)
    poke_f32(b, h_interp_n(), to_float(k + 1))
    1

fn prev_row(b, id) =
  s = prev_snap(b)
  pr_go(b, s, to_int(peek_f32(b, s + 9)), id, 0)

fn pr_go(b, s, n, id, i) =
  if i >= n then 0 - 1
  else if to_int(peek_f32(b, s + 12 + i * 16)) == id && peek_f32(b, s + 12 + i * 16 + 11) > 0.5 then s + 12 + i * 16
  else pr_go(b, s, n, id, i + 1)

# A colour per player, off the golden angle round the hue circle — the same
# arithmetic hueOf ran in the page, at full health: the figure pales with
# health in its own shader.
fn hue(b, o, id) =
  hh = fract(to_float(id) * 0.61803398875) * 6.0
  sat = 0.75
  val = 0.9
  poke_f32(b, o + 9, hsv_f(5.0, hh, sat, val))
  poke_f32(b, o + 10, hsv_f(3.0, hh, sat, val))
  poke_f32(b, o + 11, hsv_f(1.0, hh, sat, val))

fn fract(x) = x - floor(x)

extern fn floor(x: Float) -> Float

fn hsv_f(n, hh, sat, val) =
  k = fmod_f(n + hh, 6.0)
  m = min(min(k, 4.0 - k), 1.0)
  val - val * sat * max(0.0, m)

fn fmod_f(a, m) = a - floor(a / m) * m

fn shark(b, now) =
  if peek_f32(b, h_have()) < 1.5 then 0
  else
    t = lerp_t(b, now)
    a = prev_snap(b)
    c = last_snap(b)
    poke_f32(b, h_shark_x(), peek_f32(b, a + 2) + (peek_f32(b, c + 2) - peek_f32(b, a + 2)) * t)
    poke_f32(b, h_shark_x() + 1, peek_f32(b, a + 3) + (peek_f32(b, c + 3) - peek_f32(b, a + 3)) * t)
    poke_f32(b, h_shark_x() + 2, peek_f32(b, a + 4) + (peek_f32(b, c + 4) - peek_f32(b, a + 4)) * t)
    poke_f32(b, h_shark_x() + 3, peek_f32(b, a + 5) + wrap_pi(peek_f32(b, c + 5) - peek_f32(b, a + 5)) * t)
    poke_f32(b, h_shark_x() + 4, peek_f32(b, c + 6))
    1

# ---- who arrived and who left ----------------------------------------------
#
# Announced off the snapshot rather than off a message of its own: somebody is
# announced once their name has arrived, and never this player. The told table
# holds the ids already said.

fn announce(b, h, now) =
  if peek_f32(b, h_have()) < 0.5 then 0
  else
    sn = last_snap(b)
    n = to_int(peek_f32(b, sn + 9))

    for i in 0..n
      maybe_hello(b, h, to_int(peek_f32(b, sn + 12 + i * 16)), now)

    sweep_told(b, h, sn, n, now)
    poke_f32(b, h_first_roster(), 0.0)
    1

# Half a second between a name arriving and the line being written.
#
# A player is announced under the name they are wearing, and for the first
# moment of a first visit that is not the name they chose: the server has to
# say something the instant somebody is let in, and what it has then is
# `player7`. What they actually asked to be called is a message of their own,
# sent as soon as their socket opens and arriving a round trip later — so the
# valley used to read "player7 joined" and then quietly rename them to `xmas`
# in the roster, with the log left saying the wrong thing for ever.
#
# The roster and the tag can correct themselves because they are drawn from
# what is true this frame. A line in a log cannot: it is a record of a moment.
# So the moment is allowed to settle first.
# In seconds, because that is what this whole file counts in: `wire_tick`
# divides the page's milliseconds by a thousand before anything here sees
# them, and the log's own timestamps are on the same clock. Written as 500
# once, which is not half a second but eight minutes, and read as "nobody
# ever joined" — a wait long enough to look like a missing feature.
fn hello_wait() = 0.5

fn maybe_hello(b, h, id, now) =
  if id == to_int(peek_f32(b, h_id())) then 0
  else if told_has(b, id) then 0
  else if name_len(b, id) == 0 then 0
  # Whoever was already here when this browser walked in is not news. Written
  # down at once and never said — and before the wait below, because that
  # wait is about a name settling and these names settled long ago.
  else if peek_f32(b, h_first_roster()) > 0.5 then mark_told(b, id)
  else if now - first_named(b, id, now) < hello_wait() then 0
  else say_hello(b, h, id, now)

fn mark_told(b, id) =
  n = to_int(peek_f32(b, h_told_n()))
  if n >= 64 then 0
  else
    poke_f32(b, told_at() + n, to_float(id))
    poke_f32(b, h_told_n(), to_float(n + 1))
    1

fn say_hello(b, h, id, now) =
  if mark_told(b, id) == 0 then 0
  else
    crier_line(b, h, id, " joined", false, now)
    sl = hud.log_push_start(h, false, now)
    add_name(b, h, sl, id, 1)
    hud.slot_add(h, sl, 2, " joined")
    1

# When this id was first seen with a name on it, remembered the first time it
# is asked. A table rather than a single clock because two people can walk in
# together, and the second one's half second is their own.
fn first_named(b, id, now) = fn_go(b, id, now, 0)

fn fn_go(b, id, now, i) =
  if i >= wait_cap() then now
  else if to_int(peek_f32(b, waited_at() + i * 2)) == id + 1 then peek_f32(b, waited_at() + i * 2 + 1)
  else if peek_f32(b, waited_at() + i * 2) < 0.5 then fn_put(b, id, now, i)
  else fn_go(b, id, now, i + 1)

# One higher than the id it stands for: nought is a player — the first one to
# walk into an empty valley — and it is also what an empty slot holds.
fn fn_put(b, id, now, i) =
  poke_f32(b, waited_at() + i * 2, to_float(id + 1))
  poke_f32(b, waited_at() + i * 2 + 1, now)
  now

fn told_has(b, id) = th_go(b, id, 0)

fn th_go(b, id, i) =
  if i >= to_int(peek_f32(b, h_told_n())) then false
  else if to_int(peek_f32(b, told_at() + i)) == id then true
  else th_go(b, id, i + 1)

fn sweep_told(b, h, sn, n, now) =
  st_go(b, h, sn, n, now, 0)

fn st_go(b, h, sn, n, now, i) =
  if i >= to_int(peek_f32(b, h_told_n())) then 0
  else
    id = to_int(peek_f32(b, told_at() + i))
    if in_snap(b, sn, n, id) then st_go(b, h, sn, n, now, i + 1)
    else
      crier_line(b, h, id, " left", true, now)
      sl = hud.log_push_start(h, false, now)
      add_name(b, h, sl, id, 3)
      hud.slot_add(h, sl, 3, " left")
      drop_told(b, i)
      st_go(b, h, sn, n, now, i)

fn in_snap(b, sn, n, id) = is_go(b, sn, n, id, 0)

fn is_go(b, sn, n, id, i) =
  if i >= n then false
  else if to_int(peek_f32(b, sn + 12 + i * 16)) == id then true
  else is_go(b, sn, n, id, i + 1)

fn drop_told(b, i) =
  n = to_int(peek_f32(b, h_told_n()))
  poke_f32(b, told_at() + i, peek_f32(b, told_at() + n - 1))
  poke_f32(b, h_told_n(), to_float(n - 1))
  1

fn crier_line(b, h, id, what, out, now) =
  sl = hud.sl_crier()
  m = hud.slot_meta(sl)
  poke_f32(h, m, 0.0)
  add_name(b, h, sl, id, if out then 2 else 1)
  hud.slot_add(h, sl, if out then 3 else 0, what)
  poke_f32(h, hud.h_crier_at(), now)
  poke_f32(h, hud.h_crier_out(), if out then 1.0 else 0.0)
  1

# ---- the HUD's rows ---------------------------------------------------------
#
# The roster, the board and the tags, straight out of the snapshot — what the
# page used to assemble from three exported views of the same list.

fn hud_rows(b, h, now) =
  if peek_f32(b, h_have()) < 0.5 then 0
  else
    roster_rows(b, h)
    board_rows(b, h)
    tag_rows(b, h)
    1

fn roster_rows(b, h) =
  sn = last_snap(b)
  n = to_int(peek_f32(b, sn + 9))
  rows = if n > 16 then 16 else n

  for i in 0..rows
    roster_row(b, h, sn + 12 + i * 16, hud.sl_roster0() + i, i)

  poke_f32(h, hud.h_roster_n(), to_float(rows))

fn roster_row(b, h, p, sl, i) =
  id = to_int(peek_f32(b, p))
  m = hud.slot_meta(sl)
  poke_f32(h, m, 0.0)
  add_name(b, h, sl, id, 0)
  scratch_hue(b, id)
  hp = peek_f32(b, p + 6)
  poke_f32(h, m + 1, peek_f32(b, 56))
  poke_f32(h, m + 2, peek_f32(b, 57))
  poke_f32(h, m + 3, peek_f32(b, 58))
  poke_f32(h, m + 4, if id == to_int(peek_f32(b, h_id())) then 0.0 - max(hp, 0.001) else hp)
  poke_f32(h, m + 5, peek_f32(b, p + 9))
  poke_f32(h, m + 6, peek_f32(b, p + 10))
  poke_f32(h, m + 7, if hp <= 0.001 then 1.0 else 0.0)
  1

# The hue again, into the header's scratch corner this time — the roster's
# meta wants three floats and `hue` writes to the interp layout.
fn scratch_hue(b, id) =
  hh = fract(to_float(id) * 0.61803398875) * 6.0
  poke_f32(b, 56, hsv_f(5.0, hh, 0.75, 0.9))
  poke_f32(b, 57, hsv_f(3.0, hh, 0.75, 0.9))
  poke_f32(b, 58, hsv_f(1.0, hh, 0.75, 0.9))

# Most kills first, then fewest deaths, then whoever arrived first. Sixteen
# rows picked by selection each time the board is up — it is up twenty
# seconds every ten minutes, and n is at most thirty-two.
fn board_rows(b, h) =
  sn = last_snap(b)
  if peek_f32(b, sn + 7) < 0.5 then poke_f32(h, hud.h_board_n(), 0.0)
  else
    n = to_int(peek_f32(b, sn + 9))
    rows = if n > 16 then 16 else n

    for i in 0..rows
      board_row(b, h, sn, n, i)

    poke_f32(h, hud.h_board_n(), to_float(rows))

fn board_row(b, h, sn, n, rank) =
  p = pick_rank(b, sn, n, rank)
  if p < 0 then 0
  else
    id = to_int(peek_f32(b, p))
    sl = hud.sl_board0() + rank
    m = hud.slot_meta(sl)
    poke_f32(h, m, 0.0)
    add_name(b, h, sl, id, 0)
    poke_f32(h, m + 1, peek_f32(b, p + 13))
    poke_f32(h, m + 2, peek_f32(b, p + 14))
    poke_f32(h, m + 3, if id == to_int(peek_f32(b, h_id())) then 1.0 else 0.0)
    1

# The row with rank `r`: better than exactly r others, by kills then deaths
# then id — computed by counting rather than sorting in place, because the
# snapshot is read-only here.
fn pick_rank(b, sn, n, r) = prk_go(b, sn, n, r, 0)

fn prk_go(b, sn, n, r, i) =
  if i >= n then 0 - 1
  else
    p = sn + 12 + i * 16
    if rank_of(b, sn, n, p, i) == r then p else prk_go(b, sn, n, r, i + 1)

fn rank_of(b, sn, n, p, self0) = ro_go(b, sn, n, p, self0, 0, 0)

fn ro_go(b, sn, n, p, self0, i, better) =
  if i >= n then better
  else if i == self0 then ro_go(b, sn, n, p, self0, i + 1, better)
  else
    q = sn + 12 + i * 16
    ahead = beats(b, q, p)
    ro_go(b, sn, n, p, self0, i + 1, if ahead then better + 1 else better)

fn beats(b, q, p) =
  qk = peek_f32(b, q + 13)
  pk = peek_f32(b, p + 13)
  if qk > pk then true
  else if qk < pk then false
  else
    qd = peek_f32(b, q + 14)
    pd = peek_f32(b, p + 14)
    if qd < pd then true
    else if qd > pd then false
    else peek_f32(b, q) < peek_f32(b, p)

# The tags ride the interpolated positions, so a name is over the head the
# figure is actually drawn at.
fn tag_rows(b, h) =
  n = to_int(peek_f32(b, h_interp_n()))
  rows = if n > 16 then 16 else n

  for i in 0..rows
    tag_row(b, h, interp_at() + i * 12, hud.sl_tag0() + i)

  poke_f32(h, hud.h_tag_n(), to_float(rows))

# A name over a head, unless that head has gone down.
#
# Crouching is the one thing in this valley that is *for* not being seen, and
# a name floating over a bush is the loudest thing on the screen — brighter
# than the body it belongs to and readable at ninety metres, which is further
# than the figure itself is legible. So the tag goes with the posture: slot
# seven of the interpolated row is what the server says they are doing, and
# three is down on one knee.
#
# It hides the name and nothing else. The body is still drawn, still lit, and
# still shot at — this is cover, not invisibility.
fn crouching(b, o) = to_int(peek_f32(b, o + 7)) == 3

fn tag_row(b, h, o, sl) =
  id = to_int(peek_f32(b, o))
  m = hud.slot_meta(sl)
  poke_f32(h, m, 0.0)
  n = if crouching(b, o) then 0 else name_len(b, id)
  if n == 0 then 0
  else
    add_name(b, h, sl, id, 0)
    poke_f32(h, m + 1, peek_f32(b, o + 1))
    poke_f32(h, m + 2, peek_f32(b, o + 2))
    poke_f32(h, m + 3, peek_f32(b, o + 3))
    poke_f32(h, m + 4, peek_f32(b, o + 6))
    1

# ---- what goes out ----------------------------------------------------------

fn out_input(b, keys, yaw, pitch) =
  poke_i8(b, out_at(), 105)
  poke_i8(b, out_at() + 1, bit_and(keys, 255))
  poke_i8(b, out_at() + 2, bit_and(shr(keys, 8), 255))
  out_f32(b, out_at() + 3, yaw)
  out_f32(b, out_at() + 7, pitch)
  11

# The tools ask with one byte: everything the server needs — where this player
# stands, where they look — it already has.
fn out_mine(b) =
  poke_i8(b, out_at(), 77)
  1

fn out_build(b) =
  poke_i8(b, out_at(), 78)
  1

fn out_fire(b, dx, dy, dz) =
  poke_i8(b, out_at(), 102)
  out_f32(b, out_at() + 1, dx)
  out_f32(b, out_at() + 5, dy)
  out_f32(b, out_at() + 9, dz)
  13

fn out_reload(b) =
  poke_i8(b, out_at(), 82)
  1

fn out_ping(b, now) =
  poke_i8(b, out_at(), 112)
  poke_f64(b, 30, now)

  for i in 0..8
    poke_i8(b, out_at() + 1 + i, peek_u8(b, 240 + i))
  9

# The page put the text at OUT+1 already; this stamps the letter in front.
fn out_text(b, op, len) =
  poke_i8(b, out_at(), op)
  len + 1

fn out_f32(b, at, v) =
  poke_f32(b, 63, v)

  for i in 0..4
    poke_i8(b, at + i, peek_u8(b, 252 + i))
  0

# Replays what a fresh world has to be told — a tier change rebuilds the
# valley mid-round, and the crystals shot before it have to stay shot.
fn replay(b, w) =
  pull_again(b, w)
  n = to_int(peek_f32(b, h_gone_n()))

  for i in 0..n
    v.put_gone(w, to_int(peek_f32(b, gone_at() + i)))

  if peek_f32(b, h_have()) > 0.5 then
    v.set_world_time(w, peek_f32(b, last_snap(b) + 1))
    v.set_match(w, to_int(peek_f32(b, last_snap(b) + 7)), peek_f32(b, last_snap(b) + 8))
    1
  else
    v.set_world_time(w, peek_f32(b, h_clock0()))
    1


# How many stood in the last snapshot — the corner's "N people in the valley".
fn here(b) =
  if peek_f32(b, h_have()) < 0.5 then 0 else to_int(peek_f32(b, last_snap(b) + 9))

# ---- who else is carrying a light ------------------------------------------
#
# The six lamp slots the shaders read, filled from the interpolated rows this
# file already builds. It was in host.js: a filter, a sort and a loop over the
# same twelve floats, written a second time in another language against
# offsets it had to be told. The data is here, so the loop is here.
#
# Six because that is what a light in a shared valley is worth — the beams are
# summed per fragment over the whole world, and a valley of thirty-two people
# would be paying for lights a hundred metres behind them. Nearest first, so
# the ones that are cut are the ones furthest from this eye, which are also
# the ones most likely already past the beam's twenty-six metre reach.
fn lamps_at() = 4832
fn lamp_cap() = 6
fn lamp_floats() = lamp_cap() * 8

# A lamp is at the eye and not at the feet: 1.75 up, the same figure
# `place_player` puts a body's eye at. A beam has to leave somebody's head
# rather than their boots.
fn lamp_high() = 1.75

fn wire_lamps(b: Ptr, s: Ptr) -> Int =
  for i in 0..lamp_floats()
    poke_f32(b, lamps_at() + i, 0.0)
  gather_lamps(b, s, to_int(peek_f32(b, h_interp_n())), 0, 0)

# One pass over everybody, inserting each lit lamp into the six by distance.
# Insertion rather than a sort because the list is six long and the input is
# at most thirty-two: sorting everybody to keep the front of the list is work
# nobody asked for.
fn gather_lamps(b, s, n, i, held) =
  if i >= n then held
  else if lamp_lit(b, interp_at() + i * 12) then
    gather_lamps(b, s, n, i + 1, insert_lamp(b, s, interp_at() + i * 12, held))
  else gather_lamps(b, s, n, i + 1, held)

# Lit and alive. The torch rides the low bit of the row's flag float — see
# `interp_one` — and a light on somebody who has been shot is a light nobody
# is carrying.
fn lamp_lit(b, o) =
  peek_f32(b, o + 6) > 0.001 && to_int(peek_f32(b, o + 8)) % 2 == 1

fn lamp_far(b, s, o) =
  dx = peek_f32(b, o + 1) - peek_f32(s, 16)
  dy = peek_f32(b, o + 2) + lamp_high() - peek_f32(s, 17)
  dz = peek_f32(b, o + 3) - peek_f32(s, 18)
  dx * dx + dy * dy + dz * dz

fn insert_lamp(b, s, o, held) =
  k = lamp_slot(b, s, lamp_far(b, s, o), held, 0)
  if k >= lamp_cap() then held
  else
    shift_lamps(b, if held < lamp_cap() then held else lamp_cap() - 1, k)
    write_lamp(b, o, k)
    if held < lamp_cap() then held + 1 else held

# Where this one belongs: the first slot holding a lamp further off than it is,
# or the end of what is held.
fn lamp_slot(b, s, d, held, k) =
  if k >= held then k
  else if slot_far(b, s, k) > d then k
  else lamp_slot(b, s, d, held, k + 1)

fn slot_far(b, s, k) =
  at = lamps_at() + k * 8
  dx = peek_f32(b, at) - peek_f32(s, 16)
  dy = peek_f32(b, at + 1) - peek_f32(s, 17)
  dz = peek_f32(b, at + 2) - peek_f32(s, 18)
  dx * dx + dy * dy + dz * dz

# Everything from `k` down one slot, last first so nothing is overwritten
# before it has been moved.
fn shift_lamps(b, from, k) =
  if from <= k then 0
  else
    copy_lamp(b, from - 1, from)
    shift_lamps(b, from - 1, k)

fn copy_lamp(b, src, dst) =
  for i in 0..8
    poke_f32(b, lamps_at() + dst * 8 + i, peek_f32(b, lamps_at() + src * 8 + i))
  0

# The slot itself: where the lamp is with `w` saying it is lit, then which way
# it is pointed — their own yaw and pitch, built the way the camera builds
# this player's.
fn write_lamp(b, o, k) =
  at = lamps_at() + k * 8
  yaw = peek_f32(b, o + 4)
  pitch = peek_f32(b, o + 5)
  cp = cos(pitch)
  poke_f32(b, at, peek_f32(b, o + 1))
  poke_f32(b, at + 1, peek_f32(b, o + 2) + lamp_high())
  poke_f32(b, at + 2, peek_f32(b, o + 3))
  poke_f32(b, at + 3, 1.0)
  poke_f32(b, at + 4, sin(yaw) * cp)
  poke_f32(b, at + 5, sin(pitch))
  poke_f32(b, at + 6, 0.0 - cos(yaw) * cp)
  poke_f32(b, at + 7, 0.0)
  0

extern fn sin(x: Float) -> Float

extern fn cos(x: Float) -> Float

