# Asking for a fresh magazine by hand, and every reason the valley says no.
#
# The refusals are the whole of this feature — the change itself is the one the
# empty magazine has always done — so they are what is checked.
import "valley" as v

fn step(w, s, n) = if n == 0 then 0 else step_one(w, s, n)

fn step_one(w, s, n) =
  v.walk(s, 0.05, 0.0, 0.0, 0)
  v.step_world(w, 0.05)
  step(w, s, n - 1)

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn state(s) =
  "rounds " + int_to_str(v.ak_rounds(s)) + ", spare " + int_to_str(v.ak_mags(s))

fn main() =
  w = v.init(48, 200, 120, 200)
  s = v.join(w)
  step(w, s, 2)
  println("the AK, straight out of the box: " + state(s))

  # A full magazine has nothing to change.
  say("asking with a full magazine", v.ask_reload(s), 0)

  # Fire a few, then ask. Rounds go, a spare comes off the belt, and the
  # magazine is full again.
  v.set_look(s, 0.0, 0.0 - 1.45)
  spend(w, s, 5)
  println("after five rounds: " + state(s))
  mags0 = v.ak_mags(s)
  say("asking with rounds gone", v.ask_reload(s), 1)
  println("  now: " + state(s))
  say("  it is full again", v.ak_rounds(s), v.ak_full())
  say("  and a spare went", v.ak_mags(s), mags0 - 1)

  # And not twice: the change is running, and the fire clock says so.
  say("asking again inside the change", v.ask_reload(s), 0)

  # Once it is over, a full magazine is still nothing to change.
  step(w, s, 40)
  say("asking after it, still full", v.ask_reload(s), 0)

  # The wrong weapon in the hands.
  spend(w, s, 3)
  v.set_weapon(s, 0)
  say("asking with the rifle up", v.ask_reload(s), 0)
  v.set_weapon(s, 2)

  # Down. Nobody reloads on the ground.
  h = v.health(s)
  v.set_health(s, 0.0)
  say("asking while down", v.ask_reload(s), 0)
  v.set_health(s, h)

  # And with nothing left on the belt.
  drain(w, s, 8)
  println("belt emptied: " + state(s))
  say("asking with no spare", v.ask_reload(s), 0)

fn spend(w, s, n) = if n == 0 then 0 else spend_one(w, s, n)

fn spend_one(w, s, n) =
  v.want_fire(s, 0.0, 0.0 - 0.9927, 0.0 - 0.1205)
  v.try_fire(s, v.world_time(w), 0.55)
  step(w, s, 4)
  spend(w, s, n - 1)

# Empty the belt: fire the magazine dry and let the next pull take a spare,
# over and over, until there is nothing left to take.
fn drain(w, s, n) = if n == 0 then 0 else drain_one(w, s, n)

fn drain_one(w, s, n) =
  spend(w, s, 31)
  step(w, s, 40)
  drain(w, s, n - 1)
