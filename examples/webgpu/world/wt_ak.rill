# The AK: the default arm, thirty rounds, automatic at one round per tick,
# and a bullet at a third of the rifle's muzzle speed.
import "valley" as v

fn run_ticks(w, s, n) =
  if n == 0 then 0 else run_tick(w, s, n)

fn run_tick(w, s, n) =
  v.want_fire(s, 0.0, 0.0, 0.0 - 1.0)
  v.try_fire(s, v.world_time(w), 0.55)
  v.step_world(w, 0.05)
  run_ticks(w, s, n - 1)

fn main() =
  w = v.init(48, 400, 300, 900)
  s = v.join(w)
  println("default weapon: " + int_to_str(v.weapon(s)) + " (want 2, the AK), magazine " + int_to_str(v.ak_rounds(s)) + " of " + int_to_str(v.ak_full()))
  v.set_look(s, 0.0, 0.0)
  run_ticks(w, s, 20)
  fired = v.ak_full() - v.ak_rounds(s)
  println("one second of held trigger: " + int_to_str(fired) + " rounds gone (want ~19-20), rifle still " + int_to_str(v.rounds(s)))
  b = v.bullets(w)
  vx = peek_f32(b, 3)
  vz = peek_f32(b, 5)
  println("muzzle speed " + float_to_str(sqrt(vx * vx + vz * vz)) + " (want 40 = a third of 120)")
  run_ticks(w, s, 40)
  println("after the magazine: " + int_to_str(v.ak_rounds(s)) + " left, held ammo says " + int_to_str(v.held_ammo(s)))
  crystal_test()

# What the rounds are worth: a crystal takes one rifle round or five of the
# AK's, and a body hit lands at a third.
fn crystal_test() =
  w = v.init(48, 400, 300, 900)
  s = v.join(w)
  cb = peek_ptr(w, 66)
  cx = peek_f32(cb, 0)
  cy = peek_f32(cb, 1)
  cz = peek_f32(cb, 2)
  sc = peek_f32(cb, 3)
  poke_f32(s, 21, cx - 3.0)
  poke_f32(s, 22, cy)
  poke_f32(s, 23, cz)
  poke_f32(s, 16, cx - 3.0)
  poke_f32(s, 17, cy + sc * 0.75)
  poke_f32(s, 18, cz)
  v.set_look(s, 1.5708, 0.0)
  b0 = v.breaks(s)
  shots = pump(w, s, cb, 0, b0, 0)
  println("the AK against crystal 0: broke after " + int_to_str(shots) + " rounds (want 5)")
  println("  debug: scale " + float_to_str(sc) + ", wear " + float_to_str(peek_f32(peek_ptr(w, 123), 0)) + ", ak left " + int_to_str(v.ak_rounds(s)) + ", crystal now " + float_to_str(peek_f32(cb, 3)))
  v.set_weapon(s, 0)
  cx1 = peek_f32(cb, 8)
  0

fn pump(w, s, cb, n, b0, guard) =
  if v.breaks(s) > b0 then n else if guard > 40 then 0 - 1 else pump_one(w, s, cb, n, b0, guard)

fn pump_one(w, s, cb, n, b0, guard) =
  v.want_fire(s, 1.0, 0.0, 0.0)
  v.try_fire(s, v.world_time(w), 0.55)
  v.step_world(w, 0.05)
  v.step_world(w, 0.05)
  v.step_world(w, 0.05)
  pump(w, s, cb, n + 1, b0, guard + 1)
