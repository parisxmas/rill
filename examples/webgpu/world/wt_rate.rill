# Does the server spend a belt at the same rate the player does?
#
# It did not, and the way it failed is worth keeping a file for, because the
# arithmetic that broke it is the arithmetic of every automatic weapon this
# valley will ever have.
#
# The server ticks every fifty milliseconds. The MG3's gap is fifty
# milliseconds. So a player firing exactly on rate sends one shot per tick and
# has no margin whatsoever — and the server took at most one ask per tick and
# then snapped its own clock to the tick it took it on. Two messages arriving
# in one window and none in the next is not a fault, it is what a network
# does; and every time it happened the server kept a round the player had
# already spent. The counts drift apart, the page eventually obeys the server
# because that is what `ammo_agrees` is for, and what the player sees is the
# magazine filling itself up while they hold the trigger down.
#
# What is asserted here is the property rather than the mechanism: over a
# belt's worth of firing, the server ends up within a round or two of the
# client whatever the messages did on the way.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

# One tick of a server: `n` shot messages arrived since the last one, and then
# the tick runs. Time advances by the tick, not by the shot.
fn tick(s, t, n) =
  ask(s, n)
  v.try_fire(s, t, 0.35)
  1

fn ask(s, n) =
  if n <= 0 then 0
  else
    # Straight down the way they are looking: `faces` refuses a shot that
    # disagrees with the look by more than a flick, which is the check that
    # makes a fire message worth anything at all.
    v.want_fire(s, 0.0, 0.0, 0.0 - 1.0)
    ask(s, n - 1)

# A run of ticks, with `pattern` deciding how many messages each one saw.
# Jitter is not random here: it is the worst honest case, alternating two and
# none, which is one message per tick on average and the shape that broke it.
fn jitter(s, i, n, t0) =
  if i >= n then 1
  else
    tick(s, t0 + to_float(i) * 0.05, if i % 2 == 0 then 2 else 0)
    jitter(s, i + 1, n, t0)

fn steady(s, i, n, t0) =
  if i >= n then 1
  else
    tick(s, t0 + to_float(i) * 0.05, 1)
    steady(s, i + 1, n, t0)

fn main() =
  w = v.init(32, 4, 4, 4)
  s = v.join(w)
  v.set_weapon(s, 5)
  v.set_look(s, 0.0, 0.0)

  println("on rate, with the messages evenly spaced")
  poke_f32(s, 252, 75.0)
  poke_f32(s, 52, 0.0 - 100.0)
  steady(s, 0, 40, 100.0)
  say("forty ticks, forty rounds", 75 - v.mg_rounds(s), 40)

  println("on rate, with the messages arriving in pairs")
  # The same forty shots, delivered two at a time on every other tick. The
  # player fired forty; the server must spend forty. It spent twenty.
  poke_f32(s, 252, 75.0)
  poke_f32(s, 52, 0.0 - 100.0)
  jitter(s, 0, 40, 200.0)
  say("forty asks, forty rounds", 75 - v.mg_rounds(s), 40)

  println("and no more than that")
  # The other half of the gate, which is the half that is not about fairness:
  # a client that sends a hundred messages in one tick gets what the gap
  # allows and no more. Three is `ask_cap`, and it is the ceiling on a burst.
  poke_f32(s, 252, 75.0)
  poke_f32(s, 52, 0.0 - 100.0)
  ask(s, 100)
  v.try_fire(s, 300.0, 0.35)
  say("a hundred asks in one tick spend two", 75 - v.mg_rounds(s), 2)

  # And a quiet minute does not become a burst: the credit is floored at the
  # same three, so holding fire buys nothing that holding the trigger would
  # not have bought anyway.
  poke_f32(s, 252, 75.0)
  poke_f32(s, 52, 300.0)
  ask(s, 100)
  v.try_fire(s, 360.0, 0.35)
  say("nor does a minute of silence", 75 - v.mg_rounds(s), 2)

  println("the AK is unchanged")
  # Two ticks to its gap, so it had the margin all along — and it must still
  # be held to its own rate rather than to the MG3's.
  #
  # Its clock starts at the first tick rather than a long way behind it: a
  # weapon that has not been fired for a while is owed the burst `ask_cap`
  # allows, and this stage is about the rate that is left once that is spent.
  v.set_weapon(s, 2)
  poke_f32(s, 106, 30.0)
  # One gap behind the first tick, so the first tick is a shot: starting level
  # with it costs the first one and the answer comes out nine, which is a true
  # number about the wrong question.
  poke_f32(s, 52, 400.0 - 0.10)
  steady(s, 0, 20, 400.0)
  say("twenty ticks of asks, ten rounds", 30 - v.ak_rounds(s), 10)

  # And the burst it is owed, counted on its own: three, the same ceiling the
  # MG3 has, because the ceiling is about how far behind a connection may fall
  # rather than about which gun fell behind.
  poke_f32(s, 106, 30.0)
  poke_f32(s, 52, 0.0 - 100.0)
  ask(s, 9)
  v.try_fire(s, 500.0, 0.35)
  say("and after a long quiet, two at once", 30 - v.ak_rounds(s), 2)
  println("done")
