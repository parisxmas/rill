# The second rocket, in every way a player actually fires it at a wall that
# has already been hit once: at the same spot, at the settled stub under the
# hole, and at the standing stone beside it. Prints where each blast went off
# and what it took, because "the wall did not break" has three different
# causes and they need telling apart.
import "valley" as v

fn absf(x) = if x < 0.0 then 0.0 - x else x

fn fire_at(w, x, y, z, fx, fy, fz) =
  fb = v.fireballs(w)
  k = to_int(peek_f32(w, 63))
  at = k % 24 * 9
  d = sqrt((x - fx) * (x - fx) + (y - fy) * (y - fy) + (z - fz) * (z - fz))
  poke_f32(fb, at, fx)
  poke_f32(fb, at + 1, fy)
  poke_f32(fb, at + 2, fz)
  poke_f32(fb, at + 3, (x - fx) / d * 70.0)
  poke_f32(fb, at + 4, (y - fy) / d * 70.0)
  poke_f32(fb, at + 5, (z - fz) / d * 70.0)
  poke_f32(fb, at + 6, 0.0 - 1.5)
  poke_f32(fb, at + 7, 6.0)
  poke_f32(fb, at + 8, 0.0)
  poke_f32(w, 63, to_float(k + 1))
  1

fn run_ticks(w, n) =
  if n == 0 then 0 else run_tick(w, n)

fn run_tick(w, n) =
  v.step_world(w, 0.05)
  run_ticks(w, n - 1)

fn last_blast(w, tag, before) =
  bb = peek_ptr(w, 81)
  at = (to_int(peek_f32(w, 80)) - 1) % 8 * 8
  println(tag + ": blast at " + float_to_str(peek_f32(bb, at)) + " " + float_to_str(peek_f32(bb, at + 1)) + " " + float_to_str(peek_f32(bb, at + 2)) + ", " + int_to_str(v.blocks_gone(w) - before) + " stones gone")
  0

fn main() =
  w = v.init(48, 400, 300, 900)
  bb = v.blocks_ptr(w)
  i = 4 * 8 + 4
  bx = peek_f32(bb, i * 8)
  by = peek_f32(bb, i * 8 + 1)
  bz = peek_f32(bb, i * 8 + 2)
  g = v.height(bx, bz)
  println("target: column 4 course 4 at " + float_to_str(bx) + " " + float_to_str(by) + " " + float_to_str(bz) + ", ground " + float_to_str(g))

  # The first rocket, from eight metres, flat at mid-height.
  fire_at(w, bx, by, bz, bx - 8.0, by, bz)
  run_ticks(w, 12)
  n1 = v.blocks_gone(w)
  last_blast(w, "first", 0)

  # The second, aimed exactly where the first was — what a player does.
  fire_at(w, bx, by, bz, bx - 8.0, by, bz)
  run_ticks(w, 12)
  n2 = v.blocks_gone(w)
  last_blast(w, "second, same aim", n1)

  # At the settled stub under the hole: the tallest stone still standing in
  # the target column, wherever settling put it.
  j = tallest(w, bb, 4 * 8, 0, 0 - 1)
  if j >= 0 then aim_stub(w, bb, j, n2) else all_gone()
  0

fn all_gone() =
  println("the whole column is gone")
  0

fn tallest(w, bb, base, k, best) =
  if k >= 8 then best
  else if v.block_broken(w, base + k) > 0 then tallest(w, bb, base, k + 1, best)
  else tallest(w, bb, base, k + 1, base + k)

fn aim_stub(w, bb, j, before) =
  sx = peek_f32(bb, j * 8)
  sy = peek_f32(bb, j * 8 + 1)
  sz = peek_f32(bb, j * 8 + 2)
  println("stub: stone " + int_to_str(j) + " stands at height " + float_to_str(sy))
  fire_at(w, sx, sy, sz, sx - 8.0, sy + 0.5, sz)
  run_ticks(w, 12)
  last_blast(w, "third, at the stub", before)
  0
