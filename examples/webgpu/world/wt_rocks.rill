# A native run for the boulders: that they are where rock is, that they lie
# in outcrops rather than evenly, and that walking into one stops you.
#
# The placement is a hash and nothing else, so a server and every browser grow
# the same rockfall from the same seed without any of them saying a word about
# it — which is the same bargain the pines were placed under and the reason
# none of this is on the wire. What this file is really pinning is that the
# bargain still holds when the rule gets clever: a cluster is two hashes deep
# rather than one, and two hashes are twice the chance of a stray sine.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn at(b, i, k) = peek_f32(b, i * 8 + k)

# How many of them stand on ground the terrain itself draws as stone.
fn on_stone(b, i, n, acc) =
  if i >= n then acc
  else on_stone(b, i + 1, n, acc + if v.stony(at(b, i, 0), at(b, i, 2)) then 1 else 0)

# The nearest other boulder to this one, in centimetres. An outcrop is a thing
# whose members are close together; scattered stones are not.
fn nearest(b, i, j, n, best) =
  if j >= n then best
  else if j == i then nearest(b, i, j + 1, n, best)
  else
    dx = at(b, i, 0) - at(b, j, 0)
    dz = at(b, i, 2) - at(b, j, 2)
    d = sqrt(dx * dx + dz * dz)
    nearest(b, i, j + 1, n, if d < best then d else best)

fn close_ones(b, i, n, acc) =
  if i >= n then acc
  else close_ones(b, i + 1, n, acc + if nearest(b, i, 0, n, 1000.0) < 6.0 then 1 else 0)

# Which of the two meshes a stone is comes out of its own angle now, hashed
# in the shader — the three slots it used to ride in carry the ground's
# colour. So what this file can check is the angles: a run of them that all
# land on the same side of the hash is a run that draws one shape.
fn seconds(b, i, n, acc) =
  if i >= n then acc
  else seconds(b, i + 1, n, acc + if spun(at(b, i, 4)) < 0.5 then 1 else 0)

# The shader's own hash, kept in step by hand: `spin(rot, 4.0)` in rock.wgsl.
fn spun(rot) =
  x = sin(rot * 12.9898 + 4.0 * 78.233) * 43758.5453
  x - floor(x)

fn main() =
  w = v.init(48, 20, 20, 20)
  s = v.join(w)
  b = v.rocks(s)
  n = v.rock_count(s)

  println("the outcrops")
  say("there are boulders", if n > 24 then 1 else 0, 1)
  say("and not more than the cap", if n <= v.rock_cap() then 1 else 0, 1)
  # Every one of them, not most of them: the ground is tested twice on the way
  # in — once for the cluster and once for the stone — and the second test is
  # the one that keeps a cluster from spilling its edge into the meadow.
  say("every one of them is on stone", on_stone(b, 0, n, 0), n)
  # All but a handful. A cluster is dropped onto the grey and its stones are
  # kept one at a time, so an outcrop that straddles the edge of a rock face
  # can lose every member but one — and a single boulder lying on a slope is
  # a thing that happens to valleys. What this catches is the failure that
  # matters: a rule that has stopped clustering at all and gone back to
  # sprinkling stones evenly over the map.
  say("all but a few have a neighbour within six metres",
      if n - close_ones(b, 0, n, 0) <= 4 then 1 else 0, 1)

  println("no two alike")
  # A run of stones all the same size or all the same shape is a run that came
  # from a hash that is not varying, which is a bug this file can see and a
  # screenshot cannot.
  say("both meshes are asked for", if seconds(b, 0, n, 0) > 4 && seconds(b, 0, n, 0) < n - 4 then 1 else 0, 1)
  say("the sizes differ", if at(b, 0, 3) != at(b, 1, 3) then 1 else 0, 1)
  say("and none is inside out", if at(b, 0, 3) > 0.0 && at(b, 1, 3) > 0.0 then 1 else 0, 1)
  # Every stone carries the colour of the ground it is lying on, which is what
  # keeps it in the same light as its surroundings — see `emit_rock`. A zero
  # here would be a boulder painted black.
  say("each carries a ground colour", darkest(b, 0, n, 1), 1)

  println("solid, and which kind of solid")
  # A boulder is two things at two heights, and which one you meet depends on
  # how big it is. The small ones are a kerb — you walk up onto them without
  # thinking about it. The big ones are a wall until you are over the top.
  #
  # Both cases matter and they are one rule with one number in it, so both are
  # asserted. Handed to `collide_all` and nothing else — which is what the
  # first draft did — every boulder was a wall at every height, including the
  # height of somebody standing on top of one, and none of them could be
  # climbed at all.
  small = smallest(b, 0, n, 0)
  sx = at(b, small, 0)
  sz = at(b, small, 2)
  stop = at(b, small, 1) + v.rock_tall(at(b, small, 3))
  poke_f32(s, 21, sx + 0.05)
  poke_f32(s, 23, sz)
  poke_f32(s, 22, v.ground(sx, sz))
  poke_f32(s, 24, 0.0)
  land(s, 20)
  say("a low one is walked up onto, in cm",
      to_int((v.player_y(s) - stop) * 100.0 + 0.5), 0)

  big = biggest(b, 0, n, 0)
  bx0 = at(b, big, 0)
  bz0 = at(b, big, 2)
  poke_f32(s, 21, bx0 + 0.05)
  poke_f32(s, 23, bz0)
  poke_f32(s, 22, v.ground(bx0, bz0))
  poke_f32(s, 24, 0.0)
  land(s, 20)
  ex = v.player_x(s) - bx0
  ez = v.player_z(s) - bz0
  say("a tall one has to be climbed, not walked through",
      if sqrt(ex * ex + ez * ez) > 0.5 then 1 else 0, 1)
  # And the number that decides between them is a step, not a wall: the
  # tallest boulder in the valley must still be jumpable, or an outcrop is a
  # fence.
  say("and its top is within a jump",
      if v.rock_tall(at(b, big, 3)) < 1.6 then 1 else 0, 1)

  println("and standable")
  # Dropped onto the middle of a boulder from just over it: the feet stop on
  # its top rather than falling through to the hillside underneath.
  #
  # This is what a boulder was missing at first. It was handed to
  # `collide_all` and nothing else, which is a wall at every height including
  # the height of somebody standing on top — so the push came before the jump
  # could land and the top could not be reached at all.
  bx = at(b, 0, 0)
  bz = at(b, 0, 2)
  top = at(b, 0, 1) + v.rock_tall(at(b, 0, 3))
  poke_f32(s, 21, bx)
  poke_f32(s, 23, bz)
  poke_f32(s, 22, top + 0.4)
  poke_f32(s, 24, 0.0)
  land(s, 40)
  say("dropped on one, the feet stop on its top, in cm",
      to_int((v.player_y(s) - top) * 100.0 + 0.5), 0)
  say("and it counts as standing", to_int(v.grounded(s)), 1)
  # And from up there the ground is the stone, not the hill: a boulder that
  # let you stand on it but reported the hillside underneath would be a boulder
  # you sank into the moment you tried to walk off it.
  say("which is above the hillside under it",
      if top > v.ground(bx, bz) - 0.05 then 1 else 0, 1)

  println("nothing on a slope too steep to hold it")
  # The other half of where a stone may lie. Grey ground is not enough: a face
  # at fifty degrees has nothing resting on it, and a boulder drawn there is a
  # boulder glued to a wall.
  say("none of them is on ground too steep to hold one",
      steepest(b, 0, n, 0), 0)
  # And the other half of what changed: a stone may lie in the meadow now.
  # The rule used to keep them to ground the terrain draws grey, which put
  # every one of them on the steepest slopes in the valley — the one place
  # they look stuck on rather than come to rest.
  say("and some of them are down in the green", if greens(b, 0, n, 0) > 3 then 1 else 0, 1)
  println("done")

fn land(s, n) =
  if n == 0 then 1
  else
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
    land(s, n - 1)

fn darkest(b, i, n, acc) =
  if i >= n then acc
  else darkest(b, i + 1, n, if at(b, i, 5) + at(b, i, 6) + at(b, i, 7) > 0.2 then acc else 0)

# Green ground is the one band whose green beats both its neighbours.
fn greens(b, i, n, acc) =
  if i >= n then acc
  else greens(b, i + 1, n,
    acc + if at(b, i, 6) > at(b, i, 5) && at(b, i, 6) > at(b, i, 7) then 1 else 0)

fn steepest(b, i, n, acc) =
  if i >= n then acc
  else steepest(b, i + 1, n,
    acc + if v.rock_tilt(at(b, i, 0), at(b, i, 2)) >= v.rock_steep() then 1 else 0)

fn smallest(b, i, n, best) =
  if i >= n then best
  else smallest(b, i + 1, n, if at(b, i, 3) < at(b, best, 3) then i else best)

fn biggest(b, i, n, best) =
  if i >= n then best
  else biggest(b, i + 1, n, if at(b, i, 3) > at(b, best, 3) then i else best)
