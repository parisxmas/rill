# A wt-style churn run: three hundred players who join, hear the door
# sequence, and leave at once — one after another, so what is measured from
# outside is the cost of an arrival and a departure and nothing else. A leak
# per connection shows as RSS climbing in a straight line against this count.
import "ws"

fn port() = 8092

fn churn_count() = 300

fn header_rest(fd, buf) =
  at = str_find(buf, "\r\n\r\n")
  if at < 0 then grow_header(fd, buf) else str_sub(buf, at + 4, str_len(buf) - at - 4)

fn grow_header(fd, buf) =
  more = fill(fd, buf, str_len(buf) + 1)
  if str_len(more) == str_len(buf) then "" else header_rest(fd, more)

fn one(i) = match connect_to("127.0.0.1", port())
  Err(e) ->
    println("churn " + int_to_str(i) + " failed: " + e)
    0
  Ok(fd) -> pass_through(i, fd)

fn pass_through(i, fd) =
  sock_write(fd, ws_handshake_request("127.0.0.1", "/?p=135"))
  acc = header_rest(fd, fill(fd, "", 4))
  (h, a2) = ws_take(fd, acc)
  ok = if str_len(h) > 0 && str_get(h, 0) == 104 then 1 else 0
  ws_close(fd)
  ok

fn churn(i, ok) =
  if i >= churn_count() then ok else churn(i + 1, ok + one(i))

fn main() =
  n = churn(0, 0)
  println(int_to_str(n) + " of " + int_to_str(churn_count()) + " walked in and out")
