# The shared valley, without a browser and without a socket.
#
# `server.rill` is the network and `world.rill` is the browser, and neither can
# be run by a test suite — one holds a port for ever and the other needs a GPU.
# What is left in the middle is the part that actually decides anything, and
# this is that part: several people in one valley, walking, shooting each other
# and leaving, checked by running it.
import "valley" as v

extern fn sqrt(x: Float) -> Float

extern fn atan2(y: Float, x: Float) -> Float

fn tick(w, n) = if n == 0 then 0 else tick_one(w, n)

fn tick_one(w, n) =
  walk_all(w)
  v.step_world(w, 0.05)
  pick_all(w)
  tick(w, n - 1)

fn walk_all(w) =
  for i in 0..v.players(w)
    v.walk(v.player_block(w, i), 0.05, 0.0, 0.0, v.keys_of(v.player_block(w, i)))

fn pick_all(w) =
  for i in 0..v.players(w)
    v.pick_up(v.player_block(w, i))

fn place(s, x, z) = v.set_at(s, x, v.ground(x, z), z)

# Rounded to the metre. What is being checked is that a walk went somewhere
# and that standing still did not, and the sixth decimal place of that is a
# different machine's floating point rather than a fact about the valley.
fn where_is(name, s) =
  println(name + " is at " + int_to_str(to_int(v.player_x(s))) + ", " + int_to_str(to_int(v.player_z(s))) + " on " + float_to_str(v.health(s)))

fn absf(x) = if x < 0.0 then 0.0 - x else x

# Where somebody came in, to the metre, and how far the ground there is above
# the water.
fn where_in(name, s) =
  println("  " + name + " came in at " + int_to_str(to_int(v.player_x(s))) + ", " + int_to_str(to_int(v.player_z(s))) + ", on ground " + int_to_str(to_int(v.ground(v.player_x(s), v.player_z(s)) * 10.0)) + " decimetres up")

# Whether the camera is level. Slot 4 of the view-projection is zero for as
# long as it is — the across direction has no height of its own — so anything
# in it is the roll a round put there, and that is a fact about the matrix
# rather than about anybody's floating point.
fn tilt(s) =
  v.look(s, 1.6)
  if absf(peek_f32(s, 4)) < 0.001 then "level" else "thrown"

# How high the eye is above their own feet, which is where the camera went
# when they did: `look` writes it, so this reads it after `tilt` has looked.
fn eye(s) = float_to_str(peek_f32(s, 17) - v.player_y(s))

# Up or down. Not the health to four decimal places: the valley is still going
# on around them and a crater somewhere can take a thousandth off somebody who
# has just stood up, which is true and is not what this line is asking.
fn upright(s) = if v.health(s) > 0.5 then "on their feet" else "down"

# One player turns to the other and fires at a height on them, once, and the
# round is given long enough to get there. `up` is metres above their feet:
# half a metre is a leg, one is the body, one and six tenths is the head.
# The same shot with the shooter looking the other way, which the server
# should refuse.
# What one player is told about another depends on whether there is a line
# between them. Two standing together can see each other; the same two with a
# hundred metres and whatever the terrain does in between usually cannot, and
# the point of the test is that the answer is the terrain's and not a constant.
fn sightlines(w, a, b) =
  place(a, 0.0, 0.0)
  place(b, 3.0, 0.0)
  println("three metres apart on the same ground: " + yes(v.can_see(a, b)) + ", and the other way " + yes(v.can_see(b, a)))
  place(b, 40.0, 0.0)
  near = v.can_see(a, b)
  place(b, 120.0, 40.0)
  far = v.can_see(a, b)
  println("forty metres away: " + yes(near) + "; a hundred and thirty: " + yes(far))
  println("across the valley, " + int_to_str(counted(w, a, b, 0, 0)) + " of 16 places are in sight of the middle")

# Sixteen points around the valley, asked one at a time. A number rather than a
# list of yes and no: what matters is that it is neither nought nor sixteen —
# terrain that hid everybody would be a valley nobody could play in, and
# terrain that hid nobody would be this whole defence doing nothing.
fn counted(w, a, b, i, acc) =
  if i >= 16 then acc else counted(w, a, b, i + 1, acc + at_ring(w, a, b, i))

fn at_ring(w, a, b, i) =
  ang = to_float(i) * 0.3927
  place(a, 0.0, 0.0)
  place(b, cos(ang) * 70.0, sin(ang) * 70.0)
  v.can_see(a, b)

fn yes(n) = if n == 1 then "yes" else "no"

fn shoot_blind(w, a, b) =
  dx = v.player_x(b) - v.player_x(a)
  dy = v.player_y(b) + 1.05 - (v.player_y(a) + 1.75)
  dz = v.player_z(b) - v.player_z(a)
  l = sqrt(dx * dx + dy * dy + dz * dz)
  v.set_look(a, atan2(dx, 0.0 - dz) + 3.14159, 0.0)
  v.want_fire(a, dx / l, dy / l, dz / l)
  v.try_fire(a, v.world_time(w), 0.55)
  tick(w, 12)
  println("  with the shooter looking away, they are still on " + float_to_str(v.health(b)))
  println("  and after one of those the server does not want them gone yet: " + int_to_str(v.shooting_wild(a)))

# A browser running our client cannot send a run of these, so a run of them is
# how the server tells that something else is on the other end of the socket.
fn shoot_blind_again(w, a, b, n) =
  for i in 0..n
    blind_once(w, a, b)

  println("  after " + int_to_str(n + 1) + " of them, drop this connection: " + int_to_str(v.shooting_wild(a)))

fn blind_once(w, a, b) =
  dx = v.player_x(b) - v.player_x(a)
  dz = v.player_z(b) - v.player_z(a)
  l = sqrt(dx * dx + dz * dz)
  v.want_fire(a, dx / l, 0.0, dz / l)
  0

# And one honest shot puts the count back where it started: the streak is what
# is being counted, because the honest number of these is zero.
fn shoot_straight_again(w, a, b) =
  dx = v.player_x(b) - v.player_x(a)
  dy = v.player_y(b) + 1.05 - (v.player_y(a) + 1.75)
  dz = v.player_z(b) - v.player_z(a)
  l = sqrt(dx * dx + dy * dy + dz * dz)
  v.set_look(a, atan2(dx, 0.0 - dz), atan2(dy, sqrt(dx * dx + dz * dz)))
  v.want_fire(a, dx / l, dy / l, dz / l)
  println("  one honest shot and they are welcome again: " + int_to_str(v.shooting_wild(a)))

fn shoot_at(w, a, b, up) = shoot_at_over(w, a, b, up, 12)

# The same shot, stepped a stated number of ticks rather than the twelve that
# are enough for any lane in this file to land. The one caller that wants
# fewer is the camera: what a hit puts on the head is a spring that is spent
# inside half a second, and twelve ticks reads the very tail of it — it passed
# by five thousandths of a radian, and the day the spawn moved a few metres it
# stopped passing while the throw itself was exactly as it had always been.
fn shoot_at_over(w, a, b, up, n) =
  # The bolt rifle, whatever the spawn handed out: these lanes were measured
  # with a 120 m/s round, and the AK's forty would land in a different tick.
  v.set_weapon(a, 0)
  dx = v.player_x(b) - v.player_x(a)
  dy = v.player_y(b) + up - (v.player_y(a) + 1.75)
  dz = v.player_z(b) - v.player_z(a)
  l = sqrt(dx * dx + dy * dy + dz * dz)
  # Look where the shot is going first: the server refuses a round that is not
  # roughly where its owner says they are pointed, which is what stops a client
  # shooting behind itself.
  v.set_look(a, atan2(dx, 0.0 - dz), atan2(dy, sqrt(dx * dx + dz * dz)))
  # The way a round is actually asked for: the direction is offered, and the
  # server decides at the tick whether it may be taken — which is where the
  # bolt, the water and the shooter's own aim are checked.
  v.want_fire(a, dx / l, dy / l, dz / l)
  v.try_fire(a, v.world_time(w), 0.55)
  tick(w, n)
  println("  they are on " + float_to_str(v.health(b)) + ", the shooter still on " + float_to_str(v.health(a)))

# One round, fired at a point, and stepped the way a client steps — far enough
# to have reached ten metres and no further.
fn aim_at(s, x, y, z) =
  dx = x - v.player_x(s)
  dy = y - (v.player_y(s) + 1.75)
  dz = z - v.player_z(s)
  l = sqrt(dx * dx + dy * dy + dz * dz)
  v.fire(s, dx / l, dy / l, dz / l)

fn drift(w, n) = if n == 0 then 0 else drifted(w, n)

fn drifted(w, n) =
  v.step_visuals(w, 0.01)
  drift(w, n - 1)

fn alive(w) =
  drift(w, 10)
  if v.bullet_f(w, v.shots(w) - 1, 7) > 0.001 then "still flying" else "stopped"

# A server's tick, near enough: everybody walks, the world moves, everybody
# picks up, and whoever has been down long enough gets up.
fn serve(w, n) = if n == 0 then 0 else served(w, n)

fn served(w, n) =
  walk_all(w)
  v.step_world(w, 0.05)
  pick_all(w)
  v.rise_all(w)
  serve(w, n - 1)

# The walls are taken down before anybody shoots. This file checks what people
# do to each other — walking, shooting, falling, leaving — and the shots are
# staged along fixed lanes. Where the twelve Ls happen to stand is a placement
# decision that has moved twice already and will move again, and the day one of
# them stood across a lane, every expectation below it changed for a reason
# that had nothing to do with people. The walls have their own tests, with
# rockets, in `wt`-style native runs; here the range is cleared.
fn clear_walls(w) =
  bb = v.blocks_ptr(w)

  for i in 0..v.block_count(w)
    poke_f32(bb, i * 8 + 3, 0.0)

fn main() =
  w = v.init(48, 400, 300, 900)
  clear_walls(w)
  println(int_to_str(v.crystal_count(w)) + " crystals and " + int_to_str(v.pine_count(w)) + " pines, nobody in it yet: " + int_to_str(v.players(w)))

  a = v.join(w)
  b = v.join(w)
  c = v.join(w)
  println("three arrive: " + int_to_str(v.players(w)) + ", with ids " + int_to_str(v.player_id(a)) + " " + int_to_str(v.player_id(b)) + " " + int_to_str(v.player_id(c)))

  # Nobody chose these: they are a hash of who arrived and when. What is being
  # checked is that they are not the same spot and that none of them is in the
  # lake, which is the only thing a spawn has to get right.
  where_in("the first", a)
  where_in("the second", b)
  where_in("the third", c)

  # Somewhere flat and away from the lake, twelve metres apart.
  place(a, 0.0 - 40.0, 0.0 - 40.0)
  place(b, 0.0 - 28.0, 0.0 - 40.0)
  place(c, 0.0 - 34.0, 0.0 - 52.0)
  tick(w, 4)
  where_is("the first", a)

  # Walking is the server's: the keys are set, and the tick moves whoever
  # holds them. The third one walks and the other two stand.
  v.set_keys(c, 1)
  tick(w, 40)
  where_is("the third", c)

  println("the first shoots the second in the leg, the body and the head:")
  shoot_at(w, a, b, 0.45)
  shoot_at(w, a, b, 1.05)
  shoot_at(w, a, b, 1.62)
  println("  the first has landed " + int_to_str(v.hits_given(a)) + " and taken " + int_to_str(v.hits_taken(a)))
  println("  the second has landed " + int_to_str(v.hits_given(b)) + " and taken " + int_to_str(v.hits_taken(b)))

  # Down, and put back on their feet at the spawn with the valley as it is.
  v.respawn(b)
  println("after a respawn they are on " + float_to_str(v.health(b)))

  # And a round that does not go where its owner says they are looking is
  # refused. This is the whole of what the server can do about aiming: it
  # cannot tell a good shot from a scripted one, but it can insist that
  # whoever takes it has turned to take it, which is the part everybody else
  # can see.
  shoot_blind(w, a, b)
  shoot_blind_again(w, a, b, 11)
  shoot_straight_again(w, a, b)

  # Being shot throws the head about. The throw goes on the camera and not on
  # the yaw and pitch, so the way to see it is the matrix rather than the look.
  before = tilt(b)
  shoot_at_over(w, a, b, 1.05, 6)
  hit = tilt(b)
  tick(w, 14)
  println("the camera was " + before + ", then " + hit + ", and " + tilt(b) + " again")

  # A round stops at somebody a client can only see. On a client there are no
  # player blocks but this browser's own, so the world is told where the
  # figures are being drawn and the rounds stop there — `step_visuals` is the
  # client's step, the one that moves everything and decides nothing.
  gx = v.player_x(a) + 10.0
  gz = v.player_z(a)
  gy = v.ground(gx, gz)
  aim_at(a, gx, gy + 0.95, gz)
  println("with nobody drawn there, the round is " + alive(w) + " ten metres on")
  v.set_ghosts(w, 1)
  v.set_ghost(w, 0, gx, gy, gz)
  aim_at(a, gx, gy + 0.95, gz)
  println("with somebody drawn there, it is " + alive(w) + " at the same point")

  # Down, and up again five seconds later — and not before. The camera goes
  # over with them, which is the matrix again rather than anybody's word.
  shoot_at(w, a, b, 1.62)
  println("shot down: " + upright(b) + ", camera " + tilt(b) + ", eye at " + eye(b))
  serve(w, 120)
  println("six seconds later: " + upright(b) + ", camera " + tilt(b) + ", eye at " + eye(b))
  serve(w, 100)
  println("eleven seconds later: " + upright(b) + ", camera " + tilt(b) + ", eye at " + eye(b))

  v.leave(w, b)
  sightlines(w, a, b)
  println("one leaves: " + int_to_str(v.players(w)) + " remain, ids " + int_to_str(v.player_id(v.player_block(w, 0))) + " " + int_to_str(v.player_id(v.player_block(w, 1))))

  tick(w, 20)
  v.free_world(w)
  println("the valley is put away")
