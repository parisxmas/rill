export fn match_phase(w: Ptr) -> Int = v.match_phase(w)

export fn set_match(w: Ptr, phase: Int, left: Float) -> Int = v.set_match(w, phase, left)

export fn set_match_len(w: Ptr, secs: Int, report: Int) -> Int = v.set_match_len(w, secs, report)

export fn kills(s: Ptr) -> Int = v.kills(s)

export fn deaths(s: Ptr) -> Int = v.deaths(s)

export fn blocks_gone(w: Ptr) -> Int = v.blocks_gone(w)

# The pines a warhead has taken: how many, which, and the applying of one.
export fn pines_down(w: Ptr) -> Int = v.pines_down(w)

export fn fell_which(w: Ptr, k: Int) -> Int = v.fell_which(w, k)

export fn put_fell(w: Ptr, i: Int) -> Int = v.put_fell(w, i)

export fn pine_felled(w: Ptr, i: Int) -> Int = v.pine_felled(w, i)

export fn block_broken(w: Ptr, i: Int) -> Int = v.block_broken(w, i)

export fn block_which(w: Ptr, k: Int) -> Int = v.block_which(w, k)

export fn drop_block(w: Ptr, i: Int) -> Int = v.drop_block(w, i)

export fn wading(s: Ptr) -> Int = v.wading(s)

export fn respawn(s: Ptr) = v.respawn(s)

# What a page on its own stirs into where it puts this player. See `place_player`
# in valley.rill: with no server and no clock the seed was the same every run.
export fn spawn_salt(s: Ptr, v0: Float) = v.spawn_salt(s, v0)

export fn restart(s: Ptr) = v.restart(s)

# Whether the far crystals throw. On in a valley this browser built for itself;
# a server decides for a shared one.
export fn set_meteors(w: Ptr, on: Int) = v.set_meteors(w, on)

export fn meteors_on(w: Ptr) -> Int = v.meteors_on(w)

# ---- the HUD ----------------------------------------------------------------
#
# The display list lives in hud.rill and knows nothing about the valley; this
# is the glue that copies the live numbers into its header each frame and
# hands the page the offsets it draws from. The page's own share — the atlas,
# the pushed strings — goes straight into the block through `hud_ptr`.

export fn hud_init(s: Ptr) -> Ptr =
  h = hud.make()
  poke_ptr(s, 95, h)
  h

export fn hud_ptr(s: Ptr) -> Ptr = peek_ptr(s, 95)

export fn hud_inst_at() -> Int = hud.inst_at()

export fn hud_inst_cap() -> Int = hud.inst_cap()

export fn hud_met_at() -> Int = hud.met_at()

export fn hud_meta_at() -> Int = hud.meta_at()

export fn hud_bytes_at() -> Int = hud.bytes_at()

export fn hud_slot_bytes() -> Int = hud.slot_bytes()

export fn hud_strips() -> Int = hud.strips()

export fn hud_strip_size(s: Ptr, i: Int) -> Float = hud.strip_size(peek_ptr(s, 95), i)

export fn hud_strip_weight(s: Ptr, i: Int) -> Float = hud.strip_weight(peek_ptr(s, 95), i)

# The theme, one float at a time, indexed from its base — colours and layout
# both. What the numbers mean is written at the top of hud.rill; the point of
# the export is that they can be changed without touching it.
export fn hud_theme(s: Ptr, i: Int) -> Float = peek_f32(peek_ptr(s, 95), 256 + i)

export fn set_hud_theme(s: Ptr, i: Int, v: Float) =
  poke_f32(peek_ptr(s, 95), 256 + i, v)
  1

# One frame: the live numbers into the header, the tags through the view
# matrix, then the layout. Returns how many instances to draw.
export fn hud_frame(s: Ptr, w: Ptr) -> Int =
  h = peek_ptr(s, 95)
  if is_null(h) then 0
  else
    poke_f32(h, hud.h_health(), v.health(s))
    poke_f32(h, hud.h_breath(), v.breath(s))
    poke_f32(h, hud.h_spent(), to_float(v.winded(s)))
    held = v.weapon(s)
    poke_f32(h, hud.h_weapon(), to_float(held))
    poke_f32(h, hud.h_rounds(), to_float(if held == 2 then v.ak_rounds(s) else v.rounds(s)))
    poke_f32(h, hud.h_mag_cap(), to_float(if held == 2 then v.ak_full() else v.mag_full()))
    poke_f32(h, hud.h_ak_mags(), to_float(v.ak_mags(s)))
    poke_f32(h, hud.h_rockets(), to_float(v.rockets(s)))
    poke_f32(h, hud.h_phase(), to_float(v.match_phase(w)))
    poke_f32(h, hud.h_left(), v.match_left(w))
    poke_f32(h, hud.h_board_left(), v.match_left(w))
    poke_f32(h, hud.h_down_for(), v.down_for(s))
    poke_f32(h, hud.h_dead_secs(), v.dead_secs())
    project_tags(s, h)
    hud.build(h)

# Each tag's world position — pushed by the page into the slot's meta — through
# the same view-projection the valley was just drawn with, so a name sits over
# a head by the engine's own arithmetic. Behind the eye becomes an x no screen
# has, which is what the layout tests for.
fn project_tags(s, h) =
  n = to_int(peek_f32(h, hud.h_tag_n()))

  for i in 0..n
    project_tag(s, h, hud.slot_meta(hud.sl_tag0() + i))

fn project_tag(s, h, m) =
  x = peek_f32(h, m + 1)
  y = peek_f32(h, m + 2) + peek_f32(h, hud.t_at(hud.s_tag_rise()))
  z = peek_f32(h, m + 3)
  cw = peek_f32(s, 3) * x + peek_f32(s, 7) * y + peek_f32(s, 11) * z + peek_f32(s, 15)
  if cw <= 0.05 then
    poke_f32(h, m + 1, 0.0 - 99999.0)
    1
  else
    cx = peek_f32(s, 0) * x + peek_f32(s, 4) * y + peek_f32(s, 8) * z + peek_f32(s, 12)
    cy = peek_f32(s, 1) * x + peek_f32(s, 5) * y + peek_f32(s, 9) * z + peek_f32(s, 13)
    dx = x - peek_f32(s, 16)
    dy = y - peek_f32(s, 17)
    dz = z - peek_f32(s, 18)
    poke_f32(h, m + 1, (cx / cw * 0.5 + 0.5) * peek_f32(h, hud.h_sw()))
    poke_f32(h, m + 2, (1.0 - (cy / cw * 0.5 + 0.5)) * peek_f32(h, hud.h_sh()))
    poke_f32(h, m + 3, sqrt(dx * dx + dy * dy + dz * dz))
    1

extern fn sqrt(x: Float) -> Float

# ---- the wire ---------------------------------------------------------------
#
# The client's whole share of the protocol lives in wire.rill; these are the
# page's handles on it. The page's job is reduced to a socket: copy the bytes
# of each inbound frame to `wire_in`, call `wire_frame`; read the outbound
# builders' bytes back off `wire_out` and send them. The header field indices
# the page reads directly are wire.rill's h_* constants, mirrored once in
# host.js as `WH`.

export fn wire_new() -> Ptr = wire.make()

export fn wire_in(b: Ptr) -> Int = wire.in_at()

export fn wire_in_cap() -> Int = wire.in_cap()

export fn wire_out(b: Ptr) -> Int = wire.out_at()

export fn wire_interp_at() -> Int = wire.interp_at()

export fn wire_pev_at() -> Int = wire.pev_at()

export fn wire_token_at() -> Int = wire.token_at()

export fn wire_refuse_at() -> Int = wire.refuse_at()

export fn wire_frame(b: Ptr, len: Int, now: Float) =
  poke_f32(b, 60, now)
  if peek_u8(b, wire.in_at()) == 112 then took_pong(b, now) else wire.frame(b, len)

fn took_pong(b, now) =
  wire.pong(b)
  wire.pong_took(b, now)

# One tick: drain what arrived into the world, square this player with the
# newest snapshot, interpolate everybody, and fill the HUD's rows. Returns how
# many interpolated players the figure renderer should draw.
export fn wire_tick(b: Ptr, w: Ptr, s: Ptr, now: Float, hold: Int) -> Int =
  poke_f32(b, 60, now)
  wire.tick(b, w, s, peek_ptr(s, 95), now / 1000.0, hold)

# A fresh world mid-round — a tier rebuild — told everything the old one knew.
export fn wire_replay(b: Ptr, w: Ptr) = wire.replay(b, w)

export fn wire_here(b: Ptr) -> Int = wire.here(b)

export fn wire_out_input(b: Ptr, keys: Int, yaw: Float, pitch: Float) -> Int =
  wire.out_input(b, keys, yaw, pitch)

export fn wire_out_fire(b: Ptr, dx: Float, dy: Float, dz: Float) -> Int =
  wire.out_fire(b, dx, dy, dz)

export fn wire_out_reload(b: Ptr) -> Int = wire.out_reload(b)

export fn wire_out_ping(b: Ptr, now: Float) -> Int = wire.out_ping(b, now)

# The page wrote the text at OUT+1; this stamps the letter and says how long
# the frame is.
export fn wire_out_text(b: Ptr, op: Int, len: Int) -> Int = wire.out_text(b, op, len)

# ---- the hands --------------------------------------------------------------
#
# The input-to-trigger machine — hand.rill. The page pushes each frame's raw
# inputs and reads back the adjusted mouse, the uniform values and the sound
# cues, all at fixed indices in the hand block (mirrored once in host.js as
# `HAND`).

export fn hand_init(s: Ptr) -> Ptr = hand.make(s)

export fn hand_ptr(s: Ptr) -> Ptr = peek_ptr(s, 96)

export fn hand_frame(s: Ptr, dt: Float, now: Float, t: Float, mdx: Float, mdy: Float, flags: Int, want: Int) -> Int =
  hand.frame(s, dt, now, t, mdx, mdy, flags, want)

# ---- the skinner ------------------------------------------------------------
#
# The figures' animation — skin.rill. The page parses figure.mesh, pushes the
# rig and the clips into the block once, and uploads three regions per frame;
# every quaternion and every joint matrix is the engine's.

export fn skin_init(s: Ptr) -> Ptr = skin.make(s)

export fn skin_ptr(s: Ptr) -> Ptr = peek_ptr(s, 97)

export fn skin_frame(s: Ptr, wb: Ptr, now: Float) -> Int = skin.frame(s, wb, now)

export fn skin_fired(s: Ptr, id: Int, now: Float) = skin.fired(peek_ptr(s, 97), id, now)

export fn skin_inst_at() -> Int = skin.t_inst()

export fn skin_held_at() -> Int = skin.t_held()

export fn skin_out_at() -> Int = skin.t_out()

export fn skin_pool_at() -> Int = skin.pool()

export fn skin_clip_at(c: Int) -> Int = skin.t_clip(c)

export fn skin_grip_at() -> Int = skin.t_grip()

export fn skin_parent_at() -> Int = skin.t_parent()

export fn skin_upper_at() -> Int = skin.t_upper()

export fn skin_bindt_at() -> Int = skin.t_bindt()

export fn skin_inv_at() -> Int = skin.t_inv()

# ---- the ears ---------------------------------------------------------------
#
# The audio decisions — ears.rill. Each frame the engine watches the world's
# counters, places every event against the listener, and leaves a ring of
# fully decided cues plus three roar-voice targets; the page's whole part is
# a buffer per kind and a play call per cue.

export fn ears_init(s: Ptr) -> Ptr = ears.make(s)

export fn ears_frame(s: Ptr, wb: Ptr, now: Float) -> Int = ears.frame(s, wb, now)

export fn ears_hush(s: Ptr) = ears.hush(s)

export fn ears_cues_at() -> Int = ears.t_cues()

export fn ears_roar_at() -> Int = ears.t_roar()

# Called once when the module is instantiated, and there is nothing to set up:
# the valley is built when the host has measured the machine and knows how much
# of it to ask for.
fn main() = println("world ready")
