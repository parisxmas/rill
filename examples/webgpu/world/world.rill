export fn fires_down(w: Ptr) -> Int = v.fires_down(w)

export fn down_which(w: Ptr, k: Int) -> Int = v.down_which(w, k)

export fn down_fire(w: Ptr, i: Int) -> Int = v.down_fire(w, i)

