# The browser's names for the valley.
#
# `valley.rill` is the world; this file is the wall between it and `host.js` —
# fifty-six functions wasm can call, each of them the same call one module
# in. It is separate because an export is a wasm idea: the server compiles the
# same valley for a machine that has no such thing, and a compiler that let
# `export` through on a native target would be promising something it could
# not deliver.
#
# The host holds two pointers. `init` hands back the world — the terrain, the
# crystals, the rounds in the air, the shark — and `join` hands back a player
# in it. Everything except building and freeing the valley is asked of the
# player, because a player block knows which world it is in and these follow
# that pointer.
import "valley" as v
import "hud" as hud
import "wire" as wire
import "hand" as hand
import "skin" as skin
import "ears" as ears
import "pak" as pak

# ---- the valley, and who is in it ------------------------------------------

export fn init(grid: Int, npine: Int, ncrys: Int, ngrass: Int) -> Ptr =
  v.init(grid, npine, ncrys, ngrass)

export fn free_world(s: Ptr) = v.free_world(s)

export fn join(w: Ptr) -> Ptr = v.join(w)

export fn leave(w: Ptr, s: Ptr) = v.leave(w, s)

export fn player_id(s: Ptr) -> Int = v.player_id(s)

export fn players(w: Ptr) -> Int = v.players(w)

export fn player_block(w: Ptr, i: Int) -> Ptr = v.player_block(w, i)

# ---- what the renderer reads -----------------------------------------------

export fn terrain(s: Ptr) -> Ptr = v.terrain(s)

export fn terrain_verts(s: Ptr) -> Int = v.terrain_verts(s)

export fn pines(s: Ptr) -> Ptr = v.pines(s)

export fn pine_count(s: Ptr) -> Int = v.pine_count(s)

# The poplars along the water. No count of their own arrives from anywhere:
# it is a third of the pines, worked out on both sides of the wire from the
# one number that does.
export fn poplars(s: Ptr) -> Ptr = v.poplars(s)

export fn poplar_count(s: Ptr) -> Int = v.poplar_count(s)

# The flowers, in patches on the open ground. They collide with nothing and
# nothing collides with them: this is a buffer to draw and no more than that.
export fn flowers(s: Ptr) -> Ptr = v.flowers(s)

export fn flower_count(s: Ptr) -> Int = v.flower_count(s)

# The boulders, in outcrops on the stony slopes. Placed at init from the same
# hash on both ends, so nothing about them is ever sent — and unlike the
# flowers, they are solid: `collide_all` is given them too.
export fn rocks(s: Ptr) -> Ptr = v.rocks(s)

export fn rock_count(s: Ptr) -> Int = v.rock_count(s)

export fn crystals(s: Ptr) -> Ptr = v.crystals(s)

export fn crystal_count(s: Ptr) -> Int = v.crystal_count(s)

export fn grass(s: Ptr) -> Ptr = v.grass(s)

export fn grass_count(s: Ptr) -> Int = v.grass_count(s)

export fn shards(s: Ptr) -> Ptr = v.shards(s)

export fn shards_cap(s: Ptr) -> Int = v.shards_cap(s)

export fn bullets(s: Ptr) -> Ptr = v.bullets(s)

export fn bullets_cap(s: Ptr) -> Int = v.bullets_cap(s)

export fn fireballs(s: Ptr) -> Ptr = v.fireballs(s)

export fn fireballs_cap(s: Ptr) -> Int = v.fireballs_cap(s)

export fn blasts(s: Ptr) -> Ptr = v.blasts(s)

export fn blasts_cap(s: Ptr) -> Int = v.blasts_cap(s)

# The terrain function itself, for the host to sample: the water mesh carries
# the exact depth under every vertex, so the shore foam sits where the shore
# is rather than where a 32-bit re-derivation guesses it might be.
export fn ground(x: Float, z: Float) -> Float = v.ground(x, z)

# The lakebed's weed and the meadow's fireflies, into a buffer the page owns.
# They were the last two things scattered with `Math.random` in host.js, which
# meant every browser grew a different lakebed on the same lake — see the
# comment above `weed_beds` in valley.rill for why that was worth ending.
export fn weed_build(out: Ptr, cap: Int) -> Int = v.weed_build(out, cap)

export fn weed_cap() -> Int = v.weed_cap()

export fn fly_seed(out: Ptr, n: Int) -> Int = v.fly_seed(out, n)

export fn set_sun(s: Ptr, dx: Float, dy: Float, dz: Float) = v.set_sun(s, dx, dy, dz)

# Where the clock has the sun, and the shadow matrix that follows from it. The
# page used to own the path — the tilt, the phase, the lift, the length of a
# day — and hand the answer back in through `set_sun`, which meant the one
# thing every renderer and every server needs to agree about lived in a file
# only a browser reads. Now it asks.
export fn step_sun(s: Ptr) = v.step_sun(s)

# Which crater is lighting the valley — the youngest still burning, or minus
# one. The rule (how long a burn lasts) lived in host.js beside a copy of the
# ring's stride; the ages are the world's, so the choosing is too.
export fn blast_lit(s: Ptr) -> Int = v.blast_lit(s)

# The stride the weapon rides on: the player's own speed, eased, and a phase
# integrated from it. Stepped once a frame by whoever is drawing, and kept in
# the hand's block — it is the gun's swing, and the gun's block had room where
# the player's did not.
export fn step_bob(s: Ptr, dt: Float) = hand.step_bob(s, dt)

export fn bob_speed(s: Ptr) -> Float = hand.bob_speed(s)

export fn bob_phase(s: Ptr) -> Float = hand.bob_phase(s)

export fn sun_x(w: Ptr) -> Float = v.sun_x(w)
export fn sun_y(w: Ptr) -> Float = v.sun_y(w)
export fn sun_z(w: Ptr) -> Float = v.sun_z(w)

# ---- one step of time ------------------------------------------------------
#
# `frame` is the three of them and a camera, and is what a browser alone in the
# valley calls. A browser in someone else's valley calls `walk` and lets the
# server do the rest.

export fn walk(s: Ptr, dt: Float, mdx: Float, mdy: Float, keys: Int) = v.walk(s, dt, mdx, mdy, keys)

export fn step_world(w: Ptr, dt: Float) = v.step_world(w, dt)

export fn pick_up(s: Ptr) = v.pick_up(s)

# The same, without the healing: in a shared valley health is the server's.
export fn pick_up_quiet(s: Ptr) = v.pick_up_quiet(s)

export fn frame(s: Ptr, dt: Float, mdx: Float, mdy: Float, keys: Int, aspect: Float) =
  v.frame(s, dt, mdx, mdy, keys, aspect)

export fn look(s: Ptr, aspect: Float) = v.look(s, aspect)

# How much the sights magnify. Eased by the page; see .
export fn set_zoom(s: Ptr, z: Float) = v.set_zoom(s, z)

# How long this player has been on the ground, and how long that lasts — the
# page counts the seconds down on screen out of these two.
export fn down_for(s: Ptr) -> Float = v.down_for(s)

export fn dead_secs() -> Float = v.dead_secs()

# Where this browser is drawing the other people, so that a round can stop at
# one. Written every frame from the same interpolated positions the figures
# are drawn at, and read by nothing but the bullet step.
export fn set_ghosts(w: Ptr, n: Int) = v.set_ghosts(w, n)

export fn set_ghost(w: Ptr, i: Int, x: Float, y: Float, z: Float) = v.set_ghost(w, i, x, y, z)

# ---- being told rather than deciding ---------------------------------------
#
# What a browser in somebody else's valley uses. `step_visuals` moves
# everything and decides nothing; the rest is applying what the server worked
# out — where people are, what they are down to, which crystal went, and every
# round, throw and crater as it happens.

export fn step_visuals(w: Ptr, dt: Float) = v.step_visuals(w, dt)

export fn player_x(s: Ptr) -> Float = v.player_x(s)

export fn player_y(s: Ptr) -> Float = v.player_y(s)

export fn player_z(s: Ptr) -> Float = v.player_z(s)

export fn player_yaw(s: Ptr) -> Float = v.player_yaw(s)

export fn player_pitch(s: Ptr) -> Float = v.player_pitch(s)

export fn set_at(s: Ptr, x: Float, y: Float, z: Float) = v.set_at(s, x, y, z)

export fn set_health(s: Ptr, h: Float) = v.set_health(s, h)

export fn world_time(w: Ptr) -> Float = v.world_time(w)

export fn set_world_time(w: Ptr, t: Float) = v.set_world_time(w, t)

export fn set_shark(w: Ptr, x: Float, y: Float, z: Float, hd: Float, mode: Float, gape: Float) =
  v.set_shark(w, x, y, z, hd, mode, gape)

export fn put_bullet(w: Ptr, x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, owner: Float) =
  v.put_bullet(w, x, y, z, vx, vy, vz, owner)

export fn put_fireball(w: Ptr, x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, seed: Float, life: Float) =
  v.put_fireball(w, x, y, z, vx, vy, vz, seed, life)

export fn put_blast(w: Ptr, x: Float, y: Float, z: Float, seed: Float) =
  v.put_blast(w, x, y, z, seed)

export fn put_break(w: Ptr, i: Int) = v.put_break(w, i)

export fn put_gone(w: Ptr, i: Int) = v.put_gone(w, i)

# ---- the rifle, and what it leaves -----------------------------------------
#
# The tally and the last position are how the host learns about a hit at all:
# it happens inside a frame the host only calls.

export fn fire(s: Ptr, dx: Float, dy: Float, dz: Float) = v.fire(s, dx, dy, dz)

export fn breaks(s: Ptr) -> Int = v.breaks(s)

export fn break_x(s: Ptr) -> Float = v.break_x(s)

export fn break_y(s: Ptr) -> Float = v.break_y(s)

export fn break_z(s: Ptr) -> Float = v.break_z(s)

export fn blasts_fired(s: Ptr) -> Int = v.blasts_fired(s)

# ---- how one player is getting on ------------------------------------------

export fn health(s: Ptr) -> Float = v.health(s)

# How much running is left, and whether they are winded — a bar the browser
# draws under the vital one, and the reason the sprint key stops working.
# Somebody coming apart where they fell. The renderer calls this the moment a
# health it is drawing reaches zero, its own or one that arrived.
export fn gib_at(w: Ptr, x: Float, y: Float, z: Float, yaw: Float, id: Int) =
  v.gib_at(w, x, y, z, yaw, id)

# Rounds left in the rifle, and how many one magazine holds — the number on
# the screen, and what it is out of.
export fn rounds(s: Ptr) -> Int = v.rounds(s)

export fn mag_full() -> Int = v.mag_full()

# How many of the shard slots are ammunition boxes rather than chips of
# crystal. The renderer draws the front of that buffer as boxes and the rest as
# prisms, so it has to be told where the line is.
export fn mag_count() -> Int = v.mag_count()

# Which weapon is up, how many rockets are left, and how many the tube holds.
# The browser sets the weapon on the key and the server hears it in the eighth
# bit of the same integer the keys ride in.
export fn weapon(s: Ptr) -> Int = v.weapon(s)

export fn set_weapon(s: Ptr, n: Int) = v.set_weapon(s, n)

export fn rockets(s: Ptr) -> Int = v.rockets(s)

export fn rocket_full() -> Int = v.rocket_full()

# The AK: the default arm, thirty rounds, automatic.
export fn ak_rounds(s: Ptr) -> Int = v.ak_rounds(s)

export fn ak_full() -> Int = v.ak_full()

export fn mg_rounds(s: Ptr) -> Int = v.mg_rounds(s)

export fn took_count(s: Ptr) -> Int = v.took_count(s)

export fn mg_full() -> Int = v.mg_full()

export fn ak_mags(s: Ptr) -> Int = v.ak_mags(s)

# Asking for the magazine to be changed with rounds still in it — the `R` key.
# Answers whether it took, so the browser can leave the key alone when there
# was nothing to do rather than starting an animation for a refusal.
export fn ask_reload(s: Ptr) -> Int = v.ask_reload(s)

# Where the AK's rounds have stopped, for the chips the renderer draws there.
export fn marks(s: Ptr) -> Ptr = v.marks(s)

export fn marks_cap() -> Int = v.marks_cap()

export fn ak_mag_count() -> Int = v.ak_mag_count()

# What the held weapon has left — the snapshot's one ammo number — and the
# writing of it back when the server disagrees.
export fn held_ammo(s: Ptr) -> Int = v.held_ammo(s)

export fn set_held_ammo(s: Ptr, n: Int) = v.set_held_ammo(s, n)

# How many of the boxes are rifle magazines; the rest are rocket crates. The
# renderer draws the two kinds with two meshes over one instance buffer, and
# this is where the ranges split.
export fn mags_only() -> Int = v.mag_only()

# Where the rocket crates stop and the belts begin — the renderer draws each
# kind as its own range of the one instance buffer.
export fn crate_end() -> Int = v.crate_end()

# The crystals' bites: how many, who and which crystal, and the applying of
# one this browser was told about rather than decided.
export fn zaps(w: Ptr) -> Int = v.zaps(w)

export fn zap_who(w: Ptr, k: Int) -> Int = v.zap_who(w, k)

export fn zap_which(w: Ptr, k: Int) -> Int = v.zap_which(w, k)

export fn put_zap(w: Ptr, who: Int, ci: Int) -> Int = v.put_zap(w, who, ci)

# Where a box is, said as a count rather than as a position: box `i` has been
# taken `n` times, and the valley works out the rest. This is what arrives on
# the wire when somebody else picks one up.
export fn set_mag(w: Ptr, i: Int, times: Int) = v.set_mag(w, i, times)

export fn mag_times(w: Ptr, i: Int) -> Int = v.mag_times(w, i)

# And what the server says it is, for the rare frame the two have drifted.
export fn set_rounds(s: Ptr, n: Int) = v.set_rounds(s, n)

export fn breath(s: Ptr) -> Float = v.breath(s)

# ---- the planet, and the pack that fights it -------------------------------
#
# Gravity is the world's, a number and not a constant: everything that falls
# reads it, the legs' jump carries further under a weaker one, and the pack's
# thrust is a multiple of it rather than a figure that happens to beat this
# particular fall.

export fn gravity(w: Ptr) -> Float = v.gravity(w)

export fn set_gravity(w: Ptr, g: Float) = v.set_gravity(w, g)

export fn jet_fuel(s: Ptr) -> Float = v.jet_fuel(s)

# Whether this browser's own double press has armed the pack. The page puts it
# on the wire — see `jet_told` in valley.rill — because a tick cannot see an
# edge that happened between two of them.
export fn jet_armed_now(s: Ptr) -> Int = v.jet_armed_now(s)

# How far down on one knee, nought to one. The page hands it to the weapon in
# the hands; the eye it lowers is `walk`'s own business.
export fn crouch_of(s: Ptr) -> Float = v.crouch_of(s)

# ---- the pickaxe and what it leaves ------------------------------------------
#
# A browser with the valley to itself swings and builds directly; a client in
# somebody else's valley asks, and the `put_*` half is what being told looks
# like. The counters and rings mirror the crystals' pattern exactly.
export fn swing_pick(s: Ptr) -> Int = v.swing_pick(s)

export fn stones_of(s: Ptr) -> Int = v.stones_of(s)

export fn set_stones(s: Ptr, n: Int) = v.set_stones(s, n)

export fn try_build(s: Ptr) -> Int = v.try_build(s)

export fn put_carve(s: Ptr, ci: Int) -> Int = v.put_carve(s, ci)

export fn put_built(s: Ptr, x: Float, y: Float, z: Float, yaw: Float) -> Int = v.put_built(s, x, y, z, yaw)

export fn carves(w: Ptr) -> Int = v.carves(w)

export fn carve_ev(w: Ptr, k: Int) -> Int = v.carve_ev(w, k)

export fn built(w: Ptr) -> Int = v.built(w)

export fn built_ev(w: Ptr, k: Int, j: Int) -> Float = v.built_ev(w, k, j)

export fn blocks_total(w: Ptr) -> Int = v.blocks_total(w)

export fn magmas(w: Ptr) -> Int = v.magmas(w)

export fn magma_x(w: Ptr, k: Int) -> Float = v.magma_x(w, k)

export fn magma_z(w: Ptr, k: Int) -> Float = v.magma_z(w, k)

# The floor with the digging in it, for anything the page stands on the ground.
export fn floor_at(w: Ptr, x: Float, z: Float) -> Float = v.floor_at(w, x, z)

# Rewrites the mesh under whatever carves arrived since the last call; the
# touched cell rect is read back through `dirty_at` (ix0, iz0, ix1, iz1).
export fn rebake(s: Ptr) -> Int = v.rebake(s)

export fn dirty_at(w: Ptr, j: Int) -> Int = v.dirty_at(w, j)

# The tunnels' own geometry: one quad per face of rock with air against it,
# rebuilt whenever the digging has moved and drawn instanced. The height field
# blanks itself wherever these take over.
export fn faces_build(s: Ptr) -> Int = v.faces_build(s)

export fn rock_faces(w: Ptr) -> Int = v.rock_faces(w)

export fn face_buf(w: Ptr) -> Ptr = v.face_buf(w)

export fn face_stride() -> Int = v.face_stride()

# The whole field byte by byte, for the door.


export fn carve_page_at(w: Ptr, sx: Int) -> Int = v.carve_page_at(w, sx)

export fn carve_pages(w: Ptr) -> Int = v.carve_pages(w)

# Whether there is anything molten under this spot, which is a question about
