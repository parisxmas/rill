export fn magma_under(x: Float, z: Float) -> Int = v.yes(v.magma_under(x, z))

export fn carve_supers() -> Int = v.carve_supers()

export fn carve_page_cells() -> Int = v.carve_page_cells()

# The door speaks in columns and their masks now, sixteen bytes a column.
