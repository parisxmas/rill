export fn ap_carve_col_done(w: Ptr, sx: Int, c: Int) = v.ap_carve_col_done(w, sx, c)

# Rock or air at a point, which is the whole of what the world now is.
export fn solid_at(w: Ptr, x: Float, y: Float, z: Float) -> Int = v.solid_at(w, x, y, z)

export fn ground_under(w: Ptr, x: Float, y: Float, z: Float) -> Float = v.ground_under(w, x, y, z)

export fn roof_over(w: Ptr, x: Float, y: Float, z: Float) -> Float = v.roof_over(w, x, y, z)



export fn set_carves(s: Ptr, n: Int) = v.set_carves(s, n)

export fn set_built(s: Ptr, n: Int) = v.set_built(s, n)

# The field over a rebuild: save off the old world before it is freed, load
# into the new one once a player block exists to reach it through.
export fn carve_save(w: Ptr) -> Ptr = v.carve_save(w)

export fn carve_load(s: Ptr, keep: Ptr) = v.carve_load(s, keep)

# Told once by the page when a socket is live: the tools then ask instead of
# acting, and the rings bring back what the server decided.
export fn set_hosted(w: Ptr, n: Int) = v.set_hosted(w, n)

export fn jet_on(s: Ptr) -> Int = v.jet_on(s)

