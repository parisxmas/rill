# The ears, in the engine.
#
# Every sound in the valley used to be decided by the page: it watched the
# world's counters, measured the distance to whatever had happened, and chose
# a gain, a pan and a pitch before it ever touched a buffer. All of that is
# arithmetic about the world, and it moved here for the same reason the HUD
# and the hands did. The page keeps the one thing only it can do — the
# WebAudio graph, the decoded buffers, the music — and each frame it drains a
# little ring of fully decided cues and plays them verbatim.
#
# Two kinds of output:
#
#   - the cue ring: one-shot sounds, each entry already carrying the offset
#     into the sample, the duration, the gain, the pan and the rate. The page
#     maps the kind to a buffer and calls play. Cleared here at the top of
#     every frame, so the page never sees a cue twice.
#
#   - the roar targets: three continuous voices tracking the nearest rounds
#     in the air. Gain, pan and filter frequency per voice, refreshed every
#     frame; the page eases its nodes toward them and nothing else.
#
# The block hangs off the player at ptr slot 98:
#
#   f32  0 cues waiting          4 chimeStep      8 rng counter
#        1 breaks seen           5 chimeAt (s)
#        2 blasts seen           6 chimeSaid
#        3 zaps seen             7 lastHp
#       12..23 roar voices, 3 x [gain, pan, freq, on]
#       24..29 scratch: the three nearest rounds' distance and pan
#       32..  the cue ring, 12 x [kind, offset, dur, gain, pan, rate, 0, 0]
#
# Cue kinds: 1 a crystal breaking, 2 a fireball landing, 3 a crystal's bite,
# 4 a chip picked up, 5 this player hurt over the wire.

import "valley" as v
import "wire" as wire

extern fn sin(x: Float) -> Float
extern fn cos(x: Float) -> Float
extern fn sqrt(x: Float) -> Float
extern fn exp(x: Float) -> Float
extern fn floor(x: Float) -> Float

fn clampf(x, lo, hi) = if x < lo then lo else if x > hi then hi else x

fn maxf(a, c) = if a > c then a else c

fn minf(a, c) = if a < c then a else c

fn fract(x) = x - floor(x)

fn cue_cap() = 12

fn t_cues() = 32

fn t_roar() = 12

# A different number each time it is asked, from a counter and the same
# sine-hash the terrain uses. Audio detune does not need better dice.
fn rnd(e) =
  n = peek_f32(e, 8)
  poke_f32(e, 8, n + 1.0)
  fract(sin((n + 13.7) * 127.1) * 43758.5453)

fn make(s: Ptr) -> Ptr =
  e = alloc_bytes(1024)
  for i in 0..256
    poke_f32(e, i, 0.0)
  # Long before the first frame, so the first chip is always a fresh run.
  poke_f32(e, 5, 0.0 - 9.0)
  # Below any health the world hands out: the first reading is a baseline,
  # not a pickup.
  poke_f32(e, 7, 0.0 - 1.0)
  poke_ptr(s, 98, e)
  e

# A restart hands health back in one jump, and that jump is not a pickup.
# The counters need no such telling — they resync against whatever the reset
# world says — but the health baseline is a judgement, not a mirror.
fn hush(s: Ptr) =
  poke_f32(peek_ptr(s, 98), 7, 0.0 - 1.0)

# ---- where a sound is, from the ear's point of view -------------------------
#
# `near` is the distance at which it is half as loud, which is the only number
# that distinguishes a crystal breaking at your feet from a meteor coming down
# across the valley. The pan is how far round to the side, scaled to 0.8 so
# nothing ever sits entirely in one ear.

fn dist_to(s, x, y, z) =
  dx = x - peek_f32(s, 16)
  dy = y - peek_f32(s, 17)
  dz = z - peek_f32(s, 18)
  sqrt(dx * dx + dy * dy + dz * dz)

fn pan_to(s, x, z, d) =
  dx = x - peek_f32(s, 16)
  dz = z - peek_f32(s, 18)
  yaw = peek_f32(s, 19)
  clampf((cos(yaw) * dx + sin(yaw) * dz) / maxf(d, 0.001), 0.0 - 1.0, 1.0) * 0.8

fn gain_at(d, near) = near / (near + d)

# ---- the cue ring -----------------------------------------------------------

fn emit(e, kind, off, dur, gain, pan, rate) =
  n = to_int(peek_f32(e, 0))
  if n >= cue_cap() then 0
  else
    at = t_cues() + n * 8
    poke_f32(e, at, kind)
    poke_f32(e, at + 1, off)
    poke_f32(e, at + 2, dur)
    poke_f32(e, at + 3, gain)
    poke_f32(e, at + 4, pan)
    poke_f32(e, at + 5, rate)
    poke_f32(e, at + 6, 0.0)
    poke_f32(e, at + 7, 0.0)
    poke_f32(e, 0, to_float(n + 1))
    1

# ---- one frame --------------------------------------------------------------

fn frame(s: Ptr, wb: Ptr, now: Float) =
  e = peek_ptr(s, 98)
  poke_f32(e, 0, 0.0)
  watch_roars(e, s)
  watch_blasts(e, s)
  watch_breaks(e, s)
  watch_zaps(e, s)
  watch_health(e, s, now)
  if is_null(wb) then 0 else watch_wire(e, wb)

# ---- the roar of whatever is in the air -------------------------------------
#
# Nothing at all at the far end, and climbing steeply as it closes: cubed,
# so almost all of the loudness is spent in the last fifteen metres. Silence
# is the whole point of a sound that arrives — you notice a meteor because
# you did not hear it a moment ago. Air swallows the top of a sound before it
# swallows the bottom, so the filter opens as a round gets closer: near ones
# hiss, far ones are only a rumble.

fn roar_reach() = 28.0

# The three nearest, kept sorted in the scratch slots by insertion: each
# flying round either pushes in at its place or falls off the end.
fn consider(e, d, pan) =
  if d < peek_f32(e, 24) then
    poke_f32(e, 26, peek_f32(e, 25))
    poke_f32(e, 29, peek_f32(e, 28))
    poke_f32(e, 25, peek_f32(e, 24))
    poke_f32(e, 28, peek_f32(e, 27))
    poke_f32(e, 24, d)
    poke_f32(e, 27, pan)
    1
  else if d < peek_f32(e, 25) then
    poke_f32(e, 26, peek_f32(e, 25))
    poke_f32(e, 29, peek_f32(e, 28))
    poke_f32(e, 25, d)
    poke_f32(e, 28, pan)
    1
  else if d < peek_f32(e, 26) then
    poke_f32(e, 26, d)
    poke_f32(e, 29, pan)
    1
  else 0

fn weigh(e, s, fb, i) =
  if peek_f32(fb, i * 9 + 7) > 0.0 then
    x = peek_f32(fb, i * 9)
    z = peek_f32(fb, i * 9 + 2)
    d = dist_to(s, x, peek_f32(fb, i * 9 + 1), z)
    consider(e, d, pan_to(s, x, z, d))
  else 0

fn watch_roars(e, s) =
  for k in 0..3
    poke_f32(e, 24 + k, 1000000.0)
    poke_f32(e, 27 + k, 0.0)
  fb = v.fireballs(s)
  for i in 0..v.fireballs_cap(s)
    weigh(e, s, fb, i)
  for k2 in 0..3
    set_roar(e, k2, peek_f32(e, 24 + k2), peek_f32(e, 27 + k2))

fn set_roar(e, k, d, pan) =
  at = t_roar() + k * 4
  if d > 900000.0 then
    poke_f32(e, at, 0.0)
    poke_f32(e, at + 3, 0.0)
  else
    kk = maxf(0.0, 1.0 - d / roar_reach())
    near = kk * kk * kk
    poke_f32(e, at, 0.62 * near)
    poke_f32(e, at + 1, pan)
    poke_f32(e, at + 2, 500.0 + 5200.0 * near)
    poke_f32(e, at + 3, 1.0)

# ---- a fireball landing -----------------------------------------------------
#
# How far an impact carries, and nothing past it: thirty-two metres, which is
# close. At fifty-eight every single impact was audible — a continuous distant
# bombardment with nothing to look at — and cut to thirty-two, about half go
# quiet and the near ones land. Squared falloff inside the cutoff, and slower
# and deeper the further off it is, which is most of what makes a big noise
# sound far away. Not `>`: a tier change rebuilds the world and puts the
# tally back to zero, and a mirror that only ever climbs would go deaf.

fn boom_reach() = 32.0

fn watch_blasts(e, s) =
  nbl = v.blasts_fired(s)
  seen = to_int(peek_f32(e, 2))
  if nbl == seen then 0
  else
    poke_f32(e, 2, to_float(nbl))
    if nbl > seen then boom_newest(e, s, nbl) else 0

fn boom_newest(e, s, nbl) =
  b = v.blasts(s)
  at = (nbl - 1 + v.blasts_cap(s)) % v.blasts_cap(s) * 8
  d = dist_to(s, peek_f32(b, at), peek_f32(b, at + 1), peek_f32(b, at + 2))
  kk = maxf(0.0, 1.0 - d / boom_reach())
  # Past the cutoff there is nothing to hear, and an explosion a hundred
  # metres off would otherwise still cost the page a source playing silence.
  if kk <= 0.02 then 0
  else
    far = minf(d / boom_reach(), 1.0)
    emit(e, 2.0, floor(rnd(e) * 2.0) * 1.9, 1.85, 0.95 * kk * kk,
         pan_to(s, peek_f32(b, at), peek_f32(b, at + 2), d), 1.06 - 0.22 * far)

# ---- a crystal going --------------------------------------------------------
#
# Quieter with distance and set where it happened: which one broke is worth
# hearing when there are three of them in front of you.

fn watch_breaks(e, s) =
  nb = v.breaks(s)
  seen = to_int(peek_f32(e, 1))
  if nb == seen then 0
  else
    poke_f32(e, 1, to_float(nb))
    if nb > seen then shatter(e, s) else 0

fn shatter(e, s) =
  x = v.break_x(s)
  z = v.break_z(s)
  d = dist_to(s, x, v.break_y(s), z)
  emit(e, 1.0, floor(rnd(e) * 3.0), 0.95, 0.75 * gain_at(d, 12.0),
       pan_to(s, x, z, d), 0.94 + rnd(e) * 0.14)

# ---- the crystals' bites ----------------------------------------------------
#
# The counter moves — whether this world decided the bite or was told about
# one — and the sound comes from the ring: which crystal, at its own place.
# The light show stays with the page, which is the one that knows where the
# other players are drawn.

fn watch_zaps(e, s) =
  nz = v.zaps(s)
  seen = to_int(peek_f32(e, 3))
  if nz == seen then 0
  else
    poke_f32(e, 3, to_float(nz))
    zap_from(e, s, if seen > nz - 8 then seen else nz - 8, nz)
    1

fn zap_from(e, s, k0, nz) =
  cb = v.crystals(s)
  for k in k0..nz
    ca = v.zap_which(s, k) * 8
    x = peek_f32(cb, ca)
    z = peek_f32(cb, ca + 2)
    d = dist_to(s, x, peek_f32(cb, ca + 1), z)
    emit(e, 3.0, 0.0, 0.0, 0.15 + 0.8 * gain_at(d, 10.0),
         pan_to(s, x, z, d), 0.96 + rnd(e) * 0.1)

# ---- picking one up ---------------------------------------------------------
#
# A count and not a rate. Two chips are two notes, a semitone apart, which is
# the little rising figure a pickup should be; past two the chips still count,
# they simply stop speaking. A run ends after three quarters of a second with
# nothing picked up, and not before: `chimeAt` is pushed forward on every chip
# whether it is sounded or not, so crossing a long trail is one run of two
# notes rather than two notes every time the trail thins for a frame.

fn chime_most() = 2.0

fn watch_health(e, s, now) =
  hp = v.health(s)
  last = peek_f32(e, 7)
  gap = if hp > last then hp - last else last - hp
  if gap > 0.002 then
    poke_f32(e, 7, hp)
    if hp > last + 0.001 && last >= 0.0 then chime(e, now) else 0
  else 0

fn chime(e, now) =
  fresh = now - peek_f32(e, 5) >= 0.75
  poke_f32(e, 5, now)
  if fresh then
    poke_f32(e, 4, 0.0)
    poke_f32(e, 6, 0.0)
    speak(e)
  else if peek_f32(e, 6) >= chime_most() then 0
  else
    poke_f32(e, 4, minf(peek_f32(e, 4) + 1.0, 7.0))
    speak(e)

# A semitone a step: 2^(step/12), said with the exponential this file has.
fn speak(e) =
  poke_f32(e, 6, peek_f32(e, 6) + 1.0)
  emit(e, 4.0, 0.0, 0.0, 0.23, 0.0, exp(peek_f32(e, 4) * 0.057762265))

# ---- hurt over the wire -----------------------------------------------------
#
# The wire leaves page events; kind 2 is this player struck, with how much.
# Read before the page drains the ring for the skinner's flinch — the page
# clears it after both have looked.

fn watch_wire(e, wb) =
  pn = to_int(peek_f32(wb, wire.h_pev_n()))
  for i in 0..pn
    heed(e, wb, i)
  pn

fn heed(e, wb, i) =
  at = wire.pev_at() + i * 4
  if to_int(peek_f32(wb, at)) == 2 then
    emit(e, 5.0, floor(rnd(e) * 4.0), 0.95,
         0.55 + 0.45 * minf(1.0, peek_f32(wb, at + 1) * 2.0), 0.0,
         0.94 + rnd(e) * 0.12)
  else 0
