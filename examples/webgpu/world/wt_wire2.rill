# A native run for the client wire: synthetic frames pushed into the block
# the way the page pushes socket bytes, and the state they should leave.
import "wire" as wr
import "hud" as hud

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

# Writes one byte of a frame being staged in IN.
fn put(b, i, v) = poke_i8(b, wr.in_at() + i, v)

fn put16(b, i, v) =
  put(b, i, v % 256)
  put(b, i + 1, v / 256)

fn put32(b, i, v) =
  put16(b, i, v % 65536)
  put16(b, i + 2, v / 65536)

fn putf(b, i, v) =
  poke_f32(b, 63, v)
  put(b, i, peek_u8(b, 252))
  put(b, i + 1, peek_u8(b, 253))
  put(b, i + 2, peek_u8(b, 254))
  put(b, i + 3, peek_u8(b, 255))

fn main() =
  b = wr.make()
  poke_f32(b, wr.h_now(), 1000.0)

  # hello: id 7, 400 pines, 300 crystals, 900 grass, clock 12.5, token
  put(b, 0, 104)
  put16(b, 1, 7)
  put32(b, 3, 400)
  put32(b, 7, 300)
  put32(b, 11, 900)
  putf(b, 15, 12.5)
  put(b, 19, 97)
  put(b, 20, 98)
  wr.frame(b, 21)
  say("hello brings my id", to_int(peek_f32(b, wr.h_id())), 7)
  say("and the crystals", to_int(peek_f32(b, wr.h_crystals())), 300)
  say("and two token bytes", to_int(peek_f32(b, wr.h_token_len())), 2)

  # a name: id 9 is called Ada
  put(b, 0, 117)
  put16(b, 1, 9)
  put(b, 3, 65)
  put(b, 4, 100)
  put(b, 5, 97)
  wr.frame(b, 6)
  say("a name lands", wr.name_len(b, 9), 3)

  # the version
  put(b, 0, 118)
  put16(b, 1, 391)
  wr.frame(b, 3)
  say("the version lands", to_int(peek_f32(b, wr.h_ver())), 391)

  # a snapshot: clock 13, shark five zeros, phase 0, left 90, two players —
  # me (7) and Ada (9), Ada seen at (5, 2, 8)
  put(b, 0, 115)
  putf(b, 1, 13.0)

  for i in 0..5
    putf(b, 5 + i * 4, 0.0)

  put(b, 25, 0)
  putf(b, 26, 90.0)
  put(b, 30, 2)
  snap_row(b, 31, 7, 1.0, 2.0, 3.0, 1.0)
  snap_row(b, 68, 9, 5.0, 2.0, 8.0, 1.0)
  wr.frame(b, 105)
  say("two snapshots make one", to_int(peek_f32(b, wr.h_have())), 1)
  say("here counts both", wr.here(b), 2)

  # a said frame queues until a tick; queue depth says one is waiting
  put(b, 0, 67)
  put16(b, 1, 9)
  put(b, 3, 104)
  put(b, 4, 105)
  wr.frame(b, 5)
  say("chat waits in the queue", if to_int(peek_f32(b, wr.h_evw())) > 0 then 1 else 0, 1)

  # interpolation puts Ada where the only snapshot has her
  wr.interp(b, 1000.0)
  say("one interpolated player", to_int(peek_f32(b, wr.h_interp_n())), 1)
  say("at her x", to_int(peek_f32(b, wr.interp_at() + 1)), 5)
  say("with her id", to_int(peek_f32(b, wr.interp_at())), 9)

  # outgoing: the input frame is eleven bytes and starts with `i`
  say("input frame length", wr.out_input(b, 3, 0.5, 0.25), 11)
  say("and its letter", peek_u8(b, wr.out_at()), 105)
  say("fire frame length", wr.out_fire(b, 1.0, 0.0, 0.0), 13)
  println("done")

fn snap_row(b, at, id, x, y, z, seen) =
  put16(b, at, id)
  putf(b, at + 2, x)
  putf(b, at + 6, y)
  putf(b, at + 10, z)
  putf(b, at + 14, 0.0)
  putf(b, at + 18, 0.0)
  putf(b, at + 22, 1.0)
  put(b, at + 26, 0)
  put16(b, at + 27, 0)
  put16(b, at + 29, 0)
  put(b, at + 31, if seen > 0.5 then 1 else 0)
  put(b, at + 32, 255)
  put16(b, at + 33, 0)
  put16(b, at + 35, 0)
