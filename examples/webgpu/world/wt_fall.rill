# Reconciling against a snapshot that is old, while falling fast.
#
# The snapshot left the server half a round trip ago, so during a long fall it
# always shows this player above where they are now — speed times latency —
# and treating that as an error made a sawtooth the whole screen rode: pulled
# up 35% every tick, dropped by gravity between ticks, and past eleven metres
# a second of fall the fabricated gap crossed the four-metre teleport line and
# the sawtooth became a snap. That is what shaking screens after a jetpack
# flight were.
#
# The fix subtracts the foreseeable part before judging: the client's own
# vertical velocity times the snapshot's age. This file feeds reconcile a
# hand-built snapshot and measures exactly that.
import "valley" as v
import "wire" as wr

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

# A snapshot with one player in it, `lag` seconds staler than the client: the
# server saw them where they were, which for a body falling at `vy` is above
# where they are.
fn feed(b, s, cx, cy, cz, vy, lag, tick) = feed3(b, s, cx, cy, cz, 0.0, vy, 0.0, lag, tick)

fn feed3(b, s, cx, cy, cz, vx, vy, vz, lag, tick) =
  poke_f32(b, wr.h_have(), 1.0)
  poke_f32(b, wr.h_ping(), lag * 2.0 * 1000.0 - 100.0)   # span carries 50 of it
  poke_f32(b, wr.h_span(), 50.0)
  poke_f32(b, wr.h_which(), 0.0)
  poke_f32(b, wr.h_last_at(), to_float(tick))
  poke_f32(b, wr.h_id(), peek_f32(s, 99))
  sn = wr.snap_at(0)
  poke_f32(b, sn + 1, v.world_time(v.wd(s)))
  poke_f32(b, sn + 7, 0.0)
  poke_f32(b, sn + 8, 100.0)
  poke_f32(b, sn + 9, 1.0)
  at = sn + 12
  poke_f32(b, at, peek_f32(s, 99))
  poke_f32(b, at + 1, cx - vx * lag)
  poke_f32(b, at + 2, cy - vy * lag)
  poke_f32(b, at + 3, cz - vz * lag)
  poke_f32(b, at + 6, 1.0)
  poke_f32(b, at + 11, 1.0)
  poke_f32(b, at + 12, 0.0 - 1.0)
  0

# A snapshot carrying an ammunition figure, and nothing else moving: the
# player is left where they are so only the magazine is under test.
fn feed_ammo(b, s, ammo, tick) =
  feed3(b, s, v.player_x(s), v.player_y(s), v.player_z(s), 0.0, 0.0, 0.0, 0.0, tick)
  poke_f32(b, wr.snap_at(0) + 12 + 12, to_float(ammo))
  0

# A snapshot whose age this client will misjudge by `err` seconds: the row is
# built from where the player truly was `lag + err` ago, and the client will
# compensate for `lag`. That difference is what network jitter is.
fn feed_off(b, s, cx, cy, cz, vy, lag, err, tick) =
  feed(b, s, cx, cy, cz, vy, lag, tick)
  poke_f32(b, wr.snap_at(0) + 12 + 2, cy - vy * (lag + err))
  0

fn place(s, x, y, z, vy) = place3(s, x, y, z, 0.0, vy, 0.0)

fn place3(s, x, y, z, vx, vy, vz) =
  poke_f32(s, 21, x)
  poke_f32(s, 22, y)
  poke_f32(s, 23, z)
  poke_f32(s, 24, vy)
  poke_f32(s, 243, vx)
  poke_f32(s, 255, vz)
  0

fn main() =
  w = v.init(32, 4, 4, 4)
  s = v.join(w)
  b = wr.make()

  println("falling against a stale snapshot")
  # Falling at thirty metres a second with ninety milliseconds of lag: the
  # snapshot shows this player 2.7 m above where they are. That used to be
  # read as an error and blended — a pull of nearly a metre, upward, against
  # the fall, twenty times a second.
  place(s, 10.0, 50.0, 10.0, 0.0 - 30.0)
  feed(b, s, 10.0, 50.0, 10.0, 0.0 - 30.0, 0.09, 1)
  wr.reconcile(b, w, s, 1)
  say("a fall is not corrected upward, cm", cm(v.player_y(s) - 50.0), 0)
  say("and nothing went bad", if v.player_y(s) > 49.0 && v.player_y(s) < 51.0 then 1 else 0, 1)

  # Fifty metres a second — a long jetpack drop. The fabricated gap is 4.5 m,
  # which used to cross the teleport line: the whole screen snapped up every
  # tick. Compensated, it is centimetres.
  place(s, 10.0, 40.0, 10.0, 0.0 - 50.0)
  feed(b, s, 10.0, 40.0, 10.0, 0.0 - 50.0, 0.09, 2)
  wr.reconcile(b, w, s, 1)
  say("a hard fall does not teleport, cm", cm(v.player_y(s) - 40.0), 0)

  # A real divergence still corrects — but the vertical takes it as velocity
  # first and position second, because a vertical gap can be alive (see
  # `eased_in`): the position sips fifteen per cent this tick, and the fall
  # speed is nudged toward the server's answer so the rest closes itself.
  place(s, 10.0, 30.0, 10.0, 0.0)
  feed(b, s, 10.0, 30.5, 10.0, 0.0, 0.0, 3)
  wr.reconcile(b, w, s, 1)
  say("a standing error heals by a sip, cm", cm(v.player_y(s) - 30.0), 8)
  say("and the rest is handed to the velocity, cm per s", cm(peek_f32(s, 24)), 60)

  # And a genuine teleport-sized error still snaps, velocity or not: five
  # metres of sideways disagreement is not latency.
  # `feed` already applies the lag — it is handed where the client truly is
  # and derives the stale view itself. The first draft of this test added the
  # 2.7 by hand as well, fed a doubly-lifted row, and then blamed the code for
  # the 2.7 that came back out.
  place(s, 10.0, 20.0, 10.0, 0.0 - 30.0)
  feed(b, s, 16.0, 20.0, 10.0, 0.0 - 30.0, 0.09, 4)
  wr.reconcile(b, w, s, 1)
  say("a real five-metre error snaps to the server, cm", cm(v.player_x(s) - 16.0), 0)
  say("with the vertical lag still respected, cm", cm(v.player_y(s) - 20.0), 0)

  # Climbing is the mirror: the snapshot shows a jetpack rider below where
  # they are, and that is not an error either.
  place(s, 10.0, 60.0, 10.0, 6.5)
  feed(b, s, 10.0, 60.0, 10.0, 6.5, 0.09, 5)
  wr.reconcile(b, w, s, 1)
  say("a climb is not corrected downward, cm", cm(v.player_y(s) - 60.0), 0)

  println("timing noise is not an error")
  # What the compensation cannot know, and what that costs when it guesses.
  #
  # The age of a snapshot is half a smoothed round trip plus a smoothed gap,
  # and the truth wanders around that by however much the network jittered.
  # The compensation subtracts speed times age, so an error in the age comes
  # straight back out as an error in position of speed times *that* — nothing
  # on foot, twenty centimetres at thirteen metres a second under thrust.
  #
  # Blended, that was three centimetres of camera and twenty-nine centimetres
  # a second injected into the fall, twenty times a second, with whatever sign
  # the jitter had: the shake people reported in the air and never on the
  # ground. Nothing here is corrected toward now, because there is nothing in
  # it to correct toward.
  place(s, 10.0, 70.0, 10.0, 13.0)
  feed_off(b, s, 10.0, 70.0, 10.0, 13.0, 0.09, 0.010, 30)
  wr.reconcile(b, w, s, 1)
  say("ten milliseconds of jitter at a climb moves nothing, cm", cm(v.player_y(s) - 70.0), 0)
  say("and injects nothing into the fall, cm per s", cm(peek_f32(s, 24) - 13.0), 0)

  # And the other half, which is the half that must not be lost: a gap too big
  # to be timing is still healed, at the same speed and in the same way.
  place(s, 10.0, 70.0, 10.0, 13.0)
  feed_off(b, s, 10.0, 70.0, 10.0, 13.0, 0.09, 0.0, 31)
  poke_f32(b, wr.snap_at(0) + 12 + 2, peek_f32(b, wr.snap_at(0) + 12 + 2) + 1.0)
  wr.reconcile(b, w, s, 1)
  say("a metre of real disagreement still heals, cm", cm(v.player_y(s) - 70.0), 15)

  println("the magazine, and which way the server is wrong")
  # A snapshot is old, so the server always says more rounds than a firing
  # gun has left. Written back, a machine gun's belt refilled itself on
  # screen while the trigger was down.
  v.set_weapon(s, 5)
  poke_f32(s, 252, 60.0)
  feed_ammo(b, s, 63, 20)
  wr.reconcile(b, w, s, 0)
  say("the server being a little ahead is flight time", v.mg_rounds(s), 60)
  # Far ahead is not flight time: this client missed a belt or a box.
  poke_f32(s, 252, 60.0)
  feed_ammo(b, s, 75, 21)
  wr.reconcile(b, w, s, 0)
  say("far ahead is a reload this client missed", v.mg_rounds(s), 75)
  # And the server saying fewer is obeyed at once: the magazine is its own.
  poke_f32(s, 252, 60.0)
  feed_ammo(b, s, 50, 22)
  wr.reconcile(b, w, s, 0)
  say("the server saying fewer is obeyed", v.mg_rounds(s), 50)
  # Unless the hands are mid-change, when the page holds it.
  poke_f32(s, 252, 60.0)
  feed_ammo(b, s, 10, 23)
  wr.reconcile(b, w, s, 1)
  say("and held, nothing is written at all", v.mg_rounds(s), 60)
  v.set_weapon(s, 0)

  println("and sideways, which is what a flight mostly is")
  # Flying forward under the jetpack: climbing at six and a half and crossing
  # the valley at five and a half. The snapshot trails on both axes, and
  # neither trail is an error — read raw, the horizontal half yanked the
  # flier backward twenty times a second, which was the shake that survived
  # the vertical fix.
  place3(s, 20.0, 70.0, 20.0, 5.6, 6.5, 0.0 - 3.0)
  feed3(b, s, 20.0, 70.0, 20.0, 5.6, 6.5, 0.0 - 3.0, 0.09, 6)
  wr.reconcile(b, w, s, 1)
  say("a flight is not dragged behind itself, x cm", cm(v.player_x(s) - 20.0), 0)
  say("nor across, z cm", cm(v.player_z(s) - 20.0), 0)

  # A sprint's worth of lag never crosses the teleport line either: twelve
  # metres a second of ground speed times the lag is over a metre of nothing.
  place3(s, 30.0, 25.0, 30.0, 12.0, 0.0 - 20.0, 0.0)
  feed3(b, s, 30.0, 25.0, 30.0, 12.0, 0.0 - 20.0, 0.0, 0.12, 7)
  wr.reconcile(b, w, s, 1)
  say("a sprinting fall holds still, x cm", cm(v.player_x(s) - 30.0), 0)

  # A real sideways error under way still heals: moving forward with two
  # metres of genuine disagreement across the path, the across is pulled and
  # the along is left alone.
  place3(s, 40.0, 25.0, 40.0, 5.6, 0.0, 0.0)
  feed3(b, s, 40.0, 25.0, 42.0, 5.6, 0.0, 0.0, 0.09, 8)
  wr.reconcile(b, w, s, 1)
  say("a real error across the path heals, z cm", cm(v.player_z(s) - 40.0), 70)
  say("while the path itself is not touched, x cm", cm(v.player_x(s) - 40.0), 0)
  println("done")
