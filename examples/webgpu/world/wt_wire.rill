# A wt-style native run for the wire: connect to a running server as a client
# would, in binary, and read the door sequence back — hello, the gone and wall
# lists, sixteen boxes of ammunition — then speak (a name, an input, a ping)
# and check the valley answers with a `u`, an `s` whose numbers are sane, and
# the ping token handed straight back.
#
#   rill build server.rill -o wt-server && ./wt-server 8092 &
#   rill run wt_wire.rill
import "ws"

extern fn sin(x: Float) -> Float

extern fn cos(x: Float) -> Float

fn port() = 8092

fn u16_of(msg, i) = bit_or(str_get(msg, i), shl(str_get(msg, i + 1), 8))

fn u32_of(msg, i) = bit_or(u16_of(msg, i), shl(u16_of(msg, i + 2), 16))

fn i8_of(msg, i) = if str_get(msg, i) > 127 then str_get(msg, i) - 256 else str_get(msg, i)

fn f32_of(msg, sc, i) =
  poke_i8(sc, 0, str_get(msg, i))
  poke_i8(sc, 1, str_get(msg, i + 1))
  poke_i8(sc, 2, str_get(msg, i + 2))
  poke_i8(sc, 3, str_get(msg, i + 3))
  peek_f32(sc, 0)

fn put_f32(b, sc, v) =
  poke_f32(sc, 0, v)
  strbuf_byte(b, peek_u8(sc, 0))
  strbuf_byte(b, peek_u8(sc, 1))
  strbuf_byte(b, peek_u8(sc, 2))
  strbuf_byte(b, peek_u8(sc, 3))

fn name_msg() = chr(110) + "tester"

fn ping_msg() = chr(112) + "ABCDEFGH"

fn input_msg() =
  b = strbuf()
  sc = alloc_bytes(8)
  strbuf_byte(b, 105)
  strbuf_byte(b, 0)
  put_f32(b, sc, 0.5)
  put_f32(b, sc, 0.0 - 0.1)
  strbuf_str(b)

# Straight down the look the input above just set: the same forward the
# server's `faces` computes, so the shot is not refused as wild.
fn fire_msg() =
  b = strbuf()
  sc = alloc_bytes(8)
  strbuf_byte(b, 102)
  put_f32(b, sc, sin(0.5) * cos(0.1))
  put_f32(b, sc, sin(0.0 - 0.1))
  put_f32(b, sc, (0.0 - cos(0.5)) * cos(0.1))
  strbuf_str(b)

fn main() = match connect_to("127.0.0.1", port())
  Err(e) -> println("connect: " + e)
  Ok(fd) -> drive(fd)

fn drive(fd) =
  sock_write(fd, ws_handshake_request("127.0.0.1", "/?p=135"))
  acc = header_rest(fd, fill(fd, "", 4))
  (h, a2) = ws_take(fd, acc)
  check_hello(h)
  (g, a3) = ws_take(fd, a2)
  println("gone: op " + int_to_str(str_get(g, 0)) + ", " + int_to_str((str_len(g) - 1) / 2) + " crystals down")
  (wl, a4) = ws_take(fd, a3)
  println("wall: op " + int_to_str(str_get(wl, 0)) + ", " + int_to_str((str_len(wl) - 1) / 2) + " stones down")
  a5 = eat_mags(fd, a4, 0)
  sock_write(fd, client_frame_bin(name_msg()) + client_frame_bin(input_msg()) + client_frame_bin(ping_msg()) + client_frame_bin(fire_msg()))
  hunt(fd, a5, u16_of(h, 1), 0, 0, 0, 0, 80)
  ws_close(fd)

# The upgrade reply, however many reads it arrives in; whatever followed it in
# the same read is the first frame's start and is handed back.
fn header_rest(fd, buf) =
  at = str_find(buf, "\r\n\r\n")
  if at < 0 then grow_header(fd, buf) else str_sub(buf, at + 4, str_len(buf) - at - 4)

# A peer that closed without answering leaves `fill` returning what it was
# given; recursing on that is a spin, not a wait.
fn grow_header(fd, buf) =
  more = fill(fd, buf, str_len(buf) + 1)
  if str_len(more) == str_len(buf) then bail() else header_rest(fd, more)

fn bail() =
  println("the server closed the door on the handshake")
  ""

fn check_hello(h) =
  sc = alloc_bytes(8)
  println("hello: op " + int_to_str(str_get(h, 0)) + " id " + int_to_str(u16_of(h, 1)) + " pines " + int_to_str(u32_of(h, 3)) + " crystals " + int_to_str(u32_of(h, 7)) + " grass " + int_to_str(u32_of(h, 11)) + " clock " + float_to_str(f32_of(h, sc, 15)) + " token " + str_sub(h, 19, str_len(h) - 19))

fn eat_mags(fd, acc, n) =
  if n >= 16 then acc else eat_mag(fd, acc, n)

fn eat_mag(fd, acc, n) =
  (m, rest) = ws_take(fd, acc)
  if str_get(m, 0) != 109 then complain(m, n, rest) else eat_quietly(fd, m, rest, n)

fn eat_quietly(fd, m, rest, n) =
  if n == 0 then say_first(m) else 0
  eat_mags(fd, rest, n + 1)

fn say_first(m) =
  println("mags: op 109, box " + int_to_str(str_get(m, 1)) + " taken " + int_to_str(u32_of(m, 2)) + " times, and fifteen more")
  1

fn complain(m, n, rest) =
  println("expected a mag at " + int_to_str(n) + ", got op " + int_to_str(str_get(m, 0)))
  rest

# Read until the four answers have all arrived, or the patience runs out.
fn hunt(fd, acc, id, s, u, p, r, n) =
  if n == 0 || (s > 0 && u > 0 && p > 0 && r > 0) then report(s, u, p, r) else hunt_on(fd, acc, id, s, u, p, r, n)

fn hunt_on(fd, acc, id, s, u, p, r, n) =
  (m, rest) = ws_take(fd, acc)
  if str_len(m) == 0 then report(s, u, p, r) else sort(fd, rest, m, id, s, u, p, r, n)

fn sort(fd, rest, m, id, s, u, p, r, n) =
  k = str_get(m, 0)
  if k == 115 && s == 0 then found_snap(fd, rest, m, id, u, p, r, n) else if k == 117 then found_who(fd, rest, m, id, s, p, r, n) else if k == 112 then found_pong(fd, rest, m, id, s, u, r, n) else if k == 114 && r == 0 then found_round(fd, rest, m, id, s, u, p, n) else hunt(fd, rest, id, s, u, p, r, n - 1)

fn found_snap(fd, rest, m, id, u, p, r, n) =
  sc = alloc_bytes(8)
  count = str_get(m, 30)
  println("snapshot: " + int_to_str(count) + " player, " + int_to_str(str_len(m)) + " bytes (31 + count*37 = " + int_to_str(31 + count * 37) + ")")
  println("  clock " + float_to_str(f32_of(m, sc, 1)) + ", phase " + int_to_str(str_get(m, 25)) + ", left " + float_to_str(f32_of(m, sc, 26)))
  println("  me: id " + int_to_str(u16_of(m, 31)) + " (mine is " + int_to_str(id) + ") at " + float_to_str(f32_of(m, sc, 33)) + " " + float_to_str(f32_of(m, sc, 37)) + " " + float_to_str(f32_of(m, sc, 41)) + ", yaw " + float_to_str(f32_of(m, sc, 45)) + ", health " + float_to_str(f32_of(m, sc, 53)) + ", seen " + int_to_str(str_get(m, 62)) + ", ammo " + int_to_str(i8_of(m, 63)))
  hunt(fd, rest, id, 1, u, p, r, n - 1)

fn found_who(fd, rest, m, id, s, p, r, n) =
  println("who: id " + int_to_str(u16_of(m, 1)) + " is " + str_sub(m, 3, str_len(m) - 3))
  hunt(fd, rest, id, s, 1, p, r, n - 1)

fn found_pong(fd, rest, m, id, s, u, r, n) =
  println("pong: " + (if str_sub(m, 1, str_len(m) - 1) == "ABCDEFGH" then "the token came home" else "WRONG TOKEN " + str_sub(m, 1, str_len(m) - 1)))
  hunt(fd, rest, id, s, u, 1, r, n - 1)

fn found_round(fd, rest, m, id, s, u, p, n) =
  sc = alloc_bytes(8)
  println("round: " + int_to_str(str_len(m)) + " bytes, from " + float_to_str(f32_of(m, sc, 1)) + " " + float_to_str(f32_of(m, sc, 5)) + " " + float_to_str(f32_of(m, sc, 9)) + ", owner " + float_to_str(f32_of(m, sc, 25)) + " (mine is " + int_to_str(id) + ")")
  hunt(fd, rest, id, s, u, p, 1, n - 1)

fn report(s, u, p, r) =
  println("saw snapshot " + int_to_str(s) + ", who " + int_to_str(u) + ", pong " + int_to_str(p) + ", round " + int_to_str(r))
  0
