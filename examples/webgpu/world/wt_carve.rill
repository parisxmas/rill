# A native run for the pickaxe, now that the ground is voxels rather than a
# height field.
#
# The difference this file exists to pin down: a column is a hundred and
# twenty-eight bits, one per thirty-centimetre slab, so "this bit of the wall
# is gone and the roof over it is not" is a thing the world can say. Strike a
# wall at chest height and the wall opens at chest height. Under a height
# field the only expressible answer was "this whole column is cut down to
# here", so hitting the rock in front of you took the rock above it too, and
# from inside a shaft that read as the ground collapsing under you.
#
# The spot is found by scanning, not written down: the terrain is a function,
# and a test pinned to (34, -8) is a test that breaks when an octave moves.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

fn absf(x) = v.absf(x)

# Somewhere properly rocky, and the same scan from a chosen edge so a test can
# insist on a quadrant.
fn rocky(x, z) =
  if v.height(x, z) > 11.0 then x else if x > 80.0 then 0.0 - 1000.0 else rocky(x + 1.0, z)

fn find_rock(z) = find_rock_from(0.0 - 80.0, z)

fn find_rock_from(x0, z) =
  x = rocky(x0, z)
  if x > 0.0 - 999.0 then (x, z) else find_rock_from(x0, z + 3.0)

# Rock with — or without — something molten under it.
fn molten_at(x, z) = if v.magma_under(x, z) then 1 else 0

fn rocky_where(x, z, want) =
  if v.height(x, z) > 11.0 && molten_at(x, z) == want then x
  else if x > 80.0 then 0.0 - 1000.0
  else rocky_where(x + 1.0, z, want)

fn find_ground(z, want) =
  x = rocky_where(0.0 - 80.0, z, want)
  if x > 0.0 - 999.0 then (x, z) else find_ground(z + 3.0, want)

fn molten_of(x0) =
  for i in 0..40 with n = 0
    n + molten_at(x0 + to_float(i) * 4.0, 0.0 - 20.0)

# The middle of the column a point falls in, so a test never stands on a
# boundary and asks floating point to break a tie.
fn cell_mid_x(x, z) = v.cell_x(v.carve_cell(x, z))

fn cell_mid_z(x, z) = v.cell_z(v.carve_cell(x, z))

# The stone the last swing actually took, unpacked from the ring. Which is not
# the stone the feet are on: the ray leaves the eye, and a head stands the
# better part of a stone from where the boots are. That is the pick landing
# under the crosshair, which is what it should do.
fn last_code(w) = v.carve_ev(w, v.carves(w) - 1)

fn code_col(c) = c / v.vox_slabs()

# Stand at a point, look where told, settle one frame.
fn stance(s, x, z, yaw, pitch) =
  v.set_at(s, x, v.ground_under(v.wd(s), x, v.height(x, z) + 2.0, z) + 0.1, z)
  poke_f32(s, 19, yaw)
  poke_f32(s, 20, pitch)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  1

fn aim_down(s, x0, z0) =
  x = cell_mid_x(x0, z0)
  z = cell_mid_z(x0, z0)
  stance(s, x, z, 0.0, 0.0 - v.pitch_max())

fn swing_on(s, n, acc) =
  for i in 0..n with got = acc
    got + v.swing_pick(s)

# Standing still and swinging, which is how a shaft gets sunk. Take the stance
# once and leave it.
fn swings(s, x, z, n, acc) =
  aim_down(s, x, z)
  swing_on(s, n, acc)

fn settle(s, n) =
  for i in 0..n
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)

  1

# Sink a pit by standing in it and swinging at the same spot, dropping with
# the floor as it goes.
fn sink(s, x, z, n) =
  for i in 0..n
    aim_down(s, x, z)
    v.swing_pick(s)
    settle(s, 30)

  1

# A pit wide enough for the height field to notice one. A bite is three tenths
# of a metre and a mesh cell in the fine valley below is 170/160: a shaft
# narrower than the lattice moves no vertex of it at all — what draws such a
# shaft is the voxel faces, which is the whole point of them. So where a test
# wants to see the *mesh* follow the digging it has to open more than a
# lattice's worth, and `r` stones each way is what that takes.
fn sink_patch(s, x, z, r, n) =
  for dz in 0 - r..r + 1
    for dx in 0 - r..r + 1
      sink(s, x + to_float(dx) * v.carve_q(), z + to_float(dz) * v.carve_q(), n)

  1

fn solid(w, x, y, z) = v.solid_at(w, x, y, z)

# ---- nothing is missing from the picture -------------------------------------
#
# A terrain cell that has a roof under it draws nothing and leaves the ground
# to the voxel faces. If a column of such a cell gets no face, there is a hole
# in the hillside you can see the lake through — and there was one along every
# edge, because a terrain cell is 170/grid metres and a column is thirty
# centimetres and the one does not divide by the other.
# Is any upward-facing quad standing over this point? Asked of the point and
# not of the column, because a piece of hillside is cut to the cell that handed
# it over and no longer starts where its column does — see `ground_quad`. A
# ground quad carries its own width and depth; everything else is a stone
# square.
fn covers(w, px, pz) =
  for k in 0..v.rock_faces(w) with found = 0
    d = v.face_at(w, k, 3)
    up = d > 1.5 && d < 2.5 || d > 5.5
    fx = v.face_at(w, k, 0)
    fz = v.face_at(w, k, 2)
    wx = if d > 5.5 then v.face_at(w, k, 7) else v.carve_q()
    wz = if d > 5.5 then v.face_at(w, k, 11) else v.carve_q()
    inside = px > fx - 0.002 && px < fx + wx + 0.002 && pz > fz - 0.002 && pz < fz + wz + 0.002
    if found > 0 then 1 else if up && inside then 1 else 0

# The cell's own rectangle, sampled. What has to be true is that the cell the
# terrain stepped aside for is covered edge to edge — not that any particular
# column was drawn by any particular cell, which is what this used to ask and
# is no longer the same question.
fn cell_gaps(w, x0, z0, st) =
  for j in 0..6 with g = 0
    for i in 0..6 with h = g
      px = x0 + st * (to_float(i) + 0.5) / 6.0
      pz = z0 + st * (to_float(j) + 0.5) / 6.0
      h + 1 - covers(w, px, pz)

fn blanked_cells(w, s) =
  m = v.terrain(s)
  n = v.mesh_n(w)

  for c in 0..n * n with seen = 0
    at = c * 54
    x0 = peek_f32(m, at)
    z0 = peek_f32(m, at + 2)
    flat = peek_f32(m, at + 9) == x0 && peek_f32(m, at + 18) == x0 && peek_f32(m, at + 45) == x0 && peek_f32(m, at + 11) == z0 && peek_f32(m, at + 47) == z0
    seen + v.yes(flat)

fn blank_gaps(w, s) =
  m = v.terrain(s)
  n = v.mesh_n(w)
  st = v.cell_step(n)

  for c in 0..n * n with gaps = 0
    at = c * 54
    x0 = peek_f32(m, at)
    z0 = peek_f32(m, at + 2)
    flat = peek_f32(m, at + 9) == x0 && peek_f32(m, at + 18) == x0 && peek_f32(m, at + 45) == x0 && peek_f32(m, at + 11) == z0 && peek_f32(m, at + 47) == z0
    if flat then gaps + cell_gaps(w, x0, z0, st) else gaps

# The first of the boxes lying somewhere the pick works.
fn box_on_rock(w, sb, i) =
  if i >= v.mag_count() then 0 - 1
  else
    at = i * v.shard_stride()
    x = peek_f32(sb, at)
    z = peek_f32(sb, at + 2)
    if v.height(x, z) > 12.0 && v.height(x, z) < 22.0 then i
    else box_on_rock(w, sb, i + 1)

# The lowest terrain vertex within half a metre of (x, z). The mesh is 54
# floats a cell, nine a vertex: position, normal, colour.
fn mesh_low(m, n, x, z) =
  for i in 0..n with best = 9999.0
    vx = peek_f32(m, i * 9)
    vy = peek_f32(m, i * 9 + 1)
    vz = peek_f32(m, i * 9 + 2)
    near = absf(vx - x) < 0.6 && absf(vz - z) < 0.6
    if near && vy < best then vy else best

# The door's way: patch by patch, column by column, mask byte by mask byte,
# which is the only shape the welcome message speaks in.
fn hand_all(w, s) =
  for sx in 0..v.carve_supers()
    if v.carve_page_at(w, sx) > 0 then hand_page(w, s, sx) else 0

  1

fn hand_page(w, s, sx) =
  for c in 0..v.carve_page_cells()
    if v.carve_col_any(w, sx, c) > 0 then hand_col(w, s, sx, c) else 0

  1

fn hand_col(w, s, sx, c) =
  for i in 0..v.carve_col_bytes()
    v.ap_carve_col(v.wd(s), sx, c, i, v.carve_col_byte(w, sx, c, i))

  v.ap_carve_col_done(v.wd(s), sx, c)

# How many slabs of a column are open between two heights.
fn open_between(w, x, z, y0, y1) =
  steps = to_int((y1 - y0) / v.carve_q())

  for i in 0..steps with n = 0
    n + v.yes(solid(w, x, y0 + to_float(i) * v.carve_q(), z) == 0)

# What the terrain actually draws at a point, read out of the mesh it hands the
# GPU: the cell, then whichever of its two triangles covers the point, then that
# triangle's own plane. Not the smooth patch the four corners define — a
# triangle is flat, and the two differ everywhere except at the corners and
# along the cell's edges.
#
# Everything the voxels build reads `mesh_h`: the top of a riser, the corners of
# a piece of hillside. If it answers with the patch while the terrain draws the
# flats, the two surfaces cross somewhere over the cell and what is left open is
# bounded by the cut between the triangles — a triangle of daylight, which is
# what these were. Measured before it was fixed: two and a half centimetres.
fn drawn_at(w, s, x, z) =
  m = v.terrain(s)
  n = v.mesh_n(w)
  st = v.cell_step(n)
  ix = to_int(floor((x + 85.0) / st))
  iz = to_int(floor((z + 85.0) / st))
  ux = (x - v.lattice(ix, st)) / st
  uz = (z - v.lattice(iz, st)) / st
  at = (iz * n + ix) * 54 + (if uz > ux then 0 else 27)
  plane_at(m, at, x, z)

# The height of one triangle's plane at a point, by its own three corners.
fn plane_at(m, at, x, z) =
  ax = peek_f32(m, at)
  ay = peek_f32(m, at + 1)
  az = peek_f32(m, at + 2)
  bx = peek_f32(m, at + 9)
  by = peek_f32(m, at + 10)
  bz = peek_f32(m, at + 11)
  cx2 = peek_f32(m, at + 18)
  cy = peek_f32(m, at + 19)
  cz2 = peek_f32(m, at + 20)
  det = (bz - cz2) * (ax - cx2) + (cx2 - bx) * (az - cz2)
  if absf(det) < 0.000001 then ay
  else
    l1 = ((bz - cz2) * (x - cx2) + (cx2 - bx) * (z - cz2)) / det
    l2 = ((cz2 - az) * (x - cx2) + (ax - cx2) * (z - cz2)) / det
    l1 * ay + l2 * by + (1.0 - l1 - l2) * cy

# The worst that `mesh_h` and the drawn triangle disagree, over a scatter of
# points inside cells the terrain still draws.
fn worst_drift(w, s) =
  for i in 0..400 with worst = 0
    x = 0.0 - 70.0 + to_float(i * 37 % 140) + 0.137
    z = 0.0 - 70.0 + to_float(i * 53 % 140) + 0.211
    dd = absf(v.mesh_h(w, x, z) - drawn_at(w, s, x, z))
    if cm(dd) > worst then cm(dd) else worst

# The steepest rock in the valley, which is the only place worth asking these
# questions. A cell's crease is as deep as the cell's twist, and on the gentle
# shelf the other tests stand on the whole defect hides behind a millimetre —
# a guard that reads one is a guard that will not notice being broken again.
fn slope_at(x, z) =
  a = absf(v.height(x + 1.0, z) - v.height(x - 1.0, z))
  b = absf(v.height(x, z + 1.0) - v.height(x, z - 1.0))
  if a > b then a else b

fn grid_n() = 1600

fn grid_x(i) = 0.0 - 78.0 + to_float(i % 40) * 4.0

fn grid_z(i) = 0.0 - 78.0 + to_float(i / 40) * 4.0

fn steep_of(i) =
  x = grid_x(i)
  z = grid_z(i)
  if v.height(x, z) > 14.0 then slope_at(x, z) else 0.0

fn steepest_slope() =
  for i in 0..grid_n() with b = 0.0
    s = steep_of(i)
    if s > b then s else b

fn steepest_at(target) =
  for i in 0..grid_n() with found = 0 - 1
    if found >= 0 then found else if steep_of(i) >= target then i else 0 - 1

# A cap riser is drawn as one quad with a height at each end, so its top edge
# is a straight chord. The ground it has to meet is not straight: a mesh cell
# is drawn as two triangles and creases along the diagonal between them, and
# `mesh_h` follows that crease exactly. Where a run crosses the crease, a chord
# from end to end passes under it, and the wedge left open between the two is
# the triangle of lake that has been showing through dug pits.
#
# Only the risers that actually cap are asked: a face whose two ends already
# sit on the ground is one, and one whose top is a slab ceiling is not.
fn riser_miss(w, s) =
  n = v.faces_build(s)
  fb = v.face_buf(w)
  st = v.face_stride()
  for i in 0..n with worst = 0
    at = i * st
    dir = to_int(peek_f32(fb, at + 3))
    if dir == 2 || dir == 3 || dir == 6 then worst
    else
      x = peek_f32(fb, at)
      y = peek_f32(fb, at + 1)
      z = peek_f32(fb, at + 2)
      tall = peek_f32(fb, at + 7)
      tall2 = peek_f32(fb, at + 12)
      wide = peek_f32(fb, at + 13)
      alongz = dir < 2
      x1 = if alongz then x else x + wide
      z1 = if alongz then z + wide else z
      ta = v.mesh_h(w, x, z)
      tb = v.mesh_h(w, x1, z1)
      caps = absf(y + tall - ta) < 0.001 && absf(y + tall2 - tb) < 0.001
      if !caps then worst
      else
        tm = v.mesh_h(w, (x + x1) * 0.5, (z + z1) * 0.5)
        e = to_int(absf(y + (tall + tall2) * 0.5 - tm) * 1000.0)
        if e > worst then e else worst


# Every wall the body runs into, the eye can see.
#
# The expectation here is not taken from the meshing — writing the same
# sentence twice proves nothing — but from `solid_at`, which is the rock a
# walk collides with and a pick reads. Where rock stands against air and
# somebody has dug there, something has to be drawn on that boundary, or you
# are looking through a wall you cannot walk through, and what is behind it is
# the lake.
#
# Only the four lateral faces. A floor and a ceiling have their own rules and
# their own test above; a side is a plane of constant x or constant z, running
# along the other, and that is all this needs to know.
# Has the terrain given this point up to the voxels?
fn blanked(w, x, z) =
  n = v.mesh_n(w)
  st = v.cell_step(n)
  ix = to_int(floor((x + 85.0) / st))
  iz = to_int(floor((z + 85.0) / st))
  if v.mcell_roofed(w, st, ix, iz) > 0 then 1 else 0

fn wall_seen(w, n, dir, plane, py, runp) =
  for k in 0..n with found = 0
    if found > 0 then 1
    else if to_int(v.face_at(w, k, 3)) != dir then 0
    else
      alongz = dir < 2
      want = if alongz then v.face_at(w, k, 0) else v.face_at(w, k, 2)
      run0 = if alongz then v.face_at(w, k, 2) else v.face_at(w, k, 0)
      wide = v.face_at(w, k, 13)
      t1 = v.face_at(w, k, 7)
      t2 = v.face_at(w, k, 12)
      hi = if t1 > t2 then t1 else t2
      fy = v.face_at(w, k, 1)
      on = absf(want - plane) < 0.02 && runp > run0 - 0.02 && runp < run0 + wide + 0.02
      if on && py > fy - 0.02 && py < fy + hi + 0.02 then 1 else 0

# `want` picks what is counted: 0 the boundaries that exist, 1 the ones with
# nothing drawn on them.
fn wall_gap(w, n, dir, x, y, z, nx, nz, plane, want) =
  if v.solid_at(w, x, y, z) == 0 then 0
  else if v.solid_at(w, nx, y, nz) > 0 then 0
  # Air over the ground *as it is drawn* is not a hole, it is the sky. Asked of
  # `mesh_h` and not `height`: at the rim of a pit the two are a cell's slope
  # apart, and the picture cannot owe a wall on rock it does not draw.
  else if y >= v.mesh_h(w, nx, nz) then 0
  else if y >= v.mesh_h(w, x, z) then 0
  # And only where the terrain has stepped aside. Outside a blanked cell the
  # hillside is still the height field's to draw, and no voxel face is owed.
  else if blanked(w, x, z) == 0 then 0
  else if want == 0 then 1
  else wall_short(w, n, dir, plane, y, if dir < 2 then z else x, v.carve_q())

# Not "is there a face on this boundary" but "is the boundary covered end to
# end". A face that stops short of the column it stands on leaves a slot, and
# a slot seen along a slope is a band of lake several pixels wide — asked at
# the middle of the run only, every one of these passes.
fn wall_short(w, n, dir, plane, y, mid, q) =
  for j in 0..9 with bad = 0
    r = mid - q * 0.5 + q * (to_float(j) + 0.5) / 9.0
    bad + 1 - wall_seen(w, n, dir, plane, y, r)

fn col_gaps(w, n, x, z, q, want, only) =
  i = v.carve_cell(x, z)
  if i < 0 then 0
  else
    x0 = v.cell_x(i) - q * 0.5
    z0 = v.cell_z(i) - q * 0.5
    h = v.height(x, z)
    for k in 0..30 with miss = 0
      y = h - to_float(k) * q - q * 0.5
      g0 = if only >= 0 && only != 0 then 0 else wall_gap(w, n, 0, x, y, z, x - q, z, x0, want)
      g1 = if only >= 0 && only != 1 then 0 else wall_gap(w, n, 1, x, y, z, x + q, z, x0 + q, want)
      g4 = if only >= 0 && only != 4 then 0 else wall_gap(w, n, 4, x, y, z, x, z - q, z0, want)
      g5 = if only >= 0 && only != 5 then 0 else wall_gap(w, n, 5, x, y, z, x, z + q, z0 + q, want)
      miss + g0 + g1 + g4 + g5

fn open_walls(w, s, cx, cz, r, want, only) =
  n = v.faces_build(s)
  q = v.carve_q()
  for iz in 0 - r..r + 1 with miss = 0
    for ix in 0 - r..r + 1 with m2 = miss
      m2 + col_gaps(w, n, cx + to_float(ix) * q, cz + to_float(iz) * q, q, want, only)

# The same question asked downwards: where rock has air over it, something has
# to be lying on top of it, and it has to reach the whole of the column — not
# just the middle. An up-facing quad is either a stone square at a slab
# boundary (dir 2) or a piece of hillside (dir 6), and the piece of hillside
# carries its own width and depth and a height at each corner.
fn floor_seen(w, n, px, py, pz) =
  for k in 0..n with found = 0
    if found > 0 then 1
    else
      d = to_int(v.face_at(w, k, 3))
      if d != 2 && d != 6 then 0
      else
        fx = v.face_at(w, k, 0)
        fz = v.face_at(w, k, 2)
        wx = if d == 6 then v.face_at(w, k, 7) else v.face_at(w, k, 12)
        wz = if d == 6 then v.face_at(w, k, 11) else v.face_at(w, k, 13)
        inside = px > fx - 0.002 && px < fx + wx + 0.002 && pz > fz - 0.002 && pz < fz + wz + 0.002
        if inside == false then 0
        else
          fy = if d == 2 then v.face_at(w, k, 1) else corner_y(w, k, fx, fz, wx, wz, px, pz)
          if absf(fy - py) < 0.05 then 1 else 0

fn corner_y(w, k, fx, fz, wx, wz, px, pz) =
  ux = (px - fx) / wx
  uz = (pz - fz) / wz
  a = v.face_at(w, k, 12)
  b = v.face_at(w, k, 13)
  c = v.face_at(w, k, 14)
  d = v.face_at(w, k, 15)
  (a + (b - a) * ux) + ((c + (d - c) * ux) - (a + (b - a) * ux)) * uz

# Is any up-facing quad over this point at all, whatever height it sits at?
fn floor_any(w, n, px, pz) =
  for k in 0..n with found = 0
    if found > 0 then 1
    else
      d = to_int(v.face_at(w, k, 3))
      if d != 2 && d != 6 then 0
      else
        fx = v.face_at(w, k, 0)
        fz = v.face_at(w, k, 2)
        wx = if d == 6 then v.face_at(w, k, 7) else v.face_at(w, k, 12)
        wz = if d == 6 then v.face_at(w, k, 11) else v.face_at(w, k, 13)
        if px > fx - 0.002 && px < fx + wx + 0.002 && pz > fz - 0.002 && pz < fz + wz + 0.002 then 1 else 0

fn floor_nowhere(w, n, x, z, q) =
  for j in 0..25 with bad = 0
    px = x - q * 0.5 + q * (to_float(j % 5) + 0.5) / 5.0
    pz = z - q * 0.5 + q * (to_float(j / 5) + 0.5) / 5.0
    bad + 1 - floor_any(w, n, px, pz)

fn floor_short(w, n, x, z, py, q) =
  for j in 0..25 with bad = 0
    px = x - q * 0.5 + q * (to_float(j % 5) + 0.5) / 5.0
    pz = z - q * 0.5 + q * (to_float(j / 5) + 0.5) / 5.0
    bad + 1 - floor_seen(w, n, px, py, pz)

fn col_floor_gaps(w, n, x, z, q, want) =
  h = v.height(x, z)
  for k in 0..30 with miss = 0
    y = h - to_float(k) * q - q * 0.5
    if v.solid_at(w, x, y, z) == 0 then miss
    else if v.solid_at(w, x, y + q, z) > 0 then miss
    else if y + q * 0.5 >= h then miss
    else if want == 0 then miss + 1
    else if want == 1 then miss + (if floor_short(w, n, x, z, y + q * 0.5, q) > 0 then 1 else 0)
    else if want == 2 then miss + floor_short(w, n, x, z, y + q * 0.5, q)
    else miss + floor_nowhere(w, n, x, z, q)

fn open_floors(w, s, cx, cz, r, want) =
  n = v.faces_build(s)
  q = v.carve_q()
  for iz in 0 - r..r + 1 with miss = 0
    for ix in 0 - r..r + 1 with m2 = miss
      m2 + col_floor_gaps(w, n, cx + to_float(ix) * q, cz + to_float(iz) * q, q, want)

# A face standing clear of the hillside: the ground at both of its ends is
# under the slab it stands on, so nothing the eye can see joins it and it hangs
# in the air. `want` 0 counts them, 1 is the worst overhang in centimetres.
fn fins(w, s, want) =
  n = v.faces_build(s)
  fb = v.face_buf(w)
  st = v.face_stride()
  for i in 0..n with acc = 0
    at = i * st
    dir = to_int(peek_f32(fb, at + 3))
    if dir == 2 || dir == 3 || dir == 6 then acc
    else
      x = peek_f32(fb, at)
      y = peek_f32(fb, at + 1)
      z = peek_f32(fb, at + 2)
      wide = peek_f32(fb, at + 13)
      tall = peek_f32(fb, at + 7)
      tall2 = peek_f32(fb, at + 12)
      hiT = if tall > tall2 then tall else tall2
      alongz = dir < 2
      x1 = if alongz then x else x + wide
      z1 = if alongz then z + wide else z
      m1 = v.mesh_h(w, x, z)
      m2 = v.mesh_h(w, x1, z1)
      hi = if m1 > m2 then m1 else m2
      if hi > y + 0.001 then acc
      else if want == 0 then acc + 1
      else
        e = cm(y + hiT - hi)
        if e > acc then e else acc

# A flat square standing over the hillside: a shelf with nothing under it and
# nothing beside it, because its own sides were trimmed to a ground that is
# below it. One per slab between the middle of a column and its highest
# corner, and the daylight between them is what a rim of thin slivers is.
#
# Up-facing only. Sixty ceilings still hang over the hillside at a rim — rock
# with dug air under it and the drawn ground below both — and they are the
# same disagreement as everything else here: what the body walks into is the
# rock, what the eye sees is the lattice, and at a rim those are a cell's
# slope apart. They are seen only from underneath, which is why they are named
# here and not asserted away.
fn shelves(w, s) =
  n = v.faces_build(s)
  fb = v.face_buf(w)
  st = v.face_stride()
  for i in 0..n with c = 0
    at = i * st
    d = to_int(peek_f32(fb, at + 3))
    if d != 2 then c
    else
      x = peek_f32(fb, at) + v.carve_q() * 0.5
      y = peek_f32(fb, at + 1)
      z = peek_f32(fb, at + 2) + v.carve_q() * 0.5
      if y > v.mesh_h(w, x, z) + 0.02 then c + 1 else c

# A piece of hillside with nothing under it.
#
# A ground quad is laid at `mesh_h`, which is the lattice ramp between a cell's
# four corners. A pit dug in the middle of a cell moves no corner of it, so the
# ramp stays where it was and every quad in that cell is drawn at hillside
# height — over columns that have been taken two metres down. What is left is a
# lid over the hole with its edges hanging in the air.
#
# Asked of `solid_at`, a hand's breadth under the quad's own middle.
fn lids(w, s, want) =
  n = v.faces_build(s)
  fb = v.face_buf(w)
  st = v.face_stride()
  for i in 0..n with acc = 0
    at = i * st
    d = to_int(peek_f32(fb, at + 3))
    if d != 6 && d != 2 then acc
    else
      x = peek_f32(fb, at)
      z = peek_f32(fb, at + 2)
      wx = if d == 6 then peek_f32(fb, at + 7) else peek_f32(fb, at + 12)
      wz = if d == 6 then peek_f32(fb, at + 11) else peek_f32(fb, at + 13)
      mid = if d == 6 then (peek_f32(fb, at + 12) + peek_f32(fb, at + 13) + peek_f32(fb, at + 14) + peek_f32(fb, at + 15)) * 0.25 else peek_f32(fb, at + 1)
      px = x + wx * 0.5
      pz = z + wz * 0.5
      if v.solid_at(w, px, mid - 0.05, pz) > 0 then acc
      else if want == 6 then (if d == 6 then acc + 1 else acc)
      else if want == 2 then (if d == 2 then acc + 1 else acc)
      else if want == 0 then acc + 1
      else
        drop = cm(mid - v.floor_at(w, px, pz))
        if drop > acc then drop else acc

fn quad_over(w, s, mm) =
  n = v.faces_build(s)
  fb = v.face_buf(w)
  st = v.face_stride()
  for i in 0..n with c = 0
    at = i * st
    if to_int(peek_f32(fb, at + 3)) != 6 then c
    else
      x = peek_f32(fb, at)
      z = peek_f32(fb, at + 2)
      wx = peek_f32(fb, at + 7)
      wz = peek_f32(fb, at + 11)
      mid = (peek_f32(fb, at + 12) + peek_f32(fb, at + 13) + peek_f32(fb, at + 14) + peek_f32(fb, at + 15)) * 0.25
      e = to_int(absf(mid - v.mesh_h(w, x + wx * 0.5, z + wz * 0.5)) * 1000.0)
      if e > mm then c + 1 else c


fn main() =
  w = v.init(48, 60, 40, 60)
  s = v.join(w)
  (rx, rz) = find_rock(0.0 - 60.0)
  say("found rock to stand on", if v.height(rx, rz) > 11.0 then 1 else 0, 1)

  # Untouched, the carved floor is the base ground everywhere.
  say("before a swing the floor is the ground, cm", cm(v.floor_at(w, rx, rz) - v.height(rx, rz)), 0)

  # ---- one bite --------------------------------------------------------------
  #
  # One stone — three tenths of a metre each way, which is exactly a wall
  # block — and that stone into the pocket. It was a cube four stones on a
  # side, and a tool that takes sixty-four of the valley's own stone unit per
  # swing is not a pick.
  aim_down(s, rx, rz)
  got = v.swing_pick(s)
  say("a swing pays one stone", got, 1)
  say("and the pocket holds it", v.stones_of(s), got)
  ci = code_col(last_code(w))
  mx = v.cell_x(ci)
  mz = v.cell_z(ci)
  # The bite is two stones on a side, and the first one off a fresh hillside is
  # short of the full two: the ground is where the ground is, and the top slab
  # it lands in is part rock and part air. Every bite after it is exactly two,
  # because the floor it strikes is a slab boundary by then.
  fn drop(dx, dz) = cm(v.height(mx + dx, mz + dz) - v.floor_at(w, mx + dx, mz + dz))
  d1 = drop(0.0, 0.0)
  say("the first bite is most of two stones", if d1 > 30 && d1 <= 60 then 1 else 0, 1)
  # Two across is even, so the square cannot straddle: it runs from the stone
  # struck to the one after it, and not back to the one before.
  say("the stone in front of it went too, cm", drop(0.3, 0.0) - d1, 0)
  say("and the one behind it did not, cm", drop(0.0 - 0.3, 0.0), 0)
  say("nor the one behind that way, cm", drop(0.0, 0.0 - 0.3), 0)
  swings(s, mx, mz, 1, 0)
  say("and the next one is exactly two, cm", drop(0.0, 0.0) - d1, 60)
  say("two bites on the ring", v.carves(w), 2)
  say("one page holds them", v.carve_pages(w), 1)

  # ---- the wall, and the roof over it ---------------------------------------
  #
  # This is the whole reason the field is voxels. Stand in the pit just sunk,
  # look level at its wall, and swing. The wall opens where it was struck and
  # the rock above the strike stays where it is — so what is left is a roof,
  # which under a height field could not exist at all.
  # Deep enough to have a wall worth striking: eye level from the floor of a
  # shallow scrape is over the rim and hits nothing. Twelve bites is seven
  # metres, which puts an eye at 1.75 well under the rim.
  #
  # Sunk, not swung: `swings` takes its stance once and strikes twelve times
  # from it, and the floor runs away from the eye as it goes. That worked only
  # because a swing used to carry twelve metres. An arm's reach is two, so a
  # digger goes down with the floor they are cutting, which is what `sink`
  # does and what a digger does.
  sink(s, mx, mz, 12)
  fy = v.floor_at(w, mx, mz)
  stance(s, mx, mz, 0.0, 0.0)
  eye = peek_f32(s, 17)
  paid = v.swing_pick(s)
  say("swinging level at the wall pays", paid, 1)
  wc = code_col(last_code(w))
  wx = v.cell_x(wc)
  wz = v.cell_z(wc)
  say("and it struck the wall, not the floor", if absf(wx - mx) + absf(wz - mz) > 0.15 then 1 else 0, 1)
  say("the wall is open at eye height", solid(w, wx, eye, wz), 0)
  say("which is a ceiling, not the sky", if v.roof_over(w, wx, eye, wz) < 900.0 then 1 else 0, 1)
  # And the thing the old field could not do at all: the floor the digger is
  # standing on did not move when the wall in front of them came away.
  say("and the floor underfoot never moved, cm", cm(v.floor_at(w, mx, mz) - fy), 0)

  # ---- a tunnel --------------------------------------------------------------
  #
  # Keep swinging level and the hole runs into the hill. What makes it a
  # tunnel rather than a trench is that it is roofed for its whole length.
  swing_on(s, 8, 0)
  tx = mx
  tz = mz - 1.5
  say("a metre and a half in, it is hollow", solid(w, tx, eye, tz), 0)
  # The roof it has: where the first rock over your head is, and how much of
  # the hill is standing on top of it. Both numbers together are the thing a
  # height field could not represent at all.
  roof = v.roof_over(w, tx, eye, tz)
  say("and roofed", if roof < 900.0 then 1 else 0, 1)
  say("just over head height", if roof > eye && roof < eye + 1.5 then 1 else 0, 1)
  say("with rock standing on that roof", solid(w, tx, roof + 0.15, tz), 1)
  say("and the hillside still over all of it", solid(w, tx, v.height(tx, tz) - 0.15, tz), 1)
  # Lower than the hillside over it by the stone that was taken out: the floor
  # in a tunnel is the tunnel's own. This used to ask for half a metre, which
  # it could when a bite was four stones deep. One stone leaves exactly one
  # stone of difference — measured, 33.5 against a hillside at 34.0 — and half
  # a metre is a tie the test loses.
  say("and the floor in there is the tunnel's",
      if v.ground_under(w, tx, eye, tz) < v.height(tx, tz) - v.carve_q() then 1 else 0, 1)

  # ---- replay ----------------------------------------------------------------
  #
  # A second valley, fed the same ring, opens the same rock: the two agree
  # slab for slab without a byte of field crossing between them.
  w2 = v.init(48, 60, 40, 60)
  s2 = v.join(w2)
  for k in 0..v.carves(w)
    v.put_carve(s2, v.carve_ev(w, k))
  say("a replayed valley has the same floor, cm", cm(v.floor_at(w2, mx, mz)), cm(v.floor_at(w, mx, mz)))
  say("and the same tunnel", solid(w2, tx, eye, tz), solid(w, tx, eye, tz))
  say("and the same roof over it", solid(w2, tx, eye + 2.0, tz), solid(w, tx, eye + 2.0, tz))

  # And a third, handed the masks the way the door hands them.
  w3 = v.init(48, 60, 40, 60)
  s3 = v.join(w3)
  hand_all(w, s3)
  say("a valley handed masks has the same floor, cm", cm(v.floor_at(w3, mx, mz)), cm(v.floor_at(w, mx, mz)))
  say("and the same open slabs",
      open_between(w3, tx, tz, eye - 1.0, eye + 1.0),
      open_between(w, tx, tz, eye - 1.0, eye + 1.0))

  # ---- the bottom ------------------------------------------------------------
  #
  # Most shafts find bedrock. Twelve metres under the original ground the rock
  # stops coming out, the swing pays nothing, and that is the end of that hole.
  (bxx, bzz) = find_ground(rz + 9.0, 0)
  bx = cell_mid_x(bxx, bzz)
  bz = cell_mid_z(bxx, bzz)
  m0 = v.magmas(w)
  sink(s, bx, bz, 45)
  bd = cm(v.height(bx, bz) - v.floor_at(w, bx, bz))
  say("a shaft stops at the bedrock", if bd > 1170 && bd <= 1200 then 1 else 0, 1)
  say("and there is nothing molten under it", v.magmas(w) - m0, 0)
  aim_down(s, bx, bz)
  say("swinging at bedrock pays nothing", v.swing_pick(s), 0)

  # And a few break through, where the molten field says so — a place you go
  # and find, not a floor that is under everywhere.
  (mxx, mzz) = find_ground(rz + 9.0, 1)
  px = cell_mid_x(mxx, mzz)
  pz = cell_mid_z(mxx, mzz)
  sink(s, px, pz, 45)
  pd = cm(v.height(px, pz) - v.floor_at(w, px, pz))
  say("that pit stops at the cap too", if pd > 1170 && pd <= 1200 then 1 else 0, 1)
  say("and the bottom is magma", if v.magmas(w) > m0 then 1 else 0, 1)
  say("most of the band is bedrock", v.yes(molten_of(0.0 - 80.0) * 4 < 40), 1)

  # ---- the reach -------------------------------------------------------------
  #
  # An arm's, not a siege engine's.
  stance(s, mx, mz, 0.0, 0.0 - v.pitch_max())
  say("underfoot is within reach", v.can_mine(s), 1)
  # From the ground, not from the floor of the pit the tests above sank here.
  # Off the floor it read fourteen and the ground was only seven away, so this
  # line was measuring how much the tests dug rather than how far an arm goes.
  v.set_at(s, mx, v.height(mx, mz) + 14.0, mz)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("fourteen metres up it is not", v.can_mine(s), 0)
  # And bedrock is not for mining, which is the whole of what bedrock is.
  stance(s, px, pz, 0.0, 0.0 - v.pitch_max())
  say("the bedrock floor reads as no", v.can_mine(s), 0)

  # ---- standing in it --------------------------------------------------------
  v.set_health(s, 1.0)
  v.set_at(s, px, v.floor_at(w, px, pz), pz)
  for i in 0..60
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("a second in the pit costs a fifth", if v.health(s) < 0.85 && v.health(s) > 0.65 then 1 else 0, 1)
  v.set_at(s, px, v.height(px, pz) + 2.0, pz)
  h0 = v.health(s)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("hovering over it is free", cm(h0 - v.health(s)), 0)

  # ---- what is standing on the ground goes down with it ----------------------
  #
  # A box was put down on the hillside the valley was born with and left
  # there. Dig the shaft out from under one and it hung in the air where the
  # rock used to be — the one thing wrong with this world that could be seen
  # from across the valley.
  sb = v.shards(s)
  bi = box_on_rock(w, sb, 0)
  say("a box standing on rock", if bi >= 0 then 1 else 0, 1)
  bx = peek_f32(sb, bi * v.shard_stride())
  bz = peek_f32(sb, bi * v.shard_stride() + 2)
  say("it starts on the ground, cm", cm(peek_f32(sb, bi * v.shard_stride() + 1) - v.height(bx, bz)), 0)
  sink(s, cell_mid_x(bx, bz), cell_mid_z(bx, bz), 6)
  v.step_world(w, 1.0 / 60.0)
  fell = v.height(bx, bz) - peek_f32(sb, bi * v.shard_stride() + 1)
  say("the shaft went down under it", if cm(v.height(bx, bz) - v.floor_at(w, bx, bz)) > 100 then 1 else 0, 1)
  say("and the box went down with it", if cm(fell) > 100 then 1 else 0, 1)
  say("landing on the floor, not in the air, cm",
      cm(peek_f32(sb, bi * v.shard_stride() + 1) - v.floor_at(w, bx, bz)), 0)

  # ---- what the pick will not do ---------------------------------------------
  aim_down(s, 0.0 - 14.0, 0.0 - 34.0)
  say("the meadow refuses the pick", v.swing_pick(s), 0)

  # ---- building back ---------------------------------------------------------
  v.set_stones(s, 20)
  n0 = v.blocks_total(w)
  say("a rock goes down", v.try_build(s), 1)
  say("the table grew by one", v.blocks_total(w) - n0, 1)
  say("and the stones were paid", v.stones_of(s), 12)
  v.put_built(s2, v.built_ev(w, 0, 1), v.built_ev(w, 0, 2), v.built_ev(w, 0, 3), v.built_ev(w, 0, 4))
  say("the told valley grew too", v.blocks_total(w2) - n0, 1)
  v.set_stones(s, 3)
  say("three stones build nothing", v.try_build(s), 0)

  # ---- somebody else's valley ------------------------------------------------
  (r2x, r2z) = find_rock(rz + 21.0)
  aim_down(s, r2x, r2z)
  c0 = v.carves(w)
  v.set_hosted(w, 1)
  say("a hosted pick acts on nothing", v.pick_used(s), 0)
  say("and dug no bite of its own", v.carves(w), c0)
  v.set_hosted(w, 0)
  say("its own valley again, it digs", if v.pick_used(s) > 0 then 1 else 0, 1)

  # ---- the mesh follows ------------------------------------------------------
  #
  # On a lattice fine enough to hold the bite: this valley's mesh is one vertex
  # every 170/grid metres, so the coarse grid the rest of this test runs on
  # cannot show it. The browser builds at 160.
  #
  # And the quadrant matters. The dirty rect's empty-marker once asked whether
  # minx was above *maxz* — a distance east against a distance north — so
  # everywhere x runs positive and z negative it read "nothing to redraw" and
  # the ground you fell into still looked whole.
  w4 = v.init(160, 60, 40, 60)
  s4 = v.join(w4)
  (qx, qz) = find_rock_from(2.0, 0.0 - 55.0)
  say("a rock in the east-and-north quadrant", if qx > 0.0 && qz < 0.0 then 1 else 0, 1)
  swings(s4, qx, qz, 1, 0)
  qmx = v.cell_x(code_col(last_code(w4)))
  qmz = v.cell_z(code_col(last_code(w4)))
  qd = cm(v.height(qmx, qmz) - v.floor_at(w4, qmx, qmz))
  say("the field says most of two stones", if qd > 30 && qd <= 60 then 1 else 0, 1)
  say("and the rebake had work to do", v.rebake(s4), 1)
  # And what the voxels read is what the terrain draws, to the centimetre.
  say("the height the voxels read is the one the terrain draws, cm", worst_drift(w4, s4), 0)

  # ---- the shape of a dug rim ------------------------------------------------
  #
  # On the steepest rock there is, where a cell's ground and a column's ground
  # are furthest apart and every one of these has shown up first.
  si = steepest_at(steepest_slope())
  sx = cell_mid_x(grid_x(si), grid_z(si))
  sz = cell_mid_z(grid_x(si), grid_z(si))
  say("the steepest rock in the valley, dm per metre", to_int(steepest_slope() * 5.0), 14)
  sink_patch(s4, sx, sz, 4, 9)
  # Every wall the body runs into, the eye can see. Read off `solid_at` — the
  # rock a walk collides with — and not off the meshing, so this is a second
  # opinion and not the same sentence twice. Thirty-three of it are open along
  # the -x rim of the digging, which is the band of lake in the photographs.
  say("every wall you cannot walk through is drawn", open_walls(w4, s4, sx, sz, 7, 1, 0 - 1), 0)
  say("and every floor you can stand on", open_floors(w4, s4, sx, sz, 7, 3), 0)
  # Nothing drawn stands clear of the ground beside it. A face whose hillside
  # is under it at both ends has nothing to join and hangs in the air — four
  # hundred and forty-nine of them at one pit, the worst seven metres up.
  say("nothing is left standing in the air", fins(w4, s4, 0), 0)
  say("and nothing over the hillside at all, cm", fins(w4, s4, 1), 0)
  say("no shelf stands over the hillside", shelves(w4, s4), 0)
  say("every piece of hillside has rock under it", lids(w4, s4, 0), 0)

  # And the picture has no holes in it. A pit alone will not do for this: a
  # terrain cell only steps aside where something is roofed, so the test has
  # to sink a shaft and drive out of its wall before there is anything for the
  # voxel faces to be responsible for.
  sink(s4, qmx, qmz, 12)
  stance(s4, qmx, qmz, 0.0, 0.0)
  swing_on(s4, 8, 0)
  v.rebake(s4)
  v.faces_build(s4)
  say("the tunnel blanked some terrain", if blanked_cells(w4, s4) > 0 then 1 else 0, 1)
  say("and nothing is missing from it", blank_gaps(w4, s4), 0)
  # And the lattice itself comes down, once what has been opened is wider than
  # the lattice is. Two stones each way is a metre and a half, which always
  # swallows a corner of a cell a metre and six across.
  sink_patch(s4, qmx, qmz, 2, 6)
  v.rebake(s4)
  low = mesh_low(v.terrain(s4), v.terrain_verts(s4), qmx, qmz)
  say("the mesh came down with it, cm", if cm(v.height(qmx, qmz) - low) > 100 then 1 else 0, 1)

  # ---- the crosshair ---------------------------------------------------------
  aim_down(s, r2x, r2z)
  say("rock under the crosshair reads gold", v.can_mine(s), 1)
  poke_f32(s, 20, v.pitch_max())
  say("and the sky does not", v.can_mine(s), 0)
  println("done")
