# A native run for the pickaxe, now that the ground is voxels rather than a
# height field.
#
# The difference this file exists to pin down: a column is a hundred and
# twenty-eight bits, one per thirty-centimetre slab, so "this bit of the wall
# is gone and the roof over it is not" is a thing the world can say. Strike a
# wall at chest height and the wall opens at chest height. Under a height
# field the only expressible answer was "this whole column is cut down to
# here", so hitting the rock in front of you took the rock above it too, and
# from inside a shaft that read as the ground collapsing under you.
#
# The spot is found by scanning, not written down: the terrain is a function,
# and a test pinned to (34, -8) is a test that breaks when an octave moves.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

fn absf(x) = v.absf(x)

# Somewhere properly rocky, and the same scan from a chosen edge so a test can
# insist on a quadrant.
fn rocky(x, z) =
  if v.height(x, z) > 11.0 then x else if x > 80.0 then 0.0 - 1000.0 else rocky(x + 1.0, z)

fn find_rock(z) = find_rock_from(0.0 - 80.0, z)

fn find_rock_from(x0, z) =
  x = rocky(x0, z)
  if x > 0.0 - 999.0 then (x, z) else find_rock_from(x0, z + 3.0)

# Rock with — or without — something molten under it.
fn molten_at(x, z) = if v.magma_under(x, z) then 1 else 0

fn rocky_where(x, z, want) =
  if v.height(x, z) > 11.0 && molten_at(x, z) == want then x
  else if x > 80.0 then 0.0 - 1000.0
  else rocky_where(x + 1.0, z, want)

fn find_ground(z, want) =
  x = rocky_where(0.0 - 80.0, z, want)
  if x > 0.0 - 999.0 then (x, z) else find_ground(z + 3.0, want)

fn molten_of(x0) =
  for i in 0..40 with n = 0
    n + molten_at(x0 + to_float(i) * 4.0, 0.0 - 20.0)

# The middle of the column a point falls in, so a test never stands on a
# boundary and asks floating point to break a tie.
fn cell_mid_x(x, z) = v.cell_x(v.carve_cell(x, z))

fn cell_mid_z(x, z) = v.cell_z(v.carve_cell(x, z))

# The stone the last swing actually took, unpacked from the ring. Which is not
# the stone the feet are on: the ray leaves the eye, and a head stands the
# better part of a stone from where the boots are. That is the pick landing
# under the crosshair, which is what it should do.
fn last_code(w) = v.carve_ev(w, v.carves(w) - 1)

fn code_col(c) = c / v.vox_slabs()

# Stand at a point, look where told, settle one frame.
fn stance(s, x, z, yaw, pitch) =
  v.set_at(s, x, v.ground_under(v.wd(s), x, v.height(x, z) + 2.0, z) + 0.1, z)
  poke_f32(s, 19, yaw)
  poke_f32(s, 20, pitch)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  1

fn aim_down(s, x0, z0) =
  x = cell_mid_x(x0, z0)
  z = cell_mid_z(x0, z0)
  stance(s, x, z, 0.0, 0.0 - v.pitch_max())

fn swing_on(s, n, acc) =
  for i in 0..n with got = acc
    got + v.swing_pick(s)

# Standing still and swinging, which is how a shaft gets sunk. Take the stance
# once and leave it.
fn swings(s, x, z, n, acc) =
  aim_down(s, x, z)
  swing_on(s, n, acc)

fn settle(s, n) =
  for i in 0..n
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)

  1

# Sink a pit by standing in it and swinging at the same spot, dropping with
# the floor as it goes.
fn sink(s, x, z, n) =
  for i in 0..n
    aim_down(s, x, z)
    v.swing_pick(s)
    settle(s, 30)

  1

fn solid(w, x, y, z) = v.solid_at(w, x, y, z)

# ---- nothing is missing from the picture -------------------------------------
#
# A terrain cell that has a roof under it draws nothing and leaves the ground
# to the voxel faces. If a column of such a cell gets no face, there is a hole
# in the hillside you can see the lake through — and there was one along every
# edge, because a terrain cell is 170/grid metres and a column is thirty
# centimetres and the one does not divide by the other.
fn has_face(w, ix, iz) =
  x = v.col_lo(ix)
  z = v.col_lo(iz)

  for k in 0..v.rock_faces(w) with found = 0
    d = v.face_at(w, k, 3)
    up = d > 1.5 && d < 2.5 || d > 5.5
    if found > 0 then 1
    else if up && absf(v.face_at(w, k, 0) - x) < 0.01 && absf(v.face_at(w, k, 2) - z) < 0.01 then 1
    else 0

# What the cell needs covered, said here rather than borrowed from the engine:
# a test that asks the code under test what the answer is cannot fail with it.
fn touches(ix, lo, len) =
  a = to_float(ix) * v.carve_q() - v.carve_org()
  a < lo + len && a + v.carve_q() > lo

fn cell_gaps(w, x0, z0, st) =
  for iz in v.cell_ix(z0) - 1..v.cell_ix(z0 + st) + 2 with g = 0
    for ix in v.cell_ix(x0) - 1..v.cell_ix(x0 + st) + 2 with h = g
      if touches(ix, x0, st) && touches(iz, z0, st) then h + 1 - has_face(w, ix, iz) else h

fn blanked_cells(w, s) =
  m = v.terrain(s)
  n = v.mesh_n(w)

  for c in 0..n * n with seen = 0
    at = c * 54
    x0 = peek_f32(m, at)
    z0 = peek_f32(m, at + 2)
    flat = peek_f32(m, at + 9) == x0 && peek_f32(m, at + 18) == x0 && peek_f32(m, at + 45) == x0 && peek_f32(m, at + 11) == z0 && peek_f32(m, at + 47) == z0
    seen + v.yes(flat)

fn blank_gaps(w, s) =
  m = v.terrain(s)
  n = v.mesh_n(w)
  st = v.cell_step(n)

  for c in 0..n * n with gaps = 0
    at = c * 54
    x0 = peek_f32(m, at)
    z0 = peek_f32(m, at + 2)
    flat = peek_f32(m, at + 9) == x0 && peek_f32(m, at + 18) == x0 && peek_f32(m, at + 45) == x0 && peek_f32(m, at + 11) == z0 && peek_f32(m, at + 47) == z0
    if flat then gaps + cell_gaps(w, x0, z0, st) else gaps

# The first of the boxes lying somewhere the pick works.
fn box_on_rock(w, sb, i) =
  if i >= v.mag_count() then 0 - 1
  else
    at = i * v.shard_stride()
    x = peek_f32(sb, at)
    z = peek_f32(sb, at + 2)
    if v.height(x, z) > 12.0 && v.height(x, z) < 22.0 then i
    else box_on_rock(w, sb, i + 1)

# The lowest terrain vertex within half a metre of (x, z). The mesh is 54
# floats a cell, nine a vertex: position, normal, colour.
fn mesh_low(m, n, x, z) =
  for i in 0..n with best = 9999.0
    vx = peek_f32(m, i * 9)
    vy = peek_f32(m, i * 9 + 1)
    vz = peek_f32(m, i * 9 + 2)
    near = absf(vx - x) < 0.6 && absf(vz - z) < 0.6
    if near && vy < best then vy else best

# The door's way: patch by patch, column by column, mask byte by mask byte,
# which is the only shape the welcome message speaks in.
fn hand_all(w, s) =
  for sx in 0..v.carve_supers()
    if v.carve_page_at(w, sx) > 0 then hand_page(w, s, sx) else 0

  1

fn hand_page(w, s, sx) =
  for c in 0..v.carve_page_cells()
    if v.carve_col_any(w, sx, c) > 0 then hand_col(w, s, sx, c) else 0

  1

fn hand_col(w, s, sx, c) =
  for i in 0..v.carve_col_bytes()
    v.ap_carve_col(v.wd(s), sx, c, i, v.carve_col_byte(w, sx, c, i))

  v.ap_carve_col_done(v.wd(s), sx, c)

# How many slabs of a column are open between two heights.
fn open_between(w, x, z, y0, y1) =
  steps = to_int((y1 - y0) / v.carve_q())

  for i in 0..steps with n = 0
    n + v.yes(solid(w, x, y0 + to_float(i) * v.carve_q(), z) == 0)

fn main() =
  w = v.init(48, 60, 40, 60)
  s = v.join(w)
  (rx, rz) = find_rock(0.0 - 60.0)
  say("found rock to stand on", if v.height(rx, rz) > 11.0 then 1 else 0, 1)

  # Untouched, the carved floor is the base ground everywhere.
  say("before a swing the floor is the ground, cm", cm(v.floor_at(w, rx, rz) - v.height(rx, rz)), 0)

  # ---- one bite --------------------------------------------------------------
  #
  # A cube four stones on a side — a metre and twenty each way — and one
  # stone of it into the pocket.
  aim_down(s, rx, rz)
  got = v.swing_pick(s)
  say("a swing pays one stone", got, 1)
  say("and the pocket holds it", v.stones_of(s), got)
  ci = code_col(last_code(w))
  mx = v.cell_x(ci)
  mz = v.cell_z(ci)
  # The first bite off a fresh hillside is a little short of four stones: the
  # ground is where the ground is, and the top slab it lands in is only part
  # rock. Every bite after it is exactly four, because the floor it strikes is
  # a slab boundary by then.
  fn drop(dx, dz) = cm(v.height(mx + dx, mz + dz) - v.floor_at(w, mx + dx, mz + dz))
  d1 = drop(0.0, 0.0)
  say("the first bite is most of four stones", if d1 > 90 && d1 <= 120 then 1 else 0, 1)
  say("flat at one corner of the bite, cm", drop(0.0 - 0.3, 0.0 - 0.3), d1)
  say("flat at the far one, cm", drop(0.6, 0.6), d1)
  say("a stone past the square is untouched, cm", drop(0.9, 0.0), 0)
  say("and behind it too, cm", drop(0.0, 0.0 - 0.6), 0)
  swings(s, mx, mz, 1, 0)
  say("and the next one is exactly four, cm", drop(0.0, 0.0) - d1, 120)
  say("two bites on the ring", v.carves(w), 2)
  say("one page holds them", v.carve_pages(w), 1)

  # ---- the wall, and the roof over it ---------------------------------------
  #
  # This is the whole reason the field is voxels. Stand in the pit just sunk,
  # look level at its wall, and swing. The wall opens where it was struck and
  # the rock above the strike stays where it is — so what is left is a roof,
  # which under a height field could not exist at all.
  # Deep enough to have a wall worth striking: eye level from the floor of a
  # shallow scrape is over the rim and hits nothing.
  swings(s, mx, mz, 4, 0)
  fy = v.floor_at(w, mx, mz)
  stance(s, mx, mz, 0.0, 0.0)
  eye = peek_f32(s, 17)
  paid = v.swing_pick(s)
  say("swinging level at the wall pays", paid, 1)
  wc = code_col(last_code(w))
  wx = v.cell_x(wc)
  wz = v.cell_z(wc)
  say("and it struck the wall, not the floor", if absf(wx - mx) + absf(wz - mz) > 0.15 then 1 else 0, 1)
  say("the wall is open at eye height", solid(w, wx, eye, wz), 0)
  say("which is a ceiling, not the sky", if v.roof_over(w, wx, eye, wz) < 900.0 then 1 else 0, 1)
  # And the thing the old field could not do at all: the floor the digger is
  # standing on did not move when the wall in front of them came away.
  say("and the floor underfoot never moved, cm", cm(v.floor_at(w, mx, mz) - fy), 0)

  # ---- a tunnel --------------------------------------------------------------
  #
  # Keep swinging level and the hole runs into the hill. What makes it a
  # tunnel rather than a trench is that it is roofed for its whole length.
  swing_on(s, 6, 0)
  tx = mx
  tz = mz - 1.5
  say("a metre and a half in, it is hollow", solid(w, tx, eye, tz), 0)
  # The roof it has: where the first rock over your head is, and how much of
  # the hill is standing on top of it. Both numbers together are the thing a
  # height field could not represent at all.
  roof = v.roof_over(w, tx, eye, tz)
  say("and roofed", if roof < 900.0 then 1 else 0, 1)
  say("just over head height", if roof > eye && roof < eye + 1.5 then 1 else 0, 1)
  say("with rock standing on that roof", solid(w, tx, roof + 0.15, tz), 1)
  say("and the hillside still over all of it", solid(w, tx, v.height(tx, tz) - 0.15, tz), 1)
  say("and the floor in there is the tunnel's",
      if v.ground_under(w, tx, eye, tz) < v.height(tx, tz) - 0.5 then 1 else 0, 1)

  # ---- replay ----------------------------------------------------------------
  #
  # A second valley, fed the same ring, opens the same rock: the two agree
  # slab for slab without a byte of field crossing between them.
  w2 = v.init(48, 60, 40, 60)
  s2 = v.join(w2)
  for k in 0..v.carves(w)
    v.put_carve(s2, v.carve_ev(w, k))
  say("a replayed valley has the same floor, cm", cm(v.floor_at(w2, mx, mz)), cm(v.floor_at(w, mx, mz)))
  say("and the same tunnel", solid(w2, tx, eye, tz), solid(w, tx, eye, tz))
  say("and the same roof over it", solid(w2, tx, eye + 2.0, tz), solid(w, tx, eye + 2.0, tz))

  # And a third, handed the masks the way the door hands them.
  w3 = v.init(48, 60, 40, 60)
  s3 = v.join(w3)
  hand_all(w, s3)
  say("a valley handed masks has the same floor, cm", cm(v.floor_at(w3, mx, mz)), cm(v.floor_at(w, mx, mz)))
  say("and the same open slabs",
      open_between(w3, tx, tz, eye - 1.0, eye + 1.0),
      open_between(w, tx, tz, eye - 1.0, eye + 1.0))

  # ---- the bottom ------------------------------------------------------------
  #
  # Most shafts find bedrock. Twelve metres under the original ground the rock
  # stops coming out, the swing pays nothing, and that is the end of that hole.
  (bxx, bzz) = find_ground(rz + 9.0, 0)
  bx = cell_mid_x(bxx, bzz)
  bz = cell_mid_z(bxx, bzz)
  m0 = v.magmas(w)
  sink(s, bx, bz, 14)
  bd = cm(v.height(bx, bz) - v.floor_at(w, bx, bz))
  say("a shaft stops at the bedrock", if bd > 1170 && bd <= 1200 then 1 else 0, 1)
  say("and there is nothing molten under it", v.magmas(w) - m0, 0)
  aim_down(s, bx, bz)
  say("swinging at bedrock pays nothing", v.swing_pick(s), 0)

  # And a few break through, where the molten field says so — a place you go
  # and find, not a floor that is under everywhere.
  (mxx, mzz) = find_ground(rz + 9.0, 1)
  px = cell_mid_x(mxx, mzz)
  pz = cell_mid_z(mxx, mzz)
  sink(s, px, pz, 14)
  pd = cm(v.height(px, pz) - v.floor_at(w, px, pz))
  say("that pit stops at the cap too", if pd > 1170 && pd <= 1200 then 1 else 0, 1)
  say("and the bottom is magma", if v.magmas(w) > m0 then 1 else 0, 1)
  say("most of the band is bedrock", v.yes(molten_of(0.0 - 80.0) * 4 < 40), 1)

  # ---- the reach -------------------------------------------------------------
  #
  # An arm's, not a siege engine's.
  stance(s, mx, mz, 0.0, 0.0 - v.pitch_max())
  say("underfoot is within reach", v.can_mine(s), 1)
  v.set_at(s, mx, v.floor_at(w, mx, mz) + 5.0, mz)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("five metres up it is not", v.can_mine(s), 0)
  # And bedrock is not for mining, which is the whole of what bedrock is.
  stance(s, px, pz, 0.0, 0.0 - v.pitch_max())
  say("the bedrock floor reads as no", v.can_mine(s), 0)

  # ---- standing in it --------------------------------------------------------
  v.set_health(s, 1.0)
  v.set_at(s, px, v.floor_at(w, px, pz), pz)
  for i in 0..60
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("a second in the pit costs a fifth", if v.health(s) < 0.85 && v.health(s) > 0.65 then 1 else 0, 1)
  v.set_at(s, px, v.height(px, pz) + 2.0, pz)
  h0 = v.health(s)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("hovering over it is free", cm(h0 - v.health(s)), 0)

  # ---- what is standing on the ground goes down with it ----------------------
  #
  # A box was put down on the hillside the valley was born with and left
  # there. Dig the shaft out from under one and it hung in the air where the
  # rock used to be — the one thing wrong with this world that could be seen
  # from across the valley.
  sb = v.shards(s)
  bi = box_on_rock(w, sb, 0)
  say("a box standing on rock", if bi >= 0 then 1 else 0, 1)
  bx = peek_f32(sb, bi * v.shard_stride())
  bz = peek_f32(sb, bi * v.shard_stride() + 2)
  say("it starts on the ground, cm", cm(peek_f32(sb, bi * v.shard_stride() + 1) - v.height(bx, bz)), 0)
  sink(s, cell_mid_x(bx, bz), cell_mid_z(bx, bz), 4)
  v.step_world(w, 1.0 / 60.0)
  fell = v.height(bx, bz) - peek_f32(sb, bi * v.shard_stride() + 1)
  say("the shaft went down under it", if cm(v.height(bx, bz) - v.floor_at(w, bx, bz)) > 100 then 1 else 0, 1)
  say("and the box went down with it", if cm(fell) > 100 then 1 else 0, 1)
  say("landing on the floor, not in the air, cm",
      cm(peek_f32(sb, bi * v.shard_stride() + 1) - v.floor_at(w, bx, bz)), 0)

  # ---- what the pick will not do ---------------------------------------------
  aim_down(s, 0.0 - 14.0, 0.0 - 34.0)
  say("the meadow refuses the pick", v.swing_pick(s), 0)

  # ---- building back ---------------------------------------------------------
  v.set_stones(s, 20)
  n0 = v.blocks_total(w)
  say("a rock goes down", v.try_build(s), 1)
  say("the table grew by one", v.blocks_total(w) - n0, 1)
  say("and the stones were paid", v.stones_of(s), 12)
  v.put_built(s2, v.built_ev(w, 0, 1), v.built_ev(w, 0, 2), v.built_ev(w, 0, 3), v.built_ev(w, 0, 4))
  say("the told valley grew too", v.blocks_total(w2) - n0, 1)
  v.set_stones(s, 3)
  say("three stones build nothing", v.try_build(s), 0)

  # ---- somebody else's valley ------------------------------------------------
  (r2x, r2z) = find_rock(rz + 21.0)
  aim_down(s, r2x, r2z)
  c0 = v.carves(w)
  v.set_hosted(w, 1)
  say("a hosted pick acts on nothing", v.pick_used(s), 0)
  say("and dug no bite of its own", v.carves(w), c0)
  v.set_hosted(w, 0)
  say("its own valley again, it digs", if v.pick_used(s) > 0 then 1 else 0, 1)

  # ---- the mesh follows ------------------------------------------------------
  #
  # On a lattice fine enough to hold the bite: this valley's mesh is one vertex
  # every 170/grid metres, so the coarse grid the rest of this test runs on
  # cannot show it. The browser builds at 160.
  #
  # And the quadrant matters. The dirty rect's empty-marker once asked whether
  # minx was above *maxz* — a distance east against a distance north — so
  # everywhere x runs positive and z negative it read "nothing to redraw" and
  # the ground you fell into still looked whole.
  w4 = v.init(160, 60, 40, 60)
  s4 = v.join(w4)
  (qx, qz) = find_rock_from(2.0, 0.0 - 55.0)
  say("a rock in the east-and-north quadrant", if qx > 0.0 && qz < 0.0 then 1 else 0, 1)
  swings(s4, qx, qz, 1, 0)
  qmx = v.cell_x(code_col(last_code(w4)))
  qmz = v.cell_z(code_col(last_code(w4)))
  qd = cm(v.height(qmx, qmz) - v.floor_at(w4, qmx, qmz))
  say("the field says most of four stones", if qd > 90 && qd <= 120 then 1 else 0, 1)
  say("and the rebake had work to do", v.rebake(s4), 1)

  # And the picture has no holes in it. A pit alone will not do for this: a
  # terrain cell only steps aside where something is roofed, so the test has
  # to sink a shaft and drive out of its wall before there is anything for the
  # voxel faces to be responsible for.
  sink(s4, qmx, qmz, 5)
  stance(s4, qmx, qmz, 0.0, 0.0)
  swing_on(s4, 6, 0)
  v.rebake(s4)
  v.faces_build(s4)
  say("the tunnel blanked some terrain", if blanked_cells(w4, s4) > 0 then 1 else 0, 1)
  say("and nothing is missing from it", blank_gaps(w4, s4), 0)
  low = mesh_low(v.terrain(s4), v.terrain_verts(s4), qmx, qmz)
  say("the mesh came down with it, cm", if cm(v.height(qmx, qmz) - low) > 100 then 1 else 0, 1)

  # ---- the crosshair ---------------------------------------------------------
  aim_down(s, r2x, r2z)
  say("rock under the crosshair reads gold", v.can_mine(s), 1)
  poke_f32(s, 20, v.pitch_max())
  say("and the sky does not", v.can_mine(s), 0)
  println("done")
