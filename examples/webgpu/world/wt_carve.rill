# A native run for the pickaxe: the rock comes out, the floor goes down, the
# bottom is magma, and a second valley fed the same ring digs the same holes.
#
# The spot is found by scanning, not written down: the terrain is a function,
# and a test pinned to (34, -8) is a test that breaks when an octave moves.
# What is asserted is arithmetic — how far a floor fell, what a swing paid,
# where the cap is — against the constants in valley.rill.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn cm(x) = to_int(x * 100.0 + if x < 0.0 then 0.0 - 0.5 else 0.5)

# Somewhere properly rocky: high enough that the whole crater sits above the
# rock line, so no cell of it is refused.
fn rocky(x, z) =
  if v.height(x, z) > 11.0 then x else if x > 80.0 then 0.0 - 1000.0 else rocky(x + 1.0, z)

fn find_rock(z) = find_rock_from(0.0 - 80.0, z)

# The same scan from a chosen edge, so a test can insist on a quadrant.
fn find_rock_from(x0, z) =
  x = rocky(x0, z)
  if x > 0.0 - 999.0 then (x, z) else find_rock_from(x0, z + 3.0)

# Stand on the middle of the cell (x, z) falls in, looking dead down, one
# settled frame, then swing.
#
# Dead down, not nearly: a cell is thirty centimetres across and a look four
# degrees off vertical wanders a whole cell sideways over the couple of
# metres to the floor, so "nearly down" digs the stone next door. And the
# middle of the cell rather than the point asked for, because a test that
# stands on a cell's edge is a test about floating point.
fn cell_mid_x(x, z) = v.cell_x(v.carve_cell(x, z))

fn cell_mid_z(x, z) = v.cell_z(v.carve_cell(x, z))

# The cell the last swing actually took. Which is not the cell the feet are
# on: the ray leaves the eye, and a head stands the better part of a stone's
# width from where the boots are. That is the pick landing under the
# crosshair, which is what it should do — so what a test measures is the
# stone that came out, read off the ring, rather than the one it guessed.
fn last_cell(w) = v.carve_ev(w, v.carves(w) - 1)

fn aim_down(s, x0, z0) =
  x = cell_mid_x(x0, z0)
  z = cell_mid_z(x0, z0)
  v.set_at(s, x, v.floor_at(v.wd(s), x, z) + 0.1, z)
  poke_f32(s, 19, 0.0)
  poke_f32(s, 20, 0.0 - v.pitch_max())
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  1

# Standing still and swinging, which is how a shaft gets dug. Take the stance
# once and leave it: the ray leaves the eye, and re-planting the feet between
# swings — on a floor that is dropping as you cut it — walks the eye about
# and the crosshair with it, so what came out was a wide scrape rather than a
# shaft. A player who holds still cuts one stone all the way down.
fn swings(s, x, z, n, acc) =
  aim_down(s, x, z)
  swing_on(s, n, acc)

fn swing_on(s, n, acc) =
  if n == 0 then acc
  else swing_on(s, n - 1, acc + v.swing_pick(s))

# Sinking a pit: a three-by-three floor of stones, one course at a time,
# standing on the floor you are cutting and dropping into it as it goes. This
# is the whole mining loop — a single stone's shaft is narrower than a body
# and cannot be followed down.
fn sink(s, x, z, courses) =
  if courses == 0 then 0
  else
    course(s, x, z, 0)
    settle(s, 30)
    sink(s, x, z, courses - 1)

fn course(s, x, z, k) =
  if k >= 9 then 0
  else
    q = v.carve_q()
    dig_cell_deep(s, x + to_float(k % 3 - 1) * q, z + to_float(k / 3 - 1) * q, 1)
    course(s, x, z, k + 1)

fn settle(s, n) =
  if n == 0 then 0
  else
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
    settle(s, n - 1)

# The lowest terrain vertex within half a metre of (x, z), or a big number if
# the mesh has none there. The mesh is 54 floats a cell, nine a vertex:
# position, normal, colour.
fn mesh_low(m, i, n, x, z, best) =
  if i >= n then best
  else
    vx = peek_f32(m, i * 9)
    vy = peek_f32(m, i * 9 + 1)
    vz = peek_f32(m, i * 9 + 2)
    near = absf(vx - x) < 0.6 && absf(vz - z) < 0.6
    mesh_low(m, i + 1, n, x, z, if near && vy < best then vy else best)

fn absf(x) = if x < 0.0 then 0.0 - x else x

# The door's way: patch by patch, cell by cell inside the page, which is the
# only shape the welcome message speaks in.
fn hand_page(w, s, sx, c) =
  if c >= v.carve_page_cells() then 0
  else
    lv = v.carve_page_lv(w, sx, c)
    if lv > 0 then v.ap_carve_page(v.wd(s), sx, c, lv) else 0
    hand_page(w, s, sx, c + 1)

# How many of six cells in a line came out dug, and how deep the deepest is.
fn trench_len(w, x, z, i, n) =
  if i >= 6 then n
  else trench_len(w, x, z, i + 1, if cell_level(w, x, z + to_float(i) * v.carve_q()) > 0 then n + 1 else n)

fn trench_max(w, x, z, i, best) =
  if i >= 6 then best
  else
    lv = cell_level(w, x, z + to_float(i) * v.carve_q())
    trench_max(w, x, z, i + 1, if lv > best then lv else best)

fn cell_level(w, x, z) = v.carve_byte(w, v.carve_cell(x, z))

fn dig_cell_deep(s, x, z, n) =
  aim_down(s, x, z)
  swing_on(s, n, 0)

fn main() =
  w = v.init(48, 60, 40, 60)
  s = v.join(w)
  (rx, rz) = find_rock(0.0 - 60.0)
  say("found rock to stand on", if v.height(rx, rz) > 11.0 then 1 else 0, 1)

  # Untouched, the carved floor is the base ground everywhere.
  say("before a swing the floor is the ground, cm", cm(v.floor_at(w, rx, rz) - v.height(rx, rz)), 0)

  # One swing: two stones out of one cell, one of them into the pocket. The
  # cell is the wall's own stone, thirty centimetres of cube, and a swing
  # takes it twice.
  aim_down(s, rx, rz)
  got = v.swing_pick(s)
  say("a swing pays one stone", got, 1)
  say("and the pocket holds it", v.stones_of(s), got)
  ci = last_cell(w)
  mx = v.cell_x(ci)
  mz = v.cell_z(ci)
  fell = v.height(mx, mz) - v.floor_at(w, mx, mz)
  say("the floor fell two stones, cm", cm(fell), 60)
  say("one bite on the ring", v.carves(w), 1)
  # Flat across the bite and square at its edge: the same depth everywhere
  # inside the cell, not a dish that is deepest in the middle. This is the
  # whole of "don't make the dug shape round" as an assertion.
  fn drop(dx, dz) = cm(v.height(mx + dx, mz + dz) - v.floor_at(w, mx + dx, mz + dz))
  say("flat one side of the cell, cm", drop(0.0 - 0.1, 0.0 - 0.1), 60)
  say("flat the other, cm", drop(0.1, 0.1), 60)
  # And no wider than the stone: a step out of the cell is untouched ground.
  say("the next stone along is untouched, cm", drop(0.3, 0.0), 0)
  say("and the one behind it too, cm", drop(0.0, 0.0 - 0.3), 0)
  # And the field paid for exactly one 128-byte page, not a lattice.
  say("one page holds the pit", v.carve_pages(w), 1)

  # A stance held is a column cut. The look stops short of the pole — see
  # `pitch_max` — so a ray still runs a few centimetres sideways for every
  # metre it runs deep, and past a couple of metres the crosshair genuinely
  # covers the next stone along. Down to six stones it does not, which is
  # what makes a shaft a shaft rather than a scrape.
  swings(s, rx, rz, 2, 0)
  say("three swings, one column", if last_cell(w) == ci then 1 else 0, 1)
  say("and it is six stones deep, cm", cm(v.height(mx, mz) - v.floor_at(w, mx, mz)), 180)

  # A second valley, fed the same ring, digs the same holes: the two floors
  # agree to the centimetre without a byte of field crossing between them.
  w2 = v.init(48, 60, 40, 60)
  s2 = v.join(w2)
  for k in 0..v.carves(w)
    v.put_carve(s2, v.carve_ev(w, k))
  say("a replayed valley has the same floor, cm", cm(v.floor_at(w2, mx, mz)), cm(v.floor_at(w, mx, mz)))
  say("and the same magma", v.magmas(w2), v.magmas(w))

  # All the way to the bottom, the way a pit is actually sunk: a floor a
  # stone wider than a body, taken a course at a time, standing in it and
  # dropping with it. Fifteen courses is nine metres and nine metres is magma.
  (dx, dz) = find_rock(rz + 9.0)
  sink(s, cell_mid_x(dx, dz), cell_mid_z(dx, dz), 15)
  px = cell_mid_x(dx, dz)
  pz = cell_mid_z(dx, dz)
  say("the pit stops at the cap, cm", cm(v.height(px, pz) - v.floor_at(w, px, pz)), 900)
  say("and the bottom is magma", if v.magmas(w) > 0 then 1 else 0, 1)

  # Standing in it burns: a fifth of a bar a second, from full. From full
  # said plainly, because sinking thirty courses is thirty small falls and a
  # digger arrives at the bottom already bruised.
  v.set_health(s, 1.0)
  v.set_at(s, px, v.floor_at(w, px, pz), pz)
  for i in 0..60
    v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("a second in the pit costs a fifth", if v.health(s) < 0.85 && v.health(s) > 0.65 then 1 else 0, 1)
  # And on the rim above it, nothing: height matters, not the map square.
  v.set_at(s, px, v.height(px, pz) + 2.0, pz)
  h0 = v.health(s)
  v.walk(s, 1.0 / 60.0, 0.0, 0.0, 0)
  say("hovering over it is free", cm(h0 - v.health(s)), 0)


  # The door's way, in miniature: a third valley handed only levels — cell
  # and nibble, the pairs the welcome message carries — stands on the same
  # floor over the same magma.
  w3 = v.init(48, 60, 40, 60)
  s3 = v.join(w3)
  for sx in 0..v.carve_supers()
    hand_page(w, s3, sx, 0)
  say("a valley handed levels has the same floor, cm", cm(v.floor_at(w3, mx, mz)), cm(v.floor_at(w, mx, mz)))
  say("with the same magma", v.magmas(w3), v.magmas(w))

  # The meadow is not for digging: a swing over grass hits nothing and pays
  # nothing.
  aim_down(s, 0.0 - 14.0, 0.0 - 34.0)
  say("the meadow refuses the pick", v.swing_pick(s), 0)

  # Building: eight stones become a rock in the block table, and a valley
  # told about it draws the same rock in the same place.
  v.set_stones(s, 20)
  n0 = v.blocks_total(w)
  say("a rock goes down", v.try_build(s), 1)
  say("the table grew by one", v.blocks_total(w) - n0, 1)
  say("and the stones were paid", v.stones_of(s), 12)
  v.put_built(s2, v.built_ev(w, 0, 1), v.built_ev(w, 0, 2), v.built_ev(w, 0, 3), v.built_ev(w, 0, 4))
  say("the told valley grew too", v.blocks_total(w2) - n0, 1)
  v.set_stones(s, 3)
  say("three stones build nothing", v.try_build(s), 0)

  # And a hosted valley — a client being told — does not swing for itself:
  # `pick_used` raises the ask and touches nothing, which is what keeps a
  # predicted crater from doubling when the server's own copy arrives.
  # On fresh rock, well clear of the pit above: its centre is magma by now,
  # and magma rightly pays a swing nothing.
  (r2x, r2z) = find_rock(rz + 7.0)
  aim_down(s, r2x, r2z)
  c0 = v.carves(w)
  v.set_hosted(w, 1)
  say("a hosted pick acts on nothing", v.pick_used(s), 0)
  say("and dug no bite of its own", v.carves(w), c0)
  v.set_hosted(w, 0)
  say("its own valley again, it digs", if v.pick_used(s) > 0 then 1 else 0, 1)

  # The mesh has to follow the field, and it has to follow it everywhere.
  # The dirty rect's empty-marker used to be read as "minx above maxz" —
  # a comparison between a distance east and a distance north — so in the
  # whole quadrant where x runs positive and z runs negative every dig was
  # reported as nothing to redraw. The pick paid, the floor dropped, you fell
  # in, and the ground still looked whole. This digs in exactly that quadrant
  # and asks the terrain mesh itself how far it came down.
#
# On a lattice fine enough to hold a one-metre bite: this valley's mesh is
# one vertex every 170/grid metres, so the coarse grid the rest of this test
# runs on cannot show a single cell at all. That is not the bug and never
# was — the browser builds at 160 — so the picture is asked of a world built
# the way the browser builds one.
  w4 = v.init(160, 60, 40, 60)
  s4 = v.join(w4)
  (qx, qz) = find_rock_from(2.0, 0.0 - 55.0)
  say("a rock in the east-and-north quadrant", if qx > 0.0 && qz < 0.0 then 1 else 0, 1)
  swings(s4, qx, qz, 2, 0)
  qmx = v.cell_x(last_cell(w4))
  qmz = v.cell_z(last_cell(w4))
  say("the field says four stones, cm", cm(v.height(qmx, qmz) - v.floor_at(w4, qmx, qmz)), 120)
  say("and the rebake had work to do", v.rebake(s4), 1)
  low = mesh_low(v.terrain(s4), 0, v.terrain_verts(s4), qmx, qmz, 9999.0)
  say("the mesh came down with it, cm", if cm(v.height(qmx, qmz) - low) > 100 then 1 else 0, 1)

  # A trench: six stand-points a metre apart, one swing each, and six cells
  # a metre deep in a straight line. This is the assertion that the digging
  # is precise — that a swing takes the cell it is aimed at and not the one
  # beside it. It failed when the floor was sampled wider than a cell: a
  # swing next to a hole found the hole's own floor under the ray and dug it
  # again, so a trench cut cell by cell piled into every other cell and came
  # out twice as deep and half as long.
# Three metres a cell, because a shallow trench hides the fault: it is the
# depth beside you that pulls a widened floor, and the ray with it, out of
# the cell you are aiming at.
  (tx0, tz0) = find_rock_from(2.0, 0.0 - 40.0)
  tx = cell_mid_x(tx0, tz0)
  tz = cell_mid_z(tx0, tz0)
  c0 = v.carves(w4)
  for i in 0..6
    dig_cell_deep(s4, tx, tz + to_float(i) * v.carve_q(), 2)
  # Where the trench really starts: the first stone the ring says came out,
  # not the spot the feet were put on. The two differ by the same eye's
  # width every time, which is why the line is still a line.
  lx = v.cell_x(v.carve_ev(w4, c0))
  lz = v.cell_z(v.carve_ev(w4, c0))
  say("six stones of trench, cut in line", trench_len(w4, lx, lz, 0, 0), 6)
  say("each of them four stones, no more", trench_max(w4, lx, lz, 0, 0), 4)

  # The crosshair's answer is the swing's answer: gold exactly where a swing
  # would land.
  aim_down(s, r2x, r2z)
  say("rock under the crosshair reads gold", v.can_mine(s), 1)
  # Straight up, not a little up: a little up from inside a pit is the pit's
  # own wall, which is rock and rightly gold.
  poke_f32(s, 20, v.pitch_max())
  say("and the sky does not", v.can_mine(s), 0)
  println("done")
