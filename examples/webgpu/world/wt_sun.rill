# The sun, now that the path is the engine's rather than the page's.
#
# It moved out of host.js because it is a function of the world clock and
# nothing else, and the clock belongs to whoever is holding the world — a
# server that hands down the hour could not say where the light was coming
# from while the tilt and the phase lived in a file only a browser reads.
#
# What is pinned here is not the arithmetic, which is short enough to read.
# It is the four things the rest of the world has quietly built on:
#
#   the day is three hundred and sixty seconds long,
#   the sun is under the horizon for a third of it,
#   the dark runs from about 230 to 320 — which is what `time=night` in
#     server.rill means, and what anyone testing after dark waits for,
#   and the path misses the zenith, because `light_vp` divides by the
#     horizontal component and a sun straight overhead has none.
#
# Change the tilt or the length of a day and this file says which of those
# went with it.
import "valley" as v

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn absf(x) = v.absf(x)

# Elevation is the negation of the y the sun's light travels along: the light
# goes down when the sun is up.
fn elev(w, t) =
  v.set_world_time(w, t)
  0.0 - v.sun_y(w)

fn horiz(w, t) =
  v.set_world_time(w, t)
  x = v.sun_x(w)
  z = v.sun_z(w)
  sqrt(x * x + z * z)

fn unit_err(w, t) =
  v.set_world_time(w, t)
  x = v.sun_x(w)
  y = v.sun_y(w)
  z = v.sun_z(w)
  absf(sqrt(x * x + y * y + z * z) - 1.0)

# How many whole seconds of the day the sun spends under the horizon, and how
# many of them are dark enough that `dayness` in common.wgsl has gone to
# nought — it fades over -0.20 to 0.14, so night proper is under -0.20.
fn under(w, i, n) =
  if i >= 360 then n
  else under(w, i + 1, n + (if elev(w, to_float(i)) < 0.0 then 1 else 0))

fn dark(w, i, n) =
  if i >= 360 then n
  else dark(w, i + 1, n + (if elev(w, to_float(i)) < 0.0 - 0.20 then 1 else 0))

fn first_dark(w, i) =
  if i >= 360 then 0 - 1
  else if elev(w, to_float(i)) < 0.0 - 0.20 then i
  else first_dark(w, i + 1)

fn last_dark(w, i, best) =
  if i >= 360 then best
  else last_dark(w, i + 1, if elev(w, to_float(i)) < 0.0 - 0.20 then i else best)

# The smallest horizontal component anywhere on the path, in thousandths.
# `light_vp` clamps at 0.02 and the tilt is meant to keep it clear of that on
# its own, so this reads well above 20.
fn min_horiz(w, i, best) =
  if i >= 360 then best
  else
    h = to_int(horiz(w, to_float(i)) * 1000.0)
    min_horiz(w, i + 1, if h < best then h else best)

fn worst_unit(w, i, best) =
  if i >= 360 then best
  else
    e = to_int(unit_err(w, to_float(i)) * 100000.0)
    worst_unit(w, i + 1, if e > best then e else best)

fn main() =
  w = v.init(32, 4, 4, 4)

  println("the sun")
  # A direction, so of length one. Lifting the circle by half its amplitude is
  # what makes the day long, and the lift is what would break this if the
  # normalisation were ever dropped.
  say("the path is a unit vector, worst error in hundred-thousandths",
      worst_unit(w, 0, 0), 0)

  # Two thirds up, one third down. This is the whole point of the lift: solve
  # A·sin θ + A/2 > 0 and θ spends 240 degrees of 360 above the horizon.
  say("seconds of the day under the horizon", under(w, 0, 0), 120)

  # And the dark that `time=night` opens into. `server.rill` puts `night` at
  # 238 and `dusk` at 222 against these two numbers, so moving them moves what
  # those words mean.
  say("the dark begins", first_dark(w, 0), 227)
  say("the dark ends", last_dark(w, 0, 0 - 1), 324)
  say("seconds of true dark", dark(w, 0, 0), 98)

  # The margin `light_vp` needs. Eight degrees off the zenith is what buys it;
  # at a clean ninety this reads nought and the shadow basis has nothing to
  # build itself from.
  say("closest the sun comes to straight overhead, thousandths of horizontal",
      if min_horiz(w, 0, 1000) > 20 then 1 else 0, 1)

  # Where a fresh valley opens, which is not where the comment in host.js said
  # it did for a long time: it claimed a few degrees under the horizon and the
  # first thing you saw was the sunrise. The lift is half the amplitude and it
  # applies at t = 0 as much as anywhere, so the sun is already a fifth of the
  # way up and it is mid-morning. Measured, and written down here rather than
  # quietly corrected, because "the day starts at dawn" is the sort of thing
  # that gets built on.
  say("the day opens with the sun already up, hundredths",
      to_int(elev(w, 0.0) * 100.0), 36)
  say("and climbing", if elev(w, 5.0) > elev(w, 0.0) then 1 else 0, 1)
  say("noon is the middle of the light",
      if elev(w, 96.0) > elev(w, 0.0) then 1 else 0, 1)
  println("done")
