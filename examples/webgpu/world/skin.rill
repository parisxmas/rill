# The figures' animation, in the engine.
#
# The page carried a small animation system: pick a clip from what a player is
# doing, keep a clock per person, sample two quaternion keyframes and take the
# short way round, blend the armed idle over the top half, walk the joint
# hierarchy, and hand the GPU one matrix per joint. All arithmetic — so it
# moved. The page's share is what it always should have been: parse the mesh
# file, upload three buffers, play nothing.
#
# The rig and the clips are pushed in once, straight into this block, in the
# layout below. Each frame `frame` walks the wire's interpolated players —
# the same twelve floats the figures are drawn from — runs the clocks, poses
# everybody, drops the rifles of the dead, writes the ghosts into the world,
# and leaves three regions for the page to upload: the instance floats, the
# joint matrices, and the held-rifle matrices.
#
# ---- the block (f32 indices unless said otherwise) --------------------------
#
#     0 J   1 clips   2 hand joint   3 capacity
#     4..9  which clip is which: idle, run, crouch, die, hit, fire
#    10 figure count (out)   11 held count (out)   12 clock rows used
#    64..79    grip (a matrix)
#    80..143   parent, one float a joint (-1 for the root)
#   144..207   upper-body weight, 0..1
#   208..399   bind translations, 3 a joint
#   416..1263  inverse bind matrices, 16 a joint
#  1280..1439  clip table: 16 floats a clip — frames, fps, loops, root,
#              rootT (f32 index), rot (byte index), seconds
#  1440..1695  clocks: 32 rows of 8 — id, clip, at, seen, firedAt, hitAt,
#              health, spare
#  1700..1955  OUT instances: 32 x 8 — x, y, z, 1, yaw, r, g, b
#  1960..2487  OUT held: 33 matrices
#  2496..29631 OUT joints: 32 x J x 16
#  29700..     scratch: local and world matrices, the model, two quaternions
#  32768..     the clip payload — root tracks as f32, rotations as i16 pairs

import "valley" as v
import "wire" as wire

fn skin_bytes() = 524288

fn cap() = 32

fn t_grip() = 64
fn t_parent() = 80
fn t_upper() = 144
fn t_bindt() = 208
fn t_inv() = 416
fn t_clip(c) = 1280 + c * 16
fn t_clock(i) = 1440 + i * 8
fn t_inst() = 1700
fn t_held() = 1960
fn t_out() = 2496
fn t_local(j) = 29700 + j * 16
fn t_world(j) = 30596 + j * 16
fn t_model() = 31492
fn t_rooted() = 31508
fn t_qa() = 31524
fn t_qb() = 31528
# What each held slot is holding — 0 the rifle, 1 the launcher, 2 the AK —
# so the page can put the right mesh on the right matrix. One float a slot,
# in the gap between the scratch and the clip pool.
fn t_heldk() = 31600
fn pool() = 32768

fn make(s) =
  b = alloc_bytes(skin_bytes())

  for i in 0..2048
    poke_f32(b, i, 0.0)

  poke_f32(b, 3, to_float(cap()))

  for i in 0..32
    poke_f32(b, t_clock(i), 0.0 - 1.0)

  poke_ptr(s, 97, b)
  b

fn joints(b) = to_int(peek_f32(b, 0))

# ---- matrices ---------------------------------------------------------------
#
# Column-major throughout, as WGSL wants them. `mul` writes o = a x b with all
# three as f32 indices into this block.

fn m_mul(b, o, a, a2) =
  for c in 0..4
    m_col(b, o, a, a2, c)

fn m_col(b, o, a, a2, c) =
  for r in 0..4
    poke_f32(b, o + c * 4 + r,
      peek_f32(b, a + r) * peek_f32(b, a2 + c * 4)
      + peek_f32(b, a + 4 + r) * peek_f32(b, a2 + c * 4 + 1)
      + peek_f32(b, a + 8 + r) * peek_f32(b, a2 + c * 4 + 2)
      + peek_f32(b, a + 12 + r) * peek_f32(b, a2 + c * 4 + 3))

# A rotation and a translation straight into a matrix; nothing in this rig is
# ever scaled, which the bake checks rather than assumes.
fn m_trs(b, at, x, y, z, qx, qy, qz, qw) =
  x2 = qx + qx
  y2 = qy + qy
  z2 = qz + qz
  xx = qx * x2
  xy = qx * y2
  xz = qx * z2
  yy = qy * y2
  yz = qy * z2
  zz = qz * z2
  wx = qw * x2
  wy = qw * y2
  wz = qw * z2
  poke_f32(b, at, 1.0 - (yy + zz))
  poke_f32(b, at + 1, xy + wz)
  poke_f32(b, at + 2, xz - wy)
  poke_f32(b, at + 3, 0.0)
  poke_f32(b, at + 4, xy - wz)
  poke_f32(b, at + 5, 1.0 - (xx + zz))
  poke_f32(b, at + 6, yz + wx)
  poke_f32(b, at + 7, 0.0)
  poke_f32(b, at + 8, xz + wy)
  poke_f32(b, at + 9, yz - wx)
  poke_f32(b, at + 10, 1.0 - (xx + yy))
  poke_f32(b, at + 11, 0.0)
  poke_f32(b, at + 12, x)
  poke_f32(b, at + 13, y)
  poke_f32(b, at + 14, z)
  poke_f32(b, at + 15, 1.0)
  1

# Where the player is, as a matrix: turned about the vertical, then put down
# on the ground. The angle is pi minus the yaw — see the page's old `place`
# for the argument; the mannequin faces +z and Rill's walk means -z.
fn m_place(b, at, x, y, z, yaw) =
  a = 3.14159265 - yaw
  c = cos(a)
  s = sin(a)
  poke_f32(b, at, c)
  poke_f32(b, at + 1, 0.0)
  poke_f32(b, at + 2, 0.0 - s)
  poke_f32(b, at + 3, 0.0)
  poke_f32(b, at + 4, 0.0)
  poke_f32(b, at + 5, 1.0)
  poke_f32(b, at + 6, 0.0)
  poke_f32(b, at + 7, 0.0)
  poke_f32(b, at + 8, s)
  poke_f32(b, at + 9, 0.0)
  poke_f32(b, at + 10, c)
  poke_f32(b, at + 11, 0.0)
  poke_f32(b, at + 12, x)
  poke_f32(b, at + 13, y)
  poke_f32(b, at + 14, z)
  poke_f32(b, at + 15, 1.0)
  1

extern fn sin(x: Float) -> Float
extern fn cos(x: Float) -> Float
extern fn sqrt(x: Float) -> Float
extern fn floor(x: Float) -> Float

fn minf(a, c) = if a < c then a else c

fn maxf(a, c) = if a > c then a else c

# ---- sampling a clip --------------------------------------------------------

fn c_frames(b, c) = to_int(peek_f32(b, t_clip(c)))

fn c_fps(b, c) = peek_f32(b, t_clip(c) + 1)

fn c_loops(b, c) = peek_f32(b, t_clip(c) + 2) > 0.5

fn c_root(b, c) = to_int(peek_f32(b, t_clip(c) + 3))

fn c_roott(b, c) = to_int(peek_f32(b, t_clip(c) + 4))

fn c_rot(b, c) = to_int(peek_f32(b, t_clip(c) + 5))

fn c_secs(b, c) = peek_f32(b, t_clip(c) + 6)

# Where in the clip a clock's seconds land: the frame below, the frame above,
# and the blend between them. Packed as f0 * 65536 + f1 with t in the header
# scratch, because a tuple would be one allocation per joint per figure.
fn cut_f(b, c, secs) =
  fr = to_float(c_frames(b, c) - 1)
  f = if c_loops(b, c) then fmod_f(maxf(secs, 0.0) * c_fps(b, c), fr) else minf(maxf(secs, 0.0) * c_fps(b, c), fr)
  f

fn fmod_f(a, m) = a - floor(a / m) * m

# One joint out of one clip at frame-blend f: quaternion into qa or qb.
fn sample(b, c, f, j, q) =
  jn = joints(b)
  f0 = to_int(floor(f))
  f1 = if f0 + 1 > c_frames(b, c) - 1 then c_frames(b, c) - 1 else f0 + 1
  t = f - floor(f)
  # `peek_i16` counts in sixteen-bit elements, not in bytes — every peek in
  # this language does, and this is the one place in the valley where a byte
  # offset meets one of them. The clip table carries where the rotations
  # start as a byte offset, because that is what the page had to write; it is
  # halved here, and a joint's four components are four elements apart rather
  # than eight bytes. Read as bytes it does not crash and it does not read
  # nothing: it reads real numbers from the wrong quarter of the clip, which
  # is a figure that is wrong in every frame and says nothing about why.
  a = c_rot(b, c) / 2 + (f0 * jn + j) * 4
  a2 = c_rot(b, c) / 2 + (f1 * jn + j) * 4
  ax = to_float(peek_i16(b, a)) / 32767.0
  ay = to_float(peek_i16(b, a + 1)) / 32767.0
  az = to_float(peek_i16(b, a + 2)) / 32767.0
  aw = to_float(peek_i16(b, a + 3)) / 32767.0
  bx0 = to_float(peek_i16(b, a2)) / 32767.0
  by0 = to_float(peek_i16(b, a2 + 1)) / 32767.0
  bz0 = to_float(peek_i16(b, a2 + 2)) / 32767.0
  bw0 = to_float(peek_i16(b, a2 + 3)) / 32767.0
  flip = if ax * bx0 + ay * by0 + az * bz0 + aw * bw0 < 0.0 then 0.0 - 1.0 else 1.0
  poke_f32(b, q, ax + (bx0 * flip - ax) * t)
  poke_f32(b, q + 1, ay + (by0 * flip - ay) * t)
  poke_f32(b, q + 2, az + (bz0 * flip - az) * t)
  poke_f32(b, q + 3, aw + (bw0 * flip - aw) * t)
  1

# qa moves w of the way to qb, the short way round. A lerp and a normalise
# rather than a slerp: the two are never far apart — one is a man running and
# the other is the same man holding a rifle.
fn mix_q(b, w) =
  d = peek_f32(b, t_qa()) * peek_f32(b, t_qb()) + peek_f32(b, t_qa() + 1) * peek_f32(b, t_qb() + 1) + peek_f32(b, t_qa() + 2) * peek_f32(b, t_qb() + 2) + peek_f32(b, t_qa() + 3) * peek_f32(b, t_qb() + 3)
  flip = if d < 0.0 then 0.0 - 1.0 else 1.0

  for i in 0..4
    poke_f32(b, t_qa() + i, peek_f32(b, t_qa() + i) + (peek_f32(b, t_qb() + i) * flip - peek_f32(b, t_qa() + i)) * w)
  1

# ---- one pose ---------------------------------------------------------------

fn pose(b, slot, clip, secs, x, y, z, yaw, over, osecs) =
  jn = joints(b)
  f = cut_f(b, clip, secs)
  fo = if over >= 0 then cut_f(b, over, osecs) else 0.0

  for j in 0..jn
    joint_local(b, clip, f, over, fo, j)

  m_place(b, t_model(), x, y, z, yaw)

  for j in 0..jn
    joint_world(b, j)

  for j in 0..jn
    joint_out(b, slot, jn, j)

  m_mul(b, t_rooted(), t_world(to_int(peek_f32(b, 2))), t_grip())

  for k in 0..16
    poke_f32(b, t_held() + slot * 16 + k, peek_f32(b, t_rooted() + k))
  1

fn joint_local(b, clip, f, over, fo, j) =
  sample(b, clip, f, j, t_qa())
  w = if over >= 0 then peek_f32(b, t_upper() + j) else 0.0
  if w > 0.001 then blend_over(b, over, fo, j, w) else 0
  qx0 = peek_f32(b, t_qa())
  qy0 = peek_f32(b, t_qa() + 1)
  qz0 = peek_f32(b, t_qa() + 2)
  qw0 = peek_f32(b, t_qa() + 3)
  n = sqrt(qx0 * qx0 + qy0 * qy0 + qz0 * qz0 + qw0 * qw0)
  nn = if n < 0.0001 then 1.0 else n
  root = c_root(b, clip)
  tx = if j == root then root_t(b, clip, f, 0) else peek_f32(b, t_bindt() + j * 3)
  ty = if j == root then root_t(b, clip, f, 1) else peek_f32(b, t_bindt() + j * 3 + 1)
  tz = if j == root then root_t(b, clip, f, 2) else peek_f32(b, t_bindt() + j * 3 + 2)
  m_trs(b, t_local(j), tx, ty, tz, qx0 / nn, qy0 / nn, qz0 / nn, qw0 / nn)

fn blend_over(b, over, fo, j, w) =
  sample(b, over, fo, j, t_qb())
  mix_q(b, w)

fn root_t(b, clip, f, k) =
  f0 = to_int(floor(f))
  f1 = if f0 + 1 > c_frames(b, clip) - 1 then c_frames(b, clip) - 1 else f0 + 1
  t = f - floor(f)
  a = c_roott(b, clip) + f0 * 3 + k
  a2 = c_roott(b, clip) + f1 * 3 + k
  peek_f32(b, a) + (peek_f32(b, a2) - peek_f32(b, a)) * t

fn joint_world(b, j) =
  p = to_int(peek_f32(b, t_parent() + j))
  if p < 0 then m_mul(b, t_world(j), t_model(), t_local(j))
  else m_mul(b, t_world(j), t_world(p), t_local(j))

fn joint_out(b, slot, jn, j) =
  m_mul(b, t_rooted(), t_world(j), t_inv() + j * 16)

  for k in 0..16
    poke_f32(b, t_out() + (slot * jn + j) * 16 + k, peek_f32(b, t_rooted() + k))
  1

# A rifle lying on the ground, on its side, pointing the way whoever was
# holding it was facing and turned a little off it. The scale comes off the
# grip, which is where the bake put the only opinion about how long a rifle
# is. A pace out in front of where they went down, rather than under them.
fn drop(b, slot, x0, y, z0, yaw, spin) =
  gs = sqrt(peek_f32(b, t_grip()) * peek_f32(b, t_grip()) + peek_f32(b, t_grip() + 1) * peek_f32(b, t_grip() + 1) + peek_f32(b, t_grip() + 2) * peek_f32(b, t_grip() + 2))
  a = yaw + spin
  dx = sin(a)
  dz = 0.0 - cos(a)
  x = x0 + sin(yaw) * 0.9
  z = z0 - cos(yaw) * 0.9
  at = t_held() + slot * 16
  poke_f32(b, at, dx * gs)
  poke_f32(b, at + 1, 0.0)
  poke_f32(b, at + 2, dz * gs)
  poke_f32(b, at + 3, 0.0)
  poke_f32(b, at + 4, 0.0 - dz * gs)
  poke_f32(b, at + 5, 0.0)
  poke_f32(b, at + 6, dx * gs)
  poke_f32(b, at + 7, 0.0)
  poke_f32(b, at + 8, 0.0)
  poke_f32(b, at + 9, 0.0 - gs)
  poke_f32(b, at + 10, 0.0)
  poke_f32(b, at + 11, 0.0)
  poke_f32(b, at + 12, x)
  poke_f32(b, at + 13, y + 0.05)
  poke_f32(b, at + 14, z)
  poke_f32(b, at + 15, 1.0)
  1

# ---- the clocks -------------------------------------------------------------
#
# One row per player: which clip they are on and how far into it, kept as a
# running total so a rate change does not throw them down the clip. Firing and
# being hit are events over whatever the legs do; down beats both.

fn clock_row(b, id) = cr_find(b, id, 0, 0 - 1)

fn cr_find(b, id, i, free) =
  if i >= 32 then if free >= 0 then claim(b, free, id) else 0
  else if to_int(peek_f32(b, t_clock(i))) == id then t_clock(i)
  else if peek_f32(b, t_clock(i)) < 0.0 - 0.5 && free < 0 then cr_find(b, id, i + 1, i)
  else cr_find(b, id, i + 1, free)

fn claim(b, i, id) =
  at = t_clock(i)
  poke_f32(b, at, to_float(id))
  poke_f32(b, at + 1, 0.0)
  poke_f32(b, at + 2, 0.0)
  poke_f32(b, at + 3, peek_f32(b, 12))
  poke_f32(b, at + 4, 0.0 - 9000.0)
  poke_f32(b, at + 5, 0.0 - 9000.0)
  poke_f32(b, at + 6, 1.0)
  at

# The page forwards a fired event here, off the wire's ring: the flinch and
# the muzzle line belong to the clip machine now.
fn fired(b, id, now) =
  at = clock_row(b, id)
  if at == 0 then 0
  else
    poke_f32(b, at + 4, now)
    1

# Which clip somebody's row wants, and the clock advanced. Returns the clip.
fn clock_step(b, s, at, pose0, health, x, y, z, yaw, now) =
  hp0 = peek_f32(b, at + 6)
  if health < hp0 - 0.001 && health > 0.001 then setf(b, at + 5, now) else 0
  if health < 0.001 && hp0 >= 0.001 then gib(s, x, y, z, yaw, at) else 0
  poke_f32(b, at + 6, health)
  shooting = now - peek_f32(b, at + 4) < c_secs(b, to_int(peek_f32(b, 9)))
  hurt = now - peek_f32(b, at + 5) < c_secs(b, to_int(peek_f32(b, 8)))
  want = want_clip(b, pose0, health, hurt, shooting)
  step = minf(now - peek_f32(b, at + 3), 0.1)
  poke_f32(b, at + 3, now)
  rate = if want == to_int(peek_f32(b, 5)) then (if pose0 == 2 then 1.73 else 1.19) else 1.0
  if to_int(peek_f32(b, at + 1)) != want then reclip(b, at, want)
  else poke_f32(b, at + 2, peek_f32(b, at + 2) + step * rate)
  want

# Down first: somebody on the ground is not flinching or shooting.
fn want_clip(b, pose0, health, hurt, shooting) =
  if health < 0.001 then to_int(peek_f32(b, 7))
  else if hurt then to_int(peek_f32(b, 8))
  else if shooting then to_int(peek_f32(b, 9))
  else if pose0 == 1 || pose0 == 2 then to_int(peek_f32(b, 5))
  else if pose0 == 3 then to_int(peek_f32(b, 6))
  else to_int(peek_f32(b, 4))

fn setf(b, i, x) =
  poke_f32(b, i, x)
  1

fn reclip(b, at, want) =
  poke_f32(b, at + 1, to_float(want))
  poke_f32(b, at + 2, 0.0)

fn gib(s, x, y, z, yaw, at) =
  v.gib_at(v.wd(s), x, y, z, yaw, to_int(peek_f32(s, 99)))
  1

# ---- one frame --------------------------------------------------------------
#
# Walks the wire's interpolated players: clocks, poses, instances, ghosts,
# and the rifles of the dead — this player's own included, in the spare held
# slot, because there is no figure for yourself and so no hand to hang it off.
fn frame(s, wb, now) =
  b = peek_ptr(s, 97)
  poke_f32(b, 12, now)
  n0 = to_int(peek_f32(wb, wire.h_interp_n()))
  n = if n0 > cap() then cap() else n0

  for i in 0..n
    one(b, s, wb, i, now)

  w = v.wd(s)
  if n < cap() then
    v.set_ghost(w, n, v.player_x(s), v.player_y(s), v.player_z(s))
    v.set_ghosts(w, n + 1)
    1
  else
    v.set_ghosts(w, n)
    1
  poke_f32(b, 10, to_float(n))
  hn = if v.health(s) <= 0.001 then own_drop(b, s, n) else n
  poke_f32(b, 11, to_float(hn))
  n

fn own_drop(b, s, n) =
  poke_f32(b, t_heldk() + n, to_float(v.weapon(s)))
  drop(b, n, v.player_x(s), v.player_y(s), v.player_z(s), peek_f32(s, 19), 1.1)
  n + 1

# The armed idle rides over the walking clips only: firing, being hit and
# going down are whole-body, and so is the idle the top half comes from.
fn one(b, s, wb, i, now) =
  o = wire.interp_at() + i * 12
  id = to_int(peek_f32(wb, o))
  x = peek_f32(wb, o + 1)
  y = peek_f32(wb, o + 2)
  z = peek_f32(wb, o + 3)
  yaw = peek_f32(wb, o + 4)
  health = peek_f32(wb, o + 6)
  pose0 = to_int(peek_f32(wb, o + 7))
  at = clock_row(b, id)
  clip = clock_step(b, s, at, pose0, health, x, y, z, yaw, now)
  runs = clip == to_int(peek_f32(b, 5)) || clip == to_int(peek_f32(b, 6))
  over = if runs then to_int(peek_f32(b, 4)) else 0 - 1
  pose(b, i, clip, peek_f32(b, at + 2), x, y, z, yaw, over, now)
  inst = t_inst() + i * 8
  poke_f32(b, inst, x)
  poke_f32(b, inst + 1, y)
  poke_f32(b, inst + 2, z)
  poke_f32(b, inst + 3, 1.0)
  poke_f32(b, inst + 4, yaw)
  poke_f32(b, inst + 5, peek_f32(wb, o + 9))
  poke_f32(b, inst + 6, peek_f32(wb, o + 10))
  poke_f32(b, inst + 7, peek_f32(wb, o + 11))
  # Slot 8 is the wire's little bitfield: the lamp in bit nought, what they
  # are holding above it. The kind rides beside the held matrix so the page
  # knows which weapon this slot's matrix is carrying.
  poke_f32(b, t_heldk() + i, to_float(to_int(peek_f32(wb, o + 8)) / 2))
  if health < 0.001 then drop(b, i, x, y, z, yaw, 0.7 + to_float(id % 5) * 0.4) else 0
  v.set_ghost(v.wd(s), i, x, y, z)
  1
