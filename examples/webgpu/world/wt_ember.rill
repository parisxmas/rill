# A meteor broken in the air, and what comes down from it.
#
# Two things are being pinned. The pieces burn: some of what a broken meteor
# throws is fire rather than rock, which is what a thing that was on fire
# leaves behind. And they are harmless: a valley where the wreckage of the
# meteor you shot down hurts you as much as the meteor would have is a valley
# where shooting one is not worth doing.
#
# The second is the one a screenshot cannot show and the one that will be
# broken by accident, because "does this make a crater" is decided in a line
# shared with rockets and crystal-fire alike.
import "valley" as v
import "ears" as ears
import "hud" as hud

fn say(what, got, want) =
  println("  " + what + ": " + int_to_str(got) + " (want " + int_to_str(want) + ")")

fn fat(i) = i * v.fireball_stride()

fn alive(fb, i, n, acc) =
  if i >= n then acc
  else alive(fb, i + 1, n, acc + if peek_f32(fb, fat(i) + 7) > 0.0 then 1 else 0)

fn embers(fb, i, n, acc) =
  if i >= n then acc
  else embers(fb, i + 1, n,
    acc + if peek_f32(fb, fat(i) + 7) > 0.0 && v.is_ember(peek_f32(fb, fat(i) + 6)) > 0 then 1 else 0)

fn steps(w, n) =
  if n == 0 then 1
  else
    v.step_world(w, 1.0 / 60.0)
    steps(w, n - 1)

fn main() =
  w = v.init(48, 40, 60, 40)
  s = v.join(w)
  fb = peek_ptr(w, 74)

  println("one meteor, broken by a round of our own")
  # Thrown by hand rather than waited for, and then actually shot: a bullet
  # put through it with the right to decide, which is the path the deciding
  # end runs. The told end is below, and the two must differ — that
  # difference is the bug this file grew a stage for.
  v.put_fireball(w, 10.0, 40.0, 10.0, 0.0, 0.0 - 6.0, 0.0, 0.5, 6.0)
  say("it is in the air", alive(fb, 0, v.fireball_cap(), 0), 1)
  say("and nothing is burning yet", embers(fb, 0, v.fireball_cap(), 0), 0)

  before = v.fires_down(w)
  b = peek_ptr(w, 68)
  poke_f32(b, 0, 10.0)
  poke_f32(b, 1, 41.5)
  poke_f32(b, 2, 10.0)
  poke_f32(b, 3, 0.0)
  poke_f32(b, 4, 0.0 - 90.0)
  poke_f32(b, 5, 0.0)
  poke_f32(b, 6, 0.0)
  poke_f32(b, 7, v.bullet_life())
  poke_f32(b, 8, v.from_ak())
  v.step_bullets(w, b, 1.0 / 60.0, 1)
  say("shooting it takes it out of the sky", alive(fb, 0, v.fireball_cap(), 0), v.ember_count())
  say("and what is left of it is on fire", embers(fb, 0, v.fireball_cap(), 0), v.ember_count())
  # Counted at this end too, which is the half that was missing. Only the end
  # that decided the shot used to count it, and in a shared valley that is
  # never the browser — so a meteor broken over your head made no sound at all
  # in the one place people actually play.
  say("the valley noticed", v.fires_down(w) - before, 1)

  # And the ears said so. The cue is what the page turns into a sound; a
  # counter that moves with nothing listening to it is the bug this pins.
  poke_ptr(s, 95, hud.make())
  e = ears.make(s)
  v.set_at(s, 10.0, 30.0, 10.0)
  poke_f32(s, 16, 10.0)
  poke_f32(s, 17, 31.0)
  poke_f32(s, 18, 10.0)
  ears.frame(s, null_ptr(), 1000.0)
  poke_f32(e, 10, 0.0)
  ears.frame(s, null_ptr(), 1001.0)
  say("and it was heard", to_int(peek_f32(e, 32)), 7)
  # From where it broke, not from wherever that ring slot ended up. Five
  # embers move in the instant it goes, so the slot is somebody else's within
  # a few meteors — and a burst measured from the wrong place is one nobody
  # hears.
  say("and from where it broke, in m", to_int(v.down_y(s) + 0.5), 40)
  say("loudly enough to matter, in hundredths",
      if peek_f32(e, 35) > 0.35 then 1 else 0, 1)

  println("and they land for nothing")
  # Run until every one of them is down. The count of blasts is the thing that
  # must not move: a blast is a crater, a noise and everybody within twenty-two
  # metres of it losing health.
  b0 = to_int(peek_f32(w, 80))
  steps(w, 600)
  say("none of them is still falling", embers(fb, 0, v.fireball_cap(), 0), 0)
  say("and not one of them cratered", to_int(peek_f32(w, 80)) - b0, 0)

  println("told about one, this end spawns no fire of its own")
  # The other half, and the half that broke multiplayer twice over. Embers go
  # through the same ring the meteors fly in, and everything pushed through
  # that ring is broadcast as a throw — so a told end that also spawned its
  # own five had a ring five slots ahead of the server's from then on. Every
  # later "shot down" index landed on a dead slot and was dropped without a
  # word: the first meteor of the match made a sound, none after it did, and
  # every broken meteor rained twice the wreckage.
  v.put_fireball(w, 10.0, 40.0, 10.0, 0.0, 0.0 - 6.0, 0.0, 0.5, 6.0)
  slot = (to_int(peek_f32(w, 63)) - 1) % v.fireball_cap()
  d0 = v.fires_down(w)
  e0 = embers(fb, 0, v.fireball_cap(), 0)
  v.down_fire(w, slot)
  say("the meteor is gone", if peek_f32(fb, slot * v.fireball_stride() + 7) <= 0.0 then 1 else 0, 1)
  say("no ember was spawned here", embers(fb, 0, v.fireball_cap(), 0) - e0, 0)
  say("but it still counts, and still sounds", v.fires_down(w) - d0, 1)

  println("named by slot, not by how many you have heard")
  # The bug this stage exists for, and the one that left a shot meteor
  # burning in the sky.
  #
  # Everything that points at a fireball points at a slot of the ring, and a
  # client's ring only lines up with the server's if it has heard every throw
  # since the valley began. Somebody who joins in the middle has a counter
  # behind for ever — so `down` names one fireball on the server and a
  # different one here, kills whatever is living at that number, and the
  # meteor it was meant for flies on and lands as though nothing had happened.
  #
  # So the slot comes down the wire with the throw. What is checked is a
  # client that has missed two: the same fireball has to end up under the same
  # name at both ends.
  w2 = v.init(48, 40, 60, 40)
  fb2 = peek_ptr(w2, 74)
  # Two throws it never heard, then one it did — at the server's slot 2.
  v.put_fireball_at(w2, 2, 20.0, 44.0, 20.0, 0.0, 0.0 - 6.0, 0.0, 0.4, 6.0)
  say("it lands in the slot it was given",
      if peek_f32(fb2, 2 * v.fireball_stride() + 7) > 0.0 then 1 else 0, 1)
  say("and no other slot has anything in it",
      alive(fb2, 0, v.fireball_cap(), 0), 1)
  # And the message that shoots it down, which carries the same number.
  v.down_fire(w2, 2)
  say("the one that was named is the one that goes",
      if peek_f32(fb2, 2 * v.fireball_stride() + 7) <= 0.0 then 1 else 0, 1)

  println("a meteor that was not shot still does")
  # The other half of the same line, because a test that only says what must
  # not happen will happily pass on a valley where nothing happens at all.
  v.put_fireball(w, 12.0, 8.0, 12.0, 0.0, 0.0 - 6.0, 0.0, 0.5, 6.0)
  c0 = to_int(peek_f32(w, 80))
  steps(w, 300)
  say("it craters where it lands", if to_int(peek_f32(w, 80)) - c0 > 0 then 1 else 0, 1)
  println("done")
