# Derived Show and Eq: every data value prints and compares structurally,
# with zero ceremony — the compiler generates show/eq per concrete type.
fn main() =
  println(Some(42))
  println(range(1, 3))
  println(Some(42) == Some(42))
  println(range(1, 3) == range(1, 3))
  println(range(1, 3) == range(1, 4))
  println(show(Ok("yes")) + "!")
  println(None == Some(1))
