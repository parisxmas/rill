# The Rill prelude — compiled into every program.
# User definitions shadow these by name; redefining a prelude type (or any of
# its constructors) also removes every prelude function that depends on it.

type Option(a)
  None
  Some(a)

type Result(a, e)
  Ok(a)
  Err(e)

type List(a)
  Nil
  Cons(head: a, tail: List(a))

# What a `machine` receives: the signal, and the mailbox it came from —
# a machine's `sender`, where its `reply` goes. A mailbox is a
# `Chan(Mail(Signal))`, and anything that sends to a machine has one of
# its own to be answered on, as every process does in SDL.
type Mail(a)
  Mail(from: Chan(Mail(a)), signal: a)

# What `(a, b)` is written with. One constructor apiece, which is what lets a
# tuple be taken apart by a binding rather than a branch.
type Tuple2(a, b)
  Tuple2(a, b)

type Tuple3(a, b, c)
  Tuple3(a, b, c)

type Tuple4(a, b, c, d)
  Tuple4(a, b, c, d)

type Tuple5(a, b, c, d, e)
  Tuple5(a, b, c, d, e)

type Tuple6(a, b, c, d, e, f)
  Tuple6(a, b, c, d, e, f)

type Tuple7(a, b, c, d, e, f, g)
  Tuple7(a, b, c, d, e, f, g)

type Tuple8(a, b, c, d, e, f, g, h)
  Tuple8(a, b, c, d, e, f, g, h)

# -- lists -------------------------------------------------------------------

# Every list function here builds its result backwards and turns it round at
# the end. Written the natural way — `Cons(f(x), map(rest, f))` — the work
# left after the recursive call is what makes it a real call, and a list long
# enough then costs a stack frame per element. Turning it round costs one more
# pass and a second cell per element, which the allocator hands back off a
# free list; running out of stack costs the program.

fn map(l, f) = map_onto(l, f, Nil)

fn map_onto(l, f, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> map_onto(rest, f, Cons(f(x), acc))

fn filter(l, p) = filter_onto(l, p, Nil)

fn filter_onto(l, p, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> filter_onto(rest, p, if p(x) then Cons(x, acc) else acc)

fn fold(l, acc, f) = match l
  Nil -> acc
  Cons(x, rest) -> fold(rest, f(acc, x), f)

fn len(l) = len_from(l, 0)

fn len_from(l, n) = match l
  Nil -> n
  Cons(_, rest) -> len_from(rest, n + 1)

fn sum(l) = fold(l, 0, \a, x -> a + x)

# Counted downwards, so the list comes out in order without a second pass.
fn range(a, b) = range_down(b, a, Nil)

fn range_down(i, a, acc) = if i < a then acc else range_down(i - 1, a, Cons(i, acc))

fn rev_onto(l, acc) = match l
  Nil -> acc
  Cons(x, rest) -> rev_onto(rest, Cons(x, acc))

fn reverse(l) = rev_onto(l, Nil)

fn append(a, b) = rev_onto(rev_onto(a, Nil), b)

fn take(l, n) = take_onto(l, n, Nil)

fn take_onto(l, n, acc) = if n <= 0 then reverse(acc) else match l
  Nil -> reverse(acc)
  Cons(x, rest) -> take_onto(rest, n - 1, Cons(x, acc))

fn drop(l, n) = if n <= 0 then l else match l
  Nil -> Nil
  Cons(_, rest) -> drop(rest, n - 1)

fn nth(l, n) = match l
  Nil -> None
  Cons(x, rest) -> if n == 0 then Some(x) else nth(rest, n - 1)

fn any(l, p) = match l
  Nil -> false
  Cons(x, rest) -> p(x) || any(rest, p)

fn all(l, p) = match l
  Nil -> true
  Cons(x, rest) -> p(x) && all(rest, p)

# -- more list combinators ----------------------------------------------------

# Each of these stands on its own — its helpers are its own, named after it —
# so a program that defines a `find` of its own loses the prelude's `find`
# and nothing else.

# The first element that satisfies `p`, if any.
fn find(l, p) = match l
  Nil -> None
  Cons(x, rest) -> if p(x) then Some(x) else find(rest, p)

# Where `x` first is, or -1.
fn index_of(l, x) = index_of_from(l, x, 0)

fn index_of_from(l, x, i) = match l
  Nil -> -1
  Cons(y, rest) -> if y == x then i else index_of_from(rest, x, i + 1)

fn has(l, x) = match l
  Nil -> false
  Cons(y, rest) -> y == x || has(rest, x)

fn count(l, p) = count_from(l, p, 0)

fn count_from(l, p, n) = match l
  Nil -> n
  Cons(x, rest) -> count_from(rest, p, if p(x) then n + 1 else n)

fn last(l) = match l
  Nil -> None
  Cons(x, Nil) -> Some(x)
  Cons(_, rest) -> last(rest)

# Calls `f` on each element, for what it does rather than what it gives.
fn each(l, f) = match l
  Nil -> ()
  Cons(x, rest) ->
    f(x)
    each(rest, f)

fn fst(p) = match p
  (a, _) -> a

fn snd(p) = match p
  (_, b) -> b

fn zip(a, b) = zip_onto(a, b, Nil)

fn zip_onto(a, b, acc) = match a
  Nil -> reverse(acc)
  Cons(x, xs) -> match b
    Nil -> reverse(acc)
    Cons(y, ys) -> zip_onto(xs, ys, Cons((x, y), acc))

fn zip_with(a, b, f) = zip_with_onto(a, b, f, Nil)

fn zip_with_onto(a, b, f, acc) = match a
  Nil -> reverse(acc)
  Cons(x, xs) -> match b
    Nil -> reverse(acc)
    Cons(y, ys) -> zip_with_onto(xs, ys, f, Cons(f(x, y), acc))

fn unzip(l) = unzip_onto(l, Nil, Nil)

fn unzip_onto(l, xs, ys) = match l
  Nil -> (reverse(xs), reverse(ys))
  Cons((x, y), rest) -> unzip_onto(rest, Cons(x, xs), Cons(y, ys))

# Each element with its position, from 0.
fn enumerate(l) = enumerate_from(l, 0, Nil)

fn enumerate_from(l, i, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> enumerate_from(rest, i + 1, Cons((i, x), acc))

fn take_while(l, p) = take_while_onto(l, p, Nil)

fn take_while_onto(l, p, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> if p(x) then take_while_onto(rest, p, Cons(x, acc)) else reverse(acc)

fn drop_while(l, p) = match l
  Nil -> Nil
  Cons(x, rest) -> if p(x) then drop_while(rest, p) else l

# The elements that satisfy `p`, and the ones that do not, in their order.
fn partition(l, p) = partition_onto(l, p, Nil, Nil)

fn partition_onto(l, p, yes, no) = match l
  Nil -> (reverse(yes), reverse(no))
  Cons(x, rest) -> if p(x) then partition_onto(rest, p, Cons(x, yes), no) else partition_onto(rest, p, yes, Cons(x, no))

fn flatten(ll) = reverse(flatten_onto(ll, Nil))

fn flatten_onto(ll, acc) = match ll
  Nil -> acc
  Cons(l, rest) -> flatten_onto(rest, flatten_rev(l, acc))

fn flatten_rev(l, acc) = match l
  Nil -> acc
  Cons(x, rest) -> flatten_rev(rest, Cons(x, acc))

fn flat_map(l, f) = reverse(flat_map_onto(l, f, Nil))

fn flat_map_onto(l, f, acc) = match l
  Nil -> acc
  Cons(x, rest) -> flat_map_onto(rest, f, flat_map_rev(f(x), acc))

fn flat_map_rev(l, acc) = match l
  Nil -> acc
  Cons(x, rest) -> flat_map_rev(rest, Cons(x, acc))

# Pieces of `n`, the last one shorter if the length does not divide.
fn chunks(l, n) = if n <= 0 then Nil else chunks_onto(l, n, Nil)

fn chunks_onto(l, n, acc) = match l
  Nil -> reverse(acc)
  _ -> chunks_onto(chunks_rest(l, n), n, Cons(chunks_head(l, n, Nil), acc))

fn chunks_head(l, n, acc) = if n <= 0 then reverse(acc) else match l
  Nil -> reverse(acc)
  Cons(x, rest) -> chunks_head(rest, n - 1, Cons(x, acc))

fn chunks_rest(l, n) = if n <= 0 then l else match l
  Nil -> Nil
  Cons(_, rest) -> chunks_rest(rest, n - 1)

# Each element once, the first time it appears.
fn distinct(l) = reverse(unique_onto(l, Nil))

fn unique_onto(l, acc) = match l
  Nil -> acc
  Cons(x, rest) -> unique_onto(rest, if unique_seen(acc, x) then acc else Cons(x, acc))

fn unique_seen(l, x) = match l
  Nil -> false
  Cons(y, rest) -> y == x || unique_seen(rest, x)

# The elements grouped by what `key` says of them, each group under its key
# in the order the keys were first seen, its members in theirs.
fn group_by(l, key) = reverse(group_by_fix(group_by_onto(l, key, Nil), Nil))

fn group_by_onto(l, key, acc) = match l
  Nil -> acc
  Cons(x, rest) -> group_by_onto(rest, key, group_by_add(acc, key(x), x))

fn group_by_add(groups, k, x) = match groups
  Nil -> Cons((k, Cons(x, Nil)), Nil)
  Cons((gk, xs), rest) -> if gk == k then Cons((k, Cons(x, xs)), rest) else Cons((gk, xs), group_by_add(rest, k, x))

fn group_by_fix(groups, acc) = match groups
  Nil -> acc
  Cons((k, xs), rest) -> group_by_fix(rest, Cons((k, group_by_rev(xs, Nil)), acc))

fn group_by_rev(l, acc) = match l
  Nil -> acc
  Cons(x, rest) -> group_by_rev(rest, Cons(x, acc))

# The element whose key is least, or greatest; the first of equals.
fn min_by(l, key) = match l
  Nil -> None
  Cons(x, rest) -> Some(min_by_from(rest, key, x, key(x)))

fn min_by_from(l, key, best, bk) = match l
  Nil -> best
  Cons(x, rest) -> min_by_from(rest, key, if key(x) < bk then x else best, if key(x) < bk then key(x) else bk)

fn max_by(l, key) = match l
  Nil -> None
  Cons(x, rest) -> Some(max_by_from(rest, key, x, key(x)))

fn max_by_from(l, key, best, bk) = match l
  Nil -> best
  Cons(x, rest) -> max_by_from(rest, key, if key(x) > bk then x else best, if key(x) > bk then key(x) else bk)

# -- sorting ------------------------------------------------------------------

# A merge sort, stable: of two elements neither before the other, the one
# that came first stays first. `sort` orders by `<`, `sort_by` by what `key`
# gives, and `sort_with` by `before(a, b)` — whether `a` may come before `b`,
# which is `<=` and not `<`, or equal elements would swap.
fn sort(l) = sort_with(l, \a, b -> a <= b)

fn sort_by(l, key) = sort_with(l, \a, b -> key(a) <= key(b))

fn sort_with(l, before) = match l
  Nil -> Nil
  Cons(_, Nil) -> l
  _ -> sort_split(l, sort_half(l, 0), before)

fn sort_half(l, n) = match l
  Nil -> n / 2
  Cons(_, rest) -> sort_half(rest, n + 1)

fn sort_split(l, n, before) =
  sort_merge(sort_with(sort_front(l, n, Nil), before), sort_with(sort_back(l, n), before), before, Nil)

fn sort_front(l, n, acc) = if n <= 0 then reverse(acc) else match l
  Nil -> reverse(acc)
  Cons(x, rest) -> sort_front(rest, n - 1, Cons(x, acc))

fn sort_back(l, n) = if n <= 0 then l else match l
  Nil -> Nil
  Cons(_, rest) -> sort_back(rest, n - 1)

fn sort_merge(a, b, before, acc) = match a
  Nil -> rev_onto(acc, b)
  Cons(x, xs) -> match b
    Nil -> rev_onto(acc, a)
    Cons(y, ys) -> if before(x, y) then sort_merge(xs, b, before, Cons(x, acc)) else sort_merge(a, ys, before, Cons(y, acc))

# The program's claim, for a `--parallel` build: this value is shared between
# strands on purpose, and the writes to it are kept apart. `apart(x)` is `x`;
# what it does is let `spawn work(apart(out))` compile where `spawn work(out)`
# is refused as a race. See "Running on several cores" in the reference.
fn apart(x) = x

# -- standard error -----------------------------------------------------------

# What `println` and `print` do, on standard error: unbuffered, so it is
# there when the program dies a line later.
fn eprintln(x) =
  file_write(2, show(x) + "\n")
  ()

fn eprint(x) =
  file_write(2, show(x))
  ()

# -- machines -----------------------------------------------------------------

# A signal to a machine from outside one: `from` is the mailbox its reply
# comes to. Inside a machine, `output(to, sig)` and `reply(sig)` say the
# same with the machine's own mailbox as the sender.
fn post(to, from, signal) =
  machine_trace("post\t" + int_to_str(chan_id(from)) + "\t" + int_to_str(chan_id(to)))
  send(to, Mail(from, signal))

# What a machine says of itself when `RILL_TRACE` is set: one event a
# line on standard error, its fields tab-separated, numbered by the runtime
# in the order they happened, a machine named with its mailbox's number —
# what `rill msc` draws. Off, this is one load per event.
fn machine_trace(text) = if tracing() == 1 then trace_line(text) else ()

fn machine_note(kind, name, me, rest) =
  machine_trace(kind + "\t" + name + "#" + int_to_str(chan_id(me)) + rest)

fn machine_id(ch) = int_to_str(chan_id(ch))

# What a `machine` with timers or saves is lowered onto; a program does not
# call these. The timers are a table from a timer's name to the moment it is
# due and the signal it delivers; the saved signals are a list in the order
# they came.

fn machine_set(timers, name, ms, signal) = map_set(timers, name, (now_millis() + ms, signal))

fn machine_reset(timers, name) =
  map_del(timers, name)
  ()

fn machine_active(timers, name) = map_has(timers, name)

# How long to wait: until the soonest timer, or `after` if that is sooner,
# and a long while when there is neither. A millisecond is added so the
# deadline has passed when the wait ends.
fn machine_wait(timers, after) =
  due = machine_due(map_items(timers), -1)
  soon = if due < 0 then -1 else max(due - now_millis() + 1, 0)
  if soon < 0 && after < 0 then 1073741824 else if soon < 0 then after else if after < 0 then soon else min(soon, after)

fn machine_due(items, best) = match items
  Nil -> best
  Cons((_, (deadline, _)), rest) -> machine_due(rest, if best < 0 || deadline < best then deadline else best)

# The soonest timer, if it has run out: taken off the table, its signal.
fn machine_expired(timers) = match machine_soonest(map_items(timers), None)
  None -> None
  Some((name, (deadline, signal))) -> if deadline <= now_millis() then machine_fire(timers, name, signal) else None

fn machine_fire(timers, name, signal) =
  map_del(timers, name)
  Some(signal)

fn machine_soonest(items, best) = match items
  Nil -> best
  Cons(item, rest) -> machine_soonest(rest, machine_sooner(item, best))

fn machine_sooner(item, best) = match best
  None -> Some(item)
  Some((_, (bd, _))) -> match item
    (_, (d, _)) -> if d < bd then Some(item) else best

# Everything the mailbox holds right now, after what was pending.
fn machine_drain(me, pending) =
  got = select
    machine.s = recv(me) -> Some(machine.s)
    default -> None
  match got
    None -> pending
    Some(s) -> machine_drain(me, append(pending, Cons(s, Nil)))

# The first pending signal with priority that the state does not save,
# and failing that the first it does not save — `machine_take` with the
# priority ones looked at first.
fn machine_take_first(pending, first, saved) =
  match machine_take_from(pending, \s -> !first(s) || saved(s), Nil)
    Some(taken) -> Some(taken)
    None -> machine_take(pending, saved)

# Whether nothing pending can be answered in this state — when a `when`
# may be taken.
fn machine_idle(pending, saved) = match machine_take(pending, saved)
  None -> true
  Some(_) -> false

# The first saved signal this state does not keep, and the rest in their
# order; `None` when it keeps them all.
fn machine_take(pending, saved) = machine_take_from(pending, saved, Nil)

fn machine_take_from(pending, saved, skipped) = match pending
  Nil -> None
  Cons(s, rest) -> if saved(s) then machine_take_from(rest, saved, Cons(s, skipped)) else Some((s, rev_onto(skipped, rest)))

# -- options and results -----------------------------------------------------

fn unwrap_or(o, d) = match o
  None -> d
  Some(x) -> x

fn opt_map(o, f) = match o
  None -> None
  Some(x) -> Some(f(x))

fn res_map(r, f) = match r
  Ok(x) -> Ok(f(x))
  Err(e) -> Err(e)

# An option as a result: the value, or the error its absence is. This is how
# a lookup joins a chain of `?`: `ok_or(m[k], "no such key")?`.
fn ok_or(o, e) = match o
  None -> Err(e)
  Some(x) -> Ok(x)

# A result with its error rewritten, which is how an error crosses from one
# layer's kind to another's: `map_err(read(path), \e -> Io(e))?`.
fn map_err(r, f) = match r
  Ok(x) -> Ok(x)
  Err(e) -> Err(f(e))

# -- maps --------------------------------------------------------------------

# Everything a program asks a map goes through its slots: `map_find` says
# which slot holds a key, `map_next` walks to the next slot with anything in
# it, and the two readers take the key or the value out of one. A slot number
# means nothing after the next insertion, so nothing here keeps one.

fn map_get(m, k) =
  i = map_find(m, k)
  if i < 0 then None else Some(map_val_at(m, i))

fn map_has(m, k) = map_find(m, k) >= 0

# The value or a default, without the `Option` in between. `unwrap_or(m[k], 0)`
# is the same answer and builds a `Some` to take it apart again, which a loop
# doing this a million times can feel.
fn map_or(m, k, d) =
  i = map_find(m, k)
  if i < 0 then d else map_val_at(m, i)

fn map_keys(m) = map_keys_from(m, 0, Nil)

fn map_keys_from(m, i, acc) =
  j = map_next(m, i)
  if j < 0 then reverse(acc) else map_keys_from(m, j + 1, Cons(map_key_at(m, j), acc))

fn map_values(m) = map_values_from(m, 0, Nil)

fn map_values_from(m, i, acc) =
  j = map_next(m, i)
  if j < 0 then reverse(acc) else map_values_from(m, j + 1, Cons(map_val_at(m, j), acc))

fn map_items(m) = map_items_from(m, 0, Nil)

fn map_items_from(m, i, acc) =
  j = map_next(m, i)
  if j < 0 then reverse(acc) else map_items_from(m, j + 1, Cons((map_key_at(m, j), map_val_at(m, j)), acc))

# The other direction: a list of pairs becomes a table.
fn map_of(items) = map_fill(map_new(), items)

fn map_fill(m, items) = match items
  Nil -> m
  Cons((k, v), rest) ->
    m[k] = v
    map_fill(m, rest)

# -- numbers -----------------------------------------------------------------

fn max(a, b) = if a > b then a else b

fn min(a, b) = if a < b then a else b

fn abs(n) = if n < 0 then -n else n

# -- strings -----------------------------------------------------------------

# Through a builder rather than `x + sep + join(rest, sep)`: that copied
# everything joined so far at every element, which is quadratic in the length
# of the result as well as a stack frame per element.

fn join(l, sep) = match l
  Nil -> ""
  Cons(x, rest) -> join_onto(strbuf(), x, rest, sep)

fn join_onto(b: StrBuf, x, rest, sep) = match rest
  Nil ->
    b += x
    strbuf_str(b)
  Cons(y, more) ->
    b += x
    b += sep
    join_onto(b, y, more, sep)

fn repeat(s, n) = if n <= 0 then "" else rep_onto(strbuf(), s, n)

fn rep_onto(b: StrBuf, s, n) =
  if n <= 0 then
    strbuf_str(b)
  else
    b += s
    rep_onto(b, s, n - 1)

fn contains(s, p) = str_find(s, p) >= 0

fn starts_with(s, p) = str_find(s, p) == 0

fn split(s, sep) = if str_len(sep) == 0 then Cons(s, Nil) else split_on(s, sep, 0, Nil)

fn split_on(s, sep, from, acc) =
  i = str_find_from(s, sep, from)
  if i < 0 then reverse(Cons(str_sub(s, from, str_len(s)), acc)) else split_on(s, sep, i + str_len(sep), Cons(str_sub(s, from, i - from), acc))

fn lines(s) = split(s, "\n")

fn is_space(c) = c == 32 || c == 9 || c == 10 || c == 13

fn trim_from(s, i) = if i < str_len(s) && is_space(str_get(s, i)) then trim_from(s, i + 1) else i

fn trim_to(s, j) = if j > 0 && is_space(str_get(s, j - 1)) then trim_to(s, j - 1) else j

fn trim(s) =
  a = trim_from(s, 0)
  b = trim_to(s, str_len(s))
  if a < b then str_sub(s, a, b - a) else ""

# -- characters, where a byte is not one ------------------------------------
#
# `#s`, `s[i]` and `s[i:j]` are bytes and stay bytes. A lexer wants bytes, a
# wire protocol wants bytes, and the compiler that compiles this file is one of
# them: changing what `#` means would change what every one of them counts.
#
# What bytes are not is characters. "günaydın" is ten bytes and eight letters,
# and `s[0:2]` cuts the ü in half and hands back something that is not text at
# all. So the characters live here, on top of the bytes, and say so in their
# names. UTF-8 is self-describing — the top bits of a byte say whether it
# begins a character and how many bytes that character takes — so none of this
# needs anything the runtime does not already have.
#
# All of it walks, because UTF-8 gives no other way to find the nth character.
# For a name or a line of a menu that is nothing; for a loop over a long string
# use `char_decode` and `char_len` together, which step through byte offsets
# without counting from the beginning each time.

# How many bytes the character beginning with this byte takes. A continuation
# byte does not begin one; it counts as a single byte so that a walk over
# malformed input keeps moving instead of standing still forever.
fn char_wide(b) =
  if b < 128 then 1 else if b < 192 then 1 else if b < 224 then 2 else if b < 240 then 3 else if b < 245 then 4 else 1

# How many bytes the character at a byte offset really takes: what its first
# byte says, when that many bytes are there and every one after the first is
# a continuation byte, and one otherwise. The first byte alone swallowed
# whatever followed it — `chr(195) + "A"` was one character, U+0081, and
# the `A` was gone (2026-09-25).
fn char_len(s, at) =
  w = char_wide(str_get(s, at))
  if w == 1 || at + w > str_len(s) then 1 else if char_conts(s, at + 1, w - 1) then w else 1

fn char_conts(s, at, k) =
  k <= 0 || str_get(s, at) >= 128 && str_get(s, at) < 192 && char_conts(s, at + 1, k - 1)

# One continuation byte's six bits.
fn char_cont(s, at) = str_get(s, at) - 128

# The character at a byte offset, as a codepoint. A character that runs off the
# end of the string, or whose continuation bytes are not there, comes back as
# its first byte: enough to tell that something is wrong, and it neither reads
# past the end nor swallows the byte that follows.
fn char_decode(s, at) =
  b = str_get(s, at)
  w = char_len(s, at)
  if w == 1 then b else if w == 2 then (b - 192) * 64 + char_cont(s, at + 1) else if w == 3 then (b - 224) * 4096 + char_cont(s, at + 1) * 64 + char_cont(s, at + 2) else (b - 240) * 262144 + char_cont(s, at + 1) * 4096 + char_cont(s, at + 2) * 64 + char_cont(s, at + 3)

# The byte offset n characters on from a byte offset, stopping at the end.
fn char_walk(s, n, at) =
  if n <= 0 || at >= str_len(s) then at else char_walk(s, n - 1, at + char_len(s, at))

# Where the ith character starts, in bytes.
fn char_offset(s, i) = char_walk(s, i, 0)

# How many characters, as against how many bytes.
fn char_count(s) = char_count_from(s, 0, 0)

fn char_count_from(s, at, n) =
  if at >= str_len(s) then n else char_count_from(s, at + char_len(s, at), n + 1)

# The ith character.
fn char_at(s, i) = char_decode(s, char_offset(s, i))

# `n` characters from character `i`, in the shape `str_sub` has: a start and a
# count rather than two ends.
fn char_sub(s, i, n) =
  a = char_offset(s, i)
  str_sub(s, a, char_walk(s, n, a) - a)

# The first `n` characters — a name that has to fit a field. Cutting by bytes
# is the thing that corrupts it, because the cut lands inside a character.
fn char_take(s, n) = char_sub(s, 0, n)

fn char_drop(s, n) =
  a = char_offset(s, n)
  str_sub(s, a, str_len(s) - a)

# Every character, in order.
fn chars(s) = reverse(chars_onto(s, 0, Nil))

fn chars_onto(s, at, acc) =
  if at >= str_len(s) then acc else chars_onto(s, at + char_len(s, at), Cons(char_decode(s, at), acc))

# A codepoint as the one to four bytes UTF-8 spells it with. `chr` is not this
# and is not meant to be: it writes a low byte and nothing else, which is right
# for building bytes and wrong for every character above 127.
fn from_char(c) = strbuf_str(char_onto(strbuf(), c))

fn char_onto(b, c) =
  if c < 128 then
    strbuf_byte(b, c)
    b
  else if c < 2048 then
    strbuf_byte(b, 192 + c / 64)
    strbuf_byte(b, 128 + c % 64)
    b
  else if c < 65536 then
    strbuf_byte(b, 224 + c / 4096)
    strbuf_byte(b, 128 + c / 64 % 64)
    strbuf_byte(b, 128 + c % 64)
    b
  else
    strbuf_byte(b, 240 + c / 262144)
    strbuf_byte(b, 128 + c / 4096 % 64)
    strbuf_byte(b, 128 + c / 64 % 64)
    strbuf_byte(b, 128 + c % 64)
    b

fn from_chars(cs) = strbuf_str(chars_into(strbuf(), cs))

fn chars_into(b, cs) =
  match cs
    Nil -> b
    Cons(c, rest) -> chars_into(char_onto(b, c), rest)

# -- process and file IO (shaping the raw builtins) --------------------------

fn args_from(i, acc) = if i < 0 then acc else args_from(i - 1, Cons(arg(i), acc))

# Command-line arguments, program name included (like Go's os.Args).
fn args() = args_from(arg_count() - 1, Nil)

fn read_file(path) =
  s = read_file_raw(path)
  if io_ok() then Ok(s) else Err("cannot read " + path)

# The one file builtin that can fail before it has done anything, wrapped the
# way `listen_on` wraps `tcp_listen`: a descriptor is a number and -1 is not a
# descriptor, so the difference is worth saying in the type.
fn open_file(path, mode) =
  fd = file_open(path, mode)
  if fd < 0 then Err("cannot open " + path + " for `" + mode + "`") else Ok(fd)

# What is in a directory, as a list rather than as the newline-separated text
# `dir_list` hands back. Empty for a directory that is not there, which
# `io_ok()` tells apart from one that is there and empty.
fn dir_names(path) =
  raw = dir_list(path)
  if str_len(raw) == 0 then Nil else without_trailing_blank(lines(raw))

# Every name `dir_list` writes has a newline after it, so splitting on lines
# leaves an empty one at the end that is not a name.
fn without_trailing_blank(ls) = match ls
  Nil -> Nil
  Cons(x, Nil) -> if str_len(x) == 0 then Nil else Cons(x, Nil)
  Cons(x, rest) -> Cons(x, without_trailing_blank(rest))

# Replaces a file without a moment in which it is neither the old one nor the
# new one: the bytes go to a temporary name, are made durable there, and are
# then moved over the real name in one step the filesystem cannot half-do.
# The directory is synced last, because until it is, the *name* is only in a
# cache however durable the bytes are.
fn replace_file(path, text) =
  tmp = path + ".new"
  fd = file_open(tmp, "w")
  if fd < 0 then Err("cannot write " + tmp)
  else
    wrote = file_write(fd, text)
    ok = file_sync(fd)
    file_close(fd)
    if wrote < str_len(text) || !ok then Err("cannot write " + tmp)
    else if !file_rename(tmp, path) then Err("cannot rename " + tmp)
    else
      dir_sync(dir_of(path))
      Ok(0)

# The directory a path is in, which is what has to be synced for the path
# itself to survive a power cut. A path with no slash in it is in this one.
fn dir_of(path) = dir_upto(path, str_len(path) - 1)

fn dir_upto(path, i) =
  if i < 0 then "." else if str_get(path, i) == 47 then if i == 0 then "/" else path[:i] else dir_upto(path, i - 1)

# -- channels ----------------------------------------------------------------

# `recv` for a channel that ends. `recv` itself keeps answering the element
# type, because most channels never end — a worker pool, a pipeline, a ticker
# — and making every one of them answer an `Option` would put a `match` in
# front of every receive in the language to pay for the few that need one.
#
# Buffered values survive the close and come out first, so a producer may close
# the moment it has nothing more to say and the consumer still sees everything
# that was in flight.
fn recv_opt(ch) = if chan_wait(ch) then Some(chan_taken(ch)) else None

# -- signals -----------------------------------------------------------------

# The numbers `wait_signal` answers with. They are functions because the
# language has no constants, and they are here rather than remembered because
# 15 in a comparison says nothing about what it is.
fn sig_hup() = 1

fn sig_int() = 2

fn sig_term() = 15

# -- sockets -----------------------------------------------------------------

fn listen_on(port) =
  fd = tcp_listen(port)
  if fd < 0 then Err("cannot listen on port " + int_to_str(port)) else Ok(fd)

# The same on one address: `listen_at("127.0.0.1", 8765)` is this machine
# alone, which a tool that runs programs on request should be.
fn listen_at(host, port) =
  fd = tcp_listen_at(host, port)
  if fd < 0 then Err("cannot listen on " + host + ":" + int_to_str(port)) else Ok(fd)

fn accept_on(server) =
  fd = tcp_accept(server)
  if fd < 0 then Err("accept failed") else Ok(fd)

fn connect_to(host, port) =
  fd = tcp_connect(host, port)
  if fd < 0 then Err("cannot connect to " + host + ":" + int_to_str(port)) else Ok(fd)
