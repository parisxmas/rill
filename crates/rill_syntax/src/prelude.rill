# The Rill prelude — compiled into every program.
# User definitions shadow these by name; redefining a prelude type (or any of
# its constructors) also removes every prelude function that depends on it.

type Option(a)
  None
  Some(a)

type Result(a, e)
  Ok(a)
  Err(e)

type List(a)
  Nil
  Cons(head: a, tail: List(a))

# What `(a, b)` is written with. One constructor apiece, which is what lets a
# tuple be taken apart by a binding rather than a branch.
type Tuple2(a, b)
  Tuple2(a, b)

type Tuple3(a, b, c)
  Tuple3(a, b, c)

type Tuple4(a, b, c, d)
  Tuple4(a, b, c, d)

type Tuple5(a, b, c, d, e)
  Tuple5(a, b, c, d, e)

type Tuple6(a, b, c, d, e, f)
  Tuple6(a, b, c, d, e, f)

type Tuple7(a, b, c, d, e, f, g)
  Tuple7(a, b, c, d, e, f, g)

type Tuple8(a, b, c, d, e, f, g, h)
  Tuple8(a, b, c, d, e, f, g, h)

# -- lists -------------------------------------------------------------------

# Every list function here builds its result backwards and turns it round at
# the end. Written the natural way — `Cons(f(x), map(rest, f))` — the work
# left after the recursive call is what makes it a real call, and a list long
# enough then costs a stack frame per element. Turning it round costs one more
# pass and a second cell per element, which the allocator hands back off a
# free list; running out of stack costs the program.

fn map(l, f) = map_onto(l, f, Nil)

fn map_onto(l, f, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> map_onto(rest, f, Cons(f(x), acc))

fn filter(l, p) = filter_onto(l, p, Nil)

fn filter_onto(l, p, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> filter_onto(rest, p, if p(x) then Cons(x, acc) else acc)

fn fold(l, acc, f) = match l
  Nil -> acc
  Cons(x, rest) -> fold(rest, f(acc, x), f)

fn len(l) = len_from(l, 0)

fn len_from(l, n) = match l
  Nil -> n
  Cons(_, rest) -> len_from(rest, n + 1)

fn sum(l) = fold(l, 0, \a, x -> a + x)

# Counted downwards, so the list comes out in order without a second pass.
fn range(a, b) = range_down(b, a, Nil)

fn range_down(i, a, acc) = if i < a then acc else range_down(i - 1, a, Cons(i, acc))

fn rev_onto(l, acc) = match l
  Nil -> acc
  Cons(x, rest) -> rev_onto(rest, Cons(x, acc))

fn reverse(l) = rev_onto(l, Nil)

fn append(a, b) = rev_onto(rev_onto(a, Nil), b)

fn take(l, n) = take_onto(l, n, Nil)

fn take_onto(l, n, acc) = if n <= 0 then reverse(acc) else match l
  Nil -> reverse(acc)
  Cons(x, rest) -> take_onto(rest, n - 1, Cons(x, acc))

fn drop(l, n) = if n <= 0 then l else match l
  Nil -> Nil
  Cons(_, rest) -> drop(rest, n - 1)

fn nth(l, n) = match l
  Nil -> None
  Cons(x, rest) -> if n == 0 then Some(x) else nth(rest, n - 1)

fn any(l, p) = match l
  Nil -> false
  Cons(x, rest) -> p(x) || any(rest, p)

fn all(l, p) = match l
  Nil -> true
  Cons(x, rest) -> p(x) && all(rest, p)

# -- options and results -----------------------------------------------------

fn unwrap_or(o, d) = match o
  None -> d
  Some(x) -> x

fn opt_map(o, f) = match o
  None -> None
  Some(x) -> Some(f(x))

fn res_map(r, f) = match r
  Ok(x) -> Ok(f(x))
  Err(e) -> Err(e)

# An option as a result: the value, or the error its absence is. This is how
# a lookup joins a chain of `?`: `ok_or(m[k], "no such key")?`.
fn ok_or(o, e) = match o
  None -> Err(e)
  Some(x) -> Ok(x)

# A result with its error rewritten, which is how an error crosses from one
# layer's kind to another's: `map_err(read(path), \e -> Io(e))?`.
fn map_err(r, f) = match r
  Ok(x) -> Ok(x)
  Err(e) -> Err(f(e))

# -- maps --------------------------------------------------------------------

# Everything a program asks a map goes through its slots: `map_find` says
# which slot holds a key, `map_next` walks to the next slot with anything in
# it, and the two readers take the key or the value out of one. A slot number
# means nothing after the next insertion, so nothing here keeps one.

fn map_get(m, k) =
  i = map_find(m, k)
  if i < 0 then None else Some(map_val_at(m, i))

fn map_has(m, k) = map_find(m, k) >= 0

# The value or a default, without the `Option` in between. `unwrap_or(m[k], 0)`
# is the same answer and builds a `Some` to take it apart again, which a loop
# doing this a million times can feel.
fn map_or(m, k, d) =
  i = map_find(m, k)
  if i < 0 then d else map_val_at(m, i)

fn map_keys(m) = map_keys_from(m, 0, Nil)

fn map_keys_from(m, i, acc) =
  j = map_next(m, i)
  if j < 0 then reverse(acc) else map_keys_from(m, j + 1, Cons(map_key_at(m, j), acc))

fn map_values(m) = map_values_from(m, 0, Nil)

fn map_values_from(m, i, acc) =
  j = map_next(m, i)
  if j < 0 then reverse(acc) else map_values_from(m, j + 1, Cons(map_val_at(m, j), acc))

fn map_items(m) = map_items_from(m, 0, Nil)

fn map_items_from(m, i, acc) =
  j = map_next(m, i)
  if j < 0 then reverse(acc) else map_items_from(m, j + 1, Cons((map_key_at(m, j), map_val_at(m, j)), acc))

# The other direction: a list of pairs becomes a table.
fn map_of(items) = map_fill(map_new(), items)

fn map_fill(m, items) = match items
  Nil -> m
  Cons((k, v), rest) ->
    m[k] = v
    map_fill(m, rest)

# -- numbers -----------------------------------------------------------------

fn max(a, b) = if a > b then a else b

fn min(a, b) = if a < b then a else b

fn abs(n) = if n < 0 then -n else n

# -- strings -----------------------------------------------------------------

# Through a builder rather than `x + sep + join(rest, sep)`: that copied
# everything joined so far at every element, which is quadratic in the length
# of the result as well as a stack frame per element.

fn join(l, sep) = match l
  Nil -> ""
  Cons(x, rest) -> join_onto(strbuf(), x, rest, sep)

fn join_onto(b: StrBuf, x, rest, sep) = match rest
  Nil ->
    b += x
    strbuf_str(b)
  Cons(y, more) ->
    b += x
    b += sep
    join_onto(b, y, more, sep)

fn repeat(s, n) = if n <= 0 then "" else rep_onto(strbuf(), s, n)

fn rep_onto(b: StrBuf, s, n) =
  if n <= 0 then
    strbuf_str(b)
  else
    b += s
    rep_onto(b, s, n - 1)

fn contains(s, p) = str_find(s, p) >= 0

fn starts_with(s, p) = str_find(s, p) == 0

fn split(s, sep) = if str_len(sep) == 0 then Cons(s, Nil) else split_on(s, sep, 0, Nil)

fn split_on(s, sep, from, acc) =
  i = str_find_from(s, sep, from)
  if i < 0 then reverse(Cons(str_sub(s, from, str_len(s)), acc)) else split_on(s, sep, i + str_len(sep), Cons(str_sub(s, from, i - from), acc))

fn lines(s) = split(s, "\n")

fn is_space(c) = c == 32 || c == 9 || c == 10 || c == 13

fn trim_from(s, i) = if i < str_len(s) && is_space(str_get(s, i)) then trim_from(s, i + 1) else i

fn trim_to(s, j) = if j > 0 && is_space(str_get(s, j - 1)) then trim_to(s, j - 1) else j

fn trim(s) =
  a = trim_from(s, 0)
  b = trim_to(s, str_len(s))
  if a < b then str_sub(s, a, b - a) else ""

# -- characters, where a byte is not one ------------------------------------
#
# `#s`, `s[i]` and `s[i:j]` are bytes and stay bytes. A lexer wants bytes, a
# wire protocol wants bytes, and the compiler that compiles this file is one of
# them: changing what `#` means would change what every one of them counts.
#
# What bytes are not is characters. "günaydın" is ten bytes and eight letters,
# and `s[0:2]` cuts the ü in half and hands back something that is not text at
# all. So the characters live here, on top of the bytes, and say so in their
# names. UTF-8 is self-describing — the top bits of a byte say whether it
# begins a character and how many bytes that character takes — so none of this
# needs anything the runtime does not already have.
#
# All of it walks, because UTF-8 gives no other way to find the nth character.
# For a name or a line of a menu that is nothing; for a loop over a long string
# use `char_decode` and `char_wide` together, which step through byte offsets
# without counting from the beginning each time.

# How many bytes the character beginning with this byte takes. A continuation
# byte does not begin one; it counts as a single byte so that a walk over
# malformed input keeps moving instead of standing still forever.
fn char_wide(b) =
  if b < 128 then 1 else if b < 192 then 1 else if b < 224 then 2 else if b < 240 then 3 else 4

# One continuation byte's six bits.
fn char_cont(s, at) = str_get(s, at) - 128

# The character at a byte offset, as a codepoint. A character that runs off the
# end of the string is truncated rather than whole, and what comes back is the
# byte itself: enough to tell that something is wrong, and it cannot read past
# the end to find out what.
fn char_decode(s, at) =
  b = str_get(s, at)
  w = char_wide(b)
  if at + w > str_len(s) then b else if w == 1 then b else if w == 2 then (b - 192) * 64 + char_cont(s, at + 1) else if w == 3 then (b - 224) * 4096 + char_cont(s, at + 1) * 64 + char_cont(s, at + 2) else (b - 240) * 262144 + char_cont(s, at + 1) * 4096 + char_cont(s, at + 2) * 64 + char_cont(s, at + 3)

# The byte offset n characters on from a byte offset, stopping at the end.
fn char_walk(s, n, at) =
  if n <= 0 || at >= str_len(s) then at else char_walk(s, n - 1, at + char_wide(str_get(s, at)))

# Where the ith character starts, in bytes.
fn char_offset(s, i) = char_walk(s, i, 0)

# How many characters, as against how many bytes.
fn char_count(s) = char_count_from(s, 0, 0)

fn char_count_from(s, at, n) =
  if at >= str_len(s) then n else char_count_from(s, at + char_wide(str_get(s, at)), n + 1)

# The ith character.
fn char_at(s, i) = char_decode(s, char_offset(s, i))

# `n` characters from character `i`, in the shape `str_sub` has: a start and a
# count rather than two ends.
fn char_sub(s, i, n) =
  a = char_offset(s, i)
  str_sub(s, a, char_walk(s, n, a) - a)

# The first `n` characters — a name that has to fit a field. Cutting by bytes
# is the thing that corrupts it, because the cut lands inside a character.
fn char_take(s, n) = char_sub(s, 0, n)

fn char_drop(s, n) =
  a = char_offset(s, n)
  str_sub(s, a, str_len(s) - a)

# Every character, in order.
fn chars(s) = reverse(chars_onto(s, 0, Nil))

fn chars_onto(s, at, acc) =
  if at >= str_len(s) then acc else chars_onto(s, at + char_wide(str_get(s, at)), Cons(char_decode(s, at), acc))

# A codepoint as the one to four bytes UTF-8 spells it with. `chr` is not this
# and is not meant to be: it writes a low byte and nothing else, which is right
# for building bytes and wrong for every character above 127.
fn from_char(c) = strbuf_str(char_onto(strbuf(), c))

fn char_onto(b, c) =
  if c < 128 then
    strbuf_byte(b, c)
    b
  else if c < 2048 then
    strbuf_byte(b, 192 + c / 64)
    strbuf_byte(b, 128 + c % 64)
    b
  else if c < 65536 then
    strbuf_byte(b, 224 + c / 4096)
    strbuf_byte(b, 128 + c / 64 % 64)
    strbuf_byte(b, 128 + c % 64)
    b
  else
    strbuf_byte(b, 240 + c / 262144)
    strbuf_byte(b, 128 + c / 4096 % 64)
    strbuf_byte(b, 128 + c / 64 % 64)
    strbuf_byte(b, 128 + c % 64)
    b

fn from_chars(cs) = strbuf_str(chars_into(strbuf(), cs))

fn chars_into(b, cs) =
  match cs
    Nil -> b
    Cons(c, rest) -> chars_into(char_onto(b, c), rest)

# -- process and file IO (shaping the raw builtins) --------------------------

fn args_from(i, acc) = if i < 0 then acc else args_from(i - 1, Cons(arg(i), acc))

# Command-line arguments, program name included (like Go's os.Args).
fn args() = args_from(arg_count() - 1, Nil)

fn read_file(path) =
  s = read_file_raw(path)
  if io_ok() then Ok(s) else Err("cannot read " + path)

# The one file builtin that can fail before it has done anything, wrapped the
# way `listen_on` wraps `tcp_listen`: a descriptor is a number and -1 is not a
# descriptor, so the difference is worth saying in the type.
fn open_file(path, mode) =
  fd = file_open(path, mode)
  if fd < 0 then Err("cannot open " + path + " for `" + mode + "`") else Ok(fd)

# What is in a directory, as a list rather than as the newline-separated text
# `dir_list` hands back. Empty for a directory that is not there, which
# `io_ok()` tells apart from one that is there and empty.
fn dir_names(path) =
  raw = dir_list(path)
  if str_len(raw) == 0 then Nil else without_trailing_blank(lines(raw))

# Every name `dir_list` writes has a newline after it, so splitting on lines
# leaves an empty one at the end that is not a name.
fn without_trailing_blank(ls) = match ls
  Nil -> Nil
  Cons(x, Nil) -> if str_len(x) == 0 then Nil else Cons(x, Nil)
  Cons(x, rest) -> Cons(x, without_trailing_blank(rest))

# Replaces a file without a moment in which it is neither the old one nor the
# new one: the bytes go to a temporary name, are made durable there, and are
# then moved over the real name in one step the filesystem cannot half-do.
# The directory is synced last, because until it is, the *name* is only in a
# cache however durable the bytes are.
fn replace_file(path, text) =
  tmp = path + ".new"
  fd = file_open(tmp, "w")
  if fd < 0 then Err("cannot write " + tmp)
  else
    wrote = file_write(fd, text)
    ok = file_sync(fd)
    file_close(fd)
    if wrote < str_len(text) || !ok then Err("cannot write " + tmp)
    else if !file_rename(tmp, path) then Err("cannot rename " + tmp)
    else
      dir_sync(dir_of(path))
      Ok(0)

# The directory a path is in, which is what has to be synced for the path
# itself to survive a power cut. A path with no slash in it is in this one.
fn dir_of(path) = dir_upto(path, str_len(path) - 1)

fn dir_upto(path, i) =
  if i < 0 then "." else if str_get(path, i) == 47 then if i == 0 then "/" else path[:i] else dir_upto(path, i - 1)

# -- channels ----------------------------------------------------------------

# `recv` for a channel that ends. `recv` itself keeps answering the element
# type, because most channels never end — a worker pool, a pipeline, a ticker
# — and making every one of them answer an `Option` would put a `match` in
# front of every receive in the language to pay for the few that need one.
#
# Buffered values survive the close and come out first, so a producer may close
# the moment it has nothing more to say and the consumer still sees everything
# that was in flight.
fn recv_opt(ch) = if chan_wait(ch) then Some(chan_taken(ch)) else None

# -- signals -----------------------------------------------------------------

# The numbers `wait_signal` answers with. They are functions because the
# language has no constants, and they are here rather than remembered because
# 15 in a comparison says nothing about what it is.
fn sig_hup() = 1

fn sig_int() = 2

fn sig_term() = 15

# -- sockets -----------------------------------------------------------------

fn listen_on(port) =
  fd = tcp_listen(port)
  if fd < 0 then Err("cannot listen on port " + int_to_str(port)) else Ok(fd)

fn accept_on(server) =
  fd = tcp_accept(server)
  if fd < 0 then Err("accept failed") else Ok(fd)

fn connect_to(host, port) =
  fd = tcp_connect(host, port)
  if fd < 0 then Err("cannot connect to " + host + ":" + int_to_str(port)) else Ok(fd)
