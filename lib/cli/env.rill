module env

# The process and its surroundings: environment variables, the working
# directory, the machine's name, the process id.
#
#     import "cli/env" as env
#     port = env.get_or("PORT", "8080")
#     match env.get("HOME")
#       Some(h) -> println(h)
#       None -> println("no home")
#     env.set("TZ", "UTC")
#     env.all()                       # List((Str, Str)), as the process has them
#     env.cwd()                       # "/Users/me/src"
#
# All of it is the C library's: `getenv`, `setenv`, `getcwd`. A value is
# copied out on the way back, so what a program holds does not change when
# the environment does.
extern fn getenv(name: Ptr) -> Ptr

extern fn setenv(name: Ptr, value: Ptr, overwrite: I32) -> I32

extern fn unsetenv(name: Ptr) -> I32

extern fn getcwd(buf: Ptr, size: USize) -> Ptr

extern fn chdir(path: Ptr) -> I32

extern fn gethostname(buf: Ptr, size: USize) -> I32

extern fn getpid() -> I32

extern fn rill_env_at(i: Int) -> Ptr

# -- variables ----------------------------------------------------------------

# The variable's value, or `None` when it is not set. An empty value is
# `Some("")`, which is a different thing from unset.
fn get(name) =
  n = to_cstr(name)
  p = getenv(n)
  free_ptr(n)
  if is_null(p) then None else Some(from_cstr(p))

fn get_or(name, fallback) = match get(name)
  Some(v) -> v
  None -> fallback

# Sets the variable, replacing what was there. `false` when the C library
# refused — a name with `=` in it, or an empty one.
fn set(name, value) =
  n = to_cstr(name)
  v = to_cstr(value)
  ok = setenv(n, v, 1) == 0
  free_ptr(n)
  free_ptr(v)
  ok

fn unset(name) =
  n = to_cstr(name)
  ok = unsetenv(n) == 0
  free_ptr(n)
  ok

# Every variable as a `(name, value)` pair, in the order the process has
# them.
fn all() = all_from(0, Nil)

private fn all_from(i, acc) =
  p = rill_env_at(i)
  if is_null(p) then reverse(acc) else all_from(i + 1, Cons(pair_of(from_cstr(p)), acc))

private fn pair_of(entry) =
  eq = str_find(entry, "=")
  if eq < 0 then (entry, "") else (entry[0:eq], entry[eq + 1:])

# -- the process ------------------------------------------------------------

# The working directory, or `""` if it has been removed under the process.
fn cwd() =
  buf = alloc_bytes(4096)
  p = getcwd(buf, 4096)
  dir = if is_null(p) then "" else from_cstr(buf)
  free_ptr(buf)
  dir

# Moves the working directory; `false` when there is no such directory or
# it cannot be entered.
fn set_cwd(path) =
  p = to_cstr(path)
  ok = chdir(p) == 0
  free_ptr(p)
  ok

fn home() = get_or("HOME", "")

fn hostname() =
  buf = alloc_bytes(256)
  name = if gethostname(buf, 255) == 0 then from_cstr(buf) else ""
  free_ptr(buf)
  name

fn pid() = getpid()

# -- tests --------------------------------------------------------------------

fn test_set_get_unset() =
  assert(set("RILL_ENV_TEST", "one"))
  assert_eq(get("RILL_ENV_TEST"), Some("one"))
  assert(set("RILL_ENV_TEST", ""))
  assert_eq(get("RILL_ENV_TEST"), Some(""))
  assert(unset("RILL_ENV_TEST"))
  assert_eq(get("RILL_ENV_TEST"), None)
  assert_eq(get_or("RILL_ENV_TEST", "fallback"), "fallback")
  assert(!set("BAD=NAME", "x"))

fn test_all_lists_what_is_set() =
  set("RILL_ENV_LISTED", "a=b")
  assert_eq(filter(all(), is_listed), Cons(("RILL_ENV_LISTED", "a=b"), Nil))
  unset("RILL_ENV_LISTED")
  assert_eq(filter(all(), is_listed), Nil)

private fn is_listed(p) = match p
  (k, _) -> k == "RILL_ENV_LISTED"

fn test_the_process() =
  here = cwd()
  assert(#here > 0)
  assert(set_cwd("/"))
  assert_eq(cwd(), "/")
  assert(set_cwd(here))
  assert(!set_cwd("/no/such/directory/anywhere"))
  assert(pid() > 0)
  assert_eq(home(), get_or("HOME", ""))
