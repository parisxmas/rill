# A client for OxiDB's document engine, written in Rill.
#
# The wire is the server's native one and the payload is binary: `oxiwire.rill`
# does the framing and the tags, shared with the time-series client. What is
# here is the document surface — collections, queries, the shapes each command
# answers with.
#
# It spoke JSON until the two were measured against each other. Binary is not
# the smaller of the two — a reply of six hundred documents came to about a
# third more bytes, fixed-width numbers being what they are — but it is
# faster: roughly two and a half times, on a local socket, against the JSON
# parser as it then stood.
#
# That last clause matters. Most of the gap was the parser rather than the
# format, and the parser has since been fixed — it took strings a byte at a
# time, which cost a string the square of its length. Measured again
# afterwards the binary is about 1.4 times faster rather than 2.5. It is still
# the faster wire and there is no reason to go back, but the honest figure is
# the smaller one, and over a slow enough link the extra bytes would take even
# that back.
#
# Every call answers `Ok(data)` or `Err(message)`. On this wire the status byte
# carries which of the two it is, so there is no `{"ok":.., "data":..}`
# envelope to unwrap. The connection is a plain socket, so a strand waiting on
# a reply parks and costs nothing.
import "oxiwire"

# -- calling ------------------------------------------------------------------

fn dial(host, port) = connect_to(host, port)

fn hang_up(fd) = sock_close(fd)

# One request, one reply, unwrapped into a `Result`.
fn call(fd, request) = ow_call(fd, request)

# -- building requests --------------------------------------------------------

# `command("find", Cons(field("collection", JStr(c)), Nil))` — the `cmd` field
# is added here so no caller has to remember its name.
fn command(name, fields) = JObj(Cons(Field("cmd", JStr(name)), fields))

fn field(key, value) = Field(key, value)

fn text(s) = JStr(s)

fn int(n) = JInt(n)

fn on(collection, fields) = Cons(Field("collection", JStr(collection)), fields)

# -- commands -----------------------------------------------------------------

fn ping(fd) = call(fd, command("ping", Nil))

fn hello(fd) =
  call(fd, command("hello", Cons(Field("wire_versions", JArr(Cons(JInt(1), Nil))), Nil)))

fn list_collections(fd) = call(fd, command("list_collections", Nil))

fn insert(fd, collection, doc) =
  call(fd, command("insert", on(collection, Cons(Field("doc", doc), Nil))))

fn insert_many(fd, collection, docs) =
  call(fd, command("insert_many", on(collection, Cons(Field("docs", JArr(docs)), Nil))))

fn find(fd, collection, query) =
  call(fd, command("find", on(collection, Cons(Field("query", query), Nil))))

# `sort` is a document like `{"age": -1}`; a limit of 0 asks for no limit.
fn find_sorted(fd, collection, query, sort, limit) =
  call(fd, command("find", on(collection, Cons(Field("query", query), Cons(Field("sort", sort), limit_field(limit))))))

fn limit_field(limit) = if limit <= 0 then Nil else Cons(Field("limit", JInt(limit)), Nil)

fn count(fd, collection) = call(fd, command("count", on(collection, Nil)))

fn update(fd, collection, query, changes) =
  call(fd, command("update", on(collection, Cons(Field("query", query), Cons(Field("update", changes), Nil)))))

fn delete(fd, collection, query) =
  call(fd, command("delete", on(collection, Cons(Field("query", query), Nil))))

fn create_index(fd, collection, field_name) =
  call(fd, command("create_index", on(collection, Cons(Field("field", JStr(field_name)), Nil))))

# `$set` is the update operator the server expects for a partial change.
fn set(fields) = JObj(Cons(Field("$set", JObj(fields)), Nil))

# -- reading results ----------------------------------------------------------

# `find` answers with an array; `insert` with `{"id": n}`; `count` with
# `{"count": n}`. These name those shapes so callers do not repeat them.
fn docs(data) = items(data)

fn inserted_id(data) = as_int(unwrap_or(get(data, "id"), JNull))

fn inserted_ids(data) = map(items(data), \d -> as_int(d))

fn counted(data) = as_int(unwrap_or(get(data, "count"), JNull))

fn modified(data) = as_int(unwrap_or(get(data, "modified"), JNull))

fn deleted(data) = as_int(unwrap_or(get(data, "deleted"), JNull))

# A field of one document, as text — `field_str(doc, "name")`.
fn field_str(doc, key) = as_str(unwrap_or(get(doc, key), JNull))

fn field_int(doc, key) = as_int(unwrap_or(get(doc, key), JNull))
