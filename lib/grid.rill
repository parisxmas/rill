  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gfloor_part(o, xd, lo, hi)) else gfloor_part(o, xd, 0, n)
    out

fn gfloor_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = floor(x[k])

fn gfloor_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = floor(o[k])

fn gceil(g: Grid) =
