    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> glog1p_part(o, xd, lo, hi)) else glog1p_part(o, xd, 0, n)
    out

fn glog1p_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = log1p(x[k])

fn glog1p_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = log1p(o[k])

fn gcbrt(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gcbrt_into(o, lo, hi)) else gcbrt_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gcbrt_part(o, xd, lo, hi)) else gcbrt_part(o, xd, 0, n)
    out

fn gcbrt_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = cbrt(x[k])

fn gcbrt_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = cbrt(o[k])

fn gfloor(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gfloor_into(o, lo, hi)) else gfloor_into(o, 0, n)
