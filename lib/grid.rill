  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gsin_into(o, lo, hi)) else gsin_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gsin_part(o, xd, lo, hi)) else gsin_part(o, xd, 0, n)
    out

fn gsin_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = sin(x[k])

fn gsin_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = sin(o[k])

