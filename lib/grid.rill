    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gceil_part(o, xd, lo, hi)) else gceil_part(o, xd, 0, n)
    out

fn gceil_part(o: Buf(Float), x: Buf(Float), lo, hi) =
