    o[k] = ceil(o[k])

fn gtrunc(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gtrunc_into(o, lo, hi)) else gtrunc_into(o, 0, n)
