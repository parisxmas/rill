module heap

# A priority queue: the least element is always at the top, and taking it
# costs a logarithm. A heap is a value — `push` and `pop` give a new heap
# and leave the old one as it was — so one can be kept, passed along, or
# sent down a channel, and two strands never contend for it.
#
#     import "coll/heap" as heap
#     h = heap.of(Cons(5, Cons(1, Cons(3, Nil))))
#     heap.peek(h)                         # Some(1)
#     match heap.pop(h)
#       Some((least, rest)) -> ...
#       None -> ...
#     heap.sorted(h)                       # Cons(1, Cons(3, Cons(5, Nil)))
#
# The order is `<` unless the heap was made with `new_with(before)`, where
# `before(a, b)` says whether `a` comes out before `b` — so a heap of
# `(priority, task)` pairs can order by the priority alone, and a max-heap
# is `new_with(\a, b -> a > b)`. This is a leftist heap: merging two is a
# walk down their right spines, which are short by construction.

type Heap(a)
  Heap(before: (a, a) -> Bool, root: Tree(a), size: Int)

type Tree(a)
  Leaf
  Node(rank: Int, item: a, left: Tree(a), right: Tree(a))

fn new() = new_with(\a, b -> a < b)

fn new_with(before) = Heap(before, Leaf, 0)

fn of(items) = of_with(items, \a, b -> a < b)

fn of_with(items, before) = fold(items, new_with(before), push)

fn push(h: Heap(a), x) = Heap(h.before, meld(h.before, Node(1, x, Leaf, Leaf), h.root), h.size + 1)

fn peek(h: Heap(a)) = match h.root
  Leaf -> None
  Node(_, x, _, _) -> Some(x)

# The least element and the heap without it, or `None` when it is empty.
fn pop(h: Heap(a)) = match h.root
  Leaf -> None
  Node(_, x, l, r) -> Some((x, Heap(h.before, meld(h.before, l, r), h.size - 1)))

fn size(h: Heap(a)) = h.size

fn is_empty(h: Heap(a)) = h.size == 0

# Both heaps as one; they must have been made with the same order.
fn merge(a: Heap(a), b: Heap(a)) = Heap(a.before, meld(a.before, a.root, b.root), a.size + b.size)

# Everything, least first.
fn sorted(h: Heap(a)) = reverse(drain(h, Nil))

private fn drain(h, acc) = match pop(h)
  None -> acc
  Some((x, rest)) -> drain(rest, Cons(x, acc))

# -- the leftist tree -------------------------------------------------------

private fn meld(before, a, b) = match a
  Leaf -> b
  Node(_, x, al, ar) -> match b
    Leaf -> a
    Node(_, y, bl, br) -> if before(y, x) then make(y, bl, meld(before, a, br)) else make(x, al, meld(before, ar, b))

# The shorter right spine goes on the right, which is what keeps the
# spines short.
private fn make(x, l, r) =
  if rank(l) >= rank(r) then Node(rank(r) + 1, x, l, r) else Node(rank(l) + 1, x, r, l)

private fn rank(t) = match t
  Leaf -> 0
  Node(k, _, _, _) -> k

# -- tests --------------------------------------------------------------------

fn test_least_first() =
  h = of(Cons(5, Cons(1, Cons(3, Cons(1, Cons(4, Nil))))))
  assert_eq(size(h), 5)
  assert_eq(peek(h), Some(1))
  assert_eq(sorted(h), Cons(1, Cons(1, Cons(3, Cons(4, Cons(5, Nil))))))
  match pop(push(new(), 7))
    None -> assert(false)
    Some((x, rest)) ->
      assert_eq(x, 7)
      assert_eq(peek(rest), None)
      assert(is_empty(rest))

fn test_a_heap_is_a_value() =
  h = push(push(new(), "b"), "a")
  match pop(h)
    None -> assert(false)
    Some((x, rest)) ->
      assert_eq(x, "a")
      assert_eq(peek(rest), Some("b"))
      assert_eq(peek(h), Some("a"))
      assert_eq(size(h), 2)
      assert_eq(size(rest), 1)

fn test_another_order() =
  h = of_with(Cons((2, "write"), Cons((1, "read"), Cons((3, "close"), Nil))), \a, b -> fst(a) < fst(b))
  assert_eq(map(sorted(h), snd), Cons("read", Cons("write", Cons("close", Nil))))
  biggest = of_with(Cons(5, Cons(9, Cons(2, Nil))), \a, b -> a > b)
  assert_eq(sorted(biggest), Cons(9, Cons(5, Cons(2, Nil))))
  both = merge(of(Cons(4, Cons(8, Nil))), of(Cons(1, Cons(6, Nil))))
  assert_eq(sorted(both), Cons(1, Cons(4, Cons(6, Cons(8, Nil)))))

fn test_many() =
  h = of(reverse(range(1, 20000)))
  assert_eq(size(h), 20000)
  assert_eq(sorted(h), range(1, 20000))
