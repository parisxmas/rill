module deque

# A queue with both ends open: push and pop at the front or the back, each
# in constant time on average. A deque is a value — every operation gives
# a new one and leaves the old as it was — so it is the queue to keep in a
# loop's state or a strand's, where a list would cost a walk to reach its
# far end.
#
#
# Two lists, one for each end, the front's in order and the back's
# reversed; when one runs dry the other is turned round to feed it, which
# is the walk a plain list would make on every pop, made once in a while.
#
#     q = deque.push_back(deque.push_back(deque.new(), "first"), "second")
#     deque.pop_front(q) |> opt_map(\p -> fst(p))   # => Some(first)
#     deque.items(q)                                # => Cons(first, Cons(second, Nil))
#     deque.size(q)                                 # => 2

type Deque(a)
  Deque(front: List(a), back: List(a), size: Int)

#     deque.is_empty(deque.new())   # => true
fn new() = Deque(Nil, Nil, 0)

#     deque.items(deque.of(Cons(1, Cons(2, Nil))))   # => Cons(1, Cons(2, Nil))
fn of(items) = Deque(items, Nil, len(items))

#     deque.size(deque.of(Cons(1, Cons(2, Cons(3, Nil)))))   # => 3
fn size(q: Deque(a)) = q.size

#     deque.is_empty(deque.of(Cons(1, Nil)))   # => false
fn is_empty(q: Deque(a)) = q.size == 0

#     deque.items(deque.push_front(deque.of(Cons(2, Nil)), 1))   # => Cons(1, Cons(2, Nil))
fn push_front(q: Deque(a), x) = Deque(Cons(x, q.front), q.back, q.size + 1)

#     deque.items(deque.push_back(deque.of(Cons(1, Nil)), 2))   # => Cons(1, Cons(2, Nil))
fn push_back(q: Deque(a), x) = Deque(q.front, Cons(x, q.back), q.size + 1)

# The front element and the deque without it, or `None` when it is empty.
#
#     q = deque.of(Cons(1, Cons(2, Nil)))
#     deque.pop_front(q) |> opt_map(\p -> fst(p))                   # => Some(1)
#     deque.pop_front(q) |> opt_map(\p -> deque.items(snd(p)))     # => Some(Cons(2, Nil))
#     deque.pop_front(deque.new())                                  # => None
fn pop_front(q: Deque(a)) = match q.front
  Cons(x, rest) -> Some((x, Deque(rest, q.back, q.size - 1)))
  Nil -> match reverse(q.back)
    Nil -> None
    Cons(x, rest) -> Some((x, Deque(rest, Nil, q.size - 1)))

#     q = deque.of(Cons(1, Cons(2, Nil)))
#     deque.pop_back(q) |> opt_map(\p -> fst(p))   # => Some(2)
fn pop_back(q: Deque(a)) = match q.back
  Cons(x, rest) -> Some((x, Deque(q.front, rest, q.size - 1)))
  Nil -> match reverse(q.front)
    Nil -> None
    Cons(x, rest) -> Some((x, Deque(Nil, rest, q.size - 1)))

#     deque.peek_front(deque.of(Cons(1, Cons(2, Nil))))   # => Some(1)
fn peek_front(q: Deque(a)) = match q.front
  Cons(x, _) -> Some(x)
  Nil -> last(q.back)

#     deque.peek_back(deque.of(Cons(1, Cons(2, Nil))))   # => Some(2)
fn peek_back(q: Deque(a)) = match q.back
  Cons(x, _) -> Some(x)
  Nil -> last(q.front)

# Everything, front to back.
#
#     q = deque.push_front(deque.push_back(deque.new(), 2), 1)
#     deque.items(q)   # => Cons(1, Cons(2, Nil))
fn items(q: Deque(a)) = append(q.front, reverse(q.back))

# -- tests --------------------------------------------------------------------

fn test_a_queue() =
  q = push_back(push_back(push_back(new(), 1), 2), 3)
  assert_eq(size(q), 3)
  assert_eq(items(q), Cons(1, Cons(2, Cons(3, Nil))))
  assert_eq(peek_front(q), Some(1))
  assert_eq(peek_back(q), Some(3))
  match pop_front(q)
    None -> assert(false)
    Some((x, rest)) ->
      assert_eq(x, 1)
      assert_eq(items(rest), Cons(2, Cons(3, Nil)))
      assert_eq(items(q), Cons(1, Cons(2, Cons(3, Nil))))

fn test_both_ends() =
  q = push_front(push_back(push_front(new(), "b"), "c"), "a")
  assert_eq(items(q), Cons("a", Cons("b", Cons("c", Nil))))
  match pop_back(q)
    None -> assert(false)
    Some((x, rest)) ->
      assert_eq(x, "c")
      assert_eq(items(rest), Cons("a", Cons("b", Nil)))
      assert_eq(peek_back(rest), Some("b"))
  match pop_back(of(Cons("only", Nil)))
    None -> assert(false)
    Some((x, rest)) ->
      assert_eq(x, "only")
      assert(is_empty(rest))
      assert_eq(peek_front(rest), None)
      assert_eq(peek_back(rest), None)

fn test_drains_in_order() =
  q = of(range(1, 10000))
  assert_eq(size(q), 10000)
  assert_eq(drained(q, Nil), range(1, 10000))
  back = fold(range(1, 5000), new(), push_back)
  assert_eq(drained(back, Nil), range(1, 5000))

private fn drained(q, acc) = match pop_front(q)
  None -> reverse(acc)
  Some((x, rest)) -> drained(rest, Cons(x, acc))
