module mime

# The media type a file is served as, from its name: `mime.of_path("a/b.png")`
# is `image/png`. The table is the hundred-odd types a web server meets;
# anything else is `application/octet-stream`, which is what a browser
# treats as "download it".
#
#     mime.of_path("site/index.html")      # => text/html
#     mime.of_ext("json")                  # => application/json
#     mime.is_text("application/json")     # => true
#     mime.ext_of("image/jpeg")            # => Some(jpg)

#     mime.of_path("a/b.png")      # => image/png
#     mime.of_path("README")       # => application/octet-stream
fn of_path(path) =
  dot = last_dot(path)
  if dot < 0 then fallback() else of_ext(path[dot + 1:])

private fn last_dot(path) =
  for i in 0..#path with at = -1
    if path[i] == 46 then i else if path[i] == 47 then -1 else at

#     mime.fallback()   # => application/octet-stream
fn fallback() = "application/octet-stream"

# The type for an extension, without its dot, in any case.
#
#     mime.of_ext("JPG")    # => image/jpeg
#     mime.of_ext("wasm")   # => application/wasm
fn of_ext(ext) = map_or(table(), lower(ext), fallback())

# An extension for a type — the usual one where several exist.
#
#     mime.ext_of("text/html")        # => Some(html)
#     mime.ext_of("x-made-up/thing")   # => None
fn ext_of(kind) = opt_map(find(pairs(), \p -> snd(p) == kind), fst)

# Whether the type is text, and is served with a charset: the `text/`
# types, and the structured ones that are text too.
#
#     mime.is_text("text/css")          # => true
#     mime.is_text("image/png")         # => false
#     mime.is_text("image/svg+xml")     # => true
fn is_text(kind) =
  starts_with(kind, "text/") || kind == "application/json" || kind == "application/javascript" || kind == "application/xml" || kind == "image/svg+xml" || ends_with(kind, "+json") || ends_with(kind, "+xml")

private fn ends_with(s, p) = #p <= #s && s[#s - #p:] == p

private fn lower(s) =
  b = buf_u8(#s)
  for i in 0..#s
    b[i] = if s[i] >= 65 && s[i] <= 90 then s[i] + 32 else s[i]
  str_from_buf(b)

private fn table() = map_of(pairs())

# Extension first, type second; the first extension listed for a type is
# the one `ext_of` gives.
private fn pairs() = map(split(list(), ";"), split_pair)

private fn split_pair(l) =
  sp = str_find(l, " ")
  (l[0:sp], trim(l[sp + 1:]))

private fn list() =
  "html text/html;htm text/html;css text/css;js application/javascript"
    + ";mjs application/javascript;json application/json;map application/json;xml application/xml"
    + ";txt text/plain;md text/markdown;csv text/csv;ics text/calendar"
    + ";rill text/plain;png image/png;jpg image/jpeg;jpeg image/jpeg"
    + ";gif image/gif;webp image/webp;avif image/avif;svg image/svg+xml"
    + ";ico image/x-icon;bmp image/bmp;tif image/tiff;tiff image/tiff"
    + ";woff font/woff;woff2 font/woff2;ttf font/ttf;otf font/otf"
    + ";mp3 audio/mpeg;ogg audio/ogg;oga audio/ogg;wav audio/wav"
    + ";flac audio/flac;m4a audio/mp4;aac audio/aac;mp4 video/mp4"
    + ";webm video/webm;mov video/quicktime;mkv video/x-matroska;avi video/x-msvideo"
    + ";pdf application/pdf;zip application/zip;gz application/gzip;tar application/x-tar"
    + ";7z application/x-7z-compressed;rar application/vnd.rar;bz2 application/x-bzip2;xz application/x-xz"
    + ";wasm application/wasm;rtf application/rtf;doc application/msword;docx application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    + ";xls application/vnd.ms-excel;xlsx application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;ppt application/vnd.ms-powerpoint;pptx application/vnd.openxmlformats-officedocument.presentationml.presentation"
    + ";odt application/vnd.oasis.opendocument.text;ods application/vnd.oasis.opendocument.spreadsheet;epub application/epub+zip;jsonld application/ld+json"
    + ";rss application/rss+xml;atom application/atom+xml;yaml application/yaml;yml application/yaml"
    + ";toml application/toml;sh application/x-sh;bin application/octet-stream;exe application/octet-stream"
    + ";dmg application/x-apple-diskimage;apk application/vnd.android.package-archive;webmanifest application/manifest+json;vtt text/vtt"
    + ";srt text/plain;m3u8 application/vnd.apple.mpegurl;ts video/mp2t;glb model/gltf-binary"
    + ";gltf model/gltf+json;stl model/stl;obj model/obj"

# -- tests --------------------------------------------------------------------

fn test_by_path_and_extension() =
  assert_eq(of_path("site/index.html"), "text/html")
  assert_eq(of_path("photo.JPG"), "image/jpeg")
  assert_eq(of_path("dir.with.dots/file"), "application/octet-stream")
  assert_eq(of_path("archive.tar.gz"), "application/gzip")
  assert_eq(of_path("unknown.zzz"), "application/octet-stream")
  assert_eq(of_ext("json"), "application/json")
  assert_eq(of_ext("WOFF2"), "font/woff2")
  assert_eq(ext_of("image/jpeg"), Some("jpg"))
  assert_eq(ext_of("text/html"), Some("html"))
  assert_eq(ext_of("nothing/like-it"), None)

fn test_text_or_not() =
  assert(is_text("text/plain"))
  assert(is_text("application/json"))
  assert(is_text("image/svg+xml"))
  assert(is_text("application/ld+json"))
  assert(!is_text("image/png"))
  assert(!is_text("application/octet-stream"))

fn test_the_table_is_well_formed() =
  ps = pairs()
  assert(len(ps) > 70)
  assert(all(ps, \p -> #fst(p) > 0 && str_find(snd(p), "/") > 0))
  assert_eq(len(distinct(map(ps, fst))), len(ps))
