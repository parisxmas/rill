# -- padding ------------------------------------------------------------------

# A message is padded to a whole number of blocks: a 0x80 byte, zeros, and
# the length in bits, big-endian, in the last 8 bytes (SHA-512 reserves 16,
# and the top 8 are zero — a message of two exabytes is not this library's
# concern).
private fn pad(msg, block) =
  n = #msg
  tail = block / 8
  rest = (n + 1) % block
  zeros = if rest <= block - tail then block - tail - rest else 2 * block - tail - rest
  out = buf_u8(n + 1 + zeros + tail)
  for i in 0..n
    out[i] = msg[i]
  out[n] = 128
  for i in 0..zeros + tail
    out[n + 1 + i] = 0
  bits = n * 8
  for j in 0..8
    out[n + 1 + zeros + tail - 8 + j] = bit_and(shr(bits, 56 - j * 8), 255)
  str_from_buf(out)

# -- HMAC ---------------------------------------------------------------------

fn hmac_sha256(key, msg) = hmac(sha256, 64, key, msg)

fn hmac_sha512(key, msg) = hmac(sha512, 128, key, msg)

# A key longer than the block is hashed down to fit; a shorter one is padded
# with zeros. Two hashes, and the key only ever meets the message through
# the inner one.
private fn hmac(hash, block, key, msg) =
  k = if #key > block then hash(key) else key
  padded = k + repeat(chr(0), block - #k)
  hash(xor_byte(padded, 92) + hash(xor_byte(padded, 54) + msg))

private fn xor_byte(bytes, b) =
  out = buf_u8(#bytes)
  for i in 0..#bytes
    out[i] = bit_xor(bytes[i], b)
  str_from_buf(out)

# -- spelling and comparing ---------------------------------------------------

# A digest as lowercase hex.
fn hex(digest) = s.hex_encode(digest)

# Whether two tags are the same, taking the same time whether they differ in
# the first byte or the last — a comparison that stops early tells a caller
# how much of a guess was right.
fn same(a, b) =
  if #a != #b then false
  else
    diff = for i in 0..#a with acc = 0
      bit_or(acc, bit_xor(a[i], b[i]))
    diff == 0

# -- tests ------------------------------------------------------------------

fn test_sha256_vectors() =
  assert_eq(hex(sha256("")), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  assert_eq(hex(sha256("abc")), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  assert_eq(hex(sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
  assert_eq(hex(sha256(repeat("a", 1000000))), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")

fn test_sha256_block_edges() =
  assert_eq(hex(sha256(repeat("a", 55))), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")
  assert_eq(hex(sha256(repeat("a", 56))), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")
  assert_eq(hex(sha256(repeat("a", 64))), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")

fn test_sha512_vectors() =
  assert_eq(hex(sha512("")), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
  assert_eq(hex(sha512("abc")), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
  assert_eq(hex(sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")

# RFC 4231's cases 1, 2, 3 and 6 — a short key, a text key, a key of one byte
# repeated, and one longer than the block.
fn test_hmac_rfc4231() =
  assert_eq(hex(hmac_sha256(repeat(chr(11), 20), "Hi There")), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
  assert_eq(hex(hmac_sha256("Jefe", "what do ya want for nothing?")), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  assert_eq(hex(hmac_sha256(repeat(chr(170), 20), repeat(chr(221), 50))), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
  assert_eq(hex(hmac_sha256(repeat(chr(170), 131), "Test Using Larger Than Block-Size Key - Hash Key First")), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
  assert_eq(hex(hmac_sha512("Jefe", "what do ya want for nothing?")), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
  assert_eq(hex(hmac_sha512(repeat(chr(170), 131), "Test Using Larger Than Block-Size Key - Hash Key First")), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")

fn test_same_is_equality() =
  a = sha256("one")
  assert(same(a, sha256("one")))
  assert(!same(a, sha256("two")))
  assert(!same(a, "short"))
