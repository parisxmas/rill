# -- SHA-512 ------------------------------------------------------------------

# The digest, as 64 raw bytes.
fn sha512(msg) =
  h = h512()
  p = pad(msg, 128)
  k = k512()
  w = buf_int(80)
  v = buf_int(8)
  blocks = #p / 128
  for blk in 0..blocks
    base = blk * 128
    for i in 0..16
      w[i] = be64_at(p, base + i * 8)
    for i in 16..80
      w[i] = w[i - 16] + sig0_64(w[i - 15]) + w[i - 7] + sig1_64(w[i - 2])
    for i in 0..8
      v[i] = h[i]
    for i in 0..80
      t1 = v[7] + big1_64(v[4]) + choose(v[4], v[5], v[6]) + k[i] + w[i]
      t2 = big0_64(v[0]) + majority(v[0], v[1], v[2])
      v[7] = v[6]
      v[6] = v[5]
      v[5] = v[4]
      v[4] = v[3] + t1
      v[3] = v[2]
      v[2] = v[1]
      v[1] = v[0]
      v[0] = t1 + t2
    for i in 0..8
      h[i] = h[i] + v[i]
  words_be64(h)

private fn rotr64(x, n) = bit_or(shr(x, n), shl(x, 64 - n))

private fn sig0_64(x) = bit_xor(bit_xor(rotr64(x, 1), rotr64(x, 8)), shr(x, 7))

private fn sig1_64(x) = bit_xor(bit_xor(rotr64(x, 19), rotr64(x, 61)), shr(x, 6))

private fn big0_64(x) = bit_xor(bit_xor(rotr64(x, 28), rotr64(x, 34)), rotr64(x, 39))

private fn big1_64(x) = bit_xor(bit_xor(rotr64(x, 14), rotr64(x, 18)), rotr64(x, 41))

private fn be64_at(p, i) = bit_or(shl(be32_at(p, i), 32), be32_at(p, i + 4))

private fn words_be64(h: Buf(Int)) =
  out = buf_u8(#h * 8)
  for i in 0..#h
    for j in 0..8
      out[i * 8 + j] = bit_and(shr(h[i], 56 - j * 8), 255)
  str_from_buf(out)

