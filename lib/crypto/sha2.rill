module sha2

# SHA-256 and SHA-512 (FIPS 180-4), and HMAC over each (RFC 2104), written
# in Rill. A digest is returned as raw bytes in a `Str`; `hex` spells one
# out. Keys and messages are bytes too: any `Str` will do.
#
#     import "crypto/sha2" as sha
#     sha.hex(sha.sha256("abc"))         # "ba7816bf…f20015ad"
#     tag = sha.hmac_sha256(secret, body)
#     sha.same(tag, sent)                # compared in constant time
#
# SHA-256 is 32-bit arithmetic on 64-bit integers, masked after each step;
# SHA-512 is the machine's own 64-bit arithmetic, which wraps as the
# algorithm wants and shifts logically, so nothing has to be masked. The
# schedule and the working state are buffers rather than lists, and a block
# is read straight out of the message.
import "text/str" as s

# -- SHA-256 ------------------------------------------------------------------

# The digest, as 32 raw bytes.
fn sha256(msg) =
  h = h256()
  p = pad(msg, 64)
  k = k256()
  w = buf_int(64)
  v = buf_int(8)
  blocks = #p / 64
  for blk in 0..blocks
    base = blk * 64
    for i in 0..16
      w[i] = be32_at(p, base + i * 4)
    for i in 16..64
      w[i] = mask32(w[i - 16] + sig0(w[i - 15]) + w[i - 7] + sig1(w[i - 2]))
    for i in 0..8
      v[i] = h[i]
    for i in 0..64
      t1 = mask32(v[7] + big1(v[4]) + choose(v[4], v[5], v[6]) + k[i] + w[i])
      t2 = mask32(big0(v[0]) + majority(v[0], v[1], v[2]))
      v[7] = v[6]
      v[6] = v[5]
      v[5] = v[4]
      v[4] = mask32(v[3] + t1)
      v[3] = v[2]
      v[2] = v[1]
      v[1] = v[0]
      v[0] = mask32(t1 + t2)
    for i in 0..8
      h[i] = mask32(h[i] + v[i])
  words_be32(h)

private fn mask32(x) = bit_and(x, 4294967295)

private fn rotr32(x, n) = mask32(bit_or(shr(x, n), shl(x, 32 - n)))

private fn sig0(x) = bit_xor(bit_xor(rotr32(x, 7), rotr32(x, 18)), shr(x, 3))

private fn sig1(x) = bit_xor(bit_xor(rotr32(x, 17), rotr32(x, 19)), shr(x, 10))

private fn big0(x) = bit_xor(bit_xor(rotr32(x, 2), rotr32(x, 13)), rotr32(x, 22))

private fn big1(x) = bit_xor(bit_xor(rotr32(x, 6), rotr32(x, 11)), rotr32(x, 25))

private fn choose(e, f, g) = bit_xor(bit_and(e, f), bit_and(bit_not(e), g))

private fn majority(a, b, c) = bit_xor(bit_xor(bit_and(a, b), bit_and(a, c)), bit_and(b, c))

private fn be32_at(p, i) =
  bit_or(bit_or(shl(p[i], 24), shl(p[i + 1], 16)), bit_or(shl(p[i + 2], 8), p[i + 3]))

private fn words_be32(h: Buf(Int)) =
  out = buf_u8(#h * 4)
  for i in 0..#h
    out[i * 4] = bit_and(shr(h[i], 24), 255)
    out[i * 4 + 1] = bit_and(shr(h[i], 16), 255)
    out[i * 4 + 2] = bit_and(shr(h[i], 8), 255)
    out[i * 4 + 3] = bit_and(h[i], 255)
  str_from_buf(out)

