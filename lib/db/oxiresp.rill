module oxiresp

# A client for OxiDB's in-memory key-value engine, written in Rill.
#
# This engine is not on the wire the other two clients here use. It listens on
# a port of its own — the server is started with OXIDB_OXIMEM_PORT — and it
# speaks RESP, the protocol Redis speaks, so what is written here is what any
# Redis client writes and the engine cannot tell them apart.
#
# RESP2, and the whole of it:
#
#   +OK\r\n              a simple string
#   -ERR no such key\r\n an error
#   :42\r\n              an integer
#   $3\r\nada\r\n        a bulk string: a length, then exactly that many bytes
#   $-1\r\n              no value
#   *2\r\n<v><v>         an array
#   *-1\r\n              no array — what EXEC answers when a transaction broke
#
# A command is an array of bulk strings and nothing else, which is why every
# argument below is a `Str`: numbers go out as their digits and come back as
# whatever the command decided to answer with.
#
# Unlike a length-prefixed wire, RESP gives no frame size up front — a reader
# has to parse to find out whether it has the whole reply. So decoding answers
# `RMore` for a reply that has not all arrived, and the socket is read again.
# One command, one reply, except while subscribed — see the bottom of this
# file, where the reply to a command and a message nobody asked for arrive
# through the same socket and have to be told apart.

type Resp
  RSimple(Str)
  RError(Str)
  RInt(Int)
  RBulk(Str)
  RNil
  RNilArray
  RArray(List(Resp))

type RespRead
  RGot(value: Resp, pos: Int)
  RMore
  RBad(why: Str, pos: Int)

# A subscription is a socket and what has been read off it but not yet used.
# Every command until now has been one write and one reply, so whatever came
# after the reply could be thrown away; a subscriber cannot do that, because
# one read may carry two messages and the second is not going to be sent
# again. So the leftover is carried, and `kv_next` answers a new subscription
# along with the message — the bytes have to live somewhere, and a binding
# does not change.
type Sub
  Sub(fd: Int, buf: Str)

type Delivery
  Message(sub: Sub, channel: Str, payload: Str)
  PatternMessage(sub: Sub, pattern: Str, channel: Str, payload: Str)
  Note(sub: Sub, kind: Str, name: Str, count: Int)
  Ended(why: Str)

# -- writing a command --------------------------------------------------------

fn resp_command(args) =
  b = strbuf()
  b += "*"
  b += int_to_str(len(args))
  b += "\r\n"
  resp_put_args(b, args)
  strbuf_str(b)

fn resp_put_args(b: StrBuf, args) = match args
  Nil -> strbuf_add(b, "")
  Cons(a, rest) ->
    b += "$"
    b += int_to_str(str_len(a))
    b += "\r\n"
    b += a
    b += "\r\n"
    resp_put_args(b, rest)

# -- reading a reply ----------------------------------------------------------

# `RMore` and `RBad` are different answers and the difference is the whole
# reason this can be driven off a socket: a reply that has not finished
# arriving is not a reply that is wrong.
fn resp_decode(s, i) =
  c = str_get(s, i)
  if c < 0 then RMore else resp_kind(s, i, c, str_find_from(s, "\r\n", i))

fn resp_kind(s, i, c, e) =
  if e < 0 then RMore else if c == 43 then RGot(RSimple(resp_head(s, i, e)), e + 2) else if c == 45 then RGot(RError(resp_head(s, i, e)), e + 2) else if c == 58 then RGot(RInt(str_to_int(resp_head(s, i, e))), e + 2) else if c == 36 then resp_bulk(s, e + 2, str_to_int(resp_head(s, i, e))) else if c == 42 then resp_array(s, e + 2, str_to_int(resp_head(s, i, e)), Nil) else RBad("no RESP value begins with `" + chr(c) + "`", i)

# The text between the type byte and the CRLF.
fn resp_head(s, i, e) = str_sub(s, i + 1, e - i - 1)

# A bulk string is the one place a length is given, so it is the one place a
# byte may be anything at all — a NUL included.
fn resp_bulk(s, i, n) =
  if n < 0 then RGot(RNil, i) else if str_len(s) < i + n + 2 then RMore else RGot(RBulk(str_sub(s, i, n)), i + n + 2)

fn resp_array(s, i, n, acc) =
  if n < 0 then RGot(RNilArray, i) else if n == 0 then RGot(RArray(reverse(acc)), i) else resp_item(s, i, n, acc)

fn resp_item(s, i, n, acc) = match resp_decode(s, i)
  RMore -> RMore
  RBad(why, pos) -> RBad(why, pos)
  RGot(v, j) -> resp_array(s, j, n - 1, Cons(v, acc))

# -- the connection -----------------------------------------------------------

fn kv_connect(host, port) = connect_to(host, port)

fn kv_hang_up(fd) = sock_close(fd)

# Every call answers `Ok(value)` or `Err(message)`. An error the server sent
# and a connection that broke are both failures, and both belong here.
fn kv_command(fd, args) =
  sock_write(fd, resp_command(args))
  resp_await(fd, "")

fn resp_await(fd, buf) = match resp_decode(buf, 0)
  RGot(v, _) -> resp_answer(v)
  RBad(why, pos) -> Err("oxidb: unreadable reply: " + why + ", at byte " + int_to_str(pos))
  RMore -> resp_fill(fd, buf)

fn resp_fill(fd, buf) =
  chunk = sock_read(fd)
  if str_len(chunk) == 0 then Err("oxidb: the connection ended mid-reply") else resp_await(fd, buf + chunk)

fn resp_answer(v) = match v
  RError(e) -> Err(e)
  _ -> Ok(v)

# -- building argument lists --------------------------------------------------

fn kv_args1(a) = Cons(a, Nil)

fn kv_args2(a, b) = Cons(a, Cons(b, Nil))

fn kv_args3(a, b, c) = Cons(a, Cons(b, Cons(c, Nil)))

fn kv_args4(a, b, c, d) = Cons(a, Cons(b, Cons(c, Cons(d, Nil))))

# -- strings ------------------------------------------------------------------

fn kv_ping(fd) = kv_command(fd, kv_args1("PING"))

fn kv_echo(fd, text) = kv_command(fd, kv_args2("ECHO", text))

fn kv_set(fd, key, value) = kv_command(fd, kv_args3("SET", key, value))

fn kv_setex(fd, key, seconds, value) =
  kv_command(fd, kv_args4("SETEX", key, int_to_str(seconds), value))

fn kv_get(fd, key) = kv_command(fd, kv_args2("GET", key))

fn kv_getset(fd, key, value) = kv_command(fd, kv_args3("GETSET", key, value))

fn kv_append(fd, key, value) = kv_command(fd, kv_args3("APPEND", key, value))

fn kv_strlen(fd, key) = kv_command(fd, kv_args2("STRLEN", key))

fn kv_incr(fd, key) = kv_command(fd, kv_args2("INCR", key))

fn kv_incrby(fd, key, by) = kv_command(fd, kv_args3("INCRBY", key, int_to_str(by)))

fn kv_mset(fd, pairs) = kv_command(fd, Cons("MSET", pairs))

fn kv_mget(fd, keys) = kv_command(fd, Cons("MGET", keys))

# -- keys ---------------------------------------------------------------------

fn kv_del(fd, key) = kv_command(fd, kv_args2("DEL", key))

fn kv_exists(fd, key) = kv_command(fd, kv_args2("EXISTS", key))

fn kv_type(fd, key) = kv_command(fd, kv_args2("TYPE", key))

fn kv_rename(fd, key, to) = kv_command(fd, kv_args3("RENAME", key, to))

fn kv_expire(fd, key, seconds) =
  kv_command(fd, kv_args3("EXPIRE", key, int_to_str(seconds)))

fn kv_ttl(fd, key) = kv_command(fd, kv_args2("TTL", key))

fn kv_persist(fd, key) = kv_command(fd, kv_args2("PERSIST", key))

fn kv_keys(fd, pattern) = kv_command(fd, kv_args2("KEYS", pattern))

fn kv_dbsize(fd) = kv_command(fd, kv_args1("DBSIZE"))

# One page of the keyspace: the cursor to carry on from, and the keys on it.
#
# `KEYS` builds the whole answer in one go and holds the engine while it does,
# which is fine for a handful of keys and wrong for a million. `SCAN` is the
# same question asked a page at a time, and the cursor is opaque — it is not a
# count and not an index, and the only thing to do with it is hand it back.
#
# A walk sees every key that was there for the whole of it. One that arrives
# during the walk may or may not turn up, and one that goes may still be
# listed; that is what a scan costs, and it is the trade every keyspace this
# size makes.
fn kv_scan(fd, cursor, pattern, count) =
  kv_command(fd, kv_scan_args(cursor, pattern, count))

fn kv_scan_args(cursor, pattern, count) =
  Cons("SCAN", Cons(cursor, Cons("MATCH", Cons(pattern, Cons("COUNT", Cons(int_to_str(count), Nil))))))

# A page is a two-element array: the cursor, then the keys.
fn kv_page_cursor(v) = match kv_list(v)
  Nil -> "0"
  Cons(c, _) -> kv_text(c)

fn kv_page_keys(v) = match kv_list(v)
  Nil -> Nil
  Cons(_, rest) -> kv_page_rest(rest)

fn kv_page_rest(rest) = match rest
  Nil -> Nil
  Cons(page, _) -> kv_texts(page)

# Every key that matches, by walking the cursor to its end.
#
# The guard is not decoration: a cursor that never reaches "0" — an engine
# with a bug in it, or a page that answers with the cursor it was given — is
# an endless loop inside a caller that only asked for a list of keys.
fn kv_scan_all(fd, pattern) = kv_scan_walk(fd, pattern, "0", Nil, 0)

fn kv_scan_walk(fd, pattern, cursor, acc, seen) =
  if seen > 10000 then acc else kv_scan_page(fd, pattern, cursor, acc, seen, kv_scan(fd, cursor, pattern, 200))

fn kv_scan_page(fd, pattern, cursor, acc, seen, answer) = match answer
  Err(_) -> acc
  Ok(v) -> kv_scan_more(fd, pattern, cursor, append(acc, kv_page_keys(v)), seen, kv_page_cursor(v))

fn kv_scan_more(fd, pattern, was, acc, seen, cursor) =
  if cursor == "0" || cursor == was then acc else kv_scan_walk(fd, pattern, cursor, acc, seen + 1)

fn kv_flushdb(fd) = kv_command(fd, kv_args1("FLUSHDB"))

fn kv_select(fd, n) = kv_command(fd, kv_args2("SELECT", int_to_str(n)))

# -- hashes -------------------------------------------------------------------

fn kv_hset(fd, key, field_name, value) =
  kv_command(fd, kv_args4("HSET", key, field_name, value))

fn kv_hget(fd, key, field_name) = kv_command(fd, kv_args3("HGET", key, field_name))

fn kv_hdel(fd, key, field_name) = kv_command(fd, kv_args3("HDEL", key, field_name))

fn kv_hgetall(fd, key) = kv_command(fd, kv_args2("HGETALL", key))

fn kv_hkeys(fd, key) = kv_command(fd, kv_args2("HKEYS", key))

fn kv_hvals(fd, key) = kv_command(fd, kv_args2("HVALS", key))

fn kv_hlen(fd, key) = kv_command(fd, kv_args2("HLEN", key))

# -- lists --------------------------------------------------------------------

fn kv_lpush(fd, key, value) = kv_command(fd, kv_args3("LPUSH", key, value))

fn kv_rpush(fd, key, value) = kv_command(fd, kv_args3("RPUSH", key, value))

fn kv_lpop(fd, key) = kv_command(fd, kv_args2("LPOP", key))

fn kv_rpop(fd, key) = kv_command(fd, kv_args2("RPOP", key))

fn kv_llen(fd, key) = kv_command(fd, kv_args2("LLEN", key))

fn kv_lrange(fd, key, start, stop) =
  kv_command(fd, kv_args4("LRANGE", key, int_to_str(start), int_to_str(stop)))

# -- sets ---------------------------------------------------------------------

fn kv_sadd(fd, key, member) = kv_command(fd, kv_args3("SADD", key, member))

fn kv_srem(fd, key, member) = kv_command(fd, kv_args3("SREM", key, member))

fn kv_sismember(fd, key, member) =
  kv_command(fd, kv_args3("SISMEMBER", key, member))

fn kv_smembers(fd, key) = kv_command(fd, kv_args2("SMEMBERS", key))

fn kv_scard(fd, key) = kv_command(fd, kv_args2("SCARD", key))

# -- sorted sets --------------------------------------------------------------

fn kv_zadd(fd, key, score, member) =
  kv_command(fd, kv_args4("ZADD", key, float_to_str(score), member))

fn kv_zscore(fd, key, member) = kv_command(fd, kv_args3("ZSCORE", key, member))

fn kv_zrem(fd, key, member) = kv_command(fd, kv_args3("ZREM", key, member))

fn kv_zcard(fd, key) = kv_command(fd, kv_args2("ZCARD", key))

fn kv_zrange(fd, key, start, stop) =
  kv_command(fd, kv_args4("ZRANGE", key, int_to_str(start), int_to_str(stop)))

# -- transactions -------------------------------------------------------------

# `MULTI` queues what follows and `EXEC` answers an array of every queued
# reply. A `WATCH`ed key that somebody else changed makes `EXEC` answer the
# null array, which is `kv_broke_off` below rather than an error.
fn kv_multi(fd) = kv_command(fd, kv_args1("MULTI"))

fn kv_exec(fd) = kv_command(fd, kv_args1("EXEC"))

fn kv_discard(fd) = kv_command(fd, kv_args1("DISCARD"))

fn kv_watch(fd, key) = kv_command(fd, kv_args2("WATCH", key))

fn kv_unwatch(fd) = kv_command(fd, kv_args1("UNWATCH"))

# -- reading values out -------------------------------------------------------

# A simple string and a bulk string are different things on the wire and the
# same thing to a caller who wanted text.
fn kv_text(v) = match v
  RSimple(s) -> s
  RBulk(s) -> s
  RInt(n) -> int_to_str(n)
  RError(e) -> e
  _ -> ""

fn kv_int(v) = match v
  RInt(n) -> n
  RBulk(s) -> str_to_int(s)
  RSimple(s) -> str_to_int(s)
  _ -> 0

fn kv_float(v) = match v
  RBulk(s) -> str_to_float(s)
  RSimple(s) -> str_to_float(s)
  RInt(n) -> str_to_float(int_to_str(n))
  _ -> 0.0

fn kv_list(v) = match v
  RArray(xs) -> xs
  _ -> Nil

fn kv_texts(v) = map(kv_list(v), \x -> kv_text(x))

# A refusal that arrived *inside* a reply.
#
# A command that fails answers `Err` — `resp_answer` lifts the engine's `-ERR`
# out of the value and into the Result, so the ordinary caller never sees one.
# `EXEC` is where they survive: it answers one array holding the answer to
# every queued command, and any of those may have failed on its own while the
# transaction as a whole did not. Walking that array is the only place this is
# the question, and there it is the only way to ask it.
#
# `kv_text` of one is the engine's own words: `WRONGTYPE Operation against a
# key holding the wrong kind of value`.
fn kv_failed(v) = match v
  RError(_) -> true
  _ -> false

# The value, for a caller that has already decided a broken connection is not
# worth branching on — a counter it can live without, a line on a status page.
fn kv_or(r, fallback) = match r
  Ok(v) -> v
  Err(_) -> fallback

# Why it failed, or "" if it did not. The engine's message, or this file's
# when the socket was the thing that broke.
fn kv_why(r) = match r
  Ok(_) -> ""
  Err(e) -> e

# A key that is not there. Distinct from the empty string, which is a value.
fn kv_missing(v) = match v
  RNil -> true
  _ -> false

# What `EXEC` answers when a `WATCH`ed key moved under the transaction.
fn kv_broke_off(v) = match v
  RNilArray -> true
  _ -> false

# -- publish and subscribe ----------------------------------------------------

# `PUBLISH` answers how many subscribers were handed the message, and it is an
# ordinary command on an ordinary connection.
#
# `SUBSCRIBE` is not. The server hands that connection to a loop of its own
# and never gives it back, so a program that both publishes and subscribes
# needs two — which is why `kv_publish` takes a socket and everything below
# takes a `Sub`.
fn kv_publish(fd, channel, payload) =
  kv_command(fd, kv_args3("PUBLISH", channel, payload))

fn kv_subscribe(fd, channels) =
  sub_start(fd, Cons("SUBSCRIBE", channels), len(channels))

# Patterns are globs: `news.*` takes `news.home` and `news.sport`, and what
# arrives says which pattern caught it as well as which channel it came from.
fn kv_psubscribe(fd, patterns) =
  sub_start(fd, Cons("PSUBSCRIBE", patterns), len(patterns))

fn sub_start(fd, args, wanted) =
  sock_write(fd, resp_command(args))
  sub_confirm(Sub(fd, ""), wanted)

# One note comes back per channel. Reading them here is what leaves the
# subscription pointed at messages rather than at its own paperwork.
fn sub_confirm(sub, remaining) =
  if remaining <= 0 then Ok(sub) else sub_confirmed(remaining, kv_next(sub))

fn sub_confirmed(remaining, delivery) = match delivery
  Note(s, _, _, _) -> sub_confirm(s, remaining - 1)
  Ended(why) -> Err(why)
  Message(_, ch, _) -> Err("oxidb: a message on `" + ch + "` arrived before the subscription was confirmed")
  PatternMessage(_, _, ch, _) -> Err("oxidb: a message on `" + ch + "` arrived before the subscription was confirmed")

# More channels on a subscription that already has some. Do this before
# anything is published to it: the notes are read back here, and a message
# that arrives in the middle of them is one this cannot put down again — it
# says so rather than dropping it.
fn kv_subscribe_more(sub, channels) =
  sub_more(sub, Cons("SUBSCRIBE", channels), len(channels))

fn kv_psubscribe_more(sub, patterns) =
  sub_more(sub, Cons("PSUBSCRIBE", patterns), len(patterns))

fn sub_more(sub, args, wanted) =
  Sub(fd, _) = sub
  sock_write(fd, resp_command(args))
  sub_confirm(sub, wanted)

fn kv_unsubscribe(sub, channels) =
  Sub(fd, _) = sub
  sock_write(fd, resp_command(Cons("UNSUBSCRIBE", channels)))
  sub_confirm(sub, len(channels))

fn kv_punsubscribe(sub, patterns) =
  Sub(fd, _) = sub
  sock_write(fd, resp_command(Cons("PUNSUBSCRIBE", patterns)))
  sub_confirm(sub, len(patterns))

fn kv_sub_hang_up(sub) =
  Sub(fd, _) = sub
  sock_close(fd)

# Waits for whatever comes next, which may be a message or the server's word
# about a subscription. A strand blocked here parks, so a subscriber costs
# nothing between messages.
fn kv_next(sub) =
  Sub(fd, buf) = sub
  sub_step(fd, buf, resp_decode(buf, 0))

fn sub_step(fd, buf, read) = match read
  RGot(v, j) -> sub_delivered(Sub(fd, str_sub(buf, j, str_len(buf) - j)), v)
  RBad(why, pos) -> Ended("oxidb: unreadable message: " + why + ", at byte " + int_to_str(pos))
  RMore -> sub_fill(fd, buf)

fn sub_fill(fd, buf) =
  chunk = sock_read(fd)
  if str_len(chunk) == 0 then Ended("oxidb: the subscription ended") else kv_next(Sub(fd, buf + chunk))

# The same as `kv_next`, with the server's paperwork passed over — for a
# caller that subscribed once and only wants what was published.
fn kv_next_message(sub) = sub_past_notes(kv_next(sub))

fn sub_past_notes(delivery) = match delivery
  Note(s, _, _, _) -> kv_next_message(s)
  _ -> delivery

# Every push is an array whose first item says what it is.
fn sub_delivered(sub, v) = match v
  RError(e) -> Ended(e)
  RArray(parts) -> sub_parts(sub, parts)
  _ -> Ended("oxidb: a subscription reply that is not an array")

fn sub_parts(sub, parts) = match parts
  Nil -> Ended("oxidb: an empty subscription reply")
  Cons(kind, rest) -> sub_kind(sub, kv_text(kind), rest)

fn sub_kind(sub, kind, rest) =
  if kind == "message" then sub_message(sub, rest) else if kind == "pmessage" then sub_pattern_message(sub, rest) else sub_note(sub, kind, rest)

fn sub_message(sub, rest) = match rest
  Cons(channel, Cons(payload, _)) -> Message(sub, kv_text(channel), kv_text(payload))
  _ -> Ended("oxidb: a message with no channel")

fn sub_pattern_message(sub, rest) = match rest
  Cons(pattern, Cons(channel, Cons(payload, _))) -> PatternMessage(sub, kv_text(pattern), kv_text(channel), kv_text(payload))
  _ -> Ended("oxidb: a pattern message missing its parts")

fn sub_note(sub, kind, rest) = match rest
  Cons(name, Cons(count, _)) -> Note(sub, kind, kv_text(name), kv_int(count))
  _ -> Ended("oxidb: a `" + kind + "` note missing its parts")

# For printing a reply whatever shape it came in.
fn kv_shown(v) = match v
  RSimple(s) -> s
  RBulk(s) -> "\"" + s + "\""
  RInt(n) -> int_to_str(n)
  RError(e) -> "error: " + e
  RNil -> "nil"
  RNilArray -> "nil-array"
  RArray(xs) -> "[" + join(map(xs, \x -> kv_shown(x)), ", ") + "]"
