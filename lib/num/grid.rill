# To the nearest whole number, a half going to the even one — what `rint`
# does and what NumPy's `round` and `rint` both do. C's `round` sends a half
# away from zero instead, which would put `round(2.5)` at 3 and `round(-2.5)`
# at -3; this puts both at 2 and -2.
#
#     g.ground(g.of(Cons(2.5, Cons(3.5, Cons(-2.5, Nil)))))   # => [2, 4, -2]
fn ground(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> ground_into(o, lo, hi)) else ground_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> ground_part(o, xd, lo, hi)) else ground_part(o, xd, 0, n)
    out

private fn ground_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = rint(x[k])

private fn ground_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = rint(o[k])

#     g.grint(g.of(Cons(0.5, Cons(1.5, Nil))))   # => [0, 2]
fn grint(g: Grid) = ground(g)

#     g.gsquare(g.arange(4))   # => [0, 1, 4, 9]
fn gsquare(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gsquare_into(o, lo, hi)) else gsquare_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gsquare_part(o, xd, lo, hi)) else gsquare_part(o, xd, 0, n)
    out

private fn gsquare_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] * x[k]

private fn gsquare_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] * o[k]

#     g.greciprocal(g.of(Cons(2.0, Cons(4.0, Nil))))   # => [0.5, 0.25]
fn greciprocal(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> greciprocal_into(o, lo, hi)) else greciprocal_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> greciprocal_part(o, xd, lo, hi)) else greciprocal_part(o, xd, 0, n)
    out

private fn greciprocal_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = 1.0 / x[k]

private fn greciprocal_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = 1.0 / o[k]

# 1 where positive, -1 where negative, and zero left as it is (sign included).
#
#     g.gsign(g.of(Cons(-3.0, Cons(0.0, Cons(2.0, Nil)))))   # => [-1, 0, 1]
fn gsign(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gsign_into(o, lo, hi)) else gsign_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gsign_part(o, xd, lo, hi)) else gsign_part(o, xd, 0, n)
    out

private fn gsign_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = sign_of(x[k])

private fn gsign_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = sign_of(o[k])

private fn sign_of(v) = if v > 0.0 then 1.0 else if v < 0.0 then -1.0 else v

#     g.gdegrees(g.of(Cons(g.pi(), Nil)))   # => [180]
fn gdegrees(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gdegrees_into(o, lo, hi)) else gdegrees_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gdegrees_part(o, xd, lo, hi)) else gdegrees_part(o, xd, 0, n)
    out

private fn gdegrees_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] * 57.29577951308232

private fn gdegrees_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] * 57.29577951308232

#     g.gradians(g.of(Cons(180.0, Nil))) |> g.allclose(g.of(Cons(g.pi(), Nil)), 0.000001)   # => true
fn gradians(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gradians_into(o, lo, hi)) else gradians_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gradians_part(o, xd, lo, hi)) else gradians_part(o, xd, 0, n)
    out

private fn gradians_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] * 0.017453292519943295

private fn gradians_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] * 0.017453292519943295

# Held between `a` and `b`.
#
#     g.gclip(g.arange(5), 1.0, 3.0)   # => [1, 1, 2, 3, 3]
fn gclip(g: Grid, a, b) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gclip_into(o, a, b, lo, hi)) else gclip_into(o, a, b, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gclip_part(o, xd, a, b, lo, hi)) else gclip_part(o, xd, a, b, 0, n)
    out

private fn gclip_part(o: Buf(Float), x: Buf(Float), a, b, lo, hi) =
  for k in lo..hi
    o[k] = if x[k] < a then a else if x[k] > b then b else x[k]

private fn gclip_into(o: Buf(Float), a, b, lo, hi) =
  for k in lo..hi
    o[k] = if o[k] < a then a else if o[k] > b then b else o[k]

# The larger, and the smaller, of each element and one number.
#
#     g.gmaxk(g.arange(3), 1.0)   # => [1, 1, 2]
fn gmaxk(g: Grid, v) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gmaxk_into(o, v, lo, hi)) else gmaxk_into(o, v, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gmaxk_part(o, xd, v, lo, hi)) else gmaxk_part(o, xd, v, 0, n)
    out

private fn gmaxk_part(o: Buf(Float), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if x[k] > v then x[k] else v

private fn gmaxk_into(o: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if o[k] > v then o[k] else v

#     g.gmink(g.arange(3), 1.0)   # => [0, 1, 1]
fn gmink(g: Grid, v) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gmink_into(o, v, lo, hi)) else gmink_into(o, v, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gmink_part(o, xd, v, lo, hi)) else gmink_part(o, xd, v, 0, n)
    out

private fn gmink_part(o: Buf(Float), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if x[k] < v then x[k] else v

private fn gmink_into(o: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if o[k] < v then o[k] else v

#     g.gfmodk(g.arange(5), 3.0)   # => [0, 1, 2, 0, 1]
fn gfmodk(g: Grid, v) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gfmodk_into(o, v, lo, hi)) else gfmodk_into(o, v, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gfmodk_part(o, xd, v, lo, hi)) else gfmodk_part(o, xd, v, 0, n)
    out

private fn gfmodk_part(o: Buf(Float), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = fmod(x[k], v)

private fn gfmodk_into(o: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = fmod(o[k], v)

# The angle of (y, x) — `gatan2(y, x)`, as C and NumPy order it.
#
#     g.gatan2(g.ones1(1), g.zeros1(1)) |> g.allclose(g.of(Cons(g.pi() / 2.0, Nil)), 0.000001)   # => true
fn gatan2(a: Grid, b: Grid) =
  need_same(a, b, "gatan2")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> gatan2_into(o, yd, lo, hi)) else gatan2_into(o, yd, 0, n)
    a
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gatan2_part(o, xd, yd, lo, hi)) else gatan2_part(o, xd, yd, 0, n)
    out

private fn gatan2_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = atan2(x[k], y[k])

private fn gatan2_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = atan2(o[k], y[k])

#     g.ghypot(g.of(Cons(3.0, Nil)), g.of(Cons(4.0, Nil)))   # => [5]
fn ghypot(a: Grid, b: Grid) =
  need_same(a, b, "ghypot")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> ghypot_into(o, yd, lo, hi)) else ghypot_into(o, yd, 0, n)
    a
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> ghypot_part(o, xd, yd, lo, hi)) else ghypot_part(o, xd, yd, 0, n)
    out

private fn ghypot_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = hypot(x[k], y[k])

private fn ghypot_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = hypot(o[k], y[k])

#     g.gfmod(g.of(Cons(7.0, Nil)), g.of(Cons(3.0, Nil)))   # => [1]
fn gfmod(a: Grid, b: Grid) =
  need_same(a, b, "gfmod")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> gfmod_into(o, yd, lo, hi)) else gfmod_into(o, yd, 0, n)
    a
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gfmod_part(o, xd, yd, lo, hi)) else gfmod_part(o, xd, yd, 0, n)
    out

private fn gfmod_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = fmod(x[k], y[k])

private fn gfmod_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = fmod(o[k], y[k])

#     g.gcopysign(g.of(Cons(3.0, Nil)), g.of(Cons(-1.0, Nil)))   # => [-3]
fn gcopysign(a: Grid, b: Grid) =
  need_same(a, b, "gcopysign")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> gcopysign_into(o, yd, lo, hi)) else gcopysign_into(o, yd, 0, n)
    a
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gcopysign_part(o, xd, yd, lo, hi)) else gcopysign_part(o, xd, yd, 0, n)
    out

private fn gcopysign_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = copysign(x[k], y[k])

private fn gcopysign_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = copysign(o[k], y[k])

# Each element to the matching element's power.
#
#     g.gpowg(g.of(Cons(2.0, Cons(3.0, Nil))), g.of(Cons(3.0, Cons(2.0, Nil))))   # => [8, 9]
fn gpowg(a: Grid, b: Grid) =
  need_same(a, b, "gpowg")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> gpowg_into(o, yd, lo, hi)) else gpowg_into(o, yd, 0, n)
    a
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gpowg_part(o, xd, yd, lo, hi)) else gpowg_part(o, xd, yd, 0, n)
    out

private fn gpowg_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = pow(x[k], y[k])

private fn gpowg_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = pow(o[k], y[k])

# `f` on every element; `zip` on every pair. For what the named operations
# above do not cover — they are the fast ones: a lambda is a call per
# element.
#
#     g.map(g.arange(3), \x -> x * x + 1.0)   # => [1, 2, 5]
fn map(g: Grid, f) =
  out = if unique(g) && unique(g.data) && contiguous(g) then g else fresh(g.shape)
  x = dense(g)
  o = out.data
  xd = x.data
  n = size(g)
  if par(n) then run(n, \lo, hi -> map_part(o, xd, f, lo, hi)) else map_part(o, xd, f, 0, n)
  out

private fn map_part(o: Buf(Float), x: Buf(Float), f, lo, hi) =
  for k in lo..hi
    o[k] = f(x[k])

#     g.zip(g.arange(3), g.ones1(3), \x, y -> x - y)   # => [-1, 0, 1]
fn zip(a: Grid, b: Grid, f) =
  need_same(a, b, "zip")
  out = if unique(a) && unique(a.data) && contiguous(a) then a else if unique(b) && unique(b.data) && contiguous(b) then b else fresh(a.shape)
  x = dense(a)
  y = dense(b)
  o = out.data
  xd = x.data
  yd = y.data
  n = size(a)
  if par(n) then run(n, \lo, hi -> zip_part(o, xd, yd, f, lo, hi)) else zip_part(o, xd, yd, f, 0, n)
  out

private fn zip_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), f, lo, hi) =
  for k in lo..hi
    o[k] = f(x[k], y[k])

# -- masks: a byte per element, 1 where a comparison held ---------------------

#     g.mcount(g.mask_of(g.shape1(3)))   # => 0
#     g.any(g.mask_of(g.shape1(3)))      # => false
fn mask_of(shape: Buf(Int)) = Mask(shape, buf_u8(count(shape)))

private fn mask_size(m: Mask) = count(m.shape)

# `gt(a, b)` is `a > b` element by element; `gtk(a, v)` compares with one
# number. `lt`, `ge`, `le`, `eq`, `ne` and their `k` forms likewise.
#
#     g.gt(g.arange(3), g.ones1(3))   # => [false, false, true]
fn gt(a: Grid, b: Grid) =
  need_same(a, b, "gt")
  x = dense(a)
  y = dense(b)
  m = mask_of(a.shape)
  bits = m.bits
  xd = x.data
  yd = y.data
  n = size(a)
  if par(n) then run(n, \lo, hi -> gt_part(bits, xd, yd, lo, hi)) else gt_part(bits, xd, yd, 0, n)
  m

private fn gt_part(o: Buf(U8), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] > y[k] then 1 else 0

#     g.lt(g.arange(3), g.ones1(3))   # => [true, false, false]
fn lt(a: Grid, b: Grid) = gt(b, a)

#     g.ge(g.arange(3), g.ones1(3))   # => [false, true, true]
fn ge(a: Grid, b: Grid) =
  need_same(a, b, "ge")
  x = dense(a)
  y = dense(b)
  m = mask_of(a.shape)
  bits = m.bits
  xd = x.data
  yd = y.data
  n = size(a)
  if par(n) then run(n, \lo, hi -> ge_part(bits, xd, yd, lo, hi)) else ge_part(bits, xd, yd, 0, n)
  m

private fn ge_part(o: Buf(U8), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] >= y[k] then 1 else 0

#     g.le(g.arange(3), g.ones1(3))   # => [true, true, false]
fn le(a: Grid, b: Grid) = ge(b, a)

#     g.eq(g.arange(3), g.ones1(3))   # => [false, true, false]
fn eq(a: Grid, b: Grid) =
  need_same(a, b, "eq")
  x = dense(a)
  y = dense(b)
  m = mask_of(a.shape)
  bits = m.bits
  xd = x.data
  yd = y.data
  n = size(a)
  if par(n) then run(n, \lo, hi -> eq_part(bits, xd, yd, lo, hi)) else eq_part(bits, xd, yd, 0, n)
  m

private fn eq_part(o: Buf(U8), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] == y[k] then 1 else 0

#     g.ne(g.arange(3), g.ones1(3))   # => [true, false, true]
fn ne(a: Grid, b: Grid) = mask_not(eq(a, b))

#     g.gtk(g.arange(3), 1.0)   # => [false, false, true]
fn gtk(g: Grid, v) =
  x = dense(g)
  m = mask_of(g.shape)
  bits = m.bits
  xd = x.data
  n = size(g)
  if par(n) then run(n, \lo, hi -> gtk_part(bits, xd, v, lo, hi)) else gtk_part(bits, xd, v, 0, n)
  m

private fn gtk_part(o: Buf(U8), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if x[k] > v then 1 else 0

#     g.ltk(g.arange(3), 1.0)   # => [true, false, false]
fn ltk(g: Grid, v) =
  x = dense(g)
  m = mask_of(g.shape)
  bits = m.bits
  xd = x.data
  n = size(g)
  if par(n) then run(n, \lo, hi -> ltk_part(bits, xd, v, lo, hi)) else ltk_part(bits, xd, v, 0, n)
  m

private fn ltk_part(o: Buf(U8), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if x[k] < v then 1 else 0

#     g.gek(g.arange(3), 1.0)   # => [false, true, true]
fn gek(g: Grid, v) = mask_not(ltk(g, v))

#     g.lek(g.arange(3), 1.0)   # => [true, true, false]
fn lek(g: Grid, v) = mask_not(gtk(g, v))

#     g.eqk(g.arange(3), 1.0)   # => [false, true, false]
fn eqk(g: Grid, v) =
  x = dense(g)
  m = mask_of(g.shape)
  bits = m.bits
  xd = x.data
  n = size(g)
  if par(n) then run(n, \lo, hi -> eqk_part(bits, xd, v, lo, hi)) else eqk_part(bits, xd, v, 0, n)
  m

private fn eqk_part(o: Buf(U8), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = if x[k] == v then 1 else 0

#     g.nek(g.arange(3), 1.0)   # => [true, false, true]
fn nek(g: Grid, v) = mask_not(eqk(g, v))

# `a` where the mask holds, `b` elsewhere.
#
#     g.where(g.gtk(g.arange(4), 1.0), g.arange(4), g.zeros1(4))   # => [0, 0, 2, 3]
fn where(m: Mask, a: Grid, b: Grid) =
  need_mask(m, a, "where")
  need_same(a, b, "where")
  bits = m.bits
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> where_into(o, bits, yd, lo, hi)) else where_into(o, bits, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> where_onto(xd, bits, o, lo, hi)) else where_onto(xd, bits, o, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> where_part(o, bits, xd, yd, lo, hi)) else where_part(o, bits, xd, yd, 0, n)
    out

private fn where_part(o: Buf(Float), m: Buf(U8), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if m[k] != 0 then x[k] else y[k]

private fn where_into(o: Buf(Float), m: Buf(U8), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if m[k] != 0 then o[k] else y[k]

private fn where_onto(x: Buf(Float), m: Buf(U8), o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if m[k] != 0 then x[k] else o[k]

# How many elements the mask holds for.
#
#     g.mcount(g.gtk(g.arange(5), 1.0))   # => 3
fn mcount(m: Mask) =
  bits = m.bits
  n = mask_size(m)
  if par(n) then reduce_i(n, \lo, hi -> count_part(bits, lo, hi)) else count_part(bits, 0, n)

private fn count_part(m: Buf(U8), lo, hi) =
  for k in lo..hi with acc = 0
    acc + m[k]

private fn reduce_i(n, f) = to_int(reduce_f(n, \lo, hi -> to_float(f(lo, hi)), \a, b -> a + b))

#     g.any(g.gtk(g.arange(3), 1.0))   # => true
#     g.any(g.gtk(g.arange(3), 5.0))   # => false
fn any(m: Mask) = mcount(m) > 0

#     g.all(g.gek(g.arange(3), 0.0))   # => true
fn all(m: Mask) = mcount(m) == mask_size(m)

#     g.mask_not(g.gtk(g.arange(3), 1.0))   # => [true, true, false]
fn mask_not(m: Mask) =
  out = if unique(m) && unique(m.bits) then m else mask_of(m.shape)
  o = out.bits
  src = m.bits
  n = mask_size(m)
  if par(n) then run(n, \lo, hi -> not_part(o, src, lo, hi)) else not_part(o, src, 0, n)
  out

private fn not_part(o: Buf(U8), m: Buf(U8), lo, hi) =
  for k in lo..hi
    o[k] = 1 - m[k]

#     g.mask_and(g.gtk(g.arange(4), 0.0), g.ltk(g.arange(4), 3.0))   # => [false, true, true, false]
fn mask_and(a: Mask, b: Mask) =
  out = if unique(a) && unique(a.bits) then a else if unique(b) && unique(b.bits) then b else mask_of(a.shape)
  o = out.bits
  x = a.bits
  y = b.bits
  n = mask_size(a)
  if par(n) then run(n, \lo, hi -> and_part(o, x, y, lo, hi)) else and_part(o, x, y, 0, n)
  out

private fn and_part(o: Buf(U8), x: Buf(U8), y: Buf(U8), lo, hi) =
  for k in lo..hi
    o[k] = x[k] * y[k]

#     g.mask_or(g.ltk(g.arange(4), 1.0), g.gtk(g.arange(4), 2.0))   # => [true, false, false, true]
fn mask_or(a: Mask, b: Mask) =
  out = if unique(a) && unique(a.bits) then a else if unique(b) && unique(b.bits) then b else mask_of(a.shape)
  o = out.bits
  x = a.bits
  y = b.bits
  n = mask_size(a)
  if par(n) then run(n, \lo, hi -> or_part(o, x, y, lo, hi)) else or_part(o, x, y, 0, n)
  out

private fn or_part(o: Buf(U8), x: Buf(U8), y: Buf(U8), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] + y[k] > 0 then 1 else 0

# The mask as a grid of 1.0 and 0.0.
#
#     g.to_grid(g.gtk(g.arange(3), 1.0))   # => [0, 0, 1]
fn to_grid(m: Mask) =
  out = fresh(m.shape)
  o = out.data
  bits = m.bits
  n = mask_size(m)
  if par(n) then run(n, \lo, hi -> to_grid_part(o, bits, lo, hi)) else to_grid_part(o, bits, 0, n)
  out

private fn to_grid_part(o: Buf(Float), m: Buf(U8), lo, hi) =
  for k in lo..hi
    o[k] = to_float(m[k])

# Not a number, endless, and neither: `v != v` is true of a NaN alone, and
# `v - v` is zero for every ordinary number and a NaN for an infinity.
#
#     g.isnan(g.of(Cons(1.0, Cons(g.nan(), Nil))))   # => [false, true]
fn isnan(g: Grid) =
  x = dense(g)
  m = mask_of(dup_shape(g.shape))
  for k in 0..size(g)
    m.bits[k] = if x.data[k] != x.data[k] then 1 else 0
  m

#     g.isinf(g.of(Cons(1.0, Cons(g.inf(), Nil))))   # => [false, true]
fn isinf(g: Grid) =
  x = dense(g)
  m = mask_of(dup_shape(g.shape))
  for k in 0..size(g)
    v = x.data[k]
    m.bits[k] = if v == v && v - v != 0.0 then 1 else 0
  m

#     g.isfinite(g.of(Cons(1.0, Cons(g.inf(), Cons(g.nan(), Nil)))))   # => [true, false, false]
fn isfinite(g: Grid) =
  x = dense(g)
  m = mask_of(dup_shape(g.shape))
  for k in 0..size(g)
    v = x.data[k]
    m.bits[k] = if v == v && v - v == 0.0 then 1 else 0
  m

# Element by element, within `eps` of each other.
#
#     g.isclose(g.of(Cons(1.0, Cons(2.0, Nil))), g.of(Cons(1.0000001, Cons(2.5, Nil))), 0.001)   # => [true, false]
fn isclose(a: Grid, b: Grid, eps) =
  need_same(a, b, "isclose")
  x = dense(a)
  y = dense(b)
  m = mask_of(dup_shape(a.shape))
  for k in 0..size(a)
    d = x.data[k] - y.data[k]
    m.bits[k] = if d <= eps && d >= 0.0 - eps then 1 else 0
  m

#     g.allclose(g.arange(3), g.arange(3), 0.0)   # => true
fn allclose(a: Grid, b: Grid, eps) = same_shape(a, b) && close_elems(a, b, eps)

private fn close_elems(a: Grid, b: Grid, eps) =
  x = dense(a)
  y = dense(b)
  for k in 0..size(a) with ok = true
    d = x.data[k] - y.data[k]
    ok && d <= eps && d >= 0.0 - eps

# -- reductions -------------------------------------------------------------

# The sums are `fast fn`s: the compiler may split each into running sums
# side by side, in the machine's vector lanes, and add them at the end — one
# running sum is a chain of adds each waiting for the last. The eight partial
# sums this used to write out by hand did the same, and were as fast or a
# little slower (a thousand numbers: 101 ns, 68 now). The order of additions
# differs from one running sum, as NumPy's pairwise summation differs from
# both; the answers agree to the last few bits.
#
#     g.sum(g.arange(5))   # => 10
fn sum(g: Grid) =
  d = dense(g).data
  n = size(g)
  if par(n) then reduce_f(n, \lo, hi -> sum_range(d, lo, hi), fadd) else sum_range(d, 0, n)

private fn fadd(a, b) = a + b

private fast fn sum_range(d: Buf(Float), lo, hi) =
  for k in lo..hi with acc = 0.0
    acc + d[k]

#     g.mean(g.arange(5))   # => 2
fn mean(g: Grid) = sum(g) / to_float(size(g))

#     g.prod(g.of(Cons(2.0, Cons(3.0, Cons(4.0, Nil)))))   # => 24
fn prod(g: Grid) =
  x = dense(g)
  for k in 0..size(g) with acc = 1.0
    acc * x.data[k]

#     g.dot(g.of(Cons(1.0, Cons(2.0, Nil))), g.of(Cons(3.0, Cons(4.0, Nil))))   # => 11
fn dot(a: Grid, b: Grid) =
  if size(a) != size(b) then
    fail("dot: " + int_to_str(size(a)) + " against " + int_to_str(size(b)) + " elements")
    0.0
  else
    d = dense(a).data
    e = dense(b).data
    n = size(a)
    if par(n) then reduce_f(n, \lo, hi -> dot_range(d, 0, e, 0, lo, hi), fadd) else dot_range(d, 0, e, 0, 0, n)

# The sum of `d[doff + k] * e[eoff + k]` for k in lo up to hi.
private fast fn dot_range(d: Buf(Float), doff, e: Buf(Float), eoff, lo, hi) =
  for k in lo..hi with acc = 0.0
    acc + d[doff + k] * e[eoff + k]

#     g.norm(g.of(Cons(3.0, Cons(4.0, Nil))))   # => 5
fn norm(g: Grid) = sqrt(dot(g, g))

private fn fmax(a, b) = if a > b then a else b

private fn fmin(a, b) = if a < b then a else b

# The largest and smallest, eight lanes at a time, written out: eight chains
# of comparisons instead of one keep the loop from waiting on itself, and a
# `fast fn` would not do it here — what it loosens is addition, and a
# comparison is not one. The eight agree exactly with one.
#
#     g.gmax(g.of(Cons(2.0, Cons(9.0, Cons(4.0, Nil)))))   # => 9
fn gmax(g: Grid) =
  d = dense(g).data
  n = size(g)
  if par(n) then reduce_f(n, \lo, hi -> max_range(d, lo, hi), fmax) else max_range(d, 0, n)

private fn max_range(d: Buf(Float), lo, hi) =
  octs = (hi - lo) / 8
  first = d[lo]
  (m0, m1, m2, m3, m4, m5, m6, m7) = for k in 0..octs with acc = (first, first, first, first, first, first, first, first)
    (p0, p1, p2, p3, p4, p5, p6, p7) = acc
    o = lo + 8 * k
    (fmax(p0, d[o]), fmax(p1, d[o + 1]), fmax(p2, d[o + 2]), fmax(p3, d[o + 3]), fmax(p4, d[o + 4]), fmax(p5, d[o + 5]), fmax(p6, d[o + 6]), fmax(p7, d[o + 7]))
  for k in lo + octs * 8..hi with m = fmax(fmax(fmax(m0, m1), fmax(m2, m3)), fmax(fmax(m4, m5), fmax(m6, m7)))
    fmax(m, d[k])

#     g.gmin(g.of(Cons(2.0, Cons(9.0, Cons(4.0, Nil)))))   # => 2
fn gmin(g: Grid) =
  d = dense(g).data
  n = size(g)
  if par(n) then reduce_f(n, \lo, hi -> min_range(d, lo, hi), fmin) else min_range(d, 0, n)

private fn min_range(d: Buf(Float), lo, hi) =
  octs = (hi - lo) / 8
  first = d[lo]
  (m0, m1, m2, m3, m4, m5, m6, m7) = for k in 0..octs with acc = (first, first, first, first, first, first, first, first)
    (p0, p1, p2, p3, p4, p5, p6, p7) = acc
    o = lo + 8 * k
    (fmin(p0, d[o]), fmin(p1, d[o + 1]), fmin(p2, d[o + 2]), fmin(p3, d[o + 3]), fmin(p4, d[o + 4]), fmin(p5, d[o + 5]), fmin(p6, d[o + 6]), fmin(p7, d[o + 7]))
  for k in lo + octs * 8..hi with m = fmin(fmin(fmin(m0, m1), fmin(m2, m3)), fmin(fmin(m4, m5), fmin(m6, m7)))
    fmin(m, d[k])

# Where the largest is, the first of them if there are several: four lanes,
# each keeping the first place it saw its own largest, and the lanes settled
# by value first and place second.
#
#     g.argmax(g.of(Cons(2.0, Cons(9.0, Cons(9.0, Nil)))))   # => 1
fn argmax(g: Grid) =
  d = dense(g).data
  n = size(g)
  (m, i) = if par(n) then reduce_fi(n, \lo, hi -> argmax_range(d, lo, hi), later_wins_max) else argmax_range(d, 0, n)
  i

private fn argmax_range(d: Buf(Float), lo, hi) =
  quads = (hi - lo) / 4
  first = d[lo]
  (m0, i0, m1, i1, m2, i2, m3, i3) = for k in 0..quads with acc = (first, lo, first, lo + 1, first, lo + 2, first, lo + 3)
    (p0, j0, p1, j1, p2, j2, p3, j3) = acc
    o = lo + 4 * k
    (b0, c0) = if d[o] > p0 then (d[o], o) else (p0, j0)
    (b1, c1) = if d[o + 1] > p1 then (d[o + 1], o + 1) else (p1, j1)
    (b2, c2) = if d[o + 2] > p2 then (d[o + 2], o + 2) else (p2, j2)
    (b3, c3) = if d[o + 3] > p3 then (d[o + 3], o + 3) else (p3, j3)
    (b0, c0, b1, c1, b2, c2, b3, c3)
  (m01, i01) = later_wins_max(m0, i0, m1, i1)
  (m23, i23) = later_wins_max(m2, i2, m3, i3)
  (m, i) = later_wins_max(m01, i01, m23, i23)
  for k in lo + quads * 4..hi with best = (m, i)
    (bm, bi) = best
    if d[k] > bm then (d[k], k) else best

private fn later_wins_max(m0, i0, m1, i1) =
  if m1 > m0 || m1 == m0 && i1 < i0 then (m1, i1) else (m0, i0)

private fn later_wins_min(m0, i0, m1, i1) =
  if m1 < m0 || m1 == m0 && i1 < i0 then (m1, i1) else (m0, i0)

#     g.argmin(g.of(Cons(2.0, Cons(9.0, Cons(1.0, Nil)))))   # => 2
fn argmin(g: Grid) =
  d = dense(g).data
  n = size(g)
  (m, i) = if par(n) then reduce_fi(n, \lo, hi -> argmin_range(d, lo, hi), later_wins_min) else argmin_range(d, 0, n)
  i

private fn argmin_range(d: Buf(Float), lo, hi) =
  quads = (hi - lo) / 4
  first = d[lo]
  (m0, i0, m1, i1, m2, i2, m3, i3) = for k in 0..quads with acc = (first, lo, first, lo + 1, first, lo + 2, first, lo + 3)
    (p0, j0, p1, j1, p2, j2, p3, j3) = acc
    o = lo + 4 * k
    (b0, c0) = if d[o] < p0 then (d[o], o) else (p0, j0)
    (b1, c1) = if d[o + 1] < p1 then (d[o + 1], o + 1) else (p1, j1)
    (b2, c2) = if d[o + 2] < p2 then (d[o + 2], o + 2) else (p2, j2)
    (b3, c3) = if d[o + 3] < p3 then (d[o + 3], o + 3) else (p3, j3)
    (b0, c0, b1, c1, b2, c2, b3, c3)
  (m01, i01) = later_wins_min(m0, i0, m1, i1)
  (m23, i23) = later_wins_min(m2, i2, m3, i3)
  (m, i) = later_wins_min(m01, i01, m23, i23)
  for k in lo + quads * 4..hi with best = (m, i)
    (bm, bi) = best
    if d[k] < bm then (d[k], k) else best

#     g.var(g.of(Cons(2.0, Cons(4.0, Cons(4.0, Cons(6.0, Nil))))))   # => 2
fn var(g: Grid) =
  m = mean(g)
  d = dense(g).data
  n = size(g)
  total = if par(n) then reduce_f(n, \lo, hi -> sqdev_range(d, m, lo, hi), fadd) else sqdev_range(d, m, 0, n)
  total / to_float(n)

# The sum of squared distances from `m`.
private fast fn sqdev_range(d: Buf(Float), m, lo, hi) =
  for k in lo..hi with acc = 0.0
    dd = d[k] - m
    acc + dd * dd

#     g.std(g.of(Cons(2.0, Cons(4.0, Cons(4.0, Cons(6.0, Nil))))))   # => 1.4142135623730951
fn std(g: Grid) = sqrt(var(g))

#     g.cumsum(g.arange(4))   # => [0, 1, 3, 6]
fn cumsum(g: Grid) =
  x = dense(g)
  out = fresh(g.shape)
  for k in 0..size(g)
    out.data[k] = if k == 0 then x.data[0] else out.data[k - 1] + x.data[k]
  out

# Sums of a 2-D grid along an axis: 0 adds the rows together (one number per
# column), 1 adds each row up (one number per row).
# No copy for a view: the loops follow the strides. When the axis being
# summed steps by one, each answer is a contiguous eight-lane sum; when the
# other axis does, the answers are accumulated a row at a time, which
# vectorizes across them. Either way a transposed grid is summed as fast as
# the grid it came from, and the answers are split across the workers.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.sum_axis(a, 0)   # => [3, 5, 7]
#     g.sum_axis(a, 1)   # => [3, 12]
fn sum_axis(g: Grid, axis) =
  n_out = if axis == 0 then g.shape[1] else g.shape[0]
  s_out = if axis == 0 then g.strides[1] else g.strides[0]
  n_in = if axis == 0 then g.shape[0] else g.shape[1]
  s_in = if axis == 0 then g.strides[0] else g.strides[1]
  out = zeros1(n_out)
  o = out.data
  d = g.data
  off = g.off
  if par(n_out * n_in) then run(n_out, \lo, hi -> axis_part(o, d, off, s_out, s_in, n_in, lo, hi)) else axis_part(o, d, off, s_out, s_in, n_in, 0, n_out)
  out

private fn axis_part(o: Buf(Float), d: Buf(Float), off, s_out, s_in, n_in, lo, hi) =
  if s_in == 1 then
    for t in lo..hi
      base = off + t * s_out
      o[t] = sum_range(d, base, base + n_in)
  else if s_out == 1 then
    # Four rows per pass over the answers: the answers are read and written
    # once per four rows rather than once per row, and it is the writes
    # that were the cost.
    quads = n_in / 4
    for i in 0..quads
      b0 = off + 4 * i * s_in
      b1 = b0 + s_in
      b2 = b1 + s_in
      b3 = b2 + s_in
      for t in lo..hi
        o[t] += d[b0 + t] + d[b1 + t] + (d[b2 + t] + d[b3 + t])
    for i in quads * 4..n_in
      base = off + i * s_in
      for t in lo..hi
        o[t] += d[base + t]
  else
    for t in lo..hi
      base = off + t * s_out
      o[t] = for i in 0..n_in with acc = 0.0
        acc + d[base + i * s_in]

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.mean_axis(a, 1)   # => [1, 4]
fn mean_axis(g: Grid, axis) =
  n = if axis == 0 then g.shape[0] else g.shape[1]
  scale(sum_axis(g, axis), 1.0 / to_float(n))

# -- sorting and order --------------------------------------------------------

# In place when this is the only holder of the grid and its storage, each
# row on its own for a matrix.
#
#     g.sort(g.of(Cons(3.0, Cons(1.0, Cons(2.0, Nil)))))   # => [1, 2, 3]
fn sort(g: Grid) =
  out = if unique(g) && unique(g.data) && contiguous(g) then g else copy(g)
  if ndim(out) == 1 then sort_range(out.data, 0, size(out))
  else
    c = out.shape[1]
    for i in 0..rows_of(out)
      sort_range(out.data, i * c, (i + 1) * c)
  out

# Sorting by the bits rather than by comparing. A float's order is its bit
# pattern's order once the sign is folded in — invert a negative number's
# bits, set a positive number's top bit — and then the numbers can be put
# in place one byte at a time, eight passes, each a counting sort. There is
# nothing to predict and nothing to mispredict, which is what a comparison
# sort spends its time on; the price is two buffers the size of the input
# and eight passes over them, so it is worth it above a few thousand
# elements and not below.
private fn radix_sort(d: Buf(Float), lo, hi) =
  n = hi - lo
  keys = buf_int(n)
  tmp = buf_int(n)
  # One pass builds all eight histograms, so the passes themselves have
  # only to move the numbers.
  cnt = buf_int(2048)
  for i in 0..n
    k = encode_key(peek_i64(d, lo + i))
    keys[i] = k
    for p in 0..8
      at = p * 256 + bit_and(shr(k, p * 8), 255)
      cnt[at] = cnt[at] + 1
  out = radix_passes(keys, tmp, cnt, n, 0)
  for i in 0..n
    poke_i64(d, lo + i, decode_key(out[i]))
  0

private fn radix_passes(src: Buf(Int), dst: Buf(Int), cnt: Buf(Int), n, p) =
  if p >= 8 then src
  else if cnt[p * 256 + bit_and(shr(src[0], p * 8), 255)] == n then radix_passes(src, dst, cnt, n, p + 1)
  else
    radix_scatter(src, dst, cnt, n, p)
    radix_passes(dst, src, cnt, n, p + 1)

private fn radix_scatter(src: Buf(Int), dst: Buf(Int), cnt: Buf(Int), n, p) =
  sh = p * 8
  base = p * 256
  off = buf_int(256)
  total = for k in 0..256 with acc = 0
    off[k] = acc
    acc + cnt[base + k]
  for i in 0..n
    v = src[i]
    b = bit_and(shr(v, sh), 255)
    dst[off[b]] = v
    off[b] = off[b] + 1
  0

# The bits of a float, made to compare as unsigned integers do, and put
# back again.
private fn encode_key(bits) = if bits < 0 then bit_not(bits) else bit_or(bits, shl(1, 63))

private fn decode_key(k) = if k >= 0 then bit_not(k) else bit_xor(k, shl(1, 63))

# Under two hundred thousand, the runtime's pattern-defeating quicksort over
# the range, which beat the radix sort below that at every size measured
# (5000 numbers: 36 us against 65); from there up the radix sort, whose eight
# passes cost the same per number however many there are. Both put numbers
# in the order of their bits, so a NaN and a -0.0 land where they would with
# either.
private fn sort_range(d: Buf(Float), lo, hi) =
  if hi - lo >= 200000 then radix_sort(d, lo, hi)
  else
    buf_sort_range(d, lo, hi)
    0

# Where the elements would go if they were sorted, ties in the order they
# were in. The runtime orders each number's bits beside its position — a
# byte at a time from the lowest for a big grid, which is stable by
# construction, and a quick sort of the pairs for a small one, which the
# position makes stable — in half the time of the merge sort over positions
# written here (a million: 30 ms, now 16). `-0.0` and `0.0` are equal, as `<`
# has them.
#
#     g.argsort(g.of(Cons(3.0, Cons(1.0, Cons(2.0, Nil)))))   # => [1, 2, 0]
fn argsort(g: Grid) =
  n = size(g)
  d = dense(g).data
  idx = buf_int(n)
  buf_argsort(d, idx)
  out = fresh(shape1(n))
  for k in 0..n
    out.data[k] = to_float(idx[k])
  out

# The values that occur, each once, in order.
#
#     g.distinct(g.of(Cons(3.0, Cons(1.0, Cons(3.0, Nil)))))   # => [1, 3]
fn distinct(g: Grid) =
  n = size(g)
  if n == 0 then copy(g)
  else
    s = sort(copy(g))
    d = s.data
    kept = for k in 1..n with c = 1
      if d[k] != d[k - 1] then c + 1 else c
    out = fresh(shape1(kept))
    out.data[0] = d[0]
    at = for k in 1..n with w = 1
      if d[k] != d[k - 1] then
        out.data[w] = d[k]
        w + 1
      else w
    out

# Where `v` would go in a sorted grid, before anything equal to it.
#
#     g.searchsorted(g.of(Cons(1.0, Cons(3.0, Cons(5.0, Nil)))), 3.0)   # => 1
#     g.searchsorted(g.of(Cons(1.0, Cons(3.0, Cons(5.0, Nil)))), 4.0)   # => 2
fn searchsorted(g: Grid, v) =
  d = dense(g).data
  fn find(lo, hi) =
    if lo >= hi then lo
    else
      mid = lo + (hi - lo) / 2
      if d[mid] < v then find(mid + 1, hi) else find(lo, mid)
  find(0, size(g))

# The positions of the elements that are not zero.
#
#     g.nonzero(g.of(Cons(0.0, Cons(2.0, Cons(0.0, Cons(5.0, Nil))))))   # => [1, 3]
fn nonzero(g: Grid) =
  x = dense(g)
  n = size(g)
  kept = for k in 0..n with c = 0
    if x.data[k] != 0.0 then c + 1 else c
  out = fresh(shape1(kept))
  at = for k in 0..n with w = 0
    if x.data[k] != 0.0 then
      out.data[w] = to_float(k)
      w + 1
    else w

  out

#     g.count_nonzero(g.of(Cons(0.0, Cons(2.0, Cons(5.0, Nil)))))   # => 2
fn count_nonzero(g: Grid) =
  x = dense(g)
  for k in 0..size(g) with c = 0
    if x.data[k] != 0.0 then c + 1 else c

# The middle value, and the value a fraction of the way along, interpolating
# between neighbours the way NumPy does. Neither sorts: the runtime selects
# the one below in a copy (core's introselect, linear on average, which is
# what NumPy's `median` does too), and the one above is the least of what
# the selection left after it. Five million numbers: 12 ms by two
# quickselects written here, 7 now, NumPy 8.
#
#     g.median(g.of(Cons(3.0, Cons(1.0, Cons(2.0, Nil)))))              # => 2
#     g.median(g.of(Cons(4.0, Cons(1.0, Cons(2.0, Cons(3.0, Nil))))))   # => 2.5
fn median(g: Grid) = quantile(g, 0.5)

#     g.percentile(g.arange(5), 50.0)   # => 2
#     g.percentile(g.arange(5), 25.0)   # => 1
fn percentile(g: Grid, q) = quantile(g, q / 100.0)

#     g.quantile(g.arange(5), 0.75)   # => 3
fn quantile(g: Grid, q) =
  n = size(g)
  c = copy(flatten(g))
  d = c.data
  pos = q * to_float(n - 1)
  lo = to_int(floor(pos))
  frac = pos - to_float(lo)
  a = buf_select_nth(d, 0, n, lo)
  # everything after `lo` is no smaller now, so the next one up is the
  # least of them: a scan, not a second selection
  b = if lo + 1 < n then min_range(d, lo + 1, n) else a
  a + frac * (b - a)

# The distance from the smallest to the largest.
#
#     g.ptp(g.of(Cons(2.0, Cons(9.0, Cons(4.0, Nil)))))   # => 7
fn ptp(g: Grid) = gmax(g) - gmin(g)

#     g.average(g.arange(4))   # => 1.5
fn average(g: Grid) = mean(g)

# The difference between each element and the one before it.
#
#     g.diff(g.of(Cons(1.0, Cons(4.0, Cons(9.0, Nil)))))   # => [3, 5]
fn diff(g: Grid) =
  n = size(g)
  x = dense(g)
  out = fresh(shape1(if n > 0 then n - 1 else 0))
  for k in 1..n
    out.data[k - 1] = x.data[k] - x.data[k - 1]
  out

#     g.cumprod(g.of(Cons(1.0, Cons(2.0, Cons(3.0, Nil)))))   # => [1, 2, 6]
fn cumprod(g: Grid) =
  x = dense(g)
  out = fresh(dup_shape(g.shape))
  for k in 0..size(g)
    out.data[k] = if k == 0 then x.data[0] else out.data[k - 1] * x.data[k]
  out

# The same reductions with the NaNs left out, as NumPy's `nan*` do.
#
#     g.nansum(g.of(Cons(1.0, Cons(g.nan(), Cons(2.0, Nil)))))   # => 3
fn nansum(g: Grid) =
  x = dense(g)
  for k in 0..size(g) with acc = 0.0
    if x.data[k] == x.data[k] then acc + x.data[k] else acc

#     g.nanmean(g.of(Cons(1.0, Cons(g.nan(), Cons(3.0, Nil)))))   # => 2
fn nanmean(g: Grid) =
  x = dense(g)
  c = for k in 0..size(g) with acc = 0
    if x.data[k] == x.data[k] then acc + 1 else acc
  nansum(g) / to_float(c)

#     g.nanmax(g.of(Cons(1.0, Cons(g.nan(), Cons(3.0, Nil)))))   # => 3
fn nanmax(g: Grid) =
  (m, i) = nanbest(g, true)
  m

#     g.nanmin(g.of(Cons(1.0, Cons(g.nan(), Cons(3.0, Nil)))))   # => 1
fn nanmin(g: Grid) =
  (m, i) = nanbest(g, false)
  m

#     g.nanargmax(g.of(Cons(1.0, Cons(g.nan(), Cons(3.0, Nil)))))   # => 2
fn nanargmax(g: Grid) =
  (m, i) = nanbest(g, true)
  i

#     g.nanargmin(g.of(Cons(1.0, Cons(g.nan(), Cons(3.0, Nil)))))   # => 0
fn nanargmin(g: Grid) =
  (m, i) = nanbest(g, false)
  i

# The largest or smallest number that is one, and where it is.
private fn nanbest(g: Grid, want_max) =
  x = dense(g)
  n = size(g)
  for k in 0..n with best = (nan(), 0)
    (m, i) = best
    v = x.data[k]
    if v != v then best else if m != m || (if want_max then v > m else v < m) then (v, k) else best

# The two floats that are not numbers, for a program that needs to say so.
#
#     g.nan() == g.nan()   # => false
fn nan() = 0.0 / 0.0

#     g.inf() > 1e308   # => true
fn inf() = 1.0 / 0.0

# -- linear algebra -------------------------------------------------------------

# (r × k) times (k × c), the way a BLAS does it: ten columns of the right
# operand are packed into a panel that stays in the nearest cache, and a
# kernel walks four rows of the left operand down that panel keeping the
# 4 × 10 block of answers in twenty vector registers — `Float2` pairs, one
# fused multiply-add each per step. Column blocks are handed to strands
# when there are workers to take them. Rows and columns past the last
# whole block are finished by the plain triple loop.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.matmul(a, g.transpose(a))   # => [[5, 14], [14, 50]]
fn matmul(a: Grid, b: Grid) =
  if cols_of(a) != rows_of(b) then
    fail("matmul: " + show_shape(a.shape) + " times " + show_shape(b.shape))
    a
  else
    x = dense(a)
    y = dense(b)
    r = x.shape[0]
    kk = x.shape[1]
    c = y.shape[1]
    out = zeros2(r, c)
    o = out.data
    xd = x.data
    yd = y.data
    nb = c / 10
    # Worth splitting by the multiplications, not the elements: a 256 × 256
    # product is seventeen million of them.
    if par(r * c * kk / 4) && nb > 1 then run(nb, \lo, hi -> mm_blocks(xd, yd, o, r, kk, c, lo, hi)) else mm_blocks(xd, yd, o, r, kk, c, 0, nb)
    mm_edges(xd, yd, o, r, kk, c, nb * 10, r / 4 * 4)
    out

type Acc
  Acc(c00: Float2, c01: Float2, c02: Float2, c03: Float2, c04: Float2, c10: Float2, c11: Float2, c12: Float2, c13: Float2, c14: Float2, c20: Float2, c21: Float2, c22: Float2, c23: Float2, c24: Float2, c30: Float2, c31: Float2, c32: Float2, c33: Float2, c34: Float2)

# Column blocks lo up to hi, ten wide: pack the panel, then every four rows.
private fn mm_blocks(x: Buf(Float), y: Buf(Float), o: Buf(Float), r, kk, c, lo, hi) =
  p = buf_float(kk * 10)
  for bj in lo..hi
    j0 = bj * 10
    for k in 0..kk
      for jj in 0..10
        p[k * 10 + jj] = y[k * c + j0 + jj]
    for bi in 0..r / 4
      i0 = bi * 4
      Acc(c00, c01, c02, c03, c04, c10, c11, c12, c13, c14, c20, c21, c22, c23, c24, c30, c31, c32, c33, c34) = mm_kernel(x, p, kk, i0)
      row0 = i0 * c + j0
      f2_store(o, row0, c00)
      f2_store(o, row0 + 2, c01)
      f2_store(o, row0 + 4, c02)
      f2_store(o, row0 + 6, c03)
      f2_store(o, row0 + 8, c04)
      row1 = row0 + 1 * c
      f2_store(o, row1, c10)
      f2_store(o, row1 + 2, c11)
      f2_store(o, row1 + 4, c12)
      f2_store(o, row1 + 6, c13)
      f2_store(o, row1 + 8, c14)
      row2 = row0 + 2 * c
      f2_store(o, row2, c20)
      f2_store(o, row2 + 2, c21)
      f2_store(o, row2 + 4, c22)
      f2_store(o, row2 + 6, c23)
      f2_store(o, row2 + 8, c24)
      row3 = row0 + 3 * c
      f2_store(o, row3, c30)
      f2_store(o, row3 + 2, c31)
      f2_store(o, row3 + 4, c32)
      f2_store(o, row3 + 6, c33)
      f2_store(o, row3 + 8, c34)

private fn mm_kernel(x: Buf(Float), p: Buf(Float), kk, i0) =
  ra = i0 * kk
  for k in 0..kk with acc = Acc(splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0))
    Acc(c00, c01, c02, c03, c04, c10, c11, c12, c13, c14, c20, c21, c22, c23, c24, c30, c31, c32, c33, c34) = acc
    a0 = splat2(x[ra + k])
    a1 = splat2(x[ra + 1 * kk + k])
    a2 = splat2(x[ra + 2 * kk + k])
    a3 = splat2(x[ra + 3 * kk + k])
    rb = k * 10
    b0 = f2_load(p, rb)
    b1 = f2_load(p, rb + 2)
    b2 = f2_load(p, rb + 4)
    b3 = f2_load(p, rb + 6)
    b4 = f2_load(p, rb + 8)
    Acc(fma2(a0, b0, c00), fma2(a0, b1, c01), fma2(a0, b2, c02), fma2(a0, b3, c03), fma2(a0, b4, c04), fma2(a1, b0, c10), fma2(a1, b1, c11), fma2(a1, b2, c12), fma2(a1, b3, c13), fma2(a1, b4, c14), fma2(a2, b0, c20), fma2(a2, b1, c21), fma2(a2, b2, c22), fma2(a2, b3, c23), fma2(a2, b4, c24), fma2(a3, b0, c30), fma2(a3, b1, c31), fma2(a3, b2, c32), fma2(a3, b3, c33), fma2(a3, b4, c34))

# The columns past the last block of ten, for every row; then the rows past
# the last block of four, for the blocked columns.
private fn mm_edges(x: Buf(Float), y: Buf(Float), o: Buf(Float), r, kk, c, cb, rb) =
  for i in 0..if cb < c then r else 0
    for k in 0..kk
      aik = x[i * kk + k]
      for j in cb..c
        o[i * c + j] += aik * y[k * c + j]
  for i in rb..r
    for k in 0..kk
      aik = x[i * kk + k]
      for j in 0..cb
        o[i * c + j] += aik * y[k * c + j]

# Matrix times vector, as a 1-D grid.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.matvec(a, g.ones1(3))   # => [3, 12]
fn matvec(a: Grid, v: Grid) =
  x = dense(a)
  y = dense(v)
  r = x.shape[0]
  c = x.shape[1]
  out = fresh(shape1(r))
  o = out.data
  xd = x.data
  yd = y.data
  if par(r * c) then run(r, \lo, hi -> matvec_part(o, xd, yd, c, lo, hi)) else matvec_part(o, xd, yd, c, 0, r)
  out

private fn matvec_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), c, lo, hi) =
  for i in lo..hi
    o[i] = dot_range(x, i * c, y, 0, 0, c)

#     g.outer(g.arange(2), g.of(Cons(1.0, Cons(2.0, Nil))))   # => [[0, 0], [1, 2]]
fn outer(a: Grid, b: Grid) =
  x = dense(a)
  y = dense(b)
  n = size(a)
  m = size(b)
  out = fresh(shape2(n, m))
  for i in 0..n
    for j in 0..m
      out.data[i * m + j] = x.data[i] * y.data[j]
  out

#     g.identity(2)   # => [[1, 0], [0, 1]]
fn identity(n) =
  g = zeros2(n, n)
  for i in 0..n
    g.data[i * n + i] = 1.0
  g

#     g.trace(g.arange(4) |> g.reshape2(2, 2))   # => 3
fn trace(g: Grid) =
  n = if g.shape[0] < g.shape[1] then g.shape[0] else g.shape[1]
  for i in 0..n with acc = 0.0
    acc + at2(g, i, i)

# -- solving ------------------------------------------------------------------

# The LU factors of a square matrix, worked out in one pass with partial
# pivoting: `a` holds L below the diagonal (its own diagonal is all ones,
# and is not stored) and U on and above it, `piv` says which row of the
# original each row came from, `sign` is 1 or -1 by how many rows were
# exchanged, and `ok` is false when the matrix turned out to be singular.
# Everything below solves through this: one factorisation, then as many
# right-hand sides as wanted.
type Lu
  Lu(a: Grid, piv: Buf(Int), sign: Float, ok: Bool)

#     m = g.of(Cons(4.0, Cons(3.0, Cons(6.0, Cons(3.0, Nil))))) |> g.reshape2(2, 2)
#     f = g.lu(m)
#     f.ok     # => true
#     f.sign   # => -1
fn lu(a: Grid) =
  n = rows_of(a)
  m = copy(a)
  d = m.data
  piv = buf_int(n)
  for i in 0..n
    piv[i] = i
  (sign, ok) = lu_walk(d, n, piv, 16, 0, 1.0, true)
  Lu(m, piv, sign, ok)

# Sixty-four columns at a time. The unblocked way updates the whole
# trailing matrix once per column, which is n passes over n² numbers; this
# updates it once per block of columns, which is the same arithmetic with a
# sixty-fourth of the reading and writing, and it is what a LAPACK does.
# A matrix smaller than one block takes the first branch and is the
# unblocked algorithm exactly.
private fn lu_walk(d: Buf(Float), n, piv: Buf(Int), nb, k, sign, ok) =
  if k >= n || !ok then (sign, ok)
  else
    w = if n - k < nb then n - k else nb
    (sg, good) = panel_lu(d, n, piv, k, w, sign, ok)
    if !good then (sg, false)
    else
      trsm_panel(d, n, k, w)
      gemm_sub(d, (k + w) * n + k + w, n, d, (k + w) * n + k, n, d, k * n + k + w, n, n - k - w, w, n - k - w)
      lu_walk(d, n, piv, nb, k + w, sg, good)

# The block of columns, factored in a copy of its own laid the other way
# round: column by column is how this has to go, and a column of a
# row-major matrix is one number per cache line, four hundred lines to
# read four hundred numbers. Copied out transposed — the panel is a few
# tens of kilobytes, so the copy is free beside what it saves — a column
# becomes a run of neighbours, the pivot search and the scaling read it at
# the speed of memory rather than of misses, and the rank-one update
# vectorizes.
#
# A row exchange has to move the whole row, so the two parts outside the
# panel are swapped where they are.
private fn panel_lu(d: Buf(Float), n, piv: Buf(Int), k, w, sign, ok) =
  h = n - k
  t = buf_float_uninit(w * h)
  for c in 0..w
    col = c * h
    src = k * n + k + c
    for r in 0..h
      t[col + r] = d[src + r * n]
  (sg, good) = panel_core(t, h, w, piv, d, n, k, sign, ok)
  for c in 0..w
    col = c * h
    dst = k * n + k + c
    for r in 0..h
      d[dst + r * n] = t[col + r]
  (sg, good)

private fn panel_core(t: Buf(Float), h, w, piv: Buf(Int), d: Buf(Float), n, k, sign, ok) =
  for c in 0..w with acc = (sign, ok)
    (sg, good) = acc
    col = c * h
    p = for r in c + 1..h with best = c
      if fabs(t[col + r]) > fabs(t[col + best]) then r else best
    if fabs(t[col + p]) == 0.0 then (sg, false)
    else
      sg2 = if p != c then
        for cc in 0..w
          base = cc * h
          x = t[base + c]
          t[base + c] = t[base + p]
          t[base + p] = x
        swap_row_span(d, n, k + c, k + p, 0, k)
        swap_row_span(d, n, k + c, k + p, k + w, n)
        was = piv[k + c]
        piv[k + c] = piv[k + p]
        piv[k + p] = was
        0.0 - sg
      else sg
      # Multiplying by the reciprocal rather than dividing by the pivot: a
      # division is ten times a multiplication and there is one of them per
      # element under the diagonal.
      rp = 1.0 / t[col + c]
      for r in c + 1..h
        t[col + r] = t[col + r] * rp
      for cc in c + 1..w
        f = t[cc * h + c]
        base = cc * h
        for r in c + 1..h
          t[base + r] = t[base + r] - f * t[col + r]
      (sg2, good)

private fn swap_row_span(d: Buf(Float), n, i, j, c0, c1) =
  ri = i * n
  rj = j * n
  for c in c0..c1
    x = d[ri + c]
    d[ri + c] = d[rj + c]
    d[rj + c] = x
  0

# The rows of the block, worked forwards through the unit lower triangle,
# which turns the columns to the right of the block into their part of U.
private fn trsm_panel(d: Buf(Float), n, k, w) =
  for i in k + 1..k + w
    for t in k..i
      f = d[i * n + t]
      for c in k + w..n
        d[i * n + c] = d[i * n + c] - f * d[t * n + c]
  0

# `c -= a * b`, where all three sit inside bigger buffers: `coff`, `aoff`
# and `boff` say where each starts and `cld`, `ald` and `bld` how wide the
# buffer each lives in is. `c` is `m` by `nn`, `a` is `m` by `kk`, `b` is
# `kk` by `nn`.
#
# Four rows by eight columns at a time, the sixteen answers kept in
# `Float2` registers while the shared dimension is walked — the same shape
# of kernel as `matmul`, and for the same reason: written as one
# multiply-add per sixteen bytes moved it is the memory bus that answers,
# not the processor. Both halves of solving go through this: the trailing
# update of the factorisation, and the substitutions afterwards.
type Blk
  Blk(c00: Float2, c01: Float2, c02: Float2, c03: Float2, c10: Float2, c11: Float2, c12: Float2, c13: Float2, c20: Float2, c21: Float2, c22: Float2, c23: Float2, c30: Float2, c31: Float2, c32: Float2, c33: Float2)

private fn gemm_sub(c: Buf(Float), coff, cld, a: Buf(Float), aoff, ald, b: Buf(Float), boff, bld, m, kk, nn) =
  nr = m / 4
  nc = nn / 8
  # Each strand takes a stripe of four-row tiles: they write to rows of
  # their own and read what they share, so there is nothing to agree about.
  flops = 2 * m * kk * nn
  if par_flops(flops) then run_split(strands_for(flops), nr, \lo, hi -> gemm_rows(c, coff, cld, a, aoff, ald, b, boff, bld, kk, nc, lo, hi)) else gemm_rows(c, coff, cld, a, aoff, ald, b, boff, bld, kk, nc, 0, nr)

  for i in nr * 4..m
    for t in 0..kk
      f = a[aoff + i * ald + t]
      for j in 0..nn
        c[coff + i * cld + j] = c[coff + i * cld + j] - f * b[boff + t * bld + j]
  for i in 0..nr * 4
    for t in 0..kk
      f = a[aoff + i * ald + t]
      for j in nc * 8..nn
        c[coff + i * cld + j] = c[coff + i * cld + j] - f * b[boff + t * bld + j]
  0

private fn gemm_rows(c: Buf(Float), coff, cld, a: Buf(Float), aoff, ald, b: Buf(Float), boff, bld, kk, nc, lo, hi) =
  for bi in lo..hi
    for bj in 0..nc
      gemm_block(c, coff, cld, a, aoff, ald, b, boff, bld, kk, bi * 4, bj * 8)
  0

private fn gemm_block(c: Buf(Float), coff, cld, a: Buf(Float), aoff, ald, b: Buf(Float), boff, bld, kk, i0, j0) =
  ar0 = aoff + i0 * ald
  ar1 = ar0 + ald
  ar2 = ar1 + ald
  ar3 = ar2 + ald
  cr0 = coff + i0 * cld + j0
  cr1 = cr0 + cld
  cr2 = cr1 + cld
  cr3 = cr2 + cld
  Blk(c00, c01, c02, c03, c10, c11, c12, c13, c20, c21, c22, c23, c30, c31, c32, c33) = for t in 0..kk with acc = Blk(splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0), splat2(0.0))
    Blk(p00, p01, p02, p03, p10, p11, p12, p13, p20, p21, p22, p23, p30, p31, p32, p33) = acc
    x0 = splat2(a[ar0 + t])
    x1 = splat2(a[ar1 + t])
    x2 = splat2(a[ar2 + t])
    x3 = splat2(a[ar3 + t])
    br = boff + t * bld + j0
    y0 = f2_load(b, br)
    y1 = f2_load(b, br + 2)
    y2 = f2_load(b, br + 4)
    y3 = f2_load(b, br + 6)
    Blk(fma2(x0, y0, p00), fma2(x0, y1, p01), fma2(x0, y2, p02), fma2(x0, y3, p03), fma2(x1, y0, p10), fma2(x1, y1, p11), fma2(x1, y2, p12), fma2(x1, y3, p13), fma2(x2, y0, p20), fma2(x2, y1, p21), fma2(x2, y2, p22), fma2(x2, y3, p23), fma2(x3, y0, p30), fma2(x3, y1, p31), fma2(x3, y2, p32), fma2(x3, y3, p33))
  f2_store(c, cr0, f2_load(c, cr0) - c00)
  f2_store(c, cr0 + 2, f2_load(c, cr0 + 2) - c01)
  f2_store(c, cr0 + 4, f2_load(c, cr0 + 4) - c02)
  f2_store(c, cr0 + 6, f2_load(c, cr0 + 6) - c03)
  f2_store(c, cr1, f2_load(c, cr1) - c10)
  f2_store(c, cr1 + 2, f2_load(c, cr1 + 2) - c11)
  f2_store(c, cr1 + 4, f2_load(c, cr1 + 4) - c12)
  f2_store(c, cr1 + 6, f2_load(c, cr1 + 6) - c13)
  f2_store(c, cr2, f2_load(c, cr2) - c20)
  f2_store(c, cr2 + 2, f2_load(c, cr2 + 2) - c21)
  f2_store(c, cr2 + 4, f2_load(c, cr2 + 4) - c22)
  f2_store(c, cr2 + 6, f2_load(c, cr2 + 6) - c23)
  f2_store(c, cr3, f2_load(c, cr3) - c30)
  f2_store(c, cr3 + 2, f2_load(c, cr3 + 2) - c31)
  f2_store(c, cr3 + 4, f2_load(c, cr3 + 4) - c32)
  f2_store(c, cr3 + 6, f2_load(c, cr3 + 6) - c33)
  0

# The row at or below `k` with the largest number in column `k`.
private fn pivot_row(d: Buf(Float), n, k) =
  for i in k + 1..n with best = k
    if fabs(d[i * n + k]) > fabs(d[best * n + k]) then i else best

private fn swap_rows(d: Buf(Float), n, i, j) =
  for c in 0..n
    t = d[i * n + c]
    d[i * n + c] = d[j * n + c]
    d[j * n + c] = t
  0

# `x` such that `a x = b`, for a vector `b` or a matrix of them.
#
#     m = g.of(Cons(2.0, Cons(1.0, Cons(1.0, Cons(3.0, Nil))))) |> g.reshape2(2, 2)
#     g.solve(m, g.of(Cons(3.0, Cons(5.0, Nil))))   # => [0.7999999999999999, 1.4000000000000001]
fn solve(a: Grid, b: Grid) =
  x = try_solve(a, b)
  if size(x) == 0 && size(b) != 0 then
    fail("solve: the matrix is singular")
    b
  else x

# The same, saying so by handing back a grid of no elements rather than
# stopping the program — what a host that has to answer for itself calls.
#
#     singular = g.ones2(2, 2)
#     g.size(g.try_solve(singular, g.ones1(2)))   # => 0
fn try_solve(a: Grid, b: Grid) =
  if rows_of(a) != cols_of(a) then
    fail("solve: " + show_shape(a.shape) + " is not square")
    b
  else if rows_of(a) != rows_of(b) then
    fail("solve: " + show_shape(a.shape) + " against " + show_shape(b.shape))
    b
  else
    f = lu(a)
    if !f.ok then zeros1(0) else lu_solve(f, b)

private fn lu_solve(f: Lu, b: Grid) =
  n = rows_of(f.a)
  kc = if ndim(b) == 1 then 1 else cols_of(b)
  d = f.a.data
  bd = dense(b).data
  x = fresh(dup_shape(b.shape))
  o = x.data
  # The right-hand side in the order the rows were taken.
  for i in 0..n
    for j in 0..kc
      o[i * kc + j] = bd[f.piv[i] * kc + j]
  if par_flops(2 * n * n * kc) && kc > 1 then run_split(strands_streaming(2 * n * n * kc), kc, \lo, hi -> solve_cols(d, o, n, kc, lo, hi)) else solve_cols(d, o, n, kc, 0, kc)

  x

# The columns `j0` up to `j1` of the answer: forwards through L, then
# backwards through U.
private fn solve_cols(d: Buf(Float), o: Buf(Float), n, kc, j0, j1) =
  nb = 16
  blocks = (n + nb - 1) / nb
  width = j1 - j0
  # Forwards through L, twenty-four rows at a time: settle the rows of one
  # block against each other, then take that block out of everything below
  # it in one multiplication. The same blocking as the factorisation, and
  # for the same reason — with one right-hand side it is arithmetic either
  # way, with a matrix of them it is the difference between reading the
  # triangle once per row and once per block.
  for kb in 0..blocks
    k = kb * nb
    w = if n - k < nb then n - k else nb
    for t in k..k + w
      for i in t + 1..k + w
        fct = d[i * n + t]
        for j in j0..j1
          o[i * kc + j] = o[i * kc + j] - fct * o[t * kc + j]
    gemm_sub(o, (k + w) * kc + j0, kc, d, (k + w) * n + k, n, o, k * kc + j0, kc, n - k - w, w, width)
  # Backwards through U, the same way and from the other end.
  for kb in 0..blocks
    k = (blocks - 1 - kb) * nb
    w = if n - k < nb then n - k else nb
    for tt in 0..w
      t = k + w - 1 - tt
      rp = 1.0 / d[t * n + t]
      for j in j0..j1
        o[t * kc + j] = o[t * kc + j] * rp
      for i in k..t
        fct = d[i * n + t]
        for j in j0..j1
          o[i * kc + j] = o[i * kc + j] - fct * o[t * kc + j]
    gemm_sub(o, j0, kc, d, k, n, o, k * kc + j0, kc, k, w, width)
  0

# The columns `j0` up to `j1` of the inverse: forwards through L, then
# backwards through U. `o` holds the identity on the way in and the answer
# on the way out, before the columns are put back in order.
private fn inv_cols(d: Buf(Float), o: Buf(Float), n, j0, j1) =
  nb = 16
  blocks = (n + nb - 1) / nb
  width = j1 - j0
  # Forwards through L. Column j is zero above row j, so a block that ends
  # at row k + w has nothing to say to the columns past it.
  for kb in 0..blocks
    k = kb * nb
    w = if n - k < nb then n - k else nb
    act = if k + w < n then k + w else n
    hi = if j1 < act then j1 else act
    if hi > j0 then
      for t in k..k + w
        for i in t + 1..k + w
          fct = d[i * n + t]
          for j in j0..hi
            o[i * n + j] = o[i * n + j] - fct * o[t * n + j]
      gemm_sub(o, (k + w) * n + j0, n, d, (k + w) * n + k, n, o, k * n + j0, n, n - k - w, w, hi - j0)
    else 0

  # Backwards through U, all the way across.
  for kb in 0..blocks
    k = (blocks - 1 - kb) * nb
    w = if n - k < nb then n - k else nb
    for tt in 0..w
      t = k + w - 1 - tt
      rp = 1.0 / d[t * n + t]
      for j in j0..j1
        o[t * n + j] = o[t * n + j] * rp
      for i in k..t
        fct = d[i * n + t]
        for j in j0..j1
          o[i * n + j] = o[i * n + j] - fct * o[t * n + j]
    gemm_sub(o, j0, n, d, k, n, o, k * n + j0, n, k, w, width)
  0

# The determinant: the product down U's diagonal, with the sign the row
# exchanges left. Zero when the matrix is singular.
#
#     g.det(g.of(Cons(1.0, Cons(2.0, Cons(3.0, Cons(4.0, Nil))))) |> g.reshape2(2, 2))   # => -2
#     g.det(g.ones2(2, 2))                                                            # => 0
fn det(a: Grid) =
  f = lu(a)
  if !f.ok then 0.0
  else
    n = rows_of(a)
    for i in 0..n with acc = f.sign
      acc * f.a.data[i * n + i]

# The inverse. Solving against the identity would do it, but a third of
# that work is on zeros: the forward pass turns the identity into a lower
# triangle, so a block of rows only has to touch the columns it can have
# reached. Doing it that way needs the answer's columns put back in the
# order the row exchanges took them out of, which is the last pass here.
#
#     g.inv(g.of(Cons(4.0, Cons(7.0, Cons(2.0, Cons(6.0, Nil))))) |> g.reshape2(2, 2))   # => [[0.6, -0.7000000000000001], [-0.2, 0.4]]
fn inv(a: Grid) =
  x = try_inv(a)
  if size(x) == 0 && rows_of(a) != 0 then
    fail("inv: the matrix is singular")
    a
  else x

#     g.size(g.try_inv(g.ones2(2, 2)))   # => 0
fn try_inv(a: Grid) =
  n = rows_of(a)
  if n != cols_of(a) then
    fail("inv: " + show_shape(a.shape) + " is not square")
    a
  else
    f = lu(a)
    if !f.ok then zeros1(0)
    else
      d = f.a.data
      z = zeros2(n, n)
      o = z.data
      for i in 0..n
        o[i * n + i] = 1.0
      # Every column of the answer is solved on its own, so the columns are
      # what the workers divide between them: one handing round for the
      # whole of it, rather than one per multiplication.
      if par_flops(2 * n * n * n) then run_split(strands_streaming(2 * n * n * n), n, \lo, hi -> inv_cols(d, o, n, lo, hi)) else inv_cols(d, o, n, 0, n)
      # The columns, back where the exchanges took them from.
      out = fresh(shape2(n, n))
      for i in 0..n
        row = i * n
        for k in 0..n
          out.data[row + f.piv[k]] = o[row + k]
      out

# `a` multiplied by itself `k` times, by squaring: a hundredth power is
# seven multiplications rather than ninety-nine.
#
#     g.matrix_power(g.of(Cons(1.0, Cons(1.0, Cons(1.0, Cons(0.0, Nil))))) |> g.reshape2(2, 2), 10)   # => [[89, 55], [55, 34]]
fn matrix_power(a: Grid, k) =
  if k < 0 then matrix_power(inv(a), 0 - k) else if k == 0 then identity(rows_of(a)) else power_walk(a, k, identity(rows_of(a)))

private fn power_walk(a: Grid, k, acc: Grid) =
  if k == 0 then acc else power_walk(matmul(a, a), k / 2, if k % 2 == 1 then matmul(acc, a) else acc)

# The least-squares solution of an overdetermined system, through the
# normal equations: `x` least-squaring `a x - b`. Forming `aᵀa` squares the
# conditioning, so a badly conditioned `a` wants a decomposition this
# library does not have yet.
#
#     xs = g.of(Cons(1.0, Cons(1.0, Cons(1.0, Cons(2.0, Cons(1.0, Cons(3.0, Nil))))))) |> g.reshape2(3, 2)
#     g.lstsq(xs, g.of(Cons(2.0, Cons(4.0, Cons(6.0, Nil))))) |> g.allclose(g.of(Cons(0.0, Cons(2.0, Nil))), 0.000001)   # => true
fn lstsq(a: Grid, b: Grid) =
  at = transpose(a)
  solve(matmul(at, a), matvec(at, b))

#     g.size(g.try_lstsq(g.zeros2(2, 2), g.ones1(2)))   # => 0
fn try_lstsq(a: Grid, b: Grid) =
  at = transpose(a)
  try_solve(matmul(at, a), matvec(at, b))

# The sizes of a matrix: the largest column sum, the largest row sum, and
# the square root of the sum of the squares.
#
#     g.norm1(g.of(Cons(1.0, Cons(-2.0, Cons(3.0, Cons(4.0, Nil))))) |> g.reshape2(2, 2))   # => 6
fn norm1(a: Grid) =
  r = rows_of(a)
  c = cols_of(a)
  for j in 0..c with best = 0.0
    s = for i in 0..r with acc = 0.0
      acc + fabs(at2(a, i, j))
    if s > best then s else best

#     g.norm_inf(g.of(Cons(1.0, Cons(-2.0, Cons(3.0, Cons(4.0, Nil))))) |> g.reshape2(2, 2))   # => 7
fn norm_inf(a: Grid) =
  r = rows_of(a)
  c = cols_of(a)
  for i in 0..r with best = 0.0
    s = for j in 0..c with acc = 0.0
      acc + fabs(at2(a, i, j))
    if s > best then s else best

#     g.norm_fro(g.of(Cons(3.0, Cons(0.0, Cons(0.0, Cons(4.0, Nil))))) |> g.reshape2(2, 2))   # => 5
fn norm_fro(a: Grid) = norm(flatten(copy(a)))

# How far from singular, measured with the largest column sum.
#
#     g.cond(g.identity(3))   # => 1
fn cond(a: Grid) = norm1(a) * norm1(inv(a))

# The dot product under other names, the outer product of every pair, and
# the cross product of two three-element vectors.
#
#     g.inner(g.of(Cons(1.0, Cons(2.0, Nil))), g.of(Cons(3.0, Cons(4.0, Nil))))   # => 11
fn inner(a: Grid, b: Grid) = dot(a, b)

#     g.vdot(g.of(Cons(1.0, Cons(2.0, Nil))), g.of(Cons(3.0, Cons(4.0, Nil))))   # => 11
fn vdot(a: Grid, b: Grid) = dot(a, b)

#     g.kron(g.of(Cons(1.0, Cons(2.0, Nil))) |> g.as_rows, g.of(Cons(1.0, Cons(10.0, Nil))) |> g.as_rows)   # => [[1, 10, 2, 20]]
fn kron(a: Grid, b: Grid) =
  ra = rows_of(a)
  ca = cols_of(a)
  rb = rows_of(b)
  cb = cols_of(b)
  out = fresh(shape2(ra * rb, ca * cb))
  cols = ca * cb
  for i in 0..ra
    for j in 0..ca
      v = at2(a, i, j)
      for p in 0..rb
        for q in 0..cb
          out.data[(i * rb + p) * cols + j * cb + q] = v * at2(b, p, q)
  out

#     g.cross(g.of(Cons(1.0, Cons(0.0, Cons(0.0, Nil)))), g.of(Cons(0.0, Cons(1.0, Cons(0.0, Nil)))))   # => [0, 0, 1]
fn cross(a: Grid, b: Grid) =
  x = dense(a)
  y = dense(b)
  out = fresh(shape1(3))
  out.data[0] = x.data[1] * y.data[2] - x.data[2] * y.data[1]
  out.data[1] = x.data[2] * y.data[0] - x.data[0] * y.data[2]
  out.data[2] = x.data[0] * y.data[1] - x.data[1] * y.data[0]
  out

# -- text -------------------------------------------------------------------

impl Show(Grid)
  fn show(g) = render(g)

#     g.render(g.arange(3))   # => [0, 1, 2]
fn render(g: Grid) =
  b = strbuf()
  if ndim(g) == 1 then
    render_row(b, g, 0)
  else
    b += "["
    for i in 0..g.shape[0]
      b += if i > 0 then ", " else ""
      render_row(b, g, i)
    b += "]"
  strbuf_str(b)

private fn render_row(b: StrBuf, g: Grid, i) =
  b += "["
  n = if ndim(g) == 1 then g.shape[0] else g.shape[1]
  for j in 0..n
    b += if j > 0 then ", " else ""
    b += float_to_str(if ndim(g) == 1 then at1(g, j) else at2(g, i, j))
  b += "]"

impl Show(Mask)
  fn show(m) = render_mask(m)

#     g.render_mask(g.gtk(g.arange(3), 1.0))   # => [false, false, true]
fn render_mask(m: Mask) =
  b = strbuf()
  if #m.shape == 1 then
    render_mask_row(b, m, 0, m.shape[0])
  else
    b += "["
    c = m.shape[1]
    for i in 0..m.shape[0]
      b += if i > 0 then ", " else ""
      render_mask_row(b, m, i * c, c)
    b += "]"
  strbuf_str(b)

private fn render_mask_row(b: StrBuf, m: Mask, start, n) =
  b += "["
  for j in 0..n
    b += if j > 0 then ", " else ""
    b += if m.bits[start + j] != 0 then "true" else "false"
  b += "]"
