module grid

# grid — arrays of numbers with a shape, the way NumPy has them.
#
# A grid is one flat `Buf(Float)` and the shape laid over it: `shape` says
# how many along each axis, `strides` how far to step in the buffer for one
# along each axis, `off` where element zero sits. `transpose`, `rows`, `col`
# and `slice1` are views — the same buffer, a different shape — and cost
# nothing; `copy` and every operation that makes a new grid lay their result
# out contiguously, which is the shape every fast path here recognises.
#
# The arithmetic (`add`, `mul`, `gsqrt`, `sum`, `matmul` …) is written as
# plain loops over the buffer rather than through a lambda per element, so
# that the compiler can hoist the bounds checks and vectorize; `map` and
# `zip` take a lambda and are for everything the named operations do not
# cover. A grid is storage, as a `Buf` is: `put1`/`put2` write in place, and
# the views share it.
#
# A comparison makes a `Mask` — one byte per element, as NumPy's boolean
# arrays are — and `where`, `mcount`, `any` and `all` read one.
#
# What is here, by section: shapes and views; making grids; elementwise
# arithmetic and the rest of the maths; masks and `where`; reductions,
# including the `nan`-skipping ones and the order statistics; joining,
# sorting and searching; and solving, on an LU factorisation with partial
# pivoting. What is not here: dtypes other than float, more than two
# dimensions, broadcasting between different shapes, and the decompositions
# beyond LU.
#
# Three things keep it fast. An operation writes its result into an
# operand's own storage when that operand is a temporary nobody else can
# see (`unique`), so `a * 2.0 + 1.0` makes one grid and not two. The
# reductions run eight partial sums in four vector lanes, and `matmul` is a
# register-blocked kernel written in `Float2`. And on a `--parallel` build
# with `RILL_THREADS` set, anything over a quarter of a million elements is
# split across the workers in strands; a single-worker run never spawns.
#
#   import "num/grid" as g
#   a = g.arange(6) |> g.reshape2(2, 3)
#   b = g.transpose(a)
#   println(g.matmul(a, b))     # [[5, 14], [14, 50]]
#
# From Python it is `import grid as g` — `bindings/python` builds this
# library into a shared object and gives its handles NumPy's notation.
#
#     import "num/grid" as g
#     a = g.arange(6) |> g.reshape2(2, 3)
#     a                                  # => [[0, 1, 2], [3, 4, 5]]
#     b = g.transpose(a)
#     g.matmul(a, b)                     # => [[5, 14], [14, 50]]
#     g.sum(a)                           # => 15
#     g.gtk(a, 2.0)                      # => [[false, false, false], [true, true, true]]
#     g.where(g.gtk(a, 2.0), a, g.zeros_like(a))   # => [[0, 0, 0], [3, 4, 5]]

extern "m" fn sqrt(x: Float) -> Float

extern "m" fn exp(x: Float) -> Float

extern "m" fn log(x: Float) -> Float

extern "m" fn pow(x: Float, y: Float) -> Float

extern "m" fn floor(x: Float) -> Float

extern "m" fn ceil(x: Float) -> Float

extern "m" fn trunc(x: Float) -> Float

extern "m" fn round(x: Float) -> Float

extern "m" fn rint(x: Float) -> Float

extern "m" fn sin(x: Float) -> Float

extern "m" fn cos(x: Float) -> Float

extern "m" fn tan(x: Float) -> Float

extern "m" fn asin(x: Float) -> Float

extern "m" fn acos(x: Float) -> Float

extern "m" fn atan(x: Float) -> Float

extern "m" fn atan2(y: Float, x: Float) -> Float

extern "m" fn sinh(x: Float) -> Float

extern "m" fn cosh(x: Float) -> Float

extern "m" fn tanh(x: Float) -> Float

extern "m" fn exp2(x: Float) -> Float

extern "m" fn expm1(x: Float) -> Float

extern "m" fn log2(x: Float) -> Float

extern "m" fn log10(x: Float) -> Float

extern "m" fn log1p(x: Float) -> Float

extern "m" fn cbrt(x: Float) -> Float

extern "m" fn hypot(x: Float, y: Float) -> Float

extern "m" fn fmod(x: Float, y: Float) -> Float

extern "m" fn copysign(x: Float, y: Float) -> Float

extern "m" fn fabs(x: Float) -> Float

type Grid
  Grid(shape: Buf(Int), strides: Buf(Int), off: Int, data: Buf(Float))

# 1 where a comparison held, 0 where it did not; always contiguous.
type Mask
  Mask(shape: Buf(Int), bits: Buf(U8))

# -- shape ----------------------------------------------------------------------

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.ndim(a)              # => 2
#     g.ndim(g.arange(3))    # => 1
fn ndim(g: Grid) = #g.shape

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.size(a)   # => 6
fn size(g: Grid) = count(g.shape)

#     g.count(g.shape2(2, 3))   # => 6
fn count(shape: Buf(Int)) =
  for d in 0..#shape with n = 1
    n * shape[d]

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.rows_of(a)   # => 2
fn rows_of(g: Grid) = g.shape[0]

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.cols_of(a)   # => 3
fn cols_of(g: Grid) = if ndim(g) == 1 then g.shape[0] else g.shape[1]

# Row-major strides for a shape: the last axis steps by one.
private fn rowmajor(shape: Buf(Int)) =
  s = buf_int(#shape)
  fn back(d, step) =
    if d < 0 then 0
    else
      s[d] = step
      back(d - 1, step * shape[d])
  back(#shape - 1, 1)
  s

#     #g.shape1(4)      # => 1
#     g.shape1(4)[0]    # => 4
fn shape1(n) =
  s = buf_int(1)
  s[0] = n
  s

#     s = g.shape2(2, 3)
#     s[0]   # => 2
#     s[1]   # => 3
fn shape2(r, c) =
  s = buf_int(2)
  s[0] = r
  s[1] = c
  s

#     g.same_shape(g.zeros2(2, 3), g.ones2(2, 3))   # => true
#     g.same_shape(g.zeros2(2, 3), g.ones2(3, 2))   # => false
fn same_shape(a: Grid, b: Grid) = #a.shape == #b.shape && same_dims(a, b)

private fn same_dims(a: Grid, b: Grid) =
  for d in 0..#a.shape with ok = true
    ok && a.shape[d] == b.shape[d]

# Whether the elements sit in the buffer in order, starting at its front.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.contiguous(a)                # => true
#     g.contiguous(g.transpose(a))   # => false
fn contiguous(g: Grid) = g.off == 0 && #g.data == size(g) && standard_strides(g)

private fn standard_strides(g: Grid) =
  std = rowmajor(g.shape)
  for d in 0..#std with ok = true
    ok && (g.strides[d] == std[d] || g.shape[d] == 1)

private fn fail(msg) =
  println("grid: " + msg)
  exit(1)
  0

private fn need_same(a: Grid, b: Grid, what) =
  if same_shape(a, b) then 0 else fail(what + ": shapes differ, " + show_shape(a.shape) + " and " + show_shape(b.shape))

private fn need_mask(m: Mask, a: Grid, what) =
  if count(m.shape) == size(a) then 0 else fail(what + ": mask has " + int_to_str(count(m.shape)) + " elements, grid " + int_to_str(size(a)))

private fn show_shape(shape: Buf(Int)) =
  b = strbuf()
  b += "("
  for d in 0..#shape
    b += if d > 0 then ", " else ""
    b += int_to_str(shape[d])
  b += ")"
  strbuf_str(b)

# -- strands --------------------------------------------------------------------

# Work worth splitting: enough elements that the strands' start and the
# wait for them are small against the work — a few million, a millisecond
# or so of streaming — and more than one worker to split it over. On a
# single-worker run nothing here ever spawns.
private fn par(n) = n > 4194304 && workers() > 1

# The same question asked of arithmetic rather than elements: a matrix
# multiplication moves far less memory per operation than a pass over an
# array does, so it is worth splitting at a hundredth of the size.
private fn par_flops(f) = f > 1500000 && workers() > 1

# One strand per million operations, up to what the machine has.
private fn strands_for(flops) =
  want = flops / 1000000
  if want > workers() then workers() else want

# The same question for work that reads far more than it computes: solving
# against many right-hand sides walks the whole triangle once per strand,
# so past a few strands it is the memory bus that answers and another
# strand only makes it wait. One per thirty-two million operations.
private fn strands_streaming(flops) =
  want = flops / 32000000
  if want > workers() then workers() else want

private fn chunk_job(f, lo, hi, done) =
  f(lo, hi)
  send(done, 0)

# `f(lo, hi)` over [0, n) split evenly across the workers, and waits.
private fn run(n, f) = run_split(workers(), n, f)

# The same over a given number of pieces. Starting ten strands and waiting
# for them costs thirty-five microseconds; four costs five. A piece of work
# worth eighty microseconds is worth four strands and not ten, and a
# factorisation makes dozens of such pieces — so the count follows the work
# rather than the machine.
private fn run_split(chunks, n, f) =
  w = if chunks < 1 then 1 else if chunks > n then n else chunks
  if w < 2 then f(0, n)
  else
    done = channel()
    # `f` writes its own range of the result and nothing else: the claim a
    # `--parallel` build asks for, since what a closure holds is not in its
    # type. See "What strands may share" in the reference.
    for t in 0..w
      spawn chunk_job(apart(f), n * t / w, n * (t + 1) / w, done)
    for t in 0..w
      recv(done)

private fn part_job(f, t, lo, hi, out) = send(out, (t, f(lo, hi)))

# Each worker's `f` over its share, combined in worker order — the same
# order every run, so the answer is the same every run.
private fn reduce_f(n, f, combine) =
  w = workers()
  out = channel()
  # `f` only reads its range; `apart` is the claim, as above.
  for t in 0..w
    spawn part_job(apart(f), t, n * t / w, n * (t + 1) / w, out)
  parts = buf_float(w)
  for t in 0..w
    (i, v) = recv(out)
    parts[i] = v
  for t in 1..w with acc = parts[0]
    combine(acc, parts[t])

private fn part_job2(f, t, lo, hi, out) =
  (m, i) = f(lo, hi)
  send(out, (t, m, i))

# The same for a (value, place) pair.
private fn reduce_fi(n, f, combine) =
  w = workers()
  out = channel()
  for t in 0..w
    spawn part_job2(apart(f), t, n * t / w, n * (t + 1) / w, out)
  ms = buf_float(w)
  is = buf_int(w)
  for t in 0..w
    (k, m, i) = recv(out)
    ms[k] = m
    is[k] = i
  (m, i) = for t in 1..w with acc = (ms[0], is[0])
    (am, ai) = acc
    combine(am, ai, ms[t], is[t])
  (m, i)

# -- making grids ---------------------------------------------------------------

#     g.zeros(g.shape2(2, 2))   # => [[0, 0], [0, 0]]
fn zeros(shape: Buf(Int)) = Grid(shape, rowmajor(shape), 0, buf_float(count(shape)))

# A grid about to have every element written: no clearing pass first.
private fn fresh(shape: Buf(Int)) = Grid(shape, rowmajor(shape), 0, buf_float_uninit(count(shape)))

#     g.zeros1(3)   # => [0, 0, 0]
fn zeros1(n) = zeros(shape1(n))

#     g.zeros2(1, 2)   # => [[0, 0]]
fn zeros2(r, c) = zeros(shape2(r, c))

#     g.full(g.shape1(3), 7.5)   # => [7.5, 7.5, 7.5]
fn full(shape: Buf(Int), v) =
  g = fresh(shape)
  n = size(g)
  for i in 0..n
    g.data[i] = v
  g

#     g.ones(g.shape2(2, 2))   # => [[1, 1], [1, 1]]
fn ones(shape: Buf(Int)) = full(shape, 1.0)

#     g.ones1(2)   # => [1, 1]
fn ones1(n) = ones(shape1(n))

#     g.ones2(2, 1)   # => [[1], [1]]
fn ones2(r, c) = ones(shape2(r, c))

#     g.full2(2, 2, 3.0)   # => [[3, 3], [3, 3]]
fn full2(r, c, v) = full(shape2(r, c), v)

# 0, 1, …, n - 1
#
#     g.arange(5)   # => [0, 1, 2, 3, 4]
fn arange(n) =
  g = fresh(shape1(n))
  for i in 0..n
    g.data[i] = to_float(i)
  g

#     g.linspace(0.0, 1.0, 5)   # => [0, 0.25, 0.5, 0.75, 1]
fn linspace(a, b, n) =
  g = fresh(shape1(n))
  step = if n > 1 then (b - a) / to_float(n - 1) else 0.0
  for i in 0..n
    g.data[i] = a + to_float(i) * step
  g

# A 1-D grid from a list of floats.
#
#     g.of(Cons(1.5, Cons(2.5, Nil)))   # => [1.5, 2.5]
fn of(xs) =
  g = zeros1(len(xs))
  fn fill(l, i) = match l
    Nil -> 0
    Cons(x, rest) ->
      g.data[i] = x
      fill(rest, i + 1)
  fill(xs, 0)
  g

# A grid whose element at (i, j) is `f(i, j)`.
#
#     g.from_fn2(2, 3, \i, j -> to_float(i * 10 + j))   # => [[0, 1, 2], [10, 11, 12]]
fn from_fn2(r, c, f) =
  g = fresh(shape2(r, c))
  for i in 0..r
    for j in 0..c
      g.data[i * c + j] = f(i, j)
  g

#     g.from_fn1(4, \i -> to_float(i * i))   # => [0, 1, 4, 9]
fn from_fn1(n, f) =
  g = fresh(shape1(n))
  for i in 0..n
    g.data[i] = f(i)
  g

# -- elements -------------------------------------------------------------------

#     g.at1(g.arange(5), 3)   # => 3
fn at1(g: Grid, i) = g.data[g.off + i * g.strides[0]]

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.at2(a, 1, 2)   # => 5
fn at2(g: Grid, i, j) = g.data[g.off + i * g.strides[0] + j * g.strides[1]]

#     v = g.zeros1(3)
#     g.put1(v, 1, 9.0)
#     v   # => [0, 9, 0]
fn put1(g: Grid, i, v) =
  g.data[g.off + i * g.strides[0]] = v

#     m = g.zeros2(2, 2)
#     g.put2(m, 1, 0, 9.0)
#     m   # => [[0, 0], [9, 0]]
fn put2(g: Grid, i, j, v) =
  g.data[g.off + i * g.strides[0] + j * g.strides[1]] = v

# The buffer position of the k-th element in row-major order, for any shape.
private fn pos(g: Grid, k) =
  fn walk(d, rest, acc) =
    if d < 0 then acc
    else
      n = g.shape[d]
      walk(d - 1, rest / n, acc + rest % n * g.strides[d])
  walk(#g.shape - 1, k, g.off)

# -- views ----------------------------------------------------------------------

# Two-dimensional transpose: the same buffer read the other way round.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.transpose(a)   # => [[0, 3], [1, 4], [2, 5]]
fn transpose(g: Grid) =
  if ndim(g) != 2 then Grid(g.shape, g.strides, g.off, g.data) else Grid(shape2(g.shape[1], g.shape[0]), shape2(g.strides[1], g.strides[0]), g.off, g.data)

# Rows lo up to hi of a 2-D grid, or elements lo up to hi of a 1-D one.
#
#     m = g.arange(6) |> g.reshape2(3, 2)
#     g.rows(m, 1, 3)   # => [[2, 3], [4, 5]]
#     g.rows(g.arange(5), 1, 3)   # => [1, 2]
fn rows(g: Grid, lo, hi) =
  s = buf_int(#g.shape)
  for d in 0..#g.shape
    s[d] = g.shape[d]
  s[0] = hi - lo
  Grid(s, g.strides, g.off + lo * g.strides[0], g.data)

#     g.slice1(g.arange(5), 2, 4)   # => [2, 3]
fn slice1(g: Grid, lo, hi) = rows(g, lo, hi)

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.row(a, 1)   # => [3, 4, 5]
fn row(g: Grid, i) =
  Grid(shape1(g.shape[1]), shape1(g.strides[1]), g.off + i * g.strides[0], g.data)

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.col(a, 2)   # => [2, 5]
fn col(g: Grid, j) =
  Grid(shape1(g.shape[0]), shape1(g.strides[0]), g.off + j * g.strides[1], g.data)

# A contiguous grid with the same elements.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     t = g.transpose(a)
#     g.contiguous(g.copy(t))   # => true
#     g.copy(t)                 # => [[0, 3], [1, 4], [2, 5]]
fn copy(g: Grid) =
  out = fresh(g.shape)
  n = size(g)
  if contiguous(g) then
    o = out.data
    d = g.data
    if par(n) then run(n, \lo, hi -> copy_part(o, d, lo, hi)) else copy_part(o, d, 0, n)
  else if ndim(g) == 2 then
    r = g.shape[0]
    c = g.shape[1]
    for i in 0..r
      base = g.off + i * g.strides[0]
      st = g.strides[1]
      for j in 0..c
        out.data[i * c + j] = g.data[base + j * st]
  else
    for k in 0..n
      out.data[k] = g.data[pos(g, k)]
  out

private fn copy_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k]

#     g.reshape(g.arange(4), g.shape2(2, 2))   # => [[0, 1], [2, 3]]
fn reshape(g: Grid, shape: Buf(Int)) =
  if count(shape) != size(g) then
    fail("reshape: " + show_shape(g.shape) + " has " + int_to_str(size(g)) + " elements, " + show_shape(shape) + " wants " + int_to_str(count(shape)))
    g
  else
    src = if contiguous(g) then g else copy(g)
    Grid(shape, rowmajor(shape), 0, src.data)

#     g.reshape2(g.arange(6), 3, 2)   # => [[0, 1], [2, 3], [4, 5]]
fn reshape2(g: Grid, r, c) = reshape(g, shape2(r, c))

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.flatten(a)   # => [0, 1, 2, 3, 4, 5]
fn flatten(g: Grid) = reshape(g, shape1(size(g)))

# A grid of the same shape, filled with nothing in particular, with zeros,
# with ones, or with one number.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.same_shape(g.empty_like(a), a)   # => true
fn empty_like(g: Grid) = fresh(g.shape)

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.zeros_like(a)   # => [[0, 0, 0], [0, 0, 0]]
fn zeros_like(g: Grid) = zeros(dup_shape(g.shape))

#     g.ones_like(g.arange(3))   # => [1, 1, 1]
fn ones_like(g: Grid) = full_like(g, 1.0)

#     g.full_like(g.arange(2), 4.0)   # => [4, 4]
fn full_like(g: Grid, v) = full(dup_shape(g.shape), v)

private fn dup_shape(shape: Buf(Int)) =
  s = buf_int(#shape)
  for d in 0..#shape
    s[d] = shape[d]
  s

# A 2-D grid with one row or one column becomes the 1-D grid of its
# elements; anything else is unchanged.
#
#     g.squeeze(g.ones2(1, 3))   # => [1, 1, 1]
#     g.squeeze(g.ones2(2, 2))   # => [[1, 1], [1, 1]]
fn squeeze(g: Grid) =
  if ndim(g) == 2 && (g.shape[0] == 1 || g.shape[1] == 1) then reshape(g, shape1(size(g))) else g

#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.ravel(g.transpose(a))   # => [0, 3, 1, 4, 2, 5]
fn ravel(g: Grid) = flatten(g)

# `n` numbers from `a` to `b`, evenly spaced in the exponent: `logspace`
# takes the ends as powers of the base, `geomspace` as the values.
#
#     g.logspace(0.0, 2.0, 3, 10.0)   # => [1, 10, 100]
fn logspace(a, b, n, base) =
  e = linspace(a, b, n)
  for k in 0..n
    e.data[k] = pow(base, e.data[k])
  e

#     g.geomspace(1.0, 8.0, 4)   # => [1, 2, 4, 8]
#
# The ends are the ends given, as NumPy has them: through `log10` and back,
# 8 came out 7.999999999999999.
fn geomspace(a, b, n) =
  e = logspace(log10(a), log10(b), n, 10.0)
  if n > 0 then
    e.data[0] = a
    e.data[n - 1] = b
  else ()
  e

# Joining: `axis` 0 adds rows, 1 adds columns. Two 1-D grids join end to end.
#
#     g.concat(g.ones2(1, 2), g.zeros2(1, 2), 0)   # => [[1, 1], [0, 0]]
#     g.concat(g.ones2(1, 2), g.zeros2(1, 2), 1)   # => [[1, 1, 0, 0]]
#     g.concat(g.arange(2), g.arange(2), 0)        # => [0, 1, 0, 1]
fn concat(a: Grid, b: Grid, axis) =
  if ndim(a) == 1 && ndim(b) == 1 then
    n = size(a)
    m = size(b)
    out = fresh(shape1(n + m))
    x = dense(a)
    y = dense(b)
    for k in 0..n
      out.data[k] = x.data[k]
    for k in 0..m
      out.data[n + k] = y.data[k]
    out
  else if axis == 0 then
    if cols_of(a) != cols_of(b) then
      fail("concat: " + show_shape(a.shape) + " and " + show_shape(b.shape) + " differ along axis 1")
      a
    else
      r = rows_of(a) + rows_of(b)
      c = cols_of(a)
      out = fresh(shape2(r, c))
      x = dense(a)
      y = dense(b)
      for k in 0..size(a)
        out.data[k] = x.data[k]
      for k in 0..size(b)
        out.data[size(a) + k] = y.data[k]
      out
  else if rows_of(a) != rows_of(b) then
    fail("concat: " + show_shape(a.shape) + " and " + show_shape(b.shape) + " differ along axis 0")
    a
  else
    r = rows_of(a)
    ca = cols_of(a)
    cb = cols_of(b)
    out = fresh(shape2(r, ca + cb))
    x = dense(a)
    y = dense(b)
    for i in 0..r
      for j in 0..ca
        out.data[i * (ca + cb) + j] = x.data[i * ca + j]
      for j in 0..cb
        out.data[i * (ca + cb) + ca + j] = y.data[i * cb + j]
    out

#     g.as_rows(g.arange(3))   # => [[0, 1, 2]]
fn as_rows(g: Grid) = if ndim(g) == 1 then reshape(g, shape2(1, size(g))) else g

#     g.vstack(g.arange(2), g.ones1(2))   # => [[0, 1], [1, 1]]
fn vstack(a: Grid, b: Grid) = concat(as_rows(a), as_rows(b), 0)

#     g.hstack(g.ones2(2, 1), g.zeros2(2, 1))   # => [[1, 0], [1, 0]]
fn hstack(a: Grid, b: Grid) = concat(a, b, 1)

# Two 1-D grids as the two rows of a 2-D one.
#
#     g.stack(g.arange(2), g.ones1(2))   # => [[0, 1], [1, 1]]
fn stack(a: Grid, b: Grid) = vstack(a, b)

# The whole grid laid down `k` times, and each element `k` times over.
#
#     g.tile(g.arange(2), 2)   # => [0, 1, 0, 1]
fn tile(g: Grid, k) =
  n = size(g)
  x = dense(g)
  out = fresh(shape1(n * k))
  for t in 0..k
    for i in 0..n
      out.data[t * n + i] = x.data[i]
  out

#     g.repeat(g.arange(2), 2)   # => [0, 0, 1, 1]
fn repeat(g: Grid, k) =
  n = size(g)
  x = dense(g)
  out = fresh(shape1(n * k))
  for i in 0..n
    for t in 0..k
      out.data[i * k + t] = x.data[i]
  out

# From a 1-D grid, the square matrix with it down the diagonal; from a 2-D
# one, the diagonal itself.
#
#     g.diag(g.arange(2))                          # => [[0, 0], [0, 1]]
#     g.diag(g.arange(4) |> g.reshape2(2, 2))      # => [0, 3]
fn diag(g: Grid) =
  if ndim(g) == 1 then
    n = size(g)
    x = dense(g)
    out = zeros2(n, n)
    for i in 0..n
      out.data[i * n + i] = x.data[i]
    out
  else
    n = if g.shape[0] < g.shape[1] then g.shape[0] else g.shape[1]
    out = fresh(shape1(n))
    for i in 0..n
      out.data[i] = at2(g, i, i)
    out

#     g.diagonal(g.arange(4) |> g.reshape2(2, 2))   # => [0, 3]
fn diagonal(g: Grid) = diag(g)

# The lower and upper triangles, keeping everything on or beyond the k-th
# diagonal and zeroing the rest.
#
#     g.tril(g.ones2(2, 2), 0)   # => [[1, 0], [1, 1]]
fn tril(g: Grid, k) =
  out = copy(g)
  r = rows_of(g)
  c = cols_of(g)
  for i in 0..r
    for j in 0..c
      out.data[i * c + j] = if j - i <= k then out.data[i * c + j] else 0.0
  out

#     g.triu(g.ones2(2, 2), 0)   # => [[1, 1], [0, 1]]
fn triu(g: Grid, k) =
  out = copy(g)
  r = rows_of(g)
  c = cols_of(g)
  for i in 0..r
    for j in 0..c
      out.data[i * c + j] = if j - i >= k then out.data[i * c + j] else 0.0
  out

# Every pair from `x` and `y`, as NumPy lays them out: rows of `x` repeated
# down, columns of `y` repeated across.
#
#     (xs, ys) = g.meshgrid(g.arange(2), g.arange(3))
#     xs   # => [[0, 1], [0, 1], [0, 1]]
#     ys   # => [[0, 0], [1, 1], [2, 2]]
fn meshgrid(x: Grid, y: Grid) =
  nx = size(x)
  ny = size(y)
  xd = dense(x)
  yd = dense(y)
  gx = fresh(shape2(ny, nx))
  gy = fresh(shape2(ny, nx))
  for i in 0..ny
    for j in 0..nx
      gx.data[i * nx + j] = xd.data[j]
      gy.data[i * nx + j] = yd.data[i]
  (gx, gy)

# Reversed: along the last axis, or both axes of a 2-D grid.
#
#     g.fliplr(g.arange(3))                          # => [2, 1, 0]
#     g.fliplr(g.arange(4) |> g.reshape2(2, 2))      # => [[1, 0], [3, 2]]
fn fliplr(g: Grid) =
  x = dense(g)
  out = fresh(dup_shape(g.shape))
  c = cols_of(g)
  r = if ndim(g) == 1 then 1 else rows_of(g)
  for i in 0..r
    for j in 0..c
      out.data[i * c + j] = x.data[i * c + (c - 1 - j)]
  out

#     g.flipud(g.arange(4) |> g.reshape2(2, 2))   # => [[2, 3], [0, 1]]
fn flipud(g: Grid) =
  if ndim(g) == 1 then fliplr(g)
  else
    x = dense(g)
    out = fresh(dup_shape(g.shape))
    r = rows_of(g)
    c = cols_of(g)
    for i in 0..r
      for j in 0..c
        out.data[i * c + j] = x.data[(r - 1 - i) * c + j]
    out

#     g.flip(g.arange(4) |> g.reshape2(2, 2))   # => [[3, 2], [1, 0]]
fn flip(g: Grid) = if ndim(g) == 1 then fliplr(g) else flipud(fliplr(g))

# Everything moved along by `k`, what falls off one end coming back at the
# other.
#
#     g.roll(g.arange(4), 1)    # => [3, 0, 1, 2]
#     g.roll(g.arange(4), -1)   # => [1, 2, 3, 0]
fn roll(g: Grid, k) =
  n = size(g)
  x = dense(g)
  out = fresh(dup_shape(g.shape))
  for i in 0..n
    out.data[(i + k % n + n) % n] = x.data[i]
  out

# The elements at the given positions, which are a grid of numbers.
#
#     g.take(g.of(Cons(10.0, Cons(20.0, Cons(30.0, Nil)))), g.of(Cons(2.0, Cons(0.0, Nil))))   # => [30, 10]
fn take(g: Grid, idx: Grid) =
  x = dense(g)
  ix = dense(idx)
  n = size(idx)
  out = fresh(dup_shape(idx.shape))
  for k in 0..n
    out.data[k] = x.data[to_int(ix.data[k])]
  out

# -- elementwise ------------------------------------------------------------

# The contiguous copy every operation works from when a view is handed in.
#
#     a = g.arange(6) |> g.reshape2(2, 3)
#     g.dense(g.transpose(a))   # => [[0, 3], [1, 4], [2, 5]]
fn dense(g: Grid) = if contiguous(g) then g else copy(g)

# Every operation below writes its result into an operand's own storage
# when that operand is a temporary nobody else can see — `unique(a)` is the
# reference count read as this frame holds it — so `a * 2.0 + 1.0` makes
# one grid and not two, the way NumPy elides its temporaries. A grid that
# is still named somewhere has another holder, and is left alone. The
# loop itself lives in a `_part` function over a range, which is what a
# strand is handed when the grid is big enough to split.

#     g.add(g.arange(3), g.ones1(3))   # => [1, 2, 3]
fn add(a: Grid, b: Grid) =
  need_same(a, b, "add")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> add_into(o, yd, lo, hi)) else add_into(o, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> add_into(o, xd, lo, hi)) else add_into(o, xd, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> add_part(o, xd, yd, lo, hi)) else add_part(o, xd, yd, 0, n)
    out

private fn add_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] + y[k]

# The same, written into the first operand's own storage: one buffer, so
# the loop has no overlap to worry about and vectorizes as the fresh one.
#
#     v = g.arange(3)
#     g.add_into(v.data, g.ones1(3).data, 0, 3)   # the buffers, over a range: what the Python binding calls
#     v   # => [1, 2, 3]
fn add_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] + y[k]

#     g.sub(g.arange(3), g.ones1(3))   # => [-1, 0, 1]
fn sub(a: Grid, b: Grid) =
  need_same(a, b, "sub")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> sub_into(o, yd, lo, hi)) else sub_into(o, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> sub_onto(xd, o, lo, hi)) else sub_onto(xd, o, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> sub_part(o, xd, yd, lo, hi)) else sub_part(o, xd, yd, 0, n)
    out

private fn sub_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] - y[k]

# The same, written into the first operand's own storage: one buffer, so
# the loop has no overlap to worry about and vectorizes as the fresh one.
#
#     v = g.arange(3)
#     g.sub_into(v.data, g.ones1(3).data, 0, 3)
#     v   # => [-1, 0, 1]
fn sub_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] - y[k]

private fn sub_onto(x: Buf(Float), o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] - o[k]

#     g.mul(g.arange(3), g.arange(3))   # => [0, 1, 4]
fn mul(a: Grid, b: Grid) =
  need_same(a, b, "mul")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> mul_into(o, yd, lo, hi)) else mul_into(o, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> mul_into(o, xd, lo, hi)) else mul_into(o, xd, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> mul_part(o, xd, yd, lo, hi)) else mul_part(o, xd, yd, 0, n)
    out

private fn mul_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] * y[k]

# The same, written into the first operand's own storage: one buffer, so
# the loop has no overlap to worry about and vectorizes as the fresh one.
#
#     v = g.arange(3)
#     g.mul_into(v.data, g.arange(3).data, 0, 3)
#     v   # => [0, 1, 4]
fn mul_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] * y[k]

#     g.div(g.ones1(2), g.full(g.shape1(2), 4.0))   # => [0.25, 0.25]
fn div(a: Grid, b: Grid) =
  need_same(a, b, "div")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> div_into(o, yd, lo, hi)) else div_into(o, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> div_onto(xd, o, lo, hi)) else div_onto(xd, o, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> div_part(o, xd, yd, lo, hi)) else div_part(o, xd, yd, 0, n)
    out

private fn div_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] / y[k]

# The same, written into the first operand's own storage: one buffer, so
# the loop has no overlap to worry about and vectorizes as the fresh one.
#
#     v = g.ones1(2)
#     g.div_into(v.data, g.full(g.shape1(2), 4.0).data, 0, 2)
#     v   # => [0.25, 0.25]
fn div_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = o[k] / y[k]

private fn div_onto(x: Buf(Float), o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = x[k] / o[k]

#     g.maximum(g.arange(3), g.full(g.shape1(3), 1.0))   # => [1, 1, 2]
fn maximum(a: Grid, b: Grid) =
  need_same(a, b, "maximum")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> maximum_into(o, yd, lo, hi)) else maximum_into(o, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> maximum_into(o, xd, lo, hi)) else maximum_into(o, xd, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> maximum_part(o, xd, yd, lo, hi)) else maximum_part(o, xd, yd, 0, n)
    out

private fn maximum_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] > y[k] then x[k] else y[k]

# The same, written into the first operand's own storage: one buffer, so
# the loop has no overlap to worry about and vectorizes as the fresh one.
#
#     v = g.arange(3)
#     g.maximum_into(v.data, g.ones1(3).data, 0, 3)
#     v   # => [1, 1, 2]
fn maximum_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if o[k] > y[k] then o[k] else y[k]

#     g.minimum(g.arange(3), g.full(g.shape1(3), 1.0))   # => [0, 1, 1]
fn minimum(a: Grid, b: Grid) =
  need_same(a, b, "minimum")
  n = size(a)
  if unique(a) && unique(a.data) && contiguous(a) then
    yd = dense(b).data
    o = a.data
    if par(n) then run(n, \lo, hi -> minimum_into(o, yd, lo, hi)) else minimum_into(o, yd, 0, n)
    a
  else if unique(b) && unique(b.data) && contiguous(b) then
    xd = dense(a).data
    o = b.data
    if par(n) then run(n, \lo, hi -> minimum_into(o, xd, lo, hi)) else minimum_into(o, xd, 0, n)
    b
  else
    out = fresh(a.shape)
    xd = dense(a).data
    yd = dense(b).data
    o = out.data
    if par(n) then run(n, \lo, hi -> minimum_part(o, xd, yd, lo, hi)) else minimum_part(o, xd, yd, 0, n)
    out

private fn minimum_part(o: Buf(Float), x: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] < y[k] then x[k] else y[k]

# The same, written into the first operand's own storage: one buffer, so
# the loop has no overlap to worry about and vectorizes as the fresh one.
#
#     v = g.arange(3)
#     g.minimum_into(v.data, g.ones1(3).data, 0, 3)
#     v   # => [0, 1, 1]
fn minimum_into(o: Buf(Float), y: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if o[k] < y[k] then o[k] else y[k]

# Every element times `v`, plus `v`, to the power `v`.
#
#     g.scale(g.arange(3), 2.0)   # => [0, 2, 4]
fn scale(g: Grid, v) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> scale_into(o, v, lo, hi)) else scale_into(o, v, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> scale_part(o, xd, v, lo, hi)) else scale_part(o, xd, v, 0, n)
    out

private fn scale_part(o: Buf(Float), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = x[k] * v

#     v = g.arange(3)
#     g.scale_into(v.data, 2.0, 0, 3)
#     v   # => [0, 2, 4]
fn scale_into(o: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = o[k] * v

#     g.shift(g.arange(3), 10.0)   # => [10, 11, 12]
fn shift(g: Grid, v) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> shift_into(o, v, lo, hi)) else shift_into(o, v, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> shift_part(o, xd, v, lo, hi)) else shift_part(o, xd, v, 0, n)
    out

private fn shift_part(o: Buf(Float), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = x[k] + v

#     v = g.arange(3)
#     g.shift_into(v.data, 10.0, 0, 3)
#     v   # => [10, 11, 12]
fn shift_into(o: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = o[k] + v

#     g.power(g.arange(4), 2.0)   # => [0, 1, 4, 9]
fn power(g: Grid, v) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> power_into(o, v, lo, hi)) else power_into(o, v, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> power_part(o, xd, v, lo, hi)) else power_part(o, xd, v, 0, n)
    out

private fn power_part(o: Buf(Float), x: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = pow(x[k], v)

#     v = g.arange(4)
#     g.power_into(v.data, 2.0, 0, 4)
#     v   # => [0, 1, 4, 9]
fn power_into(o: Buf(Float), v, lo, hi) =
  for k in lo..hi
    o[k] = pow(o[k], v)

#     g.neg(g.arange(3))   # => [-0, -1, -2]
fn neg(g: Grid) = scale(g, -1.0)

#     g.gabs(g.of(Cons(-1.5, Cons(2.0, Nil))))   # => [1.5, 2]
fn gabs(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gabs_into(o, lo, hi)) else gabs_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gabs_part(o, xd, lo, hi)) else gabs_part(o, xd, 0, n)
    out

private fn gabs_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if x[k] < 0.0 then 0.0 - x[k] else x[k]

#     v = g.of(Cons(-1.5, Nil))
#     g.gabs_into(v.data, 0, 1)
#     v   # => [1.5]
fn gabs_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = if o[k] < 0.0 then 0.0 - o[k] else o[k]

#     g.gsqrt(g.of(Cons(4.0, Cons(9.0, Nil))))   # => [2, 3]
fn gsqrt(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gsqrt_into(o, lo, hi)) else gsqrt_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gsqrt_part(o, xd, lo, hi)) else gsqrt_part(o, xd, 0, n)
    out

private fn gsqrt_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = sqrt(x[k])

#     v = g.of(Cons(4.0, Nil))
#     g.gsqrt_into(v.data, 0, 1)
#     v   # => [2]
fn gsqrt_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = sqrt(o[k])

#     g.gexp(g.zeros1(2))   # => [1, 1]
fn gexp(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> gexp_into(o, lo, hi)) else gexp_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> gexp_part(o, xd, lo, hi)) else gexp_part(o, xd, 0, n)
    out

private fn gexp_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = exp(x[k])

#     v = g.zeros1(1)
#     g.gexp_into(v.data, 0, 1)
#     v   # => [1]
fn gexp_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = exp(o[k])

#     g.glog(g.of(Cons(1.0, Nil)))   # => [0]
fn glog(g: Grid) =
  n = size(g)
  if unique(g) && unique(g.data) && contiguous(g) then
    o = g.data
    if par(n) then run(n, \lo, hi -> glog_into(o, lo, hi)) else glog_into(o, 0, n)
    g
  else
    out = fresh(g.shape)
    xd = dense(g).data
    o = out.data
    if par(n) then run(n, \lo, hi -> glog_part(o, xd, lo, hi)) else glog_part(o, xd, 0, n)
    out

private fn glog_part(o: Buf(Float), x: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = log(x[k])

#     v = g.ones1(1)
#     g.glog_into(v.data, 0, 1)
#     v   # => [0]
fn glog_into(o: Buf(Float), lo, hi) =
  for k in lo..hi
    o[k] = log(o[k])

# -- more elementwise ---------------------------------------------------------

# The rest of the maths, one call per element, each written the same way as
# `gsqrt` above: into the operand's own storage when it is a temporary, into
# a fresh grid otherwise, and split across the workers when there is enough
# of it. A name is `g`-prefixed where the plain one is the C function this
# calls.

# pi, to the last bit a double holds.
#
#     g.pi() > 3.14159 && g.pi() < 3.1416   # => true
fn pi() = 3.141592653589793

