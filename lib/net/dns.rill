module dns

# A name to its addresses, through the system's resolver — `/etc/hosts`,
# the nameservers it is configured with, whatever else it consults. The
# lookup is a wait, so it is declared `blocking`: the strand parks while a
# helper thread asks, and the worker goes on with the others.
#
#     dns.ipv4("localhost")                  # => Some(127.0.0.1)
#     res_map(dns.lookup("localhost"), \addrs -> any(addrs, \a -> a == "127.0.0.1"))   # => Ok(true)
extern blocking fn rill_dns_lookup(name: Ptr) -> Ptr

# Every address the name has, IPv4 addresses first and then IPv6, or why
# there are none.
#
#     res_map(dns.lookup("localhost"), \addrs -> any(addrs, \a -> a == "127.0.0.1"))   # => Ok(true)
#     res_map(dns.lookup("no.such.host.invalid"), \addrs -> len(addrs))            # => Err(`no.such.host.invalid` is not a name the resolver knows)
fn lookup(name) =
  if #name == 0 then Err("an empty name")
  else if is_ipv4(name) then Ok(Cons(name, Nil))
  else
    c = to_cstr(name)
    p = rill_dns_lookup(c)
    free_ptr(c)
    if is_null(p) then Err("`" + name + "` is not a name the resolver knows")
    else
      text = from_cstr(p)
      free_ptr(p)
      Ok(filter(lines(text), \l -> #l > 0))

# The first IPv4 address, which is what `tcp_connect` and `udp.send_to` take.
#
#     dns.ipv4("localhost")   # => Some(127.0.0.1)
fn ipv4(name) = match lookup(name)
  Err(_) -> None
  Ok(addrs) -> find(addrs, is_ipv4)

# Four numbers of at most three digits, each below 256, with dots between.
#
#     dns.is_ipv4("192.168.0.1")   # => true
#     dns.is_ipv4("256.1.1.1")     # => false
#     dns.is_ipv4("::1")           # => false
fn is_ipv4(s) =
  parts = split(s, ".")
  len(parts) == 4 && all(parts, \p -> #p > 0 && #p <= 3 && all_digits(p) && str_to_int(p) <= 255)

private fn all_digits(s) =
  for i in 0..#s with ok = true
    ok && s[i] >= 48 && s[i] <= 57

# -- tests --------------------------------------------------------------------

fn test_localhost_and_literals() =
  assert_eq(ipv4("localhost"), Some("127.0.0.1"))
  assert_eq(lookup("10.1.2.3"), Ok(Cons("10.1.2.3", Nil)))
  assert(is_ipv4("0.0.0.0"))
  assert(!is_ipv4("256.1.1.1"))
  assert(!is_ipv4("1.2.3"))
  assert(!is_ipv4("a.b.c.d"))
  assert(!is_ipv4("1.2.3.4."))

fn test_an_unknown_name() =
  assert_eq(lookup(""), Err("an empty name"))
  assert_eq(ipv4("no-such-host.invalid"), None)
  assert_eq(lookup("no-such-host.invalid"), Err("`no-such-host.invalid` is not a name the resolver knows"))
