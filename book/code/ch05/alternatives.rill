type Direction
  North
  South
  East
  West

type Shape
  Circle(r: Float)
  Square(k: Float)

# Arms that go the same way say so once.
fn axis(d) = match d
  North | South -> "vertical"
  East | West -> "horizontal"

# And `@` names the whole of what the pattern matched, so an arm can take a
# value apart to ask about it and hand back the value it was given.
fn grow(s) = match s
  whole @ Circle(r) if r > 10.0 -> whole
  Circle(r) -> Circle(r * 2.0)
  whole @ Square(_) -> whole

fn side(s) = match s
  Circle(r) -> r
  Square(k) -> k

# It nests, unlike `|`: a field that must be 1 and is also called `first`.
fn describe(l) = match l
  Cons(first @ 1, _) -> "starts with " + int_to_str(first)
  Cons(n, _) -> "starts with " + int_to_str(n)
  Nil -> "empty"

fn main() =
  println(axis(North) + " " + axis(West))
  println(float_to_str(side(grow(Circle(2.0)))))
  println(float_to_str(side(grow(Circle(20.0)))))
  println(describe(Cons(1, Nil)) + ", " + describe(Nil))
