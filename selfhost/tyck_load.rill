# Multi-file program loading and the prelude merge: the port of `loader.rs`
# and `prelude.rs`. Imports resolve depth-first before the importing file's
# own definitions; each file loads once; all files share one flat namespace,
# and a name defined twice is an error naming both files. An aliased module
# keeps its names to itself: everything it defines is renamed `alias.name`.
# The prelude merges last and is shadowed by any user definition — a prelude
# function that (transitively) references a dropped name is dropped too.
#
# One divergence from Rust: paths are normalized textually (`.` and `..`
# folded away) rather than canonicalized by the OS, so messages that name
# files print the path as given, not resolved through symlinks.

import "lexer"
import "parser"
import "tyck_decl"

fn tldie(msg) =
  println(msg)
  exit(1)
  tldie(msg)

fn ld_or(o, d) = match o
  Some(x) -> x
  None -> d

fn fnd_name(f) = match f
  FnD(n, _, _, _, _, _, _) -> n

# ---- paths ------------------------------------------------------------------

fn dirname(p) = dn_loop(p, str_len(p) - 1)

fn dn_loop(p, i) =
  if i < 0 then "" else if str_get(p, i) == 47 then str_sub(p, 0, i) else dn_loop(p, i - 1)

fn path_join(dir, name) = if str_cmp(dir, "") == 0 then name else dir + "/" + name

fn norm_path(p) = np_render(np_fold(split_slash(p), Nil), str_len(p) > 0 && str_get(p, 0) == 47)

fn split_slash(p) = ss_loop(p, 0, 0, Nil)

fn ss_loop(p, i, start, acc) =
  if i >= str_len(p) then reverse(Cons(str_sub(p, start, i - start), acc)) else if str_get(p, i) == 47 then ss_loop(p, i + 1, i + 1, Cons(str_sub(p, start, i - start), acc)) else ss_loop(p, i + 1, start, acc)

fn np_fold(segs, stack) = match segs
  Nil -> reverse(stack)
  Cons(s, rest) -> if str_cmp(s, "") == 0 || str_cmp(s, ".") == 0 then np_fold(rest, stack) else if str_cmp(s, "..") == 0 then np_fold(rest, np_pop(stack)) else np_fold(rest, Cons(s, stack))

fn np_pop(stack) = match stack
  Nil -> Cons("..", Nil)
  Cons(h, t) -> if str_cmp(h, "..") == 0 then Cons("..", stack) else t

fn np_render(segs, abs) =
  s = join_slash(segs, "")
  if abs then "/" + s else if str_cmp(s, "") == 0 then "." else s

fn join_slash(segs, acc) = match segs
  Nil -> acc
  Cons(h, rest) -> join_slash(rest, if str_cmp(acc, "") == 0 then h else acc + "/" + h)

# ---- the loader -------------------------------------------------------------
#
# visited, aliases ("" means unqualified), function origins, name origins,
# and the accumulated declarations, newest first.

type LD
  LD(SM(Bool), SM(Str), SM(Str), SM(Str), List(Decl), List(Decl), List(Decl), List(Decl), List(FnD))

fn ld0() = LD(SLeaf, SLeaf, SLeaf, SLeaf, Nil, Nil, Nil, Nil, Nil)

fn load_program(entry, prelude_path) =
  with_prelude(ld_finish(visit(ld0(), entry, "", "", 0)), prelude_path)

fn ld_finish(ld) = match ld
  LD(_, _, _, _, ty, tr, im, ex, fs) -> M2(reverse(ty), reverse(tr), reverse(im), reverse(ex), reverse(fs), 0)

fn parse_src(src) = match lex_src(src)
  LO(ts, _) -> p_module(ts)

fn visit(ld, path, alias, from, fline) =
  canon = norm_path(path)
  src = read_file_raw(canon)
  if io_ok() then visit2(ld, canon, src, alias) else read_fail(path, from, fline)

fn read_fail(path, from, fline) =
  if str_cmp(from, "") == 0 then tldie("cannot read `" + path + "`: No such file or directory (os error 2)") else tldie(from + ": line " + int_to_str(fline) + ": cannot import `" + path + "`: No such file or directory (os error 2)")

fn visit2(ld, canon, src, alias) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) ->
    if shas(vis, canon) then revisit(ld, sget(al, canon), canon, alias) else visit3(LD(sput(vis, canon, true), sput(al, canon, alias), fo, no, ty, tr, im, ex, fs), canon, src, alias)

fn revisit(ld, had_o, canon, alias) =
  had = ld_or(had_o, "")
  if str_cmp(had, alias) == 0 then ld else tldie("`" + canon + "` is imported both " + alias_desc(had) + " and " + alias_desc(alias) + "; pick one")

fn alias_desc(a) = if str_cmp(a, "") == 0 then "unqualified" else "as `" + a + "`"

fn visit3(ld, canon, src, alias) =
  decls = parse_src(src)
  claim_decls(visit_imports(ld, decls, dirname(canon), canon), qualify(decls, alias), canon)

fn visit_imports(ld, decls, dir, canon) = match decls
  Nil -> ld
  Cons(d, rest) -> visit_imports(vi_one(ld, d, dir, canon), rest, dir, canon)

fn vi_one(ld, d, dir, canon) = match d
  DImport(pth, al, ln) -> visit(ld, path_join(dir, pth + ".rill"), ld_or(al, ""), canon, ln)
  _ -> ld

# ---- qualification ----------------------------------------------------------

fn qualify(decls, alias) =
  if str_cmp(alias, "") == 0 then decls else q_decls(decls, own_names(decls, SLeaf), alias)

fn own_names(decls, s) = match decls
  Nil -> s
  Cons(d, rest) -> own_names(rest, on_one(d, s))

fn on_one(d, s) = match d
  DType(n, _, ctors, _) -> on_ctors(ctors, sput(s, n, true))
  DFn(FnD(n, _, _, _, _, _, _)) -> sput(s, n, true)
  _ -> s

fn on_ctors(cs, s) = match cs
  Nil -> s
  Cons(Ct(n, _, _), rest) -> on_ctors(rest, sput(s, n, true))

fn q_decls(ds, own, a) = map(ds, \d -> q_decl(d, own, a))

fn q_decl(d, own, a) = match d
  DType(n, ps, ctors, ln) -> DType(a + "." + n, ps, map(ctors, \c -> q_ctor(c, own, a)), ln)
  DFn(f) -> DFn(q_fn(f, own, a))
  _ -> d

fn q_ctor(c, own, a) = match c
  Ct(n, fields, ln) -> Ct(a + "." + n, map(fields, \f -> q_field(f, own, a)), ln)

fn q_field(f, own, a) = match f
  Fld(nm, tr) -> Fld(nm, q_tr(tr, own, a))

fn q_name(n, own, a) = if shas(own, n) then a + "." + n else n

fn q_tr(t, own, a) = match t
  TR(n, args, ret, ln) -> TR(q_name(n, own, a), map(args, \x -> q_tr(x, own, a)), q_tro(ret, own, a), ln)

fn q_tro(o, own, a) = match o
  Some(t) -> Some(q_tr(t, own, a))
  None -> None

fn q_fn(f, own, a) = match f
  FnD(n, ex, ps, ret, body, ln, lf) -> FnD(a + "." + n, ex, map(ps, \p -> q_par(p, own, a)), q_tro(ret, own, a), q_expr(body, own, a), ln, lf)

fn q_par(p, own, a) = match p
  Par(n, ann) -> Par(n, q_tro(ann, own, a))

fn q_expr(e, own, a) = match e
  EVar(n, ln) -> EVar(q_name(n, own, a), ln)
  ECall(n, args, ln, t) -> ECall(q_name(n, own, a), map(args, \x -> q_expr(x, own, a)), ln, t)
  ENeg(x) -> ENeg(q_expr(x, own, a))
  EBin(op, l, r, ln) -> EBin(op, q_expr(l, own, a), q_expr(r, own, a), ln)
  EIf(c, t, e2) -> EIf(q_expr(c, own, a), q_expr(t, own, a), q_expr(e2, own, a))
  EMatch(s, arms, ln) -> EMatch(q_expr(s, own, a), map(arms, \x -> q_arm(x, own, a)), ln)
  ELambda(ps, b, ln) -> ELambda(ps, q_expr(b, own, a), ln)
  ESpawn(b, ln) -> ESpawn(q_expr(b, own, a), ln)
  ELen(x, ln) -> ELen(q_expr(x, own, a), ln)
  EIndex(b, ix, ln) -> EIndex(q_expr(b, own, a), q_expr(ix, own, a), ln)
  EIndexSet(b, ix, v, ln) -> EIndexSet(q_expr(b, own, a), q_expr(ix, own, a), q_expr(v, own, a), ln)
  EIndexOp(op, b, ix, v, ln) -> EIndexOp(op, q_expr(b, own, a), q_expr(ix, own, a), q_expr(v, own, a), ln)
  EFor(x, f, t, body, ln) -> EFor(x, q_expr(f, own, a), q_expr(t, own, a), q_expr(body, own, a), ln)
  ESelect(arms, d, ln) -> ESelect(map(arms, \x -> q_sarm(x, own, a)), q_expro(d, own, a), ln)
  EBlock(ss) -> EBlock(map(ss, \s -> q_stmt(s, own, a)))
  _ -> e

fn q_expro(o, own, a) = match o
  Some(e) -> Some(q_expr(e, own, a))
  None -> None

fn q_arm(x, own, a) = match x
  Arm(p, b, ln) -> Arm(q_pat(p, own, a), q_expr(b, own, a), ln)

fn q_pat(p, own, a) = match p
  PCtor(n, args) -> PCtor(q_name(n, own, a), map(args, \x -> q_pat(x, own, a)))
  _ -> p

fn q_sarm(x, own, a) = match x
  SArm(op, b, ln) -> SArm(q_sop(op, own, a), q_expr(b, own, a), ln)

fn q_sop(op, own, a) = match op
  SRecv(ch, nm) -> SRecv(q_expr(ch, own, a), nm)
  SSend(ch, v) -> SSend(q_expr(ch, own, a), q_expr(v, own, a))

fn q_stmt(s, own, a) = match s
  SBind(n, v, ln) -> SBind(n, q_expr(v, own, a), ln)
  SPatBind(p, v, ln) -> SPatBind(q_pat(p, own, a), q_expr(v, own, a), ln)
  SFn(FnD(n, ex, ps, ret, body, ln, lf)) -> SFn(FnD(n, ex, map(ps, \p -> q_par(p, own, a)), q_tro(ret, own, a), q_expr(body, own, a), ln, lf))
  SExpr(v) -> SExpr(q_expr(v, own, a))

# ---- claiming names ---------------------------------------------------------
#
# Kinds are claimed in the Rust checker's order — types, traits, impls,
# externs, functions — because the first duplicate found is the one reported.

fn claim_decls(ld, decls, canon) =
  ld1 = claim_types(ld, decls, canon)
  ld2 = claim_traits(ld1, decls, canon)
  ld3 = claim_impls(ld2, decls, canon)
  ld4 = claim_externs(ld3, decls, canon)
  claim_fns(ld4, decls, canon)

fn claim_name(ld, name, what, canon) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) ->
    key = what + ":" + name
    cn2(sget(no, key), vis, al, fo, no, ty, tr, im, ex, fs, key, name, what, canon)

fn cn2(prev, vis, al, fo, no, ty, tr, im, ex, fs, key, name, what, canon) = match prev
  Some(p) -> tldie(what + " `" + name + "` is defined in both `" + p + "` and `" + canon + "`")
  None -> LD(vis, al, fo, sput(no, key, canon), ty, tr, im, ex, fs)

fn claim_types(ld, decls, canon) = match decls
  Nil -> ld
  Cons(d, rest) -> claim_types(ct_one(ld, d, canon), rest, canon)

fn ct_one(ld, d, canon) = match d
  DType(n, ps, ctors, ln) ->
    ld1 = claim_ctor_names(claim_name(ld, n, "type", canon), ctors, canon)
    ld_push_type(ld1, DType(n, ps, ctors, ln))
  _ -> ld

fn claim_ctor_names(ld, ctors, canon) = match ctors
  Nil -> ld
  Cons(Ct(n, _, _), rest) -> claim_ctor_names(claim_name(ld, n, "constructor", canon), rest, canon)

fn ld_push_type(ld, d) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) -> LD(vis, al, fo, no, Cons(d, ty), tr, im, ex, fs)

fn claim_traits(ld, decls, canon) = match decls
  Nil -> ld
  Cons(d, rest) -> claim_traits(tr_one(ld, d, canon), rest, canon)

fn tr_one(ld, d, canon) = match d
  DTrait(n, pn, sigs, ln) ->
    ld1 = claim_sig_names(claim_name(ld, n, "trait", canon), sigs, canon)
    ld_push_trait(ld1, DTrait(n, pn, sigs, ln))
  _ -> ld

fn claim_sig_names(ld, sigs, canon) = match sigs
  Nil -> ld
  Cons(Sig(n, _, _, _), rest) -> claim_sig_names(claim_name(ld, n, "method", canon), rest, canon)

fn ld_push_trait(ld, d) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) -> LD(vis, al, fo, no, ty, Cons(d, tr), im, ex, fs)

fn claim_impls(ld, decls, canon) = match decls
  Nil -> ld
  Cons(d, rest) -> claim_impls(im_one(ld, d, canon), rest, canon)

fn im_one(ld, d, canon) = match d
  DImpl(tn, TR(target, targs, tret, tln), fns, ln) ->
    ld1 = claim_name(ld, tn + "(" + target + ")", "impl", canon)
    ld_push_impl(ld1, DImpl(tn, TR(target, targs, tret, tln), fns, ln))
  _ -> ld

fn ld_push_impl(ld, d) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) -> LD(vis, al, fo, no, ty, tr, Cons(d, im), ex, fs)

fn claim_externs(ld, decls, canon) = match decls
  Nil -> ld
  Cons(d, rest) -> claim_externs(ex_one(ld, d), rest, canon)

# A C symbol has one meaning per program, so declaring it twice is fine as
# long as nothing else claims the name.
fn ex_one(ld, d) = match d
  DExtern(n, sym, ps, ret, ln) -> ex_two(ld, DExtern(n, sym, ps, ret, ln), n)
  _ -> ld

fn ex_two(ld, d, n) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) ->
    if extern_listed(ex, n) then LD(vis, al, fo, no, ty, tr, im, ex, fs) else LD(vis, al, fo, no, ty, tr, im, Cons(d, ex), fs)

fn extern_listed(ex, n) = match ex
  Nil -> false
  Cons(DExtern(en, _, _, _, _), rest) -> str_cmp(en, n) == 0 || extern_listed(rest, n)
  Cons(_, rest) -> extern_listed(rest, n)

fn claim_fns(ld, decls, canon) = match decls
  Nil -> ld
  Cons(d, rest) -> claim_fns(cf_one(ld, d, canon), rest, canon)

fn cf_one(ld, d, canon) = match d
  DFn(f) -> cf_two(ld, f, canon)
  _ -> ld

fn cf_two(ld, f, canon) = match ld
  LD(vis, al, fo, no, ty, tr, im, ex, fs) -> cf_three(sget(fo, fnd_name(f)), f, vis, al, fo, no, ty, tr, im, ex, fs, canon)

fn cf_three(prev, f, vis, al, fo, no, ty, tr, im, ex, fs, canon) = match prev
  Some(p) -> tldie("function `" + fnd_name(f) + "` is defined in both `" + p + "` and `" + canon + "`")
  None -> LD(vis, al, sput(fo, fnd_name(f), canon), no, ty, tr, im, ex, Cons(f, fs))

# ---- the prelude merge ------------------------------------------------------

fn with_prelude(user, prelude_path) =
  psrc = read_file_raw(prelude_path)
  if io_ok() then lift(merge_prelude(parse_src(psrc), user)) else tldie("cannot read the prelude at `" + prelude_path + "`")

fn merge_prelude(pdecls, user) = match user
  M2(uty, utr, uim, uex, ufn, _) ->
    uts = decl_type_names(uty, SLeaf)
    ucs = decl_ctor_names(uty, SLeaf)
    ufs = fn_name_set(ufn, extern_name_set(uex, SLeaf))
    assemble(prelude_types(pdecls, uts, ucs, Nil, SLeaf), pdecls, ufs, uty, utr, uim, uex, ufn)

fn decl_type_names(ds, s) = match ds
  Nil -> s
  Cons(DType(n, _, _, _), rest) -> decl_type_names(rest, sput(s, n, true))
  Cons(_, rest) -> decl_type_names(rest, s)

fn decl_ctor_names(ds, s) = match ds
  Nil -> s
  Cons(DType(_, _, ctors, _), rest) -> decl_ctor_names(rest, ctor_name_set(ctors, s))
  Cons(_, rest) -> decl_ctor_names(rest, s)

fn ctor_name_set(cs, s) = match cs
  Nil -> s
  Cons(Ct(n, _, _), rest) -> ctor_name_set(rest, sput(s, n, true))

fn fn_name_set(fs, s) = match fs
  Nil -> s
  Cons(f, rest) -> fn_name_set(rest, sput(s, fnd_name(f), true))

fn extern_name_set(ds, s) = match ds
  Nil -> s
  Cons(DExtern(n, _, _, _, _), rest) -> extern_name_set(rest, sput(s, n, true))
  Cons(_, rest) -> extern_name_set(rest, s)

# Kept prelude types (in order) and the names no longer provided.
type PT
  PT(List(Decl), SM(Bool))

fn prelude_types(ds, uts, ucs, kept, dropped) = match ds
  Nil -> PT(reverse(kept), dropped)
  Cons(d, rest) -> pt_one(d, rest, uts, ucs, kept, dropped)

fn pt_one(d, rest, uts, ucs, kept, dropped) = match d
  DType(n, ps, ctors, ln) ->
    if shas(uts, n) || ctor_clash(ctors, ucs) then prelude_types(rest, uts, ucs, kept, drop_type(dropped, n, ctors)) else prelude_types(rest, uts, ucs, Cons(DType(n, ps, ctors, ln), kept), dropped)
  _ -> prelude_types(rest, uts, ucs, kept, dropped)

fn ctor_clash(cs, ucs) = match cs
  Nil -> false
  Cons(Ct(n, _, _), rest) -> shas(ucs, n) || ctor_clash(rest, ucs)

fn drop_type(dropped, n, ctors) = ctor_name_set(ctors, sput(dropped, n, true))

# Each prelude function paired with every name its definition mentions.
type PF
  PF(FnD, SM(Bool))

fn prelude_fns(ds, acc) = match ds
  Nil -> reverse(acc)
  Cons(DFn(f), rest) -> prelude_fns(rest, Cons(PF(f, cn_fn(f, SLeaf)), acc))
  Cons(_, rest) -> prelude_fns(rest, acc)

fn cn_fn(f, s) = match f
  FnD(_, _, ps, ret, body, _, _) -> cn_pars(ps, cn_tro(ret, cn_expr(body, s)))

fn cn_pars(ps, s) = match ps
  Nil -> s
  Cons(Par(_, ann), rest) -> cn_pars(rest, cn_tro(ann, s))

fn cn_tro(o, s) = match o
  Some(t) -> cn_tr(t, s)
  None -> s

fn cn_tr(t, s) = match t
  TR(n, args, ret, _) -> cn_tro(ret, cn_trs(args, sput(s, n, true)))

fn cn_trs(ts, s) = match ts
  Nil -> s
  Cons(t, rest) -> cn_trs(rest, cn_tr(t, s))

fn cn_expr(e, s) = match e
  EVar(n, _) -> sput(s, n, true)
  ECall(n, args, _, _) -> cn_exprs(args, sput(s, n, true))
  ENeg(x) -> cn_expr(x, s)
  EBin(_, l, r, _) -> cn_expr(r, cn_expr(l, s))
  EIf(c, t, e2) -> cn_expr(e2, cn_expr(t, cn_expr(c, s)))
  EMatch(sc, arms, _) -> cn_arms(arms, cn_expr(sc, s))
  ELambda(_, b, _) -> cn_expr(b, s)
  ESpawn(b, _) -> cn_expr(b, s)
  ELen(x, _) -> cn_expr(x, s)
  EIndex(b, ix, _) -> cn_expr(ix, cn_expr(b, s))
  EIndexSet(b, ix, v, _) -> cn_expr(v, cn_expr(ix, cn_expr(b, s)))
  EIndexOp(_, b, ix, v, _) -> cn_expr(v, cn_expr(ix, cn_expr(b, s)))
  EFor(_, f, t, body, _) -> cn_expr(body, cn_expr(t, cn_expr(f, s)))
  ESelect(arms, d, _) -> cn_expro(d, cn_sarms(arms, s))
  EBlock(ss) -> cn_stmts(ss, s)
  _ -> s

fn cn_exprs(es, s) = match es
  Nil -> s
  Cons(e, rest) -> cn_exprs(rest, cn_expr(e, s))

fn cn_expro(o, s) = match o
  Some(e) -> cn_expr(e, s)
  None -> s

fn cn_arms(arms, s) = match arms
  Nil -> s
  Cons(Arm(p, b, _), rest) -> cn_arms(rest, cn_expr(b, cn_pat(p, s)))

fn cn_pat(p, s) = match p
  PCtor(n, args) -> cn_pats(args, sput(s, n, true))
  _ -> s

fn cn_pats(ps, s) = match ps
  Nil -> s
  Cons(p, rest) -> cn_pats(rest, cn_pat(p, s))

fn cn_sarms(arms, s) = match arms
  Nil -> s
  Cons(SArm(op, b, _), rest) -> cn_sarms(rest, cn_expr(b, cn_sop(op, s)))

fn cn_sop(op, s) = match op
  SRecv(ch, _) -> cn_expr(ch, s)
  SSend(ch, v) -> cn_expr(v, cn_expr(ch, s))

fn cn_stmts(ss, s) = match ss
  Nil -> s
  Cons(SBind(_, v, _), rest) -> cn_stmts(rest, cn_expr(v, s))
  Cons(SPatBind(p, v, _), rest) -> cn_stmts(rest, cn_pat(p, cn_expr(v, s)))
  Cons(SFn(FnD(_, _, ps, ret, body, _, _)), rest) -> cn_stmts(rest, cn_pars(ps, cn_tro(ret, cn_expr(body, s))))
  Cons(SExpr(v), rest) -> cn_stmts(rest, cn_expr(v, s))

# Shadowed functions drop, then anything referencing a dropped name drops,
# until a pass removes nothing.
type FX
  FX(List(PF), SM(Bool), Bool)

fn fix_fns(pfs, ufs, dropped) = match fix_pass(pfs, ufs, dropped, Nil, false)
  FX(kept, dropped2, changed) -> if changed then fix_fns(kept, ufs, dropped2) else map(kept, \pf -> pf_fn(pf))

fn pf_fn(pf) = match pf
  PF(f, _) -> f

fn fix_pass(pfs, ufs, dropped, kept, changed) = match pfs
  Nil -> FX(reverse(kept), dropped, changed)
  Cons(PF(f, names), rest) -> fp_one(f, names, rest, ufs, dropped, kept, changed)

fn fp_one(f, names, rest, ufs, dropped, kept, changed) =
  if shas(ufs, fnd_name(f)) || refs_dropped(names, dropped) then fix_pass(rest, ufs, sput(dropped, fnd_name(f), true), kept, true) else fix_pass(rest, ufs, dropped, Cons(PF(f, names), kept), changed)

fn refs_dropped(names, dropped) = match names
  SLeaf -> false
  SNode(l, k, _, r) -> shas(dropped, k) || refs_dropped(l, dropped) || refs_dropped(r, dropped)

fn assemble(pt, pdecls, ufs, uty, utr, uim, uex, ufn) = match pt
  PT(ptypes, dropped) ->
    pfns = fix_fns(prelude_fns(pdecls, Nil), ufs, dropped)
    M2(append(ptypes, uty), utr, uim, uex, append(pfns, ufn), len(pfns))

# ---- local functions, lifted out --------------------------------------------
#
# `fn go(i) = ...` written inside a body sees the names around it and may call
# itself and the functions beside it. Nothing after this pass knows that: each
# one becomes an ordinary top-level function whose captured names arrive as
# leading parameters, and every call to it gains those arguments.
#
# A closure would have been the other way to do it, and would have cost an
# environment box and turned a self tail call into a call and a return — and a
# loop written as a local function has to stay a loop.
#
# The lifted name carries the enclosing function's, separated by a dot no Rill
# identifier can contain, and the seventh field of `FnD` records the parent so
# the checker infers the two together: a captured buffer must have the type it
# had where it was captured, since a `Buf` width is never inferred.

type LF
  LF(SM(Bool), List(FnD))

type LE
  LE(Expr, LF)

type LES
  LES(List(Expr), LF)

type LSS
  LSS(List(Stmt), LF)

type LR
  LR(List(FnD), LF)

type LD2
  LD2(FnD, Str, List(Str))

type LC
  LC(Str, Str, List(Str), List(Str))

fn lift(m) = match m
  M2(ty, tr, im, ex, fs, pn) -> lift_fin(lf_fns(fs, LF(lf_names(fs, SLeaf), Nil), Nil), ty, tr, im, ex, pn)

fn lf_names(fs, acc) = fold(fs, acc, \a, f -> sput(a, fnd_name(f), true))

fn lift_fin(lr, ty, tr, im, ex, pn) = match lr
  LR(fs2, LF(_, out)) -> M2(ty, tr, im, ex, append(fs2, reverse(out)), pn)

fn lf_fns(fs, st, acc) = match fs
  Nil -> LR(reverse(acc), st)
  Cons(f, rest) -> lf_fn(f, rest, st, acc)

fn lf_fn(f, rest, st, acc) = match f
  FnD(n, ex, ps, ret, body, ln, pa) -> lf_fn2(lf_expr(body, par_names(ps, Nil), n, st), n, ex, ps, ret, ln, pa, rest, acc)

fn lf_fn2(le, n, ex, ps, ret, ln, pa, rest, acc) = match le
  LE(b2, st) -> lf_fns(rest, st, Cons(FnD(n, ex, ps, ret, b2, ln, pa), acc))

fn par_names(ps, acc) = match ps
  Nil -> reverse(acc)
  Cons(Par(n, _), rest) -> par_names(rest, Cons(n, acc))

# `b[i] op= v` spelled out, with the index evaluated once — it may be a call,
# and running one twice would run what it does twice.
fn expand_index_op(op, base, index, value, ln) =
  EBlock(Cons(SBind("[]=.b", base, ln), Cons(SBind("[]=.i", index, ln), Cons(SExpr(EIndexSet(EVar("[]=.b", ln), EVar("[]=.i", ln), EBin(op, EIndex(EVar("[]=.b", ln), EVar("[]=.i", ln), ln), value, ln), ln)), Nil))))

# `for i in a..b` is a local function over the half-open range, which is all a
# counting loop ever was. The end is evaluated once.
fn expand_for(x, from, to, body, ln) =
  step = ECall("for", Cons(EBin(0, EVar(x, ln), EInt("1"), ln), Nil), ln, false)
  loopf = FnD("for", false, Cons(Par(x, None), Nil), None, EIf(EBin(10, EVar(x, ln), EVar("for.hi", ln), ln), EInt("0"), EBlock(Cons(SExpr(body), Cons(SExpr(step), Nil)))), ln, None)
  EBlock(Cons(SBind("for.hi", to, ln), Cons(SFn(loopf), Cons(SExpr(ECall("for", Cons(from, Nil), ln, false)), Nil))))

# `Pat = e` is bound over everything after it, which is what makes it the
# one-armed `match` that a binding taking a value apart has always been.
fn expand_pat_binds(ss) = match ss
  Nil -> Nil
  Cons(SPatBind(p, v, ln), rest) -> Cons(SExpr(EMatch(v, Cons(Arm(p, EBlock(expand_pat_binds(rest)), ln), Nil), ln)), Nil)
  Cons(s, rest) -> Cons(s, expand_pat_binds(rest))

fn lf_expr(e, env, parent, st) = match e
  EIndexOp(op, b, ix, v, ln) -> lf_expr(expand_index_op(op, b, ix, v, ln), env, parent, st)
  EFor(x, a, b, body, ln) -> lf_expr(expand_for(x, a, b, body, ln), env, parent, st)
  EBlock(ss) -> lf_block_e(lf_block(expand_pat_binds(ss), env, parent, st))
  ECall(n, args, ln, pi) -> lf_call(lf_exprs(args, env, parent, st, Nil), n, ln, pi)
  ENeg(x) -> lf_neg(lf_expr(x, env, parent, st))
  EBin(op, l, r, ln) -> lf_bin(lf_exprs(Cons(l, Cons(r, Nil)), env, parent, st, Nil), op, ln)
  EIf(c, t, e2) -> lf_if(lf_exprs(Cons(c, Cons(t, Cons(e2, Nil))), env, parent, st, Nil))
  EMatch(sc, arms, ln) -> lf_match(lf_expr(sc, env, parent, st), arms, env, parent, ln)
  ELambda(ps, b, ln) -> lf_lam(lf_expr(b, append(env, ps), parent, st), ps, ln)
  ESpawn(b, ln) -> lf_spawn(lf_expr(b, env, parent, st), ln)
  ESelect(arms, def, ln) -> lf_select(arms, def, env, parent, st, ln)
  ELen(x, ln) -> lf_len(lf_expr(x, env, parent, st), ln)
  EIndex(b, ix, ln) -> lf_index(lf_exprs(Cons(b, Cons(ix, Nil)), env, parent, st, Nil), ln)
  EIndexSet(b, ix, v, ln) -> lf_iset(lf_exprs(Cons(b, Cons(ix, Cons(v, Nil))), env, parent, st, Nil), ln)
  _ -> LE(e, st)

fn lf_exprs(es, env, parent, st, acc) = match es
  Nil -> LES(reverse(acc), st)
  Cons(x, rest) -> lf_exprs2(lf_expr(x, env, parent, st), rest, env, parent, acc)

fn lf_exprs2(le, rest, env, parent, acc) = match le
  LE(x2, st) -> lf_exprs(rest, env, parent, st, Cons(x2, acc))

fn at_e(es, i) = match nth(es, i)
  Some(x) -> x
  None -> EBool(false)

fn lf_block_e(lss) = match lss
  LSS(ss, st) -> LE(EBlock(ss), st)

fn lf_call(les, n, ln, pi) = match les
  LES(args, st) -> LE(ECall(n, args, ln, pi), st)

fn lf_neg(le) = match le
  LE(x, st) -> LE(ENeg(x), st)

fn lf_bin(les, op, ln) = match les
  LES(xs, st) -> LE(EBin(op, at_e(xs, 0), at_e(xs, 1), ln), st)

fn lf_if(les) = match les
  LES(xs, st) -> LE(EIf(at_e(xs, 0), at_e(xs, 1), at_e(xs, 2)), st)

fn lf_len(le, ln) = match le
  LE(x, st) -> LE(ELen(x, ln), st)

fn lf_index(les, ln) = match les
  LES(xs, st) -> LE(EIndex(at_e(xs, 0), at_e(xs, 1), ln), st)

fn lf_iset(les, ln) = match les
  LES(xs, st) -> LE(EIndexSet(at_e(xs, 0), at_e(xs, 1), at_e(xs, 2), ln), st)

fn lf_lam(le, ps, ln) = match le
  LE(b, st) -> LE(ELambda(ps, b, ln), st)

fn lf_spawn(le, ln) = match le
  LE(b, st) -> LE(ESpawn(b, ln), st)

fn lf_match(le, arms, env, parent, ln) = match le
  LE(sc, st) -> lf_marms(arms, env, parent, st, Nil, sc, ln)

fn lf_marms(arms, env, parent, st, acc, sc, ln) = match arms
  Nil -> LE(EMatch(sc, reverse(acc), ln), st)
  Cons(Arm(p, b, aln), rest) -> lf_marm(lf_expr(b, append(env, lf_pat_names(p, Nil)), parent, st), p, aln, rest, env, parent, acc, sc, ln)

fn lf_marm(le, p, aln, rest, env, parent, acc, sc, ln) = match le
  LE(b2, st) -> lf_marms(rest, env, parent, st, Cons(Arm(p, b2, aln), acc), sc, ln)

fn lf_pat_names(p, acc) = match p
  PVar(n) -> Cons(n, acc)
  PCtor(_, args) -> fold(args, acc, \a, x -> lf_pat_names(x, a))
  _ -> acc

fn lf_select(arms, def, env, parent, st, ln) = lf_sarms(arms, env, parent, st, Nil, def, ln)

fn lf_sarms(arms, env, parent, st, acc, def, ln) = match arms
  Nil -> lf_sdef(def, env, parent, st, reverse(acc), ln)
  Cons(SArm(op, b, aln), rest) -> lf_sarm(lf_sop(op, env, parent, st), b, aln, rest, env, parent, acc, def, ln)

fn lf_sop(op, env, parent, st) = match op
  SRecv(ch, bd) -> lf_srecv(lf_expr(ch, env, parent, st), bd)
  SSend(ch, v) -> lf_ssend(lf_exprs(Cons(ch, Cons(v, Nil)), env, parent, st, Nil))

fn lf_srecv(le, bd) = match le
  LE(ch, st) -> LSO(SRecv(ch, bd), st)

fn lf_ssend(les) = match les
  LES(xs, st) -> LSO(SSend(at_e(xs, 0), at_e(xs, 1)), st)

type LSO
  LSO(SOp, LF)

fn lf_sarm(lso, b, aln, rest, env, parent, acc, def, ln) = match lso
  LSO(op, st) -> lf_sarm2(lf_expr(b, append(env, lf_sop_binds(op, Nil)), parent, st), op, aln, rest, env, parent, acc, def, ln)

fn lf_sop_binds(op, acc) = match op
  SRecv(_, Some(n)) -> Cons(n, acc)
  _ -> acc

fn lf_sarm2(le, op, aln, rest, env, parent, acc, def, ln) = match le
  LE(b2, st) -> lf_sarms(rest, env, parent, st, Cons(SArm(op, b2, aln), acc), def, ln)

fn lf_sdef(def, env, parent, st, arms, ln) = match def
  None -> LE(ESelect(arms, None, ln), st)
  Some(d) -> lf_sdef2(lf_expr(d, env, parent, st), arms, ln)

fn lf_sdef2(le, arms, ln) = match le
  LE(d, st) -> LE(ESelect(arms, Some(d), ln), st)

type LB
  LB(List(Stmt), List(LD2), List(Str), LF)

type LN
  LN(Str, LF)

fn lf_has(st, n) = match st
  LF(u, _) -> shas(u, n)

fn lf_use(st, n) = match st
  LF(u, out) -> LF(sput(u, n, true), out)

fn lf_emit(st, f) = match st
  LF(u, out) -> LF(u, Cons(f, out))

fn lf_in(l, s) = match l
  Nil -> false
  Cons(x, rest) -> str_cmp(x, s) == 0 || lf_in(rest, s)

# The lifted name: the enclosing one's, a dot, its own. Two blocks in one
# function may use the same name; the second gets a number.
fn pick_name(parent, n, st) = pick2(parent + "." + n, st, 2)

fn pick2(base, st, k) =
  if lf_has(st, base) then pick3(base + "." + int_to_str(k), base, st, k) else LN(base, lf_use(st, base))

fn pick3(cand, base, st, k) =
  if lf_has(st, cand) then pick3(base + "." + int_to_str(k + 1), base, st, k + 1) else LN(cand, lf_use(st, cand))

fn lf_sib_names(ss, acc) = match ss
  Nil -> reverse(acc)
  Cons(SFn(f), rest) -> lf_sib_names(rest, Cons(fnd_name(f), acc))
  Cons(_, rest) -> lf_sib_names(rest, acc)

fn lf_block(ss, env, parent, st) =
  sibs = lf_sib_names(ss, Nil)
  if len(sibs) == 0 then lf_plain(ss, env, parent, st, Nil) else lf_block2(lf_pass1(ss, parent, LB(Nil, Nil, env, st)), sibs, parent)

fn lf_plain(ss, env, parent, st, acc) = match ss
  Nil -> LSS(reverse(acc), st)
  Cons(SBind(n, v, ln), rest) -> lf_plain_bind(lf_expr(v, env, parent, st), n, ln, rest, env, parent, acc)
  Cons(SExpr(e), rest) -> lf_plain_expr(lf_expr(e, env, parent, st), rest, env, parent, acc)
  Cons(SPatBind(_, _, _), _) -> tldie("internal: a pattern binding was not expanded")
  Cons(SFn(_), _) -> tldie("internal: a local function in a block reported as having none")

fn lf_plain_bind(le, n, ln, rest, env, parent, acc) = match le
  LE(v2, st) -> lf_plain(rest, append(env, Cons(n, Nil)), parent, st, Cons(SBind(n, v2, ln), acc))

fn lf_plain_expr(le, rest, env, parent, acc) = match le
  LE(e2, st) -> lf_plain(rest, env, parent, st, Cons(SExpr(e2), acc))

# Pass one: lift what is nested inside each local function, and note the names
# visible where it is written — so it cannot reach a binding made after it.
fn lf_pass1(ss, parent, b) = match ss
  Nil -> b
  Cons(s, rest) -> lf_pass1(rest, parent, lf_p1(s, parent, b))

fn lf_p1(s, parent, b) = match b
  LB(kept, defs, env, st) -> lf_p1b(s, parent, kept, defs, env, st)

fn lf_p1b(s, parent, kept, defs, env, st) = match s
  SPatBind(_, _, _) -> tldie("internal: a pattern binding was not expanded")
  SFn(f) -> lf_p1_fn(f, parent, kept, defs, env, st)
  SBind(n, v, ln) -> lf_p1_bind(lf_expr(v, env, parent, st), n, ln, kept, defs, env)
  SExpr(e) -> lf_p1_expr(lf_expr(e, env, parent, st), kept, defs, env)

fn lf_p1_bind(le, n, ln, kept, defs, env) = match le
  LE(v2, st) -> LB(Cons(SBind(n, v2, ln), kept), defs, append(env, Cons(n, Nil)), st)

fn lf_p1_expr(le, kept, defs, env) = match le
  LE(e2, st) -> LB(Cons(SExpr(e2), kept), defs, env, st)

fn lf_p1_fn(f, parent, kept, defs, env, st) = match f
  FnD(n, ex, ps, ret, body, ln, pa) -> lf_p1_fn2(pick_name(parent, n, st), n, ex, ps, ret, body, ln, pa, kept, defs, env)

fn lf_p1_fn2(nm, n, ex, ps, ret, body, ln, pa, kept, defs, env) = match nm
  LN(lifted, st) -> LB(kept, Cons(LD2(FnD(n, ex, ps, ret, body, ln, pa), lifted, env), defs), env, st)

# Pass two: what each one captures, then what its siblings force it to capture
# as well — if `g` calls `h`, `g` has to hand `h` what `h` needs.
fn lf_block2(b, sibs, parent) = match b
  LB(kept, defs, _, st) -> lf_block3(reverse(kept), reverse(defs), sibs, parent, st)

fn lf_block3(kept, defs, sibs, parent, st) =
  lf_block4(lf_fix(lf_init_caps(defs, sibs, Nil)), kept, defs, parent, st)

fn lf_init_caps(defs, sibs, acc) = match defs
  Nil -> reverse(acc)
  Cons(LD2(f, lifted, vis), rest) -> lf_init_caps(rest, sibs, Cons(lf_one_cap(f, lifted, vis, sibs), acc))

fn lf_one_cap(f, lifted, vis, sibs) = match f
  FnD(n, _, ps, _, body, _, _) -> lf_one_cap2(n, lifted, vis, sibs, lf_fv(body, par_names(ps, Nil), Nil))

fn lf_one_cap2(n, lifted, vis, sibs, free) =
  LC(n, lifted, lf_dedup(filter(vis, \x -> lf_in(free, x) && !lf_in(sibs, x)), Nil), filter(sibs, \x -> lf_in(free, x)))

# A name shadowed further in is in the visible list twice; one parameter is
# what the lifted function wants, and the call site passes the inner one.
fn lf_dedup(l, acc) = match l
  Nil -> reverse(acc)
  Cons(x, rest) -> lf_dedup(rest, if lf_in(acc, x) then acc else Cons(x, acc))

fn lf_fix(cs) = lf_fix2(cs, map(cs, \c -> lf_grow(c, cs)))

fn lf_fix2(cs, cs2) = if lf_total(cs, 0) == lf_total(cs2, 0) then cs else lf_fix(cs2)

fn lf_total(cs, acc) = match cs
  Nil -> acc
  Cons(LC(_, _, caps, _), rest) -> lf_total(rest, acc + len(caps))

fn lf_grow(c, all) = match c
  LC(n, lifted, caps, refs) -> LC(n, lifted, fold(all, caps, \a, o -> lf_add_if(a, o, refs)), refs)

fn lf_add_if(caps, o, refs) = match o
  LC(n2, _, caps2, _) -> if lf_in(refs, n2) then lf_union(caps, caps2) else caps

fn lf_union(a, b) = fold(b, a, \acc, x -> if lf_in(acc, x) then acc else append(acc, Cons(x, Nil)))

# Pass three: every call to a lifted name gains its captures, in the lifted
# bodies and in what is left of the block.
fn lf_block4(cs, kept, defs, parent, st) =
  LSS(map(kept, \s -> lf_rw_stmt(s, cs)), lf_emit_all(defs, cs, cs, parent, st))

fn lf_emit_all(defs, cs, all, parent, st) = match defs
  Nil -> st
  Cons(d, drest) -> lf_emit_step(d, drest, cs, all, parent, st)

fn lf_emit_step(d, drest, cs, all, parent, st) = match cs
  Cons(c, crest) -> lf_emit_all(drest, crest, all, parent, lf_emit_one(d, c, all, parent, st))
  Nil -> st

fn lf_emit_one(d, c, all, parent, st) = match d
  LD2(FnD(_, _, ps, ret, body, ln, _), _, _) -> lf_emit_one2(c, ps, ret, body, ln, all, parent, st)

# Rewritten first, then lifted: a nested function's free names have to
# include what a sibling call passes. Its scope is exactly its parameters.
fn lf_emit_one2(c, ps, ret, body, ln, all, parent, st) = match c
  LC(_, lifted, caps, _) -> lf_emit_one3(lf_expr(lf_rw(body, all), append(caps, par_names(ps, Nil)), lifted, st), lifted, caps, ps, ret, ln, parent)

fn lf_emit_one3(le, lifted, caps, ps, ret, ln, parent) = match le
  LE(b2, st) -> lf_emit(st, FnD(lifted, false, append(map(caps, \x -> Par(x, None)), ps), ret, b2, ln, Some(parent)))

fn lf_rw_stmt(s, cs) = match s
  SBind(n, v, ln) -> SBind(n, lf_rw(v, cs), ln)
  SPatBind(p, v, ln) -> SPatBind(p, lf_rw(v, cs), ln)
  SExpr(e) -> SExpr(lf_rw(e, cs))
  SFn(f) -> SFn(lf_rw_fnd(f, cs))

fn lf_rw_fnd(f, cs) = match f
  FnD(n, ex, ps, ret, body, ln, pa) -> FnD(n, ex, ps, ret, lf_rw(body, cs), ln, pa)

fn lf_lookup(cs, n) = match cs
  Nil -> None
  Cons(LC(m, lifted, caps, refs), rest) -> if str_cmp(m, n) == 0 then Some(LC(m, lifted, caps, refs)) else lf_lookup(rest, n)

fn lf_rw(e, cs) = match e
  EVar(n, ln) -> lf_rw_var(lf_lookup(cs, n), n, ln)
  ECall(n, args, ln, pi) -> lf_rw_call(lf_lookup(cs, n), n, map(args, \a -> lf_rw(a, cs)), ln, pi)
  ENeg(x) -> ENeg(lf_rw(x, cs))
  EBin(op, l, r, ln) -> EBin(op, lf_rw(l, cs), lf_rw(r, cs), ln)
  EIf(c, t, e2) -> EIf(lf_rw(c, cs), lf_rw(t, cs), lf_rw(e2, cs))
  EMatch(sc, arms, ln) -> EMatch(lf_rw(sc, cs), map(arms, \a -> lf_rw_arm(a, cs)), ln)
  ELambda(ps, b, ln) -> ELambda(ps, lf_rw(b, cs), ln)
  ESpawn(b, ln) -> ESpawn(lf_rw(b, cs), ln)
  ESelect(arms, def, ln) -> ESelect(map(arms, \a -> lf_rw_sarm(a, cs)), opt_map(def, \d -> lf_rw(d, cs)), ln)
  ELen(x, ln) -> ELen(lf_rw(x, cs), ln)
  EIndex(b, ix, ln) -> EIndex(lf_rw(b, cs), lf_rw(ix, cs), ln)
  EIndexSet(b, ix, v, ln) -> EIndexSet(lf_rw(b, cs), lf_rw(ix, cs), lf_rw(v, cs), ln)
  EIndexOp(op, b, ix, v, ln) -> EIndexOp(op, lf_rw(b, cs), lf_rw(ix, cs), lf_rw(v, cs), ln)
  EFor(x, f, t, body, ln) -> EFor(x, lf_rw(f, cs), lf_rw(t, cs), lf_rw(body, cs), ln)
  EBlock(ss) -> EBlock(map(ss, \s -> lf_rw_stmt(s, cs)))
  _ -> e

fn lf_rw_var(o, n, ln) = match o
  Some(_) -> tldie("`" + n + "` is a local function, and a local function can only be called — it takes the names around it as arguments, so there is no one value to hand out for it")
  None -> EVar(n, ln)

fn lf_rw_call(o, n, args, ln, pi) = match o
  Some(LC(_, lifted, caps, _)) -> ECall(lifted, append(map(caps, \c -> EVar(c, ln)), args), ln, false)
  None -> ECall(n, args, ln, pi)

fn lf_rw_arm(a, cs) = match a
  Arm(p, b, ln) -> Arm(p, lf_rw(b, cs), ln)

fn lf_rw_sarm(a, cs) = match a
  SArm(op, b, ln) -> SArm(lf_rw_sop(op, cs), lf_rw(b, cs), ln)

fn lf_rw_sop(op, cs) = match op
  SRecv(ch, bd) -> SRecv(lf_rw(ch, cs), bd)
  SSend(ch, v) -> SSend(lf_rw(ch, cs), lf_rw(v, cs))

# Names used in a body that nothing inside it binds. A callee name counts: a
# name in scope may be a function value being called.
fn lf_fv(e, bound, acc) = match e
  EVar(n, _) -> if lf_in(bound, n) then acc else Cons(n, acc)
  ECall(n, args, _, _) -> fold(args, if lf_in(bound, n) then acc else Cons(n, acc), \a, x -> lf_fv(x, bound, a))
  ENeg(x) -> lf_fv(x, bound, acc)
  EBin(_, l, r, _) -> lf_fv(r, bound, lf_fv(l, bound, acc))
  EIf(c, t, e2) -> lf_fv(e2, bound, lf_fv(t, bound, lf_fv(c, bound, acc)))
  EMatch(sc, arms, _) -> fold(arms, lf_fv(sc, bound, acc), \a, arm -> lf_fv_arm(arm, bound, a))
  ELambda(ps, b, _) -> lf_fv(b, append(bound, ps), acc)
  ESpawn(b, _) -> lf_fv(b, bound, acc)
  ESelect(arms, def, _) -> lf_fv_def(def, bound, fold(arms, acc, \a, sa -> lf_fv_sarm(sa, bound, a)))
  ELen(x, _) -> lf_fv(x, bound, acc)
  EIndex(b, ix, _) -> lf_fv(ix, bound, lf_fv(b, bound, acc))
  EIndexSet(b, ix, v, _) -> lf_fv(v, bound, lf_fv(ix, bound, lf_fv(b, bound, acc)))
  EIndexOp(_, b, ix, v, _) -> lf_fv(v, bound, lf_fv(ix, bound, lf_fv(b, bound, acc)))
  EFor(x, f, t, body, _) -> lf_fv(body, Cons(x, bound), lf_fv(t, bound, lf_fv(f, bound, acc)))
  EBlock(ss) -> lf_fv_stmts(ss, bound, acc)
  _ -> acc

fn lf_fv_arm(arm, bound, acc) = match arm
  Arm(p, b, _) -> lf_fv(b, append(bound, lf_pat_names(p, Nil)), acc)

fn lf_fv_sarm(sa, bound, acc) = match sa
  SArm(op, b, _) -> lf_fv(b, append(bound, lf_sop_binds(op, Nil)), lf_fv_sop(op, bound, acc))

fn lf_fv_sop(op, bound, acc) = match op
  SRecv(ch, _) -> lf_fv(ch, bound, acc)
  SSend(ch, v) -> lf_fv(v, bound, lf_fv(ch, bound, acc))

fn lf_fv_def(def, bound, acc) = match def
  Some(d) -> lf_fv(d, bound, acc)
  None -> acc

fn lf_fv_stmts(ss, bound, acc) = match ss
  Nil -> acc
  Cons(SBind(n, v, _), rest) -> lf_fv_stmts(rest, append(bound, Cons(n, Nil)), lf_fv(v, bound, acc))
  Cons(SPatBind(p, v, _), rest) -> lf_fv_stmts(rest, append(bound, lf_pat_names(p, Nil)), lf_fv(v, bound, acc))
  Cons(SExpr(e), rest) -> lf_fv_stmts(rest, bound, lf_fv(e, bound, acc))
  Cons(SFn(FnD(n, _, ps, _, body, _, _)), rest) -> lf_fv_stmts(rest, Cons(n, bound), lf_fv(body, append(Cons(n, bound), par_names(ps, Nil)), acc))
