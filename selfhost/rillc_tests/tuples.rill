fn divmod(a, b) = (a / b, a % b)

fn measure(s, i) = if i >= #s then 0 else s[i] + measure(s, i + 1)

fn label(p: (Int, Str)) = match p
  (n, s) -> s + ":" + int_to_str(n)

fn walk(l, n, s) = match l
  Nil -> (n, s)
  Cons(x, rest) -> walk(rest, n + 1, s + x)

fn main() =
  (q, r) = divmod(17, 5)
  println(q * 100 + r)
  (n, s) = walk(range(1, 10), 0, 0)
  println(n * 1000 + s)
  println(label((7, "seven")))
  println((1, "a", true))
  println((1, 2) == (1, 2))
  println((1, 2) == (1, 3))
  (a, (b, c)) = (1, (2, 3))
  println(a + b + c)
  v = buf_int(3)

  for i in 0..3
    (x, y) = divmod(i * 7, 3)
    v[i] = x * 10 + y

  println(v[0] + v[1] + v[2])
  println(show((4, 5)))
  println(#v)
  println(#"merhaba" + #"")
  println(measure("ab", 0))
