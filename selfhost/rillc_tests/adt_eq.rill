type P
  Pt(Int, Int)

fn main() =
  println(Pt(1, 2) == Pt(1, 2))
  println(Pt(1, 2) == Pt(1, 3))
  println(Pt(1, 2) != Pt(9, 9))
  a = Cons(1, Cons(2, Cons(3, Nil)))
  b = Cons(1, Cons(2, Cons(3, Nil)))
  println(a == b)
  println(a == Cons(1, Nil))
  println(Some("hi") == Some("hi"))
  println(Some("hi") == Some("ho"))
  println(None == Some(1))
