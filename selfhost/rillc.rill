# `rillc` — the self-hosted compiler as a command.
#
# The stages behind it are all Rill: the lexer and parser, the type checker,
# and the code generator in `rillc_gen.rill`. What was missing was the part a
# compiler is actually used through — a driver that finds the prelude and the
# runtime, writes the LLVM IR somewhere, and calls the system linker. That is
# this file, and with it the toolchain no longer needs the Rust `rill` for
# anything but building `rillc` the first time.
#
#   rillc build <file.rill> [-o <out>] [--keep-ir]
#   rillc run <file.rill>
#   rillc emit-llvm <file.rill> [-o <out.ll>]
#   rillc check <file.rill>
#
# The linker is reached through C's `system`, so every path the driver hands
# it is shell-quoted. `cc -O2` is not decoration: the generated IR is
# unoptimized, and it is the optimizer that turns the emitted `tail call`
# into a jump. Without it deep recursion overflows the stack.

import "rillc_gen"

# The C library does the four things a driver needs and Rill has no built-in
# for: run a command, read the environment, ask whether a file exists, and
# delete one.
extern fn system(command: Ptr) -> I32

extern fn getenv(name: Ptr) -> Ptr

extern fn access(path: Ptr, mode: I32) -> I32

extern fn remove(path: Ptr) -> I32

# What a command line adds up to: the source, where the output goes, where
# the prelude and the runtime library are, and whether to keep the IR file.
# Empty means "not given, work it out".
type RCX
  RCX(Str, Str, Str, Str, Bool)

fn rc_usage() =
  "usage:\n  rillc build <file.rill> [-o <out>] [--keep-ir]\n  rillc run <file.rill>\n  rillc emit-llvm <file.rill> [-o <out.ll>]\n  rillc check <file.rill>\n\n  -o          where to write the executable (or the IR, for emit-llvm)\n  --keep-ir   leave the <out>.ll file behind after linking\n  --prelude   the prelude source ($RILL_PRELUDE, else found next to rillc)\n  --runtime   librill_runtime.a ($RILL_RUNTIME, else found next to rillc)"

fn rc_usage_die(msg) =
  println("rillc: " + msg)
  println(rc_usage())
  exit(1)
  rc_usage_die(msg)

# ---- talking to the system --------------------------------------------------

# A command's exit status the way a shell reports it: the code it exited
# with, or 128 plus the signal that killed it.
fn rc_status(st) =
  sig = bit_and(st, 255)
  if st < 0 then 127 else if sig != 0 then 128 + sig else bit_and(shr(st, 8), 255)

fn rc_sh(cmd) =
  p = to_cstr(cmd)
  st = system(p)
  free_ptr(p)
  rc_status(st)

fn rc_getenv(name) =
  p = to_cstr(name)
  v = getenv(p)
  free_ptr(p)
  if is_null(v) then "" else from_cstr(v)

fn rc_exists(path) =
  p = to_cstr(path)
  r = access(p, 0)
  free_ptr(p)
  r == 0

fn rc_unlink(path) =
  p = to_cstr(path)
  r = remove(p)
  free_ptr(p)
  r == 0

# One shell word, whatever is in it. Single quotes protect everything except
# a single quote, which has to leave and come back: `'` becomes `'\''`.
fn rc_quote(s) = "'" + rc_quote_from(s, 0, "") + "'"

fn rc_quote_from(s, i, acc) =
  if i >= str_len(s) then acc else rc_quote_from(s, i + 1, acc + rc_quote_byte(str_get(s, i)))

fn rc_quote_byte(c) = if c == 39 then "'\\''" else chr(c)

# ---- paths ------------------------------------------------------------------

fn rc_last_slash(s, i) =
  if i < 0 then 0 - 1 else if str_get(s, i) == 47 then i else rc_last_slash(s, i - 1)

fn rc_dirname(p) = rc_dirname2(p, rc_last_slash(p, str_len(p) - 1))

fn rc_dirname2(p, i) = if i < 0 then "." else if i == 0 then "/" else str_sub(p, 0, i)

fn rc_basename(p) = rc_basename2(p, rc_last_slash(p, str_len(p) - 1))

fn rc_basename2(p, i) = str_sub(p, i + 1, str_len(p) - i - 1)

fn rc_ends_with(s, suf) =
  str_len(s) >= str_len(suf) && str_sub(s, str_len(s) - str_len(suf), str_len(suf)) == suf

fn rc_drop_ext(p) = if rc_ends_with(p, ".rill") then str_sub(p, 0, str_len(p) - 5) else p

# `rillc run foo.rill` has to say `./foo`, not `foo`.
fn rc_exe_path(out) = if str_find(out, "/") >= 0 then out else "./" + out

fn rc_first_existing(cands, what, hint) = match cands
  Cons(c, rest) -> if rc_exists(c) then c else rc_first_existing(rest, what, hint)
  Nil -> rcdie("cannot find " + what + "; " + hint)

# The prelude and the runtime are looked for where a built tree keeps them:
# beside `rillc` itself, or up one level in the source tree it was built in.
fn rc_find_prelude(given, home) =
  if given != "" then given else rc_find_prelude2(rc_getenv("RILL_PRELUDE"), home)

fn rc_find_prelude2(fromenv, home) =
  if fromenv != "" then fromenv else rc_first_existing(rc_prelude_dirs(home), "the prelude", "set RILL_PRELUDE or pass --prelude")

fn rc_prelude_dirs(home) =
  Cons(home + "/prelude.rill", Cons(home + "/../crates/rill_syntax/src/prelude.rill", Cons("crates/rill_syntax/src/prelude.rill", Nil)))

fn rc_find_runtime(given, home) =
  if given != "" then given else rc_find_runtime2(rc_getenv("RILL_RUNTIME"), home)

fn rc_find_runtime2(fromenv, home) =
  if fromenv != "" then fromenv else rc_first_existing(rc_runtime_dirs(home), "librill_runtime.a", "set RILL_RUNTIME or pass --runtime")

fn rc_runtime_dirs(home) =
  Cons(home + "/librill_runtime.a", Cons(home + "/../target/release/librill_runtime.a", Cons("target/release/librill_runtime.a", Nil)))

# ---- the libraries the program asks for -------------------------------------
#
# Every `extern "lib" fn ...` names something to link. A bare name is a
# library to search for, `framework:Name` is a macOS framework, and anything
# starting with `-` is handed to the linker as written — which is how a
# program says where its libraries live. Search paths go first, so they apply
# no matter which declaration carried them.

fn rc_libs(ds, acc) = match ds
  Cons(DExtern(_, lib, _, _, _), rest) -> rc_libs(rest, rc_add_lib(lib, acc))
  Cons(_, rest) -> rc_libs(rest, acc)
  Nil -> reverse(acc)

fn rc_add_lib(lib, acc) = match lib
  Some(l) -> if any(acc, \x -> x == l) then acc else Cons(l, acc)
  None -> acc

fn rc_lib_flags(libs) =
  paths = filter(libs, \l -> starts_with(l, "-"))
  named = filter(libs, \l -> !starts_with(l, "-"))
  cat(map(append(map(paths, \l -> rc_quote(l)), map(named, \l -> rc_lib_flag(l))), \f -> " " + f))

fn rc_lib_flag(l) =
  if starts_with(l, "framework:") then "-framework " + rc_quote(str_sub(l, 10, str_len(l) - 10)) else "-l" + rc_quote(l)

# ---- the command line -------------------------------------------------------

fn rc_parse(as, o) = match as
  Nil -> o
  Cons(a, rest) -> rc_parse_one(a, rest, o)

fn rc_parse_one(a, rest, o) =
  if a == "-o" then rc_parse(rc_tail(rest, a), rc_set_out(o, rc_head(rest, a))) else if a == "--prelude" then rc_parse(rc_tail(rest, a), rc_set_prelude(o, rc_head(rest, a))) else if a == "--runtime" then rc_parse(rc_tail(rest, a), rc_set_runtime(o, rc_head(rest, a))) else if a == "--keep-ir" then rc_parse(rest, rc_set_keep(o)) else if starts_with(a, "-") then rc_usage_die("unknown option `" + a + "`") else rc_parse(rest, rc_set_src(o, a))

fn rc_head(l, flag) = match l
  Cons(x, _) -> x
  Nil -> rc_usage_die("`" + flag + "` needs a value")

fn rc_tail(l, flag) = match l
  Cons(_, r) -> r
  Nil -> rc_usage_die("`" + flag + "` needs a value")

fn rc_set_src(o, v) = match o
  RCX(s, out, pre, rt, k) -> if s != "" then rc_usage_die("more than one source file given") else RCX(v, out, pre, rt, k)

fn rc_set_out(o, v) = match o
  RCX(s, _, pre, rt, k) -> RCX(s, v, pre, rt, k)

fn rc_set_prelude(o, v) = match o
  RCX(s, out, _, rt, k) -> RCX(s, out, v, rt, k)

fn rc_set_runtime(o, v) = match o
  RCX(s, out, pre, _, k) -> RCX(s, out, pre, v, k)

fn rc_set_keep(o) = match o
  RCX(s, out, pre, rt, _) -> RCX(s, out, pre, rt, true)

# Parsing, then the one default every command shares: the prelude. `-o` stays
# as it came, empty and all, because an absent `-o` means the executable is
# named after the source but the IR goes to stdout.
fn rc_opts(flags, home) = rc_defaults(rc_parse(flags, RCX("", "", "", "", false)), home)

fn rc_defaults(o, home) = match o
  RCX(s, out, pre, rt, k) ->
    if s == "" then rc_usage_die("no source file given") else RCX(s, out, rc_find_prelude(pre, home), rt, k)

fn rc_out_or(out, src) = if out != "" then out else rc_drop_ext(rc_basename(src))

# ---- the commands -----------------------------------------------------------

# `emit-llvm` with no `-o` prints, so the IR can be piped somewhere.
fn rc_emit(o) = match o
  RCX(src, out, pre, _, _) -> rc_emit2(rc_ir(setup(load_program(src, pre))), out)

fn rc_emit2(ir, out) = if out == "" then print(ir) else rc_write(out, ir)

fn rc_write(path, text) =
  if write_file(path, text) then rc_done() else rcdie("cannot write `" + path + "`")

fn rc_check(o) = match o
  RCX(src, _, pre, _, _) -> rc_checked(run_check_of(setup(load_program(src, pre))))

fn run_check_of(so) = match so
  SO(cx, st, fns) -> run_check(cx, st, fns)

fn rc_checked(r) = rc_done()

# Nothing to say, and — unlike `exit(0)` — said by falling off the end of the
# program, which is what lets the runtime's allocation report run. The whole
# leak proof hangs off that, so success never leaves through `exit`.
fn rc_done() = print("")

fn rc_build(o, home, then_run) = match o
  RCX(src, out, pre, rt, keep) ->
    rc_build2(src, rc_out_or(out, src), pre, rc_find_runtime(rt, home), keep, then_run)

fn rc_build2(src, out, pre, rt, keep, then_run) =
  m = load_program(src, pre)
  libs = rc_libs(m2_externs(m), Nil)
  ll = out + ".ll"
  if write_file(ll, rc_ir(setup(m))) then 0 else rcdie("cannot write `" + ll + "`")
  st = rc_sh(rc_link(ll, rt, out, libs))
  keep || rc_unlink(ll)
  rc_linked(st, out, then_run)

fn rc_link(ll, rt, out, libs) =
  "cc -O2 -Wno-override-module " + rc_quote(ll) + " " + rc_quote(rt) + " -o " + rc_quote(out) + rc_lib_flags(libs)

fn rc_linked(st, out, then_run) =
  if st != 0 then rcdie("linking failed") else if then_run then exit(rc_sh(rc_quote(rc_exe_path(out)))) else rc_done()

# ---- the entry point --------------------------------------------------------

fn main() = rc_dispatch(drop(args(), 1), rc_dirname(arg(0)))

fn rc_dispatch(as, home) = match as
  Nil -> rc_usage_die("no command given")
  Cons(cmd, flags) -> rc_command(cmd, flags, home)

fn rc_command(cmd, flags, home) =
  if cmd == "build" then rc_build(rc_opts(flags, home), home, false) else if cmd == "run" then rc_build(rc_opts(flags, home), home, true) else if cmd == "emit-llvm" then rc_emit(rc_opts(flags, home)) else if cmd == "check" then rc_check(rc_opts(flags, home)) else if cmd == "help" || cmd == "-h" || cmd == "--help" then rc_help() else rc_usage_die("unknown command `" + cmd + "`")

fn rc_help() = println(rc_usage())
