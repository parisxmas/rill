# The canonical printer, in Rill — the other half of `rill fmt`. The output
# is defined by the tree, not the input text; comments ride across by line
# anchoring exactly as in the Rust formatter: own-line comments attach to the
# construct that follows them, trailing comments stay on their line, and one
# authored blank line between items is preserved.
#
# Printer state is one constructor: `FS(out, own, trailing, last_line)` —
# the growing output, the own-line comments not yet placed, the trailing
# comments not yet claimed, and the highest source line already printed.

import "token"
import "ast"

type FS
  FS(Str, List(Cm), List(Cm), Int)

type RR
  RR(FS, Str)

type OB
  OB(List(Cm), FS)

type TO
  TO(Option(Str), FS)

fn pad(n) = repeat("  ", n)

fn fs_out(fs) = match fs
  FS(o, _, _, _) -> o

fn fs_last(fs) = match fs
  FS(_, _, _, l) -> l

fn fs_push(fs, ind, text) = match fs
  FS(o, own, tr, l) -> FS(o + pad(ind) + text + "\n", own, tr, l)

fn fs_blank(fs) = match fs
  FS(o, own, tr, l) -> FS(o + "\n", own, tr, l)

fn fs_mark(fs, ln) = match fs
  FS(o, own, tr, l) -> FS(o, own, tr, max(l, ln))

fn fs_set_last(fs, ln) = match fs
  FS(o, own, tr, l) -> FS(o, own, tr, max(l, ln))

fn had_gap(fs, ln) = fs_last(fs) > 0 && ln > fs_last(fs) + 1

# Own-line comments strictly before `line`, in order.
fn own_before(fs, line) = match fs
  FS(o, own, tr, l) -> ob_take(o, own, tr, l, line, Nil)

fn ob_take(o, own, tr, l, line, acc) = match own
  Cons(Cm(cl, text, ol), rest) -> if cl < line then ob_take(o, rest, tr, l, line, Cons(Cm(cl, text, ol), acc)) else OB(reverse(acc), FS(o, own, tr, l))
  Nil -> OB(reverse(acc), FS(o, Nil, tr, l))

# The line of the next unplaced own-line comment, or a line beyond any file.
fn own_peek(fs) = match fs
  FS(_, own, _, _) -> own_peek2(own)

fn own_peek2(own) = match own
  Cons(Cm(cl, _, _), _) -> cl
  Nil -> 999999999

fn own_rest(fs) = match fs
  FS(o, own, tr, l) -> own_rest2(o, own)

fn own_rest2(o, own) = match own
  Cons(Cm(_, text, _), rest) -> own_rest2(o + "\n" + text + "\n", rest)
  Nil -> o

# Claims the trailing comment sitting on `line`, if any.
fn tr_on(fs, line) = match fs
  FS(o, own, tr, l) -> tr_take(o, own, tr, l, line, Nil)

fn tr_take(o, own, tr, l, line, seen) = match tr
  Cons(Cm(cl, text, ol), rest) -> tr_hit(o, own, tr, l, line, seen, cl, text, ol, rest)
  Nil -> TO(None, FS(o, own, reverse(seen), l))

fn tr_hit(o, own, tr, l, line, seen, cl, text, ol, rest) =
  if cl == line then TO(Some(text), FS(o, own, append(reverse(seen), rest), l)) else tr_take(o, own, rest, l, line, Cons(Cm(cl, text, ol), seen))

fn push_at(fs, ind, text, ln) = push_at2(tr_on(fs_mark(fs, ln), ln), ind, text)

fn push_at2(to, ind, text) = match to
  TO(Some(c), fs) -> fs_push(fs, ind, text + "  " + c)
  TO(None, fs) -> fs_push(fs, ind, text)

# Everything that precedes the construct at `line`: one blank line wherever
# the author left one, plus the own-line comments attached to it.
fn lead(fs, line, ind) = lead2(own_before(fs, line), line, ind)

fn lead2(ob, line, ind) = match ob
  OB(cs, fs) -> lead3(lead_cs(fs, cs, ind), line)

fn lead_cs(fs, cs, ind) = match cs
  Cons(Cm(cl, text, _), rest) -> lead_cs(fs_push(fs_mark(if had_gap(fs, cl) then fs_blank(fs) else fs, cl), ind, text), rest, ind)
  Nil -> fs

fn lead3(fs, line) =
  fs_set_last(if had_gap(fs, line) then fs_blank(fs) else fs, if line > 0 then line - 1 else 0)

# ---- lines of things --------------------------------------------------------

fn expr_line(e) = match e
  EVar(_, ln) -> ln
  ECall(_, _, ln, _) -> ln
  EBin(_, _, _, ln) -> ln
  EMatch(_, _, ln) -> ln
  ELambda(_, _, ln) -> ln
  ESpawn(_, ln) -> ln
  ESelect(_, _, ln) -> ln
  EIndex(_, _, ln) -> ln
  EIndexSet(_, _, _, ln) -> ln
  ENeg(x) -> expr_line(x)
  EIf(c, _, _) -> expr_line(c)
  EBlock(ss) -> block_line(ss)
  _ -> 0

fn block_line(ss) = match ss
  Cons(s, _) -> stmt_line(s)
  Nil -> 0

fn stmt_line(s) = match s
  SBind(_, _, ln) -> ln
  SExpr(e) -> expr_line(e)

# ---- inline expressions -----------------------------------------------------

fn wrapp(need, s) = if need then "(" + s + ")" else s

fn bin_sym(op) =
  if op == 0 then "+" else if op == 1 then "-" else if op == 2 then "*" else if op == 3 then "/" else if op == 4 then "%" else if op == 5 then "==" else if op == 6 then "!=" else if op == 7 then "<" else if op == 8 then "<=" else if op == 9 then ">" else ">="

fn bin_prec(op) = if op <= 1 then 5 else if op <= 4 then 6 else 4

fn is_true(e) = match e
  EBool(b) -> b
  _ -> false

fn is_false(e) = match e
  EBool(b) -> !b
  _ -> false

fn inline(e, prec) = match e
  EInt(v) -> v
  EFloat(v) -> v
  EStr(v) -> "\"" + v + "\""
  EBool(b) -> if b then "true" else "false"
  EVar(n, _) -> n
  ECall(n, args, _, piped) -> inline_call(n, args, piped, prec)
  EIndex(b, ix, _) -> inline(b, 8) + "[" + inline(ix, 0) + "]"
  EIndexSet(b, ix, v, _) -> inline(b, 8) + "[" + inline(ix, 0) + "] = " + inline(v, 0)
  ENeg(x) -> wrapp(prec > 7, "-" + inline(x, 7))
  EBin(op, l, r, _) -> inline_bin(op, l, r, prec)
  EIf(c, t, els) -> inline_if(c, t, els, prec)
  ELambda(ps, b, _) -> wrapp(prec > 0, "\\" + join(ps, ", ") + " -> " + inline(b, 0))
  ESpawn(b, _) -> wrapp(prec > 0, "spawn " + inline(b, 0))
  EMatch(sc, arms, _) -> wrapp(prec > 0, "match " + inline(sc, 0) + " " + join(map(arms, \a -> inline_arm(a)), " "))
  ESelect(arms, def, _) -> inline_select(arms, def, prec)
  EBlock(_) -> "..."

fn inline_call(n, args, piped, prec) =
  if piped then inline_pipe(n, args, prec) else n + "(" + join(map(args, \a -> inline(a, 0)), ", ") + ")"

fn inline_pipe(n, args, prec) = match args
  Cons(h, rest) -> wrapp(prec > 1, inline(h, 1) + " |> " + pipe_callee(n, rest))
  Nil -> n

fn pipe_callee(n, rest) = match rest
  Nil -> n
  Cons(_, _) -> n + "(" + join(map(rest, \a -> inline(a, 0)), ", ") + ")"

fn inline_bin(op, l, r, prec) =
  p = bin_prec(op)
  rp = if p == 4 then 4 else p + 1
  wrapp(prec > p, inline(l, p) + " " + bin_sym(op) + " " + inline(r, rp))

# The shapes `&&`, `||` and `!` desugar to come back as the operators.
fn inline_if(c, t, els, prec) =
  if is_false(t) && is_true(els) then wrapp(prec > 7, "!" + inline(c, 7)) else if is_true(t) then wrapp(prec > 2, inline(c, 2) + " || " + inline(els, 3)) else if is_false(els) then wrapp(prec > 3, inline(c, 3) + " && " + inline(t, 4)) else wrapp(prec > 0, "if " + inline(c, 0) + " then " + inline(t, 0) + " else " + inline(els, 0))

fn inline_arm(a) = match a
  Arm(p, b, _) -> pat_str(p) + " -> " + inline(b, 0)

fn sel_op_str(op) = match op
  SRecv(ch, bind) -> sel_recv_str(ch, bind)
  SSend(ch, v) -> "send(" + inline(ch, 0) + ", " + inline(v, 0) + ")"

fn sel_recv_str(ch, bind) = match bind
  Some(n) -> n + " = recv(" + inline(ch, 0) + ")"
  None -> "recv(" + inline(ch, 0) + ")"

fn inline_select(arms, def, prec) =
  parts = map(arms, \a -> inline_sel_arm(a))
  all_parts = match def
    Some(d) -> append(parts, Cons("default -> " + inline(d, 0), Nil))
    None -> parts
  wrapp(prec > 0, "select " + join(all_parts, " "))

fn inline_sel_arm(a) = match a
  SArm(op, b, _) -> sel_op_str(op) + " -> " + inline(b, 0)

fn pat_str(p) = match p
  PWild -> "_"
  PVar(n) -> n
  PIntL(v) -> v
  PCtor(n, args) -> pat_ctor_str(n, args)

fn pat_ctor_str(n, args) = match args
  Nil -> n
  Cons(_, _) -> n + "(" + join(map(args, \a -> pat_str(a)), ", ") + ")"

fn tr_str(t) = match t
  TR(n, args, ret, _) -> tr_str2(n, args, ret)

fn tr_str2(n, args, ret) =
  tr_ret_str(if len(args) == 0 && str_cmp(n, "Fn") != 0 then n else n + "(" + join(map(args, \a -> tr_str(a)), ", ") + ")", ret)

fn tr_ret_str(s, ret) = match ret
  Some(r) -> s + " -> " + tr_str(r)
  None -> s

# ---- rendered expressions ---------------------------------------------------
#
# `render` is `inline` with layout: match arms, blocks and select arms go on
# their own lines at the continuation indent, and consume the comments
# anchored to them.

fn is_block(e) = match e
  EBlock(_) -> true
  _ -> false

fn block_stmts(e) = match e
  EBlock(ss) -> ss
  _ -> Nil

# Whether an `else` branch forces the layout form: it is a block, or an
# `else if` chain that ends in one.
fn else_needs_layout(e) = match e
  EBlock(_) -> true
  EIf(_, t, e2) -> is_block(t) || else_needs_layout(e2)
  _ -> false

# The statements of a block body, one per line at `ind`, comments woven in.
# The string starts with a newline, ready to follow `->`, `then` or `else`.
fn block_lines(fs, stmts, ind) = bl_loop(fs, stmts, ind, "")

fn bl_loop(fs, stmts, ind, s) = match stmts
  Cons(st, rest) -> bl_one(own_before(fs, stmt_line(st)), st, rest, ind, s)
  Nil -> RR(fs, s)

fn bl_one(ob, st, rest, ind, s) = match ob
  OB(cs, fs) -> bl_two(fold(cs, RRS(fs, s), \acc, c -> weave(acc, c, ind)), st, rest, ind)

fn bl_two(acc, st, rest, ind) = match acc
  RRS(fs, s) -> bl_three(rb_text(fs_mark(fs, stmt_line(st)), st, ind), st, rest, ind, s)

fn bl_three(rr, st, rest, ind, s) = match rr
  RR(fs, text) -> bl_four(tr_on(fs, stmt_line(st)), rest, ind, s + "\n" + pad(ind) + text)

fn bl_four(to, rest, ind, s) = match to
  TO(Some(c), fs) -> bl_loop(fs, rest, ind, s + "  " + c)
  TO(None, fs) -> bl_loop(fs, rest, ind, s)

fn render(fs, e, cont) = match e
  EMatch(sc, arms, _) -> render_match(fs, sc, arms, cont)
  EBlock(ss) -> render_block(fs, ss, cont)
  EIf(c, t, els) -> render_if(fs, c, t, els, cont)
  ELambda(ps, b, _) -> render_lambda(fs, ps, b, cont)
  ESpawn(b, _) -> render_spawn(fs, b, cont)
  ESelect(arms, def, _) -> render_select_full(fs, arms, def, cont)
  _ -> RR(fs, inline(e, 0))

fn render_match(fs, sc, arms, cont) = rm2(render(fs, sc, cont), arms, cont)

fn rm2(rr, arms, cont) = match rr
  RR(fs, sctext) -> rm_arms(fs, arms, cont, "match " + sctext)

fn rm_arms(fs, arms, cont, s) = match arms
  Cons(a, rest) -> rm_arms2(rm_arm(fs, a, cont, s), rest, cont)
  Nil -> RR(fs, s)

fn rm_arms2(rr, rest, cont) = match rr
  RR(fs, s) -> rm_arms(fs, rest, cont, s)

fn rm_arm(fs, a, cont, s) = match a
  Arm(p, b, ln) -> rm_arm2(own_before(fs, ln), p, b, ln, cont, s)

fn rm_arm2(ob, p, b, ln, cont, s) = match ob
  OB(cs, fs) -> rm_arm3(fold(cs, RRS(fs, s), \acc, c -> weave(acc, c, cont)), p, b, ln, cont)

type RRS
  RRS(FS, Str)

fn weave(acc, c, cont) = match acc
  RRS(fs, s) -> weave2(fs, s, c, cont)

fn weave2(fs, s, c, cont) = match c
  Cm(cl, text, _) -> RRS(fs_mark(fs, cl), s + "\n" + pad(cont) + text)

fn rm_arm3(acc, p, b, ln, cont) = match acc
  RRS(fs, s) -> rm_arm3b(fs_mark(fs, ln), p, b, ln, cont, s)

fn rm_arm3b(fs, p, b, ln, cont, s) =
  if is_block(b) then rm_blk(tr_on(fs, ln), b, cont, s + "\n" + pad(cont) + pat_str(p) + " ->") else rm_arm4(render(fs, b, cont + 1), p, ln, cont, s)

fn rm_blk(to, b, cont, s) = match to
  TO(Some(c), fs) -> rm_blk2(block_lines(fs, block_stmts(b), cont + 1), s + "  " + c)
  TO(None, fs) -> rm_blk2(block_lines(fs, block_stmts(b), cont + 1), s)

fn rm_blk2(rr, s) = match rr
  RR(fs, bl) -> RR(fs, s + bl)

fn rm_arm4(rr, p, ln, cont, s) = match rr
  RR(fs, body) -> rm_arm5(tr_on(fs, ln), s + "\n" + pad(cont) + pat_str(p) + " -> " + body)

fn rm_arm5(to, s) = match to
  TO(Some(c), fs) -> RR(fs, s + "  " + c)
  TO(None, fs) -> RR(fs, s)

fn render_block(fs, ss, cont) = rb_loop(fs, ss, cont, "", true)

fn rb_loop(fs, ss, cont, s, first) = match ss
  Cons(st, rest) -> rb_one(rb_text(fs, st, cont), rest, cont, s, first)
  Nil -> RR(fs, s)

fn rb_one(rr, rest, cont, s, first) = match rr
  RR(fs, text) -> rb_loop(fs, rest, cont, if first then text else s + "\n" + pad(cont) + text, false)

fn rb_text(fs, st, cont) = match st
  SBind(n, v, _) -> rb_bind(render(fs, v, cont + 1), n)
  SExpr(e) -> render(fs, e, cont + 1)

fn rb_bind(rr, n) = match rr
  RR(fs, text) -> RR(fs, n + " = " + text)

fn render_if(fs, c, t, els, cont) =
  if is_block(t) || else_needs_layout(els) then ri_layout(fs, c, t, els, cont) else ri2(render(fs, t, cont), fs, c, t, els, cont)

fn ri_layout(fs, c, t, els, cont) = ri_then(ri_branch(fs, t, cont), c, els, cont)

fn ri_branch(fs, b, cont) =
  if is_block(b) then block_lines(fs, block_stmts(b), cont) else ri_sp(render(fs, b, cont))

fn ri_sp(rr) = match rr
  RR(fs, txt) -> RR(fs, " " + txt)

fn ri_then(rr, c, els, cont) = match rr
  RR(fs, tt) -> ri_else(ri_branch(fs, els, cont), c, tt, cont)

fn ri_else(rr, c, tt, cont) = match rr
  RR(fs, ee) -> RR(fs, "if " + inline(c, 0) + " then" + tt + "\n" + pad(if cont > 0 then cont - 1 else 0) + "else" + ee)

fn ri2(rr, fs0, c, t, els, cont) = match rr
  RR(fs, tt) -> ri3(render(fs, els, cont), tt, c, t, els)

fn ri3(rr, tt, c, t, els) = match rr
  RR(fs, ee) -> RR(fs, if contains(tt, "\n") || contains(ee, "\n") then "if " + inline(c, 0) + " then " + tt + " else " + ee else inline(EIf(c, t, els), 0))

fn render_lambda(fs, ps, b, cont) = rl2(render(fs, b, cont), ps, b)

fn rl2(rr, ps, b) = match rr
  RR(fs, bt) -> RR(fs, if contains(bt, "\n") then "\\" + join(ps, ", ") + " -> " + bt else inline(ELambda(ps, b, 0), 0))

fn render_spawn(fs, b, cont) = rs2(render(fs, b, cont), b)

fn rs2(rr, b) = match rr
  RR(fs, bt) -> RR(fs, if contains(bt, "\n") then "spawn " + bt else inline(ESpawn(b, 0), 0))

# Select arms render like match arms; the default is anchored to its own
# line, or to the line after the last arm when it has none.
fn render_select_full(fs, arms, def, cont) =
  rsf(rsel_collect(fs, arms, cont, "select", 0), def, cont)

fn rsel_collect(fs, arms, cont, s, lastln) = match arms
  Cons(a, rest) -> rsel_c1(fs, a, rest, cont, s)
  Nil -> RSL(fs, s, lastln)

type RSL
  RSL(FS, Str, Int)

fn rsel_c1(fs, a, rest, cont, s) = match a
  SArm(op, b, ln) -> rsel_c2(own_before(fs, ln), op, b, ln, rest, cont, s)

fn rsel_c2(ob, op, b, ln, rest, cont, s) = match ob
  OB(cs, fs) -> rsel_c3(fold(cs, RRS(fs, s), \acc, c -> weave(acc, c, cont)), op, b, ln, rest, cont)

fn rsel_c3(acc, op, b, ln, rest, cont) = match acc
  RRS(fs, s) -> rsel_c3b(fs_mark(fs, ln), op, b, ln, rest, cont, s)

fn rsel_c3b(fs, op, b, ln, rest, cont, s) =
  if is_block(b) then rsel_blk(block_lines(fs, block_stmts(b), cont + 1), ln, rest, cont, s + "\n" + pad(cont) + sel_op_str(op) + " ->") else rsel_c4(render(fs, b, cont + 1), op, ln, rest, cont, s)

fn rsel_blk(rr, ln, rest, cont, s) = match rr
  RR(fs, bl) -> rsel_collect(fs, rest, cont, s + bl, ln)

fn rsel_c4(rr, op, ln, rest, cont, s) = match rr
  RR(fs, body) -> rsel_collect(fs, rest, cont, s + "\n" + pad(cont) + sel_op_str(op) + " -> " + body, ln)

fn rsf(rsl, def, cont) = match rsl
  RSL(fs, s, lastln) -> rsf2(fs, s, lastln, def, cont)

fn rsf2(fs, s, lastln, def, cont) = match def
  Some(d) -> rsf3(fs_mark(fs, if expr_line(d) == 0 then lastln + 1 else expr_line(d)), s, d, cont)
  None -> RR(fs, s)

fn rsf3(fs, s, d, cont) =
  if is_block(d) then rsf_blk(block_lines(fs, block_stmts(d), cont + 1), s + "\n" + pad(cont) + "default ->") else rsf4(render(fs, d, cont + 1), s, cont)

fn rsf_blk(rr, s) = match rr
  RR(fs, bl) -> RR(fs, s + bl)

fn rsf4(rr, s, cont) = match rr
  RR(fs, body) -> RR(fs, s + "\n" + pad(cont) + "default -> " + body)

# ---- declarations -----------------------------------------------------------

fn ret_str(r) = match r
  Some(t) -> " -> " + tr_str(t)
  None -> ""

fn par_str(p) = match p
  Par(n, Some(t)) -> n + ": " + tr_str(t)
  Par(n, None) -> n

fn ep_str(p) = match p
  EP(n, t) -> n + ": " + tr_str(t)

fn field_str(f) = match f
  Fld(Some(n), t) -> n + ": " + tr_str(t)
  Fld(None, t) -> tr_str(t)

fn lib_str(l) = match l
  Some(x) -> " \"" + x + "\""
  None -> ""

fn type_params(ps) = match ps
  Nil -> ""
  Cons(_, _) -> "(" + join(ps, ", ") + ")"

fn decl_line(d) = match d
  DImport(_, _, ln) -> ln
  DType(_, _, _, ln) -> ln
  DTrait(_, _, _, ln) -> ln
  DImpl(_, _, _, ln) -> ln
  DExtern(_, _, _, _, ln) -> ln
  DFn(f) -> fnd_line(f)

fn fnd_line(f) = match f
  FnD(_, _, _, _, _, ln) -> ln

fn is_import(d) = match d
  DImport(_, _, _) -> true
  _ -> false

fn pr_stmts(fs, ss, ind) = match ss
  Cons(st, rest) -> pr_stmts(pr_stmt(fs, st, ind), rest, ind)
  Nil -> fs

fn pr_stmt(fs, st, ind) =
  pr_stmt2(rb_text(lead(fs, stmt_line(st), ind), st, ind), stmt_line(st), ind)

fn pr_stmt2(rr, ln, ind) = match rr
  RR(fs, text) -> push_at(fs, ind, text, ln)

fn pr_fndef(fs, f, ind) = match f
  FnD(name, ex, ps, ret, body, ln) -> pf2(lead(fs, ln, ind), name, ex, ps, ret, body, ln, ind)

fn pf2(fs, name, ex, ps, ret, body, ln, ind) =
  pf3(fs, (if ex then "export fn " else "fn ") + name + "(" + join(map(ps, \p -> par_str(p)), ", ") + ")" + ret_str(ret) + " =", body, ln, ind)

fn pf3(fs, header, body, ln, ind) = match body
  EBlock(ss) -> pr_stmts(push_at(fs, ind, header, ln), ss, ind + 1)
  _ -> pf4(render(fs, body, ind + 1), header, body, ln, ind)

# A one-line body stays on the header when it fits in a hundred columns; a
# multi-line rendering always rides along, its own lines already padded.
fn pf4(rr, header, body, ln, ind) = match rr
  RR(fs, rendered) -> pf5(fs, rendered, header, body, ln, ind)

fn pf5(fs, rendered, header, body, ln, ind) =
  if contains(rendered, "\n") || ind * 2 + str_len(header) + 1 + str_len(rendered) <= 100 then push_at(fs, ind, header + " " + rendered, ln) else pf6(push_at(fs, ind, header, ln), body, ind)

fn pf6(fs, body, ind) = pf7(render(fs, body, ind + 2), ind)

fn pf7(rr, ind) = match rr
  RR(fs, rendered) -> fs_push(fs, ind + 1, rendered)

fn pr_ctor(fs, c) = match c
  Ct(n, fields, ln) -> push_at(lead(fs, ln, 1), 1, ctor_text(n, fields), ln)

fn ctor_text(n, fields) = match fields
  Nil -> n
  Cons(_, _) -> n + "(" + join(map(fields, \f -> field_str(f)), ", ") + ")"

fn pr_ctors(fs, cs) = match cs
  Cons(c, rest) -> pr_ctors(pr_ctor(fs, c), rest)
  Nil -> fs

fn pr_sig(fs, m) = match m
  Sig(n, ps, rt, ln) -> push_at(lead(fs, ln, 1), 1, n + "(" + join(map(ps, \t -> tr_str(t)), ", ") + ") -> " + tr_str(rt), ln)

fn pr_sigs(fs, ms) = match ms
  Cons(m, rest) -> pr_sigs(pr_sig(fs, m), rest)
  Nil -> fs

fn pr_impl_fns(fs, fns) = match fns
  Cons(f, rest) -> pr_impl_fns(pr_fndef(fs, f, 1), rest)
  Nil -> fs

fn import_text(path, a) = match a
  Some(x) -> "import \"" + path + "\" as " + x
  None -> "import \"" + path + "\""

fn print_decl(fs, d) = match d
  DImport(path, a, ln) -> push_at(fs, 0, import_text(path, a), ln)
  DType(name, ps, cs, ln) -> pr_ctors(push_at(fs, 0, "type " + name + type_params(ps), ln), cs)
  DTrait(name, param, sigs, ln) -> pr_sigs(push_at(fs, 0, "trait " + name + "(" + param + ")", ln), sigs)
  DImpl(name, target, fns, ln) -> pr_impl_fns(push_at(fs, 0, "impl " + name + "(" + tr_str(target) + ")", ln), fns)
  DExtern(name, lib, ps, ret, ln) -> push_at(fs, 0, "extern" + lib_str(lib) + " fn " + name + "(" + join(map(ps, \p -> ep_str(p)), ", ") + ")" + ret_str(ret), ln)
  DFn(f) -> pr_fndef(fs, f, 0)

# ---- the module -------------------------------------------------------------
#
# One blank line between declarations; consecutive imports the author kept
# together stay together; a declaration's text starts at its first attached
# comment, which is what the separator logic has to measure against.

fn pm_one(fs, d, i, prev_imp) =
  dl = decl_line(d)
  start = if own_peek(fs) < dl then own_peek(fs) else dl
  keep = prev_imp && is_import(d) && !(start < dl) && !had_gap(fs, dl)
  fs1 = if i > 0 && !keep then fs_set_last(fs_blank(fs), if start > 0 then start - 1 else 0) else fs
  print_decl(lead(fs1, dl, 0), d)

fn pm_loop(fs, ds, i, prev_imp) = match ds
  Cons(d, rest) -> pm_loop(pm_one(fs, d, i, prev_imp), rest, i + 1, is_import(d))
  Nil -> fs

fn print_module(fs, ds) = own_rest(pm_loop(fs, ds, 0, false))
